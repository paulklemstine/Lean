/-
# The converse: extremals of the Donoho–Stark uncertainty principle are exactly coset modulations

`Catalog.Shared.FourierFiniteAbelian` proves the Donoho–Stark uncertainty principle
`|supp f| * |supp f̂| ≥ |G|` and `Catalog.Shared.FourierExtremals` proves the *"if"* direction of
the equality case: every function of the form `x ↦ c · χ x · 1_H (x - a)` (a nonzero multiple of a
modulated translate of a subgroup indicator) attains equality.

This file proves the **converse**: equality forces this shape. The proof is a full equality
analysis of the chain of inequalities behind the uncertainty principle, followed by a structural
argument in which the subgroup is *reconstructed* from the support of `f`:

1. equality forces `|f|` to be constant on `supp f` (`FourierFA.isExtremal_flat`);
2. equality forces, for every `ψ ∈ supp f̂`, all the terms `conj (ψ x) * f x` (`x ∈ supp f`) to
   coincide (`FourierFA.isExtremal_aligned`);
3. hence `f x / f a = ψ (x - a)` for every `ψ ∈ supp f̂`, so all characters in `supp f̂` agree on
   the subgroup `K` generated by `supp f - a`;
4. therefore `supp f ⊆ a + K` and `supp f̂ ⊆ ψ₀ + K^⊥`, and `|K| · |K^⊥| = |G|` forces both
   inclusions to be equalities;
5. reading off the values of `f` gives `f = c · ψ₀ · 1_{a + K}`.

Main results:

* `FourierFA.eq_of_norm_sum_eq_card_mul` : equality case of the triangle inequality for complex
  numbers of equal modulus.
* `FourierFA.eqSubgroup` : the equalizer of two characters, as a subgroup.
* `FourierFA.isExtremal_flat`, `FourierFA.isExtremal_aligned` : the analytic core.
* `FourierFA.exists_coset_modulation_of_isExtremal` : the structure theorem (the converse).
* `FourierFA.isExtremal_iff_coset_modulation` : the resulting classification of extremals.
* `FourierFA.isExtremal_support_coset` : the support of an extremal function is a coset.
* `FourierFA.isExtremal_support_parallelogram` : `x, y, z ∈ supp f → x - y + z ∈ supp f`.
* `FourierFA.isExtremal_prime_card` : on a group of prime order the only extremals are the
  modulated Dirac deltas and the multiples of characters.
-/

import Mathlib
import Shared.FourierFiniteAbelian
import Shared.FourierSubgroupDuality
import Shared.FourierExtremals
import Probability.FourierRigidity

open Finset ComplexConjugate

namespace FourierFA

variable {G : Type*} [AddCommGroup G] [Fintype G] [DecidableEq G]

/-! ## Equality case of the triangle inequality -/

/-- If finitely many complex numbers all of modulus `M > 0` satisfy
`‖∑ z i‖ = card * M`, then they are all equal. -/
theorem eq_of_norm_sum_eq_card_mul {ι : Type*} {s : Finset ι} {z : ι → ℂ} {M : ℝ} (hM : 0 < M)
    (hz : ∀ i ∈ s, ‖z i‖ = M) (hsum : ‖∑ i ∈ s, z i‖ = s.card * M) :
    ∀ i ∈ s, ∀ j ∈ s, z i = z j := by
  classical
  rcases s.eq_empty_or_nonempty with rfl | hne
  · simp
  have hcard : (0 : ℝ) < s.card := by exact_mod_cast Finset.card_pos.2 hne
  set S := ∑ i ∈ s, z i with hS
  have hSnorm : ‖S‖ = s.card * M := hsum
  have hSpos : 0 < ‖S‖ := by rw [hSnorm]; positivity
  have hSne : S ≠ 0 := by
    intro h
    rw [h, norm_zero] at hSpos
    exact lt_irrefl _ hSpos
  have hconjne : conj S ≠ 0 := by simpa using hSne
  set c : ℂ := ((‖S‖ * M : ℝ) : ℂ) with hc
  have hcne : c ≠ 0 := by
    rw [hc]
    simp only [ne_eq, Complex.ofReal_eq_zero]
    positivity
  -- normalise: `w i = conj S * z i / (‖S‖ * M)` has modulus one
  have hnorm1 : ∀ i ∈ s, ‖conj S * z i / c‖ = 1 := by
    intro i hi
    rw [norm_div, norm_mul, RCLike.norm_conj, hz i hi, hc, Complex.norm_real,
      Real.norm_eq_abs, abs_of_pos (by positivity : (0 : ℝ) < ‖S‖ * M)]
    exact div_self (by positivity)
  have hMne : ((M : ℂ)) ≠ 0 := by exact_mod_cast hM.ne'
  have hSnc : ((‖S‖ : ℂ)) ≠ 0 := by exact_mod_cast hSpos.ne'
  have hsum1 : ∑ i ∈ s, conj S * z i / c = (s.card : ℂ) := by
    rw [← Finset.sum_div, ← Finset.mul_sum, ← hS]
    have hSS : conj S * S = ((‖S‖ : ℂ)) ^ 2 := Complex.conj_mul' S
    have hcc : c = ((‖S‖ : ℂ)) * ((M : ℂ)) := by rw [hc]; push_cast; ring
    rw [hSS, hcc]
    have hdiv : ((‖S‖ : ℂ)) ^ 2 / (((‖S‖ : ℂ)) * ((M : ℂ))) = ((‖S‖ : ℂ)) / ((M : ℂ)) := by
      field_simp
    rw [hdiv, hSnorm]
    push_cast
    field_simp
  have hall := eq_one_of_sum_eq_card hnorm1 hsum1
  intro i hi j hj
  have hi' : conj S * z i = c := by
    have := hall i hi
    field_simp at this
    exact this
  have hj' : conj S * z j = c := by
    have := hall j hj
    field_simp at this
    exact this
  exact mul_left_cancel₀ hconjne (hi'.trans hj'.symm)

/-! ## The equalizer subgroup of two characters -/

/-- The set of group elements on which two characters agree is a subgroup. -/
def eqSubgroup (ψ χ : AddChar G ℂ) : AddSubgroup G where
  carrier := {g : G | ψ g = χ g}
  zero_mem' := by simp
  add_mem' := by
    intro a b ha hb
    simp only [Set.mem_setOf_eq] at *
    rw [ψ.map_add_eq_mul, χ.map_add_eq_mul, ha, hb]
  neg_mem' := by
    intro a ha
    simp only [Set.mem_setOf_eq] at *
    rw [AddChar.map_neg_eq_inv, AddChar.map_neg_eq_inv, ha]

omit [Fintype G] [DecidableEq G] in
@[simp] lemma mem_eqSubgroup {ψ χ : AddChar G ℂ} {g : G} :
    g ∈ eqSubgroup ψ χ ↔ ψ g = χ g := Iff.rfl

/-! ## Elementary facts about supports -/

omit [AddCommGroup G] [DecidableEq G] in
lemma supp_nonempty_of_ne_zero {f : G → ℂ} (hf : f ≠ 0) : (supp f).Nonempty := by
  by_contra h
  rw [Finset.not_nonempty_iff_eq_empty] at h
  refine hf (funext fun x => ?_)
  by_contra hx
  have hmem : x ∈ supp f := mem_supp.2 hx
  rw [h] at hmem
  simp at hmem

lemma dft_ne_zero {f : G → ℂ} (hf : f ≠ 0) : dft f ≠ 0 := by
  intro h
  exact hf (dft_injective (by rw [h, dft_zero]))

omit [DecidableEq G] in
/-- The Fourier transform only sees the support. -/
lemma dft_eq_sum_supp (f : G → ℂ) (ψ : AddChar G ℂ) :
    dft f ψ = ∑ x ∈ supp f, conj (ψ x) * f x := by
  rw [dft]
  refine (Finset.sum_subset (Finset.subset_univ _) ?_).symm
  intro x _ hx
  have : f x = 0 := by
    by_contra h
    exact hx (mem_supp.2 h)
  simp [this]

/-! ## The analytic core: flatness and alignment -/

/-- **Equality analysis of the uncertainty principle.** For an extremal function, `|f|` is
constant on its support and, for every frequency `ψ` in the support of `f̂`, all the terms
`conj (ψ x) · f x` with `x ∈ supp f` coincide. -/
theorem isExtremal_flat_and_aligned (f : G → ℂ) (hf : f ≠ 0) (hext : IsExtremal f) :
    ∃ M : ℝ, 0 < M ∧ (∀ x ∈ supp f, ‖f x‖ = M) ∧
      ∀ ψ ∈ supp (dft f), ∀ x ∈ supp f, ∀ y ∈ supp f,
        conj (ψ x) * f x = conj (ψ y) * f y := by
  classical
  have hA : (supp f).Nonempty := supp_nonempty_of_ne_zero hf
  have hB : (supp (dft f)).Nonempty := supp_nonempty_of_ne_zero (dft_ne_zero hf)
  obtain ⟨m, -, hm⟩ :=
    Finset.exists_max_image (Finset.univ : Finset G) (fun x => ‖f x‖) ⟨hA.choose, mem_univ _⟩
  set M := ‖f m‖ with hMdef
  have hMall : ∀ x, ‖f x‖ ≤ M := fun x => hm x (mem_univ x)
  have hMpos : 0 < M := by
    obtain ⟨x₀, hx₀⟩ := hA
    exact lt_of_lt_of_le (norm_pos_iff.2 (mem_supp.1 hx₀)) (hMall x₀)
  set SA := ∑ x ∈ supp f, ‖f x‖ with hSAdef
  have hSAle : SA ≤ (supp f).card * M := by
    calc SA ≤ ∑ _x ∈ supp f, M := Finset.sum_le_sum fun x _ => hMall x
      _ = (supp f).card * M := by rw [Finset.sum_const, nsmul_eq_mul]
  have hdftle : ∀ ψ : AddChar G ℂ, ‖dft f ψ‖ ≤ SA := by
    intro ψ
    rw [dft_eq_sum_supp]
    calc ‖∑ x ∈ supp f, conj (ψ x) * f x‖ ≤ ∑ x ∈ supp f, ‖conj (ψ x) * f x‖ := norm_sum_le _ _
      _ = SA := by
          refine Finset.sum_congr rfl fun x _ => ?_
          rw [norm_mul, RCLike.norm_conj, AddChar.norm_apply, one_mul]
  -- the lower bound coming from Fourier inversion at a maximum point
  have hcard : (Fintype.card G : ℂ) ≠ 0 := by exact_mod_cast (Fintype.card_ne_zero (α := G))
  have hinvsum : (Fintype.card G : ℂ) * f m = ∑ ψ ∈ supp (dft f), ψ m * dft f ψ := by
    have hfull : (Fintype.card G : ℂ) * f m = ∑ ψ : AddChar G ℂ, ψ m * dft f ψ := by
      conv_lhs => rw [← dft_inversion f]
      rw [idft, ← mul_assoc, mul_inv_cancel₀ hcard, one_mul]
    rw [hfull]
    refine (Finset.sum_subset (Finset.subset_univ _) ?_).symm
    intro ψ _ hψ
    have : dft f ψ = 0 := by
      by_contra h
      exact hψ (mem_supp.2 h)
    simp [this]
  have hlow : (Fintype.card G : ℝ) * M ≤ ∑ ψ ∈ supp (dft f), ‖dft f ψ‖ := by
    have h1 : (Fintype.card G : ℝ) * M = ‖∑ ψ ∈ supp (dft f), ψ m * dft f ψ‖ := by
      rw [← hinvsum, norm_mul]
      simp [hMdef]
    rw [h1]
    calc ‖∑ ψ ∈ supp (dft f), ψ m * dft f ψ‖
        ≤ ∑ ψ ∈ supp (dft f), ‖ψ m * dft f ψ‖ := norm_sum_le _ _
      _ = ∑ ψ ∈ supp (dft f), ‖dft f ψ‖ := by
          refine Finset.sum_congr rfl fun ψ _ => ?_
          rw [norm_mul, AddChar.norm_apply, one_mul]
  have hBpos : (0 : ℝ) < (supp (dft f)).card := by
    exact_mod_cast Finset.card_pos.2 hB
  have hprod : ((supp f).card : ℝ) * (supp (dft f)).card = (Fintype.card G : ℝ) := by
    exact_mod_cast hext
  -- the chain of inequalities collapses
  have hupper : ∑ ψ ∈ supp (dft f), ‖dft f ψ‖ ≤ (supp (dft f)).card * SA := by
    calc ∑ ψ ∈ supp (dft f), ‖dft f ψ‖ ≤ ∑ _ψ ∈ supp (dft f), SA :=
          Finset.sum_le_sum fun ψ _ => hdftle ψ
      _ = (supp (dft f)).card * SA := by rw [Finset.sum_const, nsmul_eq_mul]
  have hSAeq : SA = (supp f).card * M := by
    refine le_antisymm hSAle ?_
    have h1 : (Fintype.card G : ℝ) * M ≤ (supp (dft f)).card * SA := le_trans hlow hupper
    rw [← hprod] at h1
    have h2 : ((supp (dft f)).card : ℝ) * (((supp f).card : ℝ) * M)
        ≤ (supp (dft f)).card * SA := by
      calc ((supp (dft f)).card : ℝ) * (((supp f).card : ℝ) * M)
          = ((supp f).card : ℝ) * (supp (dft f)).card * M := by ring
        _ ≤ (supp (dft f)).card * SA := h1
    exact le_of_mul_le_mul_left h2 hBpos
  have hflat : ∀ x ∈ supp f, ‖f x‖ = M := by
    have hsum : ∑ x ∈ supp f, ‖f x‖ = ∑ _x ∈ supp f, M := by
      rw [← hSAdef, hSAeq, Finset.sum_const, nsmul_eq_mul]
    exact (Finset.sum_eq_sum_iff_of_le fun x _ => hMall x).1 hsum
  have hdfteq : ∀ ψ ∈ supp (dft f), ‖dft f ψ‖ = SA := by
    have hsum : ∑ ψ ∈ supp (dft f), ‖dft f ψ‖ = ∑ _ψ ∈ supp (dft f), SA := by
      refine le_antisymm ?_ ?_
      · rw [Finset.sum_const, nsmul_eq_mul]; exact hupper
      · rw [Finset.sum_const, nsmul_eq_mul, hSAeq]
        calc ((supp (dft f)).card : ℝ) * (((supp f).card : ℝ) * M)
            = (Fintype.card G : ℝ) * M := by rw [← hprod]; ring
          _ ≤ ∑ ψ ∈ supp (dft f), ‖dft f ψ‖ := hlow
    exact (Finset.sum_eq_sum_iff_of_le fun ψ _ => hdftle ψ).1 hsum
  refine ⟨M, hMpos, hflat, ?_⟩
  intro ψ hψ x hx y hy
  have hn : ∀ x ∈ supp f, ‖conj (ψ x) * f x‖ = M := by
    intro x hx
    rw [norm_mul, RCLike.norm_conj, AddChar.norm_apply, one_mul, hflat x hx]
  have hsumnorm : ‖∑ x ∈ supp f, conj (ψ x) * f x‖ = (supp f).card * M := by
    rw [← dft_eq_sum_supp, hdfteq ψ hψ, hSAeq]
  exact eq_of_norm_sum_eq_card_mul hMpos hn hsumnorm x hx y hy

/-- Extremal functions are *flat*: `|f|` is constant on `supp f`. -/
theorem isExtremal_flat (f : G → ℂ) (hf : f ≠ 0) (hext : IsExtremal f) :
    ∃ M : ℝ, 0 < M ∧ ∀ x ∈ supp f, ‖f x‖ = M := by
  obtain ⟨M, hM, hflat, -⟩ := isExtremal_flat_and_aligned f hf hext
  exact ⟨M, hM, hflat⟩

/-- Extremal functions are *aligned*: each frequency of `f̂` sees all points of `supp f` in
phase. -/
theorem isExtremal_aligned (f : G → ℂ) (hf : f ≠ 0) (hext : IsExtremal f) :
    ∀ ψ ∈ supp (dft f), ∀ x ∈ supp f, ∀ y ∈ supp f,
      conj (ψ x) * f x = conj (ψ y) * f y := by
  obtain ⟨-, -, -, halign⟩ := isExtremal_flat_and_aligned f hf hext
  exact halign

/-! ## The structure theorem -/

/-- **Converse of the extremality of coset modulations.** If `f ≠ 0` attains equality in the
Donoho–Stark uncertainty principle, then `f` is a nonzero multiple of a character times the
indicator of a coset of a subgroup. -/
theorem exists_coset_modulation_of_isExtremal (f : G → ℂ) (hf : f ≠ 0) (hext : IsExtremal f) :
    ∃ (K : AddSubgroup G) (χ : AddChar G ℂ) (a : G) (c : ℂ), c ≠ 0 ∧
      (∀ x, x - a ∈ K → f x = c * χ x) ∧ (∀ x, x - a ∉ K → f x = 0) := by
  classical
  obtain ⟨M, hMpos, hflat, halign⟩ := isExtremal_flat_and_aligned f hf hext
  obtain ⟨a, ha⟩ : (supp f).Nonempty := supp_nonempty_of_ne_zero hf
  obtain ⟨ψ₀, hψ₀⟩ : (supp (dft f)).Nonempty := supp_nonempty_of_ne_zero (dft_ne_zero hf)
  have hfa : f a ≠ 0 := mem_supp.1 ha
  set K : AddSubgroup G := AddSubgroup.closure ((fun x => x - a) '' (supp f : Set G)) with hK
  letI : DecidablePred (· ∈ K) := fun _ => Classical.dec _
  -- values of `f` are prescribed by any frequency in the support of `f̂`
  have hval : ∀ ψ ∈ supp (dft f), ∀ x ∈ supp f, f x = ψ (x - a) * f a := by
    intro ψ hψ x hx
    have h := halign ψ hψ x hx a ha
    have hψx : ψ x * conj (ψ x) = 1 := by
      rw [mul_comm, Complex.conj_mul']
      norm_cast
      rw [AddChar.norm_apply]
      norm_num
    have hsub : ψ (x - a) * ψ a = ψ x := by
      rw [← ψ.map_add_eq_mul, sub_add_cancel]
    have hψa : ψ a ≠ 0 := by
      intro h0
      have := AddChar.norm_apply ψ a
      rw [h0] at this
      simp at this
    have hxa : ψ (x - a) = ψ x * (ψ a)⁻¹ := by
      rw [eq_mul_inv_iff_mul_eq₀ hψa]
      exact hsub
    have hstep : ψ x * (conj (ψ a) * f a) = ψ (x - a) * f a := by
      have hca : conj (ψ a) = (ψ a)⁻¹ := (AddChar.inv_apply_eq_conj ψ a).symm
      rw [hca, hxa]
      ring
    calc f x = ψ x * (conj (ψ x) * f x) := by rw [← mul_assoc, hψx, one_mul]
      _ = ψ x * (conj (ψ a) * f a) := by rw [h]
      _ = ψ (x - a) * f a := hstep
  -- all frequencies of `f̂` agree on `K`
  have hagree : ∀ ψ ∈ supp (dft f), ∀ g ∈ K, ψ g = ψ₀ g := by
    intro ψ hψ
    have hsub : K ≤ eqSubgroup ψ ψ₀ := by
      rw [hK]
      refine AddSubgroup.closure_le _ |>.2 ?_
      rintro g ⟨x, hx, rfl⟩
      have h1 := hval ψ hψ x (by simpa using hx)
      have h2 := hval ψ₀ hψ₀ x (by simpa using hx)
      have : ψ (x - a) * f a = ψ₀ (x - a) * f a := by rw [← h1, ← h2]
      exact mem_eqSubgroup.2 (mul_right_cancel₀ hfa this)
    intro g hg
    exact mem_eqSubgroup.1 (hsub hg)
  -- the support is contained in the coset `a + K`
  have hsuppK : ∀ x ∈ supp f, x - a ∈ K := by
    intro x hx
    rw [hK]
    exact AddSubgroup.subset_closure ⟨x, by simpa using hx, rfl⟩
  have hAle : (supp f).card ≤ (subFinset K).card := by
    have hsubset : supp f ⊆ (subFinset K).image (fun k => a + k) := by
      intro x hx
      refine Finset.mem_image.2 ⟨x - a, mem_subFinset.2 (hsuppK x hx), by abel⟩
    calc (supp f).card ≤ ((subFinset K).image (fun k => a + k)).card :=
          Finset.card_le_card hsubset
      _ ≤ (subFinset K).card := Finset.card_image_le
  -- the frequency support is contained in the coset `ψ₀ + K^⊥`
  have hBle : (supp (dft f)).card ≤ (annih K).card := by
    refine Finset.card_le_card_of_injOn (fun ψ => ψ - ψ₀) ?_ ?_
    · intro ψ hψ
      refine mem_annih.2 fun g hg => ?_
      have hg' : ψ g = ψ₀ g := hagree ψ hψ g hg
      have hψ₀g : ψ₀ g ≠ 0 := by
        intro h0
        have := AddChar.norm_apply ψ₀ g
        rw [h0] at this
        simp at this
      rw [AddChar.sub_apply' ψ ψ₀ g, hg', div_self hψ₀g]
    · intro ψ _ χ _ h
      have h' := congrArg (fun t => t + ψ₀) h
      simpa using h'
  -- comparing with `|K| * |K^⊥| = |G|` forces equality
  have hKcard : (subFinset K).card * (annih K).card = Fintype.card G :=
    card_subgroup_mul_card_annihilator
  have hBpos : 0 < (supp (dft f)).card :=
    Finset.card_pos.2 (supp_nonempty_of_ne_zero (dft_ne_zero hf))
  have hKpos : 0 < (subFinset K).card := card_subFinset_pos
  have hAeq : (supp f).card = (subFinset K).card := by
    have h1 : (supp f).card * (supp (dft f)).card = (subFinset K).card * (annih K).card := by
      rw [hext, hKcard]
    have h2 : (subFinset K).card * (supp (dft f)).card
        ≤ (subFinset K).card * (annih K).card := Nat.mul_le_mul_left _ hBle
    have h3 : (supp f).card * (supp (dft f)).card
        ≤ (subFinset K).card * (supp (dft f)).card := Nat.mul_le_mul_right _ hAle
    have h4 : (subFinset K).card * (supp (dft f)).card
        = (subFinset K).card * (annih K).card := le_antisymm h2 (by omega)
    have hBeq : (supp (dft f)).card = (annih K).card :=
      Nat.eq_of_mul_eq_mul_left hKpos h4
    rw [hBeq] at h1
    exact Nat.eq_of_mul_eq_mul_right (by omega) h1
  have hsuppeq : supp f = (subFinset K).image (fun k => a + k) := by
    refine Finset.eq_of_subset_of_card_le ?_ ?_
    · intro x hx
      exact Finset.mem_image.2 ⟨x - a, mem_subFinset.2 (hsuppK x hx), by abel⟩
    · rw [Finset.card_image_of_injective _ (add_right_injective a), ← hAeq]
  have hmem : ∀ x : G, x ∈ supp f ↔ x - a ∈ K := by
    intro x
    constructor
    · exact hsuppK x
    · intro hx
      rw [hsuppeq]
      exact Finset.mem_image.2 ⟨x - a, mem_subFinset.2 hx, by abel⟩
  -- read off the values
  refine ⟨K, ψ₀, a, f a * conj (ψ₀ a), ?_, ?_, ?_⟩
  · refine mul_ne_zero hfa ?_
    simp only [ne_eq, map_eq_zero]
    intro h0
    have := AddChar.norm_apply ψ₀ a
    rw [h0] at this
    simp at this
  · intro x hx
    have hxs : x ∈ supp f := (hmem x).2 hx
    have hv := hval ψ₀ hψ₀ x hxs
    have hsub : ψ₀ (x - a) * ψ₀ a = ψ₀ x := by
      rw [← ψ₀.map_add_eq_mul, sub_add_cancel]
    have hψ₀a : ψ₀ a ≠ 0 := by
      intro h0
      have := AddChar.norm_apply ψ₀ a
      rw [h0] at this
      simp at this
    have hca : conj (ψ₀ a) = (ψ₀ a)⁻¹ := (AddChar.inv_apply_eq_conj ψ₀ a).symm
    have hxa : ψ₀ (x - a) = ψ₀ x * (ψ₀ a)⁻¹ := by
      rw [eq_mul_inv_iff_mul_eq₀ hψ₀a]
      exact hsub
    rw [hv, hca, hxa]
    ring
  · intro x hx
    by_contra h
    exact hx ((hmem x).1 (mem_supp.2 h))

/-- **Classification of the extremals of the uncertainty principle.** A nonzero function on a
finite abelian group satisfies `|supp f| * |supp f̂| = |G|` if and only if it is a nonzero
multiple of a modulated indicator of a coset. -/
theorem isExtremal_iff_coset_modulation (f : G → ℂ) (hf : f ≠ 0) :
    IsExtremal f ↔
      ∃ (K : AddSubgroup G) (χ : AddChar G ℂ) (a : G) (c : ℂ), c ≠ 0 ∧
        (∀ x, x - a ∈ K → f x = c * χ x) ∧ (∀ x, x - a ∉ K → f x = 0) := by
  classical
  refine ⟨fun h => exists_coset_modulation_of_isExtremal f hf h, ?_⟩
  rintro ⟨K, χ, a, c, hc, h1, h2⟩
  letI : DecidablePred (· ∈ K) := fun _ => Classical.dec _
  have hfeq : f = c • modul χ (transl a (indic K)) := by
    funext x
    have hval : (c • modul χ (transl a (indic K))) x
        = c * (χ x * (if x - a ∈ K then (1 : ℂ) else 0)) := rfl
    rw [hval]
    by_cases hx : x - a ∈ K
    · rw [if_pos hx, h1 x hx]; ring
    · rw [if_neg hx, h2 x hx]; ring
  rw [hfeq]
  exact isExtremal_coset_modulation K hc χ a

/-! ## Consequences -/

/-- The support of an extremal function is a coset of a subgroup. -/
theorem isExtremal_support_coset (f : G → ℂ) (hf : f ≠ 0) (hext : IsExtremal f) :
    ∃ (K : AddSubgroup G) (a : G), ∀ x, x ∈ supp f ↔ x - a ∈ K := by
  obtain ⟨K, χ, a, c, hc, h1, h2⟩ := exists_coset_modulation_of_isExtremal f hf hext
  refine ⟨K, a, fun x => ⟨?_, ?_⟩⟩
  · intro hx
    by_contra h
    exact (mem_supp.1 hx) (h2 x h)
  · intro hx
    refine mem_supp.2 ?_
    rw [h1 x hx]
    refine mul_ne_zero hc ?_
    intro h0
    have := AddChar.norm_apply χ x
    rw [h0] at this
    simp at this

/-- Rigidity of the support of an extremal function: it is closed under the "parallelogram"
operation `(x, y, z) ↦ x - y + z`, a purely combinatorial shadow of the analytic hypothesis. -/
theorem isExtremal_support_parallelogram (f : G → ℂ) (hf : f ≠ 0) (hext : IsExtremal f)
    {x y z : G} (hx : x ∈ supp f) (hy : y ∈ supp f) (hz : z ∈ supp f) :
    x - y + z ∈ supp f := by
  obtain ⟨K, a, hK⟩ := isExtremal_support_coset f hf hext
  have hx' := (hK x).1 hx
  have hy' := (hK y).1 hy
  have hz' := (hK z).1 hz
  refine (hK _).2 ?_
  have : x - y + z - a = (x - a) - (y - a) + (z - a) := by abel
  rw [this]
  exact K.add_mem (K.sub_mem hx' hy') hz'

/-- **Prime order rigidity.** On a group of prime order the classification degenerates
completely: the only extremals are the scalar multiples of Dirac deltas and the scalar
multiples of characters. -/
theorem isExtremal_prime_card {p : ℕ} (hp : p.Prime) (hcard : Fintype.card G = p)
    (f : G → ℂ) (hf : f ≠ 0) (hext : IsExtremal f) :
    (∃ (a : G) (c : ℂ), c ≠ 0 ∧ ∀ x, f x = if x = a then c else 0) ∨
      (∃ (χ : AddChar G ℂ) (c : ℂ), c ≠ 0 ∧ ∀ x, f x = c * χ x) := by
  classical
  obtain ⟨K, χ, a, c, hc, h1, h2⟩ := exists_coset_modulation_of_isExtremal f hf hext
  haveI : Fact (Nat.card G).Prime := ⟨by rwa [Nat.card_eq_fintype_card, hcard]⟩
  rcases K.eq_bot_or_eq_top_of_prime_card with hK | hK
  · -- `K = ⊥`: the support is the single point `a`
    refine Or.inl ⟨a, c * χ a, mul_ne_zero hc ?_, fun x => ?_⟩
    · intro h0
      have := AddChar.norm_apply χ a
      rw [h0] at this
      simp at this
    · by_cases hx : x = a
      · subst hx
        rw [if_pos rfl, h1 x (by rw [sub_self]; exact K.zero_mem)]
      · rw [if_neg hx]
        refine h2 x ?_
        rw [hK, AddSubgroup.mem_bot, sub_eq_zero]
        exact hx
  · -- `K = ⊤`: `f` is a multiple of a character
    refine Or.inr ⟨χ, c, hc, fun x => h1 x ?_⟩
    rw [hK]
    exact AddSubgroup.mem_top _

end FourierFA