import Probability.PRNGBerlekampMassey

/-!
# Noise-tolerant fingerprinting: the `2L + 2e + 1` conjecture is false

Real files are only *nearly* PRNG output (headers, checksums, interleaved
metadata), so the seed-compression router needs a fingerprint test that
tolerates `e` corrupted symbols.  Conjecture **C4** of `FUTURE_DIRECTIONS.md`
proposed the Reed–Solomon-style bound: a window of length `n ≥ 2L + 2e + 1`
should determine the underlying order-`L` stream uniquely.

This file settles C4 **negatively** and repairs it.

* `errorSet` — the corrupted positions of an observed word relative to a
  candidate stream.
* `noise_tolerance_two_L_plus_two_e_false` — **C4 is false**, for every error
  budget `e ≥ 1`: over `ZMod 3` there are two *distinct* order-one streams and
  a word of length exactly `2·1 + 2e + 1` lying within Hamming distance `e` of
  both.  The counterexample is structural, not accidental: the two streams
  agree on every even index, so their disagreements are spread out and no
  window of length `2L` is error-free — precisely the failure mode flagged as
  the caveat when C4 was stated.
* `noise_tolerance_five_false` — the smallest instance (`e = 1`, `n = 5`).
* `lfsr_seq_determined_of_block` — the shifted `2L` theorem: agreement on *any*
  `2L` consecutive indices forces agreement from there on.
* `exists_error_free_block` — a pigeonhole: `2e` errors cannot meet all of the
  `2e + 1` disjoint blocks of length `2L`.
* `unique_decoding_of_long_window` — **corrected conjecture C4′**: window length
  `2L(2e + 1)` *does* suffice.  Two order-`L` streams within distance `e` of a
  common observed word agree from some index `j` with `j + 2L ≤ n` onwards.
* `unique_decoding_threshold_sharp_order_one` — the corrected threshold is
  **sharp** at `L = 1`: unique decoding still fails at length
  `4e + 1 = 2·1·(2e + 1) - 1`, one symbol short of it.

Together the results pin the truth at order one: the correct threshold for
noise-tolerant LFSR fingerprinting is *not* the linear `2L + 2e + 1` but exactly
the multiplicative `2L(2e + 1)`.
-/

namespace Catalog.Probability.SeedRec

open Finset

variable {K : Type*} [CommRing K] {L n : ℕ}

section ErrorSet

variable [DecidableEq K]

/-- The set of positions at which the observed word `w` disagrees with the
candidate stream `y`: the corrupted symbols the detector must tolerate. -/
def errorSet (w : Fin n → K) (y : ℕ → K) : Finset (Fin n) :=
  Finset.univ.filter fun i => w i ≠ y (i : ℕ)

omit [CommRing K] in
@[simp] theorem mem_errorSet {w : Fin n → K} {y : ℕ → K} {i : Fin n} :
    i ∈ errorSet w y ↔ w i ≠ y (i : ℕ) := by
  simp [errorSet]

omit [CommRing K] in
theorem eq_of_not_mem_errorSet {w : Fin n → K} {y : ℕ → K} {i : Fin n}
    (h : i ∉ errorSet w y) : w i = y (i : ℕ) := by
  simpa using h

end ErrorSet

/-! ## The refutation of C4 -/

section Counterexample

/-- The constant stream is generated by the order-one LFSR with tap `1`. -/
theorem satisfiesLFSR_const_one :
    SatisfiesLFSR (![1] : Fin 1 → ZMod 3) (fun _ => (1 : ZMod 3)) := by
  intro t
  simp

/-- The alternating stream `2 ^ t` is generated by the order-one LFSR with tap `2`. -/
theorem satisfiesLFSR_pow_two :
    SatisfiesLFSR (![2] : Fin 1 → ZMod 3) (fun t => (2 : ZMod 3) ^ t) := by
  intro t
  simp [pow_succ, mul_comm]

/-- In `ZMod 3` the powers of `2 = -1` alternate. -/
theorem two_pow_zmod_three (t : ℕ) : (2 : ZMod 3) ^ t = if Even t then 1 else 2 := by
  have h2 : (2 : ZMod 3) = -1 := by decide
  rcases Nat.even_or_odd t with ht | ht
  · rw [h2, ht.neg_one_pow, if_pos ht]
  · rw [h2, ht.neg_one_pow, if_neg (Nat.not_even_iff_odd.mpr ht)]

/-- The word used to refute C4: it takes the value `2` at index `1` and `1`
everywhere else. -/
def c4Word (e : ℕ) : Fin (2 * 1 + 2 * e + 1) → ZMod 3 := fun i => if (i : ℕ) = 1 then 2 else 1

/-- `c4Word` differs from the constant stream only at index `1`. -/
theorem card_errorSet_c4Word_const (e : ℕ) (he : 1 ≤ e) :
    (errorSet (c4Word e) (fun _ => (1 : ZMod 3))).card ≤ e := by
  classical
  have hsub : errorSet (c4Word e) (fun _ => (1 : ZMod 3))
      ⊆ {(⟨1, by omega⟩ : Fin (2 * 1 + 2 * e + 1))} := by
    intro i hi
    rw [mem_errorSet] at hi
    by_cases h1 : (i : ℕ) = 1
    · exact Finset.mem_singleton.mpr (Fin.ext h1)
    · exact absurd (by simp [c4Word, h1]) hi
  calc (errorSet (c4Word e) (fun _ => (1 : ZMod 3))).card
      ≤ ({(⟨1, by omega⟩ : Fin (2 * 1 + 2 * e + 1))} : Finset _).card := Finset.card_le_card hsub
    _ = 1 := Finset.card_singleton _
    _ ≤ e := he

/-- `c4Word` differs from the alternating stream exactly at the odd indices `≥ 3`,
of which there are `e`. -/
theorem card_errorSet_c4Word_alt (e : ℕ) :
    (errorSet (c4Word e) (fun t => (2 : ZMod 3) ^ t)).card ≤ e := by
  classical
  have hchar : ∀ i ∈ errorSet (c4Word e) (fun t => (2 : ZMod 3) ^ t),
      (i : ℕ) % 2 = 1 ∧ 3 ≤ (i : ℕ) := by
    intro i hi
    rw [mem_errorSet] at hi
    simp only [c4Word, two_pow_zmod_three] at hi
    by_cases h1 : (i : ℕ) = 1
    · refine absurd ?_ hi
      rw [if_pos h1, if_neg (show ¬ Even (i : ℕ) by simp [h1])]
    · have hodd : ¬ Even (i : ℕ) := by
        intro hev
        exact hi (by rw [if_neg h1, if_pos hev])
      have hpar : (i : ℕ) % 2 = 1 := Nat.odd_iff.mp (Nat.not_even_iff_odd.mp hodd)
      exact ⟨hpar, by omega⟩
  calc (errorSet (c4Word e) (fun t => (2 : ZMod 3) ^ t)).card
      ≤ (Finset.range e).card := by
        refine Finset.card_le_card_of_injOn (fun i => ((i : ℕ) - 3) / 2) ?_ ?_
        · intro i hi
          obtain ⟨hp, h3⟩ := hchar i (by simpa using hi)
          have hlt := i.isLt
          have hgoal : ((i : ℕ) - 3) / 2 < e := by omega
          simpa using hgoal
        · intro i hi j hj hij
          obtain ⟨hp, h3⟩ := hchar i (by simpa using hi)
          obtain ⟨hp', h3'⟩ := hchar j (by simpa using hj)
          simp only at hij
          exact Fin.ext (by omega)
    _ = e := Finset.card_range e

/-- **Conjecture C4 is false.**  For every error budget `e ≥ 1` there are two
distinct streams of linear complexity one over `ZMod 3` and a word of length
`2·1 + 2e + 1` within Hamming distance `e` of *both*: `2L + 2e + 1` symbols do
not determine the underlying PRNG stream. -/
theorem noise_tolerance_two_L_plus_two_e_false (e : ℕ) (he : 1 ≤ e) :
    ∃ (c c' : Fin 1 → ZMod 3) (y z : ℕ → ZMod 3) (w : Fin (2 * 1 + 2 * e + 1) → ZMod 3),
      SatisfiesLFSR c y ∧ SatisfiesLFSR c' z ∧
        (errorSet w y).card ≤ e ∧ (errorSet w z).card ≤ e ∧ y ≠ z := by
  refine ⟨![1], ![2], fun _ => (1 : ZMod 3), fun t => (2 : ZMod 3) ^ t, c4Word e,
    satisfiesLFSR_const_one, satisfiesLFSR_pow_two,
    card_errorSet_c4Word_const e he, card_errorSet_c4Word_alt e, ?_⟩
  intro h
  have h1 := congrFun h 1
  rw [pow_one] at h1
  exact absurd h1 (by decide)

/-! ### Sharpness of the corrected threshold at order one -/

/-- The word witnessing sharpness: `1` at even indices, `1` at the first `e` odd
indices and `2` at the last `e` odd indices — so it splits its disagreements
evenly between the constant stream and the alternating stream. -/
def sharpWord (e : ℕ) : Fin (4 * e + 1) → ZMod 3 :=
  fun i => if (i : ℕ) % 2 = 0 then 1 else if (i : ℕ) < 2 * e then 1 else 2

theorem card_errorSet_sharpWord_const (e : ℕ) :
    (errorSet (sharpWord e) (fun _ => (1 : ZMod 3))).card ≤ e := by
  classical
  have hchar : ∀ i ∈ errorSet (sharpWord e) (fun _ => (1 : ZMod 3)),
      (i : ℕ) % 2 = 1 ∧ 2 * e < (i : ℕ) := by
    intro i hi
    rw [mem_errorSet] at hi
    simp only [sharpWord] at hi
    by_cases h0 : (i : ℕ) % 2 = 0
    · exact absurd (by rw [if_pos h0]) hi
    · rw [if_neg h0] at hi
      by_cases h1 : (i : ℕ) < 2 * e
      · exact absurd (by rw [if_pos h1]) hi
      · exact ⟨by omega, by omega⟩
  calc (errorSet (sharpWord e) (fun _ => (1 : ZMod 3))).card
      ≤ (Finset.range e).card := by
        refine Finset.card_le_card_of_injOn (fun i => ((i : ℕ) - (2 * e + 1)) / 2) ?_ ?_
        · intro i hi
          obtain ⟨hp, h2⟩ := hchar i (by simpa using hi)
          have hlt := i.isLt
          have hgoal : ((i : ℕ) - (2 * e + 1)) / 2 < e := by omega
          simpa using hgoal
        · intro i hi j hj hij
          obtain ⟨hp, h2⟩ := hchar i (by simpa using hi)
          obtain ⟨hp', h2'⟩ := hchar j (by simpa using hj)
          simp only at hij
          exact Fin.ext (by omega)
    _ = e := Finset.card_range e

theorem card_errorSet_sharpWord_alt (e : ℕ) :
    (errorSet (sharpWord e) (fun t => (2 : ZMod 3) ^ t)).card ≤ e := by
  classical
  have hchar : ∀ i ∈ errorSet (sharpWord e) (fun t => (2 : ZMod 3) ^ t),
      (i : ℕ) % 2 = 1 ∧ (i : ℕ) < 2 * e := by
    intro i hi
    rw [mem_errorSet] at hi
    simp only [sharpWord, two_pow_zmod_three] at hi
    by_cases h0 : (i : ℕ) % 2 = 0
    · refine absurd ?_ hi
      rw [if_pos h0, if_pos (Nat.even_iff.mpr h0)]
    · have hnotEven : ¬ Even (i : ℕ) := by rw [Nat.even_iff]; exact h0
      rw [if_neg hnotEven, if_neg h0] at hi
      by_cases h1 : (i : ℕ) < 2 * e
      · exact ⟨by omega, h1⟩
      · exact absurd (by rw [if_neg h1]) hi
  calc (errorSet (sharpWord e) (fun t => (2 : ZMod 3) ^ t)).card
      ≤ (Finset.range e).card := by
        refine Finset.card_le_card_of_injOn (fun i => ((i : ℕ) - 1) / 2) ?_ ?_
        · intro i hi
          obtain ⟨hp, h2⟩ := hchar i (by simpa using hi)
          have hgoal : ((i : ℕ) - 1) / 2 < e := by omega
          simpa using hgoal
        · intro i hi j hj hij
          obtain ⟨hp, h2⟩ := hchar i (by simpa using hi)
          obtain ⟨hp', h2'⟩ := hchar j (by simpa using hj)
          simp only at hij
          exact Fin.ext (by omega)
    _ = e := Finset.card_range e

/-- **The corrected threshold `2L(2e + 1)` is sharp at order one.**  At window
length `4e + 1 = 2·1·(2e + 1) - 1`, one symbol short of the length demanded by
`unique_decoding_of_long_window`, unique decoding already fails: two distinct
order-one streams over `ZMod 3` are both within Hamming distance `e` of
`sharpWord e`.  So the multiplicative dependence on `e` in C4′ is not an
artefact of the block pigeonhole. -/
theorem unique_decoding_threshold_sharp_order_one (e : ℕ) :
    ∃ (c c' : Fin 1 → ZMod 3) (y z : ℕ → ZMod 3) (w : Fin (4 * e + 1) → ZMod 3),
      SatisfiesLFSR c y ∧ SatisfiesLFSR c' z ∧
        (errorSet w y).card ≤ e ∧ (errorSet w z).card ≤ e ∧ y ≠ z := by
  refine ⟨![1], ![2], fun _ => (1 : ZMod 3), fun t => (2 : ZMod 3) ^ t, sharpWord e,
    satisfiesLFSR_const_one, satisfiesLFSR_pow_two,
    card_errorSet_sharpWord_const e, card_errorSet_sharpWord_alt e, ?_⟩
  intro h
  have h1 := congrFun h 1
  rw [pow_one] at h1
  exact absurd h1 (by decide)

/-- The smallest counterexample to C4: `L = 1`, `e = 1`, window length `5`. -/
theorem noise_tolerance_five_false :
    ∃ (c c' : Fin 1 → ZMod 3) (y z : ℕ → ZMod 3) (w : Fin 5 → ZMod 3),
      SatisfiesLFSR c y ∧ SatisfiesLFSR c' z ∧
        (errorSet w y).card ≤ 1 ∧ (errorSet w z).card ≤ 1 ∧ y ≠ z :=
  noise_tolerance_two_L_plus_two_e_false 1 le_rfl

end Counterexample

/-! ## The corrected threshold -/

section Corrected

/-- `SatisfiesLFSR` is shift invariant. -/
theorem satisfiesLFSR_shift {c : Fin L → K} {y : ℕ → K} (hy : SatisfiesLFSR c y) (j : ℕ) :
    SatisfiesLFSR c (fun t => y (j + t)) := by
  intro t
  have h := hy (j + t)
  simpa [Nat.add_assoc] using h

variable [Nontrivial K]

/-- **Shifted `2L` theorem.**  Two streams of linear complexity `≤ L` that agree
on *some* `2L` consecutive indices agree from that point onwards. -/
theorem lfsr_seq_determined_of_block (c c' : Fin L → K) (y z : ℕ → K)
    (hy : SatisfiesLFSR c y) (hz : SatisfiesLFSR c' z) (j : ℕ)
    (hagree : ∀ t, j ≤ t → t < j + 2 * L → y t = z t) :
    ∀ t, j ≤ t → y t = z t := by
  have hy' : SatisfiesLFSR c (fun t => y (j + t)) := satisfiesLFSR_shift hy j
  have hz' : SatisfiesLFSR c' (fun t => z (j + t)) := satisfiesLFSR_shift hz j
  have hag : ∀ t < 2 * L, y (j + t) = z (j + t) := fun t ht =>
    hagree (j + t) (by omega) (by omega)
  have heq := lfsr_seq_determined_by_two_L c c' _ _ hy' hz' hag
  intro t ht
  have h := congrFun heq (t - j)
  simpa [Nat.add_sub_cancel' ht] using h

/-- **Pigeonhole.**  At most `2e` corrupted positions cannot meet all `2e + 1`
disjoint blocks of length `2L`: one of the blocks is error free. -/
theorem exists_error_free_block (E : Finset (Fin n)) (e : ℕ)
    (hcard : E.card ≤ 2 * e) :
    ∃ m, m < 2 * e + 1 ∧ ∀ i : Fin n, 2 * L * m ≤ (i : ℕ) → (i : ℕ) < 2 * L * m + 2 * L →
      i ∉ E := by
  classical
  by_contra hcon
  push_neg at hcon
  have hle : (Finset.range (2 * e + 1)).card ≤ E.card := by
    refine Finset.card_le_card_of_surjOn (fun i : Fin n => (i : ℕ) / (2 * L)) ?_
    intro m hm
    have hm' : m < 2 * e + 1 := by simpa using hm
    obtain ⟨i, hi1, hi2, hi3⟩ := hcon m hm'
    have hcomm : 2 * L * m = m * (2 * L) := by ring
    have hcomm' : (m + 1) * (2 * L) = 2 * L * m + 2 * L := by ring
    refine ⟨i, hi3, ?_⟩
    exact Nat.div_eq_of_lt_le (by omega) (by omega)
  rw [Finset.card_range] at hle
  omega

variable [DecidableEq K]

/-- **Corrected conjecture C4′.**  If an observed word of length
`n ≥ 2L(2e + 1)` is within Hamming distance `e` of two streams of linear
complexity at most `L`, those streams agree from some index `j` with
`j + 2L ≤ n` onwards.  So a window of length `2L(2e + 1)` *does* give unique
noise-tolerant decoding — in contrast with `2L + 2e + 1`, which by
`noise_tolerance_two_L_plus_two_e_false` does not. -/
theorem unique_decoding_of_long_window (c c' : Fin L → K) (y z : ℕ → K)
    (hy : SatisfiesLFSR c y) (hz : SatisfiesLFSR c' z) (w : Fin n → K) (e : ℕ)
    (hwy : (errorSet w y).card ≤ e) (hwz : (errorSet w z).card ≤ e)
    (hn : 2 * L * (2 * e + 1) ≤ n) :
    ∃ j, j + 2 * L ≤ n ∧ ∀ t, j ≤ t → y t = z t := by
  classical
  have hcard : (errorSet w y ∪ errorSet w z).card ≤ 2 * e :=
    (Finset.card_union_le _ _).trans (by omega)
  obtain ⟨m, hm, hblock⟩ := exists_error_free_block (errorSet w y ∪ errorSet w z) e hcard
  have hmono : 2 * L * (m + 1) ≤ 2 * L * (2 * e + 1) := Nat.mul_le_mul_left _ (by omega)
  have hexp : 2 * L * (m + 1) = 2 * L * m + 2 * L := by ring
  refine ⟨2 * L * m, by omega, ?_⟩
  refine lfsr_seq_determined_of_block c c' y z hy hz (2 * L * m) ?_
  intro t ht1 ht2
  have htn : t < n := by omega
  have hnot := hblock ⟨t, htn⟩ (by simpa using ht1) (by simpa using ht2)
  rw [Finset.mem_union] at hnot
  push_neg at hnot
  have h1 : w ⟨t, htn⟩ = y t := eq_of_not_mem_errorSet hnot.1
  have h2 : w ⟨t, htn⟩ = z t := eq_of_not_mem_errorSet hnot.2
  rw [← h1, h2]

end Corrected

end Catalog.Probability.SeedRec