import Mathlib

/-!
# EML density as a functional-analytic uniqueness principle

The EML fragment used here consists of constants, field operations, and exponentials
of coordinate functions.  It is therefore contained in the class generated by exp,
log, and field operations (log is not needed for density).

The first result applies Stone–Weierstrass to prove density on every compact space
which embeds in finite-dimensional Euclidean space, hence in particular on
`[0,1]^n`.  The connector theorem then bridges approximation theory and functional
analysis: a continuous linear observable on `C(X, ℝ)` is completely determined by
its values on this EML algebra.

A final pair of results gives an explicit shallow, one-exponential approximation to
`x²` on `[0,1]`, with uniform error at most `4/(9n)` at scale `1/n`.
-/

noncomputable section

open scoped NNReal Topology
open Set Real ContinuousMap

namespace EMLDensityFunctionalAnalysisBridge

/-- The exponential of the `i`-th coordinate of an embedding. -/
def expCoordinate {X : Type*} [TopologicalSpace X] {n : ℕ}
    (ι : C(X, Fin n → ℝ)) (i : Fin n) : C(X, ℝ) where
  toFun x := Real.exp (ι x i)
  continuous_toFun :=
    Real.continuous_exp.comp ((continuous_apply i).comp ι.continuous)

/-- Exponential coordinates separate points whenever the coordinate map is injective. -/
theorem expCoordinate_separates {X : Type*} [TopologicalSpace X] {n : ℕ}
    (ι : C(X, Fin n → ℝ)) (hι : Function.Injective ι) :
    (Algebra.adjoin ℝ (Set.range (expCoordinate ι))).SeparatesPoints := by
  intro x y hxy
  have hne : ι x ≠ ι y := hι.ne hxy
  obtain ⟨i, hi⟩ : ∃ i : Fin n, ι x i ≠ ι y i := Function.ne_iff.mp hne
  refine ⟨expCoordinate ι i, ?_, ?_⟩
  · exact Set.mem_image_of_mem _ (Algebra.subset_adjoin (Set.mem_range_self i))
  · intro heq
    exact hi (Real.exp_injective heq)

/-- **Qualitative EML universal approximation.**  On a compact space embedded in
`ℝⁿ`, constants, addition, multiplication, scalar operations, and exponentials of
coordinates generate a dense subalgebra of all continuous real functions. -/
theorem expCoordinateAlgebra_dense {X : Type*} [TopologicalSpace X]
    [CompactSpace X] {n : ℕ} (ι : C(X, Fin n → ℝ))
    (hι : Function.Injective ι) :
    (Algebra.adjoin ℝ (Set.range (expCoordinate ι))).topologicalClosure = ⊤ := by
  exact ContinuousMap.subalgebra_topologicalClosure_eq_top_of_separatesPoints _
    (expCoordinate_separates ι hι)

/-- The canonical embedding of the cube `[0,1]^n` into `ℝⁿ`. -/
def cubeEmbedding (n : ℕ) : C((Fin n → Set.Icc (0 : ℝ) 1), Fin n → ℝ) where
  toFun x i := x i
  continuous_toFun := continuous_pi fun i => continuous_subtype_val.comp (continuous_apply i)

/-- The cube embedding is injective. -/
theorem cubeEmbedding_injective (n : ℕ) : Function.Injective (cubeEmbedding n) := by
  intro x y h
  ext i
  exact congr_fun h i

/-- **Density on the cube.**  The EML algebra generated by exponentials of the
coordinate projections is dense in `C([0,1]^n, ℝ)` in the uniform topology. -/
theorem eml_dense_on_cube (n : ℕ) :
    (Algebra.adjoin ℝ (Set.range (expCoordinate (cubeEmbedding n)))).topologicalClosure = ⊤ := by
  exact expCoordinateAlgebra_dense (cubeEmbedding n) (cubeEmbedding_injective n)

/-- **Connector: EML approximation ↔ functional analysis.**  Every continuous
linear observable on `C(X, ℝ)` is determined by its values on the EML coordinate
algebra.  Thus agreement on finite exp/field expressions forces agreement on every
continuous function. -/
theorem continuousLinearMap_ext_of_agree_on_eml
    {X : Type*} [TopologicalSpace X] [CompactSpace X] {n : ℕ}
    (ι : C(X, Fin n → ℝ)) (hι : Function.Injective ι)
    (L₁ L₂ : C(X, ℝ) →L[ℝ] ℝ)
    (hagree : ∀ a : Algebra.adjoin ℝ (Set.range (expCoordinate ι)), L₁ a = L₂ a) :
    L₁ = L₂ := by
  let A : Subalgebra ℝ C(X, ℝ) := Algebra.adjoin ℝ (Set.range (expCoordinate ι))
  have hclosure : A.topologicalClosure = ⊤ := expCoordinateAlgebra_dense ι hι
  apply ContinuousLinearMap.ext_on (s := (A : Set C(X, ℝ)))
  · rw [show Submodule.span ℝ (A : Set C(X, ℝ)) = A.toSubmodule by
      exact Submodule.span_eq A.toSubmodule]
    rw [dense_iff_closure_eq]
    have hset : closure (A : Set C(X, ℝ)) = Set.univ := by
      rw [← Subalgebra.topologicalClosure_coe, hclosure]
      rfl
    simpa using hset
  · intro f hf
    exact hagree ⟨f, hf⟩

/-- Specialization of the connector to `[0,1]^n`. -/
theorem continuousLinearMap_ext_on_cube_of_agree_on_eml
    (n : ℕ)
    (L₁ L₂ : C((Fin n → Set.Icc (0 : ℝ) 1), ℝ) →L[ℝ] ℝ)
    (hagree : ∀ a : Algebra.adjoin ℝ (Set.range (expCoordinate (cubeEmbedding n))),
      L₁ a = L₂ a) :
    L₁ = L₂ := by
  exact continuousLinearMap_ext_of_agree_on_eml
    (cubeEmbedding n) (cubeEmbedding_injective n) L₁ L₂ hagree

/-- A shallow EML expression with one exponential, approximating `x²`. -/
def shallowSquareApprox (h x : ℝ) : ℝ :=
  (2 / h ^ 2) * (Real.exp (h * x) - 1 - h * x)

/-- Taylor remainder estimate used by the shallow approximation. -/
theorem exp_quadratic_remainder (u : ℝ) (hu0 : 0 ≤ u) (hu1 : u ≤ 1) :
    |Real.exp u - (1 + u + u ^ 2 / 2)| ≤ (2 / 9) * u ^ 3 := by
  have h := Real.exp_bound
    (show |u| ≤ 1 by simpa [abs_of_nonneg hu0] using hu1)
    (show 0 < 3 by norm_num)
  norm_num [Finset.sum_range_succ, abs_of_nonneg hu0] at h ⊢
  linarith

/-- Explicit uniform error for the one-exponential shallow approximant. -/
theorem shallowSquareApprox_error (h : ℝ) (hh0 : 0 < h) (hh1 : h ≤ 1)
    (x : ℝ) (hx : x ∈ Set.Icc (0 : ℝ) 1) :
    |shallowSquareApprox h x - x ^ 2| ≤ (4 / 9) * h := by
  have hid : shallowSquareApprox h x - x ^ 2 =
      (2 / h ^ 2) * (Real.exp (h * x) - (1 + h * x + (h * x) ^ 2 / 2)) := by
    have hh : h ≠ 0 := hh0.ne'
    unfold shallowSquareApprox
    field_simp
    ring
  rw [hid, abs_mul, abs_of_pos (by positivity)]
  have ht := exp_quadratic_remainder (h * x)
    (mul_nonneg hh0.le hx.1) (mul_le_one₀ hh1 hx.1 hx.2)
  rw [div_mul_eq_mul_div, div_le_iff₀] <;>
    nlinarith [abs_nonneg (Real.exp (h * x) - (1 + h * x + (h * x) ^ 2 / 2)),
      pow_two_nonneg (h * x), pow_two_nonneg (h * x - 2),
      pow_two_nonneg (h * x - 1), pow_two_nonneg (h * x + 1),
      pow_two_nonneg (h * x + 2),
      mul_le_mul_of_nonneg_left (show x ^ 3 ≤ 1 by exact pow_le_one₀ hx.1 hx.2) hh0.le]

/-- **Explicit shallow rate.** At scale `h = 1/n`, one exponential suffices to
approximate `x²` uniformly on `[0,1]` with error at most `4/(9n)`. -/
theorem shallowSquareApprox_rate (n : ℕ) (hn : 1 ≤ n)
    (x : ℝ) (hx : x ∈ Set.Icc (0 : ℝ) 1) :
    |shallowSquareApprox (1 / n) x - x ^ 2| ≤ 4 / (9 * n) := by
  convert shallowSquareApprox_error (1 / n) (by positivity)
    (by rw [div_le_iff₀ (by positivity)]; norm_cast; linarith) x hx using 1
  ring

end EMLDensityFunctionalAnalysisBridge