/-
# The matching family: equal-volume shell peelings of Euclidean balls

`Catalog/Geometry/PeelStoppingTime.lean` establishes the *upper bound* half of
the peeling theory: within any window of `N` peeling steps there is a step
whose layer content is at most the average rate
(`exists_peel_stopping_time`), with the accompanying error control
(`peelEstimate_error`) and rigidity classification (`peel_extremal_tfae`).

This file supplies the missing half — a **matching family of actions**:

* **Cyclic actions on the layers.**  The subgroup generated by `finRotate N`
  inside `Equiv.Perm (Fin N)` acts pretransitively on the `N` peeling steps
  (`zpowers_finRotate_pretransitive`), so a peeling whose layer contents are
  invariant under a single `N`-cycle already saturates the pigeonhole bound
  (`peel_extremal_of_cyclic_action`).

* **A geometric realisation.**  For every dimension `d ≥ 1`, radius `R ≥ 0`
  and every `N ≥ 1`, the concentric shells of radii
  `shellRadius R d N k = R (1 - k/N)^{1/d}` peel the ball `B(0,R) ⊆ ℝ^d` into
  `N` pieces of *equal volume* `vol(B(0,R))/N` (`shellPeel_gap`,
  `shellLayer_volume`).  Every layer is invariant under the whole orthogonal
  group (`shellLayer_isometry_invariant`): the construction is `O(d)`-equivariant.

* **Rigidity in the geometric setting.**  Conversely, *any* nested family of
  balls shrinking `B(0,R)` to a point in `N` steps, all of whose shells have
  volume at most `vol(B(0,R))/N`, must be the equal-volume shell family
  (`ball_peel_rigidity`).  Hence the constant `1` in the stopping-time bound
  is optimal already for ball peelings (`ball_peel_stopping_time_sharp`).

## Lab notes

Dimension check (`d = 2`, `R = 1`, `N = 4`): radii `1, √(3)/2 ≈ .866,
√(2)/2 ≈ .707, 1/2, 0`; shell areas `π/4` each — the radii are *not* in
arithmetic progression, only their `d`-th powers are.  This is the reason the
rigidity statement has to be phrased through the volume profile rather than
the radius profile, and it is what makes `ball_peel_rigidity` a genuinely
`d`-dependent statement.
-/
import Geometry.PeelStoppingTime

namespace Catalog.Geometry.Peel

open Finset MeasureTheory Metric
open Fin.NatCast

/-! ## Cyclic actions on the layers of a peeling -/

/-- The `m`-th power of the standard `N`-cycle is translation by `m`. -/
lemma finRotate_pow_apply (n m : ℕ) : ∀ i : Fin (n + 1),
    ((finRotate (n + 1)) ^ m) i = i + (m : Fin (n + 1)) := by
  induction m with
  | zero => intro i; simp
  | succ m ih =>
      intro i
      rw [pow_succ, Equiv.Perm.mul_apply, finRotate_succ_apply, ih]
      push_cast
      abel

/-- The cyclic group generated by an `N`-cycle acts pretransitively on the
`N` layers. -/
lemma zpowers_finRotate_pretransitive (n : ℕ) :
    MulAction.IsPretransitive (Subgroup.zpowers (finRotate (n + 1))) (Fin (n + 1)) := by
  refine ⟨fun i j => ?_⟩
  refine ⟨⟨(finRotate (n + 1)) ^ ((j - i).val), pow_mem (Subgroup.mem_zpowers _) _⟩, ?_⟩
  show ((finRotate (n + 1)) ^ ((j - i).val)) i = j
  rw [finRotate_pow_apply]
  simp

/-- **A single cyclic symmetry forces extremality.**  If the layer contents of
a peeling are invariant under the cyclic group generated by one `N`-cycle,
then the profile is arithmetic: every layer carries exactly the average
content. -/
theorem peel_extremal_of_cyclic_action (P : PeelProfile) (n : ℕ)
    (hinv : ∀ (g : Subgroup.zpowers (finRotate (n + 1))) (i : Fin (n + 1)),
      gapFin P (n + 1) (g • i) = gapFin P (n + 1) i) :
    ∀ k ≤ n + 1, P.size k = P.size 0 - k * peelRate P (n + 1) := by
  haveI := zpowers_finRotate_pretransitive n
  exact peel_arithmetic_of_pretransitive P (Nat.succ_pos n) hinv

/-! ## Volumes of Euclidean balls -/

/-- The volume of the ball of radius `r` in `ℝ^d`, as a real number. -/
noncomputable def ballVol (d : ℕ) (r : ℝ) : ℝ :=
  (volume (ball (0 : EuclideanSpace ℝ (Fin d)) r)).toReal

lemma ballVol_nonneg (d : ℕ) (r : ℝ) : 0 ≤ ballVol d r := ENNReal.toReal_nonneg

/-- Scaling law of Lebesgue measure: `vol B(0,r) = r^d · vol B(0,1)`. -/
lemma ballVol_eq (d : ℕ) (hd : 0 < d) {r : ℝ} (hr : 0 ≤ r) :
    ballVol d r = r ^ d * ballVol d 1 := by
  haveI : Nonempty (Fin d) := Fin.pos_iff_nonempty.mp hd
  haveI : Nontrivial (EuclideanSpace ℝ (Fin d)) := by infer_instance
  have h := MeasureTheory.Measure.addHaar_ball
    (μ := (volume : Measure (EuclideanSpace ℝ (Fin d)))) 0 hr
  rw [finrank_euclideanSpace_fin] at h
  unfold ballVol
  rw [h, ENNReal.toReal_mul, ENNReal.toReal_ofReal (by positivity)]

lemma ballVol_one_pos (d : ℕ) : 0 < ballVol d 1 := by
  unfold ballVol
  rw [ENNReal.toReal_pos_iff]
  exact ⟨measure_ball_pos _ _ one_pos, measure_ball_lt_top⟩

@[simp] lemma ballVol_zero (d : ℕ) : ballVol d 0 = 0 := by simp [ballVol]

lemma ballVol_mono (d : ℕ) (hd : 0 < d) {a b : ℝ} (ha : 0 ≤ a) (hab : a ≤ b) :
    ballVol d a ≤ ballVol d b := by
  rw [ballVol_eq d hd ha, ballVol_eq d hd (ha.trans hab)]
  have hpow : a ^ d ≤ b ^ d := pow_le_pow_left₀ ha hab d
  nlinarith [ballVol_one_pos d]

/-- Radii with equal `d`-th powers coincide. -/
lemma radius_eq_of_ballVol_eq (d : ℕ) (hd : 0 < d) {a b : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b)
    (h : ballVol d a = ballVol d b) : a = b := by
  rw [ballVol_eq d hd ha, ballVol_eq d hd hb] at h
  have hv := ballVol_one_pos d
  have hpow : a ^ d = b ^ d := by
    have := mul_right_cancel₀ (b := ballVol d 1) hv.ne' h
    exact this
  rcases lt_trichotomy a b with hlt | heq | hgt
  · have := pow_lt_pow_left₀ hlt ha hd.ne'; linarith
  · exact heq
  · have := pow_lt_pow_left₀ hgt hb hd.ne'; linarith

/-! ## The equal-volume shell peeling of a ball -/

/-- Radius of the `k`-th sphere in the equal-volume shell peeling of `B(0,R)`
into `N` pieces: `R (1 - k/N)^{1/d}`. -/
noncomputable def shellRadius (R : ℝ) (d N k : ℕ) : ℝ :=
  R * (max 0 (1 - (k : ℝ) / (N : ℝ))) ^ ((d : ℝ)⁻¹)

lemma shellRadius_nonneg {R : ℝ} (hR : 0 ≤ R) (d N k : ℕ) : 0 ≤ shellRadius R d N k :=
  mul_nonneg hR (Real.rpow_nonneg (le_max_left _ _) _)

lemma shellRadius_anti {R : ℝ} (hR : 0 ≤ R) (d N : ℕ) : Antitone (shellRadius R d N) := by
  intro a b hab
  have hcast : (a : ℝ) ≤ b := by exact_mod_cast hab
  have hmono : max 0 (1 - (b : ℝ) / N) ≤ max 0 (1 - (a : ℝ) / N) := by
    refine max_le_max (le_refl 0) ?_
    rcases Nat.eq_zero_or_pos N with h | h
    · subst h; simp
    · have hNR : (0 : ℝ) < N := by exact_mod_cast h
      have : (a : ℝ) / N ≤ b / N := by gcongr
      linarith
  have := Real.rpow_le_rpow (le_max_left _ _) hmono (by positivity : (0 : ℝ) ≤ ((d : ℝ)⁻¹))
  exact mul_le_mul_of_nonneg_left this hR

@[simp] lemma shellRadius_zero {R : ℝ} (d N : ℕ) :
    shellRadius R d N 0 = R := by
  simp [shellRadius]

lemma shellRadius_last {R : ℝ} (d N : ℕ) (hN : 0 < N) (hd : 0 < d) :
    shellRadius R d N N = 0 := by
  have hNR : (0 : ℝ) < N := by exact_mod_cast hN
  have hd' : ((d : ℝ)⁻¹) ≠ 0 := by
    have : (0 : ℝ) < d := by exact_mod_cast hd
    positivity
  simp [shellRadius, div_self hNR.ne', Real.zero_rpow hd']

/-- The peeling profile of the equal-volume shell family: the equipartition
profile with total content `vol B(0,R)`. -/
noncomputable def shellPeel (d : ℕ) (R : ℝ) (N : ℕ) : PeelProfile :=
  equipartitionProfile (ballVol d R) (ballVol_nonneg d R) N

/-- **The geometric identity.**  The abstract profile of the shell peeling is
exactly the sequence of volumes of the concentric balls of radii
`shellRadius R d N k`. -/
theorem shellPeel_size (d N k : ℕ) (hd : 0 < d) {R : ℝ} (hR : 0 ≤ R) :
    (shellPeel d R N).size k = ballVol d (shellRadius R d N k) := by
  have ht0 : (0 : ℝ) ≤ max 0 (1 - (k : ℝ) / (N : ℝ)) := le_max_left _ _
  have hrad : 0 ≤ shellRadius R d N k := shellRadius_nonneg hR d N k
  have hR' : ballVol d R = R ^ d * ballVol d 1 := ballVol_eq d hd hR
  rw [ballVol_eq d hd hrad, shellRadius, mul_pow, Real.rpow_inv_natCast_pow ht0 hd.ne']
  show ballVol d R * max 0 (1 - (k : ℝ) / (N : ℝ))
      = R ^ d * max 0 (1 - (k : ℝ) / (N : ℝ)) * ballVol d 1
  rw [hR']
  ring

lemma shellPeel_budget (d N : ℕ) (hN : 0 < N) {R : ℝ} :
    peelBudget (shellPeel d R N) N = ballVol d R := by
  simpa [shellPeel] using equipartitionProfile_budget (ballVol_nonneg d R) hN

lemma shellPeel_rate (d N : ℕ) (hN : 0 < N) {R : ℝ} :
    peelRate (shellPeel d R N) N = ballVol d R / N := by
  simpa [shellPeel] using equipartitionProfile_rate (ballVol_nonneg d R) hN

/-- **Equal volumes.**  Each of the `N` shells has volume exactly
`vol B(0,R) / N`. -/
theorem shellPeel_gap (d N k : ℕ) (hN : 0 < N) (hk : k < N) {R : ℝ} :
    peelGap (shellPeel d R N) k = ballVol d R / N :=
  equipartitionProfile_gap (ballVol_nonneg d R) hN hk

/-- The `k`-th shell of the peeling, as a subset of `ℝ^d`. -/
noncomputable def shellLayer (d : ℕ) (R : ℝ) (N k : ℕ) : Set (EuclideanSpace ℝ (Fin d)) :=
  ball 0 (shellRadius R d N k) \ ball 0 (shellRadius R d N (k + 1))

/-- **`O(d)`-equivariance.**  Every shell is invariant under every linear
isometry of `ℝ^d`: the peeling is a family of orbits of the orthogonal
group. -/
theorem shellLayer_isometry_invariant (d : ℕ) (R : ℝ) (N k : ℕ)
    (e : EuclideanSpace ℝ (Fin d) ≃ₗᵢ[ℝ] EuclideanSpace ℝ (Fin d)) :
    e '' shellLayer d R N k = shellLayer d R N k := by
  have himg : ∀ r : ℝ, e '' (ball (0 : EuclideanSpace ℝ (Fin d)) r) = ball 0 r := by
    intro r
    rw [LinearIsometryEquiv.image_ball, map_zero]
  rw [shellLayer, Set.image_diff e.injective, himg, himg]

/-- The volume of the `k`-th shell equals the abstract layer content, hence
`vol B(0,R)/N`. -/
theorem shellLayer_volume (d N k : ℕ) (hd : 0 < d) (hN : 0 < N) (hk : k < N) {R : ℝ}
    (hR : 0 ≤ R) : (volume (shellLayer d R N k)).toReal = ballVol d R / N := by
  have hsub : ball (0 : EuclideanSpace ℝ (Fin d)) (shellRadius R d N (k + 1))
      ⊆ ball 0 (shellRadius R d N k) :=
    ball_subset_ball (shellRadius_anti hR d N (Nat.le_succ k))
  have hfin : volume (ball (0 : EuclideanSpace ℝ (Fin d)) (shellRadius R d N (k + 1))) ≠ ⊤ :=
    measure_ball_lt_top.ne
  have hdiff : volume (shellLayer d R N k)
      = volume (ball (0 : EuclideanSpace ℝ (Fin d)) (shellRadius R d N k))
        - volume (ball (0 : EuclideanSpace ℝ (Fin d)) (shellRadius R d N (k + 1))) :=
    measure_diff hsub measurableSet_ball.nullMeasurableSet hfin
  rw [hdiff, ENNReal.toReal_sub_of_le (measure_mono hsub) measure_ball_lt_top.ne]
  have h1 : (volume (ball (0 : EuclideanSpace ℝ (Fin d)) (shellRadius R d N k))).toReal
      = (shellPeel d R N).size k := (shellPeel_size d N k hd hR).symm
  have h2 : (volume (ball (0 : EuclideanSpace ℝ (Fin d)) (shellRadius R d N (k + 1)))).toReal
      = (shellPeel d R N).size (k + 1) := (shellPeel_size d N (k + 1) hd hR).symm
  rw [show (volume (ball (0 : EuclideanSpace ℝ (Fin d)) (shellRadius R d N k))).toReal
      = (shellPeel d R N).size k from h1,
    show (volume (ball (0 : EuclideanSpace ℝ (Fin d)) (shellRadius R d N (k + 1)))).toReal
      = (shellPeel d R N).size (k + 1) from h2]
  exact shellPeel_gap d N k hN hk

/-! ## Rigidity of ball peelings -/

/-- The peeling profile attached to a nested family of balls. -/
noncomputable def radiusProfile (d : ℕ) (hd : 0 < d) (r : ℕ → ℝ)
    (hanti : Antitone r) (hnn : ∀ k, 0 ≤ r k) : PeelProfile where
  size k := ballVol d (r k)
  anti := fun _ b hab => ballVol_mono d hd (hnn b) (hanti hab)
  nonneg := fun _ => ballVol_nonneg d _

/-- **Rigidity of ball peelings.**  If a nested family of balls shrinks
`B(0,R)` to a point in `N` steps and *every* shell has volume at most
`vol B(0,R)/N`, then the radii are forced: `r k = R (1 - k/N)^{1/d}`.  Thus
the equal-volume shell peeling is the unique extremiser of the stopping-time
bound among ball peelings. -/
theorem ball_peel_rigidity (d N : ℕ) (hd : 0 < d) (hN : 0 < N) {R : ℝ} (hR : 0 ≤ R)
    (r : ℕ → ℝ) (hanti : Antitone r) (hnn : ∀ k, 0 ≤ r k) (h0 : r 0 = R) (hlast : r N = 0)
    (hsmall : ∀ k < N, ballVol d (r k) - ballVol d (r (k + 1)) ≤ ballVol d R / N) :
    ∀ k ≤ N, r k = shellRadius R d N k := by
  set P := radiusProfile d hd r hanti hnn with hP
  have hsize : ∀ k, P.size k = ballVol d (r k) := fun _ => rfl
  have hbudget : peelBudget P N = ballVol d R := by
    simp [peelBudget, hsize, h0, hlast]
  have hrate : peelRate P N = ballVol d R / N := by rw [peelRate, hbudget]
  have h1 : ∀ k < N, peelGap P k ≤ peelRate P N := by
    intro k hk
    rw [hrate, peelGap, hsize, hsize]
    exact hsmall k hk
  have h3 := ((peel_extremal_tfae P hN).out 0 2).1 h1
  intro k hk
  have hNR : (0 : ℝ) < N := by exact_mod_cast hN
  have hkN : (k : ℝ) ≤ N := by exact_mod_cast hk
  have hnneg : (0 : ℝ) ≤ 1 - (k : ℝ) / N := by
    rw [sub_nonneg, div_le_one hNR]; exact hkN
  have hvol : ballVol d (r k) = ballVol d (shellRadius R d N k) := by
    rw [← hsize k, h3 k hk, hsize 0, h0, hrate,
      ← shellPeel_size d N k hd hR, shellPeel,
      equipartitionProfile_size_of_le (ballVol_nonneg d R) hN hk]
    field_simp
  exact radius_eq_of_ballVol_eq d hd (hnn k) (shellRadius_nonneg hR d N k) hvol

/-- **Sharpness of the stopping-time constant, geometric form.**  For every
`c < 1` the equal-volume shell family witnesses that no ball peeling estimate
with constant `c` can hold: every one of its `N` shells has volume strictly
larger than `c · vol B(0,R)/N`. -/
theorem ball_peel_stopping_time_sharp (d N : ℕ) (hd : 0 < d) (hN : 0 < N) {R : ℝ} (hR : 0 < R)
    {c : ℝ} (hc : c < 1) :
    ∃ r : ℕ → ℝ, Antitone r ∧ (∀ k, 0 ≤ r k) ∧ r 0 = R ∧ r N = 0 ∧
      ∀ k < N, ¬ (ballVol d (r k) - ballVol d (r (k + 1)) ≤ c * (ballVol d R / N)) := by
  refine ⟨shellRadius R d N, shellRadius_anti hR.le d N, shellRadius_nonneg hR.le d N,
    shellRadius_zero d N, shellRadius_last d N hN hd, ?_⟩
  intro k hk hcon
  have hgap : ballVol d (shellRadius R d N k) - ballVol d (shellRadius R d N (k + 1))
      = ballVol d R / N := by
    rw [← shellPeel_size d N k hd hR.le, ← shellPeel_size d N (k + 1) hd hR.le]
    exact shellPeel_gap d N k hN hk
  rw [hgap] at hcon
  have hvolpos : 0 < ballVol d R := by
    rw [ballVol_eq d hd hR.le]
    have := ballVol_one_pos d
    positivity
  have hNR : (0 : ℝ) < N := by exact_mod_cast hN
  have : 0 < ballVol d R / N := div_pos hvolpos hNR
  nlinarith

/-- The equal-volume shell peeling really is invariant under the cyclic action
on its layers, and therefore is an extremiser in the sense of
`peel_extremal_of_cyclic_action`. -/
theorem shellPeel_cyclic_invariant (d n : ℕ) {R : ℝ} :
    ∀ (g : Subgroup.zpowers (finRotate (n + 1))) (i : Fin (n + 1)),
      gapFin (shellPeel d R (n + 1)) (n + 1) (g • i)
        = gapFin (shellPeel d R (n + 1)) (n + 1) i := by
  intro g i
  simp only [gapFin]
  rw [shellPeel_gap d (n + 1) _ (Nat.succ_pos n) (g • i).isLt,
    shellPeel_gap d (n + 1) _ (Nat.succ_pos n) i.isLt]

/-- Capstone: for every dimension and every `N`, the shell peeling of a ball
is a peeling whose layers are permuted cyclically without changing their
volumes, and whose profile is therefore exactly arithmetic — the family
matching the abstract upper bound. -/
theorem shellPeel_arithmetic (d n : ℕ) {R : ℝ} :
    ∀ k ≤ n + 1, (shellPeel d R (n + 1)).size k
      = (shellPeel d R (n + 1)).size 0 - k * peelRate (shellPeel d R (n + 1)) (n + 1) :=
  peel_extremal_of_cyclic_action _ n (shellPeel_cyclic_invariant d n)

end Catalog.Geometry.Peel