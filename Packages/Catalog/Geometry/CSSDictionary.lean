import Shared.HQECC.CSSHomology

/-!
# The CSS dictionary: parity-check matrices ⟷ chain complex ⟷ stabilizer group

This file carries out **future target 1** of the previous research cycle.  The
cycle proved the dimension formula for an abstract length-two chain complex
`A --d₂--> B --d₁--> C`, and *described* CSS codes by the informal expression
`C₁/C₂` with `C₂ ⊆ C₁`.  That description is incomplete in two ways: the usual
CSS commutation condition is `H_X H_Zᵀ = 0`, phrased with orthogonal
complements, and the object it produces is a *stabilizer group*, which never
appeared.  We give here the exact equivalence of the three pictures.

Throughout, a classical linear code is presented by a parity-check matrix.  For
`H : Matrix m N K` we write

* `code H  = ker (v ↦ H *ᵥ v)`      — the code it checks;
* `rowSpace H = range (y ↦ Hᵀ *ᵥ y)` — the code generated by its checks;
* `perp W` — the orthogonal complement for the standard bilinear form
  `⟪v, w⟫ = v ⬝ᵥ w` (which is nondegenerate: `perp_top`).

The three faces of the dictionary, for a pair `H_X, H_Z` of parity checks:

1. **Inclusion of classical codes** `rowSpace H_Z ≤ code H_X`, i.e. the mission's
   `C₂ ⊆ C₁` (`rowSpace_le_code_iff`);
2. **Orthogonality/commutation of parity checks** `H_X H_Zᵀ = 0`
   (`code_eq_perp_rowSpace` identifies `code H = perp (rowSpace H)`, so 1 is
   literally an orthogonality statement);
3. **Isotropy of the stabilizer group** for the symplectic (Pauli-commutation)
   form on `𝔽₂^N × 𝔽₂^N` (`stabilizer_isotropic_iff`): the group generated by
   the `X`-type checks and the `Z`-type checks is abelian.

`cssComplex` then packages such a pair as an honest `CSSComplex` whose cycles
are `C₁ = code H_X`, whose boundaries are `C₂ = rowSpace H_Z`, and whose
homology is therefore *the* quotient `C₁/C₂`; `cssComplex_numLogical_add`
recovers the CSS count `k = N − rank H_X − rank H_Z`, and
`cssComplex_numLogical_quotient` states it in the `C₁/C₂` form.

-- !-- Lab Notes -- !--
HYPOTHESIS (Hypothesizer).  The three formulations (inclusion of classical
codes, matrix orthogonality, isotropy of the stabilizer) are *equivalent*, and
the equivalence is an identity of submodules rather than a numerical
coincidence.

EXPERIMENT (Experimenter).  `rowSpace_le_code_iff` is proved by the adjunction
`(Hᵀ *ᵥ y) ⬝ᵥ v = y ⬝ᵥ (H *ᵥ v)` plus nondegeneracy of the dot product;
isotropy is proved by a double `Submodule.span_le` argument through the flip of
the symplectic form, so no basis or finiteness of the generating set is used.

ANALYSIS (Analyst).  The `X/Z` symmetry of CSS codes is exactly the transpose
symmetry of `H_X H_Zᵀ = 0` (`commutation_symm`).  The count
`k + rank H_X + rank H_Z = N` needs `Matrix.rank_transpose` — the only place a
field is required; the inclusion/isotropy equivalences hold over any
commutative ring with a nondegenerate dot product.

CRITIQUE (Critic).  `perp` is only well behaved because the standard form is
nondegenerate; `perp_top` records this, and no result below silently assumes
`perp (perp W) = W`.  The isotropy theorem is an iff, so it cannot be satisfied
vacuously: its right-to-left direction genuinely evaluates the form on the
generators.
-/

namespace HQECC
namespace CSSDictionary

open Matrix Module

/-! ## Classical codes from parity-check matrices -/

variable {K : Type*} [Field K] {m mx mz N : Type*}
  [Fintype m] [Fintype mx] [Fintype mz] [Fintype N]

/-- The classical code checked by `H`: `C(H) = ker H`. -/
def code (H : Matrix m N K) : Submodule K (N → K) := LinearMap.ker H.mulVecLin

/-- The code *generated* by the rows of `H`, i.e. the row space `im Hᵀ`. -/
def rowSpace (H : Matrix m N K) : Submodule K (N → K) := LinearMap.range Hᵀ.mulVecLin

omit [Fintype m] in
@[simp] lemma mem_code {H : Matrix m N K} {v : N → K} : v ∈ code H ↔ H *ᵥ v = 0 :=
  Iff.rfl

omit [Fintype N] in
lemma mem_rowSpace {H : Matrix m N K} {w : N → K} :
    w ∈ rowSpace H ↔ ∃ y : m → K, Hᵀ *ᵥ y = w := Iff.rfl

/-- The orthogonal complement of a subspace of `Kᴺ` for the standard bilinear
form `⟪v, w⟫ = v ⬝ᵥ w`. -/
def perp (W : Submodule K (N → K)) : Submodule K (N → K) where
  carrier := {v | ∀ w ∈ W, w ⬝ᵥ v = 0}
  zero_mem' := by intro w _; simp
  add_mem' := by
    intro a b ha hb w hw
    rw [dotProduct_add, ha w hw, hb w hw, add_zero]
  smul_mem' := by
    intro c a ha w hw
    rw [dotProduct_smul, ha w hw, smul_zero]

lemma mem_perp {W : Submodule K (N → K)} {v : N → K} :
    v ∈ perp W ↔ ∀ w ∈ W, w ⬝ᵥ v = 0 := Iff.rfl

/-- **Nondegeneracy** of the standard form: only `0` is orthogonal to
everything. -/
theorem perp_top : perp (⊤ : Submodule K (N → K)) = ⊥ := by
  ext v
  simp only [mem_perp, Submodule.mem_bot]
  constructor
  · intro h
    have hall : ∀ w : N → K, v ⬝ᵥ w = 0 := by
      intro w; rw [dotProduct_comm]; exact h w Submodule.mem_top
    exact dotProduct_eq_zero_iff.1 hall
  · rintro rfl w _; exact dotProduct_zero w

/-- **The parity-check code is an orthogonal complement.**  `ker H` is exactly
the orthogonal complement of the row space of `H`.  This is the precise link
between the "quotient of nested codes" and the "orthogonal complement"
formulations of CSS. -/
theorem code_eq_perp_rowSpace (H : Matrix m N K) : code H = perp (rowSpace H) := by
  ext v
  constructor
  · rintro hv _ ⟨y, rfl⟩
    rw [Matrix.mulVecLin_apply, mulVec_transpose, ← dotProduct_mulVec, (mem_code.1 hv),
      dotProduct_zero]
  · intro hv
    rw [mem_code]
    apply dotProduct_eq_zero_iff.1
    intro w
    rw [dotProduct_comm, dotProduct_mulVec, ← mulVec_transpose]
    exact hv _ ⟨w, rfl⟩

/-! ## The commutation condition -/

omit [Fintype mx] in
/-- **Dictionary, part 1.**  The mission's inclusion `C₂ ⊆ C₁` of classical
codes is *equivalent* to the CSS commutation condition `H_X H_Zᵀ = 0`. -/
theorem rowSpace_le_code_iff (Hx : Matrix mx N K) (Hz : Matrix mz N K) :
    rowSpace Hz ≤ code Hx ↔ Hx * Hzᵀ = 0 := by
  classical
  constructor
  · intro h
    ext i j
    have hmem : (Hzᵀ *ᵥ (Pi.single j 1 : mz → K)) ∈ rowSpace Hz := ⟨_, rfl⟩
    have hz := h hmem
    rw [mem_code, mulVec_mulVec] at hz
    have hij := congrFun hz i
    simpa [Matrix.mulVec, dotProduct, Pi.single_apply] using hij
  · rintro h _ ⟨y, rfl⟩
    rw [mem_code, Matrix.mulVecLin_apply, mulVec_mulVec, h]
    simp

omit [Fintype mx] [Fintype mz] in
/-- **`X ↔ Z` symmetry.**  The commutation condition is symmetric in the two
parity-check matrices, hence so is the inclusion of classical codes. -/
theorem commutation_symm (Hx : Matrix mx N K) (Hz : Matrix mz N K) :
    Hx * Hzᵀ = 0 ↔ Hz * Hxᵀ = 0 := by
  constructor <;> intro h
  · have := congrArg Matrix.transpose h
    rwa [transpose_mul, transpose_transpose, transpose_zero] at this
  · have := congrArg Matrix.transpose h
    rwa [transpose_mul, transpose_transpose, transpose_zero] at this

/-! ## The chain complex attached to a pair of parity checks -/

/-- **Dictionary, part 2.**  A commuting pair of parity-check matrices is the
same thing as a length-two chain complex `𝔽^{m_Z} --H_Zᵀ--> 𝔽^N --H_X--> 𝔽^{m_X}`. -/
noncomputable def cssComplex (Hx : Matrix mx N K) (Hz : Matrix mz N K)
    (h : Hx * Hzᵀ = 0) : CSSComplex K (mz → K) (N → K) (mx → K) where
  d2 := Hzᵀ.mulVecLin
  d1 := Hx.mulVecLin
  comp_eq_zero := by
    ext y i
    simp only [LinearMap.comp_apply, Matrix.mulVecLin_apply, mulVec_mulVec, h,
      LinearMap.zero_apply, Matrix.zero_mulVec, Pi.zero_apply]

omit [Fintype mx] in
@[simp] lemma cssComplex_cycles (Hx : Matrix mx N K) (Hz : Matrix mz N K)
    (h : Hx * Hzᵀ = 0) : (cssComplex Hx Hz h).cycles = code Hx := rfl

omit [Fintype mx] in
@[simp] lemma cssComplex_boundaries (Hx : Matrix mx N K) (Hz : Matrix mz N K)
    (h : Hx * Hzᵀ = 0) : (cssComplex Hx Hz h).boundaries = rowSpace Hz := rfl

omit [Fintype mx] in
/-- **The logical space is the quotient `C₁/C₂`.**  Stated as the dimension
identity `k + dim C₂ = dim C₁`, with `C₁ = code H_X ⊇ C₂ = rowSpace H_Z`. -/
theorem cssComplex_numLogical_quotient (Hx : Matrix mx N K) (Hz : Matrix mz N K)
    (h : Hx * Hzᵀ = 0) :
    (cssComplex Hx Hz h).numLogical + finrank K (rowSpace Hz) = finrank K (code Hx) :=
  (cssComplex Hx Hz h).finrank_homology_add_boundaries

/-- The dimension of the row space is the rank of the matrix. -/
lemma finrank_rowSpace (H : Matrix m N K) : finrank K (rowSpace H) = H.rank := by
  rw [← Matrix.rank_transpose]
  rfl

omit [Fintype mx] in
/-- **The CSS count.**  `k + rank H_X + rank H_Z = N`. -/
theorem cssComplex_numLogical_add (Hx : Matrix mx N K) (Hz : Matrix mz N K)
    (h : Hx * Hzᵀ = 0) :
    (cssComplex Hx Hz h).numLogical + Hx.rank + Hz.rank = Fintype.card N := by
  have hmain := (cssComplex Hx Hz h).numLogical_add
  have h1 : finrank K (LinearMap.range (cssComplex Hx Hz h).d1) = Hx.rank := rfl
  have h2 : finrank K (LinearMap.range (cssComplex Hx Hz h).d2) = Hz.rank :=
    finrank_rowSpace Hz
  rw [h1, h2, Module.finrank_fintype_fun_eq_card] at hmain
  exact hmain

/-! ## The stabilizer group -/

section Stabilizer

variable {N : Type*} [Fintype N]

/-- The **symplectic (Pauli commutation) form** on `𝔽₂^N × 𝔽₂^N`: a phase-free
Pauli operator is a pair `(a, b)` (its `X`-part and `Z`-part), and two such
operators commute iff this form vanishes on them. -/
def symp : ((N → ZMod 2) × (N → ZMod 2)) →ₗ[ZMod 2]
    ((N → ZMod 2) × (N → ZMod 2)) →ₗ[ZMod 2] ZMod 2 :=
  LinearMap.mk₂ (ZMod 2) (fun p q => p.1 ⬝ᵥ q.2 + q.1 ⬝ᵥ p.2)
    (by intro p₁ p₂ q; simp [add_dotProduct, dotProduct_add]; ring)
    (by intro c p q; simp [smul_dotProduct, dotProduct_smul, smul_eq_mul]; ring)
    (by intro p q₁ q₂; simp [add_dotProduct, dotProduct_add]; ring)
    (by intro c p q; simp [smul_dotProduct, dotProduct_smul, smul_eq_mul]; ring)

@[simp] lemma symp_apply (p q : (N → ZMod 2) × (N → ZMod 2)) :
    symp p q = p.1 ⬝ᵥ q.2 + q.1 ⬝ᵥ p.2 := rfl

/-- The generators of the CSS stabilizer group: the `X`-type Pauli operators
given by the rows of `H_X`, and the `Z`-type ones given by the rows of `H_Z`. -/
def stabGens (Hx : Matrix mx N (ZMod 2)) (Hz : Matrix mz N (ZMod 2)) :
    Set ((N → ZMod 2) × (N → ZMod 2)) :=
  Set.range (fun i : mx => (Hx i, (0 : N → ZMod 2))) ∪
    Set.range (fun j : mz => ((0 : N → ZMod 2), Hz j))

/-- The **stabilizer group** of the CSS code, written additively as the
`𝔽₂`-span of its generators inside the phase-free Pauli group. -/
def stab (Hx : Matrix mx N (ZMod 2)) (Hz : Matrix mz N (ZMod 2)) :
    Submodule (ZMod 2) ((N → ZMod 2) × (N → ZMod 2)) :=
  Submodule.span (ZMod 2) (stabGens Hx Hz)

/-- Isotropy of a span follows from isotropy on generators. -/
lemma isotropic_span {G : Set ((N → ZMod 2) × (N → ZMod 2))}
    (hG : ∀ g ∈ G, ∀ h ∈ G, symp g h = 0) :
    ∀ p ∈ Submodule.span (ZMod 2) G, ∀ q ∈ Submodule.span (ZMod 2) G, symp p q = 0 := by
  have hgen : ∀ g ∈ G, ∀ q ∈ Submodule.span (ZMod 2) G, symp g q = 0 := by
    intro g hg
    have : Submodule.span (ZMod 2) G ≤ LinearMap.ker (symp g) := by
      rw [Submodule.span_le]
      intro h hh
      exact hG g hg h hh
    intro q hq
    exact this hq
  intro p hp q hq
  have : Submodule.span (ZMod 2) G ≤ LinearMap.ker (symp.flip q) := by
    rw [Submodule.span_le]
    intro g hg
    simpa using hgen g hg q hq
  simpa using this hp

omit [Fintype mx] [Fintype mz] in
/-- **Dictionary, part 3.**  The CSS stabilizer group is abelian (isotropic for
the Pauli commutation form) **iff** the parity-check matrices satisfy
`H_X H_Zᵀ = 0`.  Together with `rowSpace_le_code_iff` this closes the triangle
`C₂ ⊆ C₁  ⟺  H_X H_Zᵀ = 0  ⟺  stabilizer abelian`. -/
theorem stabilizer_isotropic_iff (Hx : Matrix mx N (ZMod 2)) (Hz : Matrix mz N (ZMod 2)) :
    (∀ p ∈ stab Hx Hz, ∀ q ∈ stab Hx Hz, symp p q = 0) ↔ Hx * Hzᵀ = 0 := by
  constructor
  · intro h
    ext i j
    have hx : ((Hx i, (0 : N → ZMod 2)) : (N → ZMod 2) × (N → ZMod 2)) ∈ stab Hx Hz :=
      Submodule.subset_span (Or.inl ⟨i, rfl⟩)
    have hz : (((0 : N → ZMod 2), Hz j) : (N → ZMod 2) × (N → ZMod 2)) ∈ stab Hx Hz :=
      Submodule.subset_span (Or.inr ⟨j, rfl⟩)
    have := h _ hx _ hz
    simpa [Matrix.mul_apply, dotProduct] using this
  · intro h
    apply isotropic_span
    rintro g (⟨i, rfl⟩ | ⟨i, rfl⟩) p (⟨j, rfl⟩ | ⟨j, rfl⟩)
    · simp
    · have : (Hx * Hzᵀ) i j = 0 := by rw [h]; rfl
      simpa [Matrix.mul_apply, dotProduct] using this
    · have : (Hx * Hzᵀ) j i = 0 := by rw [h]; rfl
      simp only [symp_apply, dotProduct_zero, zero_add]
      simpa [Matrix.mul_apply, dotProduct] using this
    · simp

omit [Fintype mx] in
/-- The full triangle of the CSS dictionary. -/
theorem css_dictionary (Hx : Matrix mx N (ZMod 2)) (Hz : Matrix mz N (ZMod 2)) :
    (rowSpace Hz ≤ code Hx ↔ Hx * Hzᵀ = 0) ∧
    (Hx * Hzᵀ = 0 ↔ (∀ p ∈ stab Hx Hz, ∀ q ∈ stab Hx Hz, symp p q = 0)) :=
  ⟨rowSpace_le_code_iff Hx Hz, (stabilizer_isotropic_iff Hx Hz).symm⟩

end Stabilizer

end CSSDictionary
end HQECC