/-
# Optimality, self-similarity and waiting times for prefix-sum fair schedules

A companion to `Novelty.FairSchedulePrefixBatches`.  Building on the master counting
formula `cnt_eq` proved there, this file establishes four further structural facts about
the block schedule generated by the prefix sums of a positive rate profile.

* `owner_uniform` : for the uniform profile the block schedule *is* round robin, `t ↦ t % k`.
* `fair_lower_bound` / `roundRobin_optimal` : every schedule overshoots by at least
  `total r k - r (f 0)` at the very first slot; for the uniform profile this matches the
  `k - 1` bound achieved by round robin, so round robin is exactly optimal.
* `owner_scaled` : scaling all rates by `m` reparametrises the schedule by `t ↦ t / m`
  (self-similarity of the prefix-sum construction).
* `exists_service_in_short_window` : the sharp bounded-waiting statement — each client is
  served in every window of `total r k - r i + 1` slots.
* `bres_periodic`, `bres_period_exact` : the two-client Bresenham schedule is periodic and
  realises the same exact-rate batches as the block schedule, while (by `bres_isFair`)
  keeping the discrepancy below one unit.
-/
import Novelty.FairSchedulePrefixBatches
import Mathlib.Algebra.BigOperators.Ring.Finset

namespace FairSchedule

open Finset

/-! ## Round robin is the uniform block schedule -/

lemma pre_uniform (i : ℕ) : pre (fun _ => 1) i = i := by simp [pre]

lemma total_uniform (k : ℕ) : total (fun _ => (1:ℕ)) k = k := by simp [total, pre]

theorem owner_uniform {k : ℕ} (hk : 0 < k) (t : ℕ) : owner (fun _ => 1) k t = t % k := by
  have htot : total (fun _ => (1:ℕ)) k = k := total_uniform k
  have hs : t % total (fun _ => (1:ℕ)) k < total (fun _ => (1:ℕ)) k := Nat.mod_lt _ (by omega)
  unfold owner
  refine blockIndex_unique hs ?_ ?_
  · rw [pre_uniform, htot]
  · rw [pre_uniform, htot]
    omega

/-! ## A universal lower bound for every schedule -/

lemma schedCnt_one_self (f : ℕ → ℕ) : schedCnt f (f 0) 1 = 1 := by
  have hfil : (Finset.range 1).filter (fun u => f u = f 0) = Finset.range 1 := by
    apply Finset.filter_true_of_mem
    intro x hx
    simp only [Finset.mem_range, Nat.lt_one_iff] at hx
    rw [hx]
  unfold schedCnt
  rw [hfil]
  simp

/-- **Universal lower bound.**  Whatever the schedule, the client served in the very first
slot immediately overshoots its share by `total r k - r (f 0)`; hence no schedule can be
fairer than that. -/
theorem fair_lower_bound {r : ℕ → ℕ} {k B : ℕ} {f : ℕ → ℕ} (hf : ∀ t, f t < k)
    (hfair : IsFair f r k B) : total r k - r (f 0) ≤ B := by
  have h := hfair (f 0) (hf 0) 1
  rw [schedCnt_one_self] at h
  rw [abs_le] at h
  have h2 := h.2
  push_cast at h2
  have : (total r k : ℤ) - r (f 0) ≤ (B : ℤ) := by linarith
  omega

/-- **Optimality of round robin.**  For the uniform profile the block schedule is round robin,
it is `(k-1)`-fair, and no schedule can do better. -/
theorem roundRobin_optimal {k : ℕ} (hk : 0 < k) :
    IsFair (owner (fun _ => 1) k) (fun _ => 1) k (k - 1) ∧
      ∀ (f : ℕ → ℕ) (B : ℕ), (∀ t, f t < k) → IsFair f (fun _ => 1) k B → k - 1 ≤ B := by
  have htot : total (fun _ => (1:ℕ)) k = k := total_uniform k
  constructor
  · intro i hi t
    have h := cnt_disc_abs (r := fun _ => (1:ℕ)) (k := k) (by omega) hi t
    simp only [cnt] at h
    rw [htot] at h ⊢
    have hc : ((k - 1 : ℕ) : ℤ) = (k : ℤ) - 1 := by
      have : (1:ℕ) ≤ k := hk
      push_cast [Nat.cast_sub this]
      ring
    rw [hc]
    simpa using h
  · intro f B hf hfair
    have h := fair_lower_bound hf hfair
    rw [htot] at h
    simpa using h

/-! ## Self-similarity of the block schedule under scaling of the rates -/

lemma pre_scaled (m : ℕ) (r : ℕ → ℕ) (i : ℕ) :
    pre (fun j => m * r j) i = m * pre r i := by
  simp [pre, Finset.mul_sum]

lemma blockIndex_scaled {m : ℕ} (hm : 0 < m) (r : ℕ → ℕ) (k s : ℕ) :
    blockIndex (fun j => m * r j) k s = blockIndex r k (s / m) := by
  unfold blockIndex
  congr 1
  apply Finset.filter_congr
  intro i _
  simp only [pre_scaled]
  rw [Nat.le_div_iff_mul_le hm, Nat.mul_comm]

/-- **Scaling self-similarity.**  Multiplying every rate by `m` slows the block schedule down
by exactly the factor `m`. -/
theorem owner_scaled {m : ℕ} (hm : 0 < m) (r : ℕ → ℕ) (k t : ℕ) :
    owner (fun j => m * r j) k t = owner r k (t / m) := by
  unfold owner
  rw [blockIndex_scaled hm]
  congr 1
  have htot : total (fun j => m * r j) k = m * total r k := pre_scaled m r k
  rw [htot, Nat.mod_mul_right_div_self]

/-! ## Sharp bounded waiting time -/

lemma owner_of_mem_block {r : ℕ → ℕ} {k i x : ℕ}
    (hx1 : pre r i ≤ x) (hx2 : x < pre r (i + 1)) (hxR : x < total r k) (q : ℕ) :
    owner r k (total r k * q + x) = i := by
  have hmod : (total r k * q + x) % total r k = x := by
    rw [Nat.mul_add_mod]
    exact Nat.mod_eq_of_lt hxR
  unfold owner
  rw [hmod]
  exact blockIndex_unique hxR hx1 hx2

/-- **Sharp bounded waiting.**  Client `i` is served at least once in every window of
`total r k - r i + 1` consecutive slots; the window cannot be shortened, since the schedule
serves client `i` in one contiguous batch per period. -/
theorem exists_service_in_short_window {r : ℕ → ℕ} {k i : ℕ} (hk : 0 < total r k) (hi : i < k)
    (hri : 0 < r i) (t : ℕ) :
    ∃ s, t ≤ s ∧ s < t + (total r k - r i + 1) ∧ owner r k s = i := by
  have hps : pre r (i + 1) = pre r i + r i := pre_succ r i
  have h2 : pre r i + r i ≤ total r k := by
    have := @pre_le_total r k (i + 1) hi
    omega
  have hdm : total r k * (t / total r k) + t % total r k = t := Nat.div_add_mod t _
  have hmod : t % total r k < total r k := Nat.mod_lt _ hk
  rcases Nat.lt_or_ge (t % total r k) (pre r i) with hc | hc
  · refine ⟨total r k * (t / total r k) + pre r i, by omega, by omega, ?_⟩
    exact owner_of_mem_block (le_refl _) (by omega) (by omega) _
  · rcases Nat.lt_or_ge (t % total r k) (pre r (i + 1)) with hc2 | hc2
    · refine ⟨t, le_refl _, by omega, ?_⟩
      have := owner_of_mem_block hc hc2 hmod (t / total r k)
      rwa [hdm] at this
    · refine ⟨total r k * (t / total r k + 1) + pre r i, by nlinarith [hdm, hmod, hc2], ?_, ?_⟩
      · have : total r k * (t / total r k + 1) + pre r i
            = t + (total r k - t % total r k + pre r i) := by
          rw [Nat.mul_add, Nat.mul_one]
          omega
        omega
      · exact owner_of_mem_block (le_refl _) (by omega) (by omega) _

/-! ## The Bresenham schedule also realises the exact-rate batches -/

theorem bres_periodic {a R : ℕ} (hR : 0 < R) (t : ℕ) : bres a R (t + R) = bres a R t := by
  have h1 : (t + R) * a / R = t * a / R + a := by
    have : (t + R) * a = t * a + a * R := by ring
    rw [this, Nat.add_mul_div_right _ _ hR]
  have h2 : (t + R + 1) * a / R = (t + 1) * a / R + a := by
    have : (t + R + 1) * a = (t + 1) * a + a * R := by ring
    rw [this, Nat.add_mul_div_right _ _ hR]
  unfold bres
  rw [h1, h2]
  simp

theorem bres_period_exact {a R : ℕ} (ha : a ≤ R) (hR : 0 < R) (n : ℕ) :
    schedCnt (bres a R) 0 (n * R) = n * a ∧ schedCnt (bres a R) 1 (n * R) = n * (R - a) := by
  have hd : n * R * a / R = n * a := by
    have : n * R * a = R * (n * a) := by ring
    rw [this, Nat.mul_div_cancel_left _ hR]
  refine ⟨by rw [bres_cnt0 ha hR, hd], ?_⟩
  rw [bres_cnt1 ha hR, hd]
  rw [Nat.mul_sub]

end FairSchedule