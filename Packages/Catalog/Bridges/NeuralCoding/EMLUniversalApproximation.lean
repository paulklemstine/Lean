import Mathlib

/-! # EML Universal Approximation via Stone-Weierstrass

This file records the precise Stone–Weierstrass consequence available for EML
expressions.  The generated algebra consists of finite algebraic combinations of
an injective EML feature.  It is dense on a compact domain.

An earlier draft stated that a *single* function `a * exp (b*x)` approximates every
continuous function.  That assertion is false (a nonzero such function has constant
sign), so the original declaration is retained below in a comment and replaced by
the generated-algebra statement.  The draft also asserted the substantially stronger
single-hidden-layer logistic universal approximation theorem without developing its
required analytic machinery.  It too is retained in a comment, followed by the exact
Stone–Weierstrass formulation proved here.
-/

noncomputable section

open Real

namespace EMLUniversalApproximation

open scoped unitInterval

/-- If a real subalgebra of continuous functions on a compact space separates points,
its closure is the whole continuous-function algebra. -/
theorem stone_weierstrass_statement {X : Type*} [TopologicalSpace X] [CompactSpace X]
    (A : Subalgebra ℝ C(X, ℝ))
    (h_sep : A.SeparatesPoints) :
    A.topologicalClosure = ⊤ :=
  ContinuousMap.subalgebra_topologicalClosure_eq_top_of_separatesPoints A h_sep

/-- The continuous exponential feature on the unit interval. -/
def unitIntervalExp : C(unitInterval, ℝ) where
  toFun x := Real.exp (x : ℝ)
  continuous_toFun := Real.continuous_exp.comp continuous_subtype_val

/-- The algebra generated by one exponential feature separates points. -/
theorem unitIntervalExp_adjoin_separates :
    (Algebra.adjoin ℝ ({unitIntervalExp} : Set C(unitInterval, ℝ))).SeparatesPoints := by
  intro x y hxy
  refine ⟨unitIntervalExp, ?_, ?_⟩
  · exact Set.mem_image_of_mem _ (Algebra.subset_adjoin (Set.mem_singleton _))
  · exact fun h => hxy (Subtype.ext (Real.exp_injective h))

/-- Finite algebraic combinations of the exponential feature are dense on `[0,1]`. -/
theorem unitIntervalExp_adjoin_dense :
    (Algebra.adjoin ℝ ({unitIntervalExp} : Set C(unitInterval, ℝ))).topologicalClosure = ⊤ := by
  exact stone_weierstrass_statement _ unitIntervalExp_adjoin_separates

/-
The original (false) draft was:

```
theorem eml_approximates_continuous_on_unit_interval
    (f : C(unitInterval, ℝ)) (ε : ℝ) (hε : 0 < ε) :
    ∃ g : unitInterval → ℝ,
      (∃ a b : ℝ, g = fun x => a * exp (b * (x : ℝ))) ∧
      ∀ x : unitInterval, |g x - f x| < ε
```

A single scaled exponential cannot approximate, for example, a continuous function
which is uniformly positive at one point and uniformly negative at another.
-/

/-- Correct universal-approximation statement: every continuous function belongs to
the closure of the finite algebraic combinations of the EML exponential feature. -/
theorem eml_approximates_continuous_on_unit_interval
    (f : C(unitInterval, ℝ)) :
    f ∈ (Algebra.adjoin ℝ ({unitIntervalExp} : Set C(unitInterval, ℝ))).topologicalClosure := by
  rw [unitIntervalExp_adjoin_dense]
  trivial

/-- The fixed-point premise in the old draft is inconsistent over the reals.  This
lemma makes that fact explicit rather than presenting it as point separation. -/
theorem no_continuous_real_fixed_point_of_exp {X : Type*} [TopologicalSpace X]
    [CompactSpace X] [Nonempty X]
    (f : C(X, ℝ)) (hf : ∀ t : X, f t = exp (f t)) : False := by
  let x : X := Classical.choice inferInstance
  by_cases hx : f x = 0
  · have h := hf x
    rw [hx, Real.exp_zero] at h
    norm_num at h
  · have hlt := Real.add_one_lt_exp hx
    rw [← hf x] at hlt
    linarith

/-
The previous `exp_separates_points_real` used the impossible premise
`∀ t, f t = exp (f t)` and did not assume that `f` itself separates `x` and `y`.
Its conclusion was therefore only vacuously true.  The actual separation theorem is
`EMLStoneWeierstrassBridge.exp_separates` (or `unitIntervalExp_adjoin_separates`).
-/

/-- A general closure-level Stone–Weierstrass approximation consequence. -/
theorem eml_universal_approximation {X : Type*} [TopologicalSpace X] [CompactSpace X]
    (A : Subalgebra ℝ C(X, ℝ)) (hA : A.SeparatesPoints) (f : C(X, ℝ)) :
    f ∈ A.topologicalClosure := by
  rw [stone_weierstrass_statement A hA]
  trivial

/-
The original draft also gave, with no supporting development, the stronger theorem
that every continuous function on `[0,1]` is approximated by a finite *linear sum* of
logistic ridge functions.  Stone–Weierstrass for the generated algebra does not by
itself identify every algebra element with that restricted one-layer architecture,
so that declaration is not silently claimed here.
-/

/-- Precise EML-network consequence proved by this file: the algebra generated by the
logistic feature is dense on any compact space on which that feature is injective. -/
theorem eml_network_approximates_continuous {X : Type*} [TopologicalSpace X]
    [CompactSpace X] (feature : C(X, ℝ)) (hfeature : Function.Injective feature)
    (f : C(X, ℝ)) :
    f ∈ (Algebra.adjoin ℝ ({feature} : Set C(X, ℝ))).topologicalClosure := by
  apply eml_universal_approximation
  intro x y hxy
  refine ⟨feature, ?_, ?_⟩
  · exact Set.mem_image_of_mem _ (Algebra.subset_adjoin (Set.mem_singleton _))
  · exact hfeature.ne hxy

end EMLUniversalApproximation