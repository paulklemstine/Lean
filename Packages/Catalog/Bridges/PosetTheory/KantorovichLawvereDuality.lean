import Mathlib

/-!
# Kantorovich Duality for Lawvere–EML Closure Dynamics

This file develops a self-contained formal theory of asymmetric optimal-transport-style
duality for EML closure systems. The central construction is a **Lawvere quasi-metric**
generated by weighted derivations, together with a **Kantorovich-style dual representation**
by 1-Lipschitz observables.

## Main results

1. `WeightedGenerator` and `Reachable` define weighted one-step derivation systems and
   reachability witnesses.
2. `DerivationCost` computes the infimum cost over all derivation chains (tropical
   shortest-path distance).
3. `derivationCost_triangle` proves the triangle inequality, establishing a Lawvere
   quasi-metric structure.
4. `kantorovich_lawvere_duality` proves the central duality: distance equals the
   supremum of differences over 1-Lipschitz observables.
5. `iterative_closure_convergence_bound` provides geometric convergence rates for
   contractive closure dynamics.

## Cross-domain bridges

- **Tropical geometry**: `DerivationCost` is the tropical (min-plus) shortest-path distance
- **Optimal transport**: Kantorovich duality via Lipschitz observables
- **Cryptography**: Closure defect as post-quantum security measure
- **ML**: Lipschitz-certified robustness via dual certificates
- **Thermodynamics**: Asymmetry of Lawvere metric encodes irreversibility

## References

- F.W. Lawvere, *Metric spaces, generalized logic, and closed categories* (1973)
- C. Villani, *Optimal Transport: Old and New* (2009)
-/

open scoped ENNReal
open Set

noncomputable section

namespace KantorovichLawvere

-- ════════════════════════════════════════════════════════════════════════════
-- SECTION 1: Core Algebraic Structures
-- ════════════════════════════════════════════════════════════════════════════

/-- A Lawvere quasi-metric: asymmetric extended distance with reflexivity
and triangle inequality. Unlike a standard metric, `d(x,y) ≠ d(y,x)` in general,
capturing irreversibility.

Bridge: connects enriched category theory (Lawvere metrics) to thermodynamic
irreversibility and quantum channel costs. -/
structure LawvereQDist (α : Type*) where
  d : α → α → ℝ≥0∞
  d_self : ∀ x, d x x = 0
  d_triangle : ∀ x y z, d x z ≤ d x y + d y z

/-- Weighted one-step derivation system: a directed graph with costs on edges.

Bridge: connects EML derivation semantics to tropical shortest-path geometry
and cryptographic state-transition costs. -/
structure WeightedGenerator (α : Type*) where
  step : α → α → Prop
  cost : α → α → ℝ≥0∞
  cost_top_of_not_step : ∀ {x y}, ¬step x y → cost x y = ⊤
  step_refl : ∀ x, step x x
  cost_refl : ∀ x, cost x x = 0

/-- Finitely branching weighted generator for algorithmic applications.

Bridge: connects to Bellman-Ford style shortest-path computation and
tropical value iteration with `O(|V|·|E|)` complexity. -/
structure FinBranchGenerator (α : Type*) extends WeightedGenerator α where
  succFinset : α → Finset α
  mem_succFinset : ∀ {x y}, y ∈ succFinset x ↔ step x y

/-- EML closure operator: extensive, monotone, idempotent.

Bridge: connects lattice theory to EML semantics and algebraic fixed-point theory. -/
structure EMLClosure (α : Type*) where
  cl : Set α → Set α
  extensive : ∀ s, s ⊆ cl s
  mono : ∀ ⦃s t⦄, s ⊆ t → cl s ⊆ cl t
  idem : ∀ s, cl (cl s) ⊆ cl s

-- ════════════════════════════════════════════════════════════════════════════
-- SECTION 2: Reachability and Derivation Cost
-- ════════════════════════════════════════════════════════════════════════════

/-- Reachability with cost bound: an inductive relation capturing finite
derivation chains from `x` to `y` with total cost at most `c`.

Bridge: connects to tropical path enumeration and certified derivation chains. -/
inductive Reachable {α : Type*} (G : WeightedGenerator α) : α → α → ℝ≥0∞ → Prop where
  | refl (x : α) : Reachable G x x 0
  | step {x y z : α} {c : ℝ≥0∞} (hs : G.step x y)
    (hr : Reachable G y z c) : Reachable G x z (G.cost x y + c)

/-- Concatenation of reachability chains: if `x` reaches `y` at cost `c₁`
and `y` reaches `z` at cost `c₂`, then `x` reaches `z` at cost `c₁ + c₂`. -/
theorem reachable_trans {α : Type*} {G : WeightedGenerator α} {x y z : α}
    {c₁ c₂ : ℝ≥0∞}
    (h1 : Reachable G x y c₁) (h2 : Reachable G y z c₂) :
    Reachable G x z (c₁ + c₂) := by
  induction h1 with
  | refl => simpa using h2
  | step hs _ ih => rw [add_assoc]; exact Reachable.step hs (ih h2)

/-- Derivation cost: infimum cost over all reachability chains. This is the
tropical (min-plus) shortest-path distance in the derivation graph.

Bridge: connects EML derivation to Lawvere enriched category distance and
min-plus algebraic shortest paths. -/
def DerivationCost {α : Type*} (G : WeightedGenerator α) (x y : α) : ℝ≥0∞ :=
  sInf {c | Reachable G x y c}

-- ════════════════════════════════════════════════════════════════════════════
-- SECTION 3: Closure-Aware Lawvere Metric and Observables
-- ════════════════════════════════════════════════════════════════════════════

/-- Closure-aware Lawvere metric: derivation cost as asymmetric distance.

Bridge: connects enriched category theory / Lawvere metrics to
thermodynamic irreversibility in closure dynamics. -/
def ClosureLawvereMetric {α : Type*} (_C : EMLClosure α) (G : WeightedGenerator α)
    (x y : α) : ℝ≥0∞ :=
  DerivationCost G x y

/-- One-sided 1-Lipschitz condition for asymmetric metrics:
`f(x) - f(y) ≤ d(x,y)` for all `x, y`.

Bridge: connects Kantorovich duality to certified robustness bounds. -/
def IsLawvereLipschitz {α : Type*} (d : α → α → ℝ≥0∞) (f : α → ℝ) : Prop :=
  ∀ x y, f x - f y ≤ (d x y).toReal

/-- Lipschitz EML observable: 1-Lipschitz function compatible with closure ordering.

Bridge: connects Kantorovich duality to certified neural robustness
(lipschitz_certified_robustness) and post_quantum_security certificates. -/
structure LipschitzEMLObservable (α : Type*) (C : EMLClosure α)
    (d : α → α → ℝ≥0∞) where
  toFun : α → ℝ
  lipschitz : IsLawvereLipschitz d toFun
  closure_mono : ∀ x y, y ∈ C.cl ({x} : Set α) → toFun y ≤ toFun x

-- ════════════════════════════════════════════════════════════════════════════
-- SECTION 4: Derived Structures
-- ════════════════════════════════════════════════════════════════════════════

/-- Observable gap supremum: dual value for Kantorovich duality.
This is `sup { f(x) - f(y) | f is 1-Lipschitz }`. -/
def observableGap {α : Type*} (d : α → α → ℝ≥0∞) (x y : α) : ℝ :=
  sSup {r : ℝ | ∃ f : α → ℝ, IsLawvereLipschitz d f ∧ r = f x - f y}

/-- Closure defect to a target set: distance from a point to the nearest point
in a target set T.

Bridge: connects optimal transport defect to ML certified robustness and
lattice cryptographic security margins. -/
def closureDefectToSet {α : Type*} (d : α → α → ℝ≥0∞)
    (x : α) (T : Set α) : ℝ≥0∞ :=
  ⨅ (y : α) (_ : y ∈ T), d x y

/-- Iterates of a closure operator. -/
def closureIterate {α : Type*} (C : EMLClosure α) : ℕ → Set α → Set α
  | 0 => id
  | n + 1 => C.cl ∘ closureIterate C n

/-- Contractive closure dynamics with guaranteed geometric convergence rate.

Bridge: connects fixed-point iteration to thermodynamic relaxation rates
and algorithmic convergence certificates. -/
structure ContractiveClosureDynamics where
  defectBound : ℝ
  contractionFactor : ℝ
  defectBound_nonneg : 0 ≤ defectBound
  contraction_nonneg : 0 ≤ contractionFactor
  contraction_lt_one : contractionFactor < 1
  defect : ℕ → ℝ
  defect_nonneg : ∀ n, 0 ≤ defect n
  defect_zero_le : defect 0 ≤ defectBound
  defect_contract : ∀ n, defect (n + 1) ≤ contractionFactor * defect n

/-- Thermodynamic asymmetry index: measures irreversibility of the
asymmetric Lawvere distance.

Bridge: connects Lawvere metric asymmetry to the quantum thermodynamic arrow
of time and irreversibility certificates. -/
def ThermodynamicAsymmetryIndex {α : Type*} (d : α → α → ℝ≥0∞)
    (x y : α) : ℝ :=
  (d x y).toReal - (d y x).toReal

/-- Tropical Bellman potential: the distance-to-target function viewed as a
min-plus potential. This is the canonical dual witness for Kantorovich duality.

Bridge: connects min-plus algebra, dynamic programming, and quantum control
cost semantics. -/
def TropicalBellmanPotential {α : Type*} (d : α → α → ℝ≥0∞)
    (target : α) (x : α) : ℝ :=
  (d x target).toReal

/-- Certified robustness witness: packages a Lipschitz observable with a safety
margin for certified ML robustness.

Bridge: connects optimal transport duality to neural network robustness
certification and lipschitz_certified_robustness. -/
structure CertifiedRobustnessWitness (α : Type*) (d : α → α → ℝ≥0∞) where
  observable : α → ℝ
  observable_lipschitz : IsLawvereLipschitz d observable
  safeThreshold : ℝ
  safeSet : Set α
  safe_iff : ∀ x, x ∈ safeSet ↔ observable x ≤ safeThreshold

/-- Lattice attack surface: closure defect measuring post-quantum security
margin in a lattice-based cryptographic system.

Bridge: connects lattice shortest-vector problems to EML closure defect for
post_quantum_security analysis. -/
def LatticeAttackSurface {α : Type*} (d : α → α → ℝ≥0∞)
    (secureBasis : Set α) (x : α) : ℝ≥0∞ :=
  closureDefectToSet d x secureBasis

/-- Quantum certified gap: measures the duality gap. Under exact duality
this gap vanishes.

Bridge: connects Kantorovich duality gap to quantum thermodynamic cost
and post_quantum_security certificates. -/
def QuantumCertifiedGap {α : Type*} (d : α → α → ℝ≥0∞)
    (x y : α) : ℝ :=
  (d x y).toReal - observableGap d x y

/-- Safe-set certified observable: an observable that vanishes on a safe set
and provides dual certificates for closure defect.

Bridge: connects to lipschitz_certified_robustness and post_quantum_security
via dual certificate observables. -/
structure SafeSetCertifiedObservable (α : Type*) (d : α → α → ℝ≥0∞) where
  toFun : α → ℝ
  lipschitz : IsLawvereLipschitz d toFun
  safeSet : Set α
  vanish_on_safe : ∀ x ∈ safeSet, toFun x = 0

-- ════════════════════════════════════════════════════════════════════════════
-- SECTION 5: Derivation Cost Properties
-- ════════════════════════════════════════════════════════════════════════════

/-- DerivationCost is bounded by any reachability witness. -/
theorem derivationCost_le_of_reachable {α : Type*} {G : WeightedGenerator α}
    {x y : α} {c : ℝ≥0∞} (h : Reachable G x y c) :
    DerivationCost G x y ≤ c :=
  sInf_le h

/-- DerivationCost from a point to itself is zero. -/
theorem derivationCost_refl {α : Type*} (G : WeightedGenerator α) (x : α) :
    DerivationCost G x x = 0 :=
  le_antisymm (sInf_le (Reachable.refl x)) (zero_le _)

/-
**Triangle inequality** for derivation cost: the fundamental Lawvere
quasi-metric law. The proof concatenates reachability chains and uses
the Scott continuity of addition in `ℝ≥0∞`.

Bridge: connects EML derivation chains to tropical shortest-path composition.
-/
theorem derivationCost_triangle {α : Type*} (G : WeightedGenerator α)
    (x y z : α) :
    DerivationCost G x z ≤ DerivationCost G x y + DerivationCost G y z := by
  nontriviality;
  by_contra h_contra;
  obtain ⟨c₁, hc₁⟩ : ∃ c₁, Reachable G x y c₁ ∧ c₁ < DerivationCost G x z - DerivationCost G y z := by
    have := exists_lt_of_csInf_lt ( show { c : ℝ≥0∞ | Reachable G x y c }.Nonempty from ?_ ) ( show InfSet.sInf { c : ℝ≥0∞ | Reachable G x y c } < DerivationCost G x z - DerivationCost G y z from ?_ );
    · exact this;
    · by_cases h : ∃ c, Reachable G x y c <;> simp_all +decide [ DerivationCost ];
      exact h;
    · exact lt_tsub_iff_right.mpr ( lt_of_not_ge h_contra );
  obtain ⟨c₂, hc₂⟩ : ∃ c₂, Reachable G y z c₂ ∧ c₂ < DerivationCost G x z - c₁ := by
    have h₂ : DerivationCost G y z < DerivationCost G x z - c₁ := by
      rw [ lt_tsub_iff_left ] at *;
      rw [ add_comm ] ; aesop;
    exact sInf_lt_iff.mp h₂;
  have h_sum : DerivationCost G x z ≤ c₁ + c₂ := by
    exact derivationCost_le_of_reachable ( reachable_trans hc₁.1 hc₂.1 );
  rw [ lt_tsub_iff_left ] at *;
  grind

-- ════════════════════════════════════════════════════════════════════════════
-- SECTION 6: Lawvere Quasi-Metric from Generator
-- ════════════════════════════════════════════════════════════════════════════

/-- A weighted generator canonically induces a Lawvere quasi-metric structure. -/
def WeightedGenerator.toLawvereQDist {α : Type*} (G : WeightedGenerator α) :
    LawvereQDist α where
  d := DerivationCost G
  d_self := derivationCost_refl G
  d_triangle := derivationCost_triangle G

/-- Reflexivity of the closure-aware Lawvere metric. -/
theorem closureLawvereMetric_refl {α : Type*} (C : EMLClosure α)
    (G : WeightedGenerator α) (x : α) :
    ClosureLawvereMetric C G x x = 0 :=
  derivationCost_refl G x

/-- Triangle inequality for the closure-aware Lawvere metric. -/
theorem closureLawvereMetric_triangle {α : Type*} (C : EMLClosure α)
    (G : WeightedGenerator α) (x y z : α) :
    ClosureLawvereMetric C G x z ≤
      ClosureLawvereMetric C G x y + ClosureLawvereMetric C G y z :=
  derivationCost_triangle G x y z

/-
**Asymmetry witness**: for any two points, the asymmetry of the Lawvere
metric is precisely captured by a nonneg witness `δ`. This formalizes
measurable irreversibility: forward and reverse costs generally differ.

Bridge: connects to quantum thermodynamic asymmetry and post_quantum_security
one-way function hardness certificates.
-/
theorem closureLawvereMetric_asymmetry_witness {α : Type*}
    (C : EMLClosure α) (G : WeightedGenerator α) (x y : α) :
    ∃ δ : ℝ≥0∞,
      ClosureLawvereMetric C G x y + δ = ClosureLawvereMetric C G y x ∨
      ClosureLawvereMetric C G y x + δ = ClosureLawvereMetric C G x y := by
  by_contra! h;
  cases le_total ( ClosureLawvereMetric C G x y ) ( ClosureLawvereMetric C G y x ) <;> have := h 0 <;> simp_all +decide;
  · exact h ( ClosureLawvereMetric C G y x - ClosureLawvereMetric C G x y ) |>.1 ( by rw [ add_comm, tsub_add_cancel_of_le ‹_› ] );
  · exact h ( ClosureLawvereMetric C G x y - ClosureLawvereMetric C G y x ) |>.2 ( by rw [ add_comm, tsub_add_cancel_of_le ‹_› ] )

/-
════════════════════════════════════════════════════════════════════════════
SECTION 7: Lipschitz Observable Properties
════════════════════════════════════════════════════════════════════════════

The zero function is always 1-Lipschitz.
-/
theorem zero_isLawvereLipschitz {α : Type*} (d : α → α → ℝ≥0∞) :
    IsLawvereLipschitz d (fun _ => (0 : ℝ)) := by
  exact fun x y => by simp +decide ;

/-
Any constant function is 1-Lipschitz.
-/
theorem const_isLawvereLipschitz {α : Type*} (d : α → α → ℝ≥0∞) (c : ℝ) :
    IsLawvereLipschitz d (fun _ => c) := by
  exact fun x y => by simp +decide ;

/-- Basic Lipschitz bound: observable differences are bounded by distance. -/
theorem observable_diff_le_distance {α : Type*}
    {d : α → α → ℝ≥0∞} {f : α → ℝ} (hf : IsLawvereLipschitz d f) (x y : α) :
    f x - f y ≤ (d x y).toReal :=
  hf x y

/-
**The Tropical Bellman potential is 1-Lipschitz** when all distances are finite.
This is the key lemma for constructing the optimal dual witness in Kantorovich duality.

The proof uses the triangle inequality:
  `d(a, t) ≤ d(a, b) + d(b, t)` ⟹ `d(a, t) - d(b, t) ≤ d(a, b)`

Bridge: connects min-plus algebra to optimal transport duality.
-/
theorem tropicalBellmanPotential_lipschitz {α : Type*}
    (L : LawvereQDist α) (hfin : ∀ x y, L.d x y ≠ ⊤) (t : α) :
    IsLawvereLipschitz L.d (TropicalBellmanPotential L.d t) := by
  intro x y;
  rw [ sub_le_iff_le_add' ];
  have := L.d_triangle x y t;
  exact le_trans ( ENNReal.toReal_mono ( by aesop ) this ) ( by rw [ add_comm, ENNReal.toReal_add ] <;> aesop )

/-
The Bellman potential achieves exact distance at its target:
`f_t(x) - f_t(t) = d(x, t)` since `d(t, t) = 0`.
-/
theorem tropicalBellmanPotential_exact {α : Type*}
    (L : LawvereQDist α) (t : α) (x : α) :
    TropicalBellmanPotential L.d t x - TropicalBellmanPotential L.d t t =
      (L.d x t).toReal := by
  -- By definition of TropicalBellmanPotential, we have:
  simp [TropicalBellmanPotential];
  rw [ L.d_self, ENNReal.toReal_zero ]

/-
════════════════════════════════════════════════════════════════════════════
SECTION 8: Kantorovich Duality
════════════════════════════════════════════════════════════════════════════

**Weak duality**: the observable gap is bounded above by the distance.
Every 1-Lipschitz observable provides a lower bound on distance,
so their supremum cannot exceed the distance.
-/
theorem observableGap_le_distance {α : Type*}
    (d : α → α → ℝ≥0∞) (x y : α) :
    observableGap d x y ≤ (d x y).toReal := by
  exact csSup_le ⟨ _, ⟨ fun _ => 0, fun _ _ => by simp +decide, rfl ⟩ ⟩ fun r hr => by rcases hr with ⟨ f, hf, rfl ⟩ ; exact hf x y

/-
The observable gap is nonnegative (the zero function achieves 0).
-/
theorem observableGap_nonneg {α : Type*}
    (d : α → α → ℝ≥0∞) (x y : α) :
    0 ≤ observableGap d x y := by
  refine' le_csSup _ _;
  · exact ⟨ _, fun r hr => hr.choose_spec.2.symm ▸ observable_diff_le_distance hr.choose_spec.1 x y ⟩;
  · exact ⟨ fun _ => 0, fun _ _ => by simp +decide, by simp +decide ⟩

/-
**Kantorovich–Lawvere Duality Theorem**: For any Lawvere quasi-metric with
finite distances, the distance equals the supremum of differences over all
1-Lipschitz observables:

  `d(x, y) = sup { f(x) - f(y) | f is 1-Lipschitz w.r.t. d }`

The proof constructs an optimal dual witness via the Tropical Bellman Potential
`f_y(w) = d(w, y)`, achieving `f_y(x) - f_y(y) = d(x, y)`.

This is the asymmetric analogue of classical Kantorovich duality from optimal
transport theory, specialized to Lawvere quasi-metrics.

Bridge: connects optimal transport (Kantorovich) duality to enriched category
theory (Lawvere metrics), tropical geometry (shortest paths), and
lipschitz_certified_robustness via dual certificates.
-/
theorem kantorovich_lawvere_duality {α : Type*}
    (L : LawvereQDist α) (hfin : ∀ x y, L.d x y ≠ ⊤) (x y : α) :
    observableGap L.d x y = (L.d x y).toReal := by
  refine' csSup_eq_of_forall_le_of_forall_lt_exists_gt _ _ _ <;> norm_num;
  · exact ⟨ _, ⟨ fun _ => 0, zero_isLawvereLipschitz _, rfl ⟩ ⟩;
  · exact fun a f hf ha => ha ▸ hf x y;
  · refine' fun w hw => ⟨ _, ⟨ TropicalBellmanPotential L.d y, tropicalBellmanPotential_lipschitz L hfin y, rfl ⟩, hw.trans_le _ ⟩;
    exact le_of_eq ( Eq.symm ( tropicalBellmanPotential_exact L y x ) )

/-
════════════════════════════════════════════════════════════════════════════
SECTION 9: Closure Defect Theorems
════════════════════════════════════════════════════════════════════════════

A point in the target set has zero defect.
-/
theorem closureDefectToSet_self_mem {α : Type*}
    (d : α → α → ℝ≥0∞) (hrefl : ∀ x, d x x = 0)
    {x : α} {T : Set α} (hx : x ∈ T) :
    closureDefectToSet d x T = 0 := by
  exact le_antisymm ( by exact iInf₂_le x hx |> le_trans <| by simp +decide [ hrefl ] ) ( by exact zero_le _ )

/-
Defect satisfies a triangle inequality: defect to T from x is bounded by
distance from x to y plus defect from y to T.

Bridge: this is the defect-propagation estimate underlying
lipschitz_certified_robustness and convergence analysis.
-/
theorem closureDefectToSet_triangle {α : Type*}
    (L : LawvereQDist α) (x y : α) (T : Set α) :
    closureDefectToSet L.d x T ≤ L.d x y + closureDefectToSet L.d y T := by
  by_cases hT : ∀ a ∈ T, L.d y a = ⊤;
  · by_cases hT' : T.Nonempty <;> simp_all +decide [ closureDefectToSet ];
  · obtain ⟨a, haT, ha⟩ : ∃ a ∈ T, L.d y a ≠ ⊤ := by
      exact by push_neg at hT; exact hT;
    refine' le_of_forall_gt_imp_ge_of_dense fun r hr => _;
    -- By the definition of closureDefectToSet, there exists some $z \in T$ such that $L.d y z < r - L.d x y$.
    obtain ⟨z, hzT, hz⟩ : ∃ z ∈ T, L.d y z < r - L.d x y := by
      contrapose! hr;
      rw [ ← tsub_le_iff_left ];
      exact le_iInf₂ hr;
    refine' le_trans ( ciInf_le _ z ) _;
    · exact ⟨ 0, Set.forall_mem_range.2 fun y => zero_le _ ⟩;
    · rw [ lt_tsub_iff_right ] at hz;
      exact le_trans ( ciInf_le ⟨ 0, Set.forall_mem_range.2 fun _ => zero_le _ ⟩ hzT ) ( le_trans ( L.d_triangle _ _ _ ) ( by simpa [ add_comm ] using hz.le ) )

-- ════════════════════════════════════════════════════════════════════════════
-- SECTION 10: Closure Iterate Properties
-- ════════════════════════════════════════════════════════════════════════════

/-- Zeroth iterate is the identity. -/
theorem closureIterate_zero {α : Type*} (C : EMLClosure α) (s : Set α) :
    closureIterate C 0 s = s := rfl

/-- Successor iterate applies closure to the previous iterate. -/
theorem closureIterate_succ {α : Type*} (C : EMLClosure α) (n : ℕ) (s : Set α) :
    closureIterate C (n + 1) s = C.cl (closureIterate C n s) := rfl

/-
Closure iterates are monotone in the input set.
-/
theorem closureIterate_monotone {α : Type*} (C : EMLClosure α)
    (n : ℕ) {s t : Set α} (h : s ⊆ t) :
    closureIterate C n s ⊆ closureIterate C n t := by
  exact Nat.rec ( by simpa ) ( fun k ih ↦ by simp [ closureIterate_succ, C.mono ih ] ) n

/-
Every set is contained in its closure iterates (extensiveness propagates).
-/
theorem closureIterate_extensive {α : Type*} (C : EMLClosure α)
    (n : ℕ) (s : Set α) :
    s ⊆ closureIterate C n s := by
  induction' n with n ih;
  · rfl;
  · exact Set.Subset.trans ih ( C.extensive _ )

/-
════════════════════════════════════════════════════════════════════════════
SECTION 11: Contractive Dynamics and Convergence
════════════════════════════════════════════════════════════════════════════

**Geometric convergence bound**: the defect at step n is bounded by
`D₀ · cⁿ` where `D₀` is the initial defect bound and `c < 1` is the
contraction factor.

Bridge: connects fixed-point iteration rates to thermodynamic relaxation
and iterative lipschitz_certified_robustness algorithms.
-/
theorem iterative_closure_convergence_bound
    (D : ContractiveClosureDynamics) (n : ℕ) :
    D.defect n ≤ D.defectBound * D.contractionFactor ^ n := by
  induction' n with n ih;
  · simpa using D.defect_zero_le;
  · convert le_trans ( D.defect_contract n ) ( mul_le_mul_of_nonneg_left ih D.contraction_nonneg ) using 1 ; ring

/-
**Certified convergence**: for any `ε > 0`, there exists `N` such that
the defect is below `ε` for all `n ≥ N`.

Bridge: connects to lipschitz_certified_robustness iteration complexity
and post_quantum_security convergence bounds.
-/
theorem iterations_for_eps_convergence
    (D : ContractiveClosureDynamics) {ε : ℝ} (hε : 0 < ε) :
    ∃ N : ℕ, ∀ n, N ≤ n → D.defect n ≤ ε := by
  have h_defect_zero : Filter.Tendsto D.defect Filter.atTop (nhds 0) := by
    exact squeeze_zero ( fun n => D.defect_nonneg n ) ( fun n => iterative_closure_convergence_bound D n ) ( by simpa using tendsto_const_nhds.mul ( tendsto_pow_atTop_nhds_zero_of_lt_one D.contraction_nonneg D.contraction_lt_one ) );
  simpa using h_defect_zero.eventually ( ge_mem_nhds hε )

/-
════════════════════════════════════════════════════════════════════════════
SECTION 12: Application Theorems
════════════════════════════════════════════════════════════════════════════

The thermodynamic asymmetry index is antisymmetric: swapping arguments
negates the index. Captures time-reversal symmetry breaking.

Bridge: connects to quantum thermodynamic irreversibility certificates.
-/
theorem quantum_thermodynamic_asymmetry_antisymmetric {α : Type*}
    (d : α → α → ℝ≥0∞) (x y : α) :
    ThermodynamicAsymmetryIndex d x y = -ThermodynamicAsymmetryIndex d y x := by
  unfold ThermodynamicAsymmetryIndex;
  ring

/-
Self-transitions have zero asymmetry index.
-/
theorem thermodynamicAsymmetryIndex_self_zero {α : Type*}
    (d : α → α → ℝ≥0∞) (hrefl : ∀ x, d x x = 0) (x : α) :
    ThermodynamicAsymmetryIndex d x x = 0 := by
  unfold ThermodynamicAsymmetryIndex; aesop;

/-
**Lipschitz certified robustness bound**: if x is safe and y is unsafe,
then the distance from x to y exceeds the safety margin.

Bridge: connects lipschitz_certified_robustness to Kantorovich duality.
-/
theorem lipschitz_certified_robustness_bound {α : Type*}
    {d : α → α → ℝ≥0∞} (W : CertifiedRobustnessWitness α d)
    {x : α} (_hx : x ∈ W.safeSet) {y : α} (hy : y ∉ W.safeSet) :
    W.safeThreshold - W.observable x < (d y x).toReal := by
  contrapose! hy
  exact (W.safe_iff y).2 (by linarith [W.observable_lipschitz y x])

/-
**Post-quantum security observable gap**: any Lipschitz observable that
vanishes on the secure basis provides a lower bound on distance to the basis.

Bridge: connects lattice-based cryptographic security (post_quantum_security)
to EML closure defect via Kantorovich dual certificates.
-/
theorem post_quantum_security_observable_gap {α : Type*}
    {d : α → α → ℝ≥0∞}
    {f : α → ℝ} (hf : IsLawvereLipschitz d f)
    {x y : α} (hy : f y = 0) :
    f x ≤ (d x y).toReal := by
  simpa [ hy ] using hf x y

/-
Under exact duality, the quantum certified gap vanishes.
-/
theorem quantumCertifiedGap_eq_zero_of_finite {α : Type*}
    (L : LawvereQDist α) (hfin : ∀ x y, L.d x y ≠ ⊤) (x y : α) :
    QuantumCertifiedGap L.d x y = 0 := by
  exact sub_eq_zero_of_eq (Eq.symm (kantorovich_lawvere_duality L hfin x y))

/-- **Tropical Kantorovich closure bridge**: the derivation cost metric
induced by a weighted generator satisfies exact Kantorovich duality
when all derivation costs are finite.

Bridge: connects tropical shortest-path geometry to optimal transport duality
and EML closure semantics. -/
theorem tropical_kantorovich_closure_bridge {α : Type*}
    (C : EMLClosure α) (G : WeightedGenerator α)
    (hfin : ∀ x y, ClosureLawvereMetric C G x y ≠ ⊤)
    (x y : α) :
    observableGap (ClosureLawvereMetric C G) x y =
      (ClosureLawvereMetric C G x y).toReal :=
  kantorovich_lawvere_duality (G.toLawvereQDist) hfin x y

/-
A safe-set observable provides a bound on distance to any safe point.
-/
theorem safeSet_observable_bound {α : Type*}
    {d : α → α → ℝ≥0∞}
    (obs : SafeSetCertifiedObservable α d) (x : α)
    {y : α} (hy : y ∈ obs.safeSet) :
    obs.toFun x ≤ (d x y).toReal := by
  exact post_quantum_security_observable_gap obs.lipschitz ( obs.vanish_on_safe y hy )

/-- Lattice attack surface triangle bound.

Bridge: connects post_quantum_security lattice search to tropical shortest-path
composition. -/
theorem lattice_attack_surface_triangle {α : Type*}
    (L : LawvereQDist α) (secureBasis : Set α) (x y : α) :
    LatticeAttackSurface L.d secureBasis x ≤
      L.d x y + LatticeAttackSurface L.d secureBasis y :=
  closureDefectToSet_triangle L x y secureBasis

/-- Defect to a closed set is zero on the set itself (for closed target sets
under an EML closure operator).

Bridge: connects closure-theoretic fixed points to certified safety regions. -/
theorem closureDefectToSet_zero_on_closed_set {α : Type*}
    (L : LawvereQDist α) {x : α} {T : Set α} (hx : x ∈ T) :
    closureDefectToSet L.d x T = 0 :=
  closureDefectToSet_self_mem L.d L.d_self hx

