/-
# Multi-fold sums: every dense set contains a `d`-fold sumset of two-element sets

`Bridges.DenseSumsetLower.Core` shows that a `δ`-dense set contains a **two**-fold sumset
`A + B` with `|A| = |B| ≈ log n / log (1/δ)`.  This file is the `r`-fold companion: the same
greedy engine, iterated on the *surviving set itself*, produces an affine cube

`u + {0, a₁} + {0, a₂} + ⋯ + {0, a_d} ⊆ S`,

i.e. a `d`-fold sumset of two-element sets, with all `a_i ≠ 0` and

`d ≈ log₂ (log n / log (4/δ))`.

The dimension is only `log log n` — and necessarily so: each new factor squares the density
loss, `|U_{j+1}| ≳ |U_j|² / |D|`, so after `d` steps the density is `δ^{2^d}` and the
process stops at `2^d ≈ log n / log(1/δ)`, exactly where the two-fold argument stops at
`k ≈ log n / log(1/δ)`.  This is the quantitative form of Szemerédi's cube lemma, obtained
here from the same averaging step `DenseSumsetLower.exists_good_shift` used for the
two-fold bound.

Contents:

* `DenseSumsetLower.cubeF` — the affine cube generated by a list of shifts;
* `DenseSumsetLower.exists_cube_family` — the greedy iteration with its exact counting
  invariant `|S|^{2^j} ≤ (2|D|)^{2^j - 1} |U_j|`;
* `DenseSumsetLower.exists_cube_of_counting` — the abstract criterion;
* `DenseSumsetLower.exists_cube_group`, `exists_cube_zmod` — finite abelian groups;
* `DenseSumsetLower.exists_cube_int_Ico` and
  `DenseSumsetLower.exists_cube_of_density_int` — the integer interval, the latter in the
  clean analytic form `(4/δ)^{2^d} ≤ 2n`.
-/
import Bridges.DenseSumsetLower.Core

namespace DenseSumsetLower

open Finset Pointwise

variable {G : Type*} [AddCommGroup G] [DecidableEq G]

/-! ## Affine cubes -/

/-- The affine cube generated by a list of shifts: `cubeF [a₁, …, a_d]` is the `d`-fold
sumset `{0, a₁} + ⋯ + {0, a_d}`, i.e. the set of all subset sums of the list. -/
def cubeF : List G → Finset G
  | [] => {0}
  | a :: l => ({0, a} : Finset G) + cubeF l

@[simp] lemma cubeF_nil : cubeF ([] : List G) = {0} := rfl

lemma cubeF_cons (a : G) (l : List G) :
    cubeF (a :: l) = ({0, a} : Finset G) + cubeF l := rfl

lemma zero_mem_cubeF : ∀ l : List G, (0 : G) ∈ cubeF l
  | [] => by simp
  | a :: l => by
      rw [cubeF_cons]
      exact Finset.mem_add.mpr ⟨0, by simp, 0, zero_mem_cubeF l, by simp⟩

/-- Membership in a cube with one more generator: either the new generator is unused, or it
is added once. -/
lemma mem_cubeF_cons {a x : G} {l : List G} (hx : x ∈ cubeF (a :: l)) :
    (∃ y ∈ cubeF l, x = y) ∨ ∃ y ∈ cubeF l, x = a + y := by
  rw [cubeF_cons] at hx
  obtain ⟨p, hp, y, hy, rfl⟩ := Finset.mem_add.mp hx
  rcases Finset.mem_insert.mp hp with rfl | hp'
  · exact Or.inl ⟨y, hy, by simp⟩
  · have : p = a := by simpa using hp'
    exact Or.inr ⟨y, hy, by rw [this]⟩

/-- A cube of dimension `d` has at most `2^d` elements. -/
lemma card_cubeF_le : ∀ l : List G, (cubeF l).card ≤ 2 ^ l.length
  | [] => by simp
  | a :: l => by
      rw [cubeF_cons]
      calc (({0, a} : Finset G) + cubeF l).card
          ≤ ({0, a} : Finset G).card * (cubeF l).card := Finset.card_add_le
        _ ≤ 2 * 2 ^ l.length :=
            Nat.mul_le_mul (Finset.card_insert_le _ _ |>.trans (by simp)) (card_cubeF_le l)
        _ = 2 ^ (a :: l).length := by rw [List.length_cons]; ring

/-! ## The greedy cube iteration -/

/-- **The cube iteration.**  Let `D` absorb all differences of `S` and suppose the counting
condition holds at every scale `j ≤ d`.  Then after `j` steps there are `j` nonzero shifts
and a surviving set `U ⊆ S` with `U + cubeF l ⊆ S` and
`|S|^{2^j} ≤ (2|D|)^{2^j - 1} |U|`.

The squaring in the exponent is the price of the iteration: each step intersects `U` with a
translate of itself, so the density is squared rather than merely multiplied by `δ`. -/
theorem exists_cube_family {S D : Finset G} (hD : ∀ u ∈ S, ∀ s ∈ S, s - u ∈ D)
    (hD2 : 2 ≤ D.card) {d : ℕ}
    (hgrow : ∀ j ≤ d, 2 * (2 * D.card) ^ (2 ^ j - 1) ≤ S.card ^ (2 ^ j)) :
    ∀ j ≤ d, ∃ (U : Finset G) (l : List G), U ⊆ S ∧ l.length = j ∧ (∀ a ∈ l, a ≠ 0) ∧
      (∀ u ∈ U, ∀ x ∈ cubeF l, u + x ∈ S) ∧
      S.card ^ (2 ^ j) ≤ (2 * D.card) ^ (2 ^ j - 1) * U.card := by
  intro j
  induction j with
  | zero =>
      intro _
      refine ⟨S, [], Finset.Subset.refl S, rfl, by simp, ?_, by simp⟩
      intro u hu x hx
      have : x = 0 := by simpa using hx
      simpa [this] using hu
  | succ j ih =>
      intro hj
      obtain ⟨U, l, hUS, hlen, hne, hcube, hbound⟩ := ih (Nat.le_of_succ_le hj)
      -- the surviving set is still large, in particular it has at least two elements
      have hNpos : 0 < 2 * D.card := by omega
      have hpow : 0 < (2 * D.card) ^ (2 ^ j - 1) := Nat.pow_pos hNpos
      have hU2 : 2 ≤ U.card := by
        by_contra hcon
        push_neg at hcon
        have h1 : (2 * D.card) ^ (2 ^ j - 1) * U.card ≤ (2 * D.card) ^ (2 ^ j - 1) * 1 :=
          Nat.mul_le_mul_left _ (by omega)
        have h2 := hgrow j (Nat.le_of_succ_le hj)
        omega
      -- one greedy step, applied to `U` inside itself
      have hDU : ∀ u ∈ U, ∀ s ∈ U, s - u ∈ D := fun u hu s hs => hD u (hUS hu) s (hUS hs)
      have hFD : ({0} : Finset G).card < D.card := by simpa using hD2
      obtain ⟨a, _, ha0, hstep⟩ :=
        exists_good_shift (S := U) (D := D) (U := U) (F := {0}) (Finset.Subset.refl U) hDU hFD
      have hane : a ≠ 0 := by simpa using ha0
      set U' : Finset G := U.filter (fun u => u + a ∈ U) with hU'
      have hU'U : U' ⊆ U := Finset.filter_subset _ _
      -- the counting step: `2|D| |U'| ≥ |U|²`
      have hkey : U.card * U.card ≤ 2 * D.card * U'.card := by
        have h1 : U.card * U.card ≤ D.card * U'.card + 1 * U.card := by
          simpa [hU'] using hstep
        nlinarith [hU2, Nat.zero_le (U'.card)]
      refine ⟨U', a :: l, hU'U.trans hUS, by simp [hlen], ?_, ?_, ?_⟩
      · intro b hb
        rcases List.mem_cons.mp hb with rfl | hbl
        · exact hane
        · exact hne b hbl
      · intro u hu x hx
        rcases mem_cubeF_cons hx with ⟨y, hy, hxy⟩ | ⟨y, hy, hxy⟩
        · rw [hxy]
          exact hcube u (hU'U hu) y hy
        · have hua : u + a ∈ U := (Finset.mem_filter.mp hu).2
          have h2 := hcube (u + a) hua y hy
          rw [hxy, ← add_assoc]
          exact h2
      · -- the invariant squares
        have hexp1 : 2 ^ (j + 1) - 1 = (2 ^ j - 1) + (2 ^ j - 1) + 1 := by
          have : 1 ≤ 2 ^ j := Nat.one_le_two_pow
          have : 2 ^ (j + 1) = 2 ^ j + 2 ^ j := by ring
          omega
        have hsq : S.card ^ (2 ^ (j + 1)) = (S.card ^ (2 ^ j)) * (S.card ^ (2 ^ j)) := by
          rw [← pow_add]
          congr 1
          ring
        calc S.card ^ (2 ^ (j + 1))
            = (S.card ^ (2 ^ j)) * (S.card ^ (2 ^ j)) := hsq
          _ ≤ ((2 * D.card) ^ (2 ^ j - 1) * U.card) * ((2 * D.card) ^ (2 ^ j - 1) * U.card) :=
              Nat.mul_le_mul hbound hbound
          _ = (2 * D.card) ^ ((2 ^ j - 1) + (2 ^ j - 1)) * (U.card * U.card) := by
              rw [pow_add]; ring
          _ ≤ (2 * D.card) ^ ((2 ^ j - 1) + (2 ^ j - 1)) * (2 * D.card * U'.card) :=
              Nat.mul_le_mul_left _ hkey
          _ = (2 * D.card) ^ ((2 ^ j - 1) + (2 ^ j - 1) + 1) * U'.card := by
              rw [pow_succ]; ring
          _ = (2 * D.card) ^ (2 ^ (j + 1) - 1) * U'.card := by rw [hexp1]

/-- **Abstract cube criterion.**  If `D` absorbs all differences of `S` and
`2 (2|D|)^{2^j - 1} ≤ |S|^{2^j}` for every `j ≤ d`, then `S` contains an affine cube of
dimension `d`: there are `u` and nonzero `a₁, …, a_d` with all `2^d` sums
`u + ∑_{i ∈ I} a_i` in `S`. -/
theorem exists_cube_of_counting {S D : Finset G} (hD : ∀ u ∈ S, ∀ s ∈ S, s - u ∈ D)
    (hD2 : 2 ≤ D.card) {d : ℕ}
    (hgrow : ∀ j ≤ d, 2 * (2 * D.card) ^ (2 ^ j - 1) ≤ S.card ^ (2 ^ j)) :
    ∃ (u : G) (l : List G), l.length = d ∧ (∀ a ∈ l, a ≠ 0) ∧ u ∈ S ∧
      ∀ x ∈ cubeF l, u + x ∈ S := by
  obtain ⟨U, l, hUS, hlen, hne, hcube, hbound⟩ := exists_cube_family hD hD2 hgrow d le_rfl
  have hpow : 0 < (2 * D.card) ^ (2 ^ d - 1) := Nat.pow_pos (by omega)
  have hUpos : 0 < U.card := by
    by_contra hcon
    push_neg at hcon
    have h1 : (2 * D.card) ^ (2 ^ d - 1) * U.card = 0 := by
      have : U.card = 0 := by omega
      simp [this]
    have h2 := hgrow d le_rfl
    omega
  obtain ⟨u, hu⟩ := Finset.card_pos.mp hUpos
  exact ⟨u, l, hlen, hne, hUS hu, hcube u hu⟩

/-! ## Reducing the hypothesis to a single scale -/

/-- If the counting condition holds at the top scale `d` and `|S| ≤ 2|D|`, then it holds at
every scale `j ≤ d`: the density `|S|/(2|D|) ≤ 1` only decreases when raised to a higher
power. -/
lemma grow_of_top {N m d : ℕ} (hN : 1 ≤ N) (hm : m ≤ 2 * N)
    (htop : 2 * (2 * N) ^ (2 ^ d - 1) ≤ m ^ (2 ^ d)) :
    ∀ j ≤ d, 2 * (2 * N) ^ (2 ^ j - 1) ≤ m ^ (2 ^ j) := by
  intro j hj
  have hjd : (2 : ℕ) ^ j ≤ 2 ^ d := Nat.pow_le_pow_right (by norm_num) hj
  have h1j : 1 ≤ (2 : ℕ) ^ j := Nat.one_le_two_pow
  have hNpos : 0 < 2 * N := by omega
  have hpow : 0 < (2 * N) ^ (2 ^ d - 2 ^ j) := Nat.pow_pos hNpos
  -- `m^{2^d} ≤ m^{2^j} (2N)^{2^d - 2^j}`
  have hstep : m ^ (2 ^ d) ≤ m ^ (2 ^ j) * (2 * N) ^ (2 ^ d - 2 ^ j) := by
    have hsplit : (2 : ℕ) ^ d = 2 ^ j + (2 ^ d - 2 ^ j) := by omega
    calc m ^ (2 ^ d) = m ^ (2 ^ j) * m ^ (2 ^ d - 2 ^ j) := by rw [← pow_add, ← hsplit]
      _ ≤ m ^ (2 ^ j) * (2 * N) ^ (2 ^ d - 2 ^ j) :=
          Nat.mul_le_mul_left _ (Nat.pow_le_pow_left hm _)
  -- and `2 (2N)^{2^d-1} = 2 (2N)^{2^j-1} (2N)^{2^d-2^j}`
  have hexp : (2 : ℕ) ^ d - 1 = (2 ^ j - 1) + (2 ^ d - 2 ^ j) := by omega
  have hchain : 2 * (2 * N) ^ (2 ^ j - 1) * (2 * N) ^ (2 ^ d - 2 ^ j)
      ≤ m ^ (2 ^ j) * (2 * N) ^ (2 ^ d - 2 ^ j) := by
    calc 2 * (2 * N) ^ (2 ^ j - 1) * (2 * N) ^ (2 ^ d - 2 ^ j)
        = 2 * (2 * N) ^ (2 ^ d - 1) := by rw [hexp, pow_add]; ring
      _ ≤ m ^ (2 ^ d) := htop
      _ ≤ m ^ (2 ^ j) * (2 * N) ^ (2 ^ d - 2 ^ j) := hstep
  exact Nat.le_of_mul_le_mul_right hchain hpow

/-! ## Instance 1: finite abelian groups -/

/-- **Cubes in dense subsets of a finite abelian group.**  If `2 (2|G|)^{2^d - 1} ≤ |S|^{2^d}`
then `S` contains an affine cube of dimension `d` with nonzero generators. -/
theorem exists_cube_group [Fintype G] {S : Finset G} {d : ℕ} (hG : 2 ≤ Fintype.card G)
    (hcond : 2 * (2 * Fintype.card G) ^ (2 ^ d - 1) ≤ S.card ^ (2 ^ d)) :
    ∃ (u : G) (l : List G), l.length = d ∧ (∀ a ∈ l, a ≠ 0) ∧ u ∈ S ∧
      ∀ x ∈ cubeF l, u + x ∈ S := by
  have hD : ∀ u ∈ S, ∀ s ∈ S, s - u ∈ (Finset.univ : Finset G) := by
    intro u _ s _; exact Finset.mem_univ _
  have hcard : (Finset.univ : Finset G).card = Fintype.card G := Finset.card_univ
  have hSle : S.card ≤ 2 * Fintype.card G := le_trans (Finset.card_le_univ S) (by omega)
  refine exists_cube_of_counting hD (by omega) ?_
  intro j hj
  have := grow_of_top (N := Fintype.card G) (m := S.card) (d := d) (by omega) hSle hcond j hj
  rwa [hcard]

/-- **Cubes in dense subsets of `ZMod N`.** -/
theorem exists_cube_zmod {N : ℕ} [NeZero N] {S : Finset (ZMod N)} {d : ℕ} (hN : 2 ≤ N)
    (hcond : 2 * (2 * N) ^ (2 ^ d - 1) ≤ S.card ^ (2 ^ d)) :
    ∃ (u : ZMod N) (l : List (ZMod N)), l.length = d ∧ (∀ a ∈ l, a ≠ 0) ∧ u ∈ S ∧
      ∀ x ∈ cubeF l, u + x ∈ S := by
  have hcard : Fintype.card (ZMod N) = N := ZMod.card N
  exact exists_cube_group (by rw [hcard]; omega) (by rwa [hcard])

/-! ## Instance 2: integer intervals -/

/-- **Cubes in dense subsets of an interval.**  Every `S ⊆ [0, n) ⊆ ℤ` with
`2 (4n)^{2^d - 1} ≤ |S|^{2^d}` contains an affine cube of dimension `d` with nonzero
(possibly negative) generators. -/
theorem exists_cube_int_Ico {n : ℕ} {S : Finset ℤ} (hn : 1 ≤ n) (hS : S ⊆ Finset.Ico (0 : ℤ) n)
    {d : ℕ} (hcond : 2 * (4 * n) ^ (2 ^ d - 1) ≤ S.card ^ (2 ^ d)) :
    ∃ (u : ℤ) (l : List ℤ), l.length = d ∧ (∀ a ∈ l, a ≠ 0) ∧ u ∈ S ∧
      ∀ x ∈ cubeF l, u + x ∈ S := by
  classical
  set D : Finset ℤ := Finset.Ioo (-(n : ℤ)) n with hDdef
  have hDcard : D.card = 2 * n - 1 := by
    rw [hDdef, Int.card_Ioo]
    omega
  have hD : ∀ u ∈ S, ∀ s ∈ S, s - u ∈ D := by
    intro u hu s hs
    have hu' := Finset.mem_Ico.mp (hS hu)
    have hs' := Finset.mem_Ico.mp (hS hs)
    exact Finset.mem_Ioo.mpr ⟨by omega, by omega⟩
  have hSn : S.card ≤ n := by
    have := Finset.card_le_card hS
    rwa [Int.card_Ico, show ((n : ℤ) - 0).toNat = n by omega] at this
  have hD2 : 2 ≤ D.card := by
    rcases Nat.lt_or_ge n 2 with hlt | hge
    · -- `n = 1` forces `|S| ≤ 1`, contradicting the counting hypothesis
      exfalso
      have hS1 : S.card ≤ 1 := by omega
      have h1 : S.card ^ (2 ^ d) ≤ 1 ^ (2 ^ d) := Nat.pow_le_pow_left hS1 _
      rw [one_pow] at h1
      have h2 : (1 : ℕ) ≤ (4 * n) ^ (2 ^ d - 1) := Nat.one_le_pow _ _ (by omega)
      omega
    · omega
  have htop : 2 * (2 * D.card) ^ (2 ^ d - 1) ≤ S.card ^ (2 ^ d) := by
    refine le_trans (Nat.mul_le_mul_left _ (Nat.pow_le_pow_left ?_ _)) hcond
    omega
  refine exists_cube_of_counting hD hD2 ?_
  exact grow_of_top (N := D.card) (m := S.card) (d := d) (by omega) (by omega) htop

/-- **The analytic form.**  If `S ⊆ [0, n)` has `|S| ≥ δ n` and `(4/δ)^{2^d} ≤ 2 n`, then `S`
contains an affine cube of dimension `d`, i.e. a `d`-fold sumset
`{0,a₁} + ⋯ + {0,a_d}` (translated by `u`) with all `a_i ≠ 0`.

So a `δ`-dense subset of `[n]` contains cubes of every dimension
`d ≤ log₂ (log (2n) / log (4/δ))` — the multi-fold companion of
`DenseSumsetLower.exists_sumset_nat_range`. -/
theorem exists_cube_of_density_int {n : ℕ} {S : Finset ℤ} {δ : ℝ} (hn : 1 ≤ n)
    (h0 : 0 < δ) (hS : S ⊆ Finset.Ico (0 : ℤ) n)
    (hdense : δ * n ≤ S.card) {d : ℕ} (hd : ((4 : ℝ) / δ) ^ (2 ^ d) ≤ 2 * n) :
    ∃ (u : ℤ) (l : List ℤ), l.length = d ∧ (∀ a ∈ l, a ≠ 0) ∧ u ∈ S ∧
      ∀ x ∈ cubeF l, u + x ∈ S := by
  refine exists_cube_int_Ico hn hS ?_
  set K : ℕ := 2 ^ d with hK
  have hK1 : 1 ≤ K := Nat.one_le_two_pow
  have hnR : (1 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn
  have hn0 : (0 : ℝ) < n := by linarith
  -- real form of the goal
  have hreal : (2 : ℝ) * (4 * n) ^ (K - 1) ≤ (S.card : ℝ) ^ K := by
    have hstep1 : (2 : ℝ) * (4 * n) ^ (K - 1) ≤ (δ * n) ^ K := by
      have hsplit : (δ * n) ^ K = (δ / 4) ^ K * (4 * n) ^ K := by
        rw [← mul_pow]; ring_nf
      have hpos : (0 : ℝ) < (4 * n) ^ (K - 1) := by positivity
      have hKsplit : (4 * (n : ℝ)) ^ K = (4 * n) ^ (K - 1) * (4 * n) := by
        rw [← pow_succ]
        congr 1
        omega
      have hkey : (2 : ℝ) ≤ (δ / 4) ^ K * (4 * n) := by
        have hinv : ((4 : ℝ) / δ) ^ K = 1 / (δ / 4) ^ K := by
          rw [one_div, ← inv_pow]
          congr 1
          rw [inv_div]
        have hp : (0 : ℝ) < (δ / 4) ^ K := by positivity
        rw [hinv, div_le_iff₀ hp] at hd
        have heq : (δ / 4) ^ K * (4 * (n : ℝ)) = 2 * (2 * n * (δ / 4) ^ K) := by ring
        rw [heq]
        linarith
      calc (2 : ℝ) * (4 * n) ^ (K - 1)
          ≤ ((δ / 4) ^ K * (4 * n)) * (4 * n) ^ (K - 1) := by nlinarith
        _ = (δ / 4) ^ K * ((4 * n) ^ (K - 1) * (4 * n)) := by ring
        _ = (δ / 4) ^ K * (4 * n) ^ K := by rw [← hKsplit]
        _ = (δ * n) ^ K := hsplit.symm
    have hstep2 : ((δ * n) : ℝ) ^ K ≤ (S.card : ℝ) ^ K :=
      pow_le_pow_left₀ (by positivity) hdense K
    linarith
  have hcast : ((2 * (4 * n) ^ (K - 1) : ℕ) : ℝ) ≤ ((S.card ^ K : ℕ) : ℝ) := by
    push_cast
    exact hreal
  exact_mod_cast hcast

/-! ## A concrete instance -/

/-- **Every half-dense subset of `[0, 4096)` contains a two-dimensional cube.**
If `S ⊆ [0, 4096)` has at least `2048` elements then there are `u ∈ S` and nonzero `a, b`
with `u, u + a, u + b, u + a + b` all in `S`.  (The numeric check is
`2 (4 · 4096)^3 = 2^43 ≤ 2048^4 = 2^44`.) -/
theorem cube_two_of_half_dense (S : Finset ℤ) (hS : S ⊆ Finset.Ico (0 : ℤ) 4096)
    (hcard : 2048 ≤ S.card) :
    ∃ u a b : ℤ, a ≠ 0 ∧ b ≠ 0 ∧ u ∈ S ∧ u + a ∈ S ∧ u + b ∈ S ∧ u + a + b ∈ S := by
  have hcond : 2 * (4 * 4096) ^ (2 ^ 2 - 1) ≤ S.card ^ (2 ^ 2) := by
    have h1 : (2048 : ℕ) ^ (2 ^ 2) ≤ S.card ^ (2 ^ 2) := Nat.pow_le_pow_left hcard _
    norm_num at h1 ⊢
    omega
  obtain ⟨u, l, hlen, hne, huS, hcube⟩ := exists_cube_int_Ico (n := 4096) (by norm_num) hS hcond
  match l, hlen with
  | [a, b], _ =>
    have ha0 : a ≠ 0 := hne a (by simp)
    have hb0 : b ≠ 0 := hne b (by simp)
    have hbcube : b ∈ cubeF [b] := by
      rw [cubeF_cons]
      exact Finset.mem_add.mpr ⟨b, by simp, 0, zero_mem_cubeF _, by simp⟩
    have hmem_a : a ∈ cubeF [a, b] := by
      rw [cubeF_cons]
      exact Finset.mem_add.mpr ⟨a, by simp, 0, zero_mem_cubeF _, by simp⟩
    have hmem_b : b ∈ cubeF [a, b] := by
      rw [cubeF_cons]
      exact Finset.mem_add.mpr ⟨0, by simp, b, hbcube, by simp⟩
    have hmem_ab : a + b ∈ cubeF [a, b] := by
      rw [cubeF_cons]
      exact Finset.mem_add.mpr ⟨a, by simp, b, hbcube, rfl⟩
    refine ⟨u, a, b, ha0, hb0, huS, hcube a hmem_a, hcube b hmem_b, ?_⟩
    have := hcube (a + b) hmem_ab
    rwa [← add_assoc] at this

end DenseSumsetLower