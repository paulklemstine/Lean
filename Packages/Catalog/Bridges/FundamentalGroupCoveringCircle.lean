/-
# Coverings of the circle: the number of sheets is a complete invariant

The circle is the `K(ℤ,1)`, modelled here by the one-object groupoid of
`Multiplicative ℤ`.  Combining the Galois correspondence of
`Bridges/FundamentalGroupCoveringGalois.lean` with the fact that a subgroup of `ℤ` is
determined by its index, we obtain a complete classification of the connected coverings
of the circle:

* `circleSubgroup_eq_of_index_eq`: subgroups of `ℤ` with the same index coincide;
* `circle_coverings_classified_by_degree`: **two connected coverings of the circle are
  isomorphic exactly when they have the same number of sheets**;
* `exists_circle_covering_of_degree`: every degree occurs, the degree `0` case being the
  universal cover (the real line).

This is the sharpest possible form of the classification, and it should be contrasted
with `Bridges/FundamentalGroupCoveringExamples.lean`, where over the Klein four group two
*different* connected coverings of the same degree `2` exist.  So "number of sheets" is a
complete invariant for the circle but not in general.
-/
import Mathlib
import Bridges.FundamentalGroupCoveringGalois
import Bridges.FundamentalGroupCoveringDeck
import Bridges.FundamentalGroupCoveringExamples

open CategoryTheory MulAction

namespace FundamentalGroupCovering

/-- The fundamental group of the circle, written multiplicatively. -/
abbrev CircleGroup : Type := Multiplicative ℤ

theorem circleGroup_comm : ∀ x y : CircleGroup, x * y = y * x := fun x y => mul_comm x y

/-! ## Subgroups of `ℤ` are determined by their index -/

theorem int_addSubgroup_eq_of_index_eq (A B : AddSubgroup ℤ) (h : A.index = B.index) :
    A = B := by
  obtain ⟨a, ha⟩ := Int.subgroup_cyclic A
  obtain ⟨b, hb⟩ := Int.subgroup_cyclic B
  rw [← AddSubgroup.zmultiples_eq_closure] at ha hb
  subst ha
  subst hb
  rw [Int.index_zmultiples, Int.index_zmultiples] at h
  have : a = b ∨ a = -b := by
    rcases Int.natAbs_eq_natAbs_iff.mp h with h' | h'
    · exact Or.inl h'
    · exact Or.inr h'
  rcases this with rfl | rfl
  · rfl
  · exact AddSubgroup.zmultiples_neg

/-- **Subgroups of the fundamental group of the circle are determined by their index**,
i.e. connected coverings of the circle are determined by their number of sheets. -/
theorem circleSubgroup_eq_of_index_eq (H K : Subgroup CircleGroup) (h : H.index = K.index) :
    H = K := by
  have h' : (Subgroup.toAddSubgroup H).index = (Subgroup.toAddSubgroup K).index := h
  have := int_addSubgroup_eq_of_index_eq _ _ h'
  exact Subgroup.toAddSubgroup.injective this

/-! ## Classification of the coverings of the circle by degree -/

variable {X Y : Type} [MulAction CircleGroup X] [MulAction CircleGroup Y]

/-- **The connected coverings of the circle are classified by their number of sheets.**
Two connected coverings of `K(ℤ,1)` with the same (possibly infinite, i.e. `Nat.card = 0`)
fibre cardinality are isomorphic coverings. -/
theorem circle_coverings_classified_by_degree [IsPretransitive CircleGroup X]
    [IsPretransitive CircleGroup Y] (x : X) (y : Y) (h : Nat.card X = Nat.card Y) :
    Nonempty (GEquiv CircleGroup X Y) := by
  have hx := card_eq_index_stabilizer (G := CircleGroup) (X := X) x
  have hy := card_eq_index_stabilizer (G := CircleGroup) (X := Y) y
  have hidx : (stabilizer CircleGroup x).index = (stabilizer CircleGroup y).index := by
    rw [← hx, ← hy, h]
  have hst : stabilizer CircleGroup y = stabilizer CircleGroup x :=
    circleSubgroup_eq_of_index_eq _ _ hidx.symm
  exact (nonempty_gEquiv_iff_stabilizer_eq_of_comm circleGroup_comm x y).mpr hst

/-- Conversely, isomorphic coverings have the same number of sheets. -/
theorem card_eq_of_gEquiv (e : GEquiv CircleGroup X Y) : Nat.card X = Nat.card Y :=
  Nat.card_congr e.toEquiv

/-- **Every degree is realised.**  For each `n` the quotient covering by the subgroup
generated by `n` is a connected covering of the circle with exactly `n` sheets (`n = 0`
meaning the universal cover, of infinite degree). -/
theorem exists_circle_covering_of_degree (n : ℕ) :
    ∃ H : Subgroup CircleGroup, H.index = n := by
  refine ⟨AddSubgroup.toSubgroup (AddSubgroup.zmultiples (n : ℤ)), ?_⟩
  show (AddSubgroup.zmultiples (n : ℤ)).index = n
  rw [Int.index_zmultiples]
  simp

/-- The universal cover of the circle is the unique covering of infinite degree: its
subgroup is trivial. -/
theorem circle_universal_cover_subgroup (H : Subgroup CircleGroup) (h : H.index = 0) :
    H = ⊥ := by
  refine circleSubgroup_eq_of_index_eq H ⊥ ?_
  rw [h, Subgroup.index_bot]
  have hcard : Nat.card CircleGroup = 0 := Nat.card_eq_zero_of_infinite
  exact hcard.symm

/-- **Degree is a complete invariant for coverings of the circle, but not in general.**
Over the circle, two connected coverings are isomorphic exactly when they have the same
number of sheets; over the `K(V,1)` of the Klein four group there are two non-isomorphic
connected coverings of degree `2`. -/
theorem degree_complete_for_circle_but_not_in_general
    [IsPretransitive CircleGroup X] [IsPretransitive CircleGroup Y] (x : X) (y : Y) :
    (Nat.card X = Nat.card Y ↔ Nonempty (GEquiv CircleGroup X Y)) ∧
      (Hfst.index = Hsnd.index ∧ ¬ Nonempty (GEquiv V (V ⧸ Hfst) (V ⧸ Hsnd))) :=
  ⟨⟨fun h => circle_coverings_classified_by_degree x y h, fun ⟨e⟩ => card_eq_of_gEquiv e⟩,
    ⟨by rw [index_Hfst, index_Hsnd], kleinCoverings_not_isomorphic⟩⟩

end FundamentalGroupCovering