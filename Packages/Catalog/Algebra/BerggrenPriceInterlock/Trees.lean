import Algebra.BerggrenPriceInterlock.Core

/-!
# Berggren–Price interlock, Part II: the two trees over one vertex set

In Euclid parameters `(m,n)` the Barning–Hall–**Berggren** tree is generated by

  `bA (m,n) = (2m - n, m)`,  `bB (m,n) = (2m + n, m)`,  `bC (m,n) = (m + 2n, n)`,

with `2×2` determinants `+1, -1, +1`, while **Price**'s tree is generated by

  `pA (m,n) = (2m, m - n)`,  `pB (m,n) = (2m, m + n)`,  `pC (m,n) = (m + n, 2n)`,

with determinants `-2, +2, +2`.  Both are ternary trees on the *same* vertex set
`IsNode` with the *same* root `(2,1)`: this is the "interlock".

## Main results

* `isNode_berg`, `isNode_price` — the six generators preserve valid Euclid parameters
  (the delicate point for Price is that determinant `±2` still preserves coprimality,
  because opposite parity forces the gcd to be odd).
* `berg_parent`, `price_parent` — the two descent (parent) rules: Berggren compares
  `m` with `2n` and `3n` (continued-fraction style), Price halves `m` or `n`
  (binary-GCD style).
* `berg_tree`, `price_tree` — every node is reached from `(2,1)` by a **unique** word
  in each tree.
-/

namespace BerggrenPrice

/-! ### The six generators -/

/-- Berggren child 1: `(m,n) ↦ (2m - n, m)`; matrix `[[2,-1],[1,0]]`, determinant `+1`. -/
def bA (v : Node) : Node := (2 * v.1 - v.2, v.1)
/-- Berggren child 2: `(m,n) ↦ (2m + n, m)`; matrix `[[2,1],[1,0]]`, determinant `-1`. -/
def bB (v : Node) : Node := (2 * v.1 + v.2, v.1)
/-- Berggren child 3: `(m,n) ↦ (m + 2n, n)`; matrix `[[1,2],[0,1]]`, determinant `+1`. -/
def bC (v : Node) : Node := (v.1 + 2 * v.2, v.2)

/-- Price child 1: `(m,n) ↦ (2m, m - n)`; matrix `[[2,0],[1,-1]]`, determinant `-2`. -/
def pA (v : Node) : Node := (2 * v.1, v.1 - v.2)
/-- Price child 2: `(m,n) ↦ (2m, m + n)`; matrix `[[2,0],[1,1]]`, determinant `+2`. -/
def pB (v : Node) : Node := (2 * v.1, v.1 + v.2)
/-- Price child 3: `(m,n) ↦ (m + n, 2n)`; matrix `[[1,1],[0,2]]`, determinant `+2`. -/
def pC (v : Node) : Node := (v.1 + v.2, 2 * v.2)

/-- The Berggren generator family. -/
def berg : Fin 3 → Node → Node
  | 0 => bA
  | 1 => bB
  | 2 => bC

/-- The Price generator family. -/
def price : Fin 3 → Node → Node
  | 0 => pA
  | 1 => pB
  | 2 => pC

/-! ### The generators preserve nodes -/

theorem isNode_bA {v : Node} (h : IsNode v) : IsNode (bA v) := by
  obtain ⟨h1, h2, ⟨x, y, hxy⟩, ho⟩ := h
  refine ⟨by simp [bA]; omega, by simp [bA]; omega, ⟨-y, x + 2 * y, by simp [bA]; linear_combination hxy⟩, ?_⟩
  rw [Int.odd_iff] at ho ⊢
  simp only [bA]
  omega

theorem isNode_bB {v : Node} (h : IsNode v) : IsNode (bB v) := by
  obtain ⟨h1, h2, ⟨x, y, hxy⟩, ho⟩ := h
  refine ⟨by simp [bB]; omega, by simp [bB]; omega, ⟨y, x - 2 * y, by simp [bB]; linear_combination hxy⟩, ?_⟩
  rw [Int.odd_iff] at ho ⊢
  simp only [bB]
  omega

theorem isNode_bC {v : Node} (h : IsNode v) : IsNode (bC v) := by
  obtain ⟨h1, h2, ⟨x, y, hxy⟩, ho⟩ := h
  refine ⟨by simp [bC]; omega, by simp [bC]; omega, ⟨x, y - 2 * x, by simp [bC]; linear_combination hxy⟩, ?_⟩
  rw [Int.odd_iff] at ho ⊢
  simp only [bC]
  omega

theorem isNode_pA {v : Node} (h : IsNode v) : IsNode (pA v) := by
  obtain ⟨h1, h2, hc, ho⟩ := h
  obtain ⟨x, y, hxy⟩ := hc
  have hodd : Odd (v.1 - v.2) := by
    rw [Int.odd_iff] at ho ⊢; omega
  obtain ⟨t, ht⟩ := hodd
  have h2c : IsCoprime (2 : ℤ) (v.1 - v.2) := ⟨-t, 1, by linarith⟩
  have hac : IsCoprime v.1 (v.1 - v.2) := ⟨x + y, -y, by linear_combination hxy⟩
  refine ⟨by simp [pA]; omega, by simp [pA]; omega, h2c.mul_left hac, ?_⟩
  rw [Int.odd_iff] at ho ⊢
  simp only [pA]
  omega

theorem isNode_pB {v : Node} (h : IsNode v) : IsNode (pB v) := by
  obtain ⟨h1, h2, hc, ho⟩ := h
  obtain ⟨x, y, hxy⟩ := hc
  have hodd : Odd (v.1 + v.2) := ho
  obtain ⟨t, ht⟩ := hodd
  have h2c : IsCoprime (2 : ℤ) (v.1 + v.2) := ⟨-t, 1, by linarith⟩
  have hac : IsCoprime v.1 (v.1 + v.2) := ⟨x - y, y, by linear_combination hxy⟩
  refine ⟨by simp [pB]; omega, by simp [pB]; omega, h2c.mul_left hac, ?_⟩
  rw [Int.odd_iff] at ho ⊢
  simp only [pB]
  omega

theorem isNode_pC {v : Node} (h : IsNode v) : IsNode (pC v) := by
  obtain ⟨h1, h2, hc, ho⟩ := h
  obtain ⟨x, y, hxy⟩ := hc
  obtain ⟨t, ht⟩ := id ho
  have h2c : IsCoprime (v.1 + v.2) (2 : ℤ) := ⟨1, -t, by linarith⟩
  have hac : IsCoprime (v.1 + v.2) v.2 := ⟨x, y - x, by linear_combination hxy⟩
  refine ⟨by simp [pC]; omega, by simp [pC]; omega, h2c.mul_right hac, ?_⟩
  rw [Int.odd_iff] at ho ⊢
  simp only [pC]
  omega

theorem isNode_berg (i : Fin 3) (v : Node) (h : IsNode v) : IsNode (berg i v) := by
  fin_cases i
  · exact isNode_bA h
  · exact isNode_bB h
  · exact isNode_bC h

theorem isNode_price (i : Fin 3) (v : Node) (h : IsNode v) : IsNode (price i v) := by
  fin_cases i
  · exact isNode_pA h
  · exact isNode_pB h
  · exact isNode_pC h

/-! ### The size `m + n` strictly increases -/

theorem size_berg (i : Fin 3) (v : Node) (h : IsNode v) : size v < size (berg i v) := by
  obtain ⟨h1, h2, -, -⟩ := h
  fin_cases i <;> simp [size, berg, bA, bB, bC] <;> omega

theorem size_price (i : Fin 3) (v : Node) (h : IsNode v) : size v < size (price i v) := by
  obtain ⟨h1, h2, -, -⟩ := h
  fin_cases i <;> simp [size, price, pA, pB, pC] <;> omega

/-! ### Injectivity and disjointness of the three subtrees -/

theorem inj_berg (i : Fin 3) (u v : Node) (h : berg i u = berg i v) : u = v := by
  fin_cases i <;>
    · simp only [berg, bA, bB, bC, Prod.ext_iff] at h ⊢
      omega

theorem inj_price (i : Fin 3) (u v : Node) (h : price i u = price i v) : u = v := by
  fin_cases i <;>
    · simp only [price, pA, pB, pC, Prod.ext_iff] at h ⊢
      omega

theorem disj_berg (i j : Fin 3) (u v : Node) (hu : IsNode u) (hv : IsNode v)
    (h : berg i u = berg j v) : i = j := by
  obtain ⟨hu1, hu2, -, -⟩ := hu
  obtain ⟨hv1, hv2, -, -⟩ := hv
  fin_cases i <;> fin_cases j <;>
    · simp only [berg, bA, bB, bC, Prod.ext_iff] at h
      first
        | rfl
        | (exfalso; omega)

theorem disj_price (i j : Fin 3) (u v : Node) (hu : IsNode u) (hv : IsNode v)
    (h : price i u = price j v) : i = j := by
  obtain ⟨hu1, hu2, -, hu4⟩ := hu
  obtain ⟨hv1, hv2, -, hv4⟩ := hv
  rw [Int.odd_iff] at hu4 hv4
  fin_cases i <;> fin_cases j <;>
    · simp only [price, pA, pB, pC, Prod.ext_iff] at h
      first
        | rfl
        | (exfalso; omega)

/-! ### The two descent (parent) rules -/

/-- **Berggren descent.**  The parent of `(m,n)` is determined by comparing `m` with
`2n` and `3n`: this is the "subtract twice / reflect" continued-fraction step. -/
theorem berg_parent (v : Node) (hv : IsNode v) (hr : v ≠ root) :
    ∃ i u, IsNode u ∧ berg i u = v := by
  obtain ⟨h1, h2, hc, ho⟩ := hv
  obtain ⟨x, y, hxy⟩ := hc
  have hunit : (∃ k : ℤ, k * v.2 = 1) → v.2 = 1 := by
    intro ⟨k, hk⟩
    have : v.2 ∣ 1 := ⟨k, by linarith⟩
    have := Int.le_of_dvd one_pos this
    omega
  rcases lt_trichotomy v.1 (2 * v.2) with hlt | heq | hgt
  · refine ⟨0, (v.2, 2 * v.2 - v.1), ⟨by simp; omega, by simp; omega,
      ⟨y + 2 * x, -x, by simp; linear_combination hxy⟩, ?_⟩, ?_⟩
    · rw [Int.odd_iff] at ho ⊢; simp; omega
    · show bA _ = v
      refine Prod.ext ?_ ?_ <;> simp [bA]
  · -- `m = 2n` forces `n = 1`, i.e. the root
    exfalso
    have hn : v.2 = 1 := hunit ⟨2 * x + y, by rw [heq] at hxy; linarith⟩
    have hm : v.1 = 2 := by omega
    exact hr (Prod.ext hm hn)
  · rcases lt_trichotomy v.1 (3 * v.2) with hlt3 | heq3 | hgt3
    · refine ⟨1, (v.2, v.1 - 2 * v.2), ⟨by simp; omega, by simp; omega,
        ⟨y + 2 * x, x, by simp; linear_combination hxy⟩, ?_⟩, ?_⟩
      · rw [Int.odd_iff] at ho ⊢; simp; omega
      · show bB _ = v
        refine Prod.ext ?_ ?_ <;> simp [bB]
    · exfalso
      have hn : v.2 = 1 := hunit ⟨3 * x + y, by rw [heq3] at hxy; linarith⟩
      rw [Int.odd_iff] at ho
      omega
    · refine ⟨2, (v.1 - 2 * v.2, v.2), ⟨by simp; omega, by simp; omega,
        ⟨x, y + 2 * x, by simp; linear_combination hxy⟩, ?_⟩, ?_⟩
      · rw [Int.odd_iff] at ho ⊢; simp; omega
      · show bC _ = v
        refine Prod.ext ?_ ?_ <;> simp [bC]

/-- **Price descent.**  If `m` is even the parent halves `m`; if `m` is odd (so `n` is
even) the parent halves `n`.  This is the binary-GCD style step. -/
theorem price_parent (v : Node) (hv : IsNode v) (hr : v ≠ root) :
    ∃ i u, IsNode u ∧ price i u = v := by
  obtain ⟨h1, h2, hc, ho⟩ := hv
  obtain ⟨x, y, hxy⟩ := hc
  rw [Int.odd_iff] at ho
  rcases Int.even_or_odd v.1 with hev | hodd
  · obtain ⟨k, hk⟩ := hev
    have hk2 : v.1 = 2 * k := by omega
    have hNodd : v.2 % 2 = 1 := by omega
    obtain ⟨t, ht⟩ : ∃ t : ℤ, v.2 = 2 * t + 1 := ⟨(v.2 - 1) / 2, by omega⟩
    rcases lt_trichotomy v.2 k with hlt | heq | hgt
    · refine ⟨0, (k, k - v.2), ⟨by simp; omega, by simp; omega,
        ⟨2 * x + y, -y, by simp; linear_combination hxy - x * hk2⟩, ?_⟩, ?_⟩
      · rw [Int.odd_iff]; simp; omega
      · show pA _ = v
        refine Prod.ext ?_ ?_ <;> (simp [pA]; try omega)
    · exfalso
      have hd : v.2 ∣ 1 := ⟨2 * x + y, by rw [hk2, ← heq] at hxy; linarith⟩
      have := Int.le_of_dvd one_pos hd
      have hn : v.2 = 1 := by omega
      have hm : v.1 = 2 := by omega
      exact hr (Prod.ext hm hn)
    · refine ⟨1, (k, v.2 - k), ⟨by simp; omega, by simp; omega,
        ⟨2 * x + y, y, by simp; linear_combination hxy - x * hk2⟩, ?_⟩, ?_⟩
      · rw [Int.odd_iff]; simp; omega
      · show pB _ = v
        refine Prod.ext ?_ ?_ <;> (simp [pB]; try omega)
  · obtain ⟨k, hk⟩ := hodd
    have hNev : v.2 % 2 = 0 := by omega
    obtain ⟨t, ht⟩ : ∃ t : ℤ, v.2 = 2 * t := ⟨v.2 / 2, by omega⟩
    refine ⟨2, (v.1 - t, t), ⟨by simp; omega, by simp; omega,
      ⟨x, x + 2 * y, by simp; linear_combination hxy - y * ht⟩, ?_⟩, ?_⟩
    · rw [Int.odd_iff]; simp; omega
    · show pC _ = v
      refine Prod.ext ?_ ?_ <;> (simp [pC]; try omega)

/-! ### The two tree theorems -/

/-- **Berggren tree theorem**: every valid Euclid pair is reached from `(2,1)` by a
unique word of Berggren generators. -/
theorem berg_tree (v : Node) (hv : IsNode v) :
    ∃! w : List (Fin 3), applyWord berg w root = v :=
  exists_unique_word berg isNode_berg size_berg berg_parent inj_berg disj_berg v hv

/-- **Price tree theorem**: every valid Euclid pair is reached from `(2,1)` by a
unique word of Price generators. -/
theorem price_tree (v : Node) (hv : IsNode v) :
    ∃! w : List (Fin 3), applyWord price w root = v :=
  exists_unique_word price isNode_price size_price price_parent inj_price disj_price v hv

end BerggrenPrice