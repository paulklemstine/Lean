import Mathlib
import Shared.Ispythquadruple.IsPythQuadruple
import Shared.HigherPythagorean.QuadrupleTree
import Shared.HigherPythagorean.HarmonicLaw
import Physics.HigherPythagoreanTrees.ExactBranching
import Physics.HigherPythagoreanTrees.SignedReflections

/-!
# Mirror-fixed nodes: the star structure of the quadruple graph

In dimension two every non-plus reflection strictly raises the height
(`HigherPythagorean.triple_no_neutral_move`), so the Berggren group acts on the tree without
fixed points.  In dimension three the catalog observes *neutral* moves
(`HigherPythagorean.quad_neutral_move_iff`, example `(1,2,2,3)`).

This file identifies what a neutral move really is: the shift `k = ε·x − d` vanishes, so the
generator `Rε` **fixes** the node.  Neutral nodes are exactly the lattice points on the mirror
hyperplanes of the reflection group — the dimension-three replacement for the "star lines" of
the Berggren theory.

Main results.

* `fixed_iff_neutral` : `Rε` fixes `(a,b,c,d)` iff `ε · x = d`.
* `mirror_family_isPrimQuad`, `mirror_family_fixed` : the infinite family
  `(m, m+1, m(m+1), m²+m+1)` of primitive quadruples fixed by the generator `R₍₋,₊,₊₎`;
  the catalog's example `(1,2,2,3)` is the case `m = 1`.
* `mirror_family_children` : every member of the family has exactly `6` children, so mirror
  nodes are always of the deficient (six-fold) type.
* `mirror_unique` : a node is fixed by at most one generator other than the all-plus one, so
  the stabilisers in the reflection group are generated by a single involution.
-/

namespace HigherPythagoreanMirror

open Matrix HigherPythagorean HigherPythagoreanSigned HigherPythagoreanBranching

/-- **A neutral move is a fixed point.**  The generator `Rε` fixes the quadruple exactly when
the sign pattern is height-neutral. -/
theorem fixed_iff_neutral {e₁ e₂ e₃ : ℤ} (h₁ : IsSign e₁) (h₂ : IsSign e₂) (h₃ : IsSign e₃)
    (a b c d : ℤ) :
    signedRefl e₁ e₂ e₃ *ᵥ ![a, b, c, d] = ![a, b, c, d] ↔ e₁ * a + e₂ * b + e₃ * c = d := by
  rw [signedRefl_mulVec h₁ h₂ h₃]
  constructor
  · intro hfix
    have h4 := congrFun hfix 3
    simp [sk] at h4
    linarith
  · intro hneutral
    have hk : sk e₁ e₂ e₃ a b c d = 0 := by unfold sk; linarith
    rw [hk]
    ext i
    fin_cases i <;> simp

/-- The mirror family `(m, m+1, m(m+1), m²+m+1)` consists of Pythagorean quadruples. -/
theorem mirror_family_isPyth (m : ℤ) :
    IsPythQuadruple m (m + 1) (m * (m + 1)) (m ^ 2 + m + 1) := by
  unfold IsPythQuadruple; ring

/-- The mirror family is primitive. -/
theorem mirror_family_isPrimQuad (m : ℤ) :
    IsPrimQuad m (m + 1) (m * (m + 1)) (m ^ 2 + m + 1) := by
  refine ⟨mirror_family_isPyth m, ?_⟩
  set g : ℕ := content m (m + 1) (m * (m + 1)) (m ^ 2 + m + 1) with hg
  have h1 : (g : ℤ) ∣ m := content_dvd_fst _ _ _ _
  have h2 : (g : ℤ) ∣ (m + 1) := content_dvd_snd _ _ _ _
  have hone : (g : ℤ) ∣ 1 := by
    have := dvd_sub h2 h1
    simpa using this
  have : g ∣ 1 := by exact_mod_cast hone
  exact Nat.dvd_one.mp this

/-- **The mirror family is fixed** by the generator with a minus sign on the first
coordinate. -/
theorem mirror_family_fixed (m : ℤ) :
    signedRefl (-1) 1 1 *ᵥ ![m, m + 1, m * (m + 1), m ^ 2 + m + 1]
      = ![m, m + 1, m * (m + 1), m ^ 2 + m + 1] := by
  rw [fixed_iff_neutral (by simp [IsSign]) (by simp [IsSign]) (by simp [IsSign])]
  ring

/-- The catalog's neutral example `(1,2,2,3)` is the first member of the family. -/
theorem mirror_family_one :
    signedRefl (-1) 1 1 *ᵥ ![1, 2, 2, 3] = ![1, 2, 2, 3] := by
  have := mirror_family_fixed 1
  norm_num at this
  exact this

/-- **Mirror nodes are six-fold.**  For `m ≥ 1` every member of the mirror family has exactly
six children. -/
theorem mirror_family_children (m : ℤ) (hm : 1 ≤ m) :
    (quadChildren m (m + 1) (m * (m + 1)) (m ^ 2 + m + 1)).card = 6 := by
  have hpyth := mirror_family_isPyth m
  have hdef : WeakDefect m (m + 1) (m * (m + 1)) (m ^ 2 + m + 1) := by
    unfold WeakDefect; left; nlinarith
  rw [quad_children_card (by linarith) (by linarith) (by nlinarith) (by nlinarith) hpyth,
    if_pos hdef]

/-- **Stabilisers are cyclic of order two.**  Apart from the all-plus generator, at most one
generator fixes a given node with positive coordinates. -/
theorem mirror_unique {a b c d : ℤ} (ha : 0 < a) (hb : 0 < b) (hc : 0 < c) (hd : 0 < d)
    (h : IsPythQuadruple a b c d) {e₁ e₂ e₃ f₁ f₂ f₃ : ℤ}
    (he : e₁ * a + e₂ * b + e₃ * c = d) (hf : f₁ * a + f₂ * b + f₃ * c = d)
    (hes : (e₁, e₂, e₃) ∈ quadSignPats) (hfs : (f₁, f₂, f₃) ∈ quadSignPats)
    (hen : (e₁, e₂, e₃) ≠ (1, 1, 1)) (hfn : (f₁, f₂, f₃) ≠ (1, 1, 1)) :
    (e₁, e₂, e₃) = (f₁, f₂, f₃) := by
  refine quadNonChildren_unique ha hb hc hd h ?_ ?_ hen hfn
  · exact Finset.mem_filter.mpr ⟨hes, by simp [he]⟩
  · exact Finset.mem_filter.mpr ⟨hfs, by simp [hf]⟩

end HigherPythagoreanMirror