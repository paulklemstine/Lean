/-
# Cycle 9: `Δ_{a,b}` is the gap generating function of the numerical semigroup `⟨a,b⟩`

This closes Conjecture 3 of the research thread. For coprime `a, b > 1` let
`S = ⟨a,b⟩ = {a i + b j}` be the numerical semigroup they generate and let
`c = (a-1)(b-1)` be its conductor (`c - 1 = ab - a - b` is the Frobenius number). Writing
`G = ∑_{g a gap} X^g`, we prove

* `torusAlexander_eq_one_sub_gap`  : `Δ_{a,b} = 1 - (1 - X)·G`;
* `torusAlexander_coeff_semigroup` : `coeff_n Δ_{a,b} = [n ∈ S] - [n-1 ∈ S]`, so every
  coefficient of the Alexander polynomial of a torus knot is `0` or `±1`
  (`torusAlexander_coeff_abs_le_one`) and is decided by semigroup membership;
* `semigroup_symmetry` : `n ∈ S ↔ c-1-n ∉ S` for `n < c` — the numerical semigroup `⟨a,b⟩`
  is **symmetric**;
* `card_gaps_two_mul` : `2·#gaps = (a-1)(b-1)`, i.e. the number of gaps is the Seifert genus
  of `T(a,b)`.

The symmetry statement is obtained *from knot theory*: it is deduced by a telescoping
induction from the palindromicity of `Δ_{a,b}` (`torusAlexander_coeff_symm`, itself a
consequence of the symmetry of the Seifert form), together with the Chicken McNugget theorem
for the base case. So the arithmetic of the Frobenius problem and the topology of torus knots
are, on this pencil, literally the same theorem.
-/
import Computation.AlexanderTorusKnot.EvenDeterminant
import Mathlib.NumberTheory.FrobeniusNumber

namespace Computation.AlexanderTorusKnot

open Polynomial Finset

/-! ## The numerical semigroup `⟨a,b⟩` -/

/-- `IsRep a b n` : `n` lies in the numerical semigroup generated by `a` and `b`. -/
def IsRep (a b n : ℕ) : Prop := ∃ i j : ℕ, a * i + b * j = n

lemma isRep_iff_mem_closure (a b n : ℕ) :
    IsRep a b n ↔ n ∈ AddSubmonoid.closure ({a, b} : Set ℕ) := by
  rw [AddSubmonoid.mem_closure_pair]
  constructor
  · rintro ⟨i, j, h⟩; exact ⟨i, j, by simpa [mul_comm] using h⟩
  · rintro ⟨i, j, h⟩; exact ⟨i, j, by simpa [mul_comm] using h⟩

/-- A bounded (hence decidable) description of semigroup membership. -/
lemma isRep_iff_bounded (a b n : ℕ) :
    IsRep a b n ↔ ∃ i ∈ Finset.range (n + 1), ∃ j ∈ Finset.range (n + 1), a * i + b * j = n := by
  constructor
  · rintro ⟨i, j, hij⟩
    refine ⟨if a = 0 then 0 else i, ?_, if b = 0 then 0 else j, ?_, ?_⟩
    · simp only [Finset.mem_range]
      by_cases ha : a = 0
      · simp [ha]
      · have hi : i ≤ a * i := Nat.le_mul_of_pos_left i (by omega)
        simp only [ha, if_false, Nat.lt_succ_iff]
        omega
    · simp only [Finset.mem_range]
      by_cases hb : b = 0
      · simp [hb]
      · have hj : j ≤ b * j := Nat.le_mul_of_pos_left j (by omega)
        simp only [hb, if_false, Nat.lt_succ_iff]
        omega
    · by_cases ha : a = 0 <;> by_cases hb : b = 0 <;> simp [ha, hb] at hij ⊢ <;> omega
  · rintro ⟨i, -, j, -, hij⟩
    exact ⟨i, j, hij⟩

instance decidableIsRep (a b n : ℕ) : Decidable (IsRep a b n) :=
  decidable_of_iff _ (isRep_iff_bounded a b n).symm

lemma isRep_zero (a b : ℕ) : IsRep a b 0 := ⟨0, 0, by simp⟩

lemma isRep_add_right {a b n : ℕ} (h : IsRep a b n) : IsRep a b (n + b) := by
  obtain ⟨i, j, hij⟩ := h
  exact ⟨i, j + 1, by rw [← hij]; ring⟩

/-- Every element of the semigroup has a representation with the `a`-coefficient reduced
modulo `b`. -/
lemma exists_rep_lt {a b n : ℕ} (hb : 0 < b) (h : IsRep a b n) :
    ∃ i j : ℕ, i < b ∧ a * i + b * j = n := by
  obtain ⟨i, j, hij⟩ := h
  refine ⟨i % b, j + a * (i / b), Nat.mod_lt _ hb, ?_⟩
  have hd : b * (i / b) + i % b = i := Nat.div_add_mod i b
  calc a * (i % b) + b * (j + a * (i / b))
      = a * (b * (i / b) + i % b) + b * j := by ring
    _ = a * i + b * j := by rw [hd]
    _ = n := hij

/-- Uniqueness of the reduced representation: coprimality pins down the `a`-coefficient. -/
lemma rep_lt_unique {a b i i' j j' : ℕ} (hab : Nat.Coprime a b) (hi : i < b) (hi' : i' < b)
    (h : a * i + b * j = a * i' + b * j') : i = i' := by
  have hmod : (a * i) % b = (a * i') % b := by
    have e1 : (a * i + b * j) % b = (a * i) % b := Nat.add_mul_mod_self_left _ _ _
    have e2 : (a * i' + b * j') % b = (a * i') % b := Nat.add_mul_mod_self_left _ _ _
    rw [← e1, ← e2, h]
  have hb : a * i ≡ a * i' [MOD b] := hmod
  have hcop : Nat.Coprime b a := by simpa [Nat.coprime_comm] using hab
  exact Nat.ModEq.eq_of_lt_of_lt (Nat.ModEq.cancel_left_of_coprime (by simpa [Nat.Coprime] using
    hcop.gcd_eq_one) hb) hi hi'

/-! ## Gaps -/

/-- The gap set of `⟨a,b⟩` : the non-representable numbers below the conductor
`c = (a-1)(b-1)`. By the Chicken McNugget theorem this is *all* non-representable numbers. -/
def gaps (a b : ℕ) : Finset ℕ :=
  (Finset.range ((a - 1) * (b - 1))).filter (fun n => ¬ IsRep a b n)

/-- Chicken McNugget: everything at least as large as the conductor is representable. -/
lemma isRep_of_conductor_le {a b n : ℕ} (hab : Nat.Coprime a b) (ha : 1 < a) (hb : 1 < b)
    (hn : (a - 1) * (b - 1) ≤ n) : IsRep a b n := by
  have hfrob := frobeniusNumber_iff.1 (frobeniusNumber_pair hab ha hb)
  have hmn : a + b ≤ a * b := Nat.add_le_mul ha hb
  have hc : a * b - a - b < n := by
    have hcc : (a - 1) * (b - 1) = a * b - a - b + 1 := by
      obtain ⟨a₀, rfl⟩ : ∃ a₀, a = a₀ + 2 := ⟨a - 2, by omega⟩
      obtain ⟨b₀, rfl⟩ : ∃ b₀, b = b₀ + 2 := ⟨b - 2, by omega⟩
      have e1 : a₀ + 2 - 1 = a₀ + 1 := by omega
      have e2 : b₀ + 2 - 1 = b₀ + 1 := by omega
      have e3 : (a₀ + 1) * (b₀ + 1) = a₀ * b₀ + a₀ + b₀ + 1 := by ring
      have e4 : (a₀ + 2) * (b₀ + 2) = a₀ * b₀ + 2 * a₀ + 2 * b₀ + 4 := by ring
      rw [e1, e2, e3, e4]
      omega
    omega
  exact (isRep_iff_mem_closure a b n).2 (hfrob.2 n hc)

lemma mem_gaps_iff {a b n : ℕ} (hab : Nat.Coprime a b) (ha : 1 < a) (hb : 1 < b) :
    n ∈ gaps a b ↔ ¬ IsRep a b n := by
  simp only [gaps, Finset.mem_filter, Finset.mem_range]
  refine ⟨fun h => h.2, fun h => ⟨?_, h⟩⟩
  by_contra hle
  exact h (isRep_of_conductor_le hab ha hb (by omega))

/-- The gap generating polynomial `G = ∑_{g gap} X^g`. -/
noncomputable def gapPoly (a b : ℕ) : ℤ[X] := ∑ g ∈ gaps a b, X ^ g

lemma coeff_gapPoly {a b : ℕ} (hab : Nat.Coprime a b) (ha : 1 < a) (hb : 1 < b) (n : ℕ) :
    (gapPoly a b).coeff n = if IsRep a b n then 0 else 1 := by
  rw [gapPoly, finset_sum_coeff]
  simp only [coeff_X_pow, Finset.sum_ite_eq]
  by_cases h : IsRep a b n
  · rw [if_neg (fun hc => ((mem_gaps_iff hab ha hb).1 hc) h), if_pos h]
  · rw [if_pos ((mem_gaps_iff hab ha hb).2 h), if_neg h]

/-! ## The finite combinatorial identity -/

lemma coeff_geom_a {a b : ℕ} (ha : 0 < a) (n : ℕ) :
    (∑ i ∈ Finset.range b, (X : ℤ[X]) ^ (a * i)).coeff n
      = if ∃ i < b, a * i = n then 1 else 0 := by
  rw [finset_sum_coeff]
  simp only [coeff_X_pow]
  by_cases h : ∃ i < b, a * i = n
  · obtain ⟨i₀, hi₀, hn⟩ := h
    rw [if_pos ⟨i₀, hi₀, hn⟩, Finset.sum_eq_single i₀]
    · rw [if_pos hn.symm]
    · intro i _ hne
      refine if_neg fun hcon => hne ?_
      have hmul : a * i = a * i₀ := by omega
      exact Nat.eq_of_mul_eq_mul_left ha hmul
    · intro hmem
      exact absurd (Finset.mem_range.2 hi₀) hmem
  · rw [if_neg h]
    exact Finset.sum_eq_zero fun i hi =>
      if_neg fun hcon => h ⟨i, Finset.mem_range.1 hi, hcon.symm⟩

/-- **The gap identity.** `(1 - X^b)·G = ∑_{k<b} X^k - ∑_{i<b} X^{a i}`. -/
theorem gapPoly_identity {a b : ℕ} (hab : Nat.Coprime a b) (ha : 1 < a) (hb : 1 < b) :
    gapPoly a b - X ^ b * gapPoly a b
      = (∑ k ∈ Finset.range b, (X : ℤ[X]) ^ k) - ∑ i ∈ Finset.range b, (X : ℤ[X]) ^ (a * i) := by
  ext n
  rw [coeff_sub, coeff_sub, coeff_gapPoly hab ha hb]
  have hleft : ((X : ℤ[X]) ^ b * gapPoly a b).coeff n
      = if b ≤ n then (if IsRep a b (n - b) then 0 else 1) else 0 := by
    rw [Polynomial.coeff_X_pow_mul']
    by_cases hbn : b ≤ n
    · rw [if_pos hbn, if_pos hbn, coeff_gapPoly hab ha hb]
    · rw [if_neg hbn, if_neg hbn]
  have hgeom : (∑ k ∈ Finset.range b, (X : ℤ[X]) ^ k).coeff n = if n < b then 1 else 0 := by
    rw [finset_sum_coeff]
    simp only [coeff_X_pow, Finset.sum_ite_eq, Finset.mem_range]
  rw [hleft, hgeom, coeff_geom_a (by omega) n]
  by_cases hbn : b ≤ n
  · rw [if_pos hbn, if_neg (show ¬ n < b by omega)]
    by_cases hn : IsRep a b n
    · rw [if_pos hn]
      -- `n - b` is a gap iff `n = a i` with `i < b`
      have hkey : (¬ IsRep a b (n - b)) ↔ ∃ i < b, a * i = n := by
        obtain ⟨i, j, hi, hij⟩ := exists_rep_lt (show 0 < b by omega) hn
        constructor
        · intro hnb
          refine ⟨i, hi, ?_⟩
          rcases Nat.eq_zero_or_pos j with hj | hj
          · rw [hj] at hij; simpa using hij
          · refine absurd ⟨i, j - 1, ?_⟩ hnb
            have hbj : b * (j - 1) + b = b * j := by
              obtain ⟨j', rfl⟩ : ∃ j', j = j' + 1 := ⟨j - 1, by omega⟩
              have : j' + 1 - 1 = j' := by omega
              rw [this]; ring
            omega
        · rintro ⟨i', hi', hn'⟩ hrep
          obtain ⟨i'', j'', hi'', hij''⟩ := exists_rep_lt (show 0 < b by omega) hrep
          have hstep : b * (j'' + 1) = b * j'' + b := by ring
          have hfull : a * i'' + b * (j'' + 1) = n := by omega
          have heq : i' = i'' :=
            rep_lt_unique hab hi' hi'' (j := 0) (j' := j'' + 1) (by omega)
          subst heq
          have hpos : b ≤ b * (j'' + 1) := Nat.le_mul_of_pos_right b (by omega)
          omega
      by_cases hnb : IsRep a b (n - b)
      · rw [if_pos hnb, if_neg (fun hc => (hkey.2 hc) hnb)]
      · rw [if_neg hnb, if_pos (hkey.1 hnb)]
    · rw [if_neg hn]
      have hnb : ¬ IsRep a b (n - b) := by
        intro hc
        exact hn (by simpa [Nat.sub_add_cancel hbn] using isRep_add_right hc)
      have hno : ¬ ∃ i < b, a * i = n := by
        rintro ⟨i, -, hi⟩
        exact hn ⟨i, 0, by simpa using hi⟩
      rw [if_neg hnb, if_neg hno]
      ring
  · rw [if_neg hbn, if_pos (show n < b by omega)]
    have hiff : IsRep a b n ↔ ∃ i < b, a * i = n := by
      constructor
      · rintro ⟨i, j, hij⟩
        rcases Nat.eq_zero_or_pos j with hj | hj
        · have hn : a * i = n := by rw [hj] at hij; simpa using hij
          have hle : i ≤ a * i := Nat.le_mul_of_pos_left i (by omega)
          exact ⟨i, by omega, hn⟩
        · exfalso
          have : b ≤ b * j := Nat.le_mul_of_pos_right b hj
          omega
      · rintro ⟨i, -, hi⟩
        exact ⟨i, 0, by simpa using hi⟩
    by_cases hn : IsRep a b n
    · rw [if_pos hn, if_pos (hiff.1 hn)]; norm_num
    · rw [if_neg hn, if_neg (fun hc => hn (hiff.2 hc))]

/-! ## The main theorem -/

/-- **`Δ_{a,b}` is the gap generating function of `⟨a,b⟩`.** -/
theorem torusAlexander_eq_one_sub_gap {a b : ℕ} (hab : Nat.Coprime a b) (ha : 1 < a)
    (hb : 1 < b) :
    torusAlexander a b = 1 - (1 - X) * gapPoly a b := by
  have hne : ((X : ℤ[X]) ^ b - 1) ≠ 0 := by
    intro h
    have := congrArg (Polynomial.eval (0 : ℤ)) h
    simp [zero_pow (show b ≠ 0 by omega)] at this
  refine mul_right_cancel₀ hne ?_
  have hgeom : (∑ k ∈ Finset.range b, (X : ℤ[X]) ^ k) * (X - 1) = (X : ℤ[X]) ^ b - 1 :=
    geom_sum_mul X b
  have hmain := torusAlexander_mul_geom hab.symm (by omega) (by omega)
  rw [torusAlexander_comm] at hmain
  -- `hmain : Δ_{a,b} * (X^b - 1) = (∑_{i<b} X^{a i}) * (X - 1)`
  rw [hmain]
  have hid := gapPoly_identity hab ha hb
  have hexp : (1 - (1 - X : ℤ[X]) * gapPoly a b) * ((X : ℤ[X]) ^ b - 1)
      = (X : ℤ[X]) ^ b - 1 - (X - 1) * (gapPoly a b - X ^ b * gapPoly a b) := by
    ring
  rw [hexp, hid, ← hgeom]
  ring

/-- **Coefficients of `Δ_{a,b}` are semigroup indicators.** -/
theorem torusAlexander_coeff_semigroup {a b : ℕ} (hab : Nat.Coprime a b) (ha : 1 < a)
    (hb : 1 < b) (n : ℕ) :
    (torusAlexander a b).coeff n
      = (if IsRep a b n then 1 else 0) - (if 1 ≤ n ∧ IsRep a b (n - 1) then 1 else 0) := by
  rw [torusAlexander_eq_one_sub_gap hab ha hb]
  have hmul : ((1 - X : ℤ[X]) * gapPoly a b).coeff n
      = (gapPoly a b).coeff n - (if 1 ≤ n then (gapPoly a b).coeff (n - 1) else 0) := by
    have hsplit : ((1 - X : ℤ[X]) * gapPoly a b) = gapPoly a b - X * gapPoly a b := by ring
    rw [hsplit, coeff_sub]
    rcases Nat.eq_zero_or_pos n with rfl | hn
    · simp
    · obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
      rw [if_pos (by omega)]
      simp [Polynomial.coeff_X_mul]
  rw [coeff_sub, hmul, coeff_gapPoly hab ha hb]
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · simp [isRep_zero a b]
  · rw [if_pos (show 1 ≤ n by omega), coeff_gapPoly hab ha hb, Polynomial.coeff_one, if_neg (show ¬ (n = 0) by omega)]
    have hn1 : 1 ≤ n := hn
    by_cases h1 : IsRep a b n <;> by_cases h2 : IsRep a b (n - 1) <;>
      simp [h1, h2, hn1]

/-- Every coefficient of the Alexander polynomial of a torus knot is `0` or `±1`. -/
theorem torusAlexander_coeff_abs_le_one {a b : ℕ} (hab : Nat.Coprime a b) (ha : 1 < a)
    (hb : 1 < b) (n : ℕ) : |(torusAlexander a b).coeff n| ≤ 1 := by
  rw [torusAlexander_coeff_semigroup hab ha hb n]
  by_cases h1 : IsRep a b n <;> by_cases h2 : 1 ≤ n ∧ IsRep a b (n - 1) <;>
    simp [h1, h2]


/-! ## Symmetry of `⟨a,b⟩`, deduced from palindromicity of the knot invariant -/

/-- The Frobenius number `c - 1 = ab - a - b` is a gap. -/
lemma not_isRep_conductor_sub_one {a b : ℕ} (hab : Nat.Coprime a b) (ha : 1 < a) (hb : 1 < b) :
    ¬ IsRep a b ((a - 1) * (b - 1) - 1) := by
  have hfrob := frobeniusNumber_iff.1 (frobeniusNumber_pair hab ha hb)
  have hmn : a + b ≤ a * b := Nat.add_le_mul ha hb
  have hcc : (a - 1) * (b - 1) - 1 = a * b - a - b := by
    obtain ⟨a₀, rfl⟩ : ∃ a₀, a = a₀ + 2 := ⟨a - 2, by omega⟩
    obtain ⟨b₀, rfl⟩ : ∃ b₀, b = b₀ + 2 := ⟨b - 2, by omega⟩
    have e1 : a₀ + 2 - 1 = a₀ + 1 := by omega
    have e2 : b₀ + 2 - 1 = b₀ + 1 := by omega
    have e3 : (a₀ + 1) * (b₀ + 1) = a₀ * b₀ + a₀ + b₀ + 1 := by ring
    have e4 : (a₀ + 2) * (b₀ + 2) = a₀ * b₀ + 2 * a₀ + 2 * b₀ + 4 := by ring
    rw [e1, e2, e3, e4]
    omega
  rw [hcc, isRep_iff_mem_closure]
  exact hfrob.1

/-- The telescoping form of the symmetry, proved by induction from the palindromicity of
`Δ_{a,b}`. -/
lemma semigroup_symmetry_aux {a b : ℕ} (hab : Nat.Coprime a b) (ha : 1 < a) (hb : 1 < b) :
    ∀ n : ℕ, n < (a - 1) * (b - 1) →
      (if IsRep a b n then (1 : ℤ) else 0)
        + (if IsRep a b ((a - 1) * (b - 1) - 1 - n) then (1 : ℤ) else 0) = 1 := by
  set c := (a - 1) * (b - 1) with hc
  intro n
  induction n with
  | zero =>
      intro _
      rw [if_pos (isRep_zero a b), if_neg (by simpa using not_isRep_conductor_sub_one hab ha hb)]
      norm_num
  | succ m ih =>
      intro hm
      have hmlt : m < c := by omega
      have hIH := ih hmlt
      -- the two palindromic coefficients
      have hco1 : (torusAlexander a b).coeff (m + 1)
          = (if IsRep a b (m + 1) then (1 : ℤ) else 0) - (if IsRep a b m then (1 : ℤ) else 0) := by
        rw [torusAlexander_coeff_semigroup hab ha hb (m + 1)]
        simp
      have hco2 : (torusAlexander a b).coeff (c - (m + 1))
          = (if IsRep a b (c - 1 - m) then (1 : ℤ) else 0)
            - (if IsRep a b (c - 1 - (m + 1)) then (1 : ℤ) else 0) := by
        rw [torusAlexander_coeff_semigroup hab ha hb (c - (m + 1))]
        have e1 : c - (m + 1) = c - 1 - m := by omega
        have e2 : c - 1 - m - 1 = c - 1 - (m + 1) := by omega
        rw [e1, e2]
        simp only [show (1 ≤ c - 1 - m ∧ IsRep a b (c - 1 - (m + 1)))
          ↔ IsRep a b (c - 1 - (m + 1)) from ⟨And.right, fun h => ⟨by omega, h⟩⟩]
      have hsym := torusAlexander_coeff_symm hab (by omega) (by omega)
        (show m + 1 ≤ (a - 1) * (b - 1) by omega)
      rw [← hc] at hsym
      rw [hco1, hco2] at hsym
      have := hIH
      by_cases h1 : IsRep a b (m + 1) <;> by_cases h2 : IsRep a b m <;>
        by_cases h3 : IsRep a b (c - 1 - m) <;> by_cases h4 : IsRep a b (c - 1 - (m + 1)) <;>
        simp [h1, h2, h3, h4] at hsym this ⊢

/-- **The numerical semigroup `⟨a,b⟩` is symmetric**: below the conductor, `n` is
representable exactly when its mirror `c - 1 - n` is a gap. Proved from the palindromicity
of the Alexander polynomial of `T(a,b)`. -/
theorem semigroup_symmetry {a b n : ℕ} (hab : Nat.Coprime a b) (ha : 1 < a) (hb : 1 < b)
    (hn : n < (a - 1) * (b - 1)) :
    IsRep a b n ↔ ¬ IsRep a b ((a - 1) * (b - 1) - 1 - n) := by
  have h := semigroup_symmetry_aux hab ha hb n hn
  constructor
  · intro h1 h2
    rw [if_pos h1, if_pos h2] at h
    norm_num at h
  · intro h2
    by_contra h1
    rw [if_neg h1, if_neg h2] at h
    norm_num at h

/-- **Genus formula.** The number of gaps of `⟨a,b⟩` is half the conductor, i.e. the Seifert
genus of the torus knot `T(a,b)` — the degree of `Δ_{a,b}` is `2·#gaps`. -/
theorem card_gaps_two_mul {a b : ℕ} (hab : Nat.Coprime a b) (ha : 1 < a) (hb : 1 < b) :
    2 * (gaps a b).card = (a - 1) * (b - 1) := by
  have hsplit := Finset.card_filter_add_card_filter_not
    (s := Finset.range ((a - 1) * (b - 1))) (p := fun n => IsRep a b n)
  rw [Finset.card_range] at hsplit
  have hbij : ((Finset.range ((a - 1) * (b - 1))).filter (fun n => ¬ IsRep a b n)).card
      = ((Finset.range ((a - 1) * (b - 1))).filter (fun n => IsRep a b n)).card := by
    refine Finset.card_nbij' (fun n => (a - 1) * (b - 1) - 1 - n)
      (fun n => (a - 1) * (b - 1) - 1 - n) ?_ ?_ ?_ ?_
    · intro n hn
      simp only [Finset.coe_filter, Set.mem_setOf_eq, Finset.mem_range] at hn ⊢
      refine ⟨by omega, ?_⟩
      by_contra hcon
      exact hn.2 ((semigroup_symmetry hab ha hb hn.1).2 hcon)
    · intro n hn
      simp only [Finset.coe_filter, Set.mem_setOf_eq, Finset.mem_range] at hn ⊢
      exact ⟨by omega, (semigroup_symmetry hab ha hb hn.1).1 hn.2⟩
    · intro n hn
      simp only [Finset.coe_filter, Set.mem_setOf_eq, Finset.mem_range] at hn
      show (a - 1) * (b - 1) - 1 - ((a - 1) * (b - 1) - 1 - n) = n
      omega
    · intro n hn
      simp only [Finset.coe_filter, Set.mem_setOf_eq, Finset.mem_range] at hn
      show (a - 1) * (b - 1) - 1 - ((a - 1) * (b - 1) - 1 - n) = n
      omega
  have hg : gaps a b = (Finset.range ((a - 1) * (b - 1))).filter (fun n => ¬ IsRep a b n) := rfl
  rw [hg]
  omega

/-! ## Lab notes: the gap sets of small torus knots

`⟨3,5⟩` has gaps `{1,2,4,7}` (conductor `8`, Frobenius number `7`), and indeed
`Δ_{3,5} = Φ_15 = X^8 - X^7 + X^5 - X^4 + X^3 - X + 1`, whose exponents are exactly the
jumps of the semigroup. `⟨4,5⟩` has gaps `{1,2,3,6,7,11}`, six of them, matching the genus
`(4-1)(5-1)/2 = 6`. -/

example : gaps 3 5 = {1, 2, 4, 7} := by decide

example : 2 * (gaps 3 5).card = (3 - 1) * (5 - 1) := by decide

example : gaps 4 5 = {1, 2, 3, 6, 7, 11} := by decide

example : 2 * (gaps 4 5).card = (4 - 1) * (5 - 1) := by decide

end Computation.AlexanderTorusKnot