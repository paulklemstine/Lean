/-
# Sheffer Algebra: The Algebraic Structure Generated by Softplus

The Sheffer algebra is the smallest set of functions ℝ → ℝ that:
1. Contains the softplus function σ(x) = log(1 + eˣ)
2. Is closed under affine pre-composition: if f is in the algebra, so is x ↦ f(ax + b)
3. Is closed under affine combination: if f, g are in the algebra, so is αf + βg + γ
4. Is closed under composition

This file formalizes the Sheffer algebra and proves key closure properties.
-/

import Mathlib
-- The module `ShefferAI.Lean.SoftplusBasic` referenced by the original catalog
-- export is absent from this repository; the two facts this file used from it
-- (the definition of `softplus` and its reflection identity) are supplied here,
-- so that the file is self-contained and compiles.

open Real

noncomputable section

/-! ## Softplus -/

/-- The softplus activation `σ(x) = log (1 + eˣ)`. -/
def softplus (x : ℝ) : ℝ := Real.log (1 + Real.exp x)

/-- **Reflection identity.** `σ(x) - x = σ(-x)`; equivalently `σ(x) - σ(-x) = x`,
which is what makes the identity function representable in the Sheffer algebra. -/
theorem softplus_reflection (x : ℝ) : softplus x - x = softplus (-x) := by
  have h1 : (0 : ℝ) < 1 + Real.exp x := by positivity
  have hx : Real.exp x ≠ 0 := (Real.exp_pos x).ne'
  have hrw : (1 : ℝ) + Real.exp (-x) = (1 + Real.exp x) / Real.exp x := by
    rw [Real.exp_neg]
    field_simp
    ring
  unfold softplus
  rw [hrw, Real.log_div (ne_of_gt h1) hx, Real.log_exp]


/-- The logistic sigmoid `S(x) = eˣ / (1 + eˣ)`, the derivative of softplus. -/
def logisticSigmoid (x : ℝ) : ℝ := Real.exp x / (1 + Real.exp x)

theorem softplus_zero : softplus 0 = Real.log 2 := by
  unfold softplus
  norm_num

theorem softplus_continuous : Continuous softplus :=
  Continuous.log (continuous_const.add Real.continuous_exp) (fun x => by positivity)

theorem softplus_differentiable : Differentiable ℝ softplus :=
  Differentiable.log ((differentiable_const (1 : ℝ)).add Real.differentiable_exp)
    (fun x => by positivity)

theorem softplus_strictMono : StrictMono softplus := by
  intro a b hab
  unfold softplus
  exact Real.log_lt_log (by positivity)
    (by have := Real.exp_lt_exp.mpr hab; linarith)

/-- **Subadditivity.** `σ(x+y) ≤ σ(x) + σ(y)`, because
`1 + e^{x+y} ≤ (1 + eˣ)(1 + e^y)`. -/
theorem softplus_subadditive (x y : ℝ) : softplus (x + y) ≤ softplus x + softplus y := by
  have hx : (0 : ℝ) < 1 + Real.exp x := by positivity
  have hy : (0 : ℝ) < 1 + Real.exp y := by positivity
  have hle : 1 + Real.exp (x + y) ≤ (1 + Real.exp x) * (1 + Real.exp y) := by
    rw [Real.exp_add]
    nlinarith [Real.exp_pos x, Real.exp_pos y]
  unfold softplus
  calc Real.log (1 + Real.exp (x + y))
      ≤ Real.log ((1 + Real.exp x) * (1 + Real.exp y)) := Real.log_le_log (by positivity) hle
    _ = Real.log (1 + Real.exp x) + Real.log (1 + Real.exp y) :=
        Real.log_mul (ne_of_gt hx) (ne_of_gt hy)

/-- One-sided Lipschitz estimate: softplus increases no faster than the
identity. -/
theorem softplus_sub_le {x y : ℝ} (h : x ≤ y) : softplus y - softplus x ≤ y - x := by
  have hx : (0 : ℝ) < 1 + Real.exp x := by positivity
  have hexp : (1 : ℝ) ≤ Real.exp (y - x) := by
    have := Real.add_one_le_exp (y - x)
    linarith
  have hmul : Real.exp (y - x) * Real.exp x = Real.exp y := by
    rw [← Real.exp_add]; ring_nf
  have key : (1 : ℝ) + Real.exp y ≤ Real.exp (y - x) * (1 + Real.exp x) := by
    nlinarith [Real.exp_pos x]
  have hlog := Real.log_le_log (by positivity) key
  rw [Real.log_mul (Real.exp_ne_zero _) (ne_of_gt hx), Real.log_exp] at hlog
  unfold softplus
  linarith

theorem softplus_abs_sub_le (x y : ℝ) : |softplus x - softplus y| ≤ |x - y| := by
  rcases le_total x y with h | h
  · have hm : softplus x ≤ softplus y := softplus_strictMono.monotone h
    rw [abs_sub_comm (softplus x), abs_sub_comm x,
      abs_of_nonneg (by linarith : (0 : ℝ) ≤ softplus y - softplus x),
      abs_of_nonneg (by linarith : (0 : ℝ) ≤ y - x)]
    exact softplus_sub_le h
  · have hm : softplus y ≤ softplus x := softplus_strictMono.monotone h
    rw [abs_of_nonneg (by linarith : (0 : ℝ) ≤ softplus x - softplus y),
      abs_of_nonneg (by linarith : (0 : ℝ) ≤ x - y)]
    exact softplus_sub_le h

/-- Softplus is `1`-Lipschitz. -/
theorem softplus_lipschitz : LipschitzWith 1 softplus := by
  apply LipschitzWith.of_dist_le_mul
  intro x y
  simpa [Real.dist_eq] using softplus_abs_sub_le x y

/-- `S(x) + S(-x) = 1`. -/
theorem sigmoid_complement (x : ℝ) : logisticSigmoid x + logisticSigmoid (-x) = 1 := by
  have hx : (0 : ℝ) < Real.exp x := Real.exp_pos x
  have he : Real.exp (-x) = 1 / Real.exp x := by rw [Real.exp_neg]; ring
  unfold logisticSigmoid
  rw [he]
  field_simp
  ring

/-! ## Sheffer Expressions -/

/-- A Sheffer expression represents a function built from softplus via
    affine operations. This is a syntactic representation. -/
inductive ShefferExpr : Type where
  | base : ShefferExpr  -- σ(x)
  | affine_pre (a b : ℝ) (e : ShefferExpr) : ShefferExpr  -- e(ax + b)
  | affine_comb (α β γ : ℝ) (e₁ e₂ : ShefferExpr) : ShefferExpr  -- αe₁ + βe₂ + γ
  | comp (e₁ e₂ : ShefferExpr) : ShefferExpr  -- e₁ ∘ e₂

/-- Evaluate a Sheffer expression at a point -/
def ShefferExpr.eval : ShefferExpr → ℝ → ℝ
  | .base => softplus
  | .affine_pre a b e => fun x => e.eval (a * x + b)
  | .affine_comb α β γ e₁ e₂ => fun x => α * e₁.eval x + β * e₂.eval x + γ
  | .comp e₁ e₂ => fun x => e₁.eval (e₂.eval x)

/-- The depth of a Sheffer expression -/
def ShefferExpr.depth : ShefferExpr → ℕ
  | .base => 1
  | .affine_pre _ _ e => e.depth
  | .affine_comb _ _ _ e₁ e₂ => max e₁.depth e₂.depth
  | .comp e₁ e₂ => e₁.depth + e₂.depth

/-- The width of a Sheffer expression (number of base activations) -/
def ShefferExpr.width : ShefferExpr → ℕ
  | .base => 1
  | .affine_pre _ _ e => e.width
  | .affine_comb _ _ _ e₁ e₂ => e₁.width + e₂.width
  | .comp e₁ e₂ => e₁.width + e₂.width

/-! ## The Sheffer Algebra as a Set -/

/-- The Sheffer algebra: the set of all functions representable as Sheffer expressions -/
def ShefferAlgebra : Set (ℝ → ℝ) :=
  { f | ∃ e : ShefferExpr, f = e.eval }

/-- Softplus is in the Sheffer algebra -/
theorem softplus_mem_sheffer : softplus ∈ ShefferAlgebra :=
  ⟨ShefferExpr.base, rfl⟩

/-- The Sheffer algebra is closed under affine pre-composition -/
theorem sheffer_affine_pre_closed {f : ℝ → ℝ} (hf : f ∈ ShefferAlgebra) (a b : ℝ) :
    (fun x => f (a * x + b)) ∈ ShefferAlgebra := by
  obtain ⟨e, he⟩ := hf
  exact ⟨ShefferExpr.affine_pre a b e, by ext x; simp [ShefferExpr.eval, he]⟩

/-- The Sheffer algebra is closed under affine combination -/
theorem sheffer_affine_comb_closed {f g : ℝ → ℝ} (hf : f ∈ ShefferAlgebra)
    (hg : g ∈ ShefferAlgebra) (α β γ : ℝ) :
    (fun x => α * f x + β * g x + γ) ∈ ShefferAlgebra := by
  obtain ⟨e₁, he₁⟩ := hf
  obtain ⟨e₂, he₂⟩ := hg
  exact ⟨ShefferExpr.affine_comb α β γ e₁ e₂, by ext x; simp [ShefferExpr.eval, he₁, he₂]⟩

/-- The Sheffer algebra is closed under composition -/
theorem sheffer_comp_closed {f g : ℝ → ℝ} (hf : f ∈ ShefferAlgebra)
    (hg : g ∈ ShefferAlgebra) :
    (fun x => f (g x)) ∈ ShefferAlgebra := by
  obtain ⟨e₁, he₁⟩ := hf
  obtain ⟨e₂, he₂⟩ := hg
  exact ⟨ShefferExpr.comp e₁ e₂, by ext x; simp [ShefferExpr.eval, he₁, he₂]⟩

/-! ## Key functions in the Sheffer algebra -/

/-- Constants are in the Sheffer algebra -/
theorem const_mem_sheffer (c : ℝ) : (fun _ : ℝ => c) ∈ ShefferAlgebra := by
  have h := softplus_mem_sheffer
  have := sheffer_affine_comb_closed h h 1 (-1) c
  convert this using 1
  ext x; ring

/-- The identity function is in the Sheffer algebra:
    x = σ(x) - σ(-x) (by the reflection identity σ(x) - x = σ(-x)) -/
theorem id_mem_sheffer : (fun x : ℝ => x) ∈ ShefferAlgebra := by
  have hσ := softplus_mem_sheffer
  have hσ_neg := sheffer_affine_pre_closed hσ (-1) 0
  have hcomb := sheffer_affine_comb_closed hσ hσ_neg 1 (-1) 0
  convert hcomb using 1
  ext x
  simp
  have := softplus_reflection x
  linarith


/-- The Sheffer algebra is closed under scalar multiplication. -/
theorem sheffer_smul_closed {f : ℝ → ℝ} (hf : f ∈ ShefferAlgebra) (c : ℝ) :
    (fun x => c * f x) ∈ ShefferAlgebra := by
  have h := sheffer_affine_comb_closed hf hf c 0 0
  convert h using 1
  ext x; ring

/-! ## The Lipschitz barrier -/

/-- **Lipschitz barrier.**  Every Sheffer expression defines a globally Lipschitz
function: the base activation is `1`-Lipschitz and all three closure operations
preserve Lipschitzness (with an explicit constant). -/
theorem shefferExpr_lipschitz (e : ShefferExpr) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ x y : ℝ, |e.eval x - e.eval y| ≤ K * |x - y| := by
  induction e with
  | base => exact ⟨1, zero_le_one, fun x y => by simpa using softplus_abs_sub_le x y⟩
  | affine_pre a b e ih =>
      obtain ⟨K, hK, h⟩ := ih
      refine ⟨K * |a|, by positivity, fun x y => ?_⟩
      have hx := h (a * x + b) (a * y + b)
      have habs : |a * x + b - (a * y + b)| = |a| * |x - y| := by
        rw [show a * x + b - (a * y + b) = a * (x - y) by ring, abs_mul]
      rw [habs] at hx
      show |e.eval (a * x + b) - e.eval (a * y + b)| ≤ K * |a| * |x - y|
      calc |e.eval (a * x + b) - e.eval (a * y + b)| ≤ K * (|a| * |x - y|) := hx
        _ = K * |a| * |x - y| := by ring
  | affine_comb al be ga e₁ e₂ ih₁ ih₂ =>
      obtain ⟨K₁, hK₁, h₁⟩ := ih₁
      obtain ⟨K₂, hK₂, h₂⟩ := ih₂
      refine ⟨|al| * K₁ + |be| * K₂, by positivity, fun x y => ?_⟩
      show |al * e₁.eval x + be * e₂.eval x + ga
            - (al * e₁.eval y + be * e₂.eval y + ga)| ≤ _
      have hrw : al * e₁.eval x + be * e₂.eval x + ga
          - (al * e₁.eval y + be * e₂.eval y + ga)
          = al * (e₁.eval x - e₁.eval y) + be * (e₂.eval x - e₂.eval y) := by ring
      rw [hrw]
      have hb1 : |al * (e₁.eval x - e₁.eval y)| ≤ |al| * (K₁ * |x - y|) := by
        rw [abs_mul]
        exact mul_le_mul_of_nonneg_left (h₁ x y) (abs_nonneg al)
      have hb2 : |be * (e₂.eval x - e₂.eval y)| ≤ |be| * (K₂ * |x - y|) := by
        rw [abs_mul]
        exact mul_le_mul_of_nonneg_left (h₂ x y) (abs_nonneg be)
      calc |al * (e₁.eval x - e₁.eval y) + be * (e₂.eval x - e₂.eval y)|
          ≤ |al * (e₁.eval x - e₁.eval y)| + |be * (e₂.eval x - e₂.eval y)| :=
            abs_add_le _ _
        _ ≤ |al| * (K₁ * |x - y|) + |be| * (K₂ * |x - y|) := by linarith
        _ = (|al| * K₁ + |be| * K₂) * |x - y| := by ring
  | comp e₁ e₂ ih₁ ih₂ =>
      obtain ⟨K₁, hK₁, h₁⟩ := ih₁
      obtain ⟨K₂, hK₂, h₂⟩ := ih₂
      refine ⟨K₁ * K₂, by positivity, fun x y => ?_⟩
      show |e₁.eval (e₂.eval x) - e₁.eval (e₂.eval y)| ≤ K₁ * K₂ * |x - y|
      calc |e₁.eval (e₂.eval x) - e₁.eval (e₂.eval y)|
          ≤ K₁ * |e₂.eval x - e₂.eval y| := h₁ _ _
        _ ≤ K₁ * (K₂ * |x - y|) := mul_le_mul_of_nonneg_left (h₂ x y) hK₁
        _ = K₁ * K₂ * |x - y| := by ring

/-- Every member of the Sheffer algebra is globally Lipschitz. -/
theorem sheffer_lipschitz {f : ℝ → ℝ} (hf : f ∈ ShefferAlgebra) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ x y : ℝ, |f x - f y| ≤ K * |x - y| := by
  obtain ⟨e, he⟩ := hf
  subst he
  exact shefferExpr_lipschitz e

/-- **The squaring function is not Sheffer.**  It grows superlinearly, so it
violates the Lipschitz barrier. -/
theorem sq_not_mem_sheffer : (fun x : ℝ => x ^ 2) ∉ ShefferAlgebra := by
  intro hmem
  obtain ⟨K, hK, h⟩ := sheffer_lipschitz hmem
  have hpos : (0 : ℝ) < K + 1 := by linarith
  have hx := h (K + 1) 0
  simp only at hx
  rw [show ((K + 1 : ℝ) ^ 2 - 0 ^ 2) = (K + 1) ^ 2 by ring,
    abs_of_nonneg (by positivity : (0 : ℝ) ≤ (K + 1) ^ 2),
    show ((K + 1 : ℝ) - 0) = K + 1 by ring, abs_of_nonneg hpos.le] at hx
  nlinarith

/-! ## Sheffer Degree -/

/-- The Sheffer degree of a function: the minimum depth needed to represent it -/
noncomputable def shefferDegree (f : ℝ → ℝ) : ℕ∞ :=
  ⨅ (e : ShefferExpr) (_ : f = e.eval), (e.depth : ℕ∞)

end