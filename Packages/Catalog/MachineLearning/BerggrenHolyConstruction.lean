import MachineLearning.BerggrenNiemeierMoonshine

/-!
# Which holy construction does the Berggren tree actually realise?  (It is `A₁`, not Leech)

Fourth file of the *Moonshine from the null cone* cycle, and the positive answer to the
question left open by the two refutations of
`MachineLearning.BerggrenNiemeierMoonshine`.

Conway's "holy construction" reads the Leech lattice off the even unimodular Lorentzian
lattice `II(25,1)`: if `w` is the primitive **norm-zero** Weyl vector, then

  `w^⊥ / ℤw  ≅  Λ`  (the Leech lattice — positive definite, even, **rootless**, rank 24).

The Berggren tree lives on the null cone of `ℤ^{2,1}`, and its nodes *are* primitive
norm-zero vectors.  So every node of the tree defines its own holy construction.  This
file computes it, exactly.

## Main results

* `perp_root_decomp`, `perp_root_unique` — for the root node `ρ = (3,4,5)` the orthogonal
  lattice `ρ^⊥` has the unimodular basis `{ρ, τ}` with `τ = (2,1,2)`.
* `qform_root_combo` — the induced form on `ρ^⊥/ℤρ` is `y ↦ y²`, i.e. the rank-one *odd*
  unimodular lattice `⟨1⟩`; in the even rescaling `ℤ^{2,1}(2)` used to reach moonshine
  lattices this is `⟨2⟩ = A₁`.
* `holy_construction_root_is_A1` — packaged statement: the Berggren holy construction
  produces a rank-one lattice generated by a **root**.
* `berggren_holy_not_leech` — the sharp contrast with moonshine: the class of `τ` is a
  nonzero vector of norm `2` in the quotient, whereas the Leech lattice has minimum `4`
  and contains no roots at all.  Hence the Lorentzian arithmetic realised by the Berggren
  tree is the `A₁` holy construction, **not** the Leech one.
* `node_holy_construction` — the same computation at *every* node of the tree, obtained by
  transporting along the (invertible, linear) Berggren isometries
  (`applyGens_bijective`, `applyGens_add`, `applyGens_zsmul`).

This is the precise theorem promised by the "if false" branch of the moonshot: the tree is
an integral Lorentzian geometry all right, but the one whose holy construction is the
one-dimensional root lattice `A₁`, at the opposite extreme from the rootless Leech
lattice.
-/

namespace BerggrenStars

/-! ### The Berggren generators are ℤ-linear -/

theorem mA_add (v w : Vec) : mA (v + w) = mA v + mA w := by
  obtain ⟨a, b, c⟩ := v; obtain ⟨p, q, r⟩ := w
  simp only [mA, Prod.mk_add_mk, Prod.mk.injEq]
  refine ⟨by ring, by ring, by ring⟩

theorem mB_add (v w : Vec) : mB (v + w) = mB v + mB w := by
  obtain ⟨a, b, c⟩ := v; obtain ⟨p, q, r⟩ := w
  simp only [mB, Prod.mk_add_mk, Prod.mk.injEq]
  refine ⟨by ring, by ring, by ring⟩

theorem mC_add (v w : Vec) : mC (v + w) = mC v + mC w := by
  obtain ⟨a, b, c⟩ := v; obtain ⟨p, q, r⟩ := w
  simp only [mC, Prod.mk_add_mk, Prod.mk.injEq]
  refine ⟨by ring, by ring, by ring⟩

theorem mA_zsmul (k : ℤ) (v : Vec) : mA (k • v) = k • mA v := by
  obtain ⟨a, b, c⟩ := v
  simp only [mA, Prod.smul_mk, smul_eq_mul, Prod.mk.injEq]
  refine ⟨by ring, by ring, by ring⟩

theorem mB_zsmul (k : ℤ) (v : Vec) : mB (k • v) = k • mB v := by
  obtain ⟨a, b, c⟩ := v
  simp only [mB, Prod.smul_mk, smul_eq_mul, Prod.mk.injEq]
  refine ⟨by ring, by ring, by ring⟩

theorem mC_zsmul (k : ℤ) (v : Vec) : mC (k • v) = k • mC v := by
  obtain ⟨a, b, c⟩ := v
  simp only [mC, Prod.smul_mk, smul_eq_mul, Prod.mk.injEq]
  refine ⟨by ring, by ring, by ring⟩

theorem applyGens_add (g : List Gen) (v w : Vec) :
    applyGens g (v + w) = applyGens g v + applyGens g w := by
  induction g with
  | nil => simp
  | cons x t ih =>
      rw [applyGens_cons, applyGens_cons, applyGens_cons, ih]
      cases x
      · exact mA_add _ _
      · exact mB_add _ _
      · exact mC_add _ _

theorem applyGens_zsmul (g : List Gen) (k : ℤ) (v : Vec) :
    applyGens g (k • v) = k • applyGens g v := by
  induction g with
  | nil => simp
  | cons x t ih =>
      rw [applyGens_cons, applyGens_cons, ih]
      cases x
      · exact mA_zsmul _ _
      · exact mB_zsmul _ _
      · exact mC_zsmul _ _

theorem bil_applyGens (g : List Gen) (v w : Vec) :
    bil (applyGens g v) (applyGens g w) = bil v w := by
  induction g with
  | nil => simp
  | cons x t ih =>
      rw [applyGens_cons, applyGens_cons]
      cases x
      · simp only [Gen.act]; rw [bil_mA]; exact ih
      · simp only [Gen.act]; rw [bil_mB]; exact ih
      · simp only [Gen.act]; rw [bil_mC]; exact ih

/-! ### Berggren words are invertible on the whole lattice -/

theorem reflWord_reverse (rs : List Vec) (h : UnitList rs) (x : Vec) :
    reflWord rs.reverse (reflWord rs x) = x := by
  induction rs generalizing x with
  | nil => simp
  | cons r t ih =>
      have hr : bil r r = 1 := h r (List.mem_cons_self)
      have ht : UnitList t := fun s hs => h s (List.mem_cons_of_mem _ hs)
      rw [List.reverse_cons, reflWord_cons, reflWord_append]
      simp only [reflWord_cons, reflWord_nil]
      rw [reflU_involutive hr]
      exact ih ht x

theorem reflWord_reverse' (rs : List Vec) (h : UnitList rs) (x : Vec) :
    reflWord rs (reflWord rs.reverse x) = x := by
  have hrev : UnitList rs.reverse := fun s hs => h s (List.mem_reverse.mp hs)
  have := reflWord_reverse rs.reverse hrev x
  rwa [List.reverse_reverse] at this

/-- Every Berggren word acts bijectively on the ambient lattice `ℤ^{2,1}`. -/
theorem applyGens_bijective (g : List Gen) : Function.Bijective (applyGens g) := by
  constructor
  · intro v w h
    rw [applyGens_isReflectionWord, applyGens_isReflectionWord] at h
    have := congrArg (reflWord (wordRefl g).reverse) h
    rwa [reflWord_reverse _ (wordRefl_unit g), reflWord_reverse _ (wordRefl_unit g)] at this
  · intro v
    refine ⟨reflWord (wordRefl g).reverse v, ?_⟩
    rw [applyGens_isReflectionWord, reflWord_reverse' _ (wordRefl_unit g)]

/-! ### The holy construction at the root -/

/-- The `A₁`-generator of the Berggren holy construction at the root node `(3,4,5)`. -/
def weylT : Vec := (2, 1, 2)

theorem bil_weylT_root : bil weylT root = 0 := by decide

theorem qform_weylT : qform weylT = 1 := by decide

/-- **The orthogonal lattice of the root is spanned by `ρ` and `τ`.**  Explicit
coordinates: `v = (3c − 2a − 2b) ρ + (5a + 5b − 7c) τ`. -/
theorem perp_root_decomp {v : Vec} (h : bil v root = 0) :
    v = (3 * v.2.2 - 2 * v.1 - 2 * v.2.1) • root + (5 * v.1 + 5 * v.2.1 - 7 * v.2.2) • weylT := by
  obtain ⟨a, b, c⟩ := v
  simp only [bil, root] at h
  simp only [root, weylT, Prod.smul_mk, smul_eq_mul, Prod.mk_add_mk, Prod.mk.injEq]
  refine ⟨by linarith, by linarith, by linarith⟩

/-- Conversely every such combination is orthogonal to `ρ`. -/
theorem bil_combo_root (x y : ℤ) : bil (x • root + y • weylT) root = 0 := by
  simp only [bil, root, weylT, Prod.smul_mk, smul_eq_mul, Prod.mk_add_mk]
  ring

/-- The basis `{ρ, τ}` of `ρ^⊥` is a genuine basis: coordinates are unique. -/
theorem perp_root_unique {x y x' y' : ℤ}
    (h : x • root + y • weylT = x' • root + y' • weylT) : x = x' ∧ y = y' := by
  simp only [root, weylT, Prod.smul_mk, smul_eq_mul, Prod.mk_add_mk, Prod.mk.injEq] at h
  obtain ⟨h1, h2, h3⟩ := h
  constructor <;> [linarith; linarith]

/-- **The induced form on `ρ^⊥/ℤρ` is `y ↦ y²`.**  Since `ρ` is isotropic and orthogonal
to `τ`, the quotient form is the rank-one unimodular form; in the even rescaling
`ℤ^{2,1}(2)` this is `y ↦ 2y²`, i.e. the root lattice `A₁`. -/
theorem qform_root_combo (x y : ℤ) : qform (x • root + y • weylT) = y ^ 2 := by
  simp only [qform, bil, root, weylT, Prod.smul_mk, smul_eq_mul, Prod.mk_add_mk]
  ring

/-- The class of `τ` is nonzero in the quotient `ρ^⊥/ℤρ`. -/
theorem weylT_not_multiple_root (x : ℤ) : weylT ≠ x • root := by
  intro h
  simp only [weylT, root, Prod.smul_mk, smul_eq_mul, Prod.mk.injEq] at h
  omega

/-- **The Berggren holy construction yields `A₁`.**  `τ` is orthogonal to the isotropic
root node `ρ`, is not a multiple of it, has `qform τ = 1` (doubled norm `2`, a root of the
even lattice `ℤ^{2,1}(2)`), and `{ρ, τ}` is a basis of `ρ^⊥` on which the quadratic form is
`y²`. -/
theorem holy_construction_root_is_A1 :
    bil weylT root = 0 ∧ qform weylT = 1 ∧ (∀ x : ℤ, weylT ≠ x • root) ∧
      (∀ v : Vec, bil v root = 0 →
        ∃ x y : ℤ, v = x • root + y • weylT ∧ qform v = y ^ 2) :=
  ⟨bil_weylT_root, qform_weylT, weylT_not_multiple_root, fun v h =>
    ⟨3 * v.2.2 - 2 * v.1 - 2 * v.2.1, 5 * v.1 + 5 * v.2.1 - 7 * v.2.2,
      perp_root_decomp h, by
        conv_lhs => rw [perp_root_decomp h]
        exact qform_root_combo _ _⟩⟩

/-- **The sharp contrast with moonshine.**  Conway's holy construction in `II(25,1)`
produces the Leech lattice, whose minimum in the even normalisation is `4`, so it has *no*
vectors of norm `2`.  The Berggren holy construction produces a quotient in which a
nonzero class *does* have even-normalised norm exactly `2`.  Therefore the quotient is not
Leech-like: the Berggren tree realises the `A₁` Lorentzian arithmetic. -/
theorem berggren_holy_not_leech :
    ∃ t : Vec, bil t root = 0 ∧ (∀ x : ℤ, t ≠ x • root) ∧ 2 * qform t = 2 :=
  ⟨weylT, bil_weylT_root, weylT_not_multiple_root, by rw [qform_weylT]; norm_num⟩

/-! ### The same holy construction at every node of the tree -/

/-- **Every node of the Berggren tree has the same holy construction.**  Transporting
`{ρ, τ}` by the Berggren isometry `applyGens g` gives a basis of the orthogonal lattice of
the node `applyGens g root`, with quotient form `y ↦ y²` again — the `A₁` answer is
uniform over the tree. -/
theorem node_holy_construction (g : List Gen) :
    bil (applyGens g weylT) (applyGens g root) = 0 ∧
      qform (applyGens g weylT) = 1 ∧
      (∀ x : ℤ, applyGens g weylT ≠ x • applyGens g root) ∧
      (∀ v : Vec, bil v (applyGens g root) = 0 →
        ∃ x y : ℤ, v = x • applyGens g root + y • applyGens g weylT ∧ qform v = y ^ 2) := by
  refine ⟨by rw [bil_applyGens]; exact bil_weylT_root,
    by rw [qform, bil_applyGens]; exact qform_weylT, ?_, ?_⟩
  · intro x h
    rw [← applyGens_zsmul] at h
    exact weylT_not_multiple_root x (applyGens_bijective g |>.1 h)
  · intro v hv
    obtain ⟨u, hu⟩ := (applyGens_bijective g).2 v
    have hperp : bil u root = 0 := by
      rw [← bil_applyGens g u root, hu]; exact hv
    obtain ⟨x, y, hxy, hq⟩ := holy_construction_root_is_A1.2.2.2 u hperp
    refine ⟨x, y, ?_, ?_⟩
    · rw [← hu, hxy, applyGens_add, applyGens_zsmul, applyGens_zsmul]
    · rw [← hu, qform, bil_applyGens]; exact hq

end BerggrenStars