/-
# Which marginals?  Exact marginals of an arbitrary collision pattern

Research thread *Compression Beyond the Pigeonhole Bound*, cycle v19c.

The Bonferroni / second-moment machinery of `Geometry.AlmostLosslessConverse` and
`Geometry.BonferroniMarginals` is indifferent to *which* events it is fed; the
content of a failure bound is entirely in the marginals.  `AlmostLosslessCore`
supplies one exact marginal (`card_collisionEvent_mul`, a single pair) and
`AlmostLosslessConverse` one inequality (`card_doubleCollision_mul_le`, two
pairs through a common vertex).  This file computes **all** of them at once.

The organising principle is geometric: a *collision pattern* `P` is a graph on
the index set `ι`, a codebook satisfying the pattern is a function constant on
each connected component, and the marginal is therefore `M^{#components}`.
Rather than developing quotient combinatorics we encode the component structure
by an idempotent **collapse map** `f : ι → ι` (a choice of representative per
component), whose image is the component set.

Main results.

* `CollisionPattern.card_collapseEvent` — for any idempotent `f : ι → ι`, the set
  of codebooks constant on the fibres of `f` has cardinality exactly
  `M ^ |image f|`.  (Bijection with functions on the image.)
* `CollisionPattern.card_patternEvent_of_collapse` — the exact marginal of a
  collision pattern presented by a collapse map.
* `CollisionPattern.card_starEvent` — the **star marginal**: the event that a
  whole set `T` of competitors collides with a fixed `x ∉ T` has cardinality
  `M ^ (|ι| - |T|)`, i.e. probability `M^{-|T|}`.  All higher Bonferroni terms of
  the almost-lossless analysis are instances.
* `CollisionPattern.card_collisionEvent_eq` — recovers
  `AlmostLossless.card_collisionEvent_mul` (`|T| = 1`).
* `CollisionPattern.card_doubleCollision_mul_eq` — **upgrades**
  `AlmostLossless.card_doubleCollision_mul_le` from `≤` to an *equality*: two
  collisions through a common vertex have probability exactly `1/M²`.
* `CollisionPattern.card_disjointPairs_mul_eq` — two collisions on four distinct
  vertices are *exactly independent*, again `1/M²`.  So the two very different
  geometries of a pair of edges (sharing a vertex or not) have the *same*
  second marginal: the Bonferroni input is blind to the shape of the pattern and
  sees only its component count.
-/
import Geometry.AlmostLosslessConverse

namespace CollisionPattern

open Finset AlmostLossless

variable {ι : Type*} [Fintype ι] [DecidableEq ι] {M : ℕ}

/-! ## 1. Collapse maps and their exact marginals -/

/-- The event that a codebook is constant on the fibres of `f`, i.e. factors
through `f`. -/
def collapseEvent (M : ℕ) (f : ι → ι) : Finset (ι → Fin M) :=
  univ.filter (fun H => ∀ a, H (f a) = H a)

/-- **Exact marginal of a collapse map.**  For an idempotent `f : ι → ι` the
codebooks constant on the fibres of `f` are in bijection with the functions on
the image of `f`, so the event has cardinality exactly `M ^ |image f|`. -/
theorem card_collapseEvent (f : ι → ι) (hf : ∀ a, f (f a) = f a) :
    (collapseEvent M f).card = M ^ (univ.image f).card := by
  classical
  have hfix : ∀ s ∈ univ.image f, f s = s := by
    intro s hs
    obtain ⟨b, -, hb⟩ := mem_image.1 hs
    rw [← hb, hf]
  let e : {H : ι → Fin M // ∀ a, H (f a) = H a} ≃ ({a : ι // a ∈ univ.image f} → Fin M) :=
    { toFun := fun H s => H.1 s.1
      invFun := fun g => ⟨fun a => g ⟨f a, mem_image_of_mem f (mem_univ a)⟩, by
        intro a
        exact congrArg g (Subtype.ext (hf a))⟩
      left_inv := by
        intro H
        apply Subtype.ext
        funext a
        exact H.2 a
      right_inv := by
        intro g
        funext s
        have hs : f s.1 = s.1 := hfix s.1 s.2
        exact congrArg g (Subtype.ext hs) }
  have h1 : (collapseEvent M f).card = Fintype.card {H : ι → Fin M // ∀ a, H (f a) = H a} := by
    rw [Fintype.card_subtype]
    rfl
  rw [h1, Fintype.card_congr e, Fintype.card_fun, Fintype.card_coe, Fintype.card_fin]

/-- A *collision pattern* `P` (a finite set of pairs, i.e. a graph on `ι`): the
event that a codebook collides on every pair of `P`. -/
def patternEvent (M : ℕ) (P : Finset (ι × ι)) : Finset (ι → Fin M) :=
  univ.filter (fun H => ∀ p ∈ P, H p.1 = H p.2)

/-- **Exact marginal of a collision pattern presented by a collapse map.**
If `f` is idempotent, identifies the two ends of every pattern edge, and every
codebook respecting the pattern is constant on the fibres of `f` (i.e. `f` picks
representatives of the connected components generated by `P`), then the pattern
event has cardinality exactly `M ^ |image f|` — `M` to the number of components. -/
theorem card_patternEvent_of_collapse (P : Finset (ι × ι)) (f : ι → ι)
    (hf : ∀ a, f (f a) = f a) (hedge : ∀ p ∈ P, f p.1 = f p.2)
    (hgen : ∀ H : ι → Fin M, (∀ p ∈ P, H p.1 = H p.2) → ∀ a, H (f a) = H a) :
    (patternEvent M P).card = M ^ (univ.image f).card := by
  have hset : patternEvent M P = collapseEvent M f := by
    ext H
    simp only [patternEvent, collapseEvent, mem_filter, mem_univ, true_and]
    constructor
    · exact hgen H
    · intro h p hp
      rw [← h p.1, ← h p.2, hedge p hp]
  rw [hset, card_collapseEvent f hf]

/-! ## 2. The star marginal: `|T|` competitors colliding with a fixed point -/

/-- The event that every member of `T` collides with `x`. -/
def starEvent (M : ℕ) (T : Finset ι) (x : ι) : Finset (ι → Fin M) :=
  univ.filter (fun H => ∀ y ∈ T, H y = H x)

/-- **The star marginal is exact.**  If `x ∉ T` then
`|{H : H y = H x for all y ∈ T}| = M ^ (|ι| - |T|)`, i.e. the probability of a
prescribed star of `|T|` collisions is exactly `M^{-|T|}`.  This is the complete
family of marginals that any Bonferroni-type expansion of the almost-lossless
failure event can be fed. -/
theorem card_starEvent (T : Finset ι) (x : ι) (hx : x ∉ T) :
    (starEvent M T x).card = M ^ (Fintype.card ι - T.card) := by
  classical
  set f : ι → ι := fun a => if a ∈ T then x else a with hfdef
  have hf : ∀ a, f (f a) = f a := by
    intro a
    by_cases ha : a ∈ T
    · simp [hfdef, ha]
    · simp [hfdef, ha]
  have himg : univ.image f = univ \ T := by
    ext s
    simp only [mem_image, mem_univ, true_and, mem_sdiff, hfdef]
    constructor
    · rintro ⟨b, hb⟩
      by_cases hbT : b ∈ T
      · rw [if_pos hbT] at hb
        exact hb ▸ hx
      · rw [if_neg hbT] at hb
        exact hb ▸ hbT
    · intro hs
      exact ⟨s, by rw [if_neg hs]⟩
  have hcard : (univ.image f).card = Fintype.card ι - T.card := by
    rw [himg, Finset.card_univ_diff]
  have hset : starEvent M T x = collapseEvent M f := by
    ext H
    simp only [starEvent, collapseEvent, mem_filter, mem_univ, true_and, hfdef]
    constructor
    · intro h a
      by_cases ha : a ∈ T
      · rw [if_pos ha, h a ha]
      · rw [if_neg ha]
    · intro h y hy
      have hy' := h y
      rw [if_pos hy] at hy'
      exact hy'.symm
  rw [hset, card_collapseEvent f hf, hcard]

/-! ## 3. Consequences: the catalog marginals, exactly -/

/-- The star event of a singleton is the collision event. -/
theorem starEvent_singleton (p q : ι) :
    starEvent M {p} q = collisionEvent M p q := by
  ext H
  simp [starEvent, AlmostLossless.collisionEvent]

/-- **Exact first marginal**, recovering `AlmostLossless.card_collisionEvent_mul`
in closed form: a prescribed collision has probability exactly `1/M`. -/
theorem card_collisionEvent_eq {p q : ι} (hpq : p ≠ q) :
    (collisionEvent M p q).card = M ^ (Fintype.card ι - 1) := by
  rw [← starEvent_singleton p q, card_starEvent {p} q (by simpa using hpq.symm),
    Finset.card_singleton]

/-- **The second marginal of `AlmostLosslessConverse` is an equality.**  Two
collisions through a common vertex have probability exactly `1/M²`; the
inequality `AlmostLossless.card_doubleCollision_mul_le` loses nothing.  (Here
`2 ≤ |ι|` is automatic from the three distinct indices, and is used only to
handle the exponent arithmetic.) -/
theorem card_doubleCollision_mul_eq {p q r : ι} (hpq : p ≠ q) (hpr : p ≠ r) (hqr : q ≠ r) :
    M ^ 2 * ((collisionEvent M p r) ∩ (collisionEvent M q r)).card
      = M ^ Fintype.card ι := by
  classical
  have hset : (collisionEvent M p r) ∩ (collisionEvent M q r) = starEvent M {p, q} r := by
    ext H
    simp only [starEvent, AlmostLossless.collisionEvent, Finset.mem_inter, mem_filter,
      mem_univ, true_and, Finset.mem_insert, Finset.mem_singleton]
    constructor
    · rintro ⟨h1, h2⟩ y hy
      rcases hy with hy | hy <;> subst hy
      · exact h1
      · exact h2
    · intro h
      exact ⟨h p (Or.inl rfl), h q (Or.inr rfl)⟩
  have hcard : ({p, q} : Finset ι).card = 2 := by
    rw [Finset.card_insert_of_notMem (by simpa using hpq), Finset.card_singleton]
  have hr : r ∉ ({p, q} : Finset ι) := by
    simp only [Finset.mem_insert, Finset.mem_singleton]
    push_neg
    exact ⟨Ne.symm hpr, Ne.symm hqr⟩
  have hle : 2 ≤ Fintype.card ι := by
    have : ({p, q} : Finset ι).card ≤ Fintype.card ι := by
      simpa using Finset.card_le_univ ({p, q} : Finset ι)
    omega
  rw [hset, card_starEvent {p, q} r hr, hcard, ← pow_add]
  congr 1
  omega

/-- **Two collisions on disjoint pairs are exactly independent.**  For the event
`H p = H q ∧ H r = H s` with `p, q, r` distinct, `p ≠ s` and `r ≠ s`, the
probability is exactly `1/M²` — the same second marginal as the vertex-sharing
pattern above.  Note that `q = s` is *allowed*: the proof only needs the two
collapsed vertices `p, r` to be distinct from each other and from their targets.
Hence the Bonferroni input is a function of the *component count* of the pattern
only, and not of its geometry. -/
theorem card_disjointPairs_mul_eq {p q r s : ι} (hpq : p ≠ q) (hrs : r ≠ s)
    (hpr : p ≠ r) (hps : p ≠ s) (hqr : q ≠ r) :
    M ^ 2 * ((collisionEvent M p q) ∩ (collisionEvent M r s)).card
      = M ^ Fintype.card ι := by
  classical
  set f : ι → ι := fun a => if a = p then q else if a = r then s else a with hfdef
  have hf : ∀ a, f (f a) = f a := by
    intro a
    by_cases ha : a = p
    · simp [hfdef, ha, Ne.symm hpq, hqr]
    · by_cases hb : a = r
      · simp [hfdef, hb, Ne.symm hpr, Ne.symm hps, Ne.symm hrs]
      · simp [hfdef, ha, hb]
  have hset : (collisionEvent M p q) ∩ (collisionEvent M r s)
      = collapseEvent M f := by
    ext H
    simp only [collapseEvent, AlmostLossless.collisionEvent, Finset.mem_inter, mem_filter,
      mem_univ, true_and, hfdef]
    constructor
    · rintro ⟨h1, h2⟩ a
      by_cases ha : a = p
      · rw [if_pos ha, ha, h1]
      · by_cases hb : a = r
        · rw [if_neg ha, if_pos hb, hb, h2]
        · rw [if_neg ha, if_neg hb]
    · intro h
      refine ⟨?_, ?_⟩
      · have hp := h p
        rw [if_pos rfl] at hp
        exact hp.symm
      · have hr := h r
        rw [if_neg (Ne.symm hpr), if_pos rfl] at hr
        exact hr.symm
  have himg : univ.image f = univ \ {p, r} := by
    ext z
    simp only [mem_image, mem_univ, true_and, mem_sdiff, Finset.mem_insert,
      Finset.mem_singleton, hfdef]
    constructor
    · rintro ⟨b, hb⟩
      by_cases hbp : b = p
      · rw [if_pos hbp] at hb
        subst hb
        push_neg
        exact ⟨Ne.symm hpq, hqr⟩
      · by_cases hbr : b = r
        · rw [if_neg hbp, if_pos hbr] at hb
          subst hb
          push_neg
          exact ⟨Ne.symm hps, Ne.symm hrs⟩
        · rw [if_neg hbp, if_neg hbr] at hb
          subst hb
          push_neg
          exact ⟨hbp, hbr⟩
    · intro hz
      push_neg at hz
      exact ⟨z, by rw [if_neg hz.1, if_neg hz.2]⟩
  have hcard : (univ.image f).card = Fintype.card ι - 2 := by
    have hpr' : ({p, r} : Finset ι).card = 2 := by
      rw [Finset.card_insert_of_notMem (by simpa using hpr), Finset.card_singleton]
    rw [himg, Finset.card_univ_diff, hpr']
  have hle : 2 ≤ Fintype.card ι := by
    have h2 : ({p, r} : Finset ι).card ≤ Fintype.card ι := by
      simpa using Finset.card_le_univ ({p, r} : Finset ι)
    have hpr' : ({p, r} : Finset ι).card = 2 := by
      rw [Finset.card_insert_of_notMem (by simpa using hpr), Finset.card_singleton]
    omega
  rw [hset, card_collapseEvent f hf, hcard, ← pow_add]
  congr 1
  omega

end CollisionPattern