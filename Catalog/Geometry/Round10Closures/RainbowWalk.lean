/-
Round-10 Closures — Part III: the smooth-step ("rainbow") walk carries no gcd signal.

Experiment 338 (RAINBOWWALK) studied the multiplicative walk `x ↦ x * s (mod N)` with a
smooth step `s`.  The verdict was that the walk is a quadratic-sieve/NFS engine wearing a
walk mask: *every* value it visits is a unit modulo `N`, so the gcd channel — the only
channel through which a random walk can emit a factor — is identically trivial, and the
orbit is a coset of the cyclic group generated by `s`, hence periodic with period dividing
`ord_N(s)`: the walk never escapes the birthday floor of that subgroup.

This file proves all three statements and combines them into a formal "no factor from the
walk" theorem, phrased with the catalog's `FactoringBarriers.NontrivialDivisor`.
-/
import Geometry.Round10Closures.TraceLemma
import Cryptography.FactoringBarriers.CongruenceOfSquares

namespace Round10

open FactoringBarriers

/-- The smooth-step walk modulo `N`: start at `x`, multiply by the step `s` each round. -/
def smoothWalk (N x s : ℕ) : ℕ → ℕ
  | 0 => x % N
  | t + 1 => (smoothWalk N x s t * s) % N

/-- Closed form of the walk: `x_t = x * s^t (mod N)`. -/
theorem smoothWalk_eq (N x s : ℕ) : ∀ t, smoothWalk N x s t = (x * s ^ t) % N := by
  intro t
  induction t with
  | zero => simp [smoothWalk]
  | succ t ih =>
      rw [smoothWalk, ih, Nat.mod_mul_mod, pow_succ, ← mul_assoc]

/-- **No gcd signal (barrier 8/5).**  If the seed and the step are coprime to `N`, then
every value visited by the walk is a unit modulo `N`. -/
theorem smoothWalk_coprime {N x s : ℕ} (hx : Nat.Coprime x N) (hs : Nat.Coprime s N) :
    ∀ t, Nat.Coprime (smoothWalk N x s t) N := by
  intro t
  induction t with
  | zero => exact (ZMod.coprime_mod_iff_coprime x N).mpr hx
  | succ t ih =>
      exact (ZMod.coprime_mod_iff_coprime _ N).mpr (Nat.Coprime.mul_left ih hs)

/-- The gcd read off any walk value is the trivial divisor `1`. -/
theorem smoothWalk_gcd_eq_one {N x s : ℕ} (hx : Nat.Coprime x N) (hs : Nat.Coprime s N)
    (t : ℕ) : Nat.gcd (smoothWalk N x s t) N = 1 :=
  smoothWalk_coprime hx hs t

/-- **The walk cannot factor.**  No value of a smooth-step walk with unit seed and unit
step ever yields a nontrivial divisor of `N` through the gcd channel. -/
theorem smoothWalk_no_nontrivialDivisor {N x s : ℕ} (hx : Nat.Coprime x N)
    (hs : Nat.Coprime s N) (t : ℕ) :
    ¬ NontrivialDivisor N (Nat.gcd (smoothWalk N x s t) N) := by
  rintro ⟨-, h1, -⟩
  rw [smoothWalk_gcd_eq_one hx hs t] at h1
  omega

/-- **The orbit is a coset.**  If `s ^ r ≡ 1 (mod N)` then the walk is periodic with
period `r`; its orbit has at most `r` distinct values, whatever the seed. -/
theorem smoothWalk_periodic {N x s r : ℕ} (hr : s ^ r % N = 1 % N) (t : ℕ) :
    smoothWalk N x s (t + r) = smoothWalk N x s t := by
  have h : (x * s ^ t) * s ^ r ≡ (x * s ^ t) * 1 [MOD N] := Nat.ModEq.mul_left _ hr
  rw [smoothWalk_eq, smoothWalk_eq, pow_add, ← mul_assoc]
  simpa using h

/-- With a unit step of multiplicative order `r`, the walk revisits its seed after exactly
`r` steps: the "randomness" of the walk is nothing beyond the cyclic subgroup `⟨s⟩`. -/
theorem smoothWalk_period_orderOf {N : ℕ} [NeZero N] (x : ℕ) (u : (ZMod N)ˣ) (t : ℕ) :
    smoothWalk N x ((u : ZMod N).val) (t + orderOf u) = smoothWalk N x ((u : ZMod N).val) t := by
  refine smoothWalk_periodic ?_ t
  have hu : ((u : ZMod N)) ^ orderOf u = 1 := by
    rw [← Units.val_pow_eq_pow_val, pow_orderOf_eq_one u, Units.val_one]
  have : (((( u : ZMod N).val) ^ orderOf u : ℕ) : ZMod N) = ((1 : ℕ) : ZMod N) := by
    push_cast
    rw [ZMod.natCast_val, ZMod.cast_id, hu]
  exact (ZMod.natCast_eq_natCast_iff' _ _ _).mp this

end Round10