import Mathlib
import Catalog.Logic.ProofTheoryAndLogic.Propositional

/-!
# Theory genomes, semantic equivalence, and mutations

A theory is represented by its category of models.  The resulting `Genome` retains
models and their homomorphisms, rather than merely the set of isomorphism classes.
A semantic presentation consists of translations in both directions together with
coherent comparison isomorphisms.  This makes the slogan “Morita equivalence is
equivalence of model categories” an exact theorem.

Changing axioms is not automatically an adjunction: a change is called a `Mutation`
only when its forward interpretation has a right adjoint.  Reflective mutations add
the important boundary condition that the right adjoint is fully faithful.  Finite
evolutionary paths are generated by mutations, reflective quotients, and composition;
their composite semantics is again an adjunction.

-- !-- Lab Notes -- !--
Hypothesis (Stage 1, ranked by impact):
1. Every interpretation path generated by axiom changes and reflective quotients has
   a composite adjunction between its endpoint genomes.
2. Morita equivalence is precisely equivalence of genomes, including homomorphisms.
3. Every semantic equivalence produces reversible mutations in both directions.
4. Reflective quotients are stable under composition and therefore form a calculus of
   conservative axiom addition.
5. The monad induced by a mutation records the closure operation generated by the new
   axiom.
6. Semantic equivalence of propositional formulas is stable under compositional
   contexts, linking categorical comparison with the catalog's formula semantics.
7. Bold conjecture: every mathematically natural interpretation between essentially
   algebraic theories factors into a localization, a monadic mutation, and a Morita
   equivalence.

Experiment (Stage 2): conjectures 1--4 are established below at the level of arbitrary
categories.  Conjecture 5 survives as the canonical construction `Mutation.monad`.
Conjecture 6 is linked to the catalog's propositional semantics.  Conjecture 7 remains
open because unrestricted functors need not possess adjoints or reflective
factorizations.

Analysis (Stage 3): equivalences are stronger than one-way mutations: their unit and
counit are isomorphisms, so they yield adjunctions in both orientations.  Adjunctions
compose, while fully faithful right adjoints compose; these two closure facts explain
why generated evolutionary paths possess a single endpoint semantics.

Critique (Stage 4): the unguarded claim that changing one axiom always creates an
adjunction is false as a definition-free assertion: an arbitrary functor between model
categories need not have either adjoint.  Likewise, defining an “evolutionary path” to
mean an arbitrary functor would make the decomposition conjecture false.  The guarded
notions below expose rather than hide these hypotheses.  No claim is made that every
mathematical structure is literally a category or every theorem literally a natural
transformation; instead, natural transformations compare functorial interpretations.

Synthesis (Stage 5): `morita_iff_genome_equivalent`, `morita_reversible_mutations`,
`ReflectiveMutation.comp`, and `Evolution.realize` form a hierarchy from semantic
identity through mutation to finite paths.  The propositional bridge supplies a
concrete logical instance of semantic replacement inside an implication context.
-- !-- Lab Notes -- !--
-/

open CategoryTheory

universe v u v' u' v'' u''

namespace TheoryGenome

/-- A mathematical theory together with its category of models and homomorphisms. -/
structure Theory where
  Model : Type u
  modelCategory : Category.{v} Model

attribute [instance] Theory.modelCategory

/-- The genome of a theory is its full category of models. -/
abbrev Genome (T : Theory.{v, u}) := T.Model

/-- Bidirectional semantic translations with comparison isomorphisms. -/
structure SemanticPresentation (T : Theory.{v, u}) (U : Theory.{v', u'}) where
  toModels : Genome T ⥤ Genome U
  fromModels : Genome U ⥤ Genome T
  unitIso : 𝟭 (Genome T) ≅ toModels ⋙ fromModels
  counitIso : fromModels ⋙ toModels ≅ 𝟭 (Genome U)

/-- Morita equivalence expressed without choosing a privileged syntax. -/
def MoritaEquivalent (T : Theory.{v, u}) (U : Theory.{v', u'}) : Prop :=
  Nonempty (SemanticPresentation T U)

/-- Morita equivalence is exactly equivalence of categories of models. -/
theorem morita_iff_genome_equivalent (T : Theory.{v, u}) (U : Theory.{v', u'}) :
    MoritaEquivalent T U ↔ Nonempty (Genome T ≌ Genome U) := by
  constructor
  · rintro ⟨P⟩
    exact ⟨CategoryTheory.Equivalence.mk P.toModels P.fromModels P.unitIso P.counitIso⟩
  · rintro ⟨E⟩
    exact ⟨⟨E.functor, E.inverse, E.unitIso, E.counitIso⟩⟩

/-- A mutation is an interpretation whose forward map has a specified right adjoint. -/
structure Mutation (T : Theory.{v, u}) (U : Theory.{v', u'}) where
  forward : Genome T ⥤ Genome U
  backward : Genome U ⥤ Genome T
  adjunction : forward ⊣ backward

/-- Mutations compose, so successive axiom changes have a single endpoint semantics. -/
def Mutation.comp {T : Theory.{v, u}} {U : Theory.{v', u'}} {V : Theory.{v'', u''}}
    (M₁ : Mutation T U) (M₂ : Mutation U V) : Mutation T V where
  forward := M₁.forward ⋙ M₂.forward
  backward := M₂.backward ⋙ M₁.backward
  adjunction := M₁.adjunction.comp M₂.adjunction

/-- The identity interpretation is a neutral mutation. -/
def Mutation.identity (T : Theory.{v, u}) : Mutation T T where
  forward := 𝟭 (Genome T)
  backward := 𝟭 (Genome T)
  adjunction := Adjunction.id

/-- Every mutation canonically generates a monad on its source genome. -/
def Mutation.monad {T : Theory.{v, u}} {U : Theory.{v', u'}} (M : Mutation T U) :
    Monad (Genome T) :=
  M.adjunction.toMonad

/-- A reflective mutation models quotienting or axiom addition: the inclusion of
local models is fully faithful. -/
structure ReflectiveMutation (T : Theory.{v, u}) (U : Theory.{v', u'})
    extends Mutation T U where
  backwardFullyFaithful : backward.FullyFaithful

/-- Reflective mutations are stable under composition. -/
def ReflectiveMutation.comp {T : Theory.{v, u}} {U : Theory.{v', u'}}
    {V : Theory.{v'', u''}} (Q₁ : ReflectiveMutation T U)
    (Q₂ : ReflectiveMutation U V) : ReflectiveMutation T V where
  toMutation := Q₁.toMutation.comp Q₂.toMutation
  backwardFullyFaithful := Q₂.backwardFullyFaithful.comp Q₁.backwardFullyFaithful

/-- An adjunction packaged independently of any proposed syntactic presentation. -/
structure AdjunctionWitness (T : Theory.{v, u}) (U : Theory.{v', u'}) where
  left : Genome T ⥤ Genome U
  right : Genome U ⥤ Genome T
  adjunction : left ⊣ right

/-- Finite evolutionary paths generated by mutations and reflective quotients. -/
inductive Evolution : (T U : Theory.{v, u}) → Type (max (u + 1) (v + 1))
  | mutation {T U} (M : Mutation T U) : Evolution T U
  | quotient {T U} (Q : ReflectiveMutation T U) : Evolution T U
  | trans {T U V} (first : Evolution T U) (second : Evolution U V) : Evolution T V

/-- Every generated evolutionary path has a composite adjunction between endpoint
model categories. -/
def Evolution.realize {T U : Theory.{v, u}} :
    Evolution T U → AdjunctionWitness T U
  | .mutation M => ⟨M.forward, M.backward, M.adjunction⟩
  | .quotient Q => ⟨Q.forward, Q.backward, Q.adjunction⟩
  | .trans first second =>
      let A := Evolution.realize first
      let B := Evolution.realize second
      ⟨A.left ⋙ B.left, B.right ⋙ A.right, A.adjunction.comp B.adjunction⟩

/-- Every generated evolutionary path determines a mutation between its endpoint genomes.
This is the formal decomposition statement: realizing the path composes the adjunctions
carried by its mutation and quotient stages. -/
theorem evolution_induces_mutation {T U : Theory.{v, u}} (path : Evolution T U) :
    Nonempty (Mutation T U) := by
  let semantics := Evolution.realize path
  exact ⟨⟨semantics.left, semantics.right, semantics.adjunction⟩⟩

/-- A Morita equivalence supplies mutations in both semantic directions. -/
theorem morita_reversible_mutations {T : Theory.{v, u}} {U : Theory.{v', u'}}
    (h : MoritaEquivalent T U) : Nonempty (Mutation T U) ∧ Nonempty (Mutation U T) := by
  obtain ⟨E⟩ := (morita_iff_genome_equivalent T U).mp h
  constructor
  · exact ⟨⟨E.functor, E.inverse, E.toAdjunction⟩⟩
  · exact ⟨⟨E.inverse, E.functor, E.symm.toAdjunction⟩⟩

/-- Morita-equivalent theories are connected by generated evolutionary paths in both
semantic directions. -/
theorem morita_reversible_evolutions {T : Theory.{v, u}} {U : Theory.{v, u}}
    (h : MoritaEquivalent T U) :
    Nonempty (Evolution T U) ∧ Nonempty (Evolution U T) := by
  obtain ⟨⟨forward⟩, ⟨backward⟩⟩ := morita_reversible_mutations h
  exact ⟨⟨Evolution.mutation forward⟩, ⟨Evolution.mutation backward⟩⟩

/-- Semantic equivalence is substitutive in both arguments of implication.  This is a
concrete logical instance of compositional semantic comparison. -/
theorem implication_context_respects_semantic_equivalence
    {p p' q q' : Logic.Propositional.Formula}
    (hp : Logic.Propositional.Formula.SemEq p p')
    (hq : Logic.Propositional.Formula.SemEq q q') :
    Logic.Propositional.Formula.SemEq
      (.imp p q) (.imp p' q') := by
  intro valuation
  simp only [Logic.Propositional.Formula.eval]
  rw [hp valuation, hq valuation]

end TheoryGenome