/-
# Persistent Homology of Musical Harmony: The Topology of Bach

## Mission framing

Encode the twelve pitch classes of the chromatic scale as the cyclic group
`PC = ZMod 12` (one representative per octave-equivalence class).  A musical
*interval* of `k` semitones is the group element `(k : PC)`, and *stacking* that
interval repeatedly — the harmonic gesture that generates a chord progression —
traces the cyclic subgroup it generates.

The mission's central object is the **circle of fifths**: iterating the perfect
fifth (`k = 7` semitones) visits *all twelve* pitch classes before returning to
the start, forming the single longest harmonic cycle available in twelve-tone
equal temperament.  In the persistent-homology picture of the mission this is
the longest `H₁` bar: the fundamental circular harmonic motion that Bach's
chorales realise.  Other intervals close up into strictly shorter cycles
(shorter `H₁` bars): the tritone (`k = 6`) into a 2-cycle, the major third
(`k = 4`) into a 3-cycle, and so on.

This file makes that idea precise and proves it, building a chain of results:

* `cycleLen k` — the number of distinct pitch classes reached by stacking the
  interval `k`, i.e. the additive order of `(k : PC)`.  This is the *length of
  the harmonic cycle* generated by the interval, our formal proxy for the length
  of an `H₁` bar.
* `cycleLen_eq` — the closed form `cycleLen k = 12 / gcd 12 k`.
* Concrete values: fifth `= 12`, tritone `= 2`, major third `= 3`, whole tone
  `= 6`, minor third `= 4`, semitone `= 12`.
* `cycleLen_le` / `fifth_cycleLen_maximal` — no interval beats the fifth.
* `cycleLen_dvd_12` — every harmonic cycle length divides `12` (Lagrange).
* `cycleLen_eq_12_iff` — an interval spans all twelve pitch classes **iff** it is
  coprime to `12`.
* `maximal_generators` — the maximal generators are exactly `{1, 5, 7, 11}`.
* `fifth_generates` / `generates_iff` — the fifth generates the *entire*
  pitch-class group, and an interval does so iff it is coprime to `12`.

Everything is self-contained on top of Mathlib.
-/

import Mathlib

open scoped Classical

namespace BachTopology

/-- The twelve pitch classes of the chromatic scale, as the cyclic group
`ℤ/12ℤ`.  Two pitches are identified iff they differ by whole octaves. -/
abbrev PC : Type := ZMod 12

/-- The **harmonic cycle length** of an interval of `k` semitones: the number of
distinct pitch classes visited by stacking the interval `(k : PC)` before it
returns to its starting point.  Formally the additive order of `(k : PC)`.

This is our formal proxy for the length of the `H₁` persistence bar attached to
the harmonic motion "keep transposing by `k`". -/
noncomputable def cycleLen (k : ℕ) : ℕ := addOrderOf ((k : ℕ) : PC)

/-- **Closed form.** The harmonic cycle length of the interval `k` is
`12 / gcd(12, k)`.  This is the arithmetic engine behind every subsequent
result. -/
lemma cycleLen_eq (k : ℕ) : cycleLen k = 12 / Nat.gcd 12 k := by
  unfold cycleLen
  rw [ZMod.addOrderOf_coe k (by norm_num)]

/-- The pitch-class group has exactly twelve elements. -/
lemma card_PC : Nat.card PC = 12 := by
  simp [Nat.card_eq_fintype_card, ZMod.card]

/-! ### Concrete harmonic cycle lengths -/

/-- **The circle of fifths spans all twelve pitch classes.**  Stacking perfect
fifths (`k = 7`) visits every pitch class before returning home: the longest
harmonic cycle in twelve-tone equal temperament. -/
theorem fifth_cycleLen : cycleLen 7 = 12 := by
  rw [cycleLen_eq]; decide

/-- The tritone (`k = 6`) closes up into a mere 2-cycle. -/
theorem tritone_cycleLen : cycleLen 6 = 2 := by
  rw [cycleLen_eq]; decide

/-- The major third (`k = 4`, the augmented triad) closes up into a 3-cycle. -/
theorem majThird_cycleLen : cycleLen 4 = 3 := by
  rw [cycleLen_eq]; decide

/-- The whole tone (`k = 2`, the whole-tone scale) closes up into a 6-cycle. -/
theorem wholeTone_cycleLen : cycleLen 2 = 6 := by
  rw [cycleLen_eq]; decide

/-- The minor third (`k = 3`, the diminished-seventh chord) closes up into a
4-cycle. -/
theorem minorThird_cycleLen : cycleLen 3 = 4 := by
  rw [cycleLen_eq]; decide

/-- The semitone (`k = 1`, the chromatic scale) also spans all twelve pitch
classes.  It is coprime to `12`, hence maximal — see `maximal_generators`. -/
theorem semitone_cycleLen : cycleLen 1 = 12 := by
  rw [cycleLen_eq]; decide

/-! ### Structural bounds: the fifth is maximal -/

/-- No harmonic cycle can exceed the twelve available pitch classes. -/
theorem cycleLen_le (k : ℕ) : cycleLen k ≤ 12 := by
  rw [cycleLen_eq]; exact Nat.div_le_self 12 _

/-- **The circle of fifths is a longest harmonic cycle.**  For *every* interval
`k`, the cycle it generates is no longer than the circle of fifths.  This is the
formal core of the mission's headline claim that the circle of fifths realises
the longest `H₁` bar. -/
theorem fifth_cycleLen_maximal (k : ℕ) : cycleLen k ≤ cycleLen 7 := by
  rw [fifth_cycleLen]; exact cycleLen_le k

/-- **Lagrange for harmonic cycles.**  Every harmonic cycle length divides `12`:
harmonic cycles tile the octave. -/
theorem cycleLen_dvd_12 (k : ℕ) : cycleLen k ∣ 12 := by
  rw [cycleLen_eq]
  exact Nat.div_dvd_of_dvd (Nat.gcd_dvd_left 12 k)

/-! ### Characterising the maximal (spanning) intervals -/

/-- **An interval spans all twelve pitch classes iff it is coprime to `12`.**
Equivalently: the harmonic cycle has maximal length exactly when the interval
generates the pitch-class group additively. -/
theorem cycleLen_eq_12_iff (k : ℕ) : cycleLen k = 12 ↔ Nat.gcd 12 k = 1 := by
  rw [cycleLen_eq]
  constructor
  · intro h
    have hmul : Nat.gcd 12 k * (12 / Nat.gcd 12 k) = 12 :=
      Nat.mul_div_cancel' (Nat.gcd_dvd_left 12 k)
    rw [h] at hmul; omega
  · intro h; rw [h]

/-- **The maximal generators are exactly `{1, 5, 7, 11}`.**  Among the twelve
intervals, precisely the semitone, perfect fourth, perfect fifth and major
seventh span all twelve pitch classes.  The perfect fifth `7` is the classical
"circle of fifths" representative. -/
theorem maximal_generators (k : ℕ) (hk : k < 12) :
    cycleLen k = 12 ↔ (k = 1 ∨ k = 5 ∨ k = 7 ∨ k = 11) := by
  rw [cycleLen_eq_12_iff]
  interval_cases k <;> decide

/-! ### The circle of fifths generates the whole pitch-class group -/

/-- **The circle of fifths generates every pitch class.**  The subgroup of `PC`
generated by the perfect fifth is the entire pitch-class group: from any single
note, stacking fifths reaches all twelve pitch classes. -/
theorem fifth_generates : AddSubgroup.zmultiples ((7 : ℕ) : PC) = ⊤ := by
  apply AddSubgroup.eq_top_of_card_eq
  rw [Nat.card_zmultiples, card_PC]
  have h := fifth_cycleLen
  unfold cycleLen at h
  exact h

/-- **Generation is characterised by coprimality.**  Stacking the interval `k`
reaches every pitch class iff `k` is coprime to `12`.  This unifies
`fifth_generates` (the `k = 7` case) with the arithmetic criterion. -/
theorem generates_iff (k : ℕ) :
    AddSubgroup.zmultiples ((k : ℕ) : PC) = ⊤ ↔ Nat.gcd 12 k = 1 := by
  rw [← cycleLen_eq_12_iff]
  have hcard : Nat.card (AddSubgroup.zmultiples ((k : ℕ) : PC)) = cycleLen k := by
    rw [Nat.card_zmultiples]; rfl
  constructor
  · intro h
    have htop : Nat.card (AddSubgroup.zmultiples ((k : ℕ) : PC)) = 12 := by
      rw [h, Nat.card_congr AddSubgroup.topEquiv.toEquiv]
      simp [Nat.card_eq_fintype_card, ZMod.card]
    rw [hcard] at htop; exact htop
  · intro h
    apply AddSubgroup.eq_top_of_card_eq
    rw [hcard, h]
    simp [Nat.card_eq_fintype_card, ZMod.card]

end BachTopology