+/-- Final package: one metric space simultaneously has infinite Hausdorff
+dimension, embeds topologically in the Hilbert cube, has no antilipschitz map
+to any finite-dimensional normed real space, and has no finite cover by pieces
+of finite Hausdorff dimension. -/
+theorem hilbert_cube_transfinite_surface :
+    dimH (univ : Set (lp (fun _ : ℕ => ℝ) 2)) = ⊤ ∧
+    (∃ f : lp (fun _ : ℕ => ℝ) 2 → (ℕ → unitInterval), Topology.IsEmbedding f) ∧
+    (∀ (E : Type) [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E],
+      ¬ ∃ (K : NNReal) (f : lp (fun _ : ℕ => ℝ) 2 → E), AntilipschitzWith K f) ∧
+    (∀ (m : ℕ) (t : Fin m → Set (lp (fun _ : ℕ => ℝ) 2)),
+      ¬ ((univ : Set (lp (fun _ : ℕ => ℝ) 2)) ⊆ ⋃ i, t i ∧
+         ∀ i, dimH (t i) ≠ ⊤)) := by
+  refine ⟨dimH_univ_lp_top, exists_embedding_lp_to_hilbert_cube, ?_,
+    lp_no_finite_finiteDim_cover⟩
+  intro E _ _ _
+  exact no_antilipschitz_to_finiteDim E dimH_univ_lp_top
+
 
