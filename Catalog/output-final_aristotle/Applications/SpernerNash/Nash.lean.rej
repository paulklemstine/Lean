-/-
-Every equilibrium of Matching Pennies assigns probability `1/2` to each
-player's `false` strategy.  Thus the explicitly exhibited equilibrium is unique.
--/
-theorem matchingPennies_nash_probabilities (p q : Bool → ℝ)
-    (h : IsNash matchingPennies p q) :
-    p false = 1 / 2 ∧ q false = 1 / 2 := by
-  -- By definition of IsNash, we know that p and q are distributions, so p false + p true = 1 and q false + q true = 1.
-  have h_p_dist : p false + p true = 1 := by
-    convert h.1.2;
-    rw [ Finset.sum_eq_add ] <;> norm_num
-  have h_q_dist : q false + q true = 1 := by
-    have := h.2.1;
-    simpa [ add_comm ] using this.2;
-  -- By definition of IsNash, we know that for any pure strategy a of player 1, E1(pureDist a, q) ≤ E1(p, q).
-  have h_pure_1 : ∀ a : Bool, E1 matchingPennies (pureDist a) q ≤ E1 matchingPennies p q := by
-    exact fun a => h.2.2.1 _ ( pureDist_isDist a );
-  -- By definition of IsNash, we know that for any pure strategy b of player 2, E2(p, pureDist b) ≤ E2(p, q).
-  have h_pure_2 : ∀ b : Bool, E2 matchingPennies p (pureDist b) ≤ E2 matchingPennies p q := by
-    exact fun b => h.2.2.2 _ ( pureDist_isDist b );
-  unfold E1 E2 matchingPennies pureDist at * ; norm_num at *;
-  constructor <;> nlinarith
-
-/-
-**Complete equilibrium classification for Matching Pennies.**  A profile is a
-Nash equilibrium exactly when both players use the uniform distribution.
--/
-theorem matchingPennies_isNash_iff (p q : Bool → ℝ) :
-    IsNash matchingPennies p q ↔ p = unifBool ∧ q = unifBool := by
-  constructor <;> intro h;
-  · have := matchingPennies_nash_probabilities p q h;
-    have := h.1.2; ( have := h.2.1.2; ( unfold unifBool; norm_num at *; exact ⟨ by ext i; fin_cases i <;> linarith !, by ext i; fin_cases i <;> linarith ! ⟩ ; ) );
-  · simpa only [ h ] using matchingPennies_uniform_isNash
-
 /-! ### Prisoner's Dilemma
 
 
