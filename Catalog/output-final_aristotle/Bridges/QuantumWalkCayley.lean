import Mathlib

/-!
# Quantum Random Walks on Cayley Graphs: Spectral Theory of Abelian Cayley Graphs

This file develops the spectral theory underlying (classical and quantum) random walks
on Cayley graphs of **finite abelian groups**.  The key phenomenon powering every
statement about spectral gaps and mixing times is that the *characters* of an abelian
group simultaneously diagonalize every translation-invariant operator — in particular
the adjacency/walk operator of any Cayley graph.

We model the Hilbert space `ℓ²(G)` as functions `G → ℂ`.

## Main definitions

* `QuantumWalkCayley.shift s` — the elementary translation ("coin-free quantum walk step")
  `f ↦ (x ↦ f (x + s))`.  This is the unitary generator associated to a single group
  element `s`.
* `QuantumWalkCayley.adjacency S` — the Cayley-graph adjacency (walk) operator
  `f ↦ (x ↦ ∑_{s ∈ S} f (x + s))` for a generating (multi)set `S`.
* `QuantumWalkCayley.ell2normSq f = ∑_x ‖f x‖²` — the squared `ℓ²` norm.
* `QuantumWalkCayley.charEigenvalue S ψ = ∑_{s ∈ S} ψ s` — the eigenvalue attached to a
  character `ψ`.

## Main results

* `shift_preserves_ell2normSq` — each shift is an isometry of `ℓ²(G)` (unitarity).
* `shift_iterate` / `shift_periodic` — the single-generator quantum walk is **periodic**
  with period dividing the additive order of `s`.
* `adjacency_addChar_eigen` — **every additive character is an eigenvector** of the walk
  operator, with eigenvalue `charEigenvalue S ψ`.  This is the spectral diagonalization
  at the heart of the theory.
* `charEigenvalue_trivial` — the trivial character yields the top ("degree") eigenvalue.
* `charEigenvalue_norm_le` — every eigenvalue has modulus `≤ |S|` (Perron/Frobenius bound).
* `charEigenvalue_real_of_symmetric` — for a **symmetric** generating set the eigenvalues
  are real (so the walk operator is self-adjoint).
* `cycle_second_eigenvalue` — for the cycle `Cay(ℤ/nℤ, {±1})` the standard character has
  eigenvalue `2 cos(2π/n)`, and `cycle_spectral_gap_pos` shows the spectral gap is strictly
  positive.
-/

open scoped BigOperators

namespace QuantumWalkCayley

variable {G : Type*} [AddCommGroup G]

/-- The elementary translation operator on `ℓ²(G)`: `shift s f` sends `x ↦ f (x + s)`.
This is the unitary one-step quantum walk generated by the group element `s`. -/
def shift (s : G) (f : G → ℂ) : G → ℂ := fun x => f (x + s)

/-- The Cayley-graph adjacency / walk operator for a generating set `S`:
`adjacency S f` sends `x ↦ ∑_{s ∈ S} f (x + s)`. -/
noncomputable def adjacency (S : Finset G) (f : G → ℂ) : G → ℂ := fun x => ∑ s ∈ S, f (x + s)

/-- The squared `ℓ²` norm on `ℓ²(G)`. -/
noncomputable def ell2normSq [Fintype G] (f : G → ℂ) : ℝ := ∑ x, ‖f x‖ ^ 2

/-- The eigenvalue attached to a character `ψ` for the walk operator with generators `S`. -/
noncomputable def charEigenvalue (S : Finset G) (ψ : AddChar G ℂ) : ℂ := ∑ s ∈ S, ψ s

/-! ### Algebraic structure of the shift operator -/

/-- Composition of shifts adds the group elements. -/
theorem shift_add (s t : G) (f : G → ℂ) : shift s (shift t f) = shift (s + t) f := by
  funext x; simp [shift, add_assoc]

/-- The shift by `0` is the identity. -/
theorem shift_zero (f : G → ℂ) : shift (0 : G) f = f := by
  funext x; simp [shift]

/-- The shift operator is additive. -/
theorem shift_map_add (s : G) (f g : G → ℂ) :
    shift s (f + g) = shift s f + shift s g := by
  funext x; simp [shift]

/-- The shift operator commutes with scalar multiplication. -/
theorem shift_map_smul (s : G) (c : ℂ) (f : G → ℂ) :
    shift s (c • f) = c • shift s f := by
  funext x; simp [shift]

/-- Shifting by `-s` undoes shifting by `s`; hence `shift s` is a bijection. -/
theorem shift_neg_shift (s : G) (f : G → ℂ) : shift (-s) (shift s f) = f := by
  funext x; simp [shift, add_assoc]

/-- `shift s` is a bijection of `ℓ²(G)`. -/
theorem shift_bijective (s : G) : Function.Bijective (shift s : (G → ℂ) → (G → ℂ)) := by
  constructor
  · intro f g h; funext x
    have := congrFun h (x - s); simpa [shift] using this
  · intro f; exact ⟨shift (-s) f, by funext x; simp [shift, add_assoc]⟩

/-- **Unitarity**: each elementary quantum-walk step preserves the `ℓ²` norm. -/
theorem shift_preserves_ell2normSq [Fintype G] (s : G) (f : G → ℂ) :
    ell2normSq (shift s f) = ell2normSq f := by
  unfold ell2normSq shift
  exact Fintype.sum_equiv (Equiv.addRight s) _ _ (fun x => rfl)

/-! ### Periodicity of the single-generator quantum walk -/

/-- Iterating the shift `k` times shifts by `k • s`. -/
theorem shift_iterate (s : G) (k : ℕ) (f : G → ℂ) :
    (shift s)^[k] f = shift (k • s) f := by
  induction k generalizing f with
  | zero => funext x; simp [shift]
  | succ n ih =>
    rw [Function.iterate_succ_apply, ih]
    funext x; simp only [shift]; rw [succ_nsmul, ← add_assoc]

/-- **Periodicity**: the single-generator quantum walk `shift s` returns to the identity
after `addOrderOf s` steps.  (`U^k = I` in the language of the mission.) -/
theorem shift_periodic (s : G) : (shift s)^[addOrderOf s] = id := by
  funext f; rw [shift_iterate, addOrderOf_nsmul_eq_zero]; funext x; simp [shift]

/-! ### Translation invariance of the walk operator -/

/-- The Cayley walk operator commutes with translations — the algebraic expression of the
vertex-transitivity of a Cayley graph. -/
theorem adjacency_shift_comm (S : Finset G) (t : G) (f : G → ℂ) :
    adjacency S (shift t f) = shift t (adjacency S f) := by
  funext x; simp only [adjacency, shift]
  apply Finset.sum_congr rfl; intro s _; rw [add_right_comm]

/-! ### Spectral diagonalization by characters -/

/-- **Main spectral theorem.** Every additive character `ψ` is an eigenvector of the Cayley
walk operator, with eigenvalue `charEigenvalue S ψ = ∑_{s ∈ S} ψ s`. -/
theorem adjacency_addChar_eigen (S : Finset G) (ψ : AddChar G ℂ) :
    adjacency S (fun x => ψ x) = fun x => charEigenvalue S ψ * ψ x := by
  funext x; simp only [adjacency, charEigenvalue]
  rw [Finset.sum_mul]
  apply Finset.sum_congr rfl; intro s _
  rw [AddChar.map_add_eq_mul, mul_comm]

/-- The trivial character gives the "degree" (top) eigenvalue `|S|`. -/
theorem charEigenvalue_trivial (S : Finset G) :
    charEigenvalue S (1 : AddChar G ℂ) = (S.card : ℂ) := by
  simp [charEigenvalue]

/-- **Perron/Frobenius bound.** Every eigenvalue has modulus at most the degree `|S|`. -/
theorem charEigenvalue_norm_le [Fintype G] (S : Finset G) (ψ : AddChar G ℂ) :
    ‖charEigenvalue S ψ‖ ≤ (S.card : ℝ) := by
  unfold charEigenvalue
  calc ‖∑ s ∈ S, ψ s‖ ≤ ∑ s ∈ S, ‖ψ s‖ := norm_sum_le _ _
    _ = ∑ s ∈ S, (1 : ℝ) := by
        apply Finset.sum_congr rfl; intro s _; exact AddChar.norm_apply ψ s
    _ = (S.card : ℝ) := by simp

/-- For a character on a finite group, `conj (ψ a) = ψ (-a)`. -/
theorem conj_char [Fintype G] (ψ : AddChar G ℂ) (a : G) :
    (starRingEnd ℂ) (ψ a) = ψ (-a) := by
  rw [AddChar.map_neg_eq_inv, ← Complex.inv_eq_conj (AddChar.norm_apply ψ a)]

/-- **Self-adjointness.** For a symmetric generating set (`S = -S`) the eigenvalues are real,
so the walk operator is self-adjoint (Hermitian). -/
theorem charEigenvalue_real_of_symmetric [Fintype G] [DecidableEq G]
    (S : Finset G) (ψ : AddChar G ℂ) (hS : S.image (fun x => -x) = S) :
    (starRingEnd ℂ) (charEigenvalue S ψ) = charEigenvalue S ψ := by
  unfold charEigenvalue
  rw [map_sum, Finset.sum_congr rfl (fun s _ => conj_char ψ s)]
  have key : ∑ x ∈ S.image (fun x => -x), ψ x = ∑ x ∈ S, ψ (-x) :=
    Finset.sum_image (by intro a _ b _ h; simpa using h)
  rw [hS] at key
  exact key.symm

/-! ### The cycle graph `Cay(ℤ/nℤ, {±1})` -/

/-- The standard symmetric generating set `{1, -1}` of `ℤ/nℤ`. -/
def cycleGen (n : ℕ) : Finset (ZMod n) := {1, -1}

/-- The generating set of the cycle is symmetric. -/
theorem cycleGen_symmetric (n : ℕ) :
    (cycleGen n).image (fun x => -x) = cycleGen n := by
  unfold cycleGen
  rw [Finset.image_insert, Finset.image_singleton, neg_neg, Finset.pair_comm]

/-- For `n ≥ 3`, the standard character's eigenvalue on the cycle is `2 cos(2π/n)` — the
classical "second eigenvalue" of the cycle graph. -/
theorem cycle_second_eigenvalue (n : ℕ) [NeZero n] (hn : 3 ≤ n) :
    charEigenvalue (cycleGen n) (ZMod.stdAddChar) =
      (2 * Real.cos (2 * Real.pi / n) : ℂ) := by
  have h1 : (1 : ZMod n) ≠ -1 := by
    intro h
    have h2 : (2 : ZMod n) = 0 := by linear_combination h
    have h3 : ((2 : ℕ) : ZMod n) = 0 := by push_cast; exact h2
    rw [ZMod.natCast_eq_zero_iff] at h3
    have := Nat.le_of_dvd (by norm_num) h3; omega
  haveI : Fact (1 < n) := ⟨by omega⟩
  have hval : (1 : ZMod n).val = 1 := ZMod.val_one n
  have hz : ZMod.stdAddChar (1 : ZMod n) =
      Complex.exp (((2 * Real.pi / n) : ℝ) * Complex.I) := by
    rw [ZMod.stdAddChar_apply, ZMod.toCircle_apply, hval]; push_cast; ring_nf
  unfold charEigenvalue cycleGen
  rw [Finset.sum_pair h1, AddChar.map_neg_eq_inv]
  have hnorm : ‖ZMod.stdAddChar (1 : ZMod n)‖ = 1 := AddChar.norm_apply _ _
  rw [Complex.inv_eq_conj hnorm, Complex.add_conj, hz, Complex.exp_ofReal_mul_I_re]
  push_cast; ring

/-- **Positive spectral gap.** For `n ≥ 3` the cycle's spectral gap
`2 - 2 cos(2π/n)` is strictly positive, so the walk mixes. -/
theorem cycle_spectral_gap_pos (n : ℕ) (hn : 3 ≤ n) :
    0 < 2 - 2 * Real.cos (2 * Real.pi / n) := by
  have hn2 : (2 : ℝ) ≤ n := by exact_mod_cast (by omega : 2 ≤ n)
  have hpi := Real.pi_pos
  have hpos : 0 < 2 * Real.pi / n := by positivity
  have hle : 2 * Real.pi / n ≤ Real.pi := by
    rw [div_le_iff₀ (by positivity)]; nlinarith
  have h1 : Real.cos (2 * Real.pi / n) < Real.cos 0 :=
    Real.cos_lt_cos_of_nonneg_of_le_pi (le_refl 0) hle hpos
  rw [Real.cos_zero] at h1
  linarith

end QuantumWalkCayley