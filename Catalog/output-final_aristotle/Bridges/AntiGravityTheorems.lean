import Mathlib

open Set Relation

namespace AntiGravity

/-- A finite formal library, recording direct theorem dependencies and proof lengths. -/
structure Library (α : Type*) where
  dependsOn : α → α → Prop
  proofLength : α → ℕ

variable {α : Type*} (L : Library α)

/-- `supports x y` means that `y` is reachable from `x` by following theorem users. -/
def Supports (x y : α) : Prop :=
  ReflTransGen (fun foundation user => L.dependsOn user foundation) x y

/-- The gravitational weight of a theorem is the number of direct theorem users. -/
def weight [Fintype α] [DecidableRel L.dependsOn] (x : α) : ℕ :=
  (Finset.univ.filter fun user => L.dependsOn user x).card

/-- A theorem is anti-gravity at thresholds `(minimum weight, maximum proof length)`. -/
def IsAntiGravity [Fintype α] [DecidableRel L.dependsOn]
    (minimumWeight maximumLength : ℕ) (x : α) : Prop :=
  weight L x ≥ minimumWeight ∧ L.proofLength x ≤ maximumLength

/-- Dependency-open sets contain every theorem supported by each of their members. -/
def DependencyOpen (U : Set α) : Prop :=
  ∀ ⦃x⦄, x ∈ U → ∀ ⦃y⦄, Supports L x y → y ∈ U

/-- The Alexandrov topology generated by theorem support. -/
def dependencyTopology : TopologicalSpace α where
  IsOpen := DependencyOpen L
  isOpen_univ := by
    intro x hx y hxy
    exact Set.mem_univ y
  isOpen_inter := by
    intro U V hU hV x hx y hxy
    exact ⟨hU hx.1 hxy, hV hx.2 hxy⟩
  isOpen_sUnion := by
    intro family hfamily x hx y hxy
    rcases hx with ⟨U, hUfamily, hxU⟩
    exact ⟨U, hUfamily, hfamily U hUfamily hxU hxy⟩

/-- The dependency cone above a theorem consists of all theorems it supports. -/
def cone (x : α) : Set α := {y | Supports L x y}

/-- Dependency cones are open in the dependency topology. -/
theorem cone_isOpen (x : α) :
    @IsOpen α (dependencyTopology L) (cone L x) := by
  intro y hy z hyz
  exact hy.trans hyz

/-- Every theorem belongs to its own dependency cone. -/
theorem mem_cone (x : α) : x ∈ cone L x :=
  ReflTransGen.refl

/-- **Dependency-density criterion.** A class of theorems is dense precisely when every theorem
supports a member of the class. Thus topological density has an exact library-theoretic meaning,
not an appeal to an unspecified ambient space. -/
theorem dense_iff_supports_member (S : Set α) :
    @Dense α (dependencyTopology L) S ↔
      ∀ x, ∃ y, Supports L x y ∧ y ∈ S := by
  constructor <;> intro h
  · intro x
    specialize h x
    simp_all +decide [mem_closure_iff]
    exact h _ (cone_isOpen L x) (mem_cone L x)
  · intro x
    simp +decide [mem_closure_iff]
    exact fun U hU hx => by
      rcases h x with ⟨y, hy, hyS⟩
      exact ⟨y, hU hx hy, hyS⟩

/-- Anti-gravity theorems are dense whenever every theorem supports a sufficiently heavy theorem
with a sufficiently short proof. -/
theorem antiGravity_dense [Fintype α] [DecidableRel L.dependsOn]
    (minimumWeight maximumLength : ℕ)
    (hcofinal : ∀ x, ∃ y, Supports L x y ∧
      IsAntiGravity L minimumWeight maximumLength y) :
    @Dense α (dependencyTopology L)
      {x | IsAntiGravity L minimumWeight maximumLength x} := by
  rw [dense_iff_supports_member]
  exact hcofinal

/-- A ten-percent lower bound follows from an explicit ten-to-one charging map: every theorem is
assigned an anti-gravity theorem, and no anti-gravity theorem receives more than ten charges. -/
theorem ten_percent_of_bounded_charging [Fintype α] [DecidableEq α]
    [DecidableRel L.dependsOn]
    (minimumWeight maximumLength : ℕ)
    [DecidablePred (IsAntiGravity L minimumWeight maximumLength)] (charge : α → α)
    (hanti : ∀ x, IsAntiGravity L minimumWeight maximumLength (charge x))
    (hfiber : ∀ a, (Finset.univ.filter fun x => charge x = a).card ≤ 10) :
    Fintype.card α ≤ 10 *
      (Finset.univ.filter fun x => IsAntiGravity L minimumWeight maximumLength x).card := by
  convert Finset.card_le_mul_card_image_of_maps_to _ _ _ using 1
  all_goals try assumption
  · grind
  · aesop

/-- The unconditional ten-percent prediction is false: in a ten-theorem edgeless library, no
theorem has even one direct user, regardless of proof-length threshold. -/
theorem edgeless_ten_counterexample :
    let E : Library (Fin 10) :=
      { dependsOn := fun _ _ => False, proofLength := fun _ => 1 }
    ∀ x, weight E x = 0 ∧ ¬ IsAntiGravity E 1 1 x := by
  unfold weight IsAntiGravity
  aesop

end AntiGravity