++-++--+-    ‖pullbackAlg φ f‖ ≤ ‖f‖ :=
++-++--+-  (ContinuousMap.norm_le _ (by positivity)).2 fun x => by
++-++--+-    simpa using ContinuousMap.norm_coe_le_norm f (φ x)
