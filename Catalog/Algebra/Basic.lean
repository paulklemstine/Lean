---+-+-+--+-/-- The pullback map is norm-nonincreasing. -/
---+-+-+--+-theorem norm_pullback_le (φ : C(X, Y)) (f : C(Y, ℝ)) :
---+-+-+--+-    ‖pullbackAlg φ f‖ ≤ ‖f‖ :=
