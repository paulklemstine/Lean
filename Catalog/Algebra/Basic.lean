++----+--++Wick rotation t → it. -/
++----+--++theorem wick_duality (x y : ℝ) :
++----+--++    spb x (-y) = (x - y) / (1 + x * y) := by
++----+--++  simp only [spb]
++----+--++  have heq : (1 : ℝ) - x * (-y) = 1 + x * y := by ring
