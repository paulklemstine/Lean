---+---+/-- Oracle magnetization as a real number. -/
---+---+def oracleMagnetization' (O : FinOracle' n) : ℝ :=
---+---+  ∑ i : Fin n, if O i then (1 : ℝ) else (-1 : ℝ)
-+-+---+/-- For functions supported in `BoxDom(B)`, values outside dominant cone vanish. -/
