++--++--+-/-- Every fiber-constant function is a pullback. Uses Tietze extension. -/
++--++--+-theorem fiberConst_subset_range_pullback (φ : C(X, Y)) :
++--++--+-    (FiberConst φ : Set C(X, ℝ)) ⊆ Set.range (pullbackAlg φ) := by
