++-----+--+-variable [TopologicalSpace Y] [CompactSpace Y] [T2Space Y]
++-----+--++/-- The inverse for hyperbolic SPB is also negation. -/
++-----+--++theorem spbH_neg_right (x : ℝ) : spbH x (-x) = 0 := by
++-----+--++  simp [spbH]
