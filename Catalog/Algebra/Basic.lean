+---++    [DecidableRel G.Adj]
+---++    (hconn : G.Connected) {u v : V} (hb : G.IsBridge s(u, v)) :
+---++    Fintype.card (G.deleteEdges {s(u, v)}).ConnectedComponent = 2 := by
+---++  convert Set.ncard_eq_two.mpr _;
