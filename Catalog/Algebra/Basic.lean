-- --+--+-  fibers of `φ`.
-- --+--+-* `pullbackAlg φ` — the pullback `ℝ`-algebra homomorphism `C(Y, ℝ) →ₐ[ℝ] C(X, ℝ)`.
--@@ -7145,29 +675,7 @@
-- --+--++Domain: EML
-- --+--++Declarations: 15
