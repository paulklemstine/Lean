---+--++-----    FiberConst φ = ⊤ ↔ Function.Injective φ := by
---+--++-----  refine ⟨fun h => ?_, fiberConst_eq_top_of_injective φ⟩
---+--++-----  intro x x' hφ; by_contra h_ne
