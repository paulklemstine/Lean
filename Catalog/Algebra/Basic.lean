---+--++--+-/-- `FiberConst φ = ⊤ ↔ Injective φ`. Uses Urysohn separation for ←. -/
---+--++--+-theorem fiberConst_eq_top_iff_injective (φ : C(X, Y)) :
---+--++--+-    FiberConst φ = ⊤ ↔ Function.Injective φ := by
