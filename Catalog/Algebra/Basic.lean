-+-+-----theorem closure_range_pullback_eq_top_of_injective
-+-+-----    (φ : C(X, Y))
-+-+-----    (hφ : Function.Injective φ)
-+-+-----    (A : Subalgebra ℝ C(Y, ℝ))
