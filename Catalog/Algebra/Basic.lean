++----+---+/-- The edge moment at a shifted point exactly recovers the function value.
++----+---+    This is the fundamental reconstruction identity. -/
++----+---+@[simp]
++----+---+lemma edgeMoment_succ (f : ℕ → ℕ → ℕ → ℤ) (a b c : ℕ) :
++----+---+    edgeMoment f (a + 1) (b + 1) (c + 1) = f a b c := by
