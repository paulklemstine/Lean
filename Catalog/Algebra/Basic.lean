++-++----+/-- Binary tree identity: leaves = internal nodes + 1. -/
++-++----+theorem SPBExpr.leaf_eq_node_succ (e : SPBExpr) :
++-++----+    e.leafCount = e.nodeCount + 1 := by
++-++----+  induction e with
++-++----+  | zero => rfl
++-++----+  | one => rfl
++-++----+  | var _ => rfl
++-++----+  | node l r ihl ihr =>
++-++----+    simp [SPBExpr.leafCount, SPBExpr.nodeCount, ihl, ihr]
