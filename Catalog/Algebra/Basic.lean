-+--+++def SPBExpr.nodeCount : SPBExpr → ℕ
-+--+++  | .zero => 0
-+--+++  | .one => 0
-+--+++  | .var _ => 0
-+--+++  | .node l r => 1 + l.nodeCount + r.nodeCount
