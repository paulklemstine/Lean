---+-+-++-  add_mem' := by intro f g hf hg x x' h; simp [hf h, hg h]
---+-+-++-  zero_mem' := by intro x x' _; simp
---+-+-++-  mul_mem' := by intro f g hf hg x x' h; simp [hf h, hg h]
---+-+-++-  one_mem' := by intro x x' _; simp
