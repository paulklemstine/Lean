+---++theorem IsBridge.forall_reachable_delete_left_or_right
+---++    (hconn : G.Connected) {u v : V} (hb : G.IsBridge s(u, v)) (w : V) :
+---++    (G.deleteEdges {s(u, v)}).Reachable u w ∨
