-+-+------/
-+-+-----theorem closure_range_pullback_eq_fiberConst
-+-+-----    (φ : C(X, Y))
-+-+-----    (A : Subalgebra ℝ C(Y, ℝ))
-+-+-----    (hA : Dense (A : Set C(Y, ℝ))) :
-+-+-----    closure (((pullbackAlg φ) '' (A : Set C(Y, ℝ))) : Set C(X, ℝ))
