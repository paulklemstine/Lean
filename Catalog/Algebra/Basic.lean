---+-+++-    ‖pullbackAlg φ f‖ = ‖f‖ := by
---+-+++-  refine le_antisymm (norm_pullback_le φ f) ?_
---+-+++-  rw [ContinuousMap.norm_le _ (by positivity)]
---+-+++-  intro y; obtain ⟨x, rfl⟩ := hφ y
---+-+++-  exact ContinuousMap.norm_coe_le_norm (pullbackAlg φ f) x
