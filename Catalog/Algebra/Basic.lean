-+-++-theorem range_comp_subalgebra_subset_fiberConst
-+-++-    (φ : C(X, Y)) (A : Subalgebra ℝ C(Y, ℝ)) :
-+-++-    ((pullbackAlg φ) '' (A : Set C(Y, ℝ))) ⊆ (FiberConst φ : Set C(X, ℝ)) := by
-+-++-  rintro _ ⟨f, _, rfl⟩; exact pullback_mem_fiberConst φ f
