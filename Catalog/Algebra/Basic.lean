++----+--+-theorem pullback_mem_fiberConst (φ : C(X, Y)) (f : C(Y, ℝ)) :
++----+--+-    pullbackAlg φ f ∈ FiberConst φ := by
++----+--+-  intro x x' h; simp [h]
++----+--++/-- Depth of an SPB expression. -/
++----+--++def SPBExpr.depth : SPBExpr → ℕ
++----+--++  | .zero => 0
++----+--++  | .one => 0
++----+--++  | .var _ => 0
++----+--++  | .node l r => 1 + max l.depth r.depth
