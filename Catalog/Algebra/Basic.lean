---+-----+-+-    refine' ⟨ _, ⟨ a, ha, rfl ⟩, _ ⟩;
---+-----+-+-    nontriviality;
---+-----+-+-    rw [ hF, dist_eq_norm ] at *;
---+-----+-+-    convert lt_of_le_of_lt ( norm_pullback_le φ ( F - a ) ) ha' using 1
