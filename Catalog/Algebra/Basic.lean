++----+--+-theorem range_pullback_subset_fiberConst (φ : C(X, Y)) :
++----+--+-    Set.range (pullbackAlg φ) ⊆ (FiberConst φ : Set C(X, ℝ)) := by
++----+--+-  rintro _ ⟨f, rfl⟩; exact pullback_mem_fiberConst φ f
