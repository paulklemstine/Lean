+---++  · refine' ⟨ _, _, _, _ ⟩;
+---++    exact ( G.deleteEdges { s(u, v) } ).connectedComponentMk u;
+---++    exact ( G.deleteEdges { s(u, v) } ).connectedComponentMk v;
