++-----+-+-theorem fiberConstLift_comp (φ : C(X, Y)) (g : C(X, ℝ))
++-----+-+-    (hg : g ∈ FiberConst φ) (x : X) :
++-----+-+-    fiberConstLift φ g hg ⟨φ x, x, rfl⟩ = g x := by
++-----+-+-  simp only [fiberConstLift]
++-----+-+-  apply hg
++-----+-+-  exact (⟨φ x, x, rfl⟩ : Set.range φ).property.choose_spec
