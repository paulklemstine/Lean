++-++-----/-- `FiberConst φ` is closed in the uniform topology. -/
++-++-----theorem fiberConst_closed (φ : C(X, Y)) :
++-++-----    IsClosed (FiberConst φ : Set C(X, ℝ)) := by
++-++-----  refine isClosed_of_closure_subset ?_
