+-+-----  commutes' := by intros; ext; simp
+-+----+/-- SPB expression trees — analogous to EML expression trees. -/
+-+----+inductive SPBExpr where
+-+----+  | zero : SPBExpr
+-+----+  | one : SPBExpr
+-+----+  | var : ℕ → SPBExpr
+-+----+  | node : SPBExpr → SPBExpr → SPBExpr
+-+----+  deriving Repr, BEq
