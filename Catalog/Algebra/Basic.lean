---+-----+-+-      exact Exists.elim ( fiberConst_subset_range_pullback φ hg ) fun F hF => ⟨ F, hF.symm ⟩;
---+-----+-+-    rw [ Metric.mem_closure_iff ];
---+-----+-+-    intro ε εpos;
