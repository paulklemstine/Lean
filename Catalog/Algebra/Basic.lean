++-----+-+-/-- Pullback of continuous real-valued functions along `φ`. -/
++-----+-+-def pullbackAlg (φ : C(X, Y)) : C(Y, ℝ) →ₐ[ℝ] C(X, ℝ) where
++-----+-+-  toFun f := f.comp φ
++-----+-+-  map_zero' := by ext; simp
++-----+-+-  map_one' := by ext; simp
++-----+-+-  map_add' := by intros; ext; simp
++-----+-+-  map_mul' := by intros; ext; simp
++-----+-+-  commutes' := by intros; ext; simp
