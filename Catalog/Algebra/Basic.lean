++-++-----@[simp]
++-++-----theorem pullbackAlg_apply (φ : C(X, Y)) (f : C(Y, ℝ)) (x : X) :
++-++-----    pullbackAlg φ f x = f (φ x) := rfl
++-++----+/-- Evaluate an SPB expression. -/
++-++----+def SPBExpr.eval (e : SPBExpr) (vars : ℕ → ℝ) : ℝ :=
++-++----+  match e with
++-++----+  | .zero => 0
++-++----+  | .one => 1
++-++----+  | .var n => vars n
++-++----+  | .node l r => spb (l.eval vars) (r.eval vars)
