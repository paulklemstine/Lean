---+-----+-++    spb x (-y) = (x - y) / (1 + x * y) := by
---+-----+-++  simp only [spb]
---+-----+-++  have heq : (1 : ℝ) - x * (-y) = 1 + x * y := by ring
---+-----+-++  rw [heq]; ring
