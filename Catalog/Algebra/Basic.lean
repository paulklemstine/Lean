++-----+-++    Real.tan (α + β) = spb (Real.tan α) (Real.tan β) := by
++-----+-++  rw [spb, Real.tan_eq_sin_div_cos, Real.sin_add, Real.cos_add,
++-----+-++      Real.tan_eq_sin_div_cos, Real.tan_eq_sin_div_cos]
