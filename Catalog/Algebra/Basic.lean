---+-+++-    rw [ Metric.mem_closure_iff ];
---+-+++-    intro ε εpos;
---+-+++-    rcases hA.exists_dist_lt F εpos with ⟨ a, ha, ha' ⟩;
---+-+++-    refine' ⟨ _, ⟨ a, ha, rfl ⟩, _ ⟩;
