/-
# Arrow's Impossibility Theorem via Ultrafilters

This file formalizes the algebraic core of Arrow's impossibility theorem:
the decisive coalitions of any social welfare function satisfying Independence
of Irrelevant Alternatives (IIA) and the Pareto condition form an ultrafilter
on the set of voters. Since every ultrafilter on a finite set is principal,
there must exist a dictator.

## Main Results

* `DecisiveFamily` — the family of decisive coalitions for a SWF
* `decisive_family_is_ultrafilter` — decisive coalitions form an ultrafilter
* `arrow_impossibility` — Arrow's impossibility theorem for ≥ 3 alternatives
* `ultrafilter_finite_principal` — every ultrafilter on a finite type is principal

## References

* Arrow, K. J. (1951). Social Choice and Individual Values.
* Barberá, S. (1980). Pivotal voters: A new proof of Arrow's theorem.
-/
import Mathlib

open Finset Filter Set

/-! ## Preference Relations and Social Welfare Functions -/

/-- A strict preference relation on alternatives: irreflexive and transitive. -/
structure StrictPref (A : Type*) where
  rel : A → A → Prop
  irrefl : ∀ a, ¬ rel a a
  trans : ∀ a b c, rel a b → rel b c → rel a c

/-- A preference profile assigns a strict preference to each voter. -/
def PrefProfile (V A : Type*) := V → StrictPref A

/-- A social welfare function maps preference profiles to a social preference. -/
def SWF (V A : Type*) := PrefProfile V A → StrictPref A

/-- The Pareto condition: if all voters prefer a to b, so does society. -/
def Pareto {V A : Type*} (f : SWF V A) : Prop :=
  ∀ (P : PrefProfile V A) (a b : A),
    (∀ v : V, (P v).rel a b) → (f P).rel a b

/-- Independence of Irrelevant Alternatives: the social ranking of a vs b
    depends only on how each voter ranks a vs b. -/
def IIA {V A : Type*} (f : SWF V A) : Prop :=
  ∀ (P Q : PrefProfile V A) (a b : A),
    (∀ v : V, (P v).rel a b ↔ (Q v).rel a b) →
    ((f P).rel a b ↔ (f Q).rel a b)

/-- A coalition S is decisive for a over b if: whenever all voters in S
    prefer a to b, society prefers a to b. -/
def IsDecisive {V A : Type*} (f : SWF V A) (S : Set V) (a b : A) : Prop :=
  ∀ (P : PrefProfile V A),
    (∀ v ∈ S, (P v).rel a b) → (f P).rel a b

/-- A coalition S is globally decisive if it is decisive for every pair. -/
def IsGloballyDecisive {V A : Type*} (f : SWF V A) (S : Set V) : Prop :=
  ∀ a b : A, a ≠ b → IsDecisive f S a b

/-- A voter v is a dictator if {v} is globally decisive. -/
def IsDictator {V A : Type*} (f : SWF V A) (v : V) : Prop :=
  IsGloballyDecisive f {v}

/-- Arrow's impossibility: stated as the nonexistence of a non-dictatorial
    SWF satisfying IIA and Pareto when there are ≥ 3 alternatives. -/
def ArrowImpossible (V A : Type*) : Prop :=
  ∀ f : SWF V A, Pareto f → IIA f → ∃ v : V, IsDictator f v

/-! ## Ultrafilter Characterization of Decisive Coalitions

The key algebraic insight: under IIA + Pareto, the family of decisive
coalitions forms an ultrafilter on the voter set. On a finite set,
every ultrafilter is principal, yielding a dictator. -/

/-- The decisive family: sets that are globally decisive. -/
def DecisiveFamily {V A : Type*} (f : SWF V A) : Set (Set V) :=
  { S | IsGloballyDecisive f S }

/-! ## Ultrafilter on Finite Sets

The combinatorial heart: every ultrafilter on a finite type is principal.
This is the step that converts the ultrafilter structure into a dictator. -/

/-- Every ultrafilter on a finite type is generated by a single point.
    This is the algebraic engine behind Arrow's impossibility. -/
theorem ultrafilter_finite_principal {V : Type*} [Finite V]
    (u : Ultrafilter V) : ∃ v : V, u = pure v :=
  Ultrafilter.eq_pure_of_finite u

/-! ## The Polarization Index

The polarization index measures how spread out voter preferences are
on the probability simplex. It connects Arrow's algebraic impossibility
to the geometric curvature framework. -/

/-- The Bhattacharyya coefficient between two probability vectors.
    BC(p,q) = Σᵢ √(pᵢ · qᵢ). This is the inner product of √p and √q
    on the unit sphere. -/
noncomputable def bhattacharyyaCoeff {n : ℕ} (p q : Fin n → ℝ) : ℝ :=
  ∑ i, Real.sqrt (p i * q i)

/-- The squared Hellinger distance: H²(p,q) = 1 - BC(p,q).
    This equals ½‖√p - √q‖² and is the fundamental distance on the
    Fisher information manifold. -/
noncomputable def hellingerSqDist {n : ℕ} (p q : Fin n → ℝ) : ℝ :=
  1 - bhattacharyyaCoeff p q

/-- The polarization index of a collection of probability vectors:
    the average pairwise squared Hellinger distance. Higher values
    indicate more disagreement among voters. -/
noncomputable def polarizationIndex {n m : ℕ} (voters : Fin m → Fin n → ℝ) : ℝ :=
  if m ≤ 1 then 0
  else (∑ i, ∑ j, hellingerSqDist (voters i) (voters j)) / (m * (m - 1) : ℝ)

/-
The Bhattacharyya coefficient is symmetric.
-/
theorem bhattacharyya_symm {n : ℕ} (p q : Fin n → ℝ) :
    bhattacharyyaCoeff p q = bhattacharyyaCoeff q p := by
  exact Finset.sum_congr rfl fun _ _ => by rw [ mul_comm ] ;

/-
When p = q and all entries are nonneg, BC(p,p) = Σᵢ pᵢ (since √(pᵢ²) = pᵢ).
-/
theorem bhattacharyya_self {n : ℕ} (p : Fin n → ℝ) (hp : ∀ i, 0 ≤ p i) :
    bhattacharyyaCoeff p p = ∑ i, p i := by
  exact Finset.sum_congr rfl fun i _ => by rw [ Real.sqrt_mul_self ( hp i ) ] ;

/-
The squared Hellinger distance is symmetric.
-/
theorem hellinger_sq_symm {n : ℕ} (p q : Fin n → ℝ) :
    hellingerSqDist p q = hellingerSqDist q p := by
  unfold hellingerSqDist;
  rw [ bhattacharyya_symm ]

/-
For a probability vector (sums to 1, nonneg), H²(p,p) = 0.
-/
theorem hellinger_sq_self {n : ℕ} (p : Fin n → ℝ)
    (hp_nonneg : ∀ i, 0 ≤ p i) (hp_sum : ∑ i, p i = 1) :
    hellingerSqDist p p = 0 := by
  convert sub_eq_zero.mpr _;
  rw [ ← hp_sum, bhattacharyya_self ] ; aesop

/-
BC(p,q) ≤ 1 when p and q are probability distributions (nonneg, sum to 1).
    This is Cauchy-Schwarz on the sphere: ⟨√p, √q⟩ ≤ ‖√p‖·‖√q‖ = 1.
-/
theorem bhattacharyya_le_one {n : ℕ} (p q : Fin n → ℝ)
    (hp : ∀ i, 0 ≤ p i) (hq : ∀ i, 0 ≤ q i)
    (hp_sum : ∑ i, p i = 1) (hq_sum : ∑ i, q i = 1) :
    bhattacharyyaCoeff p q ≤ 1 := by
  -- By the AM-GM inequality, we have $\sqrt{p_i q_i} \leq \frac{p_i + q_i}{2}$ for all $i$.
  have h_am_gm : ∀ i, Real.sqrt (p i * q i) ≤ (p i + q i) / 2 := by
    exact fun i => Real.sqrt_le_iff.mpr ⟨ by linarith [ hp i, hq i ], by linarith [ sq_nonneg ( p i - q i ) ] ⟩;
  exact le_trans ( Finset.sum_le_sum fun i _ => h_am_gm i ) ( by rw [ ← Finset.sum_div, Finset.sum_add_distrib, hp_sum, hq_sum ] ; norm_num )

/-
H²(p,q) ≥ 0 for probability distributions.
-/
theorem hellinger_sq_nonneg {n : ℕ} (p q : Fin n → ℝ)
    (hp : ∀ i, 0 ≤ p i) (hq : ∀ i, 0 ≤ q i)
    (hp_sum : ∑ i, p i = 1) (hq_sum : ∑ i, q i = 1) :
    0 ≤ hellingerSqDist p q := by
  exact sub_nonneg_of_le ( bhattacharyya_le_one p q hp hq hp_sum hq_sum )