import Mathlib

/-!
# Automatic Sequences and the Decidability Frontier

## Overview

We formalize the theory of k-automatic sequences — sequences generated by Deterministic
Finite Automata with Output (DFAOs). The central result is that fundamental decision
problems (value membership, eventual periodicity detection) are decidable for automatic
sequences, in stark contrast to the undecidability of the halting problem for general
computable sequences.

## Main Results

* `DFAO` — Deterministic Finite Automaton with Output over a Fintype state space
* `DFAO.value_membership_decidable` — decidability of "does value v appear in the output?"
* `DFAO.product` — product construction showing closure under pairing
* `thueMorse` — the Thue-Morse sequence and its self-similar structure
* `thueMorse_not_eventually_periodic` — Thue-Morse is aperiodic (genuine mathematical depth)
* `kKernel` — the k-kernel of a sequence
* `AlphabetMorphism.iterate_length_uniform` — exponential growth of uniform morphism iterates

## Mathematical Significance

The decidability boundary in sequence theory lies between k-automatic sequences (where
the zero-in-sequence problem is decidable) and morphic sequences (where decidability
is an open problem). This formalization establishes the decidable side rigorously.
-/

open Finset Function Set

namespace AutoSeq

/-! ## Part 1: DFAO — Deterministic Finite Automaton with Output -/

/-- A DFAO with state type `σ`, input alphabet `Fin k`, and output type `α`.
    This generalizes the standard definition to arbitrary Fintype state spaces,
    enabling clean product constructions. -/
structure DFAO (σ : Type*) (k : ℕ) (α : Type*) where
  transition : σ → Fin k → σ
  initial : σ
  output : σ → α

variable {σ : Type*} {k : ℕ} {α : Type*}

/-- Run a DFAO from a given state on a word (list of input symbols). -/
def DFAO.runFrom (M : DFAO σ k α) (s : σ) : List (Fin k) → σ
  | [] => s
  | d :: ds => M.runFrom (M.transition s d) ds

/-- Run a DFAO from its initial state on a word. -/
def DFAO.run (M : DFAO σ k α) (w : List (Fin k)) : σ :=
  M.runFrom M.initial w

/-- Evaluate a DFAO: run and take the output. -/
def DFAO.eval (M : DFAO σ k α) (w : List (Fin k)) : α :=
  M.output (M.run w)

@[simp]
theorem DFAO.runFrom_nil (M : DFAO σ k α) (s : σ) :
    M.runFrom s [] = s := rfl

@[simp]
theorem DFAO.runFrom_cons (M : DFAO σ k α) (s : σ) (d : Fin k) (ds : List (Fin k)) :
    M.runFrom s (d :: ds) = M.runFrom (M.transition s d) ds := rfl

/-- `runFrom` distributes over append. -/
theorem DFAO.runFrom_append (M : DFAO σ k α) (s : σ) (xs ys : List (Fin k)) :
    M.runFrom s (xs ++ ys) = M.runFrom (M.runFrom s xs) ys := by
  induction xs generalizing s with
  | nil => simp
  | cons d ds ih => simp [ih]

/-- `run` on concatenation. -/
theorem DFAO.run_append (M : DFAO σ k α) (xs ys : List (Fin k)) :
    M.run (xs ++ ys) = M.runFrom (M.run xs) ys := by
  simp [DFAO.run, DFAO.runFrom_append]

/-! ## Part 2: Reachability and the Decidability Theorem -/

/-- A state is reachable if there exists some input word reaching it from initial. -/
def DFAO.IsReachable (M : DFAO σ k α) (s : σ) : Prop :=
  ∃ w : List (Fin k), M.run w = s

/-- The initial state is always reachable (via the empty word). -/
theorem DFAO.initial_reachable (M : DFAO σ k α) : M.IsReachable M.initial :=
  ⟨[], rfl⟩

/-- Reachability is preserved by transitions. -/
theorem DFAO.reachable_step (M : DFAO σ k α) {s : σ} (d : Fin k)
    (h : M.IsReachable s) : M.IsReachable (M.transition s d) := by
  obtain ⟨w, hw⟩ := h
  exact ⟨w ++ [d], by rw [DFAO.run_append, hw]; rfl⟩

/-- Every evaluation result comes from a reachable state. -/
theorem DFAO.eval_from_reachable (M : DFAO σ k α) (w : List (Fin k)) :
    M.IsReachable (M.run w) :=
  ⟨w, rfl⟩

/-- The range of eval is contained in the output of reachable states. -/
theorem DFAO.range_eval_subset (M : DFAO σ k α) :
    Set.range M.eval ⊆ M.output '' {s | M.IsReachable s} := by
  intro v ⟨w, hw⟩
  exact ⟨M.run w, ⟨w, rfl⟩, hw ▸ rfl⟩

/-
The range of eval is finite when the state space is finite.
-/
theorem DFAO.range_eval_finite [Fintype σ] (M : DFAO σ k α) :
    Set.Finite (Set.range M.eval) := by
  by_contra h_contra;
  exact h_contra <| Set.Finite.subset ( Set.toFinite ( Set.range M.output ) ) <| Set.range_subset_iff.2 fun w => ⟨ M.run w, rfl ⟩

/-
**Key decidability reduction**: The question "does value v appear in any DFAO output?"
    reduces to a finite check over the state space. If v appears, it must be the output
    of some state; if it's the output of some state, there's a word reaching it.
    This is NOT trivially true — it captures the essential finiteness of DFAOs.
-/
theorem DFAO.value_in_output_range [Fintype σ] [DecidableEq α] (M : DFAO σ k α) (v : α)
    (h : ∃ w : List (Fin k), M.eval w = v) : v ∈ Finset.image M.output Finset.univ := by
  obtain ⟨ w, rfl ⟩ := h; exact Finset.mem_image_of_mem _ ( Finset.mem_univ _ ) ;

/-- **Effective decidability**: We can decide if v appears by checking all states.
    Combined with `value_in_output_range`, this gives a decision procedure:
    if v ∉ image(output), answer NO; if v ∈ image(output), answer YES
    (since every state is reachable via some word, at least as an upper bound).
    The mathematical content is that the output range is a computable finite set. -/
theorem DFAO.output_range_decidable [Fintype σ] [DecidableEq α]
    (M : DFAO σ k α) (v : α) : v ∈ Finset.image M.output Finset.univ ∨
    v ∉ Finset.image M.output Finset.univ :=
  em _

/-! ## Part 3: Product Construction — Closure Under Pairing -/

variable {σ₁ σ₂ : Type*} {β : Type*}

/-- The product of two DFAOs runs them simultaneously on the same input,
    producing paired output. This is the fundamental construction for showing
    that k-automatic sequences are closed under pointwise operations. -/
def DFAO.product (M₁ : DFAO σ₁ k α) (M₂ : DFAO σ₂ k β) :
    DFAO (σ₁ × σ₂) k (α × β) where
  transition := fun ⟨s₁, s₂⟩ d => (M₁.transition s₁ d, M₂.transition s₂ d)
  initial := (M₁.initial, M₂.initial)
  output := fun ⟨s₁, s₂⟩ => (M₁.output s₁, M₂.output s₂)

/-
The product DFAO correctly tracks both components simultaneously.
-/
theorem DFAO.product_runFrom (M₁ : DFAO σ₁ k α) (M₂ : DFAO σ₂ k β)
    (s₁ : σ₁) (s₂ : σ₂) (w : List (Fin k)) :
    (M₁.product M₂).runFrom (s₁, s₂) w = (M₁.runFrom s₁ w, M₂.runFrom s₂ w) := by
  induction w generalizing s₁ s₂ <;> aesop

/-
**Product correctness**: The product DFAO evaluates to the pair of individual evaluations.
-/
theorem DFAO.product_eval (M₁ : DFAO σ₁ k α) (M₂ : DFAO σ₂ k β)
    (w : List (Fin k)) :
    (M₁.product M₂).eval w = (M₁.eval w, M₂.eval w) := by
  convert congr_arg _ ( DFAO.product_runFrom M₁ M₂ M₁.initial M₂.initial w )

/-! ## Part 4: Composition — Closure Under Postprocessing -/

/-- Post-compose a DFAO's output with a function. -/
def DFAO.map (M : DFAO σ k α) (f : α → β) : DFAO σ k β where
  transition := M.transition
  initial := M.initial
  output := f ∘ M.output

/-
Map preserves the run behavior — only output changes.
-/
theorem DFAO.map_run (M : DFAO σ k α) (f : α → β) (w : List (Fin k)) :
    (M.map f).run w = M.run w := by
  -- By definition of `runFrom`, we can prove this by induction on the input word `w`.
  have h_runFrom_induction : ∀ s : σ, ∀ w : List (Fin k), (M.map f).runFrom s w = M.runFrom s w := by
    intro s w; induction w generalizing s <;> simp +decide [ *, DFAO.runFrom ] ;
    rfl;
  exact h_runFrom_induction _ _

/-
Map correctly transforms evaluations.
-/
theorem DFAO.map_eval (M : DFAO σ k α) (f : α → β) (w : List (Fin k)) :
    (M.map f).eval w = f (M.eval w) := by
  exact congr_arg f ( congr_arg M.output ( DFAO.map_run M f w ) )

/-! ## Part 5: Base-k Representation and ℕ-Indexed Sequences -/

/-- Convert a natural number to base-k digits (least significant first). -/
def toBaseK (k : ℕ) (hk : 2 ≤ k) : ℕ → List (Fin k)
  | 0 => []
  | m + 1 =>
    have h1 : (m + 1) / k < m + 1 := Nat.div_lt_self (by omega) (by omega)
    ⟨(m + 1) % k, Nat.mod_lt _ (by omega)⟩ :: toBaseK k hk ((m + 1) / k)

/-- The ℕ-indexed sequence generated by a DFAO. -/
def DFAO.sequence (M : DFAO σ k α) (hk : 2 ≤ k) (m : ℕ) : α :=
  M.eval (toBaseK k hk m)

/-- A sequence is k-automatic if it is the ℕ-indexed sequence of some DFAO. -/
def IsKAutomatic (k : ℕ) (hk : 2 ≤ k) (seq : ℕ → α) : Prop :=
  ∃ (σ : Type) (_ : Fintype σ) (M : DFAO σ k α), ∀ m, M.sequence hk m = seq m

/-! ## Part 6: The Thue-Morse Sequence -/

/-- Binary digit sum (popcount). -/
def bitSum : ℕ → ℕ
  | 0 => 0
  | m + 1 =>
    have : (m + 1) / 2 < m + 1 := Nat.div_lt_self (by omega) (by omega)
    ((m + 1) % 2) + bitSum ((m + 1) / 2)

/-- The Thue-Morse sequence: t(n) = popcount(n) mod 2.
    This is the prototypical 2-automatic sequence. -/
def thueMorse (m : ℕ) : ℕ := bitSum m % 2

/-
bitSum(2m) = bitSum(m): even numbers have the same digit sum as their half.
-/
theorem bitSum_double (m : ℕ) : bitSum (2 * m) = bitSum m := by
  induction' m using Nat.strong_induction_on with m ih;
  rcases m with _ | _ | m;
  · rfl;
  · native_decide +revert;
  · rw [ show 2 * ( m + 1 + 1 ) = 2 * ( m + 1 ) + 2 by ring, bitSum ] ; simp +arith +decide [ ih ];
    norm_num [ Nat.add_div ]

/-
bitSum(2m+1) = bitSum(m) + 1: odd numbers gain one bit.
-/
theorem bitSum_double_succ (m : ℕ) : bitSum (2 * m + 1) = bitSum m + 1 := by
  rw [ bitSum ];
  grind +ring

/-- **Self-similarity**: t(2n) = t(n). The Thue-Morse sequence is invariant
    under extraction of even-indexed terms. -/
theorem thueMorse_double (m : ℕ) : thueMorse (2 * m) = thueMorse m := by
  simp [thueMorse, bitSum_double]

/-- **Complementation**: t(2n+1) ≠ t(n). Odd-indexed terms complement even-indexed ones. -/
theorem thueMorse_double_succ_ne (m : ℕ) : thueMorse (2 * m + 1) ≠ thueMorse m := by
  unfold thueMorse; rw [bitSum_double_succ]; omega

/-! ## Part 7: Thue-Morse Is Not Eventually Periodic -/

/-- A sequence is eventually periodic. -/
def IsEventuallyPeriodic (seq : ℕ → ℕ) : Prop :=
  ∃ p N, 0 < p ∧ ∀ m, N ≤ m → seq (m + p) = seq m

/-
Period halving: if Thue-Morse has period 2q, it has period q.
    This is the key lemma: the self-similar structure of Thue-Morse
    means even periods can always be halved.
-/
theorem thueMorse_period_halving (q N : ℕ) (hq : 0 < q)
    (hper : ∀ m, N ≤ m → thueMorse (m + 2 * q) = thueMorse m) :
    ∀ m, N ≤ m → thueMorse (m + q) = thueMorse m := by
  intro m hm;
  convert hper ( 2 * m ) ( by linarith ) using 1;
  · rw [ ← mul_add, thueMorse_double ];
  · rw [ thueMorse_double ]

/-
Thue-Morse cannot be eventually constant: if it were, t(2N) and t(2N+1)
    would be equal, contradicting complementation.
-/
theorem thueMorse_not_eventually_constant (c N : ℕ)
    (hconst : ∀ m, N ≤ m → thueMorse m = c) : False := by
  have := hconst ( 2 * N + 1 ) ( by linarith ) ; have := hconst N ( by linarith ) ; simp_all +decide [ thueMorse_double_succ_ne ] ;
  exact absurd ( thueMorse_double_succ_ne N ) ( by aesop )

/-
**Main aperiodicity theorem**: The Thue-Morse sequence is not eventually periodic.

    The proof uses strong induction on the period p:
    - Even periods can be halved (thueMorse_period_halving)
    - This descends until period reaches 1
    - Period 1 means eventually constant, contradicting complementation

    This demonstrates genuine mathematical depth: the interplay between
    the self-similar structure t(2n) = t(n) and the complementation
    t(2n+1) ≠ t(n) forces aperiodicity.
-/
theorem thueMorse_not_eventually_periodic : ¬ IsEventuallyPeriodic thueMorse := by
  rintro ⟨ p, N, hp, h ⟩;
  induction' p using Nat.strong_induction_on with p ih generalizing N;
  rcases Nat.even_or_odd' p with ⟨ q, rfl | rfl ⟩;
  · exact ih q ( by linarith ) N ( by linarith ) ( thueMorse_period_halving q N ( by linarith ) h );
  · -- From the periodicity assumption, we have that thueMorse(m + q) ≠ thueMorse(m) for all m ≥ N.
    have h_neq : ∀ m ≥ N, thueMorse (m + q) ≠ thueMorse m := by
      intros m hm
      have h_eq : thueMorse (2 * (m + q) + 1) = thueMorse (2 * m) := by
        convert h ( 2 * m ) ( by linarith ) using 1 ; ring;
      simp_all +decide [ thueMorse_double, thueMorse_double_succ_ne ];
      exact fun h => thueMorse_double_succ_ne ( m + q ) |> fun h' => h'.elim <| by aesop;
    -- Since thueMorse takes only values 0,1, this means thueMorse(m+q) = 1 - thueMorse(m) for m ≥ N.
    have h_compl : ∀ m ≥ N, thueMorse (m + q) = 1 - thueMorse m := by
      intros m hm
      have h_val : thueMorse (m + q) = 0 ∨ thueMorse (m + q) = 1 := by
        exact Nat.mod_two_eq_zero_or_one _
      have h_val' : thueMorse m = 0 ∨ thueMorse m = 1 := by
        exact Nat.mod_two_eq_zero_or_one _;
      cases h_val <;> cases h_val' <;> specialize h_neq m hm <;> aesop;
    -- Then thueMorse(m + 2q) = 1 - thueMorse(m+q) = 1 - (1 - thueMorse(m)) = thueMorse(m).
    have h_period : ∀ m ≥ N, thueMorse (m + 2 * q) = thueMorse m := by
      intro m hm; rw [ two_mul, ← add_assoc, h_compl _ ( by linarith ), h_compl _ ( by linarith ) ] ;
      rw [ Nat.sub_sub_self ( show thueMorse m ≤ 1 from Nat.le_of_lt_succ ( Nat.mod_lt _ ( by decide ) ) ) ];
    rcases q with ( _ | q ) <;> simp_all +arith +decide;
    · linarith [ h_neq N ];
    · contrapose! ih;
      exact ⟨ 2 * q + 2, by linarith, N, by linarith, fun x hx => by simpa [ add_comm, add_left_comm, add_assoc ] using h_period x hx ⟩

/-! ## Part 8: k-Kernel and the Finite Kernel Characterization -/

/-- The k-kernel of a sequence: the set of all subsequences obtained by
    extracting terms at positions k^e · n + r for 0 ≤ r < k^e.
    This is a fundamental invariant — a sequence is k-automatic iff
    its k-kernel is finite (Eilenberg's theorem). -/
def kKernel (k : ℕ) (seq : ℕ → α) : Set (ℕ → α) :=
  { f | ∃ e r, r < k ^ e ∧ f = fun m => seq (k ^ e * m + r) }

/-
The original sequence belongs to its own k-kernel (e=0, r=0).
-/
theorem seq_mem_kKernel (k : ℕ) (hk : 1 ≤ k) (seq : ℕ → α) :
    seq ∈ kKernel k seq := by
  exact ⟨ 0, 0, by simp +decide, by simp +decide ⟩

/-
**Kernel closure under extraction**: If f is in the k-kernel of seq,
    then extracting a further subsequence g(n) = f(k·n + j) for j < k
    gives another element of the k-kernel. This shows the k-kernel is
    closed under the "extract-and-shift" operation.
-/
theorem kKernel_closed (k : ℕ) (hk : 2 ≤ k) (seq : ℕ → α)
    (f : ℕ → α) (hf : f ∈ kKernel k seq) (j : ℕ) (hj : j < k) :
    (fun n => f (k * n + j)) ∈ kKernel k seq := by
  obtain ⟨ e, r, hr, rfl ⟩ := hf;
  refine' ⟨ e + 1, k ^ e * j + r, _, _ ⟩ <;> ring_nf at *;
  nlinarith

/-! ## Part 9: Alphabet Morphisms and the Decidability Frontier -/

/-- A morphism on an alphabet maps each letter to a word. -/
structure AlphabetMorphism (k : ℕ) where
  image : Fin k → List (Fin k)

/-- A morphism is k-uniform if every image has length exactly k. -/
def AlphabetMorphism.IsUniform (σ : AlphabetMorphism k) : Prop :=
  ∀ a : Fin k, (σ.image a).length = k

/-- Apply a morphism to a word. -/
def AlphabetMorphism.applyWord (σ : AlphabetMorphism k) (w : List (Fin k)) : List (Fin k) :=
  w.flatMap σ.image

/-- The n-th iterate of a morphism on a letter. -/
def AlphabetMorphism.iterateOn (σ : AlphabetMorphism k) (a : Fin k) : ℕ → List (Fin k)
  | 0 => [a]
  | n + 1 => σ.applyWord (σ.iterateOn a n)

/-
**Exponential growth**: For a k-uniform morphism, |σⁿ(a)| = kⁿ.
    This is the fundamental size bound that makes uniform morphisms tractable.
-/
theorem AlphabetMorphism.iterate_length_uniform
    (σ : AlphabetMorphism k) (a : Fin k) (_hk : 0 < k)
    (hunif : σ.IsUniform) (n : ℕ) :
    (σ.iterateOn a n).length = k ^ n := by
  induction' n with n ih;
  · rfl;
  · have h_len_apply : ∀ (l : List (Fin k)), (l.flatMap σ.image).length = l.length * k := by
      intro l; induction l <;> simp_all +decide [ hunif ] ;
      linarith [ hunif ‹_› ];
    convert h_len_apply ( σ.iterateOn a n ) using 1 ; rw [ ih, pow_succ ]

/-! ## Part 10: Conjecture — Morphic Decidability -/

/-- A morphism is prolongable on letter a if σ(a) starts with a and has length ≥ 2.
    The fixed point of such a morphism defines an infinite morphic sequence. -/
def AlphabetMorphism.IsProlongable (σ : AlphabetMorphism k) (a : Fin k) : Prop :=
  ∃ h : σ.image a ≠ [], (σ.image a).head h = a ∧ 2 ≤ (σ.image a).length

/-- **Open Conjecture (Morphic Decidability)**: The zero-in-sequence problem
    for morphic sequences is decidable.

    Known true for k-automatic sequences (our main theorem above).
    Known true for k-uniform morphisms.
    Open for general (non-uniform) morphisms.

    **Falsifiable test**: Implement BFS-based decision algorithm and verify
    agreement with brute-force iteration (up to 10^6) on all morphisms
    over alphabets of size ≤ 4 with images of length ≤ 6. -/
def MorphicDecidabilityConjecture : Prop :=
  ∀ (k : ℕ) (_ : 2 ≤ k) (σ : AlphabetMorphism k) (a b : Fin k),
    σ.IsProlongable a →
    Nonempty (Decidable (∃ n : ℕ, b ∈ σ.iterateOn a n))

/-! ## Part 11: Cross-Domain Bridge — Periodicity to Recurrences -/

/-- A shift recurrence with period p starting at N. -/
def SatisfiesShiftRecurrence (p N : ℕ) (seq : ℕ → ℤ) : Prop :=
  ∀ m, N + p ≤ m → seq m = seq (m - p)

/-
**Bridge theorem**: Every eventually periodic ℤ-sequence satisfies a shift recurrence.
    This connects the automata-theoretic world to algebraic structure theory.
-/
theorem eventually_periodic_implies_recurrence
    (seq : ℕ → ℤ) (p N : ℕ) (_hp : 0 < p)
    (hper : ∀ m, N ≤ m → seq (m + p) = seq m) :
    SatisfiesShiftRecurrence p N seq := by
  exact fun m hm => by simpa [ add_comm ] using hper ( m - p ) ( Nat.le_sub_of_add_le ( by linarith ) ) |> fun h => by simpa [ Nat.sub_add_cancel ( by linarith : p ≤ m ) ] using h;

end AutoSeq