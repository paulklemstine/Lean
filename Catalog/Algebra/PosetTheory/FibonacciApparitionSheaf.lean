import Mathlib

/-!
# The rank of apparition of a Fibonacci divisor

`Shared/NumberTheory/CarmichaelCompositeEntryPoint.lean` develops the theory of
Fibonacci *entry points* on top of this module, but the module itself was
missing from the catalog, which broke the build of the `Shared` library.  It is
supplied here.

For a modulus `m > 0` the set of positive indices at which `m` divides a
Fibonacci number is nonempty — the state pair `(F n, F (n+1))` mod `m` ranges
over a finite set, and the Fibonacci recursion is invertible, so the state
sequence is *purely* periodic and returns to `(0, 1)`.  The least such index is
the **rank of apparition** `fibRank m`.  Closure of the index set under `gcd`
(via `Nat.fib_gcd`) upgrades minimality to the locality statement
`fibRank_dvd_iff`: the divisibility datum spread along the index line is
generated by the single index `fibRank m`.

Main results:

* `hasFibRank_of_pos` — every positive modulus has a rank of apparition;
* `fibRank_pos`, `dvd_fib_fibRank` — the rank is positive and realises the
  divisibility;
* `fibRank_min` — minimality of the rank;
* `fibRank_dvd_iff` — `m ∣ F n ↔ fibRank m ∣ n`.
-/

namespace FibonacciApparitionSheaf

/-- The set of positive indices at which `m` divides a Fibonacci number. -/
def apparitionSet (m : ℕ) : Set ℕ := {n | 0 < n ∧ m ∣ Nat.fib n}

/-- `m` *has a rank of apparition* when it divides some Fibonacci number of
positive index. -/
def HasFibRank (m : ℕ) : Prop := (apparitionSet m).Nonempty

/-- The rank of apparition: the least positive index `n` with `m ∣ F n`. -/
noncomputable def fibRank (m : ℕ) : ℕ := sInf (apparitionSet m)

/-- The state of the Fibonacci recursion at time `n`, read modulo `m`. -/
def fibState (m n : ℕ) : ZMod m × ZMod m := ((Nat.fib n : ZMod m), (Nat.fib (n + 1) : ZMod m))

/-- **Pure periodicity.**  Because the Fibonacci recursion can be run backwards
(`F n = F (n+2) - F (n+1)`), a coincidence of states at times `a` and `a + k`
propagates all the way down to time `0`. -/
theorem fibState_zero_of_eq (m : ℕ) :
    ∀ a k : ℕ, fibState m a = fibState m (a + k) → fibState m 0 = fibState m k := by
  intro a
  induction a with
  | zero => intro k h; simpa using h
  | succ a ih =>
    intro k h
    refine ih k ?_
    have h1 : (Nat.fib (a + 1) : ZMod m) = (Nat.fib (a + k + 1) : ZMod m) := by
      have := congrArg Prod.fst h
      simp only [fibState] at this
      rw [show a + 1 + k = a + k + 1 by ring] at this
      exact this
    have h2 : (Nat.fib (a + 2) : ZMod m) = (Nat.fib (a + k + 2) : ZMod m) := by
      have := congrArg Prod.snd h
      simp only [fibState] at this
      rw [show a + 1 + 1 = a + 2 by ring, show a + 1 + k + 1 = a + k + 2 by ring] at this
      exact this
    have e1 : (Nat.fib (a + 2) : ZMod m) = (Nat.fib a : ZMod m) + (Nat.fib (a + 1) : ZMod m) := by
      rw [Nat.fib_add_two]; push_cast; ring
    have e2 : (Nat.fib (a + k + 2) : ZMod m)
        = (Nat.fib (a + k) : ZMod m) + (Nat.fib (a + k + 1) : ZMod m) := by
      rw [Nat.fib_add_two]; push_cast; ring
    have hfst : (Nat.fib a : ZMod m) = (Nat.fib (a + k) : ZMod m) := by
      linear_combination (-1 : ZMod m) * e1 + e2 + h2 - h1
    simp only [fibState, Prod.mk.injEq]
    exact ⟨hfst, h1⟩

/-- Every positive modulus has a rank of apparition. -/
theorem hasFibRank_of_pos (m : ℕ) (hm : 0 < m) : HasFibRank m := by
  haveI : NeZero m := ⟨hm.ne'⟩
  have key : ∀ a k : ℕ, 0 < k → fibState m a = fibState m (a + k) → HasFibRank m := by
    intro a k hk heq
    have h0 := fibState_zero_of_eq m a k heq
    have hz : (Nat.fib k : ZMod m) = 0 := by
      have := congrArg Prod.fst h0
      simpa [fibState] using this.symm
    exact ⟨k, hk, (ZMod.natCast_eq_zero_iff _ _).1 hz⟩
  obtain ⟨a, b, hne, heq⟩ := Finite.exists_ne_map_eq_of_infinite (fibState m)
  rcases hne.lt_or_gt with h | h
  · obtain ⟨k, rfl⟩ : ∃ k, b = a + k := ⟨b - a, by omega⟩
    exact key a k (by omega) heq
  · obtain ⟨k, rfl⟩ : ∃ k, a = b + k := ⟨a - b, by omega⟩
    exact key b k (by omega) heq.symm

/-- The rank of apparition is positive. -/
theorem fibRank_pos {m : ℕ} (h : HasFibRank m) : 0 < fibRank m :=
  (Nat.sInf_mem h).1

/-- The modulus divides the Fibonacci number at its rank of apparition. -/
theorem dvd_fib_fibRank {m : ℕ} (h : HasFibRank m) : m ∣ Nat.fib (fibRank m) :=
  (Nat.sInf_mem h).2

/-- Minimality: no positive index below the rank works. -/
theorem fibRank_min {m k : ℕ} (hk : 0 < k) (hlt : k < fibRank m) : ¬ m ∣ Nat.fib k := by
  intro hdvd
  have := Nat.sInf_le (show k ∈ apparitionSet m from ⟨hk, hdvd⟩)
  simp only [fibRank] at hlt
  omega

/-- **Locality.**  The indices at which `m` appears are exactly the multiples of
its rank of apparition. -/
theorem fibRank_dvd_iff {m : ℕ} (h : HasFibRank m) (n : ℕ) :
    m ∣ Nat.fib n ↔ fibRank m ∣ n := by
  constructor
  · intro hn
    rcases Nat.eq_zero_or_pos n with rfl | hpos
    · exact dvd_zero _
    have hg : m ∣ Nat.fib (Nat.gcd n (fibRank m)) := by
      rw [Nat.fib_gcd]
      exact Nat.dvd_gcd hn (dvd_fib_fibRank h)
    have hgpos : 0 < Nat.gcd n (fibRank m) := Nat.gcd_pos_of_pos_left _ hpos
    have hge : Nat.gcd n (fibRank m) ≤ fibRank m :=
      Nat.le_of_dvd (fibRank_pos h) (Nat.gcd_dvd_right _ _)
    have hle : fibRank m ≤ Nat.gcd n (fibRank m) := by
      by_contra hcon
      exact fibRank_min hgpos (by omega) hg
    have heq : Nat.gcd n (fibRank m) = fibRank m := le_antisymm hge hle
    exact heq ▸ Nat.gcd_dvd_left n (fibRank m)
  · intro hn
    exact dvd_trans (dvd_fib_fibRank h) (Nat.fib_dvd _ _ hn)

end FibonacciApparitionSheaf