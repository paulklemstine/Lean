/-
# Symmetric Group Generation — Exact Counting and Probability Bounds

Computational verification of generation pair counts for small symmetric groups.
-/
import Mathlib

open scoped BigOperators
open Finset

abbrev symmGroup (n : ℕ) := Equiv.Perm (Fin n)

/-! ## Computable closure -/

/-- Compute the subgroup generated by a finset of elements, returned as a Finset.
    Iterates multiplication closure until fixed point. -/
def closureFinset {α : Type*} [Group α] [DecidableEq α] [Fintype α]
    (gens : Finset α) : Finset α :=
  let step (s : Finset α) : Finset α :=
    s ∪ {1} ∪ gens.image (·⁻¹) ∪ (s ×ˢ s).image (fun p => p.1 * p.2)
  Nat.iterate step (Fintype.card α) ({1} ∪ gens ∪ gens.image (·⁻¹))

/-- Boolean test: do two permutations generate S_n? -/
def generatesTopBool {n : ℕ} (σ τ : symmGroup n) : Bool :=
  (closureFinset {σ, τ}).card == Fintype.card (symmGroup n)

/-! ## Exact counts verified by computation -/

/-- The number of generating pairs in S_2 is 3. -/
theorem genPairCount_two :
    ((Finset.univ : Finset (symmGroup 2 × symmGroup 2)).filter
      (fun (p : symmGroup 2 × symmGroup 2) => generatesTopBool p.1 p.2)).card = 3 := by
  native_decide

/-- The number of generating pairs in S_3 is 18. -/
theorem genPairCount_three :
    ((Finset.univ : Finset (symmGroup 3 × symmGroup 3)).filter
      (fun (p : symmGroup 3 × symmGroup 3) => generatesTopBool p.1 p.2)).card = 18 := by
  native_decide

/-- |S_2| = 2. -/
theorem card_symmGroup_two : Fintype.card (symmGroup 2) = 2 := by native_decide

/-- |S_3| = 6. -/
theorem card_symmGroup_three : Fintype.card (symmGroup 3) = 6 := by native_decide

/-- |S_3|² = 36, so 18/36 = 1/2 as a probability. -/
theorem genProb_three_eq : (18 : ℚ) / (6 ^ 2 : ℕ) = 1 / 2 := by norm_num

/-- |S_2|² = 4, so 3/4 as a probability. -/
theorem genProb_two_eq : (3 : ℚ) / (2 ^ 2 : ℕ) = 3 / 4 := by norm_num

/-! ## Correctness of closureFinset -/

/-- closureFinset is monotone: the set grows with each iteration step. -/
private def closureStep {α : Type*} [Group α] [DecidableEq α] [Fintype α]
    (gens : Finset α) (s : Finset α) : Finset α :=
  s ∪ {1} ∪ gens.image (·⁻¹) ∪ (s ×ˢ s).image (fun p => p.1 * p.2)

/-
Every element of closureFinset is in the abstract Subgroup.closure.
-/
theorem closureFinset_subset_closure {α : Type*} [Group α] [DecidableEq α] [Fintype α]
    (gens : Finset α) :
    ∀ x ∈ closureFinset gens, x ∈ Subgroup.closure (↑gens : Set α) := by
  intro x hx
  have h_closure : ∀ s : Finset α, (∀ x ∈ s, x ∈ Subgroup.closure (gens : Set α)) → ∀ x ∈ closureStep gens s, x ∈ Subgroup.closure (gens : Set α) := by
    intro s hs x hx; unfold closureStep at hx; aesop;
  -- By induction on the number of iterations, we can show that every element in the closureFinset is in the abstract Subgroup.closure.
  have h_ind : ∀ n : ℕ, ∀ x ∈ Nat.iterate (closureStep gens) n ({1} ∪ gens ∪ gens.image (·⁻¹)), x ∈ Subgroup.closure (gens : Set α) := by
    intro n
    induction' n with n ih;
    · simp +decide [ Subgroup.mem_closure ];
      rintro a ( ha | ⟨ b, hb, rfl ⟩ ) K hK <;> [ exact hK ha; exact K.inv_mem ( hK hb ) ];
    · simpa only [ Function.iterate_succ_apply' ] using h_closure _ ih;
  exact h_ind _ _ hx

/-- If closureFinset has full cardinality, then Subgroup.closure = ⊤. -/
theorem closureFinset_card_eq_implies_top {α : Type*} [Group α] [DecidableEq α] [Fintype α]
    (gens : Finset α) (h : (closureFinset gens).card = Fintype.card α) :
    Subgroup.closure (↑gens : Set α) = ⊤ := by
  rw [Subgroup.eq_top_iff']
  intro x
  have hmem : x ∈ closureFinset gens := by
    have : closureFinset gens = Finset.univ := by
      exact Finset.eq_univ_of_card _ h
    rw [this]; exact Finset.mem_univ _
  exact closureFinset_subset_closure gens x hmem

/-
If Subgroup.closure S = ⊤ and closureFinset ⊆ closure, then closureFinset = univ.
-/
set_option maxHeartbeats 800000 in
theorem top_implies_closureFinset_card {α : Type*} [Group α] [DecidableEq α] [Fintype α]
    (gens : Finset α) (h : Subgroup.closure (↑gens : Set α) = ⊤) :
    (closureFinset gens).card = Fintype.card α := by
  refine' le_antisymm _ _;
  · exact Finset.card_le_univ _;
  · -- Since every element of α can be expressed as a word of length ≤ Fintype.card α in the generators and their inverses, closureFinset must contain all elements of α.
    have h_all_elements : ∀ x : α, ∃ w : List α, w.length ≤ Fintype.card α ∧ (∀ y ∈ w, y ∈ gens ∪ gens.image (·⁻¹)) ∧ x = List.prod w := by
      intro x
      obtain ⟨w, hw⟩ : ∃ w : List α, (∀ y ∈ w, y ∈ gens ∪ gens.image (·⁻¹)) ∧ x = List.prod w := by
        have h_exists_word : x ∈ Subgroup.closure (gens : Set α) := by
          aesop;
        refine' Subgroup.closure_induction ( fun y hy => _ ) _ _ _ h_exists_word;
        · exact ⟨ [ y ], by aesop ⟩;
        · exact ⟨ [ ], by simp +decide ⟩;
        · rintro x y hx hy ⟨ w₁, hw₁, rfl ⟩ ⟨ w₂, hw₂, rfl ⟩ ; exact ⟨ w₁ ++ w₂, by aesop ⟩;
        · rintro x hx ⟨ w, hw, rfl ⟩;
          refine' ⟨ w.reverse.map fun y => y⁻¹, _, _ ⟩ <;> simp_all +decide [ List.prod_inv_reverse ];
          intro y hy; specialize hw y⁻¹; aesop;
      -- If the length of `w` is greater than `Fintype.card α`, we can find a shorter word that represents the same element.
      have h_shorten : ∀ {w : List α}, (∀ y ∈ w, y ∈ gens ∪ gens.image (·⁻¹)) → w.length > Fintype.card α → ∃ w' : List α, w'.length < w.length ∧ (∀ y ∈ w', y ∈ gens ∪ gens.image (·⁻¹)) ∧ List.prod w' = List.prod w := by
        intro w hw hw_len
        obtain ⟨i, j, hij, h_eq⟩ : ∃ i j : Fin (w.length + 1), i < j ∧ List.prod (w.take i) = List.prod (w.take j) := by
          by_contra! h;
          exact absurd ( Finset.card_le_univ ( Finset.image ( fun i : Fin ( w.length + 1 ) => List.prod ( List.take i w ) ) Finset.univ ) ) ( by rw [ Finset.card_image_of_injective _ fun i j hij => le_antisymm ( not_lt.1 fun hi => h _ _ hi hij.symm ) ( not_lt.1 fun hj => h _ _ hj hij ) ] ; simpa using by linarith );
        refine' ⟨ List.take i w ++ List.drop j w, _, _, _ ⟩ <;> simp_all +decide [ List.prod_append ];
        · grind;
        · rintro y ( hy | hy ) <;> [ exact hw y ( List.mem_of_mem_take hy ) ; exact hw y ( List.mem_of_mem_drop hy ) ];
      induction' n : w.length using Nat.strong_induction_on with n ih generalizing w;
      grind;
    refine' Finset.card_le_card _;
    intro x hx;
    obtain ⟨ w, hw₁, hw₂, rfl ⟩ := h_all_elements x;
    -- By definition of closureFinset, we know that if w is a list of elements in gens ∪ gens.image (·⁻¹), then w.prod is in closureFinset gens.
    have h_closure : ∀ w : List α, (∀ y ∈ w, y ∈ gens ∪ gens.image (·⁻¹)) → w.prod ∈ Nat.iterate (fun s => s ∪ {1} ∪ gens.image (·⁻¹) ∪ (s ×ˢ s).image (fun p => p.1 * p.2)) w.length ({1} ∪ gens ∪ gens.image (·⁻¹)) := by
      intro w hw₂; induction' w with y w ih <;> simp_all +decide [ Function.iterate_succ_apply' ] ;
      refine' Or.inr ( Or.inr ( Or.inr ⟨ y, w.prod, _, rfl ⟩ ) );
      refine' ⟨ _, ih ⟩;
      refine' Nat.recOn w.length _ _ <;> simp_all +decide [ Function.iterate_succ_apply' ];
    have h_closure : ∀ n ≥ w.length, w.prod ∈ Nat.iterate (fun s => s ∪ {1} ∪ gens.image (·⁻¹) ∪ (s ×ˢ s).image (fun p => p.1 * p.2)) n ({1} ∪ gens ∪ gens.image (·⁻¹)) := by
      intro n hn
      induction' hn with n hn ih;
      · exact h_closure w hw₂;
      · simp_all +decide [ Function.iterate_succ_apply' ];
    exact h_closure _ hw₁

/-- generatesTopBool = true iff Subgroup.closure {σ, τ} = ⊤. -/
theorem generatesTopBool_iff {n : ℕ} (σ τ : symmGroup n) :
    generatesTopBool σ τ = true ↔
    Subgroup.closure ({σ, τ} : Set (symmGroup n)) = ⊤ := by
  simp only [generatesTopBool, beq_iff_eq]
  constructor
  · intro h
    have : (closureFinset ({σ, τ} : Finset (symmGroup n))).card = Fintype.card (symmGroup n) := h
    have key := closureFinset_card_eq_implies_top ({σ, τ} : Finset (symmGroup n)) this
    simp at key
    exact key
  · intro h
    have key := top_implies_closureFinset_card ({σ, τ} : Finset (symmGroup n)) (by simp; exact h)
    exact key