--- Defs.lean
+++ Defs.lean
@@ -25,93 +9,23 @@
     (f : G → ℝ) : ℝ :=
   (∑ x : G, f x) / Fintype.card G
 
-/-- Variance of a function over a finite group:
-    Var(f) = (1/|G|) ∑_x (f(x) - f̄)². -/
-noncomputable def variance {G : Type*} [Fintype G]
-    (f : G → ℝ) : ℝ :=
-  (∑ x : G, (f x - meanValue f) ^ 2) / Fintype.card G
-
-/-- L² norm squared: ‖f‖₂² = ∑_x f(x)². -/
+/-- L² norm squared. -/
 noncomputable def l2NormSq {G : Type*} [Fintype G]
     (f : G → ℝ) : ℝ :=
   ∑ x : G, f x ^ 2
 
-/-- A function has mean zero. -/
-def meanZero {G : Type*} [Fintype G]
-    (f : G → ℝ) : Prop :=
-  ∑ x : G, f x = 0
-
-/-- Structure encapsulating expansion data for a symmetric Cayley graph. -/
-structure CayleySpectralData (G : Type*) [Fintype G] [Group G] where
-  /-- The generating set -/
-  gens : Finset G
-  /-- The generating set is symmetric: g ∈ S ⟹ g⁻¹ ∈ S -/
-  symm : ∀ g ∈ gens, g⁻¹ ∈ gens
-  /-- The identity is not in the generating set -/
-  id_not_mem : (1 : G) ∉ gens
-  /-- The generating set generates the whole group -/
-  generates_top : Subgroup.closure (↑gens : Set G) = ⊤
-
-/-- A canonical path system: for every pair (x, y), a word in generators
-    connecting x to y, with bounded length and bounded edge congestion. -/
-structure CanonicalPathData (G : Type*) [Fintype G] [Group G] where
-  /-- The generating set -/
-  gens : Finset G
-  /-- The generating set is symmetric -/
-  gens_symm : ∀ g ∈ gens, g⁻¹ ∈ gens
-  /-- The generating set generates the whole group -/
-  gens_generate : Subgroup.closure (↑gens : Set G) = ⊤
-  /-- Canonical path from x to y, given as a list of generators -/
-  paths : G → G → List G
-  /-- Every step in the path is a generator -/
-  path_mem : ∀ x y, ∀ s, s ∈ paths x y → s ∈ gens
-  /-- The path actually connects x to y -/
-  path_target : ∀ x y, (paths x y).prod * x = y
-  /-- Upper bound on the length of any path -/
-  length_bound : ℕ
-  /-- All paths have length ≤ length_bound -/
-  length_le : ∀ x y, (paths x y).length ≤ length_bound
-  /-- Upper bound on edge congestion -/
-  congestion : ℕ
-  /-- Positive congestion -/
-  congestion_pos : 0 < congestion
-
-/-- The explicit spectral gap lower bound from canonical path data:
-    gap ≥ |S| / (congestion · length_bound). -/
-noncomputable def explicitGapBound {G : Type*} [Fintype G] [Group G]
-    (P : CanonicalPathData G) : ℝ :=
-  P.gens.card / (P.congestion * P.length_bound : ℝ)
-
-/-- Iterated application of a function (G → ℝ) → (G → ℝ). -/
-noncomputable def iterateOp {G : Type*}
-    (op : (G → ℝ) → (G → ℝ)) : ℕ → (G → ℝ) → (G → ℝ)
-  | 0 => id
-  | n + 1 => op ∘ iterateOp op n
-
-/-! ## Basic lemmas about Dirichlet energy -/
-
-/-- Every summand in the Dirichlet energy is nonneg. -/
 theorem cayleyDirichletEnergy_nonneg {G : Type*} [Fintype G] [Group G]
     (S : Finset G) (f : G → ℝ) :
     0 ≤ cayleyDirichletEnergy S f := by
   unfold cayleyDirichletEnergy
-  apply Finset.sum_nonneg
-  intro x _
-  apply Finset.sum_nonneg
-  intro s _
-  positivity
+  apply Finset.sum_nonneg; intro x _
+  apply Finset.sum_nonneg; intro s _; positivity
 
-/-- The Dirichlet energy of a constant function is zero. -/
 theorem cayleyDirichletEnergy_const {G : Type*} [Fintype G] [Group G]
     (S : Finset G) (c : ℝ) :
     cayleyDirichletEnergy S (fun _ => c) = 0 := by
-  unfold cayleyDirichletEnergy
-  simp
+  unfold cayleyDirichletEnergy; simp
 
-/-- L² norm squared is nonneg. -/
 theorem l2NormSq_nonneg {G : Type*} [Fintype G]
     (f : G → ℝ) : 0 ≤ l2NormSq f := by
-  unfold l2NormSq
-  apply Finset.sum_nonneg
-  intro x _
 
