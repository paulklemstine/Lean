# Hybrid Adjacent-Transposition-plus-Cycle Walk on S_n

This file defines the hybrid random walk on the symmetric group S_n
generated by adjacent transpositions (i, i+1) and the long cycle
c = (0 1 2 ... n-1) with its inverse.

## Main definitions

* `hybridGeneratorsList` — the generating list for the hybrid walk
* `hybridTransitionKernel` — the transition kernel P(σ, τ)
* `uniformMeasurePerm` — the uniform measure on S_n

## Mathematical context

The hybrid walk combines local moves (adjacent transpositions) with
global moves (long cycle and its inverse). The walk is reversible
with respect to the uniform measure on S_n.
-/
import Mathlib
import Pythagorean.CayleyExpander.Defs

open Finset BigOperators Equiv Equiv.Perm

/-- The long cycle (0 1 2 ... n-1) on Fin n, using Mathlib's `Fin.cycleRange`.
    Maps i ↦ i+1 (mod n). -/
noncomputable def longCycle (n : ℕ) (hn : 1 ≤ n) : Equiv.Perm (Fin n) :=
  Fin.cycleRange ⟨n - 1, by omega⟩

/-- The list of hybrid generators:
    adjacent transpositions s_0, ..., s_{n-2} plus cycle c and c⁻¹. -/
noncomputable def hybridGeneratorsList (n : ℕ) (hn : 2 ≤ n) :
    List (Equiv.Perm (Fin n)) :=
  (List.finRange (n - 1)).map (fun i =>
    Equiv.swap (⟨i.val, by omega⟩ : Fin n) ⟨i.val + 1, by omega⟩) ++
  [longCycle n (by omega), (longCycle n (by omega))⁻¹]

/-- Number of hybrid generators = (n-1) + 2 = n + 1. -/
theorem hybridGeneratorsList_length (n : ℕ) (hn : 2 ≤ n) :
    (hybridGeneratorsList n hn).length = n + 1 := by
  unfold hybridGeneratorsList
  simp [List.length_map, List.length_finRange]
  omega

/-- The hybrid walk transition kernel: for each pair (σ, τ),
    P(σ, τ) = (number of generators g with g * σ = τ) / |generators|.
    This is the "random generator" walk. -/
noncomputable def hybridTransitionKernel (n : ℕ) (hn : 2 ≤ n)
    (σ τ : Equiv.Perm (Fin n)) : ℝ :=
  ((hybridGeneratorsList n hn).filter (fun g => g * σ = τ)).length /
    (hybridGeneratorsList n hn).length

/-- The uniform measure on S_n. -/
noncomputable def uniformMeasurePerm (n : ℕ) : Equiv.Perm (Fin n) → ℝ :=
  fun _ => (1 : ℝ) / (Fintype.card (Equiv.Perm (Fin n)))

/-- The uniform measure is positive. -/
theorem uniformMeasurePerm_pos (n : ℕ) (σ : Equiv.Perm (Fin n)) :
    0 < uniformMeasurePerm n σ := by
  unfold uniformMeasurePerm; positivity

/-- The uniform measure sums to 1. -/
theorem uniformMeasurePerm_sum (n : ℕ) :
    ∑ σ : Equiv.Perm (Fin n), uniformMeasurePerm n σ = 1 := by
  unfold uniformMeasurePerm
  simp [Finset.card_univ]