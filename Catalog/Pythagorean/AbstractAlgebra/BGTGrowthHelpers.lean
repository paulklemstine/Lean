# Helper lemmas for growth dichotomy in finite groups

This file provides the key helper lemmas needed for the growth
dichotomy theorem: every element in the subgroup generated by A
belongs to some power A^n.
-/

import Mathlib

open Finset Pointwise

variable {G : Type*} [Group G] [DecidableEq G] [Fintype G]

/-- Elements of A are in A^1 = A. -/
theorem mem_pow_one_of_mem (A : Finset G) (g : G) (hg : g ∈ A) :
    g ∈ A ^ 1 := by
  simp [hg]

/-- If g ∈ A^m and h ∈ A^n, then g * h ∈ A^(m+n). -/
theorem mul_mem_pow_add (A : Finset G) (g h : G) (m n : ℕ)
    (hg : g ∈ A ^ m) (hh : h ∈ A ^ n) :
    g * h ∈ A ^ (m + n) := by
  rw [pow_add]
  exact Finset.mem_mul.mpr ⟨g, hg, h, hh, rfl⟩

/-- 1 ∈ A^0 (since A^0 = {1}). -/
theorem one_mem_pow_zero (A : Finset G) : (1 : G) ∈ A ^ 0 := by
  simp

/-- If g ∈ A^n and 1 ∈ A, then g ∈ A^(n+m) for all m. -/
theorem mem_pow_of_mem_pow_le (A : Finset G) (h1 : (1 : G) ∈ A)
    (g : G) (n m : ℕ) (hn : n ≤ m) (hg : g ∈ A ^ n) (_hm : m ≥ 1) :
    g ∈ A ^ m := by
  obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hn
  clear _hm hn
  induction d with
  | zero => simpa using hg
  | succ k ih =>
    rw [show n + (k + 1) = (n + k) + 1 from by omega, pow_succ]
    exact Finset.mem_mul.mpr ⟨g, ih, 1, h1, mul_one g⟩

/-
Every element of closure(A) is in some A^n. This is the key
induction: we show the property holds for generators, identity,
products, and inverses.
-/
theorem closure_mem_exists_pow (A : Finset G)
    (g : G) (hg : g ∈ Subgroup.closure (↑A : Set G)) :
    ∃ n : ℕ, g ∈ A ^ n := by
  -- Use Subgroup.closure_induction on g with the property P(g) = ∃ n, g ∈ A^n.
  have h_induction : ∀ g : G, g ∈ Subgroup.closure (A : Set G) → ∃ n : ℕ, g ∈ A ^ n := by
    intro g hg
    induction' hg using Subgroup.closure_induction with g hg ih;
    · exact ⟨ 1, by simpa using hg ⟩;
    · exact ⟨ 0, by simp +decide ⟩;
    · obtain ⟨ n₁, hn₁ ⟩ := ‹∃ n, ih ∈ A ^ n›
      obtain ⟨ n₂, hn₂ ⟩ := ‹∃ n, _›
      use n₁ + n₂
      exact mul_mem_pow_add A ih _ n₁ n₂ hn₁ hn₂;
    · rename_i x hx ihx
      obtain ⟨n, hn⟩ := ihx
      have h_inv : x⁻¹ = x ^ (Fintype.card G - 1) := by
        rw [ inv_eq_of_mul_eq_one_right ] ; rw [ ← pow_succ', Nat.sub_add_cancel ( Fintype.card_pos ) ] ; simp +decide [ pow_card_eq_one ] ;
      generalize_proofs at *; (
      -- Since $x \in A^n$, we have $x^{Fintype �.card� G - 1} \in A^{n * (Fintype.card G - 1)}$ by repeated multiplication.
      have h_pow : x ^ (Fintype.card G - 1) ∈ A ^ (n * (Fintype.card G - 1)) := by
        induction' Fintype.card G - 1 with k hk <;> simp_all +decide [ pow_succ, pow_mul ];
        exact Finset.mul_mem_mul hk hn
      generalize_proofs at *; (
      grind))
  generalize_proofs at *; (
  exact h_induction g hg)

/-
If stabilization occurs (A^k = A^(k+1)) and every element is in
some power, then A^k = univ.
-/
theorem pow_eq_univ_of_stab_and_closure (A : Finset G)
    (h1 : (1 : G) ∈ A)
    (k : ℕ) (hk : k ≥ 1)
    (hstab : A ^ k = A ^ (k + 1))
    (hgen : Subgroup.closure (↑A : Set G) = ⊤) :
    A ^ k = Finset.univ := by
  -- By induction on $m$, we show that for any $m \geq k$, $A^k = A^m$.
  have h_ind : ∀ m ≥ k, A ^ k = A ^ m := by
    intro m hm;
    induction' hm with m hm ih;
    · rfl;
    · convert congr_arg ( · * A ) ih using 1;
  -- Since every element of $G$ is in the closure of $A$, and $A^k = A^n$ for � all� $n \geq k$, it follows that every element of $G$ is in $A^k$.
  have h_all : ∀ g : G, g ∈ Subgroup.closure (A : Set G) → g ∈ A ^ k := by
    intro g hg
    obtain ⟨n, hn⟩ := closure_mem_exists_pow A g hg
    by_cases hnk : n ≤ k;
    · exact mem_pow_of_mem_pow_le A h1 g n k hnk hn ( by linarith );
    · grind +splitIndPred;
  aesop

theorem card_pow_mono {G : Type*} [Group G] [DecidableEq G]
    (A : Finset G) (h1 : (1 : G) ∈ A)
    (k : ℕ) (_hk : k ≥ 1) :
    (A ^ k).card ≤ (A ^ (k + 1)).card := by
  apply Finset.card_le_card
  rw [pow_succ]
  intro x hx
  exact Finset.mem_mul.mpr ⟨x, hx, 1, h1, mul_one x⟩