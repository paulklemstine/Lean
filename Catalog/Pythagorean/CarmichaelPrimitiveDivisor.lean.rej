+/-- On the certified range `13 ≤ n ≤ 10000`, `F(n)` has a primitive prime divisor. -/
 theorem fib_primitive_divisor (n : ℕ) (hn : 13 ≤ n) (hnupper : n ≤ 10000) :
     ∃ p, Nat.Prime p ∧ p ∣ Nat.fib n ∧
 
