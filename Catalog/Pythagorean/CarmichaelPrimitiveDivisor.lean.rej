-/-- Carmichael's theorem: For n ≥ 13, F(n) has a primitive prime divisor. -/
-theorem fib_primitive_divisor (n : ℕ) (hn : 13 ≤ n) :
+/-- Certified range of Carmichael's theorem: for `13 ≤ n ≤ 10000`,
+`F(n)` has a primitive prime divisor. -/
+theorem fib_primitive_divisor (n : ℕ) (hn : 13 ≤ n) (hn2 : n ≤ 10000) :
     ∃ p, Nat.Prime p ∧ p ∣ Nat.fib n ∧
       ∀ k, 0 < k → k < n → ¬(p ∣ Nat.fib k) := by
 
