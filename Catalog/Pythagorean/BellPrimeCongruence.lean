import Pythagorean.KernelPatternsBell

/-!
# Bell numbers modulo a prime: `bell p ≡ 2 [MOD p]`

The kernel patterns of length `n` are the equivalence relations on an `n`-element set
(`KernelPattern.kerCount_eq_bell`).  For a **prime** length `p` we can let the cyclic group
`ZMod p` act on the index set by translation.  This is a `p`-group acting on a finite set, so

`Nat.bell p ≡ #(shift-invariant equivalence relations) [MOD p]`.

The heart of the matter is the classification of the invariant relations
(`KernelPattern.shiftInvariant_classification`): because `p` is prime, a single non-diagonal
related pair `i ≠ j` propagates by translation and transitivity along the whole cyclic group
generated by `j - i`, which is all of `ZMod p`.  Hence there are exactly two fixed points,
equality and the total relation, and we obtain

`KernelPattern.bell_prime_modEq : Nat.bell p ≡ 2 [MOD p]`.

Sanity checks: `bell 3 = 5 ≡ 2 (mod 3)`, `bell 5 = 52 ≡ 2 (mod 5)`, `bell 7 = 877 ≡ 2 (mod 7)`.
-/

open Finset MulAction

namespace KernelPattern

/-- The total relation: everything is related to everything. -/
def totalRel (ι : Type*) : ι → ι → Bool := fun _ _ => true

/-- The equality relation. -/
def eqRel (ι : Type*) [DecidableEq ι] : ι → ι → Bool := fun i j => decide (i = j)

theorem isKerRel_totalRel (ι : Type*) : IsKerRel (totalRel ι) :=
  ⟨fun _ => rfl, fun _ _ _ => rfl, fun _ _ _ _ _ => rfl⟩

theorem isKerRel_eqRel (ι : Type*) [DecidableEq ι] : IsKerRel (eqRel ι) := by
  refine ⟨fun a => by simp [eqRel], fun a b h => ?_, fun a b c h₁ h₂ => ?_⟩
  · simp only [eqRel, decide_eq_true_eq] at h ⊢
    exact h.symm
  · simp only [eqRel, decide_eq_true_eq] at h₁ h₂ ⊢
    exact h₁.trans h₂

section Shift

variable (p : ℕ) [Fact p.Prime]

/-- Equivalence relations on `ZMod p`, as a type. -/
def KerRelType (p : ℕ) : Type := {r : ZMod p → ZMod p → Bool // IsKerRel r}

instance : Fintype (KerRelType p) := Subtype.fintype _

instance : DecidableEq (KerRelType p) := Subtype.instDecidableEq

/-- The cyclic group `ZMod p` acts on the equivalence relations of `ZMod p` by translating
the index set. -/
instance shiftSMul : SMul (Multiplicative (ZMod p)) (KerRelType p) where
  smul g r :=
    ⟨fun i j => r.1 (i + Multiplicative.toAdd g) (j + Multiplicative.toAdd g), by
      obtain ⟨hrefl, hsymm, htrans⟩ := r.2
      exact ⟨fun a => hrefl _, fun a b h => hsymm _ _ h, fun a b c h₁ h₂ => htrans _ _ _ h₁ h₂⟩⟩

omit [Fact (Nat.Prime p)] in
theorem smul_apply (g : Multiplicative (ZMod p)) (r : KerRelType p) (i j : ZMod p) :
    (g • r).1 i j = r.1 (i + Multiplicative.toAdd g) (j + Multiplicative.toAdd g) := rfl

/-- The cyclic group `ZMod p` acts on the equivalence relations of `ZMod p` by translating
the index set. -/
instance shiftAction : MulAction (Multiplicative (ZMod p)) (KerRelType p) where
  one_smul r := by
    apply Subtype.ext
    funext i j
    rw [smul_apply]
    show r.1 (i + 0) (j + 0) = r.1 i j
    rw [add_zero, add_zero]
  mul_smul g h r := by
    apply Subtype.ext
    funext i j
    rw [smul_apply, smul_apply, smul_apply]
    show r.1 (i + (Multiplicative.toAdd g + Multiplicative.toAdd h))
        (j + (Multiplicative.toAdd g + Multiplicative.toAdd h))
      = r.1 (i + Multiplicative.toAdd g + Multiplicative.toAdd h)
          (j + Multiplicative.toAdd g + Multiplicative.toAdd h)
    rw [add_assoc, add_assoc]

/-- A fixed point of the shift action is a translation-invariant equivalence relation. -/
theorem invariant_of_mem_fixedPoints {r : KerRelType p}
    (hr : r ∈ fixedPoints (Multiplicative (ZMod p)) (KerRelType p)) (a i j : ZMod p) :
    r.1 (i + a) (j + a) = r.1 i j := by
  have h := hr (Multiplicative.ofAdd a)
  have := congrArg (fun s : KerRelType p => s.1 i j) h
  simpa [smul_apply] using this

/-- **Classification of the shift-invariant equivalence relations on `ZMod p`.**  For `p`
prime they are exactly equality and the total relation. -/
theorem shiftInvariant_classification {r : KerRelType p}
    (hr : r ∈ fixedPoints (Multiplicative (ZMod p)) (KerRelType p)) :
    r.1 = eqRel (ZMod p) ∨ r.1 = totalRel (ZMod p) := by
  obtain ⟨hrefl, hsymm, htrans⟩ := r.2
  by_cases hdiag : ∀ i j : ZMod p, r.1 i j = true → i = j
  · left
    funext i j
    by_cases h : r.1 i j = true
    · have hij : i = j := hdiag i j h
      subst hij
      simp [eqRel, hrefl i]
    · have hij : i ≠ j := by
        rintro rfl
        exact h (hrefl i)
      rw [Bool.not_eq_true] at h
      rw [h]
      simp [eqRel, hij]
  · right
    push_neg at hdiag
    obtain ⟨i, j, hrij, hij⟩ := hdiag
    set d : ZMod p := j - i with hd
    have hd0 : d ≠ 0 := sub_ne_zero.2 (Ne.symm hij)
    -- a single related pair translates to every translate of it
    have step : ∀ a : ZMod p, r.1 a (a + d) = true := by
      intro a
      have := invariant_of_mem_fixedPoints p hr (a - i) i j
      have hi : i + (a - i) = a := by ring
      have hj : j + (a - i) = a + d := by rw [hd]; ring
      rw [hi, hj] at this
      rw [this]
      exact hrij
    -- ... and then chains by transitivity
    have chain : ∀ k : ℕ, ∀ a : ZMod p, r.1 a (a + k * d) = true := by
      intro k
      induction k with
      | zero => intro a; simpa using hrefl a
      | succ m ih =>
          intro a
          have h1 : r.1 a (a + m * d) = true := ih a
          have h2 : r.1 (a + m * d) (a + m * d + d) = true := step (a + m * d)
          have h3 : a + m * d + d = a + (↑(m + 1) : ZMod p) * d := by push_cast; ring
          rw [h3] at h2
          exact htrans _ _ _ h1 h2
    funext a b
    simp only [totalRel]
    have hfield : ∃ k : ℕ, (k : ZMod p) * d = b - a := by
      refine ⟨((b - a) * d⁻¹).val, ?_⟩
      rw [ZMod.natCast_val, ZMod.cast_id]
      field_simp
    obtain ⟨k, hk⟩ := hfield
    have := chain k a
    rw [hk] at this
    simpa using this

/-- The two fixed points are distinct. -/
theorem eqRel_ne_totalRel : eqRel (ZMod p) ≠ totalRel (ZMod p) := by
  intro h
  haveI : Fact (1 < p) := ⟨(Fact.out (p := p.Prime)).one_lt⟩
  have h0 := congrFun (congrFun h 0) 1
  simp only [eqRel, totalRel, decide_eq_true_eq] at h0
  exact zero_ne_one h0

/-- The set of fixed points of the shift action is `{equality, total}`. -/
theorem fixedPoints_eq_pair :
    fixedPoints (Multiplicative (ZMod p)) (KerRelType p)
      = {⟨eqRel (ZMod p), isKerRel_eqRel _⟩, ⟨totalRel (ZMod p), isKerRel_totalRel _⟩} := by
  ext r
  constructor
  · intro hr
    rcases shiftInvariant_classification p hr with h | h
    · exact Or.inl (Subtype.ext h)
    · exact Or.inr (Subtype.ext h)
  · rintro (rfl | rfl) <;> intro g <;> apply Subtype.ext <;> funext i j
    · show eqRel (ZMod p) (i + Multiplicative.toAdd g) (j + Multiplicative.toAdd g)
        = eqRel (ZMod p) i j
      simp only [eqRel, add_left_inj]
    · rfl

theorem card_fixedPoints :
    Nat.card (fixedPoints (Multiplicative (ZMod p)) (KerRelType p)) = 2 := by
  rw [fixedPoints_eq_pair, Nat.card_coe_set_eq, Set.ncard_pair]
  intro h
  exact eqRel_ne_totalRel p (congrArg Subtype.val h)

theorem card_kerRelType : Nat.card (KerRelType p) = Nat.bell p := by
  haveI : NeZero p := ⟨(Fact.out (p := p.Prime)).ne_zero⟩
  rw [Nat.card_eq_fintype_card]
  have h1 : Fintype.card (KerRelType p) = kerCount (ZMod p) := by
    rw [kerCount, KerRels]
    exact Fintype.card_subtype _
  rw [h1, kerCount_eq_bell, ZMod.card]

/-- **Bell numbers modulo a prime.**  For every prime `p`, `Nat.bell p ≡ 2 [MOD p]`. -/
theorem bell_prime_modEq : Nat.bell p ≡ 2 [MOD p] := by
  haveI : NeZero p := ⟨(Fact.out (p := p.Prime)).ne_zero⟩
  have hG : IsPGroup p (Multiplicative (ZMod p)) := by
    refine IsPGroup.of_card (n := 1) ?_
    rw [pow_one, Nat.card_eq_fintype_card, Fintype.card_congr (Multiplicative.toAdd)]
    exact ZMod.card p
  have h := hG.card_modEq_card_fixedPoints (KerRelType p)
  rw [card_fixedPoints, card_kerRelType] at h
  exact h

end Shift

/-- For an odd prime the congruence takes the sharp form `bell p % p = 2`. -/
theorem bell_prime_mod (p : ℕ) (hp : p.Prime) (hp2 : 2 < p) : Nat.bell p % p = 2 := by
  haveI : Fact p.Prime := ⟨hp⟩
  have h := bell_prime_modEq p
  rw [Nat.ModEq, Nat.mod_eq_of_lt hp2] at h
  exact h

/-- A cross-check of `bell_prime_modEq` against the independently computed value
`Nat.bell 7 = 877` (see `Pythagorean.KernelStirlingClosedForms`): `877 = 125 * 7 + 2`. -/
theorem bell_seven_mod_seven : Nat.bell 7 % 7 = 2 :=
  bell_prime_mod 7 (by norm_num) (by norm_num)

end KernelPattern