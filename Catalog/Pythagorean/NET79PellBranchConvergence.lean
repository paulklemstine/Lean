import Mathlib
import Shared.AttentionBudgetKnee
import Shared.CatalogbuildSharedIspythtriple.IsPythTriple
import Pythagorean.NET79GeometricRatioKnee
import Pythagorean.NET79PythagoreanInversion

/-!
# The Pell branch: where the two Pythagorean budgets converge

`Pythagorean/NET79PythagoreanInversion.lean` shows that the short-leg and long-leg key
budgets of a Pythagorean triple are ordered, that the short-leg one is universally
bounded by `13` at gate `0.985`, and that the long-leg one is unbounded.  The natural
question is whether the *gap* between them can be made to vanish, and along which
arithmetic family.

The answer is the near-isosceles (Pell) branch

```
(3,4,5) → (20,21,29) → (119,120,169) → (696,697,985) → ⋯
```

generated by `(a, c) ↦ (3a + 2c + 1, 4a + 3c + 2)`.  We prove:

* `pell_isPythTriple` — every member is a Pythagorean triple with legs `a`, `a+1`
  (induction on the Pell invariant `c² = 2a² + 2a + 1`);
* `pell_short_knee_mono`, `pell_long_knee_anti` — along the branch the short-leg budget
  is non-decreasing and the long-leg budget is non-increasing, at *every* context and
  gate: the two budgets squeeze towards each other monotonically;
* `pell_branch_gaps` — at context `64` and gate `0.985` the measured gaps are
  `10, 2, 1, 0`; by `pell_branch_budgets_meet` the fourth member `(696, 697, 985)` has
  *equal* budgets on both legs, both equal to the universal bound `13`.

So the universal short-leg bound of `13` is not merely attained: it is the common limit
at which the Pythagorean budget inversion of `pyth_knee_inversion` degenerates.

-- !-- Lab Notes -- !--
Hypothesizer:
 (B1) Along the near-isosceles branch the two leg budgets converge monotonically. [BOLD]
 (B2) They actually meet, at the universal value 13.                              [BOLD]
 (B3) Off the branch they cannot meet at every context (the gap reopens) — recorded
      as a future direction, not proved here.
Experimenter: B1 and B2 proved below, zero sorries.  Exact budgets at context 64,
gate 0.985 along the branch:
  k = 0 : (3,4,5)         short 9,  long 19   gap 10
  k = 1 : (20,21,29)      short 12, long 14   gap 2
  k = 2 : (119,120,169)   short 12, long 13   gap 1
  k = 3 : (696,697,985)   short 13, long 13   gap 0
Analyst: monotonicity is structural (it follows from the Pell invariant through
`kstar_geomProfile_mono_ratio`); the *meeting* is arithmetic and needs the exact
rational computation.  The gaps `10, 2, 1, 0` are strictly decreasing but not
geometric, which is the honest reading: the squeeze is fast at first and then
quantisation of the knee takes over.
Critic: `pell_branch_budgets_meet` is an equality of two independently computed knees,
each pinned by a pass/fail bracket, so it is not a definitional coincidence.
-/

namespace PythKnee

open AttentionBudget

/-! ## The Pell branch of near-isosceles triples -/

/-- The near-isosceles branch, as pairs `(leg, hypotenuse)`. -/
def pellPair : ℕ → ℤ × ℤ
  | 0 => (3, 5)
  | k + 1 => (3 * (pellPair k).1 + 2 * (pellPair k).2 + 1,
              4 * (pellPair k).1 + 3 * (pellPair k).2 + 2)

/-- Shorter leg of the `k`-th near-isosceles triple. -/
def pellLeg (k : ℕ) : ℤ := (pellPair k).1

/-- Hypotenuse of the `k`-th near-isosceles triple. -/
def pellHyp (k : ℕ) : ℤ := (pellPair k).2

lemma pellLeg_succ (k : ℕ) : pellLeg (k + 1) = 3 * pellLeg k + 2 * pellHyp k + 1 := rfl

lemma pellHyp_succ (k : ℕ) : pellHyp (k + 1) = 4 * pellLeg k + 3 * pellHyp k + 2 := rfl

/-- **The Pell invariant**, with positivity, by induction. -/
theorem pell_invariant (k : ℕ) :
    pellHyp k ^ 2 = 2 * pellLeg k ^ 2 + 2 * pellLeg k + 1 ∧ 3 ≤ pellLeg k ∧ 5 ≤ pellHyp k := by
  induction k with
  | zero => refine ⟨by norm_num [pellLeg, pellHyp, pellPair], by norm_num [pellLeg, pellPair],
      by norm_num [pellHyp, pellPair]⟩
  | succ m ih =>
      obtain ⟨hinv, ha, hc⟩ := ih
      refine ⟨?_, ?_, ?_⟩
      · rw [pellLeg_succ, pellHyp_succ]; linear_combination hinv
      · rw [pellLeg_succ]; linarith
      · rw [pellHyp_succ]; linarith

lemma pellLeg_pos (k : ℕ) : 0 < pellLeg k := by linarith [(pell_invariant k).2.1]

lemma pellHyp_pos (k : ℕ) : 0 < pellHyp k := by linarith [(pell_invariant k).2.2]

/-- Every member of the branch is a Pythagorean triple with consecutive legs. -/
theorem pell_isPythTriple (k : ℕ) : IsPythTriple (pellLeg k) (pellLeg k + 1) (pellHyp k) := by
  unfold IsPythTriple
  linear_combination -(pell_invariant k).1

/-! ## Monotone squeeze of the two leg ratios -/

theorem pell_short_ratio_strictMono (k : ℕ) :
    legRatio (pellLeg k) (pellHyp k) < legRatio (pellLeg (k + 1)) (pellHyp (k + 1)) := by
  obtain ⟨hinv, ha, hc⟩ := pell_invariant k
  have hcR : (0 : ℝ) < (pellHyp k : ℝ) := by exact_mod_cast pellHyp_pos k
  have hcR' : (0 : ℝ) < (pellHyp (k + 1) : ℝ) := by exact_mod_cast pellHyp_pos (k + 1)
  rw [legRatio, legRatio, div_lt_div_iff₀ hcR hcR']
  have key : pellLeg k * pellHyp (k + 1) < pellLeg (k + 1) * pellHyp k := by
    rw [pellLeg_succ, pellHyp_succ]; nlinarith
  exact_mod_cast key

theorem pell_long_ratio_strictAnti (k : ℕ) :
    legRatio (pellLeg (k + 1) + 1) (pellHyp (k + 1)) < legRatio (pellLeg k + 1) (pellHyp k) := by
  obtain ⟨hinv, ha, hc⟩ := pell_invariant k
  have hcR : (0 : ℝ) < (pellHyp k : ℝ) := by exact_mod_cast pellHyp_pos k
  have hcR' : (0 : ℝ) < (pellHyp (k + 1) : ℝ) := by exact_mod_cast pellHyp_pos (k + 1)
  rw [legRatio, legRatio, div_lt_div_iff₀ hcR' hcR]
  have key : (pellLeg (k + 1) + 1) * pellHyp k < (pellLeg k + 1) * pellHyp (k + 1) := by
    rw [pellLeg_succ, pellHyp_succ]; nlinarith
  exact_mod_cast key

/-- **B1 (short side).**  The short-leg budget is non-decreasing along the branch, at
every context length and gate. -/
theorem pell_short_knee_mono (k : ℕ) {n : ℕ} (hn : 0 < n) {τ : ℝ} (hτ : τ ≤ 1) :
    kstar (geomProfile (legRatio (pellLeg k) (pellHyp k))) n τ ≤
      kstar (geomProfile (legRatio (pellLeg (k + 1)) (pellHyp (k + 1)))) n τ :=
  kstar_geomProfile_mono_ratio (legRatio_pos (pellLeg_pos k) (pellHyp_pos k))
    (pell_short_ratio_strictMono k).le hn hτ

/-- **B1 (long side).**  The long-leg budget is non-increasing along the branch. -/
theorem pell_long_knee_anti (k : ℕ) {n : ℕ} (hn : 0 < n) {τ : ℝ} (hτ : τ ≤ 1) :
    kstar (geomProfile (legRatio (pellLeg (k + 1) + 1) (pellHyp (k + 1)))) n τ ≤
      kstar (geomProfile (legRatio (pellLeg k + 1) (pellHyp k))) n τ :=
  kstar_geomProfile_mono_ratio
    (legRatio_pos (by linarith [pellLeg_pos (k + 1)]) (pellHyp_pos (k + 1)))
    (pell_long_ratio_strictAnti k).le hn hτ

/-! ## The first four members, and the meeting point -/

theorem pell_values :
    (pellLeg 0, pellHyp 0) = (3, 5) ∧ (pellLeg 1, pellHyp 1) = (20, 29) ∧
      (pellLeg 2, pellHyp 2) = (119, 169) ∧ (pellLeg 3, pellHyp 3) = (696, 985) := by
  refine ⟨rfl, ?_, ?_, ?_⟩ <;> simp [pellLeg, pellHyp, pellPair]

lemma legRatio_119 : legRatio 119 169 = (119 / 169 : ℝ) := by norm_num [legRatio]
lemma legRatio_120 : legRatio 120 169 = (120 / 169 : ℝ) := by norm_num [legRatio]
lemma legRatio_697 : legRatio 697 985 = (697 / 985 : ℝ) := by norm_num [legRatio]

set_option maxRecDepth 40000 in
theorem knee_119_169 : kstar (geomProfile (legRatio 119 169)) 64 (985 / 1000) = 12 := by
  rw [legRatio_119]
  refine kstar_geomProfile_eq_of_bracket (by norm_num) (by norm_num) (by norm_num)
    (by norm_num) (by norm_num) (by norm_num) ?_ ?_
  · rw [le_div_iff₀ (by norm_num)]; norm_num
  · norm_num

set_option maxRecDepth 40000 in
theorem knee_120_169 : kstar (geomProfile (legRatio 120 169)) 64 (985 / 1000) = 13 := by
  rw [legRatio_120]
  refine kstar_geomProfile_eq_of_bracket (by norm_num) (by norm_num) (by norm_num)
    (by norm_num) (by norm_num) (by norm_num) ?_ ?_
  · rw [le_div_iff₀ (by norm_num)]; norm_num
  · norm_num

set_option maxRecDepth 40000 in
theorem knee_697_985 : kstar (geomProfile (legRatio 697 985)) 64 (985 / 1000) = 13 := by
  rw [legRatio_697]
  refine kstar_geomProfile_eq_of_bracket (by norm_num) (by norm_num) (by norm_num)
    (by norm_num) (by norm_num) (by norm_num) ?_ ?_
  · rw [le_div_iff₀ (by norm_num)]; norm_num
  · norm_num

/-- The short-leg budget along the branch, at context `64` and gate `0.985`. -/
theorem pell_short_budgets :
    kstar (geomProfile (legRatio (pellLeg 0) (pellHyp 0))) 64 (985 / 1000) = 9 ∧
      kstar (geomProfile (legRatio (pellLeg 1) (pellHyp 1))) 64 (985 / 1000) = 12 ∧
        kstar (geomProfile (legRatio (pellLeg 2) (pellHyp 2))) 64 (985 / 1000) = 12 ∧
          kstar (geomProfile (legRatio (pellLeg 3) (pellHyp 3))) 64 (985 / 1000) = 13 := by
  obtain ⟨h0, h1, h2, h3⟩ := pell_values
  simp only [Prod.mk.injEq] at h0 h1 h2 h3
  rw [h0.1, h0.2, h1.1, h1.2, h2.1, h2.2, h3.1, h3.2]
  exact ⟨knee_three_five, knee_twenty_twentynine, knee_119_169, pell_short_leg_knee_eq_thirteen⟩

/-- The long-leg budget along the branch, at context `64` and gate `0.985`. -/
theorem pell_long_budgets :
    kstar (geomProfile (legRatio (pellLeg 0 + 1) (pellHyp 0))) 64 (985 / 1000) = 19 ∧
      kstar (geomProfile (legRatio (pellLeg 1 + 1) (pellHyp 1))) 64 (985 / 1000) = 14 ∧
        kstar (geomProfile (legRatio (pellLeg 2 + 1) (pellHyp 2))) 64 (985 / 1000) = 13 ∧
          kstar (geomProfile (legRatio (pellLeg 3 + 1) (pellHyp 3))) 64 (985 / 1000) = 13 := by
  obtain ⟨h0, h1, h2, h3⟩ := pell_values
  simp only [Prod.mk.injEq] at h0 h1 h2 h3
  rw [h0.1, h0.2, h1.1, h1.2, h2.1, h2.2, h3.1, h3.2,
    show (3 : ℤ) + 1 = 4 from by norm_num, show (20 : ℤ) + 1 = 21 from by norm_num,
    show (119 : ℤ) + 1 = 120 from by norm_num, show (696 : ℤ) + 1 = 697 from by norm_num]
  exact ⟨knee_four_five, knee_twentyone_twentynine, knee_120_169, knee_697_985⟩

/-- **B1 quantified.**  The long-minus-short budget gaps along the branch are
`10, 2, 1, 0`: strictly decreasing to zero. -/
theorem pell_branch_gaps :
    (kstar (geomProfile (legRatio (pellLeg 0 + 1) (pellHyp 0))) 64 (985 / 1000) -
        kstar (geomProfile (legRatio (pellLeg 0) (pellHyp 0))) 64 (985 / 1000) = 10) ∧
      (kstar (geomProfile (legRatio (pellLeg 1 + 1) (pellHyp 1))) 64 (985 / 1000) -
        kstar (geomProfile (legRatio (pellLeg 1) (pellHyp 1))) 64 (985 / 1000) = 2) ∧
      (kstar (geomProfile (legRatio (pellLeg 2 + 1) (pellHyp 2))) 64 (985 / 1000) -
        kstar (geomProfile (legRatio (pellLeg 2) (pellHyp 2))) 64 (985 / 1000) = 1) ∧
      (kstar (geomProfile (legRatio (pellLeg 3 + 1) (pellHyp 3))) 64 (985 / 1000) -
        kstar (geomProfile (legRatio (pellLeg 3) (pellHyp 3))) 64 (985 / 1000) = 0) := by
  obtain ⟨s0, s1, s2, s3⟩ := pell_short_budgets
  obtain ⟨l0, l1, l2, l3⟩ := pell_long_budgets
  rw [s0, s1, s2, s3, l0, l1, l2, l3]
  exact ⟨rfl, rfl, rfl, rfl⟩

/-- **B2 — the budgets meet.**  At the fourth member of the Pell branch the short-leg
and long-leg budgets coincide, both equal to the universal bound `13`. -/
theorem pell_branch_budgets_meet :
    kstar (geomProfile (legRatio (pellLeg 3) (pellHyp 3))) 64 (985 / 1000) =
      kstar (geomProfile (legRatio (pellLeg 3 + 1) (pellHyp 3))) 64 (985 / 1000) ∧
    kstar (geomProfile (legRatio (pellLeg 3) (pellHyp 3))) 64 (985 / 1000) = 13 := by
  obtain ⟨-, -, -, s3⟩ := pell_short_budgets
  obtain ⟨-, -, -, l3⟩ := pell_long_budgets
  exact ⟨by rw [s3, l3], s3⟩

end PythKnee