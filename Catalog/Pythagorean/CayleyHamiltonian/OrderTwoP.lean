import Pythagorean.CayleyHamiltonian.OrderPQ

/-!
# Every connected Cayley graph of a group of order `2p` is hamiltonian

This is the base case `p = 2` of the order-`pq` programme.  Let `|G| = 2p` with `p` an odd
prime and let `S` generate `G`.  The Sylow `p`-subgroup `N = ⟨a⟩` has index `2`, the smallest
prime factor of `|G|`, hence is normal, and the counting corollary
`pq_isHamiltonian_of_le_ncard` of the reduction theorem applies as soon as `S` contains two
distinct nonidentity elements: a partial transversal of the *single* nontrivial coset of `N`
can contain at most one element.

The remaining configuration is a connection set with at most one nonidentity element `x`.
Then `S` generates `⟨x⟩`, so `x` has order `|G|` and the cyclic generator criterion
`isHamiltonian_of_orderOf_eq_card` finishes the proof (and the case `S ⊆ {1}` is impossible,
since `⟨1⟩` is not all of a group of order `2p ≥ 6`).

Main results:

* `CayleyHamiltonian.closure_le_zpowers_of_forall_eq` : if every nonidentity element of `S`
  equals `x`, then `S` generates at most `⟨x⟩`.
* `CayleyHamiltonian.isHamiltonian_of_card_eq_two_mul_prime` : **every connected Cayley graph
  of a group of order `2p` (`p` an odd prime) is hamiltonian.**
-/

namespace CayleyHamiltonian

open SimpleGraph

variable {G : Type*} [Group G] [Fintype G] [DecidableEq G] {S : Set G}

omit [Fintype G] [DecidableEq G] in
/-- If every nonidentity element of the connection set is equal to `x`, then the subgroup
generated by `S` is contained in the cyclic subgroup generated by `x`. -/
theorem closure_le_zpowers_of_forall_eq {x : G} (hx : ∀ s ∈ S, s ≠ 1 → s = x) :
    Subgroup.closure S ≤ Subgroup.zpowers x := by
  refine (Subgroup.closure_le _).2 fun s hs => ?_
  rcases eq_or_ne s 1 with rfl | hs1
  · exact one_mem _
  · rw [hx s hs hs1]
    exact Subgroup.mem_zpowers x

/-- **All connected Cayley graphs of a group of order `2p` (`p` an odd prime) are
hamiltonian.**  No hypothesis is imposed on the connection set other than that it generates
the group; in particular `G` may be the dihedral group of order `2p`. -/
theorem isHamiltonian_of_card_eq_two_mul_prime {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2)
    (hcard : Fintype.card G = 2 * p) (hconn : Subgroup.closure S = ⊤) :
    (cayleyGraph G S).IsHamiltonian := by
  classical
  haveI : Fact p.Prime := ⟨hp⟩
  have hp3 : 3 ≤ p := by
    have h2 := hp.two_le
    omega
  have hcard' : Fintype.card G = p * 2 := by omega
  have hGcard : Nat.card G = p * 2 := by rw [Nat.card_eq_fintype_card, hcard']
  have h3card : 3 ≤ Fintype.card G := by omega
  obtain ⟨a, ha⟩ : ∃ a : G, orderOf a = p :=
    exists_prime_orderOf_dvd_card p (by rw [hcard]; exact dvd_mul_left p 2)
  have hNcard : Nat.card (Subgroup.zpowers a) = p := by rw [Nat.card_zpowers, ha]
  have hindex : (Subgroup.zpowers a).index = 2 := by
    have h := Subgroup.card_mul_index (Subgroup.zpowers a)
    rw [hNcard, hGcard] at h
    exact Nat.eq_of_mul_eq_mul_left hp.pos h
  -- `2` is the smallest prime factor of `|G| = 2p`, so the index-`2` subgroup is normal
  have hminfac : (Nat.card G).minFac = 2 := by
    have hprime : (Nat.card G).minFac.Prime := Nat.minFac_prime (by rw [hGcard]; omega)
    have hle : (Nat.card G).minFac ≤ 2 :=
      Nat.minFac_le_of_dvd (le_refl 2) (by rw [hGcard]; exact dvd_mul_left 2 p)
    have := hprime.two_le
    omega
  haveI hnormal : (Subgroup.zpowers a).Normal :=
    Subgroup.normal_of_index_eq_minFac_card (by rw [hindex, hminfac])
  by_cases hS : 2 ≤ (S \ {1}).ncard
  · exact pq_isHamiltonian_of_le_ncard Nat.prime_two hp (fun h => hp2 h.symm) ha hnormal
      hcard' hconn hS
  -- at most one nonidentity element: `S` generates a cyclic group, which must be all of `G`
  push_neg at hS
  have hfin : (S \ {1} : Set G).Finite := Set.toFinite _
  have hone : ∀ x ∈ S \ {1}, ∀ y ∈ S \ {1}, x = y :=
    (Set.ncard_le_one hfin).1 (by omega)
  rcases Set.eq_empty_or_nonempty (S \ {1}) with hempty | ⟨x, hxmem⟩
  · -- `S ⊆ {1}` cannot generate a group of order `2p ≥ 6`
    exfalso
    have hall : ∀ s ∈ S, s = 1 := by
      intro s hs
      by_contra hs1
      exact absurd (Set.mem_diff_singleton.2 ⟨hs, hs1⟩) (by rw [hempty]; exact id)
    have hle : Subgroup.closure S ≤ (⊥ : Subgroup G) :=
      (Subgroup.closure_le _).2 fun s hs => by simp [hall s hs]
    rw [hconn, top_le_iff] at hle
    have : Nat.card G = 1 := by
      rw [← Subgroup.card_top (G := G), ← hle, Subgroup.card_bot]
    omega
  · obtain ⟨hxS, hx1⟩ := Set.mem_diff_singleton.1 hxmem
    have hall : ∀ s ∈ S, s ≠ 1 → s = x := fun s hs hs1 =>
      hone s (Set.mem_diff_singleton.2 ⟨hs, hs1⟩) x hxmem
    have htop : Subgroup.zpowers x = ⊤ := by
      have := closure_le_zpowers_of_forall_eq hall
      rw [hconn, top_le_iff] at this
      exact this
    have hordx : orderOf x = Fintype.card G := by
      have h := Nat.card_zpowers x
      rw [htop, Subgroup.card_top] at h
      rw [← h, Nat.card_eq_fintype_card]
    exact isHamiltonian_of_orderOf_eq_card hxS hordx h3card

end CayleyHamiltonian