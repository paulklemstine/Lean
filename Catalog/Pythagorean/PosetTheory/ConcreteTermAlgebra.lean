import Mathlib

/-!
# A Concrete First-Order Completion Prototype

This file gives a small, self-contained model of Knuth–Bendix style completion
over a first-order signature.  Objects are related by a list of equations; the
equational theory generated by a set of equations is its reflexive, symmetric,
transitive closure.  A completion state carries a list of pending equations `E`
and a list of oriented rules `R`; a completion step orients a pending equation
into a rule.  The central correctness result is that completion preserves the
generated equational theory: when completion finishes (`E = []`), the theory of
the rule set equals the theory of the original state.

## Main Results

* `EquationalClosure.congr_mem` — the closure depends only on the membership of
  the equation list.
* `concrete_completion_correct` — completion preserves the equational theory.
-/

namespace FOTerm

/-- A completion state: pending equations `E` and oriented rules `R`, each a list
    of ordered pairs of objects of type `V`. -/
structure ConcreteState (V : Type) where
  /-- Pending equations still to be oriented. -/
  E : List (V × V)
  /-- Oriented rewrite rules. -/
  R : List (V × V)

/-- Reinterpret a rule list as a list of equations. -/
def rulesToEqs {V : Type} (R : List (V × V)) : List (V × V) := R

/-- The equational theory generated by a list of equations. -/
inductive EquationalClosure {V : Type} (eqs : List (V × V)) : V → V → Prop
  | base {a b : V} (h : (a, b) ∈ eqs) : EquationalClosure eqs a b
  | refl (a : V) : EquationalClosure eqs a a
  | symm {a b : V} : EquationalClosure eqs a b → EquationalClosure eqs b a
  | trans {a b c : V} : EquationalClosure eqs a b → EquationalClosure eqs b c →
      EquationalClosure eqs a c

/-- The equational closure only depends on which pairs are present. -/
theorem EquationalClosure.congr_mem {V : Type} {eqs1 eqs2 : List (V × V)}
    (hmem : ∀ p, p ∈ eqs1 ↔ p ∈ eqs2) {a b : V}
    (h : EquationalClosure eqs1 a b) : EquationalClosure eqs2 a b := by
  induction h with
  | base hp => exact .base ((hmem _).mp hp)
  | refl a => exact .refl a
  | symm _ ih => exact .symm ih
  | trans _ _ ih1 ih2 => exact .trans ih1 ih2

/-- The equational theory generated by a completion state (rules and pending
    equations together). -/
def ConcreteState.eqTheory {V : Type} (S : ConcreteState V) : V → V → Prop :=
  EquationalClosure (rulesToEqs S.R ++ S.E)

/-- A single completion step orients the first pending equation into a rule. -/
inductive ConcreteStep (V : Type) : ConcreteState V → ConcreteState V → Prop
  | orient (a b : V) (rest R : List (V × V)) :
      ConcreteStep V ⟨(a, b) :: rest, R⟩ ⟨rest, (a, b) :: R⟩

/-- Completion derivations: reflexive–transitive closure of completion steps. -/
inductive ConcreteDerives (V : Type) : ConcreteState V → ConcreteState V → Prop
  | refl (S : ConcreteState V) : ConcreteDerives V S S
  | step {S T U : ConcreteState V} (h : ConcreteStep V S T)
      (hd : ConcreteDerives V T U) : ConcreteDerives V S U

/-- A completion step preserves the generated equational theory. -/
theorem ConcreteStep.eqTheory_iff {V : Type} {S T : ConcreteState V}
    (h : ConcreteStep V S T) (a b : V) : S.eqTheory a b ↔ T.eqTheory a b := by
  cases h with
  | orient a' b' rest R =>
    constructor <;> intro hab
    · exact EquationalClosure.congr_mem
        (by intro p; simp only [ConcreteState.eqTheory, rulesToEqs] at *;
            simp only [List.mem_append, List.mem_cons]; tauto) hab
    · exact EquationalClosure.congr_mem
        (by intro p; simp only [ConcreteState.eqTheory, rulesToEqs] at *;
            simp only [List.mem_append, List.mem_cons]; tauto) hab

/-- A completion derivation preserves the generated equational theory. -/
theorem ConcreteDerives.eqTheory_iff {V : Type} {S T : ConcreteState V}
    (h : ConcreteDerives V S T) (a b : V) : S.eqTheory a b ↔ T.eqTheory a b := by
  induction h with
  | refl S => rfl
  | step hstep _ ih => exact (hstep.eqTheory_iff a b).trans ih

/-- **Completion correctness**: once completion terminates (`T.E = []`), the
    equational theory of the resulting rule set equals the theory of the
    original state. -/
theorem concrete_completion_correct {V : Type} {S T : ConcreteState V}
    (h : ConcreteDerives V S T) (hfin : T.E = []) :
    ∀ a b, EquationalClosure (rulesToEqs T.R) a b ↔ S.eqTheory a b := by
  intro a b
  have hpres := (h.eqTheory_iff a b).symm
  have hT : T.eqTheory a b ↔ EquationalClosure (rulesToEqs T.R) a b := by
    simp only [ConcreteState.eqTheory, hfin, List.append_nil]
  exact hT.symm.trans hpres

end FOTerm