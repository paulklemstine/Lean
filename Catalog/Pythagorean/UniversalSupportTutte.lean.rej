+  have aux : ∀ n : ℕ, ∀ S : GroundSupport ι, S.ground.card = n → F.val S = G.val S := by
+    intro n
+    induction n using Nat.strong_induction_on with
+    | _ n ih =>
+      intro S hS
+      by_cases hne : S.ground.Nonempty
+      · let e := S.ground.min' hne
+        have he : e ∈ S.ground := S.ground.min'_mem hne
+        have hcard : (S.delete e).ground.card < S.ground.card := S.delete_ground_card_lt he
+        have hcard' : (S.contract e).ground.card < S.ground.card := S.contract_ground_card_lt he
+        rw [hS] at hcard hcard'
+        rw [F.rec_val S hne, G.rec_val S hne, hcoeff.1, hcoeff.2]
+        have ih1 := ih _ hcard (S.delete e) rfl
+        have ih2 := ih _ hcard' (S.contract e) rfl
+        rw [ih1, ih2]
+      · rw [F.base_val S hne, G.base_val S hne]
