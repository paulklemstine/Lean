# The Price of Universality V: an algebra of source classes

Research thread *Compression Beyond the Pigeonhole Bound*, Phase A, Question 1.

The price of universality of a class `S` is `log₂ Cₛ`, the logarithm of its
Shtarkov sum (`MachineLearning.UniversalRedundancy.Core`).  This file shows how
that price behaves under the two natural constructions on classes:

* **independent products** (the data splits into independent blocks, each
  modelled by its own class): the Shtarkov sum is *multiplicative*, so the price
  in bits is **additive** — `k` independent blocks cost exactly `k` times the
  per-block price;
* **unions / libraries of models** (a finite family of specialised classes,
  the true one unknown): the Shtarkov sum is *subadditive* and dominates each
  member, so the price of a library of `K` specialised decompressors exceeds the
  price of the most expensive member by at most `log₂ K` bits.

Together these give the structural answer to the research question: universality
costs additively over independent data, and merging specialised decompressors is
cheap (logarithmic in the size of the library), so a *library* of specialised
decompressors is essentially as good as knowing which one to use.

## Main results

* `SourceClass.prod`, `maxLik_prod`, `shtarkovSum_prod` — multiplicativity of
  the Shtarkov sum on independent products;
* `price_prod_eq` — additivity of the price in bits;
* `SourceClass.sigmaClass`, `shtarkovSum_sigma_le`, `le_shtarkovSum_sigma` —
  the library bounds `max_i C_i ≤ C ≤ ∑_i C_i`;
* `price_sigma_le` — `price(library) ≤ log₂ K + max_i price(class i)`;
* `average_price_sigma_le` — the same bound for the *average-case* price, via
  the bridge `klDiv_nml_le_logb_shtarkovSum`.

## Application keywords

universal compression, Shtarkov sum, model libraries, product sources,
minimax redundancy, price of universality
-/

import Catalog.NumberTheory.UniversalRedundancyAverage

open Finset Real

namespace UniversalRedundancy

namespace SourceClass

/-! ## Independent products: the price is additive in bits -/

variable {X₁ X₂ : Type*} [Fintype X₁] [Fintype X₂] {Θ₁ Θ₂ : Type*}

/-- The independent product of two source classes: the message splits into two
blocks, each generated by its own class, with independently chosen
parameters. -/
def prod (S₁ : SourceClass X₁ Θ₁) (S₂ : SourceClass X₂ Θ₂) :
    SourceClass (X₁ × X₂) (Θ₁ × Θ₂) where
  prob θ x := S₁.prob θ.1 x.1 * S₂.prob θ.2 x.2
  nonneg θ x := mul_nonneg (S₁.nonneg _ _) (S₂.nonneg _ _)
  sum_one θ := by
    rw [Fintype.sum_prod_type]
    calc ∑ x₁ : X₁, ∑ x₂ : X₂, S₁.prob θ.1 x₁ * S₂.prob θ.2 x₂
        = ∑ x₁ : X₁, S₁.prob θ.1 x₁ := by
          refine Finset.sum_congr rfl fun x₁ _ => ?_
          rw [← Finset.mul_sum, S₂.sum_one θ.2, mul_one]
      _ = 1 := S₁.sum_one θ.1

variable (S₁ : SourceClass X₁ Θ₁) (S₂ : SourceClass X₂ Θ₂)

/-- **The maximum likelihood of a product class factorises.**  This is the
analytic core of the additivity of the price of universality: it holds for
arbitrary (possibly infinite) parameter sets, where the suprema need not be
attained. -/
theorem maxLik_prod [Nonempty Θ₁] [Nonempty Θ₂] (x : X₁ × X₂) :
    (S₁.prod S₂).maxLik x = S₁.maxLik x.1 * S₂.maxLik x.2 := by
  have hP0 : 0 ≤ (S₁.prod S₂).maxLik x := (S₁.prod S₂).maxLik_nonneg x
  refine le_antisymm ?_ ?_
  · refine (S₁.prod S₂).maxLik_le fun θ => ?_
    exact mul_le_mul (S₁.le_maxLik θ.1 x.1) (S₂.le_maxLik θ.2 x.2)
      (S₂.nonneg θ.2 x.2) (S₁.maxLik_nonneg x.1)
  · -- first: `maxLik₁ * p₂ ≤ maxLik(prod)` for every parameter of the second class
    have step1 : ∀ θ₂ : Θ₂, S₁.maxLik x.1 * S₂.prob θ₂ x.2 ≤ (S₁.prod S₂).maxLik x := by
      intro θ₂
      rcases eq_or_lt_of_le (S₂.nonneg θ₂ x.2) with h | h
      · rw [← h, mul_zero]; exact hP0
      · have hall : ∀ θ₁ : Θ₁, S₁.prob θ₁ x.1 ≤ (S₁.prod S₂).maxLik x / S₂.prob θ₂ x.2 := by
          intro θ₁
          rw [le_div_iff₀ h]
          exact (S₁.prod S₂).le_maxLik (θ₁, θ₂) x
        have := S₁.maxLik_le hall
        rwa [le_div_iff₀ h] at this
    -- then take the supremum over the second class
    rcases eq_or_lt_of_le (S₁.maxLik_nonneg x.1) with h | h
    · rw [← h, zero_mul]; exact hP0
    · have hall : ∀ θ₂ : Θ₂, S₂.prob θ₂ x.2 ≤ (S₁.prod S₂).maxLik x / S₁.maxLik x.1 := by
        intro θ₂
        rw [le_div_iff₀ h]
        calc S₂.prob θ₂ x.2 * S₁.maxLik x.1
            = S₁.maxLik x.1 * S₂.prob θ₂ x.2 := by ring
          _ ≤ (S₁.prod S₂).maxLik x := step1 θ₂
      have := S₂.maxLik_le hall
      rwa [le_div_iff₀ h, mul_comm] at this

/-- **Multiplicativity of the Shtarkov sum.**  For independent blocks the
minimax redundancy factors multiply. -/
theorem shtarkovSum_prod [Nonempty Θ₁] [Nonempty Θ₂] :
    (S₁.prod S₂).shtarkovSum = S₁.shtarkovSum * S₂.shtarkovSum := by
  unfold shtarkovSum
  rw [Fintype.sum_prod_type]
  calc ∑ x₁ : X₁, ∑ x₂ : X₂, (S₁.prod S₂).maxLik (x₁, x₂)
      = ∑ x₁ : X₁, ∑ x₂ : X₂, S₁.maxLik x₁ * S₂.maxLik x₂ := by
        refine Finset.sum_congr rfl fun x₁ _ => Finset.sum_congr rfl fun x₂ _ => ?_
        exact S₁.maxLik_prod S₂ (x₁, x₂)
    _ = (∑ x₁ : X₁, S₁.maxLik x₁) * ∑ x₂ : X₂, S₂.maxLik x₂ := by
        rw [Finset.sum_mul_sum]

/-- **The price of universality is additive over independent blocks.**  In bits,
`price (S₁ ⊗ S₂) = price S₁ + price S₂`; in particular `k` independent blocks of
the same class cost exactly `k` times the per-block price, so universality can
never be amortised away by batching. -/
theorem price_prod_eq [Nonempty Θ₁] [Nonempty Θ₂] :
    logb 2 (S₁.prod S₂).shtarkovSum = logb 2 S₁.shtarkovSum + logb 2 S₂.shtarkovSum := by
  rw [S₁.shtarkovSum_prod S₂,
    Real.logb_mul (ne_of_gt S₁.shtarkovSum_pos) (ne_of_gt S₂.shtarkovSum_pos)]

/-! ## Libraries of models: the price of merging specialised decompressors -/

variable {X : Type*} [Fintype X] {ι : Type*} [Fintype ι] {Θ : ι → Type*}

/-- The union (library) of a finite family of source classes on the same
message space: a parameter is a pair (which class, which parameter of it). -/
def sigmaClass (S : (i : ι) → SourceClass X (Θ i)) : SourceClass X (Σ i, Θ i) where
  prob p x := (S p.1).prob p.2 x
  nonneg p x := (S p.1).nonneg p.2 x
  sum_one p := (S p.1).sum_one p.2

variable (S : (i : ι) → SourceClass X (Θ i))

instance instNonemptySigmaParam [Nonempty ι] [∀ i, Nonempty (Θ i)] :
    Nonempty (Σ i, Θ i) := ⟨⟨Classical.arbitrary ι, Classical.arbitrary _⟩⟩

omit [Fintype ι] in
/-- Each member class is dominated by the library. -/
theorem maxLik_le_maxLik_sigma [∀ i, Nonempty (Θ i)] [Nonempty ι] (i : ι) (x : X) :
    (S i).maxLik x ≤ (sigmaClass S).maxLik x :=
  (S i).maxLik_le fun θ => (sigmaClass S).le_maxLik ⟨i, θ⟩ x

/-- The library's maximum likelihood is at most the sum of the members'. -/
theorem maxLik_sigma_le [∀ i, Nonempty (Θ i)] [Nonempty ι] (x : X) :
    (sigmaClass S).maxLik x ≤ ∑ i, (S i).maxLik x := by
  refine (sigmaClass S).maxLik_le fun p => ?_
  calc (sigmaClass S).prob p x ≤ (S p.1).maxLik x := (S p.1).le_maxLik p.2 x
    _ ≤ ∑ i, (S i).maxLik x :=
        Finset.single_le_sum (f := fun i => (S i).maxLik x)
          (fun i _ => (S i).maxLik_nonneg x) (Finset.mem_univ p.1)

omit [Fintype ι] in
/-- **Lower bound for a library**: it is at least as expensive as any of its
members. -/
theorem le_shtarkovSum_sigma [∀ i, Nonempty (Θ i)] [Nonempty ι] (i : ι) :
    (S i).shtarkovSum ≤ (sigmaClass S).shtarkovSum :=
  Finset.sum_le_sum fun x _ => maxLik_le_maxLik_sigma S i x

/-- **Subadditivity**: the Shtarkov sum of a library is at most the sum of the
Shtarkov sums of its members. -/
theorem shtarkovSum_sigma_le [∀ i, Nonempty (Θ i)] [Nonempty ι] :
    (sigmaClass S).shtarkovSum ≤ ∑ i, (S i).shtarkovSum := by
  unfold shtarkovSum
  rw [Finset.sum_comm]
  exact Finset.sum_le_sum fun x _ => maxLik_sigma_le S x

/-- **The price of a library of specialised decompressors.**  If each of `K`
specialised classes costs at most `log₂ B` bits of universality, then a single
decompressor universal for *all* of them costs at most `log₂ K + log₂ B` bits:
merging specialised models is cheap.  (And by `le_shtarkovSum_sigma` it costs at
least as much as the most expensive member, so the estimate is tight up to the
`log₂ K` naming term.) -/
theorem price_sigma_le [∀ i, Nonempty (Θ i)] [Nonempty ι] {B : ℝ}
    (hB : ∀ i, (S i).shtarkovSum ≤ B) :
    logb 2 (sigmaClass S).shtarkovSum ≤ logb 2 (Fintype.card ι) + logb 2 B := by
  have hBpos : 0 < B := lt_of_lt_of_le (S (Classical.arbitrary ι)).shtarkovSum_pos
    (hB (Classical.arbitrary ι))
  have hcard : (0 : ℝ) < (Fintype.card ι : ℝ) := by exact_mod_cast Fintype.card_pos
  have hsum : (sigmaClass S).shtarkovSum ≤ (Fintype.card ι : ℝ) * B := by
    calc (sigmaClass S).shtarkovSum ≤ ∑ i, (S i).shtarkovSum := shtarkovSum_sigma_le S
      _ ≤ ∑ _i : ι, B := Finset.sum_le_sum fun i _ => hB i
      _ = (Fintype.card ι : ℝ) * B := by
          rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
  have := Real.logb_le_logb_of_le (b := 2) (by norm_num) (sigmaClass S).shtarkovSum_pos hsum
  rwa [Real.logb_mul (ne_of_gt hcard) (ne_of_gt hBpos)] at this

/-- **Average-case version of the library bound.**  One universal code (the NML
code of the library) is within `log₂ K + log₂ B` bits, on average, of the code
tailored to the true source, whichever of the `K` specialised classes it comes
from. -/
theorem average_price_sigma_le [∀ i, Nonempty (Θ i)] [Nonempty ι] {B : ℝ}
    (hB : ∀ i, (S i).shtarkovSum ≤ B) (hpos : ∀ x, 0 < (sigmaClass S).maxLik x)
    (p : Σ i, Θ i) :
    klDiv ((sigmaClass S).prob p) (sigmaClass S).nml
      ≤ logb 2 (Fintype.card ι) + logb 2 B :=
  le_trans ((sigmaClass S).klDiv_nml_le_logb_shtarkovSum hpos p) (price_sigma_le S hB)

end SourceClass

end UniversalRedundancy