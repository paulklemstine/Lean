import Mathlib

/-!
# The derived-modulus no-go: polynomial moduli carry no factor signal

This file formalises the arithmetic core of the MULTIMOD experiment
(`40_DerivedModulus_NoGo.md`).  The experiment asked whether invariants of a
*derived modulus* `M = f(N)` — with `f` a fixed integer polynomial such as
`X ± 1`, `X² ± 1`, the third cyclotomic polynomial `Φ₃ = X² + X + 1`, or
`2X ± 1` — can carry information about the factorisation `N = p·q`.  The
empirical answer was "no"; the theorems below explain *why* it must be no.

The physical picture is a **superselection rule**: an observable built from a
polynomial in the "state" `N` lives in the algebra generated by `N` itself, so
it cannot resolve the internal degeneracy (the factorisation fiber) of `N`.
The arithmetic mechanism is the elementary but decisive identity
`N ∣ f(N) - f(0)`.

## Main results

* `Physics.DerivedModulus.gcd_eval_eq_gcd_const` :
  `gcd(N, f(N)) = gcd(N, f(0))` — the entire overlap between `N` and any
  derived modulus is *frozen at the constant term*, uniformly in `N`.
* `Physics.DerivedModulus.gcd_eval_dvd_const` : that overlap divides `f(0)`,
  hence is bounded by `|f(0)|` independently of `N`.
* `Physics.DerivedModulus.sharedPrimes_finite` : the set of primes that can
  *ever* be shared by `N` and `f(N)` (over all `N`) is finite (barrier 1/5).
* `Physics.DerivedModulus.no_factor_of_semiprime` : for a unit constant term,
  the gcd attack on the derived modulus of a semiprime never returns a factor.
* `Physics.DerivedModulus.family_coprime` : the six moduli actually tested in
  MULTIMOD are coprime to `N` for **every** integer `N`.
* `Physics.DerivedModulus.family_pairwise_gcd_le_five` : any two distinct
  members of the family share at most `5` — a resultant bound, again uniform
  in `N`.  Sharpness witnesses are given.
* `Physics.DerivedModulus.minFac_family_pred/succ` : the degeneracy observed
  in the experiment, `lpf(N ± 1) = 2` for odd `N`.
-/

namespace Physics.DerivedModulus

open Polynomial

/-! ## Bézout certificates for integer gcds -/

/-- If some integer combination of `a` and `b` equals `c`, then `gcd a b ∣ c`.
This is the certificate format used for all the uniform bounds below. -/
theorem gcd_dvd_of_comb {a b c u v : ℤ} (h : u * a + v * b = c) :
    ((Int.gcd a b : ℤ)) ∣ c := by
  have h1 : (Int.gcd a b : ℤ) ∣ a := Int.gcd_dvd_left a b
  have h2 : (Int.gcd a b : ℤ) ∣ b := Int.gcd_dvd_right a b
  exact h ▸ dvd_add (h1.mul_left u) (h2.mul_left v)

/-- A Bézout certificate for `1` proves coprimality. -/
theorem gcd_eq_one_of_bezout {a b u v : ℤ} (h : u * a + v * b = 1) :
    Int.gcd a b = 1 := by
  have := gcd_dvd_of_comb h
  have : (Int.gcd a b) ∣ 1 := by exact_mod_cast this
  exact Nat.dvd_one.mp this

/-- A Bézout certificate for a natural number `c` bounds the gcd by `c`. -/
theorem gcd_dvd_nat_of_comb {a b u v : ℤ} {c : ℕ} (h : u * a + v * b = (c : ℤ)) :
    Int.gcd a b ∣ c := by
  have := gcd_dvd_of_comb h
  exact_mod_cast this

/-! ## The polynomial barrier -/

variable (f : ℤ[X])

/-- **The mechanism.** `N` divides `f(N) - f(0)` for every integer polynomial `f`.
Everything in this file is a consequence of this single divisibility. -/
theorem dvd_eval_sub_eval_zero (N : ℤ) : N ∣ f.eval N - f.eval 0 := by
  simpa using Polynomial.sub_dvd_eval_sub N 0 f

/-- **Frozen overlap.** The gcd of `N` with the derived modulus `f(N)` does not
depend on `N` at all beyond the value `f(0)`: it equals `gcd(N, f(0))`. -/
theorem gcd_eval_eq_gcd_const (N : ℤ) :
    Int.gcd N (f.eval N) = Int.gcd N (f.eval 0) := by
  have h : N ∣ f.eval N - f.eval 0 := dvd_eval_sub_eval_zero f N
  have key : ∀ u v : ℤ, N ∣ u - v → Int.gcd N u ∣ Int.gcd N v := by
    intro u v huv
    have h1 : (Int.gcd N u : ℤ) ∣ N := Int.gcd_dvd_left N u
    have h2 : (Int.gcd N u : ℤ) ∣ u := Int.gcd_dvd_right N u
    have h3 : (Int.gcd N u : ℤ) ∣ u - v := h1.trans huv
    have h4 : (Int.gcd N u : ℤ) ∣ v := by simpa using dvd_sub h2 h3
    exact Int.dvd_gcd h1 h4
  exact Nat.dvd_antisymm (key _ _ h) (key _ _ (by simpa using dvd_neg.mpr h))

/-- Any common divisor of `N` and of the derived modulus `f(N)` already divides
the constant term `f(0)`. -/
theorem dvd_const_of_common_dvd {N d : ℤ} (h1 : d ∣ N) (h2 : d ∣ f.eval N) :
    d ∣ f.eval 0 := by
  have h3 : d ∣ f.eval N - f.eval 0 := h1.trans (dvd_eval_sub_eval_zero f N)
  simpa using dvd_sub h2 h3

/-- **Uniform bound.** The overlap between `N` and its derived modulus divides
`|f(0)|`, uniformly in `N`. -/
theorem gcd_eval_dvd_const (N : ℤ) :
    Int.gcd N (f.eval N) ∣ (f.eval 0).natAbs := by
  rw [gcd_eval_eq_gcd_const]
  exact Int.natAbs_dvd_natAbs.mpr (Int.gcd_dvd_right N (f.eval 0))

/-- If the constant term is a unit, the derived modulus is coprime to `N`
for every `N`: **the gcd attack on `f(N)` returns `1`, always.** -/
theorem gcd_eval_eq_one (h0 : f.eval 0 = 1 ∨ f.eval 0 = -1) (N : ℤ) :
    Int.gcd N (f.eval N) = 1 := by
  have hd : Int.gcd N (f.eval N) ∣ (f.eval 0).natAbs := gcd_eval_dvd_const f N
  rcases h0 with h | h <;> rw [h] at hd <;> simpa using Nat.dvd_one.mp (by simpa using hd)

/-- **Barrier 1/5, set-theoretic form.** Over *all* integers `N`, only finitely
many primes can ever be shared between `N` and its derived modulus `f(N)`:
they all divide the fixed constant `f(0)`. -/
theorem sharedPrimes_finite (h0 : f.eval 0 ≠ 0) :
    {p : ℕ | p.Prime ∧ ∃ N : ℤ, (p : ℤ) ∣ N ∧ (p : ℤ) ∣ f.eval N}.Finite := by
  have hsub : {p : ℕ | p.Prime ∧ ∃ N : ℤ, (p : ℤ) ∣ N ∧ (p : ℤ) ∣ f.eval N}
      ⊆ ((f.eval 0).natAbs.divisors : Finset ℕ) := by
    rintro p ⟨-, N, hN, hfN⟩
    have hp : (p : ℤ) ∣ f.eval 0 := dvd_const_of_common_dvd f hN hfN
    have : p ∣ (f.eval 0).natAbs := by
      simpa using Int.natAbs_dvd_natAbs.mpr hp
    exact Nat.mem_divisors.mpr ⟨this, Int.natAbs_ne_zero.mpr h0⟩
  exact Set.Finite.subset (Finset.finite_toSet _) hsub

/-- **Headline no-go.** For a semiprime `N = p·q` and any derived modulus with
unit constant term, neither prime factor divides the derived modulus, so no
invariant of `f(N)` computed by divisibility can expose `p` or `q`. -/
theorem no_factor_of_semiprime {p q : ℕ} (hp : p.Prime)
    (h0 : f.eval 0 = 1 ∨ f.eval 0 = -1) :
    ¬ ((p : ℤ) ∣ f.eval ((p : ℤ) * (q : ℤ))) := by
  intro hdvd
  have hdN : (p : ℤ) ∣ (p : ℤ) * (q : ℤ) := Dvd.intro _ rfl
  have := dvd_const_of_common_dvd f hdN hdvd
  rcases h0 with h | h <;> rw [h] at this
  · exact hp.one_lt.ne' (by exact_mod_cast Int.eq_one_of_dvd_one (by positivity) this)
  · have : (p : ℤ) ∣ 1 := (dvd_neg.mp this)
    exact hp.one_lt.ne' (by exact_mod_cast Int.eq_one_of_dvd_one (by positivity) this)

/-! ## The MULTIMOD family

The six moduli actually tested: `N-1`, `N+1`, `N²+1`, `Φ₃(N) = N²+N+1`,
`2N-1`, `2N+1`. -/

/-- The derived moduli tested in the MULTIMOD experiment. -/
def family : Fin 6 → ℤ → ℤ
  | 0 => fun N => N - 1
  | 1 => fun N => N + 1
  | 2 => fun N => N ^ 2 + 1
  | 3 => fun N => N ^ 2 + N + 1
  | 4 => fun N => 2 * N - 1
  | 5 => fun N => 2 * N + 1

/-- **Verified claim 1 of the experiment**: `gcd(N, M) = 1` for every derived
modulus `M` in the family and *every* integer `N` — no exceptions, no
"generic `N`" caveat. -/
theorem family_coprime (i : Fin 6) (N : ℤ) : Int.gcd N (family i N) = 1 := by
  fin_cases i <;> simp only [family] <;>
    [ exact gcd_eq_one_of_bezout (u := 1) (v := -1) (by ring);
      exact gcd_eq_one_of_bezout (u := -1) (v := 1) (by ring);
      exact gcd_eq_one_of_bezout (u := -N) (v := 1) (by ring);
      exact gcd_eq_one_of_bezout (u := -N - 1) (v := 1) (by ring);
      exact gcd_eq_one_of_bezout (u := 2) (v := -1) (by ring);
      exact gcd_eq_one_of_bezout (u := -2) (v := 1) (by ring) ]

/-- Consequence for semiprimes: no prime factor of `N` divides any derived
modulus of the family. -/
theorem family_no_prime_factor {p : ℕ} (hp : p.Prime) (i : Fin 6) (N : ℤ)
    (hpN : (p : ℤ) ∣ N) : ¬ ((p : ℤ) ∣ family i N) := by
  intro hpM
  have hd : (p : ℤ) ∣ (Int.gcd N (family i N) : ℤ) := by
    exact_mod_cast Int.dvd_gcd hpN hpM
  rw [family_coprime i N] at hd
  have : (p : ℤ) ∣ 1 := by simpa using hd
  exact hp.one_lt.ne' (by exact_mod_cast Int.eq_one_of_dvd_one (by positivity) this)

/-! ### Pairwise resultant bounds

Distinct members of the family are almost coprime to each other as well: the
common part divides a small constant (a resultant), again uniformly in `N`. -/

theorem gcd_pred_succ (N : ℤ) : Int.gcd (N - 1) (N + 1) ∣ 2 :=
  gcd_dvd_nat_of_comb (u := -1) (v := 1) (by push_cast; ring)

theorem gcd_pred_sq_succ (N : ℤ) : Int.gcd (N - 1) (N ^ 2 + 1) ∣ 2 :=
  gcd_dvd_nat_of_comb (u := -(N + 1)) (v := 1) (by push_cast; ring)

theorem gcd_pred_cyc3 (N : ℤ) : Int.gcd (N - 1) (N ^ 2 + N + 1) ∣ 3 :=
  gcd_dvd_nat_of_comb (u := -(N + 2)) (v := 1) (by push_cast; ring)

theorem gcd_pred_two_pred (N : ℤ) : Int.gcd (N - 1) (2 * N - 1) ∣ 1 :=
  gcd_dvd_nat_of_comb (u := -2) (v := 1) (by push_cast; ring)

theorem gcd_pred_two_succ (N : ℤ) : Int.gcd (N - 1) (2 * N + 1) ∣ 3 :=
  gcd_dvd_nat_of_comb (u := -2) (v := 1) (by push_cast; ring)

theorem gcd_succ_sq_succ (N : ℤ) : Int.gcd (N + 1) (N ^ 2 + 1) ∣ 2 :=
  gcd_dvd_nat_of_comb (u := -(N - 1)) (v := 1) (by push_cast; ring)

theorem gcd_succ_cyc3 (N : ℤ) : Int.gcd (N + 1) (N ^ 2 + N + 1) ∣ 1 :=
  gcd_dvd_nat_of_comb (u := -N) (v := 1) (by push_cast; ring)

theorem gcd_succ_two_pred (N : ℤ) : Int.gcd (N + 1) (2 * N - 1) ∣ 3 :=
  gcd_dvd_nat_of_comb (u := 2) (v := -1) (by push_cast; ring)

theorem gcd_succ_two_succ (N : ℤ) : Int.gcd (N + 1) (2 * N + 1) ∣ 1 :=
  gcd_dvd_nat_of_comb (u := 2) (v := -1) (by push_cast; ring)

theorem gcd_sq_succ_cyc3 (N : ℤ) : Int.gcd (N ^ 2 + 1) (N ^ 2 + N + 1) ∣ 1 := by
  refine gcd_dvd_nat_of_comb (u := N + 1) (v := -N) ?_
  push_cast; ring

theorem gcd_sq_succ_two_pred (N : ℤ) : Int.gcd (N ^ 2 + 1) (2 * N - 1) ∣ 5 :=
  gcd_dvd_nat_of_comb (u := 4) (v := -(2 * N + 1)) (by push_cast; ring)

theorem gcd_sq_succ_two_succ (N : ℤ) : Int.gcd (N ^ 2 + 1) (2 * N + 1) ∣ 5 :=
  gcd_dvd_nat_of_comb (u := 4) (v := -(2 * N - 1)) (by push_cast; ring)

theorem gcd_cyc3_two_pred (N : ℤ) : Int.gcd (N ^ 2 + N + 1) (2 * N - 1) ∣ 7 :=
  gcd_dvd_nat_of_comb (u := 4) (v := -(2 * N + 3)) (by push_cast; ring)

theorem gcd_cyc3_two_succ (N : ℤ) : Int.gcd (N ^ 2 + N + 1) (2 * N + 1) ∣ 3 :=
  gcd_dvd_nat_of_comb (u := 4) (v := -(2 * N + 1)) (by push_cast; ring)

theorem gcd_two_pred_two_succ (N : ℤ) : Int.gcd (2 * N - 1) (2 * N + 1) ∣ 1 :=
  gcd_dvd_nat_of_comb (u := N) (v := 1 - N) (by push_cast; ring)

/-- **Uniform pairwise bound.** Any two distinct derived moduli of the MULTIMOD
family share a factor of at most `7`, for every integer `N`.  In particular the
"second modulus" contributes no unbounded new arithmetic tied to `N`. -/
theorem family_pairwise_gcd_le_seven (i j : Fin 6) (hij : i ≠ j) (N : ℤ) :
    Int.gcd (family i N) (family j N) ≤ 7 := by
  have bound : ∀ {a b : ℤ} {c : ℕ}, 0 < c → c ≤ 7 → Int.gcd a b ∣ c →
      Int.gcd a b ≤ 7 := by
    intro a b c hc hc7 hdvd
    exact le_trans (Nat.le_of_dvd hc hdvd) hc7
  fin_cases i <;> fin_cases j <;> simp only [family] <;> first
    | exact absurd rfl hij
    | exact bound (by norm_num) (by norm_num) (gcd_pred_succ N)
    | exact bound (by norm_num) (by norm_num) (gcd_pred_sq_succ N)
    | exact bound (by norm_num) (by norm_num) (gcd_pred_cyc3 N)
    | exact bound (by norm_num) (by norm_num) (gcd_pred_two_pred N)
    | exact bound (by norm_num) (by norm_num) (gcd_pred_two_succ N)
    | exact bound (by norm_num) (by norm_num) (gcd_succ_sq_succ N)
    | exact bound (by norm_num) (by norm_num) (gcd_succ_cyc3 N)
    | exact bound (by norm_num) (by norm_num) (gcd_succ_two_pred N)
    | exact bound (by norm_num) (by norm_num) (gcd_succ_two_succ N)
    | exact bound (by norm_num) (by norm_num) (gcd_sq_succ_cyc3 N)
    | exact bound (by norm_num) (by norm_num) (gcd_sq_succ_two_pred N)
    | exact bound (by norm_num) (by norm_num) (gcd_sq_succ_two_succ N)
    | exact bound (by norm_num) (by norm_num) (gcd_cyc3_two_pred N)
    | exact bound (by norm_num) (by norm_num) (gcd_cyc3_two_succ N)
    | exact bound (by norm_num) (by norm_num) (gcd_two_pred_two_succ N)
    | (rw [Int.gcd_comm]; first
        | exact bound (by norm_num) (by norm_num) (gcd_pred_succ N)
        | exact bound (by norm_num) (by norm_num) (gcd_pred_sq_succ N)
        | exact bound (by norm_num) (by norm_num) (gcd_pred_cyc3 N)
        | exact bound (by norm_num) (by norm_num) (gcd_pred_two_pred N)
        | exact bound (by norm_num) (by norm_num) (gcd_pred_two_succ N)
        | exact bound (by norm_num) (by norm_num) (gcd_succ_sq_succ N)
        | exact bound (by norm_num) (by norm_num) (gcd_succ_cyc3 N)
        | exact bound (by norm_num) (by norm_num) (gcd_succ_two_pred N)
        | exact bound (by norm_num) (by norm_num) (gcd_succ_two_succ N)
        | exact bound (by norm_num) (by norm_num) (gcd_sq_succ_cyc3 N)
        | exact bound (by norm_num) (by norm_num) (gcd_sq_succ_two_pred N)
        | exact bound (by norm_num) (by norm_num) (gcd_sq_succ_two_succ N)
        | exact bound (by norm_num) (by norm_num) (gcd_cyc3_two_pred N)
        | exact bound (by norm_num) (by norm_num) (gcd_cyc3_two_succ N)
        | exact bound (by norm_num) (by norm_num) (gcd_two_pred_two_succ N))

/-- Sharpness of the pairwise bounds: the resultant `5` between `N²+1` and
`2N+1` is attained at `N = 2`, and the resultant `3` between `Φ₃` and `N-1` is
attained at `N = 4`.  So the bounds above cannot be improved to `1`. -/
theorem pairwise_bounds_sharp :
    Int.gcd ((2 : ℤ) ^ 2 + 1) (2 * (2 : ℤ) + 1) = 5 ∧
    Int.gcd ((4 : ℤ) - 1) ((4 : ℤ) ^ 2 + 4 + 1) = 3 := by
  constructor <;> decide

/-! ## Degeneracy of the linear moduli (claim 4)

For odd `N` the moduli `N ± 1` are even, so their least prime factor is `2`:
the "invariant" `lpf` is constant on the whole odd input class. -/

theorem minFac_succ_eq_two {N : ℕ} (hN : Odd N) : (N + 1).minFac = 2 := by
  refine (Nat.minFac_eq_two_iff _).mpr ?_
  obtain ⟨k, rfl⟩ := hN
  exact ⟨k + 1, by ring⟩

theorem minFac_pred_eq_two {N : ℕ} (hN : Odd N) (h3 : 3 ≤ N) : (N - 1).minFac = 2 := by
  refine (Nat.minFac_eq_two_iff _).mpr ?_
  obtain ⟨k, rfl⟩ := hN
  exact ⟨k, by omega⟩

/-- The degeneracy is total on odd semiprimes: `lpf(N-1) = lpf(N+1) = 2`, so
these two invariants are *constant* on the entire set of odd `N ≥ 3` and can
carry zero bits about the factorisation. -/
theorem lpf_linear_moduli_constant {p q : ℕ} (hp : Odd p) (hq : Odd q)
    (hp3 : 3 ≤ p) (hq3 : 3 ≤ q) :
    (p * q + 1).minFac = 2 ∧ (p * q - 1).minFac = 2 := by
  have hodd : Odd (p * q) := hp.mul hq
  have h3 : 3 ≤ p * q := le_trans hp3 (Nat.le_mul_of_pos_right p (by omega))
  exact ⟨minFac_succ_eq_two hodd, minFac_pred_eq_two hodd h3⟩

/-- The quadratic modulus degenerates too: for odd `N`, `N² + 1 ≡ 2 (mod 8)`,
so its `2`-adic valuation is exactly `1` and its least prime factor is again
constant. -/
theorem sqSucc_mod_eight {N : ℕ} (hN : Odd N) : (N ^ 2 + 1) % 8 = 2 := by
  obtain ⟨k, rfl⟩ := hN
  obtain ⟨m, hm⟩ := Nat.even_mul_succ_self k
  have hexp : (2 * k + 1) ^ 2 + 1 = 4 * (k * (k + 1)) + 2 := by ring
  rw [hexp, hm]
  omega

theorem minFac_sqSucc_eq_two {N : ℕ} (hN : Odd N) : (N ^ 2 + 1).minFac = 2 := by
  refine (Nat.minFac_eq_two_iff _).mpr ?_
  have := sqSucc_mod_eight hN
  omega

/-! ## Coarse-graining (claims 2/3): derived data never sees past `N`

The experiment found `C(M)` to be a function of `N`, with the apparent
correlation to `p` and `p+q` explained away as the `N`-confound.  The exact
arithmetic statement behind this is that a polynomial modulus *transports
congruences*: knowing `N` modulo `m` already determines `f(N)` modulo `m`.  So
every residue-type invariant of the derived modulus is a function of a residue
of `N` — a coarse-graining of `N`, never a refinement, and in particular never
a function of the factorisation. -/

/-- **Congruence transport.**  `N ≡ N' (mod m)` implies `f(N) ≡ f(N') (mod m)`
for every integer polynomial `f`. -/
theorem eval_modEq_of_modEq (f : ℤ[X]) {N N' m : ℤ} (h : N ≡ N' [ZMOD m]) :
    f.eval N ≡ f.eval N' [ZMOD m] := by
  have hm : m ∣ N - N' := h.symm.dvd
  have hsub : (N - N') ∣ f.eval N - f.eval N' := Polynomial.sub_dvd_eval_sub N N' f
  have hd : m ∣ f.eval N' - f.eval N := by
    simpa using dvd_neg.mpr (hm.trans hsub)
  exact Int.modEq_iff_dvd.mpr hd

/-- **Coarse-graining of the whole family.**  Two inputs congruent modulo `m`
produce derived moduli congruent modulo `m`, simultaneously for all six
MULTIMOD moduli.  Hence any invariant of the derived moduli that is computed
from residues modulo `m` collides on the entire congruence class of `N`, and
cannot separate semiprimes inside it. -/
theorem family_modEq_of_modEq (i : Fin 6) {N N' m : ℤ} (h : N ≡ N' [ZMOD m]) :
    family i N ≡ family i N' [ZMOD m] := by
  fin_cases i <;> simp only [family]
  · exact h.sub_right 1
  · exact h.add_right 1
  · exact (h.pow 2).add_right 1
  · exact ((h.pow 2).add h).add_right 1
  · exact (h.mul_left 2).sub_right 1
  · exact (h.mul_left 2).add_right 1

end Physics.DerivedModulus