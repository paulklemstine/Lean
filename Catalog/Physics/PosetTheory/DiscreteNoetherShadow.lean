import Mathlib

/-!
# Discrete Noether Theory: Forward Direction

This file establishes the forward direction of discrete Noether's theorem
for variational integrators. Given a discrete Lagrangian `Ld : Q → Q → ℝ`,
a momentum observable `p`, and a first-variation function `V` measuring
symmetry breaking, we prove that infinitesimal invariance of `Ld` implies
conservation of the discrete momentum along all discrete Euler–Lagrange trajectories.

## Main definitions

* `DiscreteNoether.MomentumConservedOnTrajectories` — momentum is constant along DEL orbits
* `DiscreteNoether.InfinitesimallyInvariant` — the pairwise symmetry variation vanishes
* `DiscreteNoether.RichDiscreteFlow` — every pair `(q₀, q₁)` is realized within some
  DEL trajectory segment
* `DiscreteNoether.SymmetryDefectZeroOnTrajectories` — symmetry defect vanishes on-shell

## Main results

* `DiscreteNoether.discrete_momentum_conserved` — forward Noether: invariance → conservation
* `DiscreteNoether.discrete_momentum_conserved_range` — conservation holds for all
  trajectory segments within a given range

## References

* Marsden, West: *Discrete mechanics and variational integrators*, Acta Numerica 10 (2001)
-/

namespace DiscreteNoether

variable {Q : Type*}

/-- The discrete momentum observable `p : Q → Q → ℝ` is conserved along
all discrete Euler–Lagrange trajectories. That is, for every DEL triple
`(q₀, q₁, q₂)`, we have `p q₁ q₂ = p q₀ q₁`. -/
def MomentumConservedOnTrajectories (DEL : Q → Q → Q → Prop) (p : Q → Q → ℝ) : Prop :=
  ∀ ⦃q₀ q₁ q₂ : Q⦄, DEL q₀ q₁ q₂ → p q₁ q₂ = p q₀ q₁

/-- The pairwise first-order variation of the discrete Lagrangian under
the infinitesimal generator vanishes on all pairs. This expresses that
`Ld` is invariant under the one-parameter group generated by `X`:

  `V(q₀, q₁) := d/dε|₀ Ld(q₀ + εX(q₀), q₁ + εX(q₁)) = 0`

for all configuration pairs `(q₀, q₁)`. -/
def InfinitesimallyInvariant (V : Q → Q → ℝ) : Prop :=
  ∀ q₀ q₁ : Q, V q₀ q₁ = 0

/-- A discrete Euler–Lagrange flow is *rich* if for every pair `(q₀, q₁)`
of configuration points, there exists some predecessor `qprev` such that
`(qprev, q₀, q₁)` is a DEL triple. This ensures that every two-point
segment is realized within some trajectory, making conservation data
sufficient to probe the symmetry defect at every pair. -/
def RichDiscreteFlow (DEL : Q → Q → Q → Prop) : Prop :=
  ∀ q₀ q₁ : Q, ∃ qprev, DEL qprev q₀ q₁

/-- The symmetry defect vanishes on all DEL trajectory segments. -/
def SymmetryDefectZeroOnTrajectories (DEL : Q → Q → Q → Prop) (D : Q → Q → Q → ℝ) : Prop :=
  ∀ ⦃q₀ q₁ q₂ : Q⦄, DEL q₀ q₁ q₂ → D q₀ q₁ q₂ = 0

/-- **Forward discrete Noether theorem.** If the first-variation identity holds
on DEL trajectories (relating momentum drift to the pairwise symmetry variation),
then infinitesimal invariance of the discrete Lagrangian implies conservation of
the discrete momentum.

Mathematically: if `V(qₖ, qₖ₊₁) = p(qₖ, qₖ₊₁) - p(qₖ₋₁, qₖ)` on shell,
and `V ≡ 0`, then `p` is conserved. -/
theorem discrete_momentum_conserved
    (DEL : Q → Q → Q → Prop) (p V : Q → Q → ℝ)
    (hvar : ∀ ⦃q₀ q₁ q₂ : Q⦄, DEL q₀ q₁ q₂ → V q₁ q₂ = p q₁ q₂ - p q₀ q₁)
    (hinv : InfinitesimallyInvariant V) :
    MomentumConservedOnTrajectories DEL p := by
  intro q₀ q₁ q₂ hdel
  have hv := hvar hdel
  rw [hinv q₁ q₂] at hv
  linarith

/-- **Forward Noether for trajectory ranges.** For a trajectory `q : ℕ → Q`
satisfying DEL at each step, momentum is constant:
`p(q n, q (n+1)) = p(q 0, q 1)` for all `n`. -/
theorem discrete_momentum_conserved_range
    (DEL : Q → Q → Q → Prop) (p : Q → Q → ℝ)
    (hcons : MomentumConservedOnTrajectories DEL p)
    (q : ℕ → Q) (hq : ∀ k, DEL (q k) (q (k + 1)) (q (k + 2)))
    (n : ℕ) : p (q n) (q (n + 1)) = p (q 0) (q 1) := by
  induction n with
  | zero => rfl
  | succ n ih =>
    have h := hcons (hq n)
    linarith

end DiscreteNoether