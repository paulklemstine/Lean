import Mathlib

/-!
# Arithmetic on a Möbius band: obstruction and corrected conclusions

We formalize the endpoint identification `(0,y) ~ (1,-y)` on pairs of real
numbers.  The proposed coordinatewise arithmetic does not descend to this
quotient: equivalent representatives can have inequivalent products.  We also
check the proposed integer embedding and factorization claims exactly.
-/

namespace MoebiusArithmetic

abbrev RawPoint := ℝ × ℝ

/-- The equivalence relation generated by the Möbius endpoint gluing. -/
def EndpointRel (a b : RawPoint) : Prop :=
  a = b ∨
    (a.1 = 0 ∧ b.1 = 1 ∧ a.2 = -b.2) ∨
    (a.1 = 1 ∧ b.1 = 0 ∧ a.2 = -b.2)

lemma endpointRel_refl (a : RawPoint) : EndpointRel a a := by
  exact Or.inl rfl

lemma endpointRel_symm {a b : RawPoint} (h : EndpointRel a b) : EndpointRel b a := by
  grind +locals

lemma endpointRel_trans {a b c : RawPoint}
    (hab : EndpointRel a b) (hbc : EndpointRel b c) : EndpointRel a c := by
  rcases hab with ( rfl | ⟨ ha, hb, hab ⟩ | ⟨ ha, hb, hab ⟩ ) <;> rcases hbc with ( rfl | ⟨ hc, hd, hbc ⟩ | ⟨ hc, hd, hbc ⟩ );
  all_goals unfold EndpointRel; aesop;

/-- The setoid presenting the elementary Möbius endpoint quotient. -/
def endpointSetoid : Setoid RawPoint where
  r := EndpointRel
  iseqv := ⟨endpointRel_refl, @endpointRel_symm, @endpointRel_trans⟩

/-
The two standard representatives of a glued endpoint are equivalent.
-/
theorem twist_identification (y : ℝ) :
    EndpointRel (0, y) (1, -y) := by
  exact Or.inr <| Or.inl ⟨ rfl, rfl, by ring ⟩

/-
But `(0,1)` and `(0,-1)` are distinct even after endpoint gluing.
-/
theorem same_edge_opposites_not_identified :
    ¬ EndpointRel (0, (1 : ℝ)) (0, (-1 : ℝ)) := by
  -- By definition of EndpointRel, we need to show that (0, 1) and (0, -1) are not equivalent.
  unfold EndpointRel
  simp;
  norm_num

/-
Coordinatewise multiplication is not compatible with Möbius gluing.
Consequently it cannot induce the conjectured multiplication on the quotient.
-/
theorem coordinatewise_mul_not_well_defined :
    ∃ a a' b b' : RawPoint,
      EndpointRel a a' ∧ EndpointRel b b' ∧
      ¬ EndpointRel (a.1 * b.1, a.2 * b.2)
        (a'.1 * b'.1, a'.2 * b'.2) := by
  use ( 0, 1 ), ( 1, -1 ), ( 0, 1 ), ( 1, -1 ) ; norm_num [ EndpointRel ] ;

/-
Coordinatewise addition also fails to descend through the gluing.
-/
theorem coordinatewise_add_not_well_defined :
    ∃ a a' b b' : RawPoint,
      EndpointRel a a' ∧ EndpointRel b b' ∧
      ¬ EndpointRel (a.1 + b.1, a.2 + b.2)
        (a'.1 + b'.1, a'.2 + b'.2) := by
  -- Let's choose specific points, such as a = (0, 1), a' = (1, -1), b = (0, 1), and b' = (1, -1).
  use (0, 1), (1, -1), (0, 1), (1, -1);
  norm_num [ EndpointRel ]

/-- The proposed coordinate, interpreted in `ℚ` (where division is exact). -/
def proposedCoord (n : ℤ) : ℚ :=
  1 / 2 + 1 / (2 * (n : ℚ))

/-- The proposed scale. -/
def proposedScale (n : ℤ) : ℚ := n.natAbs

/-- The real-number value claimed in the prompt, over exact rational data. -/
def representedValue (n : ℤ) : ℚ :=
  proposedScale n * (2 * proposedCoord n - 1)

/-
For positive input, the proposed embedding represents `1`, not the input.
-/
theorem proposed_embedding_collapses_positive {n : ℤ} (hn : 0 < n) :
    representedValue n = 1 := by
  unfold representedValue; unfold proposedScale; unfold proposedCoord; simp +decide; ring_nf;
  rw [ abs_of_pos ( by positivity ), mul_inv_cancel₀ ( by positivity ) ]

/-
For negative input, the proposed embedding represents `-1`, not the input.
-/
theorem proposed_embedding_collapses_negative {n : ℤ} (hn : n < 0) :
    representedValue n = -1 := by
  unfold representedValue; simp +decide [ *, proposedScale, proposedCoord ] ; ring_nf;
  rw [ abs_of_neg, mul_inv_eq_iff_eq_mul₀ ] <;> aesop

/-- The coordinate component itself distinguishes `2` and `3`; it is the
claimed represented real value, not the pair-valued embedding, that collapses. -/
theorem proposed_coordinates_distinguish_two_three :
    proposedCoord 2 ≠ proposedCoord 3 := by
  norm_num [proposedCoord]

/-
The claimed collision is instead visible at the represented-value level:
all positive integers have the same represented value.
-/
theorem represented_value_collision : representedValue 2 = representedValue 3 := by
  norm_num [representedValue, proposedScale, proposedCoord]

/-- The requested positive factorization is ordinary integer arithmetic. -/
theorem factor_six : (6 : ℤ) = 2 * 3 := by
  norm_num

/-- The proposed equality `-6 = (-2)(-3)` is false: two orientation reversals
cancel rather than produce a reversal. -/
theorem factor_negative_six_claim_false : (-(6 : ℤ)) ≠ (-2) * (-3) := by
  norm_num

/-- The corrected signed factorization. -/
theorem factor_negative_six_correct : (-(6 : ℤ)) = 2 * 3 * (-1) := by
  norm_num

/-
Zero cannot be expressed as a finite product of nonzero integer factors.
-/
theorem zero_not_product_of_nonzero_factors (s : Finset ℕ) (f : ℕ → ℤ)
    (hf : ∀ i ∈ s, f i ≠ 0) : ∏ i ∈ s, f i ≠ 0 := by
  exact Finset.prod_ne_zero_iff.mpr hf

/-
The alleged "twist prime" `-1` is not prime; it is a unit.
-/
theorem negative_one_is_not_prime : ¬ Prime (-(1 : ℤ)) := by
  norm_num [ Prime ]

/-
In fact the only integer units are the two orientations `1` and `-1`.
-/
theorem integer_units_are_orientations (u : ℤ) :
    IsUnit u ↔ u = 1 ∨ u = -1 := by
  -- We need to show that $u$ is a unit if and only if $u = 1$ or $u = -1$.
  apply Int.isUnit_iff

end MoebiusArithmetic