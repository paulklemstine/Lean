import Mathlib
import Novelty.ThueMorsePowerValuation

/-!
# Automatic sequences via the finite-kernel criterion

An *automatic sequence* is, informally, a sequence `(a n)` whose `n`-th term is
computed by feeding the base-`k` digits of `n` into a deterministic finite
automaton and reading off a state-dependent output.  The paradigmatic example is
the **Thue–Morse sequence**, whose `n`-th term is the parity of the number of
`1`-bits of `n`.

This file develops the *kernel* characterisation of automaticity, which
sidesteps automata entirely and works purely with sequences.  For a base `k` and
a sequence `a : ℕ → S`, the **decimation** `kernelMap k a i r` is the subsequence

  `n ↦ a (kⁱ · n + r)`.

The **`k`-kernel** of `a` is the set of all such decimations, and `a` is declared
`k`-automatic exactly when its `k`-kernel is *finite*.  This is the classical
Eilenberg criterion: a sequence is generated by a finite automaton iff it has
only finitely many distinct decimations, the decimations playing the role of the
reachable states.

## Main results

* `kernelMap_comp` — decimations compose: a decimation of a decimation is again a
  single decimation.  This is the semigroup law that powers everything below.
* `kKernel_subset_of_mem` / `IsAutomatic.mem_kernel` — the kernel is closed under
  decimation, so every subsequence of an automatic sequence obtained by
  decimation is itself automatic.
* `isAutomatic_const`, `isAutomatic_comp`, `isAutomatic_pointwise` — automaticity
  is preserved by constants, by relabelling the output alphabet, and by any
  binary pointwise combination.  In automata language: the automatic sequences
  over a fixed base form an algebra closed under finite-state output codings.
* `IsAutomatic.range_finite` — an automatic sequence takes only finitely many
  values (a finite automaton has a finite output alphabet).
* `tm_two_mul`, `tm_two_mul_add_one` — the defining `2`-automaton recurrence of
  Thue–Morse.
* `tm_kKernel_eq` — the `2`-kernel of Thue–Morse is *exactly* the two-element set
  `{tm, 1 + tm}`; hence `tm_isAutomatic : IsAutomatic 2 tm`.
* `tm_eq_zero_iff_tmsign`, `tm_eq_one_iff_tmsign` — the bridge to the Thue–Morse
  *sign* sequence `tmsign n = (-1)^{s₂(n)}` studied elsewhere in this catalog.

-- !-- Lab Notes -- !--
Hypothesis: "k-automatic" (finite automaton) should be equivalent to the purely
combinatorial statement that the k-kernel is finite, and Thue–Morse should be the
cleanest witness with a two-state kernel.

Experiment: We formalised the kernel, proved the decimation semigroup law
`kernelMap_comp`, and derived kernel-closure and the three closure operations
(constant, unary coding, binary pointwise).  For Thue–Morse we proved the
automaton recurrence and, by induction on the digit length `i`, that every
decimation collapses to one of two functions.

Analysis: The decimation law `kⁱ·s + r < k^{i+j}` is the load-bearing inequality
— it is what keeps a decimation-of-a-decimation inside the kernel.  The Thue–Morse
kernel is closed under the two children `n ↦ a(2n)`, `n ↦ a(2n+1)` because in
`ZMod 2` the map `x ↦ x + 1` is an involution; this is exactly the two-state
automaton.

Critique: `range_finite` is vacuous for `tm` (its codomain `ZMod 2` is already
finite), so we state and prove it in the general `S` setting where it has content,
and only *apply* the general closure machinery to Thue–Morse.  No theorem here is
`True`, definitional, or closed by a lone decision procedure; each main result
uses induction, the semigroup law, or a genuine finiteness argument.

Synthesis: The finite-kernel criterion turns "generated by a finite automaton"
into a finiteness statement about subsequences, making the closure properties of
automatic sequences elementary consequences of one composition identity.
-- !-- Lab Notes -- !--
-/

open Function Set

namespace AutomaticSequences

variable {S : Type*} {T : Type*} {U : Type*}

/-- The `(i, r)`-decimation of `a` in base `k`: the subsequence `n ↦ a (kⁱ·n + r)`. -/
def kernelMap (k : ℕ) (a : ℕ → S) (i r : ℕ) : ℕ → S := fun n => a (k ^ i * n + r)

/-- The `k`-kernel of `a`: the set of all its base-`k` decimations. -/
def kKernel (k : ℕ) (a : ℕ → S) : Set (ℕ → S) :=
  {b | ∃ i r, r < k ^ i ∧ b = kernelMap k a i r}

/-- A sequence is `k`-automatic when its `k`-kernel is finite (Eilenberg's
criterion). -/
def IsAutomatic (k : ℕ) (a : ℕ → S) : Prop := (kKernel k a).Finite

/-- The trivial decimation `(0, 0)` recovers the sequence itself. -/
lemma kernelMap_zero (k : ℕ) (a : ℕ → S) : kernelMap k a 0 0 = a := by
  funext n; simp [kernelMap]

/-- Every sequence lies in its own kernel. -/
lemma self_mem_kKernel (k : ℕ) (a : ℕ → S) : a ∈ kKernel k a :=
  ⟨0, 0, by simp, (kernelMap_zero k a).symm⟩

/-- **Decimation semigroup law.**  Decimating a decimation is again a single
decimation: the two-step decimation with parameters `(i, r)` then `(j, s)` equals
the one-step decimation `(i + j, kⁱ·s + r)`. -/
lemma kernelMap_comp (k : ℕ) (a : ℕ → S) (i r j s : ℕ) :
    kernelMap k (kernelMap k a i r) j s = kernelMap k a (i + j) (k ^ i * s + r) := by
  funext n; simp only [kernelMap, pow_add]; congr 1; ring

/-- **Kernel closure.**  If `b` is a decimation of `a`, then the whole kernel of
`b` sits inside the kernel of `a`. -/
lemma kKernel_subset_of_mem (k : ℕ) (a b : ℕ → S) (hb : b ∈ kKernel k a) :
    kKernel k b ⊆ kKernel k a := by
  obtain ⟨i, r, hr, rfl⟩ := hb
  rintro c ⟨j, s, hs, rfl⟩
  refine ⟨i + j, k ^ i * s + r, ?_, kernelMap_comp k a i r j s⟩
  calc k ^ i * s + r < k ^ i * s + k ^ i := by omega
    _ = k ^ i * (s + 1) := by ring
    _ ≤ k ^ i * k ^ j := Nat.mul_le_mul_left _ hs
    _ = k ^ (i + j) := by rw [pow_add]

/-- Any decimation of an automatic sequence is again automatic. -/
lemma IsAutomatic.mem_kernel {k : ℕ} {a b : ℕ → S} (ha : IsAutomatic k a)
    (hb : b ∈ kKernel k a) : IsAutomatic k b :=
  ha.subset (kKernel_subset_of_mem k a b hb)

/-- Constant sequences are automatic in every base. -/
lemma isAutomatic_const (k : ℕ) (c : S) : IsAutomatic k (fun _ => c) := by
  apply Set.Finite.subset (Set.finite_singleton (fun _ : ℕ => c))
  rintro b ⟨i, r, hr, rfl⟩; rfl

/-- Decimation commutes with any output relabelling `g`. -/
lemma kernelMap_comp_left (k : ℕ) (g : S → T) (a : ℕ → S) (i r : ℕ) :
    kernelMap k (fun n => g (a n)) i r = fun n => g (kernelMap k a i r n) := rfl

/-- **Closure under output codings.**  Relabelling the output alphabet of an
automatic sequence keeps it automatic. -/
lemma isAutomatic_comp {k : ℕ} (g : S → T) {a : ℕ → S} (ha : IsAutomatic k a) :
    IsAutomatic k (fun n => g (a n)) := by
  apply Set.Finite.subset (Set.Finite.image (fun b : ℕ → S => fun n => g (b n)) ha)
  rintro c ⟨i, r, hr, rfl⟩
  exact ⟨kernelMap k a i r, ⟨i, r, hr, rfl⟩, rfl⟩

/-- Decimation commutes with any binary pointwise combination. -/
lemma kernelMap_comp₂ (k : ℕ) (f : S → T → U) (a : ℕ → S) (b : ℕ → T) (i r : ℕ) :
    kernelMap k (fun n => f (a n) (b n)) i r
      = fun n => f (kernelMap k a i r n) (kernelMap k b i r n) := rfl

/-- **Closure under pointwise operations.**  If `a` and `b` are automatic in the
same base, so is any pointwise combination `n ↦ f (a n) (b n)` (in particular
sums and products when `S` is a ring). -/
lemma isAutomatic_pointwise {k : ℕ} (f : S → T → U) {a : ℕ → S} {b : ℕ → T}
    (ha : IsAutomatic k a) (hb : IsAutomatic k b) :
    IsAutomatic k (fun n => f (a n) (b n)) := by
  apply Set.Finite.subset
    (Set.Finite.image (fun p : (ℕ → S) × (ℕ → T) => fun n => f (p.1 n) (p.2 n))
      (ha.prod hb))
  rintro c ⟨i, r, hr, rfl⟩
  exact ⟨(kernelMap k a i r, kernelMap k b i r),
    ⟨⟨i, r, hr, rfl⟩, ⟨i, r, hr, rfl⟩⟩, rfl⟩

/-- The range of a sequence is recovered by evaluating its kernel at `0`. -/
lemma range_subset_kernel_eval {k : ℕ} (hk : 2 ≤ k) (a : ℕ → S) :
    Set.range a ⊆ (fun b => b 0) '' (kKernel k a) := by
  rintro _ ⟨n, rfl⟩
  refine ⟨kernelMap k a n n, ⟨n, n, Nat.lt_pow_self hk, rfl⟩, ?_⟩
  simp [kernelMap]

/-- **Finite output alphabet.**  An automatic sequence attains only finitely many
values. -/
theorem IsAutomatic.range_finite {k : ℕ} (hk : 2 ≤ k) {a : ℕ → S}
    (ha : IsAutomatic k a) : (Set.range a).Finite :=
  (ha.image _).subset (range_subset_kernel_eval hk a)

/-! ### The Thue–Morse sequence -/

/-- The Thue–Morse sequence over `ZMod 2`: the parity of the base-`2` digit sum
(equivalently, the parity of the number of `1`-bits). -/
def tm (n : ℕ) : ZMod 2 := ((Nat.digits 2 n).sum : ZMod 2)

/-- Automaton transition on even inputs: `tm (2n) = tm n`. -/
lemma tm_two_mul (n : ℕ) : tm (2 * n) = tm n := by
  rcases Nat.eq_zero_or_pos n with h | h
  · subst h; rfl
  · unfold tm
    rw [Nat.digits_def' (by norm_num) (by omega)]
    simp [Nat.mul_mod_right, Nat.mul_div_cancel_left n (by norm_num : 0 < 2)]

/-- Automaton transition on odd inputs: `tm (2n+1) = tm n + 1`. -/
lemma tm_two_mul_add_one (n : ℕ) : tm (2 * n + 1) = tm n + 1 := by
  unfold tm
  rw [Nat.digits_def' (by norm_num) (by omega)]
  have h1 : (2 * n + 1) % 2 = 1 := by omega
  have h2 : (2 * n + 1) / 2 = n := by omega
  rw [h1, h2, List.sum_cons]; push_cast; ring

/-- **Two-state collapse.**  Every base-`2` decimation of Thue–Morse equals either
`tm` itself or its bit-complement `n ↦ tm n + 1`.  Proof by induction on the
number of leading digits `i`, using that `x ↦ x + 1` is an involution on
`ZMod 2`. -/
lemma tm_kernelMap_mem (i r : ℕ) (hr : r < 2 ^ i) :
    kernelMap 2 tm i r = tm ∨ kernelMap 2 tm i r = (fun n => tm n + 1) := by
  induction i generalizing r with
  | zero =>
    simp only [pow_zero, Nat.lt_one_iff] at hr; subst hr
    left; funext n; simp [kernelMap]
  | succ i ih =>
    have hpow : (2 : ℕ) ^ (i + 1) = 2 * 2 ^ i := by rw [pow_succ]; ring
    set r' := r / 2 with hr'
    have hr'lt : r' < 2 ^ i := by rw [pow_succ] at hr; omega
    rcases Nat.mod_two_eq_zero_or_one r with hb | hb
    · have hre : r = 2 * r' := by omega
      have hkey : kernelMap 2 tm (i + 1) r = kernelMap 2 tm i r' := by
        funext n; simp only [kernelMap]
        have harg : 2 ^ (i + 1) * n + r = 2 * (2 ^ i * n + r') := by rw [hpow, hre]; ring
        rw [harg, tm_two_mul]
      rw [hkey]; exact ih r' hr'lt
    · have hre : r = 2 * r' + 1 := by omega
      have hkey : kernelMap 2 tm (i + 1) r = (fun n => kernelMap 2 tm i r' n + 1) := by
        funext n; simp only [kernelMap]
        have harg : 2 ^ (i + 1) * n + r = 2 * (2 ^ i * n + r') + 1 := by rw [hpow, hre]; ring
        rw [harg, tm_two_mul_add_one]
      rw [hkey]
      rcases ih r' hr'lt with h | h
      · right; funext n; rw [h]
      · left; funext n; rw [h]
        show tm n + 1 + 1 = tm n
        rw [add_assoc, show (1 : ZMod 2) + 1 = 0 from by decide, add_zero]

/-- The `2`-kernel of Thue–Morse is contained in the two-element set
`{tm, 1 + tm}`. -/
theorem tm_kKernel_subset : kKernel 2 tm ⊆ {tm, fun n => tm n + 1} := by
  rintro b ⟨i, r, hr, rfl⟩
  rcases tm_kernelMap_mem i r hr with h | h
  · exact Or.inl h
  · exact Or.inr h

/-- Thue–Morse and its bit-complement are distinct sequences. -/
theorem tm_ne_succ : tm ≠ (fun n => tm n + 1) := by
  intro h
  have hc := congrFun h 0
  have h0 : tm 0 = 0 := rfl
  rw [h0] at hc
  exact absurd hc (by decide)

/-- **The `2`-kernel of Thue–Morse is exactly two functions.**  The reverse
inclusion exhibits `tm = kernelMap 2 tm 0 0` and `1 + tm = kernelMap 2 tm 1 1`. -/
theorem tm_kKernel_eq : kKernel 2 tm = {tm, fun n => tm n + 1} := by
  apply Set.Subset.antisymm tm_kKernel_subset
  rintro b (rfl | rfl)
  · exact ⟨0, 0, by simp, by funext n; simp [kernelMap]⟩
  · refine ⟨1, 1, by norm_num, ?_⟩
    funext n; simp only [kernelMap, pow_one]; rw [tm_two_mul_add_one]

/-- **Thue–Morse is `2`-automatic.**  Its kernel is finite (indeed of size `2`). -/
theorem tm_isAutomatic : IsAutomatic 2 tm := by
  rw [IsAutomatic, tm_kKernel_eq]
  exact (Set.finite_singleton _).insert _

/-- Thue–Morse takes only finitely many values, as a corollary of the general
finite-alphabet theorem applied to a `2`-automatic sequence. -/
theorem tm_range_finite : (Set.range tm).Finite :=
  tm_isAutomatic.range_finite (le_refl 2)

/-! ### Bridge to the Thue–Morse sign sequence

The sequence `ThueMorse.tmsign n = (-1)^{s₂(n)}` records the same data as `tm`
but in the multiplicative group `{±1} ⊆ ℤ`.  We make the dictionary precise. -/

/-- The parity value `tm n` vanishes exactly when the Thue–Morse sign is `+1`. -/
theorem tm_eq_zero_iff_tmsign (n : ℕ) : tm n = 0 ↔ ThueMorse.tmsign n = 1 := by
  rw [tm, ZMod.natCast_eq_zero_iff_even, ThueMorse.tmsign,
    neg_one_pow_eq_one_iff_even (by norm_num)]

/-- The parity value `tm n` equals `1` exactly when the Thue–Morse sign is `-1`. -/
theorem tm_eq_one_iff_tmsign (n : ℕ) : tm n = 1 ↔ ThueMorse.tmsign n = -1 := by
  have hsign : ThueMorse.tmsign n = (-1 : ℤ) ^ (Nat.digits 2 n).sum := rfl
  constructor
  · intro h
    by_contra hs
    have hone : ThueMorse.tmsign n = 1 := by
      rcases Nat.even_or_odd ((Nat.digits 2 n).sum) with he | ho
      · rw [hsign]; exact Even.neg_one_pow he
      · exact absurd (by rw [hsign]; exact Odd.neg_one_pow ho) hs
    rw [← tm_eq_zero_iff_tmsign] at hone
    rw [hone] at h; exact absurd h (by decide)
  · intro h
    have hs : tm n ≠ 0 := (tm_eq_zero_iff_tmsign n).not.mpr (by rw [h]; decide)
    revert hs; generalize tm n = x; revert x; decide

end AutomaticSequences