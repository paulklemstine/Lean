import Novelty.ECAMaximalDimension

/-!
# Cycle 4: the fixed-point variety is a covariant of the symmetry orbit

The `256` elementary rules carry an action of the Klein four-group generated by

* **reflection** `l ↔ r` (space inversion), and
* **conjugation** `0 ↔ 1` (colour inversion),

and Wolfram's classification is constant on the orbits.  We prove that the
fixed-point variety transforms *covariantly* under this group: reflecting the
rule reflects the variety, conjugating the rule translates the variety by the
all-ones configuration.

This turns the single computation of Cycle 1 into a structural statement about
the whole class-4 orbit `{110, 124, 137, 193}`: each of these Turing-complete
rules has a **one-point** fixed-point variety, and for the two odd members the
variety does not even contain the origin, so it carries no linear dimension at
all.

## Main results

* `mem_fixedSet_reflect`, `fixedSet_eq_reflect_image` — covariance under space
  inversion.
* `mem_fixedSet_conjugate`, `fixedSet_eq_conjugate_image` — covariance under
  colour inversion.
* `rule124_fixedSet`, `rule137_fixedSet`, `rule193_fixedSet` — the fixed-point
  varieties of the remaining class-4 rules, obtained from Rule 110 by symmetry.
* `class4_orbit_fixedSet_singleton` — the whole class-4 orbit has singleton
  varieties, and `class4_orbit_never_maximal` — none of them is maximal.
-/

namespace ECAFixedVariety

/-- Space inversion of a configuration. -/
def reflectCfg {n : ℕ} (s : Cfg n) : Cfg n := fun i => s (-i)

/-- Colour inversion of a configuration. -/
def conjCfg {n : ℕ} (s : Cfg n) : Cfg n := fun i => 1 + s i

@[simp] lemma reflectCfg_reflectCfg {n : ℕ} (s : Cfg n) : reflectCfg (reflectCfg s) = s := by
  funext i
  simp [reflectCfg]

lemma zmod2_one_add_one_add : ∀ x : ZMod 2, 1 + (1 + x) = x := by decide

@[simp] lemma conjCfg_conjCfg {n : ℕ} (s : Cfg n) : conjCfg (conjCfg s) = s := by
  funext i
  exact zmod2_one_add_one_add (s i)

@[simp] lemma reflectCfg_zero {n : ℕ} : reflectCfg (0 : Cfg n) = 0 := rfl

@[simp] lemma conjCfg_zero {n : ℕ} : conjCfg (0 : Cfg n) = 1 := by
  funext i
  show 1 + (0 : ZMod 2) = 1
  ring

/-! ### Covariance under space inversion -/

/-- If `rule'` is the spatial mirror of `rule`, a configuration is stationary for
`rule` exactly when its reflection is stationary for `rule'`. -/
theorem mem_fixedSet_reflect {rule rule' n : ℕ}
    (h : ∀ l c r : ZMod 2, localRuleZ rule' l c r = localRuleZ rule r c l) (s : Cfg n) :
    reflectCfg s ∈ fixedSet rule' n ↔ s ∈ fixedSet rule n := by
  rw [mem_fixedSet_iff, mem_fixedSet_iff]
  constructor
  · intro hs i
    have hi := hs (-i)
    simp only [reflectCfg] at hi
    rw [show -(-i - 1) = i + 1 from by ring, show -(-i) = i from by ring,
      show -(-i + 1) = i - 1 from by ring, h] at hi
    exact hi
  · intro hs i
    show localRuleZ rule' (s (-(i - 1))) (s (-i)) (s (-(i + 1))) = s (-i)
    rw [h, show -(i + 1) = -i - 1 from by ring, show -(i - 1) = -i + 1 from by ring]
    exact hs (-i)

/-- The mirror rule has the reflected variety. -/
theorem fixedSet_eq_reflect_image {rule rule' n : ℕ}
    (h : ∀ l c r : ZMod 2, localRuleZ rule' l c r = localRuleZ rule r c l) :
    fixedSet rule' n = reflectCfg '' fixedSet rule n := by
  ext s
  constructor
  · intro hs
    refine ⟨reflectCfg s, ?_, reflectCfg_reflectCfg s⟩
    rw [← mem_fixedSet_reflect h]
    rwa [reflectCfg_reflectCfg]
  · rintro ⟨t, ht, rfl⟩
    exact (mem_fixedSet_reflect h t).2 ht

/-! ### Covariance under colour inversion -/

/-- If `rule'` is the colour-conjugate of `rule`, a configuration is stationary
for `rule` exactly when its complement is stationary for `rule'`. -/
theorem mem_fixedSet_conjugate {rule rule' n : ℕ}
    (h : ∀ l c r : ZMod 2, localRuleZ rule' l c r = 1 + localRuleZ rule (1 + l) (1 + c) (1 + r))
    (s : Cfg n) :
    conjCfg s ∈ fixedSet rule' n ↔ s ∈ fixedSet rule n := by
  have hcancel : ∀ x : ZMod 2, 1 + (1 + x) = x := by decide
  rw [mem_fixedSet_iff, mem_fixedSet_iff]
  constructor
  · intro hs i
    have hi := hs i
    show localRuleZ rule (s (i - 1)) (s i) (s (i + 1)) = s i
    rw [show conjCfg s (i - 1) = 1 + s (i - 1) from rfl, show conjCfg s i = 1 + s i from rfl,
      show conjCfg s (i + 1) = 1 + s (i + 1) from rfl, h, hcancel, hcancel, hcancel] at hi
    exact add_left_cancel hi
  · intro hs i
    have hi := hs i
    show localRuleZ rule' (1 + s (i - 1)) (1 + s i) (1 + s (i + 1)) = 1 + s i
    rw [h, hcancel, hcancel, hcancel, hi]

/-- The colour-conjugate rule has the translated variety. -/
theorem fixedSet_eq_conjugate_image {rule rule' n : ℕ}
    (h : ∀ l c r : ZMod 2, localRuleZ rule' l c r = 1 + localRuleZ rule (1 + l) (1 + c) (1 + r)) :
    fixedSet rule' n = conjCfg '' fixedSet rule n := by
  ext s
  constructor
  · intro hs
    refine ⟨conjCfg s, ?_, conjCfg_conjCfg s⟩
    rw [← mem_fixedSet_conjugate h]
    rwa [conjCfg_conjCfg]
  · rintro ⟨t, ht, rfl⟩
    exact (mem_fixedSet_conjugate h t).2 ht

/-! ### The class-4 orbit of Rule 110 -/

/-- Rule 124 is the spatial mirror of Rule 110. -/
lemma rule124_mirror_rule110 :
    ∀ l c r : ZMod 2, localRuleZ 124 l c r = localRuleZ 110 r c l := by decide

/-- Rule 137 is the colour conjugate of Rule 110. -/
lemma rule137_conj_rule110 :
    ∀ l c r : ZMod 2, localRuleZ 137 l c r = 1 + localRuleZ 110 (1 + l) (1 + c) (1 + r) := by
  decide

/-- Rule 193 is the mirror of Rule 137, i.e. the conjugate of Rule 124. -/
lemma rule193_mirror_rule137 :
    ∀ l c r : ZMod 2, localRuleZ 193 l c r = localRuleZ 137 r c l := by decide

/-- Rule 124 fixes only the zero configuration. -/
theorem rule124_fixedSet (n : ℕ) : fixedSet 124 n = {0} := by
  rw [fixedSet_eq_reflect_image rule124_mirror_rule110, rule110_fixedSet]
  simp

/-- Rule 137 fixes only the all-ones configuration. -/
theorem rule137_fixedSet (n : ℕ) : fixedSet 137 n = {1} := by
  rw [fixedSet_eq_conjugate_image rule137_conj_rule110, rule110_fixedSet]
  simp

/-- Rule 193 fixes only the all-ones configuration. -/
theorem rule193_fixedSet (n : ℕ) : fixedSet 193 n = {1} := by
  rw [fixedSet_eq_reflect_image rule193_mirror_rule137, rule137_fixedSet]
  have : reflectCfg (1 : Cfg n) = 1 := rfl
  rw [Set.image_singleton, this]

/-- **The entire class-4 orbit has a one-point fixed-point variety.** -/
theorem class4_orbit_fixedSet_singleton (n : ℕ) :
    (∃ s : Cfg n, fixedSet 110 n = {s}) ∧ (∃ s : Cfg n, fixedSet 124 n = {s}) ∧
      (∃ s : Cfg n, fixedSet 137 n = {s}) ∧ (∃ s : Cfg n, fixedSet 193 n = {s}) :=
  ⟨⟨0, rule110_fixedSet n⟩, ⟨0, rule124_fixedSet n⟩, ⟨1, rule137_fixedSet n⟩,
    ⟨1, rule193_fixedSet n⟩⟩

/-- None of the four Turing-complete class-4 rules has a maximal-dimensional
variety; the conjecture's class-4 prediction fails on the whole orbit. -/
theorem class4_orbit_never_maximal {n : ℕ} (hn : 3 ≤ n) :
    ¬ HasFixedDim 110 n n ∧ ¬ HasFixedDim 124 n n ∧ ¬ HasFixedDim 137 n n ∧
      ¬ HasFixedDim 193 n n := by
  refine ⟨?_, ?_, ?_, ?_⟩ <;>
    · rw [hasFixedDim_max_iff_eq_204 (by norm_num) hn]
      norm_num

/-- The odd members of the orbit have varieties that miss the origin, so they
are not linear subvarieties at all: their "dimension" is undefined even though
the variety is a single point. -/
theorem rule137_no_fixed_dim (n d : ℕ) : ¬ HasFixedDim 137 n d :=
  odd_rule_no_fixed_dim (by norm_num) n d

theorem rule193_no_fixed_dim (n d : ℕ) : ¬ HasFixedDim 193 n d :=
  odd_rule_no_fixed_dim (by norm_num) n d

end ECAFixedVariety