--- Basic.lean
+++ Basic.lean
@@ -1,121 +1,107 @@
 import Mathlib
 
 /-!
-# Fermat Near-Misses
+# The Anti-Fibonacci Sequence — Foundations
 
-Elementary existence, optimality, counting, and quantitative error bounds for
-`|a^n + b^n - c^n|`.
+The Fibonacci sequence `F (n+1) = F n + F (n-1)` is the paradigm of *addition-driven*
+growth: consecutive ratios converge to the golden ratio and terms grow exponentially.
+
+This file studies a *counterpoint* sequence obtained from the concrete data
+`1, 1, 2, 4, 7, 11, 16, 22, 29, …` proposed in the research brief.  The successive
+differences are `0, 1, 2, 3, 4, 5, …`, so the sequence is generated by the first-order
+recurrence
+
+  `A 0 = 1`,   `A (n+1) = A n + n`.
+
+Equivalently `A n = 1 + n (n-1) / 2` (the central-polygonal / "lazy caterer" numbers
+`A000124` prepended with a leading `1`).  We call it `antiFib`.
+
+## Main results in this file
+
+* `antiFib_closed` — the exact (subtraction-free) closed form
+  `2 * antiFib n + n = n * n + 2`.
+* `antiFib_real`  — the real-valued closed form `antiFib n = (n² - n + 2)/2`.
+* `antiFib_avoids_sum` — from index `6` on, a term is **strictly smaller** than the
+  sum of its two predecessors: `antiFib (n+6) < antiFib (n+5) + antiFib (n+4)`.  In
+  particular `antiFib (n+6) ≠ antiFib (n+5) + antiFib (n+4)`, so the sequence really
+  does "avoid addition" — but only past a sharp threshold (see `antiFib_boundary`).
+* `antiFib_boundary` — sharpness: `antiFib 5 = antiFib 4 + antiFib 3`, so the
+  avoidance property *fails* exactly at index `5`.
+
+-- !-- Lab Notes -- !--
+Hypothesis (Hypothesizer): the brief claims `A(n+1)` is "the smallest positive integer
+not equal to `A n + A (n-1)`" and that `A n ~ n²/4` with `A n = ⌊n²/4⌋ + O(1)`.
+
+Experiment (Experimenter): computing the literal greedy rule "smallest positive integer
+≠ A n + A(n-1)" yields `1` almost always and does NOT reproduce `1,1,2,4,7,11,16`.
+The concrete data given IS reproduced exactly by `A 0 = 1, A(n+1) = A n + n`
+(`#eval` gives `1,1,2,4,7,11,16,22,29,37`).  So we take the data as ground truth.
+
+Analysis (Analyst): the data forces `A n = 1 + n(n-1)/2`, hence `A n ~ n²/2`, NOT `n²/4`.
+Moreover `A n - ⌊n²/2⌋` grows linearly, so the `O(1)` claim is false for every constant
+multiple of `n²`; only the *exact* quadratic identity survives.
+
+Critique (Critic): does this sequence even "avoid addition"?  Checking:
+`A 5 = 11 = 7 + 4 = A 4 + A 3` — it FAILS at index 5!  But for all larger indices
+`A k < A(k-1) + A(k-2)` strictly.  We therefore prove the *corrected*, sharp statement
+(`antiFib_avoids_sum` for `k ≥ 6`, with `antiFib_boundary` witnessing sharpness).
+
+Synthesis: the honest object is the recurrence `A(n+1) = A n + n`; the true asymptotic
+constant is `1/2`, and the "anti-addition" property holds exactly for indices `≥ 6`.
+-- !-- Lab Notes -- !--
 -/
 
-namespace FermatNearMisses
+namespace AntiFibonacci
 
-/-- The nonnegative integral error in a Fermat-type equation. -/
-def error (a b c n : ℕ) : ℕ :=
-  ((a : ℤ) ^ n + (b : ℤ) ^ n - (c : ℤ) ^ n).natAbs
+/-- The anti-Fibonacci sequence: `antiFib 0 = 1` and `antiFib (n+1) = antiFib n + n`.
+Its terms are `1, 1, 2, 4, 7, 11, 16, 22, 29, 37, …`. -/
+def antiFib : ℕ → ℕ
+  | 0 => 1
+  | (n + 1) => antiFib n + n
 
-/-- A triple is a near-miss at tolerance `B` when its integral error is at most `B`. -/
-def IsNearMiss (B a b c n : ℕ) : Prop := error a b c n ≤ B
+@[simp] theorem antiFib_zero : antiFib 0 = 1 := rfl
 
-/-- In the cancellation family `(t,s,t)`, the Fermat error is exactly `s^n`. -/
-theorem cancellation_family_exact_error (t s n : ℕ) : error t s t n = s ^ n := by
-  unfold error
-  norm_num
+theorem antiFib_succ (n : ℕ) : antiFib (n + 1) = antiFib n + n := rfl
 
-/-- Every exponent has an unbounded family of integral near-misses with error one. -/
-theorem adjacent_family_exact_error (t n : ℕ) : error t 1 t n = 1 := by
-  simpa using cancellation_family_exact_error t 1 n
+/-- Subtraction-free closed form: `2 * antiFib n + n = n² + 2`.
+This is the workhorse identity from which every other result is derived. -/
+theorem antiFib_closed (n : ℕ) : 2 * antiFib n + n = n * n + 2 := by
+  induction n with
+  | zero => rfl
+  | succ k ih =>
+      show 2 * (antiFib k + k) + (k + 1) = (k + 1) * (k + 1) + 2
+      nlinarith [ih]
 
-/-- Every exponent admits a positive error-one triple whose two scalable entries
-exceed any prescribed cutoff. -/
-theorem arbitrarily_large_optimal_near_misses (n cutoff : ℕ) :
-    ∃ a b c : ℕ, cutoff < a ∧ 0 < b ∧ cutoff < c ∧ error a b c n = 1 := by
-  use cutoff + 1, 1, cutoff + 1
-  exact ⟨Nat.lt_succ_self _, by decide, Nat.lt_succ_self _,
-    adjacent_family_exact_error _ _⟩
+/-- Real-valued closed form: `antiFib n = (n² - n + 2) / 2`. -/
+theorem antiFib_real (n : ℕ) : (antiFib n : ℝ) = ((n : ℝ) ^ 2 - n + 2) / 2 := by
+  have h := antiFib_closed n
+  have h2 : (2 * antiFib n + n : ℝ) = (n * n + 2 : ℝ) := by exact_mod_cast h
+  push_cast at h2
+  nlinarith [h2]
 
-/-- The distinct positive triple `(6,8,9)` is an optimal cubic near-miss:
-`6^3 + 8^3 = 9^3 - 1`. -/
-theorem optimal_cubic_near_miss :
-    error 6 8 9 3 = 1 ∧ 0 < 6 ∧ 6 < 8 ∧ 8 < 9 := by
-  norm_num [error]
+/-- Every anti-Fibonacci term is positive. -/
+theorem antiFib_pos (n : ℕ) : 0 < antiFib n := by
+  have h := antiFib_closed n
+  nlinarith [h]
 
-/-- On the diagonal `(t,t,t)`, the absolute Fermat error is exactly `t^n`. -/
-theorem diagonal_error (t n : ℕ) : error t t t n = t ^ n := by
-  unfold error
-  norm_num
+/-- **Main result (anti-addition).** From index `6` onwards a term is *strictly less*
+than the sum of its two predecessors, so it can never equal that sum: the sequence
+systematically "avoids addition". -/
+theorem antiFib_avoids_sum (n : ℕ) :
+    antiFib (n + 6) < antiFib (n + 5) + antiFib (n + 4) := by
+  have h6 := antiFib_closed (n + 6)
+  have h5 := antiFib_closed (n + 5)
+  have h4 := antiFib_closed (n + 4)
+  nlinarith [h6, h5, h4]
 
-/-- The diagonal error satisfies an exact quadratic-scale normalization identity. -/
-theorem diagonal_relative_error_identity (t n : ℕ) :
-    error t t t n * t ^ n = t ^ (2 * n) := by
-  rw [diagonal_error, pow_mul']
-  ring
+/-- Consequence: no term (from index `6`) equals the sum of the two before it. -/
+theorem antiFib_ne_sum (n : ℕ) :
+    antiFib (n + 6) ≠ antiFib (n + 5) + antiFib (n + 4) :=
+  Nat.ne_of_lt (antiFib_avoids_sum n)
 
-/-- At base two, the quadratic-scale normalized diagonal error decays exponentially,
-expressed here without division. -/
-theorem binary_diagonal_exponential_decay (n : ℕ) :
-    error 2 2 2 n * 2 ^ n = 2 ^ (2 * n) := by
-  convert diagonal_relative_error_identity 2 n using 1
+/-- **Sharpness.** The avoidance property fails at index `5`:
+`antiFib 5 = antiFib 4 + antiFib 3` (i.e. `11 = 7 + 4`).  Together with
+`antiFib_avoids_sum` this pins the threshold exactly at `6`. -/
+theorem antiFib_boundary : antiFib 5 = antiFib 4 + antiFib 3 := by decide
 
-/-- For fixed exponent, there are exactly `N` members of the error-one
-cancellation family indexed by `t < N`. -/
-theorem count_exact_near_miss_family (n N : ℕ) :
-    ((Finset.range N).filter fun t => error t 1 t n = 1).card = N := by
-  rw [Finset.filter_true_of_mem]
-  · exact Finset.card_range N
-  · exact fun t _ => adjacent_family_exact_error t n
-
-/-- Any nonzero integral Fermat error is at least one, so the cancellation family
-attains the least possible positive error. -/
-theorem one_le_error_of_ne_zero {a b c n : ℕ} (h : error a b c n ≠ 0) :
-    1 ≤ error a b c n := by
-  exact Nat.pos_of_ne_zero h
-
-/-- Changing a nonnegative integral base from `b` to `a` changes its `n`th power
-by at most `n |a-b| max(a,b)^(n-1)`. -/
-theorem power_gap_bound (a b n : ℕ) :
-    |(a : ℤ) ^ n - (b : ℤ) ^ n| ≤
-      |(a : ℤ) - (b : ℤ)| * (n : ℤ) * (max a b : ℤ) ^ (n - 1) := by
-  have h := abs_pow_sub_pow_le (a : ℤ) (b : ℤ) n
-  convert h using 1; norm_num [abs_of_nonneg]
-
-/-- If the sum of powers lies below `c^n`, adding the error produces an exact
-additive equation. This is the elementary bridge from near-misses to abc-type
-triples. -/
-theorem deficit_identity {a b c n : ℕ} (h : a ^ n + b ^ n ≤ c ^ n) :
-    a ^ n + b ^ n + error a b c n = c ^ n := by
-  unfold error;
-  grind
-
-/-- The genuinely ordered family `(t,1,t+1)` has error at most the first-order
-power-gap bound plus one. Thus for fixed exponent its error is `O(t^(n-1))`,
-one degree smaller than the scale of the entries' `n`th powers. -/
-theorem ordered_adjacent_error_bound (t n : ℕ) :
-    error t 1 (t + 1) n ≤ n * (t + 1) ^ (n - 1) + 1 := by
-  set x : ℤ := (t + 1 : ℤ) ^ n - t ^ n
-  have hx_nonneg : x ≥ 0 := by
-    exact sub_nonneg_of_le <| mod_cast Nat.pow_le_pow_left (Nat.le_succ _) _
-  have h_abs : Int.natAbs (1 - x) ≤ n * (t + 1) ^ (n - 1) + 1 := by
-    have h_power_gap : Int.natAbs x ≤ n * (t + 1) ^ (n - 1) := by
-      have h := power_gap_bound (t + 1) t n
-      simp_all +decide [abs_of_nonneg]
-      linarith [abs_of_nonneg hx_nonneg]
-    omega
-  convert h_abs using 1
-  norm_num [error]
-  ring_nf!
-
-/-- Exact small cases for the ordered family, recording the numerical evidence
-behind its polynomial growth pattern. -/
-theorem ordered_small_cases :
-    error 1 1 2 2 = 2 ∧ error 2 1 3 2 = 4 ∧ error 3 1 4 2 = 6 ∧
-    error 1 1 2 3 = 6 ∧ error 2 1 3 3 = 18 ∧ error 3 1 4 3 = 36 ∧
-    error 1 1 2 4 = 14 ∧ error 2 1 3 4 = 64 ∧ error 3 1 4 4 = 174 := by
-  norm_num [error]
-
-/-- The ordered near-miss family is nondegenerate: both smaller entries are
-positive and strictly below the largest whenever `t` is positive. -/
-theorem ordered_adjacent_nondegenerate {t : ℕ} (ht : 0 < t) :
-    0 < t ∧ 0 < 1 ∧ t < t + 1 ∧ 1 < t + 1 := by
-  omega
-
 
