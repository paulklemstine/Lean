+++ Basic.lean
@@ -1,136 +1,107 @@
 import Mathlib
 
 /-!
-# Two-dimensional Newtonian gravity
+# The Anti-Fibonacci Sequence — Foundations
 
-This file formalizes the radial calculus behind planar Newtonian gravity.  It also
-records an important correction to the motivating claim: the logarithmic force
-law does have stable circular orbits.  What fails is Bertrand closure: the
-linearized radial and angular frequencies have irrational ratio `√2`.
+The Fibonacci sequence `F (n+1) = F n + F (n-1)` is the paradigm of *addition-driven*
+growth: consecutive ratios converge to the golden ratio and terms grow exponentially.
+
+This file studies a *counterpoint* sequence obtained from the concrete data
+`1, 1, 2, 4, 7, 11, 16, 22, 29, …` proposed in the research brief.  The successive
+differences are `0, 1, 2, 3, 4, 5, …`, so the sequence is generated by the first-order
+recurrence
+
+  `A 0 = 1`,   `A (n+1) = A n + n`.
+
+Equivalently `A n = 1 + n (n-1) / 2` (the central-polygonal / "lazy caterer" numbers
+`A000124` prepended with a leading `1`).  We call it `antiFib`.
+
+## Main results in this file
+
+* `antiFib_closed` — the exact (subtraction-free) closed form
+  `2 * antiFib n + n = n * n + 2`.
+* `antiFib_real`  — the real-valued closed form `antiFib n = (n² - n + 2)/2`.
+* `antiFib_avoids_sum` — from index `6` on, a term is **strictly smaller** than the
+  sum of its two predecessors: `antiFib (n+6) < antiFib (n+5) + antiFib (n+4)`.  In
+  particular `antiFib (n+6) ≠ antiFib (n+5) + antiFib (n+4)`, so the sequence really
+  does "avoid addition" — but only past a sharp threshold (see `antiFib_boundary`).
+* `antiFib_boundary` — sharpness: `antiFib 5 = antiFib 4 + antiFib 3`, so the
+  avoidance property *fails* exactly at index `5`.
+
+-- !-- Lab Notes -- !--
+Hypothesis (Hypothesizer): the brief claims `A(n+1)` is "the smallest positive integer
+not equal to `A n + A (n-1)`" and that `A n ~ n²/4` with `A n = ⌊n²/4⌋ + O(1)`.
+
+Experiment (Experimenter): computing the literal greedy rule "smallest positive integer
+≠ A n + A(n-1)" yields `1` almost always and does NOT reproduce `1,1,2,4,7,11,16`.
+The concrete data given IS reproduced exactly by `A 0 = 1, A(n+1) = A n + n`
+(`#eval` gives `1,1,2,4,7,11,16,22,29,37`).  So we take the data as ground truth.
+
+Analysis (Analyst): the data forces `A n = 1 + n(n-1)/2`, hence `A n ~ n²/2`, NOT `n²/4`.
+Moreover `A n - ⌊n²/2⌋` grows linearly, so the `O(1)` claim is false for every constant
+multiple of `n²`; only the *exact* quadratic identity survives.
+
+Critique (Critic): does this sequence even "avoid addition"?  Checking:
+`A 5 = 11 = 7 + 4 = A 4 + A 3` — it FAILS at index 5!  But for all larger indices
+`A k < A(k-1) + A(k-2)` strictly.  We therefore prove the *corrected*, sharp statement
+(`antiFib_avoids_sum` for `k ≥ 6`, with `antiFib_boundary` witnessing sharpness).
+
+Synthesis: the honest object is the recurrence `A(n+1) = A n + n`; the true asymptotic
+constant is `1/2`, and the "anti-addition" property holds exactly for indices `≥ 6`.
+-- !-- Lab Notes -- !--
 -/
 
-open Real
+namespace AntiFibonacci
 
-namespace FlatlandGravity
+/-- The anti-Fibonacci sequence: `antiFib 0 = 1` and `antiFib (n+1) = antiFib n + n`.
+Its terms are `1, 1, 2, 4, 7, 11, 16, 22, 29, 37, …`. -/
+def antiFib : ℕ → ℕ
+  | 0 => 1
+  | (n + 1) => antiFib n + n
 
-/-- The potential energy per test body for attractive planar Newtonian gravity. -/
-noncomputable def potential (k r : ℝ) : ℝ := k * Real.log r
+@[simp] theorem antiFib_zero : antiFib 0 = 1 := rfl
 
-/-- The radial force associated with the planar potential. -/
-noncomputable def radialForce (k r : ℝ) : ℝ := -k / r
+theorem antiFib_succ (n : ℕ) : antiFib (n + 1) = antiFib n + n := rfl
 
-/-- The effective radial potential, including the centrifugal term. -/
-noncomputable def effectivePotential (k m ell r : ℝ) : ℝ :=
-  potential k r + ell ^ 2 / (2 * m * r ^ 2)
+/-- Subtraction-free closed form: `2 * antiFib n + n = n² + 2`.
+This is the workhorse identity from which every other result is derived. -/
+theorem antiFib_closed (n : ℕ) : 2 * antiFib n + n = n * n + 2 := by
+  induction n with
+  | zero => rfl
+  | succ k ih =>
+      show 2 * (antiFib k + k) + (k + 1) = (k + 1) * (k + 1) + 2
+      nlinarith [ih]
 
-/-
-The logarithmic potential has derivative `k/r`, hence force `-k/r`.
--/
-theorem hasDerivAt_potential {k r : ℝ} (hr : r ≠ 0) :
-    HasDerivAt (potential k) (k / r) r := by
-  convert HasDerivAt.const_mul k ( Real.hasDerivAt_log hr ) using 1
+/-- Real-valued closed form: `antiFib n = (n² - n + 2) / 2`. -/
+theorem antiFib_real (n : ℕ) : (antiFib n : ℝ) = ((n : ℝ) ^ 2 - n + 2) / 2 := by
+  have h := antiFib_closed n
+  have h2 : (2 * antiFib n + n : ℝ) = (n * n + 2 : ℝ) := by exact_mod_cast h
+  push_cast at h2
+  nlinarith [h2]
 
-/-
-The force is the negative derivative of the logarithmic potential.
--/
-theorem force_eq_neg_potential_deriv {k r : ℝ} (hr : r ≠ 0) :
-    HasDerivAt (potential k) (-radialForce k r) r := by
-  convert hasDerivAt_potential hr using 1 ; unfold radialForce ; ring
+/-- Every anti-Fibonacci term is positive. -/
+theorem antiFib_pos (n : ℕ) : 0 < antiFib n := by
+  have h := antiFib_closed n
+  nlinarith [h]
 
-/-
-First derivative of the effective radial potential.
--/
-theorem hasDerivAt_effectivePotential {k m ell r : ℝ} (hm : m ≠ 0) (hr : r ≠ 0) :
-    HasDerivAt (effectivePotential k m ell)
-      (k / r - ell ^ 2 / (m * r ^ 3)) r := by
-  convert HasDerivAt.add ( hasDerivAt_potential hr ) ( HasDerivAt.div ( hasDerivAt_const _ _ ) ( HasDerivAt.mul ( hasDerivAt_const _ _ ) ( hasDerivAt_pow 2 r ) ) _ ) using 1 <;> ring ; norm_num [ hm, hr ];
-  · -- By simplifying, we can see that the two expressions are equal.
-    field_simp
-    ring;
-  · norm_num [ hm, hr ]
+/-- **Main result (anti-addition).** From index `6` onwards a term is *strictly less*
+than the sum of its two predecessors, so it can never equal that sum: the sequence
+systematically "avoids addition". -/
+theorem antiFib_avoids_sum (n : ℕ) :
+    antiFib (n + 6) < antiFib (n + 5) + antiFib (n + 4) := by
+  have h6 := antiFib_closed (n + 6)
+  have h5 := antiFib_closed (n + 5)
+  have h4 := antiFib_closed (n + 4)
+  nlinarith [h6, h5, h4]
 
-/-
-Algebraic characterization of a circular orbit (a critical point of the
- effective potential).
--/
-theorem circular_critical_iff {k m ell r : ℝ}
-    (hm : m ≠ 0) (hr : r ≠ 0) :
-    k / r - ell ^ 2 / (m * r ^ 3) = 0 ↔ ell ^ 2 = m * k * r ^ 2 := by
-  grind
+/-- Consequence: no term (from index `6`) equals the sum of the two before it. -/
+theorem antiFib_ne_sum (n : ℕ) :
+    antiFib (n + 6) ≠ antiFib (n + 5) + antiFib (n + 4) :=
+  Nat.ne_of_lt (antiFib_avoids_sum n)
 
-/-- Second derivative expression for the effective potential. -/
-noncomputable def effectiveSecondDeriv (k m ell r : ℝ) : ℝ :=
-  -k / r ^ 2 + 3 * ell ^ 2 / (m * r ^ 4)
+/-- **Sharpness.** The avoidance property fails at index `5`:
+`antiFib 5 = antiFib 4 + antiFib 3` (i.e. `11 = 7 + 4`).  Together with
+`antiFib_avoids_sum` this pins the threshold exactly at `6`. -/
+theorem antiFib_boundary : antiFib 5 = antiFib 4 + antiFib 3 := by decide
 
-/-
-At a circular orbit, the effective second derivative is `2k/r²`.
--/
-theorem effectiveSecondDeriv_at_circular {k m ell r : ℝ}
-    (hm : m ≠ 0) (hr : r ≠ 0) (hcirc : ell ^ 2 = m * k * r ^ 2) :
-    effectiveSecondDeriv k m ell r = 2 * k / r ^ 2 := by
-  unfold effectiveSecondDeriv; ring;
-  grind
-
-/-
-Contrary to the motivating “no stable circular orbit” claim, every circular
-orbit with positive coupling and positive radius is linearly stable.
--/
-theorem circular_orbit_stable {k m ell r : ℝ}
-    (hk : 0 < k) (hm : m ≠ 0) (hr : 0 < r)
-    (hcirc : ell ^ 2 = m * k * r ^ 2) :
-    0 < effectiveSecondDeriv k m ell r := by
-  convert div_pos ( mul_pos zero_lt_two hk ) ( sq_pos_of_pos hr ) using 1 ; rw [ effectiveSecondDeriv_at_circular ] <;> aesop
-
-/-- Linearized radial frequency squared at a circular orbit. -/
-noncomputable def radialFrequencySq (k m r : ℝ) : ℝ := 2 * k / (m * r ^ 2)
-
-/-- Angular frequency squared at a circular orbit. -/
-noncomputable def angularFrequencySq (k m r : ℝ) : ℝ := k / (m * r ^ 2)
-
-/-
-The radial epicyclic frequency squared is twice the angular frequency squared.
--/
-theorem radialFrequencySq_eq_two_mul_angular (k m r : ℝ) :
-    radialFrequencySq k m r = 2 * angularFrequencySq k m r := by
-  exact show 2 * k / ( m * r ^ 2 ) = 2 * ( k / ( m * r ^ 2 ) ) by ring;
-
-/-
-The positive frequencies therefore have ratio `√2`.
--/
-theorem radialFrequency_eq_sqrtTwo_mul_angular {omegaR omegaTheta : ℝ}
-    (hTheta : 0 < omegaTheta)
-    (hR : 0 ≤ omegaR)
-    (hsq : omegaR ^ 2 = 2 * omegaTheta ^ 2) :
-    omegaR = Real.sqrt 2 * omegaTheta := by
-  rw [ ← sq_eq_sq₀ ?_ ?_ ] <;> first | positivity | rw [ hsq, mul_pow, Real.sq_sqrt ] ; linarith;
-
-/-
-Irrationality of `√2` prevents exact commensurability of the two positive
-frequencies.  This is the linearized Bertrand-closure obstruction.
--/
-theorem no_frequency_commensurability {omegaR omegaTheta : ℝ}
-    (hTheta : 0 < omegaTheta)
-    (hR : 0 ≤ omegaR)
-    (hsq : omegaR ^ 2 = 2 * omegaTheta ^ 2) :
-    ¬ ∃ p q : ℕ, 0 < p ∧ 0 < q ∧ (p : ℝ) * omegaR = (q : ℝ) * omegaTheta := by
-  -- By assumption, we have omegaR = sqrt(2) * omegaTheta.
-  have h_ratio : omegaR = Real.sqrt 2 * omegaTheta := by
-    rw [ ← sq_eq_sq₀ ?_ ?_ ] <;> first | positivity | rw [ hsq, mul_pow, Real.sq_sqrt ] ; linarith;
-  simp_all +decide [mul_comm, mul_left_comm]
-  exact fun x hx y hy => ⟨ fun h => irrational_sqrt_two <| ⟨ y / x, by push_cast; rw [ ← h, mul_div_cancel_left₀ _ <| by positivity ] ⟩, hTheta.ne' ⟩
-
-/-
-Combined diagnosis: planar gravity has stable circular motion, but its
-linearized radial and angular oscillations cannot share an integer period.
--/
-theorem flatland_diagnosis {k m ell r omegaR omegaTheta : ℝ}
-    (hk : 0 < k) (hm : m ≠ 0) (hr : 0 < r)
-    (hcirc : ell ^ 2 = m * k * r ^ 2)
-    (hTheta : 0 < omegaTheta) (hR : 0 ≤ omegaR)
-    (hsq : omegaR ^ 2 = 2 * omegaTheta ^ 2) :
-    0 < effectiveSecondDeriv k m ell r ∧
-      ¬ ∃ p q : ℕ, 0 < p ∧ 0 < q ∧ (p : ℝ) * omegaR = (q : ℝ) * omegaTheta := by
-  convert circular_orbit_stable hk hm hr hcirc using 1;
-  exact ⟨ fun h => h.1, fun h => ⟨ h, no_frequency_commensurability hTheta hR hsq ⟩ ⟩
-
 
