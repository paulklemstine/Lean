import Novelty.ShorCombState

/-! # The exact bond dimension of the comb at an arbitrary cut

`ShorCombState` shows that the periodic comb has Schmidt rank exactly `r` across
a cut whose block size `B` is coprime to `r`, and rank `1` when `r ∣ B`.  This
file proves the **sharp interpolating formula** covering every cut of a register
whose low half is at least as long as the period:

`schmidtRank (comb across the cut) = min C (r / gcd r B)`,

where `B` is the block size (the size of the low half), `C` the number of blocks
(the size of the high half) and `r` the order.  The arithmetic content is that
the high-half labels `c ↦ x₀ - B·c (mod r)` sweep out the cyclic subgroup
generated by `B` in `ℤ/r`, of index `gcd(r, B)`, and do so with period
`r / gcd(r, B)`.

Consequences:

* `schmidtRank_combCut_sharp` : the exact formula;
* `schmidtRank_combCut_eq_of_coprime` : the coprime case recovers rank `r`;
* `schmidtRank_combCut_of_dvd` : `r ∣ B` collapses the rank to `1`;
* `bondDim_combCut_sharp_ge` : the corresponding exact bond-dimension threshold.

The formula shows precisely where a tensor-train emulation could be cheap: only
when `gcd(r, B)` is large, i.e. when the block size already almost resolves the
period — which for a power-of-two register means `r` has a large power-of-two
part, the classically easy case.
-/

open Finset

namespace ShorIrreducible

open IITTensorNetwork

section SharpRank

variable {B C r x0 : ℕ} [NeZero r] {amp : ℝ}

/-- The period of the high-half labelling: `r / gcd(r, B)`. -/
def cutPeriod (r B : ℕ) : ℕ := r / Nat.gcd r B

omit [NeZero r] in
lemma cutPeriod_pos (hr : 0 < r) : 0 < cutPeriod r B :=
  Nat.div_pos (Nat.le_of_dvd hr (Nat.gcd_dvd_left r B)) (Nat.gcd_pos_of_pos_left B hr)

omit [NeZero r] in
/-- Multiplication by `B` in `ℤ/r` is periodic with period `r / gcd(r, B)`. -/
lemma natCast_mul_congr_of_modEq {c c' : ℕ} (h : c ≡ c' [MOD cutPeriod r B]) :
    ((B * c : ℕ) : ZMod r) = ((B * c' : ℕ) : ZMod r) := by
  classical
  set g := Nat.gcd r B with hg
  have hgr : g ∣ r := Nat.gcd_dvd_left r B
  have hgB : g ∣ B := Nat.gcd_dvd_right r B
  have hdvd : ((cutPeriod r B : ℕ) : ℤ) ∣ (c' : ℤ) - (c : ℤ) := (Nat.modEq_iff_dvd).mp h
  obtain ⟨w, hw⟩ := hdvd
  have hrg : (g : ℤ) * (cutPeriod r B : ℤ) = (r : ℤ) := by
    rw [cutPeriod, hg]
    have : g * (r / g) = r := Nat.mul_div_cancel' hgr
    exact_mod_cast this
  obtain ⟨b', hb'⟩ := hgB
  have hB' : (B : ℤ) = (g : ℤ) * (b' : ℤ) := by exact_mod_cast congrArg (fun n : ℕ => (n : ℤ)) hb'
  have hkey : (r : ℤ) ∣ (B : ℤ) * ((c' : ℤ) - (c : ℤ)) := by
    refine ⟨(b' : ℤ) * w, ?_⟩
    rw [hw, hB', ← hrg]
    ring
  rw [ZMod.natCast_eq_natCast_iff]
  rw [Nat.modEq_iff_dvd]
  push_cast
  have hex : (B : ℤ) * (c' : ℤ) - (B : ℤ) * (c : ℤ) = (B : ℤ) * ((c' : ℤ) - (c : ℤ)) := by ring
  rw [hex]
  exact hkey

omit [NeZero r] in
/-- Conversely, multiplication by `B` is injective modulo the period. -/
lemma modEq_of_natCast_mul_eq (hr : 0 < r) {c c' : ℕ}
    (h : ((B * c : ℕ) : ZMod r) = ((B * c' : ℕ) : ZMod r)) : c ≡ c' [MOD cutPeriod r B] := by
  have h' : B * c ≡ B * c' [MOD r] := (ZMod.natCast_eq_natCast_iff _ _ _).mp h
  exact Nat.ModEq.cancel_left_div_gcd hr h'

/-- The high-half labels of the comb, as a function of a natural number. -/
def combLabel (B r x0 : ℕ) : ℕ → ZMod r := fun c => (x0 : ZMod r) - ((B * c : ℕ) : ZMod r)

lemma combRight_eq_combLabel (B C r x0 : ℕ) (c : Fin C) :
    combRight B C r x0 c = combLabel B r x0 (c : ℕ) := by
  rw [combRight, combLabel]
  push_cast
  ring

lemma image_combRight_eq_range (B C r x0 : ℕ) :
    (univ : Finset (Fin C)).image (combRight B C r x0)
      = (Finset.range C).image (combLabel B r x0) := by
  classical
  ext z
  simp only [Finset.mem_image, Finset.mem_univ, true_and, Finset.mem_range]
  constructor
  · rintro ⟨c, rfl⟩
    exact ⟨(c : ℕ), c.isLt, (combRight_eq_combLabel B C r x0 c).symm⟩
  · rintro ⟨c, hc, rfl⟩
    exact ⟨⟨c, hc⟩, by rw [combRight_eq_combLabel]⟩

omit [NeZero r] in
/-- **The high-half labels sweep out exactly `min C (r / gcd(r,B))` residues.** -/
theorem card_image_combLabel (hr : 0 < r) :
    ((Finset.range C).image (combLabel B r x0)).card = min C (cutPeriod r B) := by
  classical
  set s := cutPeriod r B with hs
  set D := min C s with hD
  have hspos : 0 < s := cutPeriod_pos hr
  have hcong : ∀ c c' : ℕ, c ≡ c' [MOD s] → combLabel B r x0 c = combLabel B r x0 c' := by
    intro c c' h
    rw [combLabel, combLabel, natCast_mul_congr_of_modEq h]
  have hrange : (Finset.range C).image (combLabel B r x0)
      = (Finset.range D).image (combLabel B r x0) := by
    apply Finset.Subset.antisymm
    · intro z hz
      obtain ⟨c, hc, rfl⟩ := Finset.mem_image.mp hz
      rw [Finset.mem_range] at hc
      refine Finset.mem_image.mpr ⟨c % s, ?_, ?_⟩
      · rw [Finset.mem_range, hD, lt_min_iff]
        exact ⟨lt_of_le_of_lt (Nat.mod_le c s) hc, Nat.mod_lt _ hspos⟩
      · exact (hcong c (c % s) (Nat.ModEq.symm (Nat.mod_modEq c s))).symm
    · intro z hz
      obtain ⟨c, hc, rfl⟩ := Finset.mem_image.mp hz
      rw [Finset.mem_range] at hc
      exact Finset.mem_image.mpr ⟨c, Finset.mem_range.mpr (lt_of_lt_of_le hc (min_le_left _ _)), rfl⟩
  have hinj : Set.InjOn (combLabel B r x0) (Finset.range D) := by
    intro c hc c' hc' h
    rw [Finset.coe_range, Set.mem_Iio] at hc hc'
    have hcs : c < s := lt_of_lt_of_le hc (min_le_right _ _)
    have hcs' : c' < s := lt_of_lt_of_le hc' (min_le_right _ _)
    rw [combLabel, combLabel, sub_right_inj] at h
    have := modEq_of_natCast_mul_eq hr h
    rw [Nat.ModEq, Nat.mod_eq_of_lt hcs, Nat.mod_eq_of_lt hcs'] at this
    exact this
  rw [hrange, Finset.card_image_of_injOn hinj, Finset.card_range]

/-- **The exact Schmidt rank of the comb at an arbitrary cut** of a register
whose low half is at least as long as the period. -/
theorem schmidtRank_combCut_sharp (hamp : amp ≠ 0) (hr : 0 < r) (hB : r ≤ B) :
    schmidtRank (combCutMatrix B C r x0 amp) = min C (cutPeriod r B) := by
  classical
  rw [combCutMatrix_eq_matchMatrix, schmidtRank_matchMatrix hamp, matchSet,
    image_combLeft_eq_univ hB, Finset.univ_inter, image_combRight_eq_range,
    card_image_combLabel hr]

/-- The coprime case: the rank is the full order (given a long enough high
half).  This recovers `schmidtRank_combCut_eq`. -/
theorem schmidtRank_combCut_eq_of_coprime (hamp : amp ≠ 0) (hr : 0 < r) (hB : r ≤ B)
    (hC : r ≤ C) (hcop : Nat.Coprime B r) :
    schmidtRank (combCutMatrix B C r x0 amp) = r := by
  have hg : Nat.gcd r B = 1 := by
    rw [Nat.gcd_comm]
    exact hcop
  rw [schmidtRank_combCut_sharp hamp hr hB, cutPeriod, hg, Nat.div_one, min_eq_right hC]

/-- The degenerate case: if the block size is a multiple of the order the state
factorizes across the cut. -/
theorem schmidtRank_combCut_of_dvd (hamp : amp ≠ 0) (hr : 0 < r) (hB : r ≤ B) (hC : 0 < C)
    (hdvd : r ∣ B) :
    schmidtRank (combCutMatrix B C r x0 amp) = 1 := by
  have hg : Nat.gcd r B = r := Nat.gcd_eq_left hdvd
  rw [schmidtRank_combCut_sharp hamp hr hB, cutPeriod, hg, Nat.div_self hr,
    min_eq_right hC]

/-- **The exact bond-dimension threshold at a cut.**  No MPS representation of
the comb across the cut exists below bond dimension `min C (r / gcd(r,B))`. -/
theorem not_hasBondDim_combCut_sharp (hamp : amp ≠ 0) (hr : 0 < r) (hB : r ≤ B) {χ : ℕ}
    (hχ : χ < min C (cutPeriod r B)) : ¬ HasBondDim (combCutMatrix B C r x0 amp) χ := by
  intro h
  have := schmidtRank_le_of_hasBondDim h
  rw [schmidtRank_combCut_sharp hamp hr hB] at this
  exact absurd this (not_le.mpr hχ)

/-- **Cheap cuts need a large common factor.**  If some cut of the comb admits a
bond dimension `χ` smaller than the number of blocks, then `gcd(r, B) ≥ r / χ`:
a low-rank cut forces the block size to resolve almost all of the period.  For a
power-of-two register this means the order has a large power-of-two part — the
classically easy regime. -/
theorem le_gcd_mul_of_hasBondDim (hamp : amp ≠ 0) (hr : 0 < r) (hB : r ≤ B) {χ : ℕ}
    (hχC : χ < C) (h : HasBondDim (combCutMatrix B C r x0 amp) χ) :
    r ≤ Nat.gcd r B * χ := by
  have hrank := schmidtRank_le_of_hasBondDim h
  rw [schmidtRank_combCut_sharp hamp hr hB] at hrank
  have hle : cutPeriod r B ≤ χ := by
    rcases min_cases C (cutPeriod r B) with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · omega
    · omega
  calc r = Nat.gcd r B * (r / Nat.gcd r B) :=
        (Nat.mul_div_cancel' (Nat.gcd_dvd_left r B)).symm
    _ ≤ Nat.gcd r B * χ := Nat.mul_le_mul_left _ hle

end SharpRank

end ShorIrreducible