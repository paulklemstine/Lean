/-
# The interval topology on surreal numbers

The proposed topology generated by open intervals is exactly the order topology.  Contrary to the
mission's conjecture, this topology is totally separated, not connected, and not contractible.
This file builds on the existing surreal topology development and adds the missing local
compactness obstruction: no surreal has a compact neighbourhood.
-/

import Algebra.SurrealTopologyConnector

open Set Filter
open scoped Topology

namespace SurrealTopologyNovelty

open SurrealTopologyConnector

namespace Surreal

/-- The chosen topology is the topology generated by order intervals. -/
theorem interval_topology_is_order_topology :
    (inferInstance : TopologicalSpace Surreal.{0}) = Preorder.topology Surreal.{0} := by
  rfl

/-- Open intervals with surreal endpoints form a neighbourhood basis at every surreal. -/
theorem interval_neighborhood_basis (x : Surreal.{0}) :
    (𝓝 x).HasBasis (fun p : Surreal.{0} × Surreal.{0} => p.1 < x ∧ x < p.2)
      (fun p => Ioo p.1 p.2) := by
  simpa only [Prod.exists] using (nhds_basis_Ioo x)

/-- The positive natural multiples of a fixed surreal step. -/
def NaturalStepSet (ε : Surreal.{0}) : Set Surreal.{0} :=
  Set.range fun n : ℕ => (n : Surreal.{0}) * ε

/-- Every natural step belongs to the clopen ray reached by finitely many steps. -/
theorem naturalStepSet_subset_finiteStepRay {ε : Surreal.{0}} (hε : 0 < ε) :
    NaturalStepSet ε ⊆ SurrealTopologyConnector.Surreal.FiniteStepRay 0 ε := by
  rintro _ ⟨n, rfl⟩
  refine ⟨n + 1, ?_⟩
  push_cast
  simp only [zero_add]
  nlinarith

/-- Inside the finite-step ray, finitely many early multiples can be removed to obtain a
neighbourhood avoiding every natural multiple. -/
theorem naturalStepSet_compl_mem_nhds_of_mem_ray {ε y : Surreal.{0}} (hε : 0 < ε)
    (hy : y ∉ NaturalStepSet ε)
    (hyray : y ∈ SurrealTopologyConnector.Surreal.FiniteStepRay 0 ε) :
    (NaturalStepSet ε)ᶜ ∈ 𝓝 y := by
  obtain ⟨N, hyN⟩ := hyray
  simp only [zero_add] at hyN
  let F : Set Surreal.{0} := ↑((Finset.range N).image fun n : ℕ => (n : Surreal.{0}) * ε)
  have hFclosed : IsClosed F := (Finset.finite_toSet _).isClosed
  have hyF : y ∈ Fᶜ := by
    intro hy'
    apply hy
    simp only [F, Finset.mem_coe, Finset.mem_image] at hy'
    obtain ⟨n, _, hn⟩ := hy'
    exact ⟨n, hn⟩
  have hIio : Iio ((N : Surreal.{0}) * ε) ∈ 𝓝 y := isOpen_Iio.mem_nhds hyN
  have hFc : Fᶜ ∈ 𝓝 y := hFclosed.isOpen_compl.mem_nhds hyF
  apply mem_of_superset (inter_mem hIio hFc)
  rintro z ⟨hzN, hzF⟩ ⟨n, rfl⟩
  by_cases hn : n < N
  · apply hzF
    simp only [F, Finset.mem_coe, Finset.mem_image]
    exact ⟨n, Finset.mem_range.mpr hn, rfl⟩
  · have hNn : (N : Surreal.{0}) ≤ n := by exact_mod_cast Nat.le_of_not_gt hn
    exact (not_le_of_gt hzN) (mul_le_mul_of_nonneg_right hNn hε.le)

/-- A point outside the natural-step set has a neighbourhood disjoint from it. -/
theorem naturalStepSet_compl_mem_nhds {ε y : Surreal.{0}} (hε : 0 < ε)
    (hy : y ∉ NaturalStepSet ε) : (NaturalStepSet ε)ᶜ ∈ 𝓝 y := by
  by_cases hyray : y ∈ SurrealTopologyConnector.Surreal.FiniteStepRay 0 ε
  · exact naturalStepSet_compl_mem_nhds_of_mem_ray hε hy hyray
  · apply mem_of_superset
      ((SurrealTopologyConnector.Surreal.finiteStepRay_isClosed 0 ε hε).isOpen_compl.mem_nhds
        (by simpa))
    intro z hz hstep
    exact hz (naturalStepSet_subset_finiteStepRay hε hstep)

/-- For a positive step, its natural multiples form a closed subset of the surreal line. -/
theorem naturalStepSet_isClosed {ε : Surreal.{0}} (hε : 0 < ε) :
    IsClosed (NaturalStepSet ε) := by
  rw [← isOpen_compl_iff]
  exact isOpen_iff_mem_nhds.mpr fun y hy => naturalStepSet_compl_mem_nhds hε hy

/-- Natural multiples of a positive step have no greatest element. -/
theorem naturalStepSet_no_greatest {ε : Surreal.{0}} (hε : 0 < ε) :
    ¬ ∃ z, IsGreatest (NaturalStepSet ε) z := by
  rintro ⟨z, hzmem, hzmax⟩
  obtain ⟨n, rfl⟩ := hzmem
  have hnext : ((n + 1 : ℕ) : Surreal.{0}) * ε ∈ NaturalStepSet ε :=
    ⟨n + 1, rfl⟩
  have hle := hzmax hnext
  push_cast at hle
  nlinarith

/-- A compact set cannot contain all natural multiples of a positive surreal step. -/
theorem compact_not_contains_naturalStepSet {K : Set Surreal.{0}} (hK : IsCompact K)
    {ε : Surreal.{0}} (hε : 0 < ε) : ¬ NaturalStepSet ε ⊆ K := by
  intro hsub
  have hstep_compact : IsCompact (NaturalStepSet ε) :=
    hK.of_isClosed_subset (naturalStepSet_isClosed hε) hsub
  have hstep_nonempty : (NaturalStepSet ε).Nonempty := ⟨0, ⟨0, by simp⟩⟩
  exact naturalStepSet_no_greatest hε (hstep_compact.exists_isGreatest hstep_nonempty)

/-- No surreal number has a compact neighbourhood in the interval topology. -/
theorem no_compact_neighborhood (x : Surreal.{0}) :
    ¬ ∃ K : Set Surreal.{0}, K ∈ 𝓝 x ∧ IsCompact K := by
  rintro ⟨K, hK_nhds, hK_compact⟩
  obtain ⟨⟨a, b⟩, ⟨hax, hxb⟩, habK⟩ := (interval_neighborhood_basis x).mem_iff.mp hK_nhds
  obtain ⟨ε, hε, hε_small⟩ :=
    SurrealTopologyConnector.Surreal.exists_infinitesimal_below (sub_pos.mpr hxb)
  let T : Surreal.{0} ≃ₜ Surreal.{0} := Homeomorph.addRight (-x)
  have hTK : IsCompact (T '' K) := hK_compact.image T.continuous
  apply compact_not_contains_naturalStepSet hTK hε
  intro y hy
  obtain ⟨n, rfl⟩ := hy
  refine ⟨x + (n : Surreal.{0}) * ε, habK ?_, ?_⟩
  · constructor
    · exact hax.trans_le (le_add_of_nonneg_right (mul_nonneg (Nat.cast_nonneg n) hε.le))
    · linarith [hε_small n]
  · simp [T, add_assoc]

/-- The interval-topological surreal line is not locally compact. -/
theorem not_locallyCompactSpace : ¬ LocallyCompactSpace Surreal.{0} := by
  intro h
  letI : LocallyCompactSpace Surreal.{0} := h
  obtain ⟨K, hK, hKx⟩ := exists_compact_mem_nhds (0 : Surreal.{0})
  exact no_compact_neighborhood 0 ⟨K, hKx, hK⟩

/-- The interval topology on surreals is disconnected (indeed, totally separated). -/
theorem interval_topology_not_connected : ¬ ConnectedSpace Surreal.{0} :=
  SurrealTopologyConnector.Surreal.not_connectedSpace

/-- The interval topology on surreals is not contractible. -/
theorem interval_topology_not_contractible : ¬ ContractibleSpace Surreal.{0} :=
  SurrealTopologyConnector.Surreal.not_contractibleSpace

/-- Every loop class is the identity, although the space is not contractible. -/
theorem interval_topology_piOne_trivial (x : Surreal.{0})
    (γ : FundamentalGroup Surreal.{0} x) : γ = 1 :=
  SurrealTopologyConnector.Surreal.fundamentalGroup_eq_one x γ

/-- Every continuous path in the interval topology has equal endpoints. -/
theorem interval_topology_paths_are_constant_at_endpoints
    {x y : Surreal.{0}} (p : Path x y) : x = y :=
  SurrealTopologyConnector.Surreal.path_eq_endpoints p

end Surreal

end SurrealTopologyNovelty