import Mathlib
import Catalog.Cryptography.BraidGroup
import Catalog.Bridges.GroupTheoryBridge

/-! # Topological Quantum Compiling: Algebraic and Topological Certificates

A finite collection of gates determines an algebraic subgroup, while universality is a
statement about its topological closure.  This chapter isolates rigorous certificates for
three logically distinct steps: generation, infinitude, and density.  The results apply to
braid representations without assuming a particular normalization of the Jones matrices.
-/

open Set

namespace TopologicalQuantumCompiling

variable {G : Type*} [Group G]

/-- The subgroup algebraically generated by a family of gates. -/
def gateGroup {ι : Type*} (gate : ι → G) : Subgroup G :=
  Subgroup.closure (Set.range gate)

/-
Every listed gate belongs to the subgroup generated by the list.
-/
lemma gate_mem_gateGroup {ι : Type*} (gate : ι → G) (i : ι) :
    gate i ∈ gateGroup gate := by
  exact Subgroup.subset_closure ( Set.mem_range_self i )

/-
A subgroup contains all generated gates exactly when it contains the generated subgroup.
-/
theorem gateGroup_le_iff {ι : Type*} (gate : ι → G) (H : Subgroup G) :
    gateGroup gate ≤ H ↔ ∀ i, gate i ∈ H := by
  unfold gateGroup;
  simp +decide [ Subgroup.closure_le, Set.range_subset_iff ]

/-
A homomorphism carries every word in the generated gate group into the group generated
by the image gates.  This connects symbolic braid words with their represented gates.
-/
theorem map_gateGroup_le {ι : Type*} {H : Type*} [Group H]
    (ρ : G →* H) (gate : ι → G) :
    (gateGroup gate).map ρ ≤ gateGroup (fun i => ρ (gate i)) := by
  simp +decide [ gateGroup, Subgroup.map_le_iff_le_comap ];
  exact Set.range_subset_iff.2 fun i => Subgroup.subset_closure ⟨ i, rfl ⟩

section Topology

variable [TopologicalSpace G] [IsTopologicalGroup G]

/-
Density is equivalent to the absence of a proper closed subgroup containing all gates.
This is the precise closed-subgroup criterion needed in universality arguments.
-/
theorem dense_iff_no_proper_closed_supergroup {ι : Type*} (gate : ι → G) :
    (gateGroup gate).topologicalClosure = ⊤ ↔
      ∀ K : Subgroup G, IsClosed (K : Set G) → (∀ i, gate i ∈ K) → K = ⊤ := by
  refine' ⟨ fun h K hK hK' => _, fun h => _ ⟩;
  · refine' eq_top_iff.mpr _;
    rw [ ← h ];
    exact closure_minimal ( fun x hx => by exact Subgroup.closure_induction ( fun x hx => by aesop ) ( by aesop ) ( by aesop ) ( by aesop ) hx ) hK;
  · refine' h _ _ _;
    · exact isClosed_closure;
    · exact fun i => subset_closure ( gate_mem_gateGroup gate i )

/-
A dense generated subgroup meets every nonempty open target region.  Thus density yields
arbitrarily accurate gate synthesis once metric balls are chosen as target regions.
-/
theorem dense_gateGroup_hits_open {ι : Type*} {gate : ι → G}
    (hdense : (gateGroup gate).topologicalClosure = ⊤)
    {U : Set G} (hUopen : IsOpen U) (hUne : U.Nonempty) :
    ∃ w : G, w ∈ gateGroup gate ∧ w ∈ U := by
  obtain ⟨ x, hx ⟩ := hUne;
  have h_dense : Dense (gateGroup gate : Set G) := by
    rw [ SetLike.ext_iff ] at hdense;
    exact fun x => hdense x |>.2 trivial;
  exact h_dense.inter_nhds_nonempty ( hUopen.mem_nhds hx )

end Topology

/-
An injective integer-power orbit is an infinitude certificate for every subgroup
containing the certified element.
-/
theorem subgroup_infinite_of_injective_zpowers (S : Subgroup G) (x : G) (hx : x ∈ S)
    (hinj : Function.Injective (fun n : ℤ => x ^ n)) : Set.Infinite (S : Set G) := by
  exact Set.infinite_of_injective_forall_mem hinj fun n => zpow_mem hx n

/-
If a represented braid word has distinct integer powers, then the represented braid
subgroup is infinite.  This formalizes the proposed infinite-order test independently of
matrix coordinates.
-/
theorem braid_image_infinite_of_word
    {H : Type*} [Group H] (ρ : BraidGroup.BraidGrp 3 →* H)
    (b : BraidGroup.BraidGrp 3)
    (hinj : Function.Injective (fun n : ℤ => (ρ b) ^ n)) :
    Set.Infinite ((⊤ : Subgroup (BraidGroup.BraidGrp 3)).map ρ : Set H) := by
  apply Set.infinite_of_injective_forall_mem hinj;
  exact fun n => ⟨ b ^ n, by simp +decide ⟩

/-
Specialization of the preceding certificate to the product of the three Artin
generators of the four-strand braid group.
-/
theorem braid4_generator_product_certificate
    {H : Type*} [Group H] (ρ : BraidGroup.BraidGrp 3 →* H)
    (hinj : Function.Injective (fun n : ℤ =>
      (ρ (BraidGroup.sigma (0 : Fin 3) * BraidGroup.sigma (1 : Fin 3) *
        BraidGroup.sigma (2 : Fin 3))) ^ n)) :
    Set.Infinite ((⊤ : Subgroup (BraidGroup.BraidGrp 3)).map ρ : Set H) := by
  convert braid_image_infinite_of_word ρ ( BraidGroup.sigma 0 * BraidGroup.sigma 1 * BraidGroup.sigma 2 ) hinj using 1

/-- The dimension expression stated in the motivating proposal evaluates to thirteen,
not three, at the stated parameters.  Consequently that expression cannot define the
three-dimensional Fibonacci sector without an additional sector restriction. -/
lemma proposed_dimension_formula_mismatch :
    (5 - 1) * (4 - 1) + 1 = 13 ∧ (5 - 1) * (4 - 1) + 1 ≠ 3 := by
  norm_num

-- !-- Lab Notes -- !--
/-
Hypothesis.  Universality should be split into an algebraic generation statement, an
infinite-order certificate, and a topological maximality statement.  Conflating these
steps obscures what a numerical matrix calculation can establish.

Experiment.  The algebraic braid-group construction supplies the four-strand domain as
`BraidGrp 3`.  We tested an abstract represented word and replaced
finite-order numerical heuristics by injectivity of its full integer-power orbit.

Analysis.  Infinite order proves only that the image is infinite; it does not imply
density.  Density follows exactly when every closed subgroup containing the gates is the
whole ambient group.  Once this is known, every nonempty open approximation target contains
a generated word.

Critique.  The proposed dimension formula evaluates to thirteen at k = 5 and n = 4, not
three, so it cannot simultaneously describe the asserted representation.  Moreover, the
Solovay--Kitaev theorem converts an already dense inverse-closed gate set into an efficient
approximation algorithm; it is not a density test.  No concrete Jones normalization was
specified, so no claim about particular 3 by 3 matrices is made here.

Synthesis.  The resulting certificates are normalization-independent and expose the two
missing obligations for a concrete Fibonacci representation: prove injectivity of the
integer-power orbit of a chosen braid, and classify closed subgroups containing the three
generator images.
-/
-- !-- Lab Notes -- !--

end TopologicalQuantumCompiling