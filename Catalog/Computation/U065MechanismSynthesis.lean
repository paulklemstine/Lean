/-
# U065 — Synthesis: the divisibility mixture *is* a Dickman hump, and it survives
every single-covariate removal

`U065QRMixture` computes the arithmetic of the mixture exactly, `U065NoSingleCarrier`
bounds each prime's share of it, and `U065DickmanHump` converts a hump amplitude over
an exact Dickman baseline into a mixture spread.  This file joins the three.

Main statements.

* `mixture_hump_calibration` — the log-amplitude `A` produced by the quadratic-residue
  divisibility mixture is realised exactly as a two-point Dickman hump of spread
  `calibratedSpread u A ∈ (0, u)`.  So the observed "hump over exact Dickman baseline"
  and the "divisibility-mixture baseline" are two descriptions of one object.
* `calibratedSpread_lt_calibratedSpread` — the calibration is strictly monotone, hence a
  *smaller* amplitude means a strictly *smaller* spread: amplitudes are comparable.
* `residual_amplitude_ge_half` and `residual_hump_pos` — after conditioning away any
  single prime (any single per-hit binary covariate) at least half of the amplitude
  remains, and the residual hump is still a genuine hump with a strictly positive
  calibrated spread.  This is the formal content of the experimental `removal_pct = 0`
  table: the per-hit binary covariate family cannot carry the feature.
-/
import Computation.U065NoSingleCarrier
import Computation.U065DickmanHump

namespace U065

open Finset

section Synthesis

variable {ι : Type*} [Fintype ι]

/-- Amplitude that remains after conditioning away the single prime `Q j`. -/
noncomputable def residualAmplitude (Q : ι → ℕ) [∀ i, Fact (Q i).Prime] (c : ℝ) (j : ι) : ℝ :=
  humpLogAmplitude Q c - logExcess (Q j) c

/-- **The divisibility mixture is exactly a Dickman hump.**  The amplitude generated by
the quadratic-residue mixture over odd primes is realised by a two-point mixture of the
Dickman argument with an admissible spread. -/
theorem mixture_hump_calibration (Q : ι → ℕ) [∀ i, Fact (Q i).Prime] (hQ : ∀ i, Q i ≠ 2)
    {c u : ℝ} (hc : 0 < c) (hc1 : c ≠ 1) (hu : 0 < u) [Nonempty ι] :
    calibratedSpread u (humpLogAmplitude Q c) ∈ Set.Ioo 0 u ∧
      humpAmp u (calibratedSpread u (humpLogAmplitude Q c)) = humpLogAmplitude Q c := by
  have hA : 0 < humpLogAmplitude Q c := humpLogAmplitude_pos Q hQ hc hc1
  exact ⟨calibratedSpread_mem_Ioo hu hA, humpAmp_calibratedSpread hu hA⟩

/-- Strict monotonicity of the calibration: a larger hump amplitude corresponds to a
strictly larger mixture spread. -/
theorem calibratedSpread_lt_calibratedSpread {u A B : ℝ} (hu : 0 < u) (hA : 0 < A)
    (hAB : A < B) : calibratedSpread u A < calibratedSpread u B := by
  have hB : 0 < B := lt_trans hA hAB
  have hmemA := calibratedSpread_mem_Ioo hu hA
  have hmemB := calibratedSpread_mem_Ioo hu hB
  have hIcoA : calibratedSpread u A ∈ Set.Ico (0 : ℝ) u :=
    ⟨le_of_lt hmemA.1, hmemA.2⟩
  have hIcoB : calibratedSpread u B ∈ Set.Ico (0 : ℝ) u :=
    ⟨le_of_lt hmemB.1, hmemB.2⟩
  by_contra hcon
  push_neg at hcon
  rcases lt_or_eq_of_le hcon with h | h
  · have hlt := humpAmp_strictMonoOn hu hIcoB hIcoA h
    simp only [humpAmp_calibratedSpread hu hA, humpAmp_calibratedSpread hu hB] at hlt
    linarith
  · have : humpAmp u (calibratedSpread u B) = humpAmp u (calibratedSpread u A) := by rw [h]
    rw [humpAmp_calibratedSpread hu hA, humpAmp_calibratedSpread hu hB] at this
    linarith

/-- **At least half of the hump survives any single-covariate removal** (three or more
small primes in the mixture). -/
theorem residual_amplitude_ge_half (Q : ι → ℕ) [∀ i, Fact (Q i).Prime] (hQ : ∀ i, Q i ≠ 2)
    {c : ℝ} (hc : 0 < c) (hcard : 3 ≤ Fintype.card ι) (j : ι) :
    (1 / 2 : ℝ) * humpLogAmplitude Q c ≤ residualAmplitude Q c j := by
  have h := no_single_carrier Q hQ hc hcard j
  rw [residualAmplitude]
  linarith

/-- **The residual hump is still a hump.**  After removing any single prime the
remaining amplitude is strictly positive and its calibrated Dickman spread is a genuine
admissible spread; moreover it is strictly smaller than the full spread whenever the
removed prime contributed anything. -/
theorem residual_hump_pos (Q : ι → ℕ) [∀ i, Fact (Q i).Prime] (hQ : ∀ i, Q i ≠ 2)
    {c u : ℝ} (hc : 0 < c) (hc1 : c ≠ 1) (hu : 0 < u) (hcard : 3 ≤ Fintype.card ι) (j : ι) :
    0 < residualAmplitude Q c j ∧
      calibratedSpread u (residualAmplitude Q c j) ∈ Set.Ioo 0 u ∧
      humpAmp u (calibratedSpread u (residualAmplitude Q c j)) = residualAmplitude Q c j := by
  have hne : Nonempty ι := ⟨j⟩
  have hA : 0 < humpLogAmplitude Q c := humpLogAmplitude_pos Q hQ hc hc1
  have hhalf := residual_amplitude_ge_half Q hQ hc hcard j
  have hpos : 0 < residualAmplitude Q c j := by linarith
  exact ⟨hpos, calibratedSpread_mem_Ioo hu hpos, humpAmp_calibratedSpread hu hpos⟩

/-- Quantitative form of "the covariate family is removed from the search space": the
spread inferred after any single-prime removal is at least the spread that half the
amplitude already forces. -/
theorem residual_spread_ge (Q : ι → ℕ) [∀ i, Fact (Q i).Prime] (hQ : ∀ i, Q i ≠ 2)
    {c u : ℝ} (hc : 0 < c) (hc1 : c ≠ 1) (hu : 0 < u) (hcard : 3 ≤ Fintype.card ι) (j : ι) :
    calibratedSpread u ((1 / 2 : ℝ) * humpLogAmplitude Q c)
      ≤ calibratedSpread u (residualAmplitude Q c j) := by
  have hne : Nonempty ι := ⟨j⟩
  have hA : 0 < humpLogAmplitude Q c := humpLogAmplitude_pos Q hQ hc hc1
  have hhalf := residual_amplitude_ge_half Q hQ hc hcard j
  have hhalfpos : 0 < (1 / 2 : ℝ) * humpLogAmplitude Q c := by linarith
  rcases lt_or_eq_of_le hhalf with h | h
  · exact (calibratedSpread_lt_calibratedSpread hu hhalfpos h).le
  · rw [h]

end Synthesis

end U065