import Mathlib

/-!
# Automatic Sequences: Decidability and the Finite Kernel Theorem

## Overview

We formalize the decidability theory of k-automatic sequences, proving that
fundamental decision problems are decidable for sequences generated by
Deterministic Finite Automata with Output (DFAOs).

## Main Results

* `DFAO.output_range_finite` — The output range of a DFAO is finite
* `DFAO.eval_value_mem_output_image` — Every output value comes from a state's output
* `DFAO.levelSet_state_determined` — Level sets are determined by final state
* `kAutomatic_closure_pointwise` — Closure under pointwise operations
* `kKernel_closed` — The k-kernel is closed under subsequence extraction
* `thueMorse_both_values_infinite` — Thue-Morse outputs both 0 and 1 infinitely often
* `thueMorse_not_eventually_periodic` — Thue-Morse is aperiodic
-/

open Finset Function Set

namespace AutoSeqDecide

/-! ## Part 1: DFAO — Deterministic Finite Automaton with Output -/

/-- A Deterministic Finite Automaton with Output (DFAO). -/
structure DFAO (σ : Type*) (k : ℕ) (α : Type*) where
  transition : σ → Fin k → σ
  initial : σ
  output : σ → α

variable {σ : Type*} {k : ℕ} {α : Type*}

/-- Run a DFAO from state `s` on input word `w`. -/
def DFAO.runFrom (M : DFAO σ k α) (s : σ) : List (Fin k) → σ
  | [] => s
  | d :: ds => M.runFrom (M.transition s d) ds

/-- Run from initial state. -/
def DFAO.run (M : DFAO σ k α) (w : List (Fin k)) : σ :=
  M.runFrom M.initial w

/-- Evaluate: run and read the output. -/
def DFAO.eval (M : DFAO σ k α) (w : List (Fin k)) : α :=
  M.output (M.run w)

@[simp]
theorem DFAO.runFrom_nil (M : DFAO σ k α) (s : σ) :
    M.runFrom s [] = s := rfl

@[simp]
theorem DFAO.runFrom_cons (M : DFAO σ k α) (s : σ) (d : Fin k) (ds : List (Fin k)) :
    M.runFrom s (d :: ds) = M.runFrom (M.transition s d) ds := rfl

theorem DFAO.runFrom_append (M : DFAO σ k α) (s : σ) (xs ys : List (Fin k)) :
    M.runFrom s (xs ++ ys) = M.runFrom (M.runFrom s xs) ys := by
  induction xs generalizing s with
  | nil => simp
  | cons d ds ih => simp [ih]

theorem DFAO.run_append (M : DFAO σ k α) (xs ys : List (Fin k)) :
    M.run (xs ++ ys) = M.runFrom (M.run xs) ys :=
  DFAO.runFrom_append M M.initial xs ys

/-! ## Part 2: Output Range Finiteness and Decidability -/

/-- Every evaluation result comes from the output function applied to some state. -/
theorem DFAO.eval_value_mem_output_image [Fintype σ] [DecidableEq α] (M : DFAO σ k α)
    (w : List (Fin k)) :
    M.eval w ∈ Finset.image M.output Finset.univ :=
  Finset.mem_image_of_mem _ (Finset.mem_univ _)

/-- The set of all possible output values is finite. -/
theorem DFAO.output_range_finite [Fintype σ] (M : DFAO σ k α) :
    Set.Finite (Set.range M.eval) :=
  Set.Finite.subset (Set.toFinite (Set.range M.output))
    (Set.range_subset_iff.2 fun w => ⟨M.run w, rfl⟩)

/-
If v is not in the image of the output function, then v never appears
    as an evaluation result. This gives one direction of decidability:
    checking the output image is a sound method for ruling out values.
-/
theorem DFAO.not_in_output_image_implies_not_eval [Fintype σ] [DecidableEq α]
    (M : DFAO σ k α) (v : α) (hv : v ∉ Finset.image M.output Finset.univ) :
    ¬ ∃ w : List (Fin k), M.eval w = v := by
  simp_all +decide [ DFAO.eval ]

/-! ## Part 3: Level Sets and State Determination -/

/-- The level set of a DFAO value v. -/
def DFAO.levelSet (M : DFAO σ k α) (v : α) : Set (List (Fin k)) :=
  { w | M.eval w = v }

/-
**Regularity of level sets**: Whether a word is in the level set depends
    only on the final state reached, not on the specific word.
    This structural property is what makes level sets regular languages.
-/
theorem DFAO.levelSet_state_determined (M : DFAO σ k α) (v : α)
    (w₁ w₂ : List (Fin k)) (h : M.run w₁ = M.run w₂) :
    (w₁ ∈ M.levelSet v ↔ w₂ ∈ M.levelSet v) := by
  unfold DFAO.levelSet; simp +decide [ h ] ;
  unfold DFAO.eval; aesop;

/-
The level set decomposes as a union over accepting states.
-/
theorem DFAO.levelSet_eq_union [Fintype σ] [DecidableEq α] (M : DFAO σ k α) (v : α) :
    M.levelSet v = ⋃ s ∈ (Finset.univ.filter (fun s => M.output s = v)),
      { w | M.run w = s } := by
  ext w
  simp [DFAO.levelSet, DFAO.eval]

/-! ## Part 4: Product Construction and Closure -/

variable {σ₁ σ₂ : Type*} {β : Type*}

/-- Product of two DFAOs. -/
def DFAO.product (M₁ : DFAO σ₁ k α) (M₂ : DFAO σ₂ k β) :
    DFAO (σ₁ × σ₂) k (α × β) where
  transition := fun ⟨s₁, s₂⟩ d => (M₁.transition s₁ d, M₂.transition s₂ d)
  initial := (M₁.initial, M₂.initial)
  output := fun ⟨s₁, s₂⟩ => (M₁.output s₁, M₂.output s₂)

/-- Product correctly tracks both components. -/
theorem DFAO.product_runFrom (M₁ : DFAO σ₁ k α) (M₂ : DFAO σ₂ k β)
    (s₁ : σ₁) (s₂ : σ₂) (w : List (Fin k)) :
    (M₁.product M₂).runFrom (s₁, s₂) w = (M₁.runFrom s₁ w, M₂.runFrom s₂ w) := by
  induction w generalizing s₁ s₂ with
  | nil => rfl
  | cons d ds ih => exact ih _ _

/-- Product correctly evaluates to the pair. -/
theorem DFAO.product_eval (M₁ : DFAO σ₁ k α) (M₂ : DFAO σ₂ k β)
    (w : List (Fin k)) :
    (M₁.product M₂).eval w = (M₁.eval w, M₂.eval w) := by
  unfold DFAO.eval DFAO.run
  rw [show (M₁.product M₂).initial = (M₁.initial, M₂.initial) from rfl]
  rw [DFAO.product_runFrom]
  rfl

/-- Post-compose the output of a DFAO. -/
def DFAO.mapOutput (M : DFAO σ k α) (f : α → β) : DFAO σ k β where
  transition := M.transition
  initial := M.initial
  output := f ∘ M.output

theorem DFAO.mapOutput_runFrom (M : DFAO σ k α) (f : α → β) (s : σ)
    (w : List (Fin k)) :
    (M.mapOutput f).runFrom s w = M.runFrom s w := by
  induction w generalizing s with
  | nil => rfl
  | cons d ds ih => exact ih _

theorem DFAO.mapOutput_eval (M : DFAO σ k α) (f : α → β) (w : List (Fin k)) :
    (M.mapOutput f).eval w = f (M.eval w) := by
  unfold DFAO.eval DFAO.run
  rw [show (M.mapOutput f).initial = M.initial from rfl]
  conv_lhs => rw [show (M.mapOutput f).output = f ∘ M.output from rfl]
  rw [DFAO.mapOutput_runFrom]
  rfl

/-! ## Part 5: Closure of k-Automatic Sequences -/

/-- Convert ℕ to base-k digits (least significant first). -/
def toBaseK (k : ℕ) (hk : 2 ≤ k) : ℕ → List (Fin k)
  | 0 => []
  | m + 1 =>
    have h1 : (m + 1) / k < m + 1 := Nat.div_lt_self (by omega) (by omega)
    ⟨(m + 1) % k, Nat.mod_lt _ (by omega)⟩ :: toBaseK k hk ((m + 1) / k)

/-- The ℕ-indexed sequence generated by a DFAO. -/
def DFAO.sequence (M : DFAO σ k α) (hk : 2 ≤ k) (m : ℕ) : α :=
  M.eval (toBaseK k hk m)

/-- A sequence is k-automatic if it arises from a DFAO. -/
def IsKAutomatic (k : ℕ) (hk : 2 ≤ k) (seq : ℕ → α) : Prop :=
  ∃ (σ : Type) (_ : Fintype σ) (M : DFAO σ k α), ∀ m, M.sequence hk m = seq m

/-
**Closure Theorem**: k-automatic sequences are closed under
    pointwise application of any function. If f, g are k-automatic,
    then n ↦ h(f(n), g(n)) is k-automatic for any h.

    Proof: Given DFAOs M₁, M₂ generating f, g, the product DFAO
    M₁ × M₂ generates (f, g). Composing with h via mapOutput
    gives a DFAO for n ↦ h(f(n), g(n)).
-/
theorem kAutomatic_closure_pointwise {γ : Type*} {k : ℕ} (hk : 2 ≤ k)
    (f : ℕ → α) (g : ℕ → β) (h : α → β → γ)
    (hf : IsKAutomatic k hk f) (hg : IsKAutomatic k hk g) :
    IsKAutomatic k hk (fun n => h (f n) (g n)) := by
  obtain ⟨ σ₁, hσ₁, M₁, hM₁ ⟩ := hf;
  -- We need to show that the pointwise application of h is k-automatic.
  -- We can use the product construction and mapOutput to obtain a DFAO for h(f(n), g(n)).
  obtain ⟨ σ₂, hσ₂, M₂, hM₂ ⟩ := hg;
  use σ₁ × σ₂, by infer_instance, (M₁.product M₂).mapOutput (fun p => h p.1 p.2);
  simp +decide [ ← hM₁, ← hM₂, DFAO.sequence, DFAO.mapOutput_eval, DFAO.product_eval ]

/-! ## Part 6: The k-Kernel -/

/-- The k-kernel of a sequence: all subsequences n ↦ seq(k^e · n + r). -/
def kKernel (k : ℕ) (seq : ℕ → α) : Set (ℕ → α) :=
  { f | ∃ e r, r < k ^ e ∧ f = fun m => seq (k ^ e * m + r) }

/-- The sequence itself is in its k-kernel (with e=0, r=0). -/
theorem seq_mem_kKernel (k : ℕ) (hk : 1 ≤ k) (seq : ℕ → α) :
    seq ∈ kKernel k seq :=
  ⟨0, 0, by simp, by simp⟩

/-
**Kernel Closure**: The k-kernel is closed under one-step subsequence
    extraction. If f ∈ kernel(seq) and j < k, then n ↦ f(kn + j) ∈ kernel(seq).

    Proof: if f(n) = seq(k^e · n + r) with r < k^e, then
    f(k·n + j) = seq(k^e · (k·n + j) + r) = seq(k^(e+1) · n + k^e · j + r).
    Since j < k and r < k^e, we have k^e · j + r < k^e · k = k^(e+1).
-/
theorem kKernel_closed (k : ℕ) (hk : 2 ≤ k) (seq : ℕ → α)
    (f : ℕ → α) (hf : f ∈ kKernel k seq) (j : ℕ) (hj : j < k) :
    (fun n => f (k * n + j)) ∈ kKernel k seq := by
  obtain ⟨ e, r, hr, rfl ⟩ := hf;
  refine' ⟨ e + 1, k ^ e * j + r, _, _ ⟩ <;> ring_nf;
  nlinarith

/-! ## Part 7: Thue-Morse Sequence -/

/-- Binary digit sum (popcount). -/
def bitSum : ℕ → ℕ
  | 0 => 0
  | m + 1 =>
    have : (m + 1) / 2 < m + 1 := Nat.div_lt_self (by omega) (by omega)
    ((m + 1) % 2) + bitSum ((m + 1) / 2)

/-- The Thue-Morse sequence: t(n) = popcount(n) mod 2. -/
def thueMorse (m : ℕ) : ℕ := bitSum m % 2

/-
bitSum(2m) = bitSum(m): even numbers preserve digit sum.
-/
theorem bitSum_double (m : ℕ) : bitSum (2 * m) = bitSum m := by
  -- We can prove this by induction on $m$.
  induction' m with m ih;
  · rfl;
  · rw [ Nat.mul_succ, bitSum ];
    grind

/-
bitSum(2m+1) = bitSum(m) + 1: odd numbers gain one bit.
-/
theorem bitSum_double_succ (m : ℕ) : bitSum (2 * m + 1) = bitSum m + 1 := by
  rw [ add_comm ];
  rw [ add_comm, bitSum ];
  norm_num [ Nat.add_mod, Nat.add_div ];
  ring

/-- t(2n) = t(n): self-similarity of Thue-Morse. -/
theorem thueMorse_double (m : ℕ) : thueMorse (2 * m) = thueMorse m := by
  simp [thueMorse, bitSum_double]

/-- t(2n+1) ≠ t(n): complementation property of Thue-Morse. -/
theorem thueMorse_double_succ_ne (m : ℕ) : thueMorse (2 * m + 1) ≠ thueMorse m := by
  unfold thueMorse; rw [bitSum_double_succ]; omega

/-
**Value Dichotomy**: The Thue-Morse sequence takes both values 0 and 1
    for infinitely many n. This follows from self-similarity: if t(m) = 0,
    then t(2m) = 0 and t(2m+1) = 1; if t(m) = 1, then t(2m) = 1 and t(2m+1) = 0.
    So both values propagate to arbitrarily large indices.
-/
theorem thueMorse_both_values_infinite :
    (∀ N, ∃ m ≥ N, thueMorse m = 0) ∧ (∀ N, ∃ m ≥ N, thueMorse m = 1) := by
  constructor;
  · intro N
    by_contra! hN;
    -- By induction, we can show that for all $m \geq N$, $thueMorse m = 1$.
    have h_ind : ∀ m ≥ N, thueMorse m = 1 := by
      exact fun m hm => Or.resolve_left ( Nat.mod_two_eq_zero_or_one _ ) ( hN m hm );
    have := h_ind ( 2 * N + 1 ) ( by linarith ) ; have := h_ind N le_rfl ; simp_all +decide [ thueMorse_double_succ_ne ] ;
    exact absurd ( h_ind N le_rfl ) ( by have := thueMorse_double_succ_ne N; aesop );
  · intro N;
    by_contra! h;
    -- By induction, we can show that for all $m \geq N$, $thueMorse m = 0$.
    have h_ind : ∀ m ≥ N, thueMorse m = 0 := by
      exact fun m hm => Or.resolve_right ( Nat.mod_two_eq_zero_or_one _ ) ( h m hm );
    exact absurd ( h_ind ( 2 * N + 1 ) ( by linarith ) ) ( by have := thueMorse_double_succ_ne N; aesop )

/-! ## Part 8: Aperiodicity of Thue-Morse -/

/-- A sequence is eventually periodic with some period p starting at N. -/
def IsEventuallyPeriodic (seq : ℕ → ℕ) : Prop :=
  ∃ p N, 0 < p ∧ ∀ m, N ≤ m → seq (m + p) = seq m

/-
Period halving: if Thue-Morse has period 2q starting at N,
    then it has period q starting at N.
-/
theorem thueMorse_period_halving (q N : ℕ) (_hq : 0 < q)
    (hper : ∀ m, N ≤ m → thueMorse (m + 2 * q) = thueMorse m) :
    ∀ m, N ≤ m → thueMorse (m + q) = thueMorse m := by
  intro m hm;
  contrapose! hper;
  use 2 * m;
  simp_all +decide [ ← mul_add, thueMorse_double ];
  grind +extAll

/-
**Aperiodicity Theorem**: The Thue-Morse sequence is not eventually periodic.
-/
theorem thueMorse_not_eventually_periodic : ¬ IsEventuallyPeriodic thueMorse := by
  rintro ⟨ p, N, hp, h ⟩;
  induction' p using Nat.strong_induction_on with p ih generalizing N;
  rcases Nat.even_or_odd' p with ⟨ q, rfl | rfl ⟩;
  · exact ih q ( by linarith ) N ( by linarith ) ( thueMorse_period_halving q N ( by linarith ) h );
  · -- From hper, thueMorse(m + 2q+1) = thueMorse(m) for all m ≥ N. Apply this to m = 2n where n ≥ N: thueMorse(2n + 2q+1) = thueMorse(2n). LHS: thueMorse(2(n+q) + 1) ≠ thueMorse(n+q) by complementation. RHS: thueMorse(2n) = thueMorse(n) by self-similarity. So thueMorse(2(n+q)+1) = thueMorse(n), and thueMorse(2(n+q)+1) ≠ thueMorse(n+q). This means thueMorse(n+q) ≠ thueMorse(n) for all n ≥ N.
    have h_neq : ∀ n ≥ N, thueMorse (n + q) ≠ thueMorse n := by
      intros n hn
      have h_eq : thueMorse (2 * (n + q) + 1) = thueMorse (2 * n) := by
        convert h ( 2 * n ) ( by linarith ) using 1 ; ring;
      have := thueMorse_double_succ_ne ( n + q ) ; have := thueMorse_double n; aesop;
    -- Since thueMorse takes values in {0,1}, thueMorse(n+q) = 1 - thueMorse(n) for n ≥ N.
    have h_eq : ∀ n ≥ N, thueMorse (n + q) = 1 - thueMorse n := by
      intros n hn
      have h_val : thueMorse (n + q) < 2 ∧ thueMorse n < 2 := by
        exact ⟨ Nat.mod_lt _ ( by decide ), Nat.mod_lt _ ( by decide ) ⟩;
      grind;
    -- Then thueMorse(n + 2q) = 1 - thueMorse(n+q) = 1 - (1 - thueMorse(n)) = thueMorse(n). So thueMorse has period 2q starting at N.
    have h_period : ∀ n ≥ N, thueMorse (n + 2 * q) = thueMorse n := by
      intro n hn; rw [ two_mul, ← add_assoc, h_eq _ ( by linarith ), h_eq _ ( by linarith ) ] ;
      unfold thueMorse;
      omega;
    rcases q with ( _ | q ) <;> simp_all +decide;
    · linarith [ h_neq N ];
    · exact absurd ( ih ( 2 * ( q + 1 ) ) le_rfl N ( by linarith ) ) ( by push_neg; aesop )

/-! ## Part 9: Shift Recurrences — Bridge to Algebra -/

/-- A sequence satisfies a shift recurrence of period p starting at N. -/
def SatisfiesShiftRecurrence (p N : ℕ) (seq : ℕ → ℤ) : Prop :=
  ∀ m, N + p ≤ m → seq m = seq (m - p)

/-
Every eventually periodic ℤ-sequence satisfies a shift recurrence.
-/
theorem eventually_periodic_implies_recurrence
    (seq : ℕ → ℤ) (p N : ℕ) (_hp : 0 < p)
    (hper : ∀ m, N ≤ m → seq (m + p) = seq m) :
    SatisfiesShiftRecurrence p N seq := by
  intro m hm; specialize hper ( m - p ) ( Nat.le_sub_of_add_le ( by linarith ) ) ; rw [ Nat.sub_add_cancel ( by linarith ) ] at hper; exact hper;

/-! ## Part 10: Conjecture — Morphic Decidability -/

/-- A morphism on alphabet Fin k. -/
structure AlphabetMorphism (k : ℕ) where
  image : Fin k → List (Fin k)

/-- A morphism is prolongable on letter a if σ(a) starts with a
    and has length ≥ 2, ensuring the fixed point is well-defined. -/
def AlphabetMorphism.IsProlongable (σ : AlphabetMorphism k) (a : Fin k) : Prop :=
  ∃ h : σ.image a ≠ [], (σ.image a).head h = a ∧ 2 ≤ (σ.image a).length

/-- **Open Conjecture**: The zero-in-sequence problem for morphic sequences
    is decidable. Known true for k-uniform morphisms. Open in general.

    **Falsifiable test**: Check all prolongable morphisms over {0,1,2} with
    images of length ≤ 5 — does BFS terminate in ≤ 10^6 steps for all? -/
def MorphicDecidabilityConjecture : Prop :=
  ∀ (k : ℕ) (_ : 2 ≤ k) (σ : AlphabetMorphism k) (a : Fin k),
    σ.IsProlongable a →
    ∀ b : Fin k, Nonempty (Decidable (∃ i : Fin (σ.image a).length, (σ.image a).get i = b))

end AutoSeqDecide