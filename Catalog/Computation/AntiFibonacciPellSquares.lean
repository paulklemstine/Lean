import Novelty.Basic

/-!
# Perfect squares in the Anti-Fibonacci sequence: a complete Pell classification

For the Fibonacci sequence, the determination of the perfect squares (`F 1 = F 2 = 1`
and `F 12 = 144`) is a famous hard theorem of Cohn.  For the anti-Fibonacci sequence of
`Novelty.Basic` (`antiFib 0 = 1`, `antiFib (n+1) = antiFib n + n`,
`2·antiFib n + n = n² + 2`) the answer is *completely and elementarily solvable* — and
the answer is an infinite Pell orbit rather than a finite list.

Since `8 · antiFib n = (2n-1)² + 7`, the equation `antiFib n = y²` is exactly the
Pell-type equation

  `x² + 7 = 8 y²`,  `x = 2n - 1`.

## Main results

* `AntiFibonacciSquares.Reach` — the inductive orbit generated by the two fundamental
  solutions `(1,1)`, `(5,2)` under the automorphism `(x,y) ↦ (3x+8y, x+3y)` induced by
  the fundamental unit `3 + √8`.
* `AntiFibonacciSquares.Reach.isPellSol` — every reachable pair solves `x² + 7 = 8y²`.
* `AntiFibonacciSquares.isPellSol_reach` — **completeness (Vieta descent)**: *every*
  natural solution of `x² + 7 = 8y²` is reachable.  Hence the solution set is exactly
  two `Pell` orbits.
* `AntiFibonacciSquares.antiFib_eq_sq_iff` — the classification transported back:
  for `n ≥ 1`, `antiFib n` is a perfect square **iff** `Reach (2n-1) y` for some `y`.
* `AntiFibonacciSquares.exists_square_above` — consequently there are **infinitely
  many** perfect squares in the anti-Fibonacci sequence
  (`1, 4, 16, 121, 529, 4096, 17956, …` at indices `1, 3, 6, 16, 33, 91, 190, …`),
  in sharp contrast with Fibonacci's three square terms.

-- !-- Lab Notes -- !--
Hypothesis (Hypothesizer): `8·antiFib n = (2n-1)² + 7` converts "is a square" into a
Pell equation, so — unlike Fibonacci — the squares should form an infinite, exactly
describable family.

Experiment (Experimenter): scanning `n ≤ 2000` (`#eval` below) gives squares exactly at
`n = 1, 3, 6, 16, 33, 91, 190, 528, 1105` with values
`1, 4, 16, 121, 529, 4096, 17956, 139129, 609961`; the `x = 2n-1` values
`1, 5, 11, 31, 65, 181, 379, 1055, 2209` are precisely the two interleaved orbits of
`(x,y) ↦ (3x+8y, x+3y)` started at `(1,1)` and `(5,2)`.

Analysis (Analyst): `(3x+8y)² + 7 - 8(x+3y)² = x² + 7 - 8y²`, so the map preserves the
solution set; conversely for `y ≥ 3` one checks `8y ≤ 3x ≤ 9y`, so
`(3x-8y, 3y-x)` is again a solution with strictly smaller `y`, giving a Vieta descent
that terminates at `y ∈ {1, 2}`.  This proves *completeness* of the orbit description.

Critique (Critic): all inequalities used in the descent must be verified over `ℕ`
(`8y ≤ 3x` fails for `y ≤ 2`, which is exactly why there are two base solutions rather
than one), and the conversion `x = 2n-1` needs `n ≥ 1`; both guards appear explicitly
in the statements.  `Reach` is *not* postulated: it is an inductive family whose two
constructors are the verified base solutions.
-- !-- Lab Notes -- !--
-/

open AntiFibonacci

namespace AntiFibonacciSquares

/-- The Pell-type condition `x² + 7 = 8y²` equivalent to `antiFib ((x+1)/2) = y²`. -/
def IsPellSol (x y : ℕ) : Prop := x ^ 2 + 7 = 8 * y ^ 2

/-- The orbit of the two fundamental solutions under `(x,y) ↦ (3x+8y, x+3y)`. -/
inductive Reach : ℕ → ℕ → Prop where
  | one : Reach 1 1
  | five : Reach 5 2
  | step {x y : ℕ} : Reach x y → Reach (3 * x + 8 * y) (x + 3 * y)

/-- Every reachable pair is a solution. -/
theorem Reach.isPellSol {x y : ℕ} (h : Reach x y) : IsPellSol x y := by
  induction h with
  | one => norm_num [IsPellSol]
  | five => norm_num [IsPellSol]
  | step _ ih =>
      unfold IsPellSol at ih ⊢
      nlinarith [ih]

/-- Reachable pairs have positive second coordinate. -/
theorem Reach.pos {x y : ℕ} (h : Reach x y) : 1 ≤ y ∧ 1 ≤ x := by
  induction h with
  | one => exact ⟨le_refl 1, le_refl 1⟩
  | five => exact ⟨by norm_num, by norm_num⟩
  | step _ ih => exact ⟨by omega, by omega⟩

/-- Reachable pairs have odd first coordinate, so `x = 2n - 1` for a unique `n ≥ 1`. -/
theorem Reach.odd {x y : ℕ} (h : Reach x y) : x % 2 = 1 := by
  induction h with
  | one => norm_num
  | five => norm_num
  | step _ ih => omega

/-! ### Vieta descent: the orbit description is complete -/

/-- For a solution with `y ≥ 3` the descended pair is well defined: `8y ≤ 3x`. -/
theorem descent_le {x y : ℕ} (h : IsPellSol x y) (hy : 3 ≤ y) : 8 * y ≤ 3 * x := by
  unfold IsPellSol at h
  by_contra hcon
  push_neg at hcon
  nlinarith [h, hy, hcon]

/-- For any solution, `x < 3y`. -/
theorem descent_lt {x y : ℕ} (h : IsPellSol x y) : x < 3 * y := by
  unfold IsPellSol at h
  nlinarith [h]

/-- For a solution with `y ≥ 2`, we have `2y < x`, so the descent strictly decreases `y`. -/
theorem descent_gt {x y : ℕ} (h : IsPellSol x y) (hy : 2 ≤ y) : 2 * y < x := by
  unfold IsPellSol at h
  nlinarith [h, hy]

/-- **Completeness of the orbit description (Vieta descent).**  Every natural solution
of `x² + 7 = 8y²` lies in the orbit of `(1,1)` or `(5,2)`. -/
theorem isPellSol_reach : ∀ y x : ℕ, IsPellSol x y → Reach x y := by
  intro y
  induction y using Nat.strong_induction_on with
  | _ y ih =>
    intro x h
    rcases Nat.lt_or_ge y 3 with hsmall | hbig
    · -- base cases `y ≤ 2`
      interval_cases y
      · exfalso; unfold IsPellSol at h; omega
      · have hx : x = 1 := by unfold IsPellSol at h; nlinarith [h]
        subst hx; exact Reach.one
      · have hx : x = 5 := by unfold IsPellSol at h; nlinarith [h]
        subst hx; exact Reach.five
    · -- descent
      have hle : 8 * y ≤ 3 * x := descent_le h hbig
      have hlt : x < 3 * y := descent_lt h
      have hgt : 2 * y < x := descent_gt h (by omega)
      set x' := 3 * x - 8 * y with hx'
      set y' := 3 * y - x with hy'
      have hxx : x = 3 * x' + 8 * y' := by omega
      have hyy : y = x' + 3 * y' := by omega
      have hsol' : IsPellSol x' y' := by
        unfold IsPellSol at h ⊢
        rw [hxx, hyy] at h
        nlinarith [h]
      have hy'lt : y' < y := by omega
      have := ih y' hy'lt x' hsol'
      have hstep := this.step
      rwa [← hxx, ← hyy] at hstep

/-! ### Back to the anti-Fibonacci sequence -/

/-- The dictionary: for `n ≥ 1`, `antiFib n = y²` iff `(2n-1, y)` is a Pell solution. -/
theorem antiFib_eq_sq_iff_isPellSol {n y : ℕ} (hn : 1 ≤ n) :
    antiFib n = y ^ 2 ↔ IsPellSol (2 * n - 1) y := by
  have hc := antiFib_closed n
  unfold IsPellSol
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  have hred : 2 * (m + 1) - 1 = 2 * m + 1 := by omega
  rw [hred]
  constructor
  · intro h
    rw [h] at hc
    nlinarith [hc]
  · intro h
    nlinarith [hc, h]

/-- **Classification of the squares.**  For `n ≥ 1`, the anti-Fibonacci number
`antiFib n` is a perfect square exactly when `2n - 1` occurs in the Pell orbit. -/
theorem antiFib_eq_sq_iff {n : ℕ} (hn : 1 ≤ n) :
    (∃ y, antiFib n = y ^ 2) ↔ ∃ y, Reach (2 * n - 1) y := by
  constructor
  · rintro ⟨y, hy⟩
    exact ⟨y, isPellSol_reach y (2 * n - 1) ((antiFib_eq_sq_iff_isPellSol hn).1 hy)⟩
  · rintro ⟨y, hy⟩
    exact ⟨y, (antiFib_eq_sq_iff_isPellSol hn).2 hy.isPellSol⟩

/-- Reachable pairs give squares of the anti-Fibonacci sequence. -/
theorem antiFib_of_reach {x y : ℕ} (h : Reach x y) : antiFib ((x + 1) / 2) = y ^ 2 := by
  have hodd := h.odd
  have hpos := h.pos
  have hsol := h.isPellSol
  have hn : 1 ≤ (x + 1) / 2 := by omega
  rw [antiFib_eq_sq_iff_isPellSol hn]
  have : 2 * ((x + 1) / 2) - 1 = x := by omega
  rw [this]
  exact hsol

/-- The orbit grows without bound. -/
theorem reach_unbounded (M : ℕ) : ∃ x y, Reach x y ∧ M < x := by
  induction M with
  | zero => exact ⟨1, 1, Reach.one, by norm_num⟩
  | succ k ih =>
      obtain ⟨x, y, hr, hx⟩ := ih
      have hpos := hr.pos
      exact ⟨3 * x + 8 * y, x + 3 * y, hr.step, by omega⟩

/-- **Infinitely many perfect squares.**  For every bound `M` there is an index `n > M`
with `antiFib n` a perfect square — in sharp contrast with the Fibonacci sequence,
whose only square terms are `1` and `144`. -/
theorem exists_square_above (M : ℕ) : ∃ n y, M < n ∧ antiFib n = y ^ 2 := by
  obtain ⟨x, y, hr, hx⟩ := reach_unbounded (2 * M + 2)
  refine ⟨(x + 1) / 2, y, ?_, antiFib_of_reach hr⟩
  omega

/-! ### Experimental data -/

section Evidence

/-- Indices `n ≤ 2000` at which `antiFib n` is a perfect square. -/
def squareIndices (M : ℕ) : List ℕ :=
  (List.range M).filter fun n => Nat.sqrt (antiFib n) * Nat.sqrt (antiFib n) == antiFib n

/-- info: [0, 1, 3, 6, 16, 33, 91, 190, 528, 1105] -/
#guard_msgs in #eval squareIndices 2000

/-- info: [1, 1, 4, 16, 121, 529, 4096, 17956, 139129, 609961] -/
#guard_msgs in #eval (squareIndices 2000).map antiFib

/-- The two interleaved Pell orbits, as `x = 2n - 1`. -/
def orbit (x0 y0 : ℕ) : ℕ → ℕ × ℕ
  | 0 => (x0, y0)
  | k + 1 => let p := orbit x0 y0 k; (3 * p.1 + 8 * p.2, p.1 + 3 * p.2)

/-- info: [(1, 1), (11, 4), (65, 23), (379, 134)] -/
#guard_msgs in #eval (List.range 4).map (orbit 1 1)

/-- info: [(5, 2), (31, 11), (181, 64), (1055, 373)] -/
#guard_msgs in #eval (List.range 4).map (orbit 5 2)

end Evidence

end AntiFibonacciSquares