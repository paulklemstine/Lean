import Mathlib
import Geometry.MissingDataCohomology

/-!
# The obstruction to calibrating many sources is a Betti number of the nerve

`Catalog/Computation/DatabaseHolonomy.lean` computes the calibration obstruction
for three cyclically overlapping data sources. This file generalises the
computation to two infinite families of nerves and exhibits the contrast that
makes the phenomenon topological rather than statistical:

* `finrank_H1_cycle` — for `m ≥ 1` sources arranged in a cycle (source `i`
  overlaps source `i+1` only), the calibration complex has `dim H¹ = 1`,
  independently of `m`, of the field, and of its characteristic. This is the
  first Betti number of the `m`-cycle;
* `finrank_H1_star` — for `m + 1` sources arranged in a star (a hub overlapping
  every spoke, no spoke–spoke overlap), `dim H¹ = 0`; the star is a tree, first
  Betti number `0`;
* `cycle_holonomy_iff` — an explicit solvability criterion: prescribed pairwise
  offsets around the cycle are realisable iff their total holonomy vanishes.

Hence the number of independent unfixable inconsistencies in a multi-source
integration problem is a topological invariant of the overlap graph, not a
function of the missing rate or of the number of features.

-- !-- Lab Notes -- !--
Hypothesis: the calibration obstruction of a multi-source database equals the
first Betti number of the nerve of the sources.
Experiment: compute `H¹` for the two extreme families of connected nerves, the
`m`-cycle (one independent cycle) and the star on `m + 1` vertices (none).
Analysis: the kernel of the cyclic coboundary is exactly the constants, in every
characteristic, since the additive group of `ZMod m` is generated by `1`; hence
the rank is `m - 1` and the cokernel is one dimensional. The star coboundary is
surjective by an explicit section, so its `H¹` vanishes.
Critique: both families are proved; the general statement `dim H¹ = b₁(nerve)`
for an arbitrary connected overlap graph is recorded as a conjecture in
`FUTURE_DIRECTIONS.md`, not claimed here.
Synthesis: cycles in the nerve, not missing rates, create obstructions.
-- !-- Lab Notes -- !--
-/

open MissingDataCohomology

namespace DatabaseNerveBetti

variable (𝕜 : Type*) [Field 𝕜]

/-! ### The cyclic nerve -/

/-- Calibration coboundary of the `m`-cycle: a recalibration `s` of the sources
induces the offsets `s i - s (i+1)` on the overlaps. -/
def dCycle (m : ℕ) [NeZero m] : (ZMod m → 𝕜) →ₗ[𝕜] (ZMod m → 𝕜) where
  toFun s := fun i => s i - s (i + 1)
  map_add' s t := by funext i; simp; ring
  map_smul' a s := by funext i; simp; ring

@[simp] lemma dCycle_apply (m : ℕ) [NeZero m] (s : ZMod m → 𝕜) (i : ZMod m) :
    dCycle 𝕜 m s i = s i - s (i + 1) := rfl

/-- The total-holonomy functional. -/
def sumLin (m : ℕ) [NeZero m] : (ZMod m → 𝕜) →ₗ[𝕜] 𝕜 where
  toFun t := ∑ i : ZMod m, t i
  map_add' s t := by simp [Finset.sum_add_distrib]
  map_smul' a s := by simp [Finset.mul_sum]

@[simp] lemma sumLin_apply (m : ℕ) [NeZero m] (t : ZMod m → 𝕜) :
    sumLin 𝕜 m t = ∑ i : ZMod m, t i := rfl

/-- Only constant recalibrations are invisible on the cyclic nerve. -/
theorem ker_dCycle (m : ℕ) [NeZero m] :
    LinearMap.ker (dCycle 𝕜 m) = 𝕜 ∙ (fun _ => (1 : 𝕜)) := by
  apply le_antisymm
  · intro s hs
    have h : ∀ i : ZMod m, s i = s (i + 1) := by
      intro i
      have hi := congrFun (LinearMap.mem_ker.1 hs) i
      have hi0 : s i - s (i + 1) = 0 := hi
      exact sub_eq_zero.1 hi0
    have hnat : ∀ n : ℕ, s ((n : ZMod m)) = s 0 := by
      intro n
      induction n with
      | zero => simp
      | succ n ih =>
          have hstep := h ((n : ZMod m))
          push_cast
          rw [← hstep]
          exact ih
    refine Submodule.mem_span_singleton.2 ⟨s 0, ?_⟩
    funext i
    have hi : ((i.val : ℕ) : ZMod m) = i := ZMod.natCast_rightInverse i
    have hv := hnat i.val
    rw [hi] at hv
    simp [hv]
  · rw [Submodule.span_le]
    rintro _ rfl
    apply LinearMap.mem_ker.2
    funext i
    simp

/-- The cyclic coboundary has corank one. -/
theorem finrank_range_dCycle (m : ℕ) [NeZero m] :
    Module.finrank 𝕜 (LinearMap.range (dCycle 𝕜 m)) + 1 = m := by
  have hker : Module.finrank 𝕜 (LinearMap.ker (dCycle 𝕜 m)) = 1 := by
    rw [ker_dCycle]
    exact finrank_span_singleton (by
      intro h
      have := congrFun h 0
      simp at this)
  have hrn := LinearMap.finrank_range_add_finrank_ker (dCycle 𝕜 m)
  have hdim : Module.finrank 𝕜 (ZMod m → 𝕜) = m := by
    simp [ZMod.card]
  rw [hker, hdim] at hrn
  exact hrn

/-- The holonomy functional is onto, hence its kernel is a hyperplane. -/
theorem finrank_ker_sumLin (m : ℕ) [NeZero m] :
    Module.finrank 𝕜 (LinearMap.ker (sumLin 𝕜 m)) + 1 = m := by
  have hsurj : Function.Surjective (sumLin 𝕜 m) := by
    intro a
    refine ⟨Pi.single 0 a, ?_⟩
    simp
  have hrange : Module.finrank 𝕜 (LinearMap.range (sumLin 𝕜 m)) = 1 := by
    rw [LinearMap.range_eq_top.2 hsurj]
    simp
  have hrn := LinearMap.finrank_range_add_finrank_ker (sumLin 𝕜 m)
  have hdim : Module.finrank 𝕜 (ZMod m → 𝕜) = m := by
    simp [ZMod.card]
  rw [hrange, hdim] at hrn
  omega

/-- Coboundaries have vanishing holonomy. -/
theorem range_dCycle_le_ker_sumLin (m : ℕ) [NeZero m] :
    LinearMap.range (dCycle 𝕜 m) ≤ LinearMap.ker (sumLin 𝕜 m) := by
  rintro _ ⟨s, rfl⟩
  apply LinearMap.mem_ker.2
  have hsplit : ∑ i : ZMod m, (s i - s (i + 1))
      = (∑ i : ZMod m, s i) - ∑ i : ZMod m, s (i + 1) := Finset.sum_sub_distrib _ _
  have hshift : ∑ i : ZMod m, s (i + 1) = ∑ i : ZMod m, s i :=
    Fintype.sum_equiv (Equiv.addRight (1 : ZMod m)) _ _ (fun i => rfl)
  simp only [sumLin_apply, dCycle_apply]
  rw [hsplit, hshift]
  ring

/-- **Holonomy criterion on a cycle.** Prescribed pairwise offsets around a
cyclic arrangement of sources are realisable by per-source recalibrations if and
only if their total holonomy vanishes. -/
theorem cycle_holonomy_iff (m : ℕ) [NeZero m] (t : ZMod m → 𝕜) :
    t ∈ LinearMap.range (dCycle 𝕜 m) ↔ ∑ i : ZMod m, t i = 0 := by
  have heq : LinearMap.range (dCycle 𝕜 m) = LinearMap.ker (sumLin 𝕜 m) := by
    refine Submodule.eq_of_le_of_finrank_eq (range_dCycle_le_ker_sumLin 𝕜 m) ?_
    have h1 := finrank_range_dCycle 𝕜 m
    have h2 := finrank_ker_sumLin 𝕜 m
    omega
  rw [heq]
  exact ⟨fun h => by simpa using LinearMap.mem_ker.1 h, fun h => LinearMap.mem_ker.2 (by simpa using h)⟩

/-- The calibration complex of `m` cyclically arranged sources. Triple overlaps
are empty, so there are no degree-two constraints. -/
def cycleComplex (m : ℕ) [NeZero m] : DataComplex 𝕜 where
  C0 := ZMod m → 𝕜
  C1 := ZMod m → 𝕜
  C2 := Fin 0 → 𝕜
  d0 := dCycle 𝕜 m
  d1 := 0
  d_sq := by simp

/-- **One independent obstruction per cycle.** For every `m ≥ 1` and every field,
the cyclic calibration complex has `dim H¹ = 1`. -/
theorem finrank_H1_cycle (m : ℕ) [NeZero m] :
    Module.finrank 𝕜 (cycleComplex 𝕜 m).H1 = 1 := by
  have hform := (cycleComplex 𝕜 m).finrank_H1_formula
  have hd0 : Module.finrank 𝕜 (LinearMap.range (cycleComplex 𝕜 m).d0) + 1 = m :=
    finrank_range_dCycle 𝕜 m
  have hd1 : Module.finrank 𝕜 (LinearMap.range (cycleComplex 𝕜 m).d1) = 0 := by
    simp [cycleComplex]
  have hC1 : Module.finrank 𝕜 (cycleComplex 𝕜 m).C1 = m := by
    simp [cycleComplex, ZMod.card]
  rw [hd1, hC1] at hform
  omega

/-! ### The star (tree) nerve -/

/-- Calibration coboundary of the star with hub `0` and `m` spokes. -/
def dStar (m : ℕ) : (Fin (m + 1) → 𝕜) →ₗ[𝕜] (Fin m → 𝕜) where
  toFun s := fun i => s 0 - s i.succ
  map_add' s t := by funext i; simp; ring
  map_smul' a s := by funext i; simp; ring

@[simp] lemma dStar_apply (m : ℕ) (s : Fin (m + 1) → 𝕜) (i : Fin m) :
    dStar 𝕜 m s i = s 0 - s i.succ := rfl

/-- On a star every prescribed family of offsets is realisable. -/
theorem dStar_surjective (m : ℕ) : Function.Surjective (dStar 𝕜 m) := by
  intro t
  refine ⟨Fin.cons 0 (fun i => -t i), ?_⟩
  funext i
  simp

/-- The calibration complex of a star-shaped family of sources. -/
def starComplex (m : ℕ) : DataComplex 𝕜 where
  C0 := Fin (m + 1) → 𝕜
  C1 := Fin m → 𝕜
  C2 := Fin 0 → 𝕜
  d0 := dStar 𝕜 m
  d1 := 0
  d_sq := by simp

/-- **No obstruction on a tree.** A star-shaped overlap pattern always admits a
global calibration: `dim H¹ = 0`, in contrast with the cyclic case. -/
theorem finrank_H1_star (m : ℕ) : Module.finrank 𝕜 (starComplex 𝕜 m).H1 = 0 :=
  DataComplex.h1_vanishes_of_surjective_d0 _ (dStar_surjective 𝕜 m)

/-- **Topological dichotomy.** With the same number of pairwise overlaps, a
cyclic arrangement of sources carries a one-dimensional integration obstruction
while a star carries none. -/
theorem cycle_star_dichotomy (m : ℕ) [NeZero m] :
    Module.finrank 𝕜 (cycleComplex 𝕜 m).H1 ≠ Module.finrank 𝕜 (starComplex 𝕜 m).H1 := by
  rw [finrank_H1_cycle, finrank_H1_star]
  omega

end DatabaseNerveBetti