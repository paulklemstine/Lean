----++---/-- Membership in `crossGaps` unpacked. -/
----++---theorem mem_crossGaps_iff {α : Type*} {f : α → Fin n → ℝ} {x : α}
----++---    {S : Finset (Fin n)} {r : ℝ} :
----++---    r ∈ crossGaps f x S ↔ ∃ i ∈ S, ∃ j, j ∉ S ∧ r = scoreGap f x i j := by
