----++---    {hS : S.Nonempty} {hSc : (finCompl S).Nonempty}
----++---    {i j : Fin n} (hi : i ∈ S) (hj : j ∉ S) :
----++---    topkMargin' f x S hS hSc ≤ scoreGap f x i j := by
