------------+-+
------------+-+/-- Extend a support datum to an S₃-invariant function on ℤ³ via sorting. -/
------------+-+def satakeExtend (h : SupportDatum) : ℤ → ℤ → ℤ → ℤ :=
------------+-+  fun a b c => h (toGL3Dom a b c)
