------------+-+theorem satakeExtend_invariant (h : SupportDatum) : IsS3Invariant (satakeExtend h) := by
------------+-+  constructor
------------+-+  · intro a b c; simp only [satakeExtend, toGL3Dom_swap12]
------------+-+  · intro a b c; simp only [satakeExtend, toGL3Dom_cycle]
