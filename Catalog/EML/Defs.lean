------------+-+
------------+-+/-- Extract the support datum: restrict a Hecke function to the dominant chamber. -/
------------+-+def satakeSupport (f : TropicalHeckeGL3) : SupportDatum :=
------------+-+  fun μ => f.1 μ.1.1 μ.1.2.1 μ.1.2.2
