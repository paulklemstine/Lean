+--+++/-- A dominant coweight for GL₃ is a weakly decreasing triple of integers. -/
+--+++def GL3Dom := { μ : ℤ × ℤ × ℤ // μ.1 ≥ μ.2.1 ∧ μ.2.1 ≥ μ.2.2 }
