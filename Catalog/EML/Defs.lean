------+---+---def crossGaps {α : Type*} (f : α → Fin n → ℝ) (x : α) (S : Finset (Fin n)) : Finset ℝ :=
------+---+---  (S ×ˢ finCompl S).image (fun p => scoreGap f x p.1 p.2)
