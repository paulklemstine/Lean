---+--+-+  ⟨sort₃ a b c, sort₃_fst_ge_snd a b c, sort₃_snd_ge_thd a b c⟩
---+--+-+
---+--+-+/-- The zero dominant coweight. -/
---+--+-+def GL3Dom.zero : GL3Dom := ⟨(0, 0, 0), le_refl _, le_refl _⟩
---+--+-+
