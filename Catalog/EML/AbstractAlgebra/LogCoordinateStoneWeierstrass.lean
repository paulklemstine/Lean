/-
# A non-circular Stone–Weierstrass density result for the log-coordinate algebra

This file proves, in a deliberately **non-circular** way, that the subalgebra of
`C([0,1], ℝ)` generated by the single continuous coordinate `t ↦ log (1 + t)` is
dense, i.e. its topological closure is `⊤`.

## Background: the circularity problem

A previous attempt (`Catalog/EML/StoneWeierstrassApprox.lean`) phrased EML universal
approximation in terms of subalgebras that already *separate points*, and then
re-used EML "universal approximation" statements to justify density.  Any attempt to
deduce density of a *specific* EML-generated algebra by appealing back to a generic
"EML universal approximation" theorem is circular: the generic theorem is exactly the
thing one wants to instantiate.

## The corrected, non-circular statement

We do **not** import or use `EML.StoneWeierstrassApprox`,
`eml_universalApproximation`, `eml_exists_uniform_approx`, or any pre-existing
density/universal-approximation assertion for EML networks.  We use only

* Mathlib's general Stone–Weierstrass theorem
  (`ContinuousMap.subalgebra_topologicalClosure_eq_top_of_separatesPoints`), and
* elementary facts about `Real.log` (injectivity on the positive reals, continuity
  away from `0`).

The argument is:

1. `logCoord` is a genuine element of `C([0,1], ℝ)` (continuity from `Real.log`
   being continuous on the positives and `1 + t > 0` on `[0,1]`).
2. The underlying function `x ↦ log (1 + x)` is **injective** on `[0,1]`.
3. Hence the singleton-generated subalgebra `Algebra.adjoin ℝ {logCoord}` already
   **separates points** of `[0,1]`.
4. Mathlib's Stone–Weierstrass theorem turns point-separation on a compact space into
   density: `topologicalClosure = ⊤`.
5. As a downstream corollary (never used to prove density) we get the usual
   `ε`-approximation statement.

## Main results

* `logCoord`               : the continuous coordinate `t ↦ log (1 + t)`.
* `logCoord_injective`     : injectivity of the underlying function.
* `logCoordSubalg`         : `Algebra.adjoin ℝ {logCoord}`.
* `logCoordSubalg_separatesPoints` : it separates points of `[0,1]`.
* `logCoordSubalg_dense`   : `logCoordSubalg.topologicalClosure = ⊤`.
* `logCoordSubalg_closure_eq_top` : the `Set`-level closure version.
* `logCoordSubalg_exists_approx`  : the `ε`-approximation corollary.
-/
import Mathlib

open ContinuousMap Real Topology

noncomputable section

/-- The closed unit interval `[0,1] ⊆ ℝ`, used as a compact Hausdorff space via the
subtype topology.  We use `abbrev` so the `CompactSpace`/`T2Space` instances for
`Set.Icc` fire automatically. -/
abbrev IUnit : Set ℝ := Set.Icc (0 : ℝ) 1

/-- For `x ∈ [0,1]` we have `1 + x > 0`. -/
theorem one_add_pos_of_IUnit (x : IUnit) : 0 < 1 + (x : ℝ) := by
  have hx : (0 : ℝ) ≤ (x : ℝ) := x.2.1
  linarith

/-- The underlying real-valued function `x ↦ log (1 + x)` is continuous on `[0,1]`. -/
theorem logCoord_continuous : Continuous (fun x : IUnit => Real.log (1 + (x : ℝ))) := by
  apply Real.continuousOn_log.comp_continuous
  · exact continuous_const.add continuous_subtype_val
  · intro x
    have hx : (0 : ℝ) ≤ (x : ℝ) := x.2.1
    simp only [Set.mem_compl_iff, Set.mem_singleton_iff]
    intro h; linarith

/-- The continuous coordinate `logCoord : C([0,1], ℝ)`, `x ↦ log (1 + x)`. -/
def logCoord : C(IUnit, ℝ) := ⟨fun x => Real.log (1 + (x : ℝ)), logCoord_continuous⟩

@[simp] theorem logCoord_apply (x : IUnit) : logCoord x = Real.log (1 + (x : ℝ)) := rfl

/-- The underlying function of `logCoord` is injective on `[0,1]`: if
`log (1 + x) = log (1 + y)` then, both arguments being positive, injectivity of
`Real.log` on the positive reals gives `1 + x = 1 + y`, hence `x = y`. -/
theorem logCoord_injective : Function.Injective (fun x : IUnit => logCoord x) := by
  intro a b h
  have ha : (0 : ℝ) < 1 + (a : ℝ) := by have := a.2.1; linarith
  have hb : (0 : ℝ) < 1 + (b : ℝ) := by have := b.2.1; linarith
  have hlog := Real.log_injOn_pos (Set.mem_Ioi.mpr ha) (Set.mem_Ioi.mpr hb) h
  exact Subtype.ext (by linarith)

/-- The subalgebra of `C([0,1], ℝ)` generated by the single coordinate `logCoord`. -/
def logCoordSubalg : Subalgebra ℝ C(IUnit, ℝ) :=
  Algebra.adjoin ℝ ({logCoord} : Set C(IUnit, ℝ))

/-- `logCoord` belongs to the algebra it generates. -/
theorem logCoord_mem_logCoordSubalg : logCoord ∈ logCoordSubalg :=
  Algebra.subset_adjoin (Set.mem_singleton _)

/-- The log-coordinate algebra separates points of `[0,1]`: distinct points are
distinguished by `logCoord` itself, which lies in the algebra. -/
theorem logCoordSubalg_separatesPoints : logCoordSubalg.SeparatesPoints := by
  intro x y hxy
  refine ⟨logCoord, ⟨logCoord, logCoord_mem_logCoordSubalg, rfl⟩, ?_⟩
  intro h
  exact hxy (logCoord_injective h)

/-- **Main theorem (non-circular density).**  The log-coordinate algebra is dense in
`C([0,1], ℝ)`: its topological closure is `⊤`.  This is Mathlib's Stone–Weierstrass
theorem applied to the point-separation established above. -/
theorem logCoordSubalg_dense : logCoordSubalg.topologicalClosure = ⊤ :=
  ContinuousMap.subalgebra_topologicalClosure_eq_top_of_separatesPoints
    logCoordSubalg logCoordSubalg_separatesPoints

/-- `Set`-level reformulation: the closure of the carrier set of `logCoordSubalg` is
all of `C([0,1], ℝ)`. -/
theorem logCoordSubalg_closure_eq_top :
    closure (logCoordSubalg : Set C(IUnit, ℝ)) = (⊤ : Set C(IUnit, ℝ)) := by
  rw [← Subalgebra.topologicalClosure_coe, logCoordSubalg_dense]
  simp [Set.top_eq_univ]

/-- The carrier of `logCoordSubalg` is dense. -/
theorem logCoordSubalg_dense_set : Dense (logCoordSubalg : Set C(IUnit, ℝ)) := by
  rw [dense_iff_closure_eq, logCoordSubalg_closure_eq_top, Set.top_eq_univ]

/-- **Downstream corollary (`ε`-approximation).**  Every continuous function on
`[0,1]` can be uniformly approximated, to within any `ε > 0`, by an element of the
algebra generated by `t ↦ log (1 + t)`.

This is *not* used in the proof of density above. -/
theorem logCoordSubalg_exists_approx (F : C(IUnit, ℝ)) {ε : ℝ} (hε : 0 < ε) :
    ∃ G ∈ logCoordSubalg, ‖F - G‖ < ε := by
  obtain ⟨G, hGmem, hGdist⟩ := logCoordSubalg_dense_set.exists_dist_lt F hε
  exact ⟨G, hGmem, by rwa [dist_eq_norm] at hGdist⟩

/-! ## Stretch goal: approximants are polynomials in `log (1 + t)` -/

/-- Elements of `logCoordSubalg` are exactly the polynomial expressions in `logCoord`:
`G` lies in the algebra iff `G = aeval logCoord p` for some real polynomial `p`. -/
theorem mem_logCoordSubalg_iff (G : C(IUnit, ℝ)) :
    G ∈ logCoordSubalg ↔ ∃ p : Polynomial ℝ, Polynomial.aeval logCoord p = G := by
  rw [logCoordSubalg, Algebra.adjoin_singleton_eq_range_aeval]
  simp only [AlgHom.mem_range]

/-- Pointwise meaning of a polynomial in `logCoord`: evaluating `aeval logCoord p` at
`x ∈ [0,1]` gives `p (log (1 + x))`.  Thus elements of `logCoordSubalg` are precisely
the functions `t ↦ p (log (1 + t))`, i.e. polynomial-in-log EML networks. -/
theorem aeval_logCoord_apply (p : Polynomial ℝ) (x : IUnit) :
    (Polynomial.aeval logCoord p) x = Polynomial.aeval (Real.log (1 + (x : ℝ))) p := by
  rw [← logCoord_apply x]
  induction p using Polynomial.induction_on with
  | C a => simp
  | add p q hp hq => simp [hp, hq]
  | monomial n a _ => simp [pow_succ]

/-- **Explicit polynomial-in-log approximation.**  Every continuous `F` on `[0,1]` is,
for each `ε > 0`, uniformly within `ε` of a function `t ↦ p (log (1 + t))` for some
real polynomial `p`.  This packages the density result in the concrete EML form. -/
theorem exists_poly_log_approx (F : C(IUnit, ℝ)) {ε : ℝ} (hε : 0 < ε) :
    ∃ p : Polynomial ℝ, ‖F - Polynomial.aeval logCoord p‖ < ε := by
  obtain ⟨G, hGmem, hG⟩ := logCoordSubalg_exists_approx F hε
  obtain ⟨p, hp⟩ := (mem_logCoordSubalg_iff G).mp hGmem
  exact ⟨p, by rw [hp]; exact hG⟩

end