/-
# The Euler Brick Tree, IV: a verified bounded search along the tree

Two things are done here.

* A *general local criterion*: if for some modulus `p` the quartic
  `w⁴ + 16u²v²` is a nonsquare in `ZMod p`, then the brick generated by the
  triple `(u,v,w)` is not a perfect cuboid.  This is the abstract engine behind
  the mod-7 obstruction of `Tropical.EulerBrickTree.Obstruction`.

* A *bounded search along the tree's growth*: every one of the `40` nodes of
  the Berggren tree of depth at most `3` is exhibited explicitly with its
  reachability proof, and for each of them the perfect-cuboid condition is
  refuted by trapping the quartic `c⁴ + 16a²b²` strictly between two
  consecutive squares.  Thus the first four levels of the brick tree contain no
  perfect cuboid, and the refutation is a Lean proof, not a numerical search.
-/
import Mathlib
import Tropical.EulerBrickTree.Core
import Tropical.EulerBrickTree.Descent
import Tropical.EulerBrickTree.Obstruction

namespace EulerBrickTree

/-! ## Tools -/

/-- An integer strictly between two consecutive squares is not a square. -/
theorem not_square_between {n k : ℤ} (hk : 0 ≤ k) (h1 : k ^ 2 < n) (h2 : n < (k + 1) ^ 2) :
    ¬ ∃ s : ℤ, n = s ^ 2 := by
  rintro ⟨s, rfl⟩
  have habs : |s| ^ 2 = s ^ 2 := sq_abs s
  have hs0 : 0 ≤ |s| := abs_nonneg s
  have h3 : k < |s| := by nlinarith
  have h4 : k + 1 ≤ |s| := by omega
  nlinarith

/-- **General local criterion.**  A modulus in which the quartic is a nonsquare
refutes the perfect-cuboid condition for the whole generated brick. -/
theorem brick_not_perfect_of_local_nonsquare (p : ℕ) [NeZero p] {u v w : ℤ}
    (h : IsPT u v w) (hw : w ≠ 0)
    (hns : ∀ S : ZMod p,
      ((w : ZMod p) ^ 4 + 16 * (u : ZMod p) ^ 2 * (v : ZMod p) ^ 2) ≠ S ^ 2) :
    ¬ IsPerfectCuboid (brick u v w).1 (brick u v w).2.1 (brick u v w).2.2 := by
  intro hperf
  obtain ⟨s, hs⟩ := (brick_perfect_iff h hw).mp hperf
  refine hns ((s : ℤ) : ZMod p) ?_
  have hc := congrArg (fun t : ℤ => (t : ZMod p)) hs
  push_cast at hc
  exact hc

/-- Reachability step along the first generator, in equational form. -/
theorem treeReach_stepA {a b c a' b' c' : ℤ} (h : TreeReach a b c)
    (e : bergA a b c = (a', b', c')) : TreeReach a' b' c' := by
  have h2 := TreeReach.stepA h
  rw [e] at h2
  simpa using h2

/-- Reachability step along the second generator, in equational form. -/
theorem treeReach_stepB {a b c a' b' c' : ℤ} (h : TreeReach a b c)
    (e : bergB a b c = (a', b', c')) : TreeReach a' b' c' := by
  have h2 := TreeReach.stepB h
  rw [e] at h2
  simpa using h2

/-- Reachability step along the third generator, in equational form. -/
theorem treeReach_stepC {a b c a' b' c' : ℤ} (h : TreeReach a b c)
    (e : bergC a b c = (a', b', c')) : TreeReach a' b' c' := by
  have h2 := TreeReach.stepC h
  rw [e] at h2
  simpa using h2

/-- Refuting a node: trap the quartic between consecutive squares. -/
theorem node_not_perfect {a b c k : ℤ} (h : TreeReach a b c) (hk : 0 ≤ k)
    (h1 : k ^ 2 < c ^ 4 + 16 * a ^ 2 * b ^ 2)
    (h2 : c ^ 4 + 16 * a ^ 2 * b ^ 2 < (k + 1) ^ 2) :
    ¬ IsPerfectCuboid (brick a b c).1 (brick a b c).2.1 (brick a b c).2.2 := by
  rw [treeBrick_perfect_iff h]
  exact not_square_between hk h1 h2

