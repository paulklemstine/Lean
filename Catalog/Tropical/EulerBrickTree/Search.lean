    ∀ t ∈ nodesDepthLe3,
      ¬ IsPerfectCuboid (brick t.1 t.2.1 t.2.2).1 (brick t.1 t.2.1 t.2.2).2.1
        (brick t.1 t.2.1 t.2.2).2.2 := by
