    ¬ IsPerfectCuboid (brick 3 4 5).1 (brick 3 4 5).2.1 (brick 3 4 5).2.2 :=
  node_not_perfect reach_3_4_5 (k := 54) (by norm_num) (by norm_num) (by norm_num)

