import Tropical.MagmaMonoid.Structure

/-!
# Tropical operations inside the magma monoid

This file is the tropical face of the magma-monoid theory developed in
`Tropical.MagmaMonoid.{Green, Regularity, Structure}`.

The two tropical semiring operations behave completely differently as *elements
of the magma monoid*:

* **Tropical addition** (`min`, or `max` for the max-plus convention) is a
  commutative idempotent magma.  We show that all such operations form a
  **left-zero band** inside `Bin(X)`
  (`product_eq_left_of_commutative_diagIdem`), that they are all mutually
  `L`-equivalent (`greenL_of_commutative_diagIdem`), and we compute the
  submonoid they generate: `⟨min, max⟩ = {1, min, max}`
  (`closure_minOp_maxOp`).

* **Tropical multiplication** (ordinary addition of exponents) is commutative
  but *not* diagonally idempotent, and its regularity in the magma monoid turns
  out to be a **divisibility-by-two** question about the value semigroup:
  it is regular over `ℚ` and `ℝ` (`isRegular_tropicalMul_rat`,
  `isRegular_tropicalMul_real`) and **not** regular over `ℤ`
  (`not_isRegular_tropicalMul_int`).

So the regularity criterion of `Regularity.lean` detects arithmetic properties
of the coefficient semiring: a purely semigroup-theoretic invariant of `Bin(X)`
sees 2-divisibility of the tropical value group.
-/

namespace MagmaMonoid

variable {X : Type*}

/-! ### Commutative idempotent magmas form a left-zero band -/

/-- If `f` is commutative and `g` is diagonally idempotent then `f * g = f`.
Consequently the set of commutative, diagonally idempotent operations (all
semilattices, in particular `min` and `max`) is a **left-zero subsemigroup** of
the magma monoid. -/
theorem product_eq_left_of_commutative_diagIdem {f g : Operation X}
    (hf : ∀ a b, f a b = f b a) (hg : ∀ x, g x x = x) : product f g = f := by
  funext a b
  simp [product, hf a b, hg]

/-- Any two commutative diagonally idempotent operations are `L`-equivalent in
the magma monoid: the whole band sits in a single `L`-class. -/
theorem greenL_of_commutative_diagIdem {f g : Operation X}
    (hf : ∀ a b, f a b = f b a) (hg : ∀ a b, g a b = g b a)
    (hf' : ∀ x, f x x = x) (hg' : ∀ x, g x x = x) : GreenL f g :=
  ⟨⟨g, product_eq_left_of_commutative_diagIdem hg hf'⟩,
    ⟨f, product_eq_left_of_commutative_diagIdem hf hg'⟩⟩

/-- Commutative diagonally idempotent operations all share the same pairmorph
image, namely the whole diagonal. -/
theorem pairImage_of_commutative_diagIdem {f : Operation X}
    (hf : ∀ a b, f a b = f b a) (hf' : ∀ x, f x x = x) :
    pairImage f = Set.range fun x : X ↦ (x, x) := by
  ext q
  constructor
  · rintro ⟨⟨a, b⟩, rfl⟩
    exact ⟨f a b, by simp [pairmorph, hf a b]⟩
  · rintro ⟨x, rfl⟩
    exact ⟨(x, x), by simp [pairmorph, hf' x]⟩

/-! ### `min` and `max` -/

section Lattice

variable [LinearOrder X]

/-- Tropical addition (min-plus convention) as an element of the magma monoid. -/
def minOp : Bin X := fun a b ↦ min a b

/-- Tropical addition (max-plus convention) as an element of the magma monoid. -/
def maxOp : Bin X := fun a b ↦ max a b

theorem minOp_comm (a b : X) : minOp a b = minOp b a := min_comm a b
theorem maxOp_comm (a b : X) : maxOp a b = maxOp b a := max_comm a b
theorem minOp_diag (x : X) : minOp x x = x := min_self x
theorem maxOp_diag (x : X) : maxOp x x = x := max_self x

@[simp] theorem minOp_mul_maxOp : (minOp : Bin X) * maxOp = minOp :=
  product_eq_left_of_commutative_diagIdem minOp_comm maxOp_diag

@[simp] theorem maxOp_mul_minOp : (maxOp : Bin X) * minOp = maxOp :=
  product_eq_left_of_commutative_diagIdem maxOp_comm minOp_diag

@[simp] theorem minOp_mul_minOp : (minOp : Bin X) * minOp = minOp :=
  product_eq_left_of_commutative_diagIdem minOp_comm minOp_diag

@[simp] theorem maxOp_mul_maxOp : (maxOp : Bin X) * maxOp = maxOp :=
  product_eq_left_of_commutative_diagIdem maxOp_comm maxOp_diag

/-- `min` and `max` are `L`-equivalent elements of the magma monoid. -/
theorem greenL_minOp_maxOp : GreenL (minOp : Operation X) maxOp :=
  greenL_of_commutative_diagIdem minOp_comm maxOp_comm minOp_diag maxOp_diag

/-- Both tropical additions are regular elements of the magma monoid. -/
theorem isRegular_minOp : IsRegular (minOp : Operation X) :=
  isRegular_of_diagonal_idempotent _ minOp_diag

theorem isRegular_maxOp : IsRegular (maxOp : Operation X) :=
  isRegular_of_diagonal_idempotent _ maxOp_diag

/-- The three-element submonoid `{1, min, max}` of the magma monoid. -/
def tropicalBand : Submonoid (Bin X) where
  carrier := {1, minOp, maxOp}
  one_mem' := by simp
  mul_mem' := by
    rintro a b (rfl | rfl | rfl) (rfl | rfl | rfl) <;>
      simp [one_mul, mul_one, Set.mem_insert_iff]

/-- **The submonoid generated by the two tropical additions** is
`{1, min, max}`: since the band is left-zero, every word in `min` and `max`
collapses to its first letter. -/
theorem closure_minOp_maxOp :
    Submonoid.closure ({minOp, maxOp} : Set (Bin X)) = tropicalBand := by
  apply le_antisymm
  · rw [Submonoid.closure_le]
    rintro x (rfl | rfl)
    · exact Or.inr (Or.inl rfl)
    · exact Or.inr (Or.inr rfl)
  · rintro x (rfl | rfl | rfl)
    · exact one_mem _
    · exact Submonoid.subset_closure (Or.inl rfl)
    · exact Submonoid.subset_closure (Or.inr rfl)

end Lattice

/-! ### Tropical multiplication: regularity is 2-divisibility -/

section TropicalMul

open Tropical

/-- Tropical multiplication (i.e. addition of exponents) as an element of the
magma monoid. -/
def tropicalMul (R : Type*) [Add R] : Operation (Tropical R) := fun a b ↦ a * b

/-- Over a value group in which every element is divisible by `2`, tropical
multiplication is a regular element of the magma monoid: a pseudo-inverse is
built from halving. -/
theorem isRegular_tropicalMul_of_two_divisible {R : Type*} [AddCommMonoid R]
    (h : ∀ r : R, ∃ s : R, s + s = r) : IsRegular (tropicalMul R) := by
  rw [isRegular_iff]
  intro x y _
  obtain ⟨s, hs⟩ := h (untrop x + untrop y)
  refine ⟨trop s, ?_⟩
  apply untrop_injective
  simp [tropicalMul, hs]

/-- **Regularity of tropical multiplication is exactly 2-divisibility of the
value monoid.**  The magma-monoid criterion, applied to the tropical product,
reduces to solvability of `s + s = r`. -/
theorem isRegular_tropicalMul_iff {R : Type*} [AddCommMonoid R] :
    IsRegular (tropicalMul R) ↔ ∀ r : R, ∃ s : R, s + s = r := by
  refine ⟨fun h r ↦ ?_, isRegular_tropicalMul_of_two_divisible⟩
  rw [isRegular_iff] at h
  obtain ⟨z, hz⟩ := h (trop r) (trop 0) (by simp [tropicalMul, mul_comm])
  refine ⟨untrop z, ?_⟩
  have := congrArg untrop hz
  simpa [tropicalMul] using this

theorem isRegular_tropicalMul_rat : IsRegular (tropicalMul ℚ) :=
  isRegular_tropicalMul_of_two_divisible fun r ↦ ⟨r / 2, by ring⟩

theorem isRegular_tropicalMul_real : IsRegular (tropicalMul ℝ) :=
  isRegular_tropicalMul_of_two_divisible fun r ↦ ⟨r / 2, by ring⟩

/-- **Over the integers tropical multiplication is not regular.**  The value
`trop 1` is a commutative value of the operation which is not attained on the
diagonal, because `1` is odd.  This is the tropical incarnation of the diagonal
obstruction isolated by the regularity criterion. -/
theorem not_isRegular_tropicalMul_int : ¬ IsRegular (tropicalMul ℤ) := by
  rw [isRegular_iff]
  intro h
  obtain ⟨z, hz⟩ := h (trop 0) (trop 1) (by simp [tropicalMul, mul_comm])
  have hz' : untrop z + untrop z = 0 + 1 := by
    simpa [tropicalMul] using congrArg untrop hz
  omega

end TropicalMul

end MagmaMonoid