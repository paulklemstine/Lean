import Mathlib

/-!
# Tropical Tensor-Product Universality for Separable Bivariate EML Maps

This file formalizes a bivariate tropical Stone–Weierstrass / tensor-generation theorem:
given one-variable function families `A ⊆ C(X, ℝ)` and `B ⊆ C(Y, ℝ)` that separate
points, the product max-plus family on `X × Y` built from lifted functions of `A` and `B`
is uniformly dense in `C(X × Y, ℝ)`.

This is the idempotent/tropical analogue of algebraic tensor-product universality:
bivariate continuous functions are uniformly approximated by finite max-plus
combinations of separable terms.

## Main definitions

* `liftFst` / `liftSnd`: canonical embeddings of `C(X, ℝ)` and `C(Y, ℝ)` into `C(X × Y, ℝ)`
* `pureTensorMaxPlus`: the pure tensor `(x,y) ↦ a(x) + b(y)` in max-plus coordinates
* `ProductMaxPlusFamily`: the inductively generated max-plus family on `X × Y`

## Main results

* `productFamily_separates_points`: the product family separates all points of `X × Y`
* `productFamily_separatesPointsStrongly`: two-point interpolation for the product family
* `dense_productMaxPlusFamily`: density of the product max-plus family in `C(X × Y, ℝ)`
* `approx_productMaxPlusFamily`: ε-approximation version
* `dense_productMaxPlusFamily_univ`: universality for full function spaces

## Mathematical significance

This theorem upgrades one-variable tropical approximation to compositional multivariate
approximation: higher-dimensional EML maps can be built from one-dimensional factors by
tropical tensoring. It is the max-plus analogue of the classical fact that tensor products
of dense subalgebras are dense in the product-space function algebra.
-/

noncomputable section

open ContinuousMap Set Topology

variable {X Y : Type*} [TopologicalSpace X] [TopologicalSpace Y]

/-! ## Section 1: Lifting and Pure Tensors -/

/-- Lift a continuous function on `X` to the product `X × Y` via projection. -/
def liftFst (f : C(X, ℝ)) : C(X × Y, ℝ) :=
  f.comp ⟨Prod.fst, continuous_fst⟩

/-- Lift a continuous function on `Y` to the product `X × Y` via projection. -/
def liftSnd (g : C(Y, ℝ)) : C(X × Y, ℝ) :=
  g.comp ⟨Prod.snd, continuous_snd⟩

@[simp] theorem liftFst_apply (f : C(X, ℝ)) (p : X × Y) : liftFst f p = f p.1 := rfl

@[simp] theorem liftSnd_apply (g : C(Y, ℝ)) (p : X × Y) : liftSnd g p = g p.2 := rfl

/-- The pure tensor in max-plus coordinates: `(x, y) ↦ a(x) + b(y)`. -/
def pureTensorMaxPlus (a : C(X, ℝ)) (b : C(Y, ℝ)) : C(X × Y, ℝ) :=
  liftFst a + liftSnd b

@[simp] theorem pureTensorMaxPlus_apply (a : C(X, ℝ)) (b : C(Y, ℝ)) (p : X × Y) :
    pureTensorMaxPlus a b p = a p.1 + b p.2 := rfl

/-- Pure tensors are continuous. -/
theorem continuous_pureTensorMaxPlus (a : C(X, ℝ)) (b : C(Y, ℝ)) :
    Continuous fun p : X × Y => a p.1 + b p.2 :=
  (pureTensorMaxPlus a b).continuous

/-! ## Section 2: Lift Homomorphism Properties -/

theorem liftFst_const (c : ℝ) :
    liftFst (ContinuousMap.const X c) = ContinuousMap.const (X × Y) c := by
  ext; simp

theorem liftSnd_const (c : ℝ) :
    liftSnd (ContinuousMap.const Y c) = ContinuousMap.const (X × Y) c := by
  ext; simp

theorem liftFst_add (f g : C(X, ℝ)) :
    liftFst (f + g) = liftFst f + (liftFst g : C(X × Y, ℝ)) := by
  ext; simp

theorem liftSnd_add (f g : C(Y, ℝ)) :
    liftSnd (f + g) = liftSnd f + (liftSnd g : C(X × Y, ℝ)) := by
  ext; simp

theorem liftFst_neg (f : C(X, ℝ)) :
    liftFst (-f) = -(liftFst f : C(X × Y, ℝ)) := by
  ext; simp

theorem liftSnd_neg (g : C(Y, ℝ)) :
    liftSnd (-g) = -(liftSnd g : C(X × Y, ℝ)) := by
  ext; simp

theorem liftFst_sup (f g : C(X, ℝ)) :
    liftFst (f ⊔ g) = liftFst f ⊔ (liftFst g : C(X × Y, ℝ)) := by
  ext; simp [liftFst, ContinuousMap.sup_apply]

theorem liftSnd_sup (f g : C(Y, ℝ)) :
    liftSnd (f ⊔ g) = liftSnd f ⊔ (liftSnd g : C(X × Y, ℝ)) := by
  ext; simp [liftSnd, ContinuousMap.sup_apply]

/-! ## Section 3: The Product Max-Plus Family -/

/-- The product max-plus family on `X × Y` generated by families `A` on `X` and `B` on `Y`.
This is the smallest set containing all lifted functions from `A` and `B`, all real constants,
and closed under pointwise `sup` (tropical addition), `+` (tropical multiplication),
and negation. -/
inductive ProductMaxPlusFamily (A : Set C(X, ℝ)) (B : Set C(Y, ℝ)) :
    Set C(X × Y, ℝ) where
  | liftA {a : C(X, ℝ)} (ha : a ∈ A) : ProductMaxPlusFamily A B (liftFst a)
  | liftB {b : C(Y, ℝ)} (hb : b ∈ B) : ProductMaxPlusFamily A B (liftSnd b)
  | const (c : ℝ) : ProductMaxPlusFamily A B (ContinuousMap.const (X × Y) c)
  | sup {f g : C(X × Y, ℝ)} :
      ProductMaxPlusFamily A B f → ProductMaxPlusFamily A B g →
      ProductMaxPlusFamily A B (f ⊔ g)
  | add {f g : C(X × Y, ℝ)} :
      ProductMaxPlusFamily A B f → ProductMaxPlusFamily A B g →
      ProductMaxPlusFamily A B (f + g)
  | neg {f : C(X × Y, ℝ)} :
      ProductMaxPlusFamily A B f → ProductMaxPlusFamily A B (-f)

namespace ProductMaxPlusFamily

variable {A : Set C(X, ℝ)} {B : Set C(Y, ℝ)}

theorem const_mem (c : ℝ) :
    ContinuousMap.const (X × Y) c ∈ ProductMaxPlusFamily A B :=
  ProductMaxPlusFamily.const c

theorem sup_mem {f g : C(X × Y, ℝ)}
    (hf : f ∈ ProductMaxPlusFamily A B) (hg : g ∈ ProductMaxPlusFamily A B) :
    f ⊔ g ∈ ProductMaxPlusFamily A B :=
  ProductMaxPlusFamily.sup hf hg

theorem add_mem {f g : C(X × Y, ℝ)}
    (hf : f ∈ ProductMaxPlusFamily A B) (hg : g ∈ ProductMaxPlusFamily A B) :
    f + g ∈ ProductMaxPlusFamily A B :=
  ProductMaxPlusFamily.add hf hg

theorem neg_mem {f : C(X × Y, ℝ)}
    (hf : f ∈ ProductMaxPlusFamily A B) :
    -f ∈ ProductMaxPlusFamily A B :=
  ProductMaxPlusFamily.neg hf

/-- The product family contains pure tensors. -/
theorem pureTensor_mem {a : C(X, ℝ)} {b : C(Y, ℝ)} (ha : a ∈ A) (hb : b ∈ B) :
    pureTensorMaxPlus a b ∈ ProductMaxPlusFamily A B :=
  ProductMaxPlusFamily.add (ProductMaxPlusFamily.liftA ha) (ProductMaxPlusFamily.liftB hb)

/-- Inf-closure from sup and negation: `f ⊓ g = -((-f) ⊔ (-g))`. -/
theorem inf_mem {f g : C(X × Y, ℝ)}
    (hf : f ∈ ProductMaxPlusFamily A B) (hg : g ∈ ProductMaxPlusFamily A B) :
    f ⊓ g ∈ ProductMaxPlusFamily A B := by
  have : f ⊓ g = -((-f) ⊔ (-g)) := by
    ext x; simp [min_def, max_def]; split_ifs <;> linarith
  rw [this]
  exact neg_mem (sup_mem (neg_mem hf) (neg_mem hg))

/-- Subtraction. -/
theorem sub_mem {f g : C(X × Y, ℝ)}
    (hf : f ∈ ProductMaxPlusFamily A B) (hg : g ∈ ProductMaxPlusFamily A B) :
    f - g ∈ ProductMaxPlusFamily A B := by
  rw [sub_eq_add_neg]
  exact add_mem hf (neg_mem hg)

/-- Zero is in the family. -/
theorem zero_mem : (0 : C(X × Y, ℝ)) ∈ ProductMaxPlusFamily A B := by
  have h := const_mem (A := A) (B := B) 0
  convert h using 1

/-- Natural number scalar multiples. -/
theorem nsmul_mem {f : C(X × Y, ℝ)} (hf : f ∈ ProductMaxPlusFamily A B) (n : ℕ) :
    n • f ∈ ProductMaxPlusFamily A B := by
  induction n with
  | zero => simpa using zero_mem
  | succ n ih => rw [succ_nsmul]; exact add_mem ih hf

end ProductMaxPlusFamily

/-! ## Section 4: Product Point Separation -/

/-- If `A` separates points of `X`, then lifted functions from `A` separate
product points that differ in the first coordinate. -/
theorem liftFst_separates
    {A : Set C(X, ℝ)}
    (hA_sep : ∀ x₁ x₂ : X, x₁ ≠ x₂ → ∃ a ∈ A, a x₁ ≠ a x₂)
    {p₁ p₂ : X × Y} (hx : p₁.1 ≠ p₂.1) :
    ∃ f ∈ ProductMaxPlusFamily A B, f p₁ ≠ f p₂ := by
  obtain ⟨a, ha, hne⟩ := hA_sep _ _ hx
  exact ⟨liftFst a, ProductMaxPlusFamily.liftA ha, by simp [hne]⟩

/-- If `B` separates points of `Y`, then lifted functions from `B` separate
product points that differ in the second coordinate. -/
theorem liftSnd_separates
    {B : Set C(Y, ℝ)}
    (hB_sep : ∀ y₁ y₂ : Y, y₁ ≠ y₂ → ∃ b ∈ B, b y₁ ≠ b y₂)
    {p₁ p₂ : X × Y} (hy : p₁.2 ≠ p₂.2) :
    ∃ f ∈ ProductMaxPlusFamily A B, f p₁ ≠ f p₂ := by
  obtain ⟨b, hb, hne⟩ := hB_sep _ _ hy
  exact ⟨liftSnd b, ProductMaxPlusFamily.liftB hb, by simp [hne]⟩

/-- **Product separation lemma**: if `A` separates points of `X` and `B` separates
points of `Y`, then the product max-plus family separates all points of `X × Y`. -/
theorem productFamily_separates_points
    {A : Set C(X, ℝ)} {B : Set C(Y, ℝ)}
    (hA_sep : ∀ x₁ x₂ : X, x₁ ≠ x₂ → ∃ a ∈ A, a x₁ ≠ a x₂)
    (hB_sep : ∀ y₁ y₂ : Y, y₁ ≠ y₂ → ∃ b ∈ B, b y₁ ≠ b y₂) :
    ∀ p₁ p₂ : X × Y, p₁ ≠ p₂ →
      ∃ f ∈ ProductMaxPlusFamily A B, f p₁ ≠ f p₂ := by
  intro p₁ p₂ hp
  by_cases hx : p₁.1 ≠ p₂.1
  · exact liftFst_separates hA_sep hx
  · push_neg at hx
    have hy : p₁.2 ≠ p₂.2 := fun h => hp (Prod.ext hx h)
    exact liftSnd_separates hB_sep hy

/-! ## Section 5: Strong Point Separation (Two-Point Interpolation)

We derive the strong two-point interpolation property required by the lattice
Stone–Weierstrass theorem. The proof constructs interpolating functions from
the max-plus closure structure (constants, addition, sup, negation, separation). -/

/-
Auxiliary: from a separating function, construct a nonneg function vanishing at `p₁`
and positive at `p₂`. Uses `f ↦ (f - const (f p₁)) ⊔ 0` to kill the value at `p₁`
while preserving positivity elsewhere.
-/
theorem exists_zero_pos_of_sep
    {A : Set C(X, ℝ)} {B : Set C(Y, ℝ)}
    (hA_sep : ∀ x₁ x₂ : X, x₁ ≠ x₂ → ∃ a ∈ A, a x₁ ≠ a x₂)
    (hB_sep : ∀ y₁ y₂ : Y, y₁ ≠ y₂ → ∃ b ∈ B, b y₁ ≠ b y₂)
    (p₁ p₂ : X × Y) (hp : p₁ ≠ p₂) :
    ∃ h ∈ ProductMaxPlusFamily A B, h p₁ = 0 ∧ 0 < h p₂ ∧ ∀ z, 0 ≤ h z := by
  -- Consider the separating function `f` obtained from `productFamily_separates_points`.
  obtain ⟨f, hf⟩ : ∃ f ∈ ProductMaxPlusFamily A B, f p₁ < f p₂ := by
    -- By the separation property, there exists a function `g` in the family such that `g p₁ ≠ g p₂`.
    obtain ⟨g, hg_mem, hg_ne⟩ : ∃ g ∈ ProductMaxPlusFamily A B, g p₁ ≠ g p₂ := by
      exact productFamily_separates_points hA_sep hB_sep p₁ p₂ hp;
    cases lt_or_gt_of_ne hg_ne <;> [ exact ⟨ g, hg_mem, ‹_› ⟩ ; exact ⟨ -g, ProductMaxPlusFamily.neg_mem hg_mem, by simpa using ‹_› ⟩ ];
  refine' ⟨ ( f - ContinuousMap.const ( X × Y ) ( f p₁ ) ) ⊔ ContinuousMap.const ( X × Y ) 0, _, _, _, _ ⟩ <;> simp_all +decide;
  exact ProductMaxPlusFamily.sup_mem ( ProductMaxPlusFamily.sub_mem hf.1 ( ProductMaxPlusFamily.const_mem _ ) ) ( ProductMaxPlusFamily.const_mem _ )

/-
Auxiliary: given a nonneg function vanishing at `p₁` and positive at `p₂`,
one can rescale to achieve any positive target value at `p₂` while keeping `p₁ = 0`.
-/
theorem exists_zero_target_of_pos
    {A : Set C(X, ℝ)} {B : Set C(Y, ℝ)}
    {h : C(X × Y, ℝ)} (hh : h ∈ ProductMaxPlusFamily A B)
    (hh0 : h p₁ = 0) (_hh_nn : ∀ z, 0 ≤ h z) (hhp : 0 < h p₂)
    (t : ℝ) (ht : 0 ≤ t) :
    ∃ g ∈ ProductMaxPlusFamily A B, g p₁ = 0 ∧ g p₂ = t := by
  -- Choose n such that n * h p₂ ≥ t.
  obtain ⟨n, hn⟩ : ∃ n : ℕ, n * h p₂ ≥ t := by
    exact ⟨ ⌈t / h p₂⌉₊, by nlinarith [ Nat.le_ceil ( t / h p₂ ), mul_div_cancel₀ t hhp.ne' ] ⟩;
  refine' ⟨ _, _, _, _ ⟩;
  exact ( n • h ) ⊓ ContinuousMap.const ( X × Y ) t;
  · exact ProductMaxPlusFamily.inf_mem ( ProductMaxPlusFamily.nsmul_mem hh n ) ( ProductMaxPlusFamily.const_mem t );
  · simp +decide [ *, ContinuousMap.inf_apply ];
  · simp +decide [ *, ContinuousMap.inf_apply ]

/-
**Two-point interpolation**: for any two distinct product points and any target values,
there exists a function in the product family attaining those values.
This is `Set.SeparatesPointsStrongly` for the product max-plus family.
-/
theorem productFamily_separatesPointsStrongly
    {A : Set C(X, ℝ)} {B : Set C(Y, ℝ)}
    (hA_sep : ∀ x₁ x₂ : X, x₁ ≠ x₂ → ∃ a ∈ A, a x₁ ≠ a x₂)
    (hB_sep : ∀ y₁ y₂ : Y, y₁ ≠ y₂ → ∃ b ∈ B, b y₁ ≠ b y₂) :
    (ProductMaxPlusFamily A B : Set C(X × Y, ℝ)).SeparatesPointsStrongly := by
  intros v x y; by_cases hxy : x = y;
  · exact ⟨ ContinuousMap.const _ ( v x ), ProductMaxPlusFamily.const_mem _, rfl, by simp +decide [ hxy ] ⟩;
  · -- Use `exists_zero_pos_of_sep` to get $h₁$ and $h₂$ with $h₁ x = 0$, $h₁ y > 0$, $h₂ y = 0$, $h₂ x > 0$.
    obtain ⟨h₁, hh₁_mem, hh₁_x, hh₁_y, hh₁_nn⟩ := exists_zero_pos_of_sep hA_sep hB_sep x y hxy
    obtain ⟨h₂, hh₂_mem, hh₂_y, hh₂_x, hh₂_nn⟩ := exists_zero_pos_of_sep hA_sep hB_sep y x (Ne.symm hxy);
    -- Use `exists_zero_target_of_pos` to get $g₁$ and $g₂$ with $g₁ x = 0$, $g₁ y = \max(v y - v x, 0)$, $g₂ y = 0$, $g₂ x = \max(v x - v y, 0)$.
    obtain ⟨g₁, hg₁_mem, hg₁_x, hg₁_y⟩ := exists_zero_target_of_pos hh₁_mem hh₁_x hh₁_nn hh₁_y (max (v y - v x) 0) (by
    exact le_max_right _ _)
    obtain ⟨g₂, hg₂_mem, hg₂_y, hg₂_x⟩ := exists_zero_target_of_pos hh₂_mem hh₂_y hh₂_nn hh₂_x (max (v x - v y) 0) (by
    exact le_max_right _ _);
    refine' ⟨ g₁ + g₂ + ContinuousMap.const ( X × Y ) ( Min.min ( v x ) ( v y ) ), _, _, _ ⟩ <;> simp_all +decide [ add_assoc ];
    · exact ProductMaxPlusFamily.add_mem hg₁_mem ( ProductMaxPlusFamily.add_mem hg₂_mem ( ProductMaxPlusFamily.const_mem _ ) );
    · cases max_cases ( v x - v y ) 0 <;> cases min_cases ( v x ) ( v y ) <;> linarith;
    · cases max_cases ( v y - v x ) 0 <;> cases min_cases ( v x ) ( v y ) <;> linarith

/-! ## Section 6: Main Density Theorems -/

variable [CompactSpace X] [CompactSpace Y]

/-- **Tropical tensor-product density theorem (max-plus version)**:
the product max-plus family generated by `A ⊆ C(X, ℝ)` and `B ⊆ C(Y, ℝ)` is
uniformly dense in `C(X × Y, ℝ)`, provided each family separates points.

This is the idempotent analogue of algebraic tensor-product universality. -/
theorem dense_productMaxPlusFamily
    {A : Set C(X, ℝ)} {B : Set C(Y, ℝ)}
    (hA_sep : ∀ x₁ x₂ : X, x₁ ≠ x₂ → ∃ a ∈ A, a x₁ ≠ a x₂)
    (hB_sep : ∀ y₁ y₂ : Y, y₁ ≠ y₂ → ∃ b ∈ B, b y₁ ≠ b y₂) :
    Dense (ProductMaxPlusFamily A B : Set C(X × Y, ℝ)) := by
  rw [dense_iff_closure_eq]
  have h := ContinuousMap.sublattice_closure_eq_top
    (L := ProductMaxPlusFamily A B)
    ⟨_, ProductMaxPlusFamily.const_mem 0⟩
    (fun f hf g hg => ProductMaxPlusFamily.inf_mem hf hg)
    (fun f hf g hg => ProductMaxPlusFamily.sup_mem hf hg)
    (productFamily_separatesPointsStrongly hA_sep hB_sep)
  exact_mod_cast h

/-- **Tropical tensor-product approximation theorem**:
every continuous function on `X × Y` can be uniformly approximated to within `ε`
by a function in the product max-plus family. -/
theorem approx_productMaxPlusFamily
    {A : Set C(X, ℝ)} {B : Set C(Y, ℝ)}
    (hA_sep : ∀ x₁ x₂ : X, x₁ ≠ x₂ → ∃ a ∈ A, a x₁ ≠ a x₂)
    (hB_sep : ∀ y₁ y₂ : Y, y₁ ≠ y₂ → ∃ b ∈ B, b y₁ ≠ b y₂)
    (f : C(X × Y, ℝ)) {ε : ℝ} (hε : 0 < ε) :
    ∃ g ∈ ProductMaxPlusFamily A B, ‖f - g‖ < ε := by
  have hd := dense_productMaxPlusFamily hA_sep hB_sep
  simpa [dist_eq_norm] using Metric.mem_closure_iff.1 (hd f) ε hε

/-! ## Section 7: Corollaries -/

omit [CompactSpace X] [CompactSpace Y] in
/-- The product family contains all pure tensors `(x,y) ↦ a(x) + b(y)`. -/
theorem pureTensor_mem_productFamily
    {A : Set C(X, ℝ)} {B : Set C(Y, ℝ)}
    {a : C(X, ℝ)} {b : C(Y, ℝ)} (ha : a ∈ A) (hb : b ∈ B) :
    pureTensorMaxPlus a b ∈ ProductMaxPlusFamily A B :=
  ProductMaxPlusFamily.pureTensor_mem ha hb

/-- **Universality for full function spaces**: when `A = C(X, ℝ)` and `B = C(Y, ℝ)`,
every continuous function on `X × Y` can be uniformly approximated by max-plus
combinations of separable terms. This is the tropical analogue of the classical
fact that `C(X) ⊗ C(Y)` is dense in `C(X × Y)`. -/
theorem dense_productMaxPlusFamily_univ [T2Space X] [T2Space Y] :
    Dense (ProductMaxPlusFamily (Set.univ : Set C(X, ℝ))
      (Set.univ : Set C(Y, ℝ)) : Set C(X × Y, ℝ)) := by
  apply dense_productMaxPlusFamily
  · intro x₁ x₂ hx
    obtain ⟨f, hf, hfx⟩ := separatesPoints_continuous_of_t35Space hx
    exact ⟨⟨f, hf⟩, Set.mem_univ _, hfx⟩
  · intro y₁ y₂ hy
    obtain ⟨f, hf, hfx⟩ := separatesPoints_continuous_of_t35Space hy
    exact ⟨⟨f, hf⟩, Set.mem_univ _, hfx⟩

end