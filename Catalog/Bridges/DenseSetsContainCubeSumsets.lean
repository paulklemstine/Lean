/-
# Dense sets always contain a sumset with both summands large

The files `Bridges/DeltaDenseSumsetAvoidance.lean`, `Bridges/GAPSumsetAvoidance.lean` and
`Bridges/UniformDimensionGAP.lean` develop the *sharpness* side of the finitary
Kra–Moreira–Richter–Robertson picture: a `δ`-dense set `S ⊆ [n]` avoiding all sumsets
`A + B` of two (generalised) progressions of size `≍ log n / log(1/δ)`.

This file provides the complementary *lower bound*, i.e. a statement of the form "every
dense set **does** contain a sumset with both summands large".  Nothing of this kind is
available in Mathlib, and the two-term version in
`Bridges/DenseSetsContainTwoTermSumsets.lean` only makes one summand large.

The mechanism is the classical density iteration.  For `S ⊆ [n]` write
`T_v = {x ∈ S : x + v ∈ S}`.  Counting pairs `x < y` in `S` gives some `v ≥ 1` with
`|T_v| ≥ |S|(|S|-1)/(2n)`, so densities essentially square at each step
(`DenseCubes.exists_shift`).  Iterating `k` times produces steps `u 0, …, u (k-1) ≥ 1` and
a nonempty surviving set `T` such that `x + C ⊆ S` for every `x ∈ T`, where

`C = {0, u 0} + {0, u 1} + ⋯ + {0, u (k-1)}`

is the `k`-dimensional combinatorial cube generated by the steps (`DenseCubes.cubeI`,
`DenseCubes.exists_cube_survivors`).  Splitting the cube into its first `⌊k/2⌋` and last
`⌈k/2⌉ ` factors writes it as a sumset `A + B`, and since the steps are positive each
factor has at least (number of its indices) `+ 1` elements
(`DenseCubes.card_le_card_cubeI`).  The iteration survives `k` steps as long as
`4 n (δ/4)^{2^k} ≥ 2`, i.e. as long as `2^k ≤ log(2n) / log(4/δ)`, giving

**Main theorem** (`DenseCubes.exists_sumset_of_dense_log`, `…_loglog`): every `S ⊆ [n]`
with `|S| ≥ δ n` contains a sumset `A + B` with

`min(|A|, |B|) ≥ ⌊k/2⌋ + 1`, where `k = ⌊log₂ (log(2n) / log(4/δ))⌋`,

i.e. with both summands of size `≳ ½ log₂ log n`.  This is of course far from the
conjectured `log n / log(1/δ)`, but it is unconditional and quantitative, and it shows
that the sharpness constructions of the other files cannot be pushed below a
`log log`-type bound.
-/
import Mathlib

namespace DenseCubes

open Finset Pointwise

/-! ## Combinatorial cubes -/

/-- The combinatorial cube generated by the steps `u i`, `i ∈ I`:
`cubeI u I = ∑_{i ∈ I} {0, u i}`, the set of all subset sums of `{u i : i ∈ I}`. -/
def cubeI (u : ℕ → ℕ) (I : Finset ℕ) : Finset ℕ := ∑ i ∈ I, ({0, u i} : Finset ℕ)

lemma cubeI_empty (u : ℕ → ℕ) : cubeI u ∅ = {0} := by
  rw [cubeI, Finset.sum_empty, Finset.singleton_zero]

lemma cubeI_insert {u : ℕ → ℕ} {I : Finset ℕ} {i : ℕ} (hi : i ∉ I) :
    cubeI u (insert i I) = cubeI u I + {0, u i} := by
  rw [cubeI, Finset.sum_insert hi, cubeI, add_comm]

lemma cubeI_union {u : ℕ → ℕ} {I J : Finset ℕ} (h : Disjoint I J) :
    cubeI u (I ∪ J) = cubeI u I + cubeI u J := by
  rw [cubeI, cubeI, cubeI, Finset.sum_union h]

lemma cubeI_congr {u u' : ℕ → ℕ} {I : Finset ℕ} (h : ∀ i ∈ I, u i = u' i) :
    cubeI u I = cubeI u' I :=
  Finset.sum_congr rfl (fun i hi => by rw [h i hi])

lemma cubeI_nonempty (u : ℕ → ℕ) (I : Finset ℕ) : (cubeI u I).Nonempty := by
  classical
  induction I using Finset.induction with
  | empty => rw [cubeI_empty]; exact ⟨0, by simp⟩
  | insert i I hi ih =>
      rw [cubeI_insert hi]
      exact ih.add ⟨0, by simp⟩

/-- Adding one positive step to a nonempty set increases its cardinality: the largest
element gains a new translate above it. -/
lemma card_add_pair_succ {X : Finset ℕ} (hX : X.Nonempty) {v : ℕ} (hv : 0 < v) :
    X.card + 1 ≤ (X + ({0, v} : Finset ℕ)).card := by
  classical
  set M := X.max' hX with hM
  have hMmem : M ∈ X := X.max'_mem hX
  have hsub : insert (M + v) X ⊆ X + ({0, v} : Finset ℕ) := by
    intro x hx
    rcases Finset.mem_insert.1 hx with rfl | hx
    · exact Finset.add_mem_add hMmem (by simp)
    · have hx0 : x = x + 0 := by omega
      rw [hx0]
      exact Finset.add_mem_add hx (by simp)
  have hnot : M + v ∉ X := by
    intro h
    have := X.le_max' _ h
    omega
  have hcard := Finset.card_le_card hsub
  rwa [Finset.card_insert_of_notMem hnot] at hcard

/-- A cube with positive steps has at least one more element than it has generators. -/
lemma card_le_card_cubeI {u : ℕ → ℕ} {I : Finset ℕ} (hu : ∀ i ∈ I, 0 < u i) :
    I.card + 1 ≤ (cubeI u I).card := by
  classical
  induction I using Finset.induction with
  | empty => rw [cubeI_empty]; simp
  | insert i I hi ih =>
      have ihp := ih (fun j hj => hu j (Finset.mem_insert_of_mem hj))
      rw [cubeI_insert hi, Finset.card_insert_of_notMem hi]
      have := card_add_pair_succ (cubeI_nonempty u I) (hu i (Finset.mem_insert_self i I))
      omega

/-! ## One step of the density iteration -/

/-- **Pair counting.**  If `S ⊆ [n]` has at least two elements then some positive shift
`v` keeps many elements inside `S`: `|S|(|S|-1) ≤ 2n·|{x ∈ S : x + v ∈ S}|`.  Indeed the
`|S|(|S|-1)/2` pairs `x < y` of `S` are distributed among at most `n` possible
differences. -/
theorem exists_shift {n : ℕ} {S : Finset ℕ} (hS : S ⊆ range n) (h2 : 2 ≤ S.card) :
    ∃ v, 0 < v ∧ S.card * (S.card - 1) ≤ 2 * n * (S.filter (fun x => x + v ∈ S)).card := by
  classical
  set m := S.card with hm
  set P : Finset (ℕ × ℕ) := (S ×ˢ S).filter (fun p => p.1 < p.2) with hP
  set Q : Finset (ℕ × ℕ) := (S ×ˢ S).filter (fun p => p.2 < p.1) with hQ
  have hPQ : P.card = Q.card := by
    refine Finset.card_bij (fun p _ => (p.2, p.1)) ?_ ?_ ?_
    · intro p hp
      simp only [hP, hQ, Finset.mem_filter, Finset.mem_product] at hp ⊢
      exact ⟨⟨hp.1.2, hp.1.1⟩, hp.2⟩
    · intro p hp q hq h
      simp only [Prod.mk.injEq] at h
      exact Prod.ext h.2 h.1
    · intro q hq
      refine ⟨(q.2, q.1), ?_, rfl⟩
      simp only [hP, hQ, Finset.mem_filter, Finset.mem_product] at hq ⊢
      exact ⟨⟨hq.1.2, hq.1.1⟩, hq.2⟩
  have hdisj : Disjoint P Q := by
    rw [Finset.disjoint_left]
    intro p hp hq
    simp only [hP, hQ, Finset.mem_filter] at hp hq
    omega
  have hunion : P ∪ Q = S.offDiag := by
    ext p
    simp only [hP, hQ, Finset.mem_union, Finset.mem_filter, Finset.mem_product,
      Finset.mem_offDiag]
    constructor
    · rintro (⟨h, hlt⟩ | ⟨h, hlt⟩) <;> exact ⟨h.1, h.2, by omega⟩
    · rintro ⟨ha, hb, hne⟩
      rcases Nat.lt_or_ge p.1 p.2 with h | h
      · exact Or.inl ⟨⟨ha, hb⟩, h⟩
      · exact Or.inr ⟨⟨ha, hb⟩, by omega⟩
  have hmm : m * (m - 1) = m * m - m := by rw [Nat.mul_sub, Nat.mul_one]
  have hPcard : m * (m - 1) ≤ 2 * P.card := by
    have hcard : P.card + Q.card = m * m - m := by
      rw [← Finset.card_union_of_disjoint hdisj, hunion, Finset.offDiag_card, hm]
    omega
  have hn1 : 1 ≤ n := by
    obtain ⟨x, hx⟩ : S.Nonempty := Finset.card_pos.1 (by omega)
    have := hS hx
    simp only [Finset.mem_range] at this
    omega
  have hfib : ∀ p ∈ P, p.2 - p.1 ∈ Icc 1 n := by
    intro p hp
    simp only [hP, Finset.mem_filter, Finset.mem_product] at hp
    have h1 := hS hp.1.1
    have h2' := hS hp.1.2
    simp only [Finset.mem_range] at h1 h2'
    rw [Finset.mem_Icc]
    omega
  have hsum : P.card = ∑ v ∈ Icc 1 n, (P.filter (fun p => p.2 - p.1 = v)).card :=
    Finset.card_eq_sum_card_fiberwise hfib
  have hfibcard : ∀ v ∈ Icc 1 n,
      (P.filter (fun p => p.2 - p.1 = v)).card ≤ (S.filter (fun x => x + v ∈ S)).card := by
    intro v _
    refine Finset.card_le_card_of_injOn (fun p => p.1) ?_ ?_
    · intro p hp
      rw [Finset.mem_coe, Finset.mem_filter, hP, Finset.mem_filter, Finset.mem_product] at hp
      rw [Finset.mem_coe, Finset.mem_filter]
      refine ⟨hp.1.1.1, ?_⟩
      have hpv : p.1 + v = p.2 := by omega
      rw [hpv]; exact hp.1.1.2
    · intro p hp q hq h
      rw [Finset.mem_coe, Finset.mem_filter, hP, Finset.mem_filter, Finset.mem_product] at hp hq
      simp only at h
      exact Prod.ext h (by omega)
  have hle : P.card ≤ ∑ v ∈ Icc 1 n, (S.filter (fun x => x + v ∈ S)).card := by
    rw [hsum]; exact Finset.sum_le_sum hfibcard
  by_contra hcon
  push_neg at hcon
  have hall : ∀ v ∈ Icc 1 n, 2 * n * (S.filter (fun x => x + v ∈ S)).card < m * (m - 1) := by
    intro v hv
    exact hcon v (by rw [Finset.mem_Icc] at hv; omega)
  have hne : (Icc 1 n).Nonempty := ⟨1, by simp [hn1]⟩
  have hsum2 : ∑ v ∈ Icc 1 n, (2 * n * (S.filter (fun x => x + v ∈ S)).card)
      < ∑ v ∈ Icc 1 n, m * (m - 1) := Finset.sum_lt_sum_of_nonempty hne hall
  rw [← Finset.mul_sum, Finset.sum_const, Nat.card_Icc, smul_eq_mul] at hsum2
  simp only [Nat.add_sub_cancel] at hsum2
  have hmul : 2 * n * P.card ≤ 2 * n * ∑ v ∈ Icc 1 n, (S.filter (fun x => x + v ∈ S)).card :=
    Nat.mul_le_mul_left _ hle
  nlinarith [hPcard, hmul, hsum2, hn1]

/-! ## The iteration -/

/-- **The density iteration.**  Let `0 < t ≤ 1` and let `S ⊆ [n]` have `|S| ≥ 4nt`.  If
`4 n t^{2^k} ≥ 2`, then there are positive steps `u 0, …, u (k-1)` and a surviving set
`T ⊆ [n]` with `|T| ≥ 4 n t^{2^k}` such that `x + C ⊆ S` for every `x ∈ T`, where `C` is
the cube generated by the steps.

Each step of the iteration replaces the current set by `{x : x, x+v ∈ current}` for a
well-chosen `v`, which squares the (normalised) density; hence the doubly exponential
`t^{2^k}`. -/
theorem exists_cube_survivors (n : ℕ) (t : ℝ) (ht0 : 0 < t) (ht1 : t ≤ 1) :
    ∀ (k : ℕ) (S : Finset ℕ), S ⊆ range n → 2 ≤ 4 * n * t ^ (2 ^ k) → 4 * n * t ≤ S.card →
      ∃ (u : ℕ → ℕ) (T : Finset ℕ), (∀ i < k, 0 < u i) ∧ T ⊆ range n ∧
        4 * n * t ^ (2 ^ k) ≤ T.card ∧ ∀ x ∈ T, ∀ y ∈ cubeI u (range k), x + y ∈ S := by
  intro k
  induction k with
  | zero =>
      intro S hS _ hcard
      refine ⟨fun _ => 1, S, by omega, hS, by simpa using hcard, ?_⟩
      intro x hx y hy
      rw [Finset.range_zero, cubeI_empty, Finset.mem_singleton] at hy
      simpa [hy] using hx
  | succ k ih =>
      intro S hS hbig hcard
      have hkle : t ^ (2 ^ (k + 1)) ≤ t ^ (2 ^ k) :=
        pow_le_pow_of_le_one (le_of_lt ht0) ht1 (Nat.pow_le_pow_right (by omega) (by omega))
      have hnpos : (0 : ℝ) < n := by
        rcases Nat.eq_zero_or_pos n with rfl | hn
        · simp at hbig
          nlinarith [pow_pos ht0 (2 ^ (k + 1))]
        · exact_mod_cast hn
      have hbigk : 2 ≤ 4 * n * t ^ (2 ^ k) := by nlinarith [hkle, hnpos]
      obtain ⟨u, T, hu, hTsub, hTcard, hTprop⟩ := ih S hS hbigk hcard
      -- one more shift
      have hT2 : 2 ≤ T.card := by exact_mod_cast le_trans hbigk hTcard
      obtain ⟨v, hv, hshift⟩ := exists_shift hTsub hT2
      set T' : Finset ℕ := T.filter (fun x => x + v ∈ T) with hT'
      have hcT : (2 : ℝ) ≤ (T.card : ℝ) := by exact_mod_cast hT2
      have hsub1 : ((T.card - 1 : ℕ) : ℝ) = (T.card : ℝ) - 1 := by
        have : 1 ≤ T.card := by omega
        push_cast [Nat.cast_sub this]; ring
      have hshiftR : (T.card : ℝ) * ((T.card : ℝ) - 1) ≤ 2 * n * (T'.card : ℝ) := by
        have := hshift
        have hcastle : ((T.card * (T.card - 1) : ℕ) : ℝ) ≤ ((2 * n * T'.card : ℕ) : ℝ) := by
          exact_mod_cast this
        push_cast [hsub1] at hcastle
        linarith [hcastle]
      have hTcard' : 4 * n * t ^ (2 ^ (k + 1)) ≤ T'.card := by
        have hA : (0 : ℝ) < t ^ (2 ^ k) := pow_pos ht0 _
        have hsq : t ^ (2 ^ (k + 1)) = (t ^ (2 ^ k)) ^ 2 := by
          rw [← pow_mul, pow_succ]
        -- `|T'| ≥ |T|²/(4n) ≥ (4nA)²/(4n) = 4nA²`
        have h1 : (T.card : ℝ) * ((T.card : ℝ) - 1) ≥ (T.card : ℝ) ^ 2 / 2 := by nlinarith
        have h2 : (T.card : ℝ) ^ 2 / 2 ≤ 2 * n * (T'.card : ℝ) := by linarith [hshiftR]
        have h3 : (4 * n * t ^ (2 ^ k)) ^ 2 ≤ (T.card : ℝ) ^ 2 := by
          have h0 : (0 : ℝ) ≤ 4 * n * t ^ (2 ^ k) := by positivity
          nlinarith [hTcard]
        rw [hsq]
        nlinarith [h2, h3, hnpos]
      refine ⟨Function.update u k v, T', ?_, ?_, hTcard', ?_⟩
      · intro i hi
        rcases Nat.lt_or_ge i k with h | h
        · rw [Function.update_of_ne (by omega)]
          exact hu i h
        · have : i = k := by omega
          rw [this, Function.update_self]
          exact hv
      · exact (Finset.filter_subset _ _).trans hTsub
      · intro x hx y hy
        rw [hT', Finset.mem_filter] at hx
        rw [Finset.range_add_one, cubeI_insert (by simp), Function.update_self] at hy
        have hcong : cubeI (Function.update u k v) (range k) = cubeI u (range k) :=
          cubeI_congr (fun i hi => by
            rw [Function.update_of_ne (by simp only [Finset.mem_range] at hi; omega)])
        rw [hcong] at hy
        obtain ⟨z, hz, w, hw, rfl⟩ := Finset.mem_add.1 hy
        rcases Finset.mem_insert.1 hw with rfl | hw'
        · simpa using hTprop x hx.1 z hz
        · rw [Finset.mem_singleton] at hw'
          subst hw'
          have he : x + (z + w) = (x + w) + z := by ring
          rw [he]
          exact hTprop (x + w) hx.2 z hz

/-! ## The main theorem -/

/-- **Every dense set contains a sumset with both summands large.**

Let `S ⊆ [n]` with `|S| ≥ δ n`, and let `k` be such that the iteration survives, i.e.
`4 n (δ/4)^{2^k} ≥ 2`.  Then `S` contains a sumset `A + B` with
`|A| ≥ ⌊k/2⌋ + 1` and `|B| ≥ ⌊k/2⌋ + 1`.

Here `A` and `B` are (a translate of) the two halves of the `k`-dimensional cube produced
by the density iteration. -/
theorem exists_sumset_of_dense (δ : ℝ) (h0 : 0 < δ) (h1 : δ < 1) {n : ℕ} {S : Finset ℕ}
    (hS : S ⊆ range n) (hcard : δ * n ≤ S.card) (k : ℕ)
    (hk : 2 ≤ 4 * n * (δ / 4) ^ (2 ^ k)) :
    ∃ A B : Finset ℕ, A + B ⊆ S ∧ k / 2 + 1 ≤ A.card ∧ k / 2 + 1 ≤ B.card := by
  classical
  have ht0 : 0 < δ / 4 := by linarith
  have ht1 : δ / 4 ≤ 1 := by linarith
  have hcard' : 4 * (n : ℝ) * (δ / 4) ≤ S.card := by linarith [hcard]
  obtain ⟨u, T, hu, hTsub, hTcard, hTprop⟩ :=
    exists_cube_survivors n (δ / 4) ht0 ht1 k S hS hk hcard'
  have hTne : T.Nonempty := by
    rw [← Finset.card_pos]
    have : (2 : ℝ) ≤ (T.card : ℝ) := le_trans hk hTcard
    have : (2 : ℕ) ≤ T.card := by exact_mod_cast this
    omega
  obtain ⟨x, hx⟩ := hTne
  set j : ℕ := k / 2 with hj
  have hdisj : Disjoint (range j) (Ico j k) := by
    rw [Finset.disjoint_left]
    intro i hi hi'
    rw [Finset.mem_range] at hi
    rw [Finset.mem_Ico] at hi'
    omega
  have hunion : range j ∪ Ico j k = range k := by
    ext i
    simp only [Finset.mem_union, Finset.mem_range, Finset.mem_Ico]
    omega
  refine ⟨{x} + cubeI u (range j), cubeI u (Ico j k), ?_, ?_, ?_⟩
  · intro z hz
    rw [add_assoc, ← cubeI_union hdisj, hunion] at hz
    obtain ⟨x', hx', y, hy, rfl⟩ := Finset.mem_add.1 hz
    rw [Finset.mem_singleton] at hx'
    subst hx'
    exact hTprop _ hx y hy
  · rw [Finset.card_singleton_add]
    have := card_le_card_cubeI (u := u) (I := range j)
      (fun i hi => hu i (by rw [Finset.mem_range] at hi; omega))
    rwa [Finset.card_range] at this
  · have := card_le_card_cubeI (u := u) (I := Ico j k)
      (fun i hi => hu i (by rw [Finset.mem_Ico] at hi; omega))
    rw [Nat.card_Ico] at this
    omega

/-- **Logarithmic form.**  If `2^k · log(4/δ) ≤ log(2n)` then every `S ⊆ [n]` with
`|S| ≥ δ n` contains a sumset `A + B` with `min(|A|,|B|) ≥ ⌊k/2⌋ + 1`.  In other words a
`δ`-dense subset of `[n]` always contains a sumset of two sets of size at least
`½ log₂ (log(2n)/log(4/δ))`. -/
theorem exists_sumset_of_dense_log (δ : ℝ) (h0 : 0 < δ) (h1 : δ < 1) {n : ℕ} {S : Finset ℕ}
    (hn : 1 ≤ n) (hS : S ⊆ range n) (hcard : δ * n ≤ S.card) (k : ℕ)
    (hk : 2 ^ k * Real.log (4 / δ) ≤ Real.log (2 * n)) :
    ∃ A B : Finset ℕ, A + B ⊆ S ∧ k / 2 + 1 ≤ A.card ∧ k / 2 + 1 ≤ B.card := by
  have hnR : (1 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn
  refine exists_sumset_of_dense δ h0 h1 hS hcard k ?_
  -- `(δ/4)^{2^k} ≥ 1/(2n)`, by taking logarithms
  have hpos : (0 : ℝ) < (δ / 4) ^ (2 ^ k) := by positivity
  have hlogpow : Real.log ((δ / 4) ^ (2 ^ k)) = -(2 ^ k * Real.log (4 / δ)) := by
    rw [Real.log_pow]
    have : Real.log (δ / 4) = -Real.log (4 / δ) := by
      rw [← Real.log_inv]
      congr 1
      field_simp
    rw [this]
    push_cast
    ring
  have hlogle : Real.log (1 / (2 * n)) ≤ Real.log ((δ / 4) ^ (2 ^ k)) := by
    rw [hlogpow, one_div, Real.log_inv]
    linarith [hk]
  have hge : 1 / (2 * (n : ℝ)) ≤ (δ / 4) ^ (2 ^ k) :=
    (Real.log_le_log_iff (by positivity) hpos).1 hlogle
  have : 4 * (n : ℝ) * (1 / (2 * n)) ≤ 4 * n * (δ / 4) ^ (2 ^ k) := by
    have h4n : (0 : ℝ) < 4 * n := by linarith
    exact mul_le_mul_of_nonneg_left hge (le_of_lt h4n)
  have heq : 4 * (n : ℝ) * (1 / (2 * n)) = 2 := by field_simp; ring
  linarith [heq ▸ this]

/-- **Explicit `log log` bound.**  For `4/δ ≤ 2n`, every `S ⊆ [n]` with `|S| ≥ δ n`
contains a sumset `A + B` with

`min(|A|, |B|) ≥ ⌊log₂ ⌊log(2n)/log(4/δ)⌋⌋ / 2 + 1`,

which for fixed `δ` grows like `½ log₂ log n`. -/
theorem exists_sumset_of_dense_loglog (δ : ℝ) (h0 : 0 < δ) (h1 : δ < 1) {n : ℕ}
    {S : Finset ℕ} (hn : 1 ≤ n) (hδn : 4 / δ ≤ 2 * n) (hS : S ⊆ range n)
    (hcard : δ * n ≤ S.card) :
    ∃ A B : Finset ℕ, A + B ⊆ S ∧
      (Nat.log 2 ⌊Real.log (2 * n) / Real.log (4 / δ)⌋₊) / 2 + 1 ≤ A.card ∧
      (Nat.log 2 ⌊Real.log (2 * n) / Real.log (4 / δ)⌋₊) / 2 + 1 ≤ B.card := by
  have hnR : (1 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn
  have hlpos : 0 < Real.log (4 / δ) := Real.log_pos (by rw [lt_div_iff₀ h0]; linarith)
  have hratio : 1 ≤ Real.log (2 * n) / Real.log (4 / δ) := by
    rw [le_div_iff₀ hlpos]
    have := Real.log_le_log (by positivity) hδn
    linarith
  set K : ℕ := ⌊Real.log (2 * (n : ℝ)) / Real.log (4 / δ)⌋₊ with hK
  have hK1 : 1 ≤ K := Nat.le_floor (by exact_mod_cast hratio)
  set k : ℕ := Nat.log 2 K with hk
  have hpowk : 2 ^ k ≤ K := Nat.pow_log_le_self 2 (by omega)
  have hkR : (2 : ℝ) ^ k * Real.log (4 / δ) ≤ Real.log (2 * n) := by
    have h1' : ((2 ^ k : ℕ) : ℝ) ≤ (K : ℝ) := by exact_mod_cast hpowk
    have h2' : (K : ℝ) ≤ Real.log (2 * n) / Real.log (4 / δ) := Nat.floor_le (by linarith)
    rw [← le_div_iff₀ hlpos]
    push_cast at h1'
    linarith
  exact exists_sumset_of_dense_log δ h0 h1 hn hS hcard k hkR

end DenseCubes