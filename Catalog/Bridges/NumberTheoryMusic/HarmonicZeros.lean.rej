--- HarmonicZeros.lean
+++ HarmonicZeros.lean
@@ -155,4 +155,63 @@
     exact GraphZetaPrimeCycle.localFactor_factor l q u α β hs hp
   · exact graphZeta_reciprocal_harmonic l q α β hs hp hq hne
 
+/-- The reciprocal contribution of a conjugate pair on the critical line
+`re z = 1/2`, parameterized by its ordinate `t`. -/
+noncomputable def criticalPairHarmonic (t : ℝ) : ℂ :=
+  (((1 / 2 : ℝ) : ℂ) + Complex.I * t)⁻¹ +
+    (((1 / 2 : ℝ) : ℂ) - Complex.I * t)⁻¹
+
+/-
+A conjugate pair on the critical line makes the positive real contribution
+`1 / (1/4 + t²)` to the reciprocal-zero harmonic.
+-/
+theorem criticalPairHarmonic_eq (t : ℝ) :
+    criticalPairHarmonic t = ((1 / ((1 / 4 : ℝ) + t ^ 2) : ℝ) : ℂ) := by
+  unfold criticalPairHarmonic;
+  rw [ inv_add_inv ] <;> norm_num [ Complex.ext_iff ] ; ring;
+  norm_num [ Complex.normSq, sq ] ; ring
+
+/-- The harmonic of a finite collection of critical-line conjugate pairs. -/
+noncomputable def criticalWindowHarmonic (ordinates : Finset ℝ) : ℂ :=
+  ∑ t ∈ ordinates, criticalPairHarmonic t
+
+/-
+Exact positive-term formula for a finite critical-line window.
+-/
+theorem criticalWindowHarmonic_eq (ordinates : Finset ℝ) :
+    criticalWindowHarmonic ordinates =
+      (((∑ t ∈ ordinates, 1 / ((1 / 4 : ℝ) + t ^ 2)) : ℝ) : ℂ) := by
+  unfold criticalWindowHarmonic; simp [criticalPairHarmonic_eq]
+
+/-
+Every finite critical-line window has nonnegative real harmonic.
+-/
+theorem criticalWindowHarmonic_nonneg (ordinates : Finset ℝ) :
+    0 ≤ (criticalWindowHarmonic ordinates).re := by
+  rw [ criticalWindowHarmonic_eq ] ; norm_cast ; exact Finset.sum_nonneg fun _ _ ↦ by positivity;
+
+/-
+A nonempty finite critical-line window has strictly positive real harmonic.
+-/
+theorem criticalWindowHarmonic_pos {ordinates : Finset ℝ} (hne : ordinates.Nonempty) :
+    0 < (criticalWindowHarmonic ordinates).re := by
+  rw [ criticalWindowHarmonic_eq ] ; exact_mod_cast Finset.sum_pos ( fun x hx => one_div_pos.mpr <| by positivity ) hne;
+
+/-
+Adding ordinates can only increase the critical-line harmonic.
+-/
+theorem criticalWindowHarmonic_mono {s t : Finset ℝ} (hst : s ⊆ t) :
+    (criticalWindowHarmonic s).re ≤ (criticalWindowHarmonic t).re := by
+  unfold criticalWindowHarmonic;
+  simp +decide [ criticalPairHarmonic_eq ];
+  exact Finset.sum_le_sum_of_subset_of_nonneg hst fun _ _ _ => div_nonneg ( by norm_cast; positivity ) ( Complex.normSq_nonneg _ )
+
+/-
+A cardinality bound obtained from the critical-line separation `|z| ≥ 1/2`.
+-/
+theorem criticalWindowHarmonic_le_four_card (ordinates : Finset ℝ) :
+    (criticalWindowHarmonic ordinates).re ≤ 4 * ordinates.card := by
+  rw [ criticalWindowHarmonic_eq ] ; norm_cast ; simp +decide [ mul_comm ];
+  exact le_trans ( Finset.sum_le_sum fun x hx => inv_le_of_inv_le₀ ( by positivity ) <| show 4⁻¹ + x ^ 2 ≥ 4⁻¹ by nlinarith ) <| by norm_num;
+
 
