+-+--    rank-2 Levi subgroup for the simple root α₁. -/
+-+--def Levi12Compatible (D : TropDatum) : Prop :=
+-+--  ∀ a b : ℕ, D (a + 1, b) - D (a, b) = D (a + 1, 0) - D (a, 0)
