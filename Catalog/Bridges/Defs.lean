+----+    idempotent measure theory. -/
+----+def IsMaxitiveSetFun {X : Type*} [Preorder X] (μ : Set X → ℝ≥0∞) : Prop :=
+----+  ∀ A : Set X, μ A = ⨆ x ∈ A, μ (irreducibleClosed X x)
