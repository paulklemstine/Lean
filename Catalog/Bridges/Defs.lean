+-+--def SatakeAdmissible (D : TropDatum) : Prop :=
+-+--  EdgeValuationCompatible D ∧
+-+--  Levi12Compatible D ∧
+-+--  Levi23Compatible D ∧
+-+--  AdjacentFacetCompatible D
