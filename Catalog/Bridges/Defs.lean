+-----def transportCost {X : Type*} [Fintype X] [Nonempty X] [PseudoMetricSpace X]
+-----    {μ ν : MaxitiveProb X} (π : MaxitiveCoupling μ ν) : ℝ :=
+-----  (Finset.univ ×ˢ Finset.univ).sup'
+-----    (by simp [Finset.Nonempty]) fun p => π.toFun p.1 p.2 + dist p.1 p.2
