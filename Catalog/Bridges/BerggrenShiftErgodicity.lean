import Bridges.BerggrenHarmonicSingularity

/-!
# Ergodicity of the Berggren boundary shift

The shift `shift : Bdry → Bdry`, `x ↦ (x₁, x₂, …)`, forgets the first Berggren move of an
infinite word.  `BerggrenHarmonicSingularity` shows that it preserves every harmonic measure
`bernoulli P`.  Here we prove the sharper dynamical statement: the shift is *ergodic* for each
harmonic measure.

The proof is the classical tail-σ-algebra argument, carried out for the Berggren letters:

* the coordinate σ-algebras `coordSigma n` are independent under `bernoulli P`
  (`iIndep_coordSigma`);
* a strictly shift-invariant set `S` satisfies `S = (shift^[n]) ⁻¹' S`, and `shift^[n]` is
  measurable for the σ-algebra generated by the coordinates `≥ n`; hence `S` belongs to the
  tail σ-algebra (`tail_measurable_of_invariant`);
* Kolmogorov's 0-1 law then forces `bernoulli P S ∈ {0, 1}` (`measure_invariant_zero_or_one`).

## Main results

* `measurePreserving_shift` : the shift preserves the harmonic measure.
* `tail_triviality` : the tail σ-algebra of the Berggren letters is `bernoulli P`-trivial.
* `ergodic_shift` : **the Berggren boundary shift is ergodic for every harmonic measure.**
* `ae_eq_const_of_shift_invariant` : every shift-invariant boundary observable is a.e. constant.
* `bernoulli_mem_extremePoints` : the harmonic measures are exactly extreme points of the
  simplex of shift-invariant probability measures on the Berggren Cantor boundary.
-/

namespace BerggrenHarmonic

open MeasureTheory ProbabilityTheory Filter MeasurableSpace Set
open scoped Topology ENNReal

/-! ## Independence of the coordinate σ-algebras -/

/-- The σ-algebra generated by the `n`-th Berggren letter. -/
def coordSigma (n : ℕ) : MeasurableSpace Bdry :=
  MeasurableSpace.comap (fun x : Bdry => x n) inferInstance

lemma coordSigma_le (n : ℕ) : coordSigma n ≤ (inferInstance : MeasurableSpace Bdry) :=
  (measurable_pi_apply n).comap_le

/-- Under a harmonic measure the letters of a random Berggren word are independent, as
σ-algebras. -/
lemma iIndep_coordSigma (P : ProbVec) : iIndep coordSigma (bernoulli P) :=
  iIndepFun_infinitePi (X := fun _ : ℕ => (id : Letter → Letter)) (fun _ => measurable_id)

/-! ## Iterates of the shift and the tail σ-algebra -/

lemma shift_iterate (n : ℕ) (x : Bdry) (k : ℕ) : (shift^[n] x) k = x (k + n) := by
  induction n generalizing x with
  | zero => simp
  | succ m ih =>
      rw [Function.iterate_succ_apply, ih]
      simp only [shift]
      ring_nf

/-- `shift^[n]` only reads the letters from position `n` on. -/
lemma measurable_shift_iterate_tail (n : ℕ) :
    Measurable[⨆ i : ℕ, coordSigma (i + n)] (shift^[n]) := by
  rw [@measurable_pi_iff Bdry ℕ (fun _ => Letter) (⨆ i : ℕ, coordSigma (i + n)) _ (shift^[n])]
  intro k
  have h1 : Measurable[coordSigma (k + n)] (fun x : Bdry => x (k + n)) :=
    comap_le_iff_le_map.mp le_rfl
  have h3 := h1.mono (le_iSup (fun i => coordSigma (i + n)) k) le_rfl
  convert h3 using 1
  funext x
  exact shift_iterate n x k

lemma preimage_iterate_of_invariant {S : Set Bdry} (hS : shift ⁻¹' S = S) (n : ℕ) :
    (shift^[n]) ⁻¹' S = S := by
  induction n with
  | zero => rfl
  | succ m ih => rw [Function.iterate_succ, Set.preimage_comp, ih, hS]

/-- A strictly shift-invariant measurable set belongs to the tail σ-algebra of the letters:
whether an infinite Berggren word lies in `S` cannot be decided from any finite prefix. -/
lemma tail_measurable_of_invariant {S : Set Bdry} (hSm : MeasurableSet S)
    (hS : shift ⁻¹' S = S) : MeasurableSet[limsup coordSigma atTop] S := by
  rw [limsup_eq_iInf_iSup_of_nat', measurableSet_iInf]
  intro n
  have h := measurable_shift_iterate_tail n hSm
  rwa [preimage_iterate_of_invariant hS n] at h

/-- **Kolmogorov 0-1 law on the Berggren boundary.**  The tail σ-algebra of the letters is
trivial for every harmonic measure. -/
theorem tail_triviality (P : ProbVec) {S : Set Bdry}
    (hS : MeasurableSet[limsup coordSigma atTop] S) :
    bernoulli P S = 0 ∨ bernoulli P S = 1 :=
  measure_zero_or_one_of_measurableSet_limsup_atTop coordSigma_le (iIndep_coordSigma P) hS

theorem measure_invariant_zero_or_one (P : ProbVec) {S : Set Bdry} (hSm : MeasurableSet S)
    (hS : shift ⁻¹' S = S) : bernoulli P S = 0 ∨ bernoulli P S = 1 :=
  tail_triviality P (tail_measurable_of_invariant hSm hS)

/-! ## Ergodicity -/

theorem measurePreserving_shift (P : ProbVec) :
    MeasurePreserving shift (bernoulli P) (bernoulli P) :=
  ⟨measurable_shift, shift_invariant P⟩

/-- **The Berggren boundary shift is ergodic for every harmonic measure.**  Forgetting the first
Berggren move mixes the boundary completely: no nontrivial measurable event survives it. -/
theorem ergodic_shift (P : ProbVec) : Ergodic shift (bernoulli P) where
  toMeasurePreserving := measurePreserving_shift P
  aeconst_set := by
    intro S hSm hS
    rw [eventuallyConst_set']
    rcases measure_invariant_zero_or_one P hSm hS with h | h
    · exact Or.inl (ae_eq_empty.2 h)
    · refine Or.inr (ae_eq_univ.2 ?_)
      have h2 : bernoulli P Sᶜ = bernoulli P univ - bernoulli P S :=
        measure_compl hSm (measure_ne_top (bernoulli P) S)
      rw [h2, h, measure_univ, tsub_self]

/-- Any boundary observable that is invariant under forgetting the first Berggren move is
almost surely constant. -/
theorem ae_eq_const_of_shift_invariant (P : ProbVec) {g : Bdry → ℝ} (hg : Measurable g)
    (hinv : g ∘ shift = g) : ∃ c, g =ᵐ[bernoulli P] fun _ => c :=
  (ergodic_shift P).toPreErgodic.ae_eq_const_of_ae_eq_comp hg hinv

/-- The harmonic measures are extreme points of the simplex of shift-invariant probability
measures on the Berggren Cantor boundary: they are the *pure* stationary states of the walk. -/
theorem bernoulli_mem_extremePoints (P : ProbVec) :
    bernoulli P ∈
      extremePoints ℝ≥0∞ {ν : Measure Bdry | MeasurePreserving shift ν ν ∧ IsProbabilityMeasure ν} :=
  (ergodic_shift P).mem_extremePoints

end BerggrenHarmonic