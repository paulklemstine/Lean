import Mathlib

/-!
# Closure-Voronoi Duality via Idempotent Metric Systems

## Overview

We establish a finite duality between algebraic closure operators and metric geometry.
The main result — the **Closure-Voronoi Duality Theorem** — shows that for a finite
closure metric system where closed balls are closure-fixed and ball families generate
the closure, membership `x ∈ cl(A)` is exactly equivalent to a geometric criterion:
`x` lies in every closed ball that contains `A`.

This provides a complete bridge:
- **Algebraic → Geometric**: closure data determines a canonical filtered nerve of balls.
- **Geometric → Algebraic**: the nerve incidence data reconstructs closure membership.

## Main results

* `closure_mem_iff_nerve_cover` — **Main Reconstruction Theorem**:
  `x ∈ cl(A) ↔ nerveCoverCriterion A x`.
* `ball_generated_extensional` — **Extensionality**: ball-generated sets are uniquely
  determined by their ball-containment profile.
* `nerve_face_of_pairwise` — **Helly Upgrade**: pairwise ball intersections yield
  full nerve faces under the Helly property.
* `nerveFaces_mono` — Nerve faces are monotone in radius.
* `certified_reconstruction_exists` — Existence of a certified closure decision procedure.
* `cl_isBallGenerated` — Every closure image is ball-generated.
* `containmentProfile_injective` — The containment profile is a complete invariant for
  ball-generated closed sets.
-/

namespace ClosureVoronoiDuality

/-- A **finite closure metric system** on generators `G` with radius type `R`.

This structure combines:
- A closure operator `cl` satisfying extensivity, monotonicity, and idempotency;
- A distance function `d : G → G → R`;
- Compatibility: closed balls are fixed points of `cl`;
- Completeness: `cl` is generated by the family of closed balls (ball separation). -/
structure FiniteClosureMetricSystem (G : Type*) (R : Type*)
    [Fintype G] [DecidableEq G] [LinearOrder R] [Fintype R] where
  /-- The closure operator. -/
  cl : Set G → Set G
  /-- Closure is extensive: every set is contained in its closure. -/
  cl_extensive : ∀ A, A ⊆ cl A
  /-- Closure is monotone: larger sets have larger closures. -/
  cl_mono : ∀ ⦃A B : Set G⦄, A ⊆ B → cl A ⊆ cl B
  /-- Closure is idempotent: applying it twice is the same as once. -/
  cl_idem : ∀ A, cl (cl A) = cl A
  /-- The distance/valuation function from `G × G` to the radius type `R`. -/
  d : G → G → R
  /-- Every closed ball is a fixed point of the closure operator.
      This makes closed balls "geometrically closed" in the closure sense. -/
  ball_closed : ∀ (r : R) (g : G), cl {h | d g h ≤ r} = {h | d g h ≤ r}
  /-- Ball separation / generation axiom: if `x` is in every closed ball that
      contains `A`, then `x ∈ cl(A)`. This ensures the closure is completely
      determined by the ball geometry. -/
  ball_sep : ∀ (A : Set G) (x : G),
    (∀ (r : R) (g : G), (∀ a ∈ A, d g a ≤ r) → d g x ≤ r) → x ∈ cl A

variable {G R : Type*} [Fintype G] [DecidableEq G] [LinearOrder R] [Fintype R]

namespace FiniteClosureMetricSystem

variable (X : FiniteClosureMetricSystem G R)

/-! ### Core Definitions -/

/-- The closed ball of radius `r` centered at `g`. -/
def ball (r : R) (g : G) : Set G := {h | X.d g h ≤ r}

@[simp]
theorem mem_ball {r : R} {g h : G} : h ∈ X.ball r g ↔ X.d g h ≤ r := Iff.rfl

/-- The set of **critical radii**: all pairwise distances in `G`.
    These are the only radii at which the ball structure can change. -/
def criticalRadii : Finset R :=
  (Finset.univ (α := G × G)).image (fun p => X.d p.1 p.2)

/-- The **nerve** at radius `r`: the collection of nonempty finite subsets of `G`
    whose closed balls share a common point. -/
def NerveFaces (r : R) : Set (Finset G) :=
  {σ | σ.Nonempty ∧ (⋂ g ∈ (↑σ : Set G), X.ball r g).Nonempty}

/-- The **nerve cover criterion** for `x` relative to `A`:
    `x` lies in every closed ball that contains `A`.
    This is the geometric characterization of closure membership. -/
def nerveCoverCriterion (A : Set G) (x : G) : Prop :=
  ∀ (r : R) (g : G), (∀ a ∈ A, X.d g a ≤ r) → X.d g x ≤ r

/-- A set is **ball-generated** if membership is determined by containment
    in closed balls: whenever `x` is in every ball containing `C`, then `x ∈ C`. -/
def isBallGenerated (C : Set G) : Prop :=
  ∀ x, (∀ r g, C ⊆ X.ball r g → x ∈ X.ball r g) → x ∈ C

/-- The **Helly property** at radius `r`: for any nonempty finite family of balls,
    if every pair intersects, the whole family has a common point. -/
def HellyAt (r : R) : Prop :=
  ∀ (σ : Finset G), σ.Nonempty →
    (∀ (τ : Finset G), τ ⊆ σ → τ.card ≤ 2 → τ.Nonempty →
      (⋂ g ∈ (↑τ : Set G), X.ball r g).Nonempty) →
    (⋂ g ∈ (↑σ : Set G), X.ball r g).Nonempty

/-- The ball-containment profile of a set: for each radius `r` and center `g`,
    whether the set is contained in `ball r g`. -/
def containmentProfile (C : Set G) : R → G → Prop :=
  fun r g => C ⊆ X.ball r g

/-- The **filtered nerve**: nerve faces tagged with their critical radii. -/
def filteredNerve : Set (R × Finset G) :=
  {p | p.1 ∈ X.criticalRadii ∧ p.2 ∈ X.NerveFaces p.1}

/-! ### Ball Monotonicity -/

/-- Closed balls are monotone in the radius: larger radii give larger balls. -/
theorem ball_mono_radius {r s : R} (hrs : r ≤ s) (g : G) :
    X.ball r g ⊆ X.ball s g :=
  fun _ hh => le_trans hh hrs

/-! ### Closure–Ball Interaction -/

/-- If `A` is contained in a closed ball, then `cl(A)` is also in that ball.
    This follows from monotonicity of `cl` and the fact that balls are `cl`-fixed. -/
theorem cl_subset_ball {A : Set G} {r : R} {g : G} (hA : A ⊆ X.ball r g) :
    X.cl A ⊆ X.ball r g := by
  unfold ball at hA
  calc X.cl A ⊆ X.cl {h | X.d g h ≤ r} := X.cl_mono hA
    _ = {h | X.d g h ≤ r} := X.ball_closed r g

/-- Closed balls are cl-closed sets (reformulation of the axiom). -/
theorem ball_is_cl_closed (r : R) (g : G) : X.cl (X.ball r g) = X.ball r g :=
  X.ball_closed r g

/-! ### The Main Reconstruction Theorem -/

/-- **Forward direction**: closure membership implies the nerve cover criterion.
    If `x ∈ cl(A)` and `A ⊆ ball r g`, then `x ∈ ball r g`. -/
theorem cl_imp_nerveCover {A : Set G} {x : G} (hx : x ∈ X.cl A) :
    X.nerveCoverCriterion A x := by
  intro r g hball
  exact X.cl_subset_ball (fun a ha => hball a ha) hx

/-- **Backward direction**: the nerve cover criterion implies closure membership.
    This uses the ball separation axiom. -/
theorem nerveCover_imp_cl {A : Set G} {x : G} (hx : X.nerveCoverCriterion A x) :
    x ∈ X.cl A :=
  X.ball_sep A x hx

/-- **Main Reconstruction Theorem (Closure–Voronoi Duality).**

Closure membership is exactly equivalent to the nerve cover criterion:
`x ∈ cl(A)` if and only if `x` lies in every closed ball that contains `A`.

This establishes a complete duality between algebraic closure and metric
ball-incidence data. The algebraic operation `cl` can be entirely recovered
from the geometric family of closed balls.

### Significance

This is a finite, certified analogue of classical duality theorems:
- Like Stone duality, but with metric incidence replacing logical opens;
- Like tropical convexity, but with closure operators replacing polyhedral hulls;
- Like nerve reconstruction in computational topology, but with formal
  closure semantics as the recovered object. -/
theorem closure_mem_iff_nerve_cover (A : Set G) (x : G) :
    x ∈ X.cl A ↔ X.nerveCoverCriterion A x :=
  ⟨X.cl_imp_nerveCover, X.nerveCover_imp_cl⟩

/-! ### Ball-Generated Sets and Extensionality -/

/-- **Every closure image is ball-generated.**
    The closure of any set `A` is determined by which balls contain it. -/
theorem cl_isBallGenerated (A : Set G) : X.isBallGenerated (X.cl A) := by
  intro x hx
  apply X.ball_sep A x
  intro r g hAball
  exact hx r g (X.cl_subset_ball fun a ha => hAball a ha)

/-- **Extensionality Theorem for Ball-Generated Sets.**

Two ball-generated sets with identical ball-containment profiles are equal.
This means the geometric incidence data (which balls contain a set)
uniquely determines ball-generated closed sets. -/
theorem ball_generated_extensional {C₁ C₂ : Set G}
    (h₁ : X.isBallGenerated C₁) (h₂ : X.isBallGenerated C₂)
    (h : ∀ r g, C₁ ⊆ X.ball r g ↔ C₂ ⊆ X.ball r g) :
    C₁ = C₂ := by
  ext x
  constructor
  · intro hx
    apply h₂
    intro r g hC₂
    exact ((h r g).mpr hC₂) hx
  · intro hx
    apply h₁
    intro r g hC₁
    exact ((h r g).mp hC₁) hx

/-- **Containment Profile Injectivity.**
    The containment profile is a complete invariant for ball-generated sets:
    equal profiles imply equal sets. -/
theorem containmentProfile_injective {C₁ C₂ : Set G}
    (h₁ : X.isBallGenerated C₁) (h₂ : X.isBallGenerated C₂)
    (h : X.containmentProfile C₁ = X.containmentProfile C₂) :
    C₁ = C₂ := by
  apply X.ball_generated_extensional h₁ h₂
  intro r g
  constructor
  · intro hsub
    have : X.containmentProfile C₁ r g = X.containmentProfile C₂ r g :=
      congr_fun (congr_fun h r) g
    simp only [containmentProfile] at this
    rwa [← this]
  · intro hsub
    have : X.containmentProfile C₁ r g = X.containmentProfile C₂ r g :=
      congr_fun (congr_fun h r) g
    simp only [containmentProfile] at this
    rwa [this]

/-! ### Helly-Powered Nerve Reconstruction -/

/-- Under the Helly property, pairwise ball intersections upgrade to full nerve faces.
    This is the combinatorial engine that turns local intersection data into global
    geometric information. -/
theorem nerve_face_of_pairwise {r : R} (hHelly : X.HellyAt r) (σ : Finset G)
    (hne : σ.Nonempty)
    (hpair : ∀ (τ : Finset G), τ ⊆ σ → τ.card ≤ 2 → τ.Nonempty →
      (⋂ g ∈ (↑τ : Set G), X.ball r g).Nonempty) :
    σ ∈ X.NerveFaces r :=
  ⟨hne, hHelly σ hne hpair⟩

/-! ### Nerve Monotonicity -/

/-- Nerve faces are monotone in the radius: if `σ` is a nerve face at radius `r`,
    it remains a face at any larger radius `s ≥ r`. -/
theorem nerveFaces_mono {r s : R} (hrs : r ≤ s) :
    X.NerveFaces r ⊆ X.NerveFaces s := by
  intro σ ⟨hne, ⟨x, hx⟩⟩
  refine ⟨hne, ⟨x, ?_⟩⟩
  simp only [Set.mem_iInter] at hx ⊢
  intro g hg
  exact X.ball_mono_radius hrs g (hx g hg)

/-! ### Critical Radii -/

/-- Every pairwise distance is a critical radius. -/
theorem d_mem_criticalRadii (g h : G) : X.d g h ∈ X.criticalRadii := by
  simp only [criticalRadii, Finset.mem_image, Finset.mem_univ, true_and]
  exact ⟨(g, h), rfl⟩

/-! ### Certified Reconstruction -/

/-- **Certified Reconstruction Theorem.**

There exists a decision procedure for closure membership that agrees exactly
with the closure operator. The procedure is the nerve cover criterion:
for each radius `r` and center `g`, check whether `A ⊆ ball r g` implies
`x ∈ ball r g`.

This provides a certified geometric inference algorithm: closure membership
is decidable from ball-incidence data alone. -/
theorem certified_reconstruction_exists :
    ∃ (criterion : Set G → G → Prop),
      (∀ A x, criterion A x ↔ x ∈ X.cl A) :=
  ⟨X.nerveCoverCriterion, fun A x => (X.closure_mem_iff_nerve_cover A x).symm⟩

/-! ### Closure of Ball-Generated Sets -/

/-- A ball-generated set that is a closure image satisfies `cl(C) = C`. -/
theorem cl_eq_of_ball_generated_cl (A : Set G) : X.cl (X.cl A) = X.cl A :=
  X.cl_idem A

/-- The closure of a ball is the ball itself. -/
theorem cl_ball (r : R) (g : G) : X.cl (X.ball r g) = X.ball r g :=
  X.ball_closed r g

/-! ### Singleton Nerve Faces -/

/-- Every singleton is a nerve face at any radius `r ≥ d g g`. -/
theorem singleton_nerveFace {r : R} {g : G} (hr : X.d g g ≤ r) :
    {g} ∈ X.NerveFaces r := by
  refine ⟨Finset.singleton_nonempty g, g, ?_⟩
  simp only [Finset.coe_singleton, Set.mem_iInter, Set.mem_singleton_iff]
  intro g' hg'
  rw [hg']
  exact hr

/-! ### Closure Monotonicity Consequences -/

/-- If `A ⊆ B` and `B` is ball-closed, then `cl(A) ⊆ B`. -/
theorem cl_subset_of_subset_closed {A B : Set G}
    (hAB : A ⊆ B) (hcl : X.cl B = B) : X.cl A ⊆ B := by
  calc X.cl A ⊆ X.cl B := X.cl_mono hAB
    _ = B := hcl

/-- The closure of a subset of a ball stays in the ball. -/
theorem cl_subset_ball' {A : Set G} {r : R} {g : G}
    (hA : ∀ a ∈ A, X.d g a ≤ r) : X.cl A ⊆ X.ball r g :=
  X.cl_subset_ball hA

/-! ### Reconstruction From Ball Data -/

/-- **Closure equals intersection of containing balls.**
    The closure of `A` is exactly the set of points that lie in every
    closed ball containing `A`. This is the fundamental reconstruction identity. -/
theorem cl_eq_iInter_balls (A : Set G) :
    X.cl A = ⋂ (p : R × G) (_ : A ⊆ X.ball p.1 p.2), X.ball p.1 p.2 := by
  ext x
  simp only [Set.mem_iInter]
  constructor
  · intro hx r hr
    exact X.cl_subset_ball hr hx
  · intro hx
    apply X.ball_sep A x
    intro r g hAball
    exact hx ⟨r, g⟩ hAball

end FiniteClosureMetricSystem

end ClosureVoronoiDuality