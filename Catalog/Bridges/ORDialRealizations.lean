import Mathlib
import Bridges.ORDialMaximum

/-!
# Realizations of the OR-dial maximum: quadratic residues attain the cap

`Bridges.ORDialMaximum` proves that every class-rate profile on every finite abelian
class group gives at most `orCap = g(2) = 0.31128…` bits, and that an index-two subgroup
kernel attains it.  This file supplies the arithmetic realizations claimed in paper 73:

* `exists_index_two_of_cyclic`: a finite cyclic group of even order has an index-two
  subgroup (the squares), constructed as `zpowers (g²)` for a generator `g`;
* `mem_zpowers_sq_iff_isSquare`: that subgroup *is* the subgroup of squares, i.e. the
  quadratic-residue subgroup;
* `orDial_isGreatest_units_zmod`: for every odd prime `p`, the OR dial on the class group
  `(ℤ/p)ˣ` has global maximum `orCap`, attained by the quadratic-residue (Legendre-symbol)
  kernel — this covers `p = 5` (`ℚ(√5)`), `p = 11` (`ℚ(√-11)`), etc.;
* `orDial_isGreatest_units_zmod_four`: the same for the non-prime conductor `m = 4`
  (the Gaussian character), where the unit group is `C₂` and the kernel is trivial.
-/

open Real

namespace ORDial

/-- In a finite cyclic group with generator `g`, the cyclic subgroup generated by `g²` is
exactly the subgroup of squares. -/
lemma mem_zpowers_sq_iff_isSquare {G : Type*} [Group G] {g : G}
    (hg : ∀ x : G, x ∈ Subgroup.zpowers g) (x : G) :
    x ∈ Subgroup.zpowers (g ^ 2) ↔ IsSquare x := by
  constructor
  · rintro ⟨n, rfl⟩
    exact ⟨g ^ n, by show (g ^ 2) ^ n = g ^ n * g ^ n; group⟩
  · rintro ⟨y, rfl⟩
    obtain ⟨n, rfl⟩ := hg y
    exact ⟨n, by show (g ^ 2) ^ n = g ^ n * g ^ n; group⟩

/-- **A finite cyclic group of even order has an index-two subgroup**, namely its squares. -/
lemma exists_index_two_of_cyclic (G : Type*) [Group G] [Finite G] [IsCyclic G]
    (h : 2 ∣ Nat.card G) : ∃ K : Subgroup G, K.index = 2 ∧ ∀ x, x ∈ K ↔ IsSquare x := by
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := G)
  have hord : orderOf g = Nat.card G := orderOf_eq_card_of_forall_mem_zpowers hg
  have hpos : 0 < Nat.card G := Nat.card_pos
  refine ⟨Subgroup.zpowers (g ^ 2), ?_, mem_zpowers_sq_iff_isSquare hg⟩
  have hcard : Nat.card (Subgroup.zpowers (g ^ 2)) = Nat.card G / 2 := by
    rw [Nat.card_zpowers, orderOf_pow, hord, Nat.gcd_eq_right h]
  have hmul := Subgroup.card_mul_index (Subgroup.zpowers (g ^ 2))
  obtain ⟨k, hk⟩ := h
  rw [hk] at hpos
  have hk0 : 0 < k := by omega
  have hcard' : Nat.card (Subgroup.zpowers (g ^ 2)) = k := by rw [hcard, hk]; omega
  rw [hcard', hk] at hmul
  exact Nat.eq_of_mul_eq_mul_left hk0 (by rw [hmul]; ring)

/-- **The quadratic-residue kernel of `(ℤ/p)ˣ` has index two** for every odd prime `p`. -/
theorem exists_index_two_units_zmod (p : ℕ) [Fact p.Prime] (hp : p ≠ 2) :
    ∃ K : Subgroup (ZMod p)ˣ, K.index = 2 ∧ ∀ x, x ∈ K ↔ IsSquare x := by
  have hodd : Odd p := (Nat.Prime.odd_of_ne_two Fact.out hp)
  have hcard : Nat.card ((ZMod p)ˣ) = p - 1 := by
    rw [Nat.card_eq_fintype_card, ZMod.card_units_eq_totient, Nat.totient_prime Fact.out]
  have h2 : 2 ∣ Nat.card ((ZMod p)ˣ) := by
    rw [hcard]
    obtain ⟨k, hk⟩ := hodd
    omega
  exact exists_index_two_of_cyclic _ h2

/-- **The OR dial on `(ℤ/p)ˣ` has global maximum `g(2)`** for every odd prime `p`, attained
by the quadratic-residue (Legendre-symbol) kernel profile.  This is the exact statement
verified numerically for `p = 5, 7, 11` in paper 73: `ℚ(√5)`, `ℚ(√-11)`, … all sit at the
cap, `P(OR) = 3/4`. -/
theorem orDial_isGreatest_units_zmod (p : ℕ) [Fact p.Prime] (hp : p ≠ 2) :
    IsGreatest {x : ℝ | ∃ s : (ZMod p)ˣ → ℝ, (∀ a, 0 ≤ s a ∧ s a ≤ 1) ∧ orInfo s = x} orCap := by
  obtain ⟨K, hK, -⟩ := exists_index_two_units_zmod p hp
  exact orDial_isGreatest K hK

/-- The Gaussian conductor `m = 4`: the unit group is `C₂`, the quadratic character is
`χ₄`, its kernel is trivial of index two, and the dial again peaks at `g(2)`. -/
theorem orDial_isGreatest_units_zmod_four :
    IsGreatest {x : ℝ | ∃ s : (ZMod 4)ˣ → ℝ, (∀ a, 0 ≤ s a ∧ s a ≤ 1) ∧ orInfo s = x} orCap := by
  have hcard : Nat.card ((ZMod 4)ˣ) = 2 := by
    rw [Nat.card_eq_fintype_card, ZMod.card_units_eq_totient]
    decide
  refine orDial_isGreatest (⊥ : Subgroup (ZMod 4)ˣ) ?_
  rw [Subgroup.index_bot, hcard]

/-- The cap value in the form used in the papers: `H(3/4) - ½H(1/2)`, i.e. `0.3113` bits,
attained with `P(OR) = 3/4`. -/
theorem orCap_value_bits : 0.3111 < orCap / Real.log 2 ∧ orCap / Real.log 2 < 0.3114 :=
  orCap_bits_bounds

end ORDial