import Mathlib

/-!
# Pythagorean Lattice Reduction for Integer Factoring

## Overview

We establish a formal bridge between Pythagorean triple arithmetic (via the Berggren tree)
and integer factoring, proving several tiers of results:

1. **Square-root collision theorem**: A nontrivial square-root collision modulo `n` yields
   a nontrivial factor of `n`. This is the core arithmetic engine underlying the
   quadratic sieve and Shor's algorithm.

2. **Square divisor factor extraction**: If `n | c²` but `n ∤ c`, then `gcd(c, n)` is a
   nontrivial factor. Applied to Pythagorean triples `a²+b²=c²`, this yields factors
   from triples whose hypotenuse is partially divisible by `n`.

3. **Euclid parametrization**: The classical `(m²-k², 2mk, m²+k²)` parametrization
   always produces Pythagorean triples.

4. **Berggren orbit preservation**: All triples generated by the Berggren ternary tree
   are Pythagorean, with the quadratic form preserved by each generator.

5. **Reduction theorem**: Factoring reduces to finding a vector satisfying
   a quadratic congruence side-condition.

## References

- Berggren, B. (1934). "Pytagoreiska trianglar"
- Barning, F. J. M. (1963). "Over pythagorese en bijna-pythagorese driehoeken"
-/

open Int Nat Matrix

set_option maxHeartbeats 800000

/-! ## Definitions -/

/-- A vector `v : Fin 3 → ℤ` represents a Pythagorean triple: `v₀² + v₁² = v₂²`. -/
def IsPythTriple (v : Fin 3 → ℤ) : Prop :=
  v 0 ^ 2 + v 1 ^ 2 = v 2 ^ 2

/-- The Euclid parametrization of a Pythagorean triple:
    `(m² - k², 2mk, m² + k²)`. -/
def EuclidTriple (m k : ℤ) : Fin 3 → ℤ :=
  ![m ^ 2 - k ^ 2, 2 * m * k, m ^ 2 + k ^ 2]

/-- The Pythagorean quadratic form `Q(a,b,c) = a² + b² - c²`. -/
def QForm (v : Fin 3 → ℤ) : ℤ := v 0 ^ 2 + v 1 ^ 2 - v 2 ^ 2

/-- The three Berggren matrices generating the ternary tree of primitive Pythagorean triples.
    Generator 0 = U (left), 1 = A (middle), 2 = D (right). -/
def BerggrenMat' : Fin 3 → Matrix (Fin 3) (Fin 3) ℤ
  | ⟨0, _⟩ => !![1, -2, 2; 2, -1, 2; 2, -2, 3]
  | ⟨1, _⟩ => !![1, 2, 2; 2, 1, 2; 2, 2, 3]
  | ⟨2, _⟩ => !![-1, 2, 2; -2, 1, 2; -2, 2, 3]

/-- A Berggren word: a finite sequence of generator indices in `{0, 1, 2}`. -/
abbrev BWord' := List (Fin 3)

/-- Matrix product of a Berggren word: the composition of generators. -/
def BWordMatrix' : BWord' → Matrix (Fin 3) (Fin 3) ℤ
  | [] => 1
  | i :: w => BerggrenMat' i * BWordMatrix' w

/-- Root triple `(3, 4, 5)`: the seed of the Berggren tree. -/
def rootVec' : Fin 3 → ℤ := ![3, 4, 5]

/-- Triple obtained by applying a Berggren word to the root `(3, 4, 5)`. -/
def BWordTriple' (w : BWord') : Fin 3 → ℤ := (BWordMatrix' w).mulVec rootVec'

/-- A lattice-based factoring instance. -/
structure FactoringInstance where
  n : ℕ
  basis : Matrix (Fin 3) (Fin 3) ℤ
  sideCond : (Fin 3 → ℤ) → Prop

/-- A short vector solution: a nonzero vector satisfying the side condition. -/
def HasShortVectorSolution (I : FactoringInstance) : Prop :=
  ∃ v : Fin 3 → ℤ, v ≠ 0 ∧ I.sideCond v

/-- The collision side condition: a Pythagorean triple where `n | a² - b²`
    but `n ∤ a - b` and `n ∤ a + b`. -/
def CollisionSideCond (n : ℕ) (v : Fin 3 → ℤ) : Prop :=
  IsPythTriple v ∧
  (n : ℤ) ∣ v 0 ^ 2 - v 1 ^ 2 ∧
  ¬ (n : ℤ) ∣ v 0 - v 1 ∧
  ¬ (n : ℤ) ∣ v 0 + v 1

/-- The hypotenuse-gcd side condition: `n | (a² + b²)` but `n ∤ c`. -/
def HypGcdSideCond (n : ℕ) (v : Fin 3 → ℤ) : Prop :=
  IsPythTriple v ∧
  (n : ℤ) ∣ v 0 ^ 2 + v 1 ^ 2 ∧
  ¬ (n : ℤ) ∣ v 2

/-! ## Part 1: Square-Root Collision Yields Factor -/

/-- **Key arithmetic lemma**: If `n` divides a product `a * b` but divides neither
    factor individually, then `gcd(a, n)` is a nontrivial factor of `n`. -/
theorem gcd_nontrivial_of_dvd_mul_not_dvd
    (n : ℕ) (hn : 1 < n) (a b : ℤ)
    (hdvd : (n : ℤ) ∣ a * b)
    (hna : ¬ (n : ℤ) ∣ a)
    (hnb : ¬ (n : ℤ) ∣ b) :
    1 < Int.gcd a n ∧ Int.gcd a n < n ∧ (Int.gcd a n : ℤ) ∣ (n : ℤ) := by
  refine ⟨lt_of_le_of_ne (Nat.gcd_pos_of_pos_right _ (by positivity)) (Ne.symm ?_), ?_, ?_⟩
  · exact fun h => hnb <| Int.dvd_of_dvd_mul_right_of_gcd_one hdvd <|
      by simpa [Int.gcd_comm] using h
  · exact lt_of_le_of_ne
      (Nat.le_of_dvd hn.le (Int.natCast_dvd_natCast.mp (Int.gcd_dvd_right _ _)))
      fun con => hna <| Int.natCast_dvd.mpr <| con ▸ Nat.gcd_dvd_left _ _
  · exact Int.gcd_dvd_right _ _

/-- **Square-root collision yields factor** (integer formulation).
    If `x² ≡ y² (mod n)` but `x ≢ y (mod n)` and `x ≢ -y (mod n)`,
    then `n` has a nontrivial divisor `d` with `1 < d < n`. -/
theorem square_collision_yields_factor
    (n : ℕ) (hn : 1 < n)
    (x y : ℤ)
    (hdvd : (n : ℤ) ∣ x ^ 2 - y ^ 2)
    (hndvd1 : ¬ (n : ℤ) ∣ x - y)
    (hndvd2 : ¬ (n : ℤ) ∣ x + y) :
    ∃ d : ℕ, 1 < d ∧ d < n ∧ d ∣ n := by
  have h_gcd := gcd_nontrivial_of_dvd_mul_not_dvd n hn (x - y) (x + y)
    (by convert hdvd using 1; ring) hndvd1 hndvd2
  exact ⟨_, h_gcd.1, h_gcd.2.1, mod_cast h_gcd.2.2⟩

/-! ## Part 2: Square Divisor Factor Extraction -/

/-
If `n > 1` divides `c²` but not `c`, then `gcd(c, n)` is a nontrivial factor of `n`.
-/
theorem factor_of_square_dvd_not_dvd
    (n : ℕ) (hn : 1 < n)
    (c : ℤ)
    (h_sq_dvd : (n : ℤ) ∣ c ^ 2)
    (h_not_dvd : ¬ (n : ℤ) ∣ c) :
    ∃ d : ℕ, 1 < d ∧ d < n ∧ d ∣ n := by
  -- By definition of gcd, we know that gcd(c, n) is a divisor of n.
  have h_gcd_div : (Int.gcd c n : ℤ) ∣ n := by
    exact Int.gcd_dvd_right _ _;
  have h_gcd_ne_one : Int.gcd c n ≠ 1 := by
    exact fun h => h_not_dvd <| Int.dvd_of_dvd_mul_left_of_gcd_one ( by simpa [ sq ] using h_sq_dvd ) <| by simpa [ Int.gcd_comm ] using h;
  have h_gcd_ne_n : Int.gcd c n ≠ n := by
    exact fun h => h_not_dvd <| Int.dvd_trans ( by norm_num ) <| h ▸ Int.gcd_dvd_left _ _;
  exact ⟨ Int.gcd c n, lt_of_le_of_ne ( Nat.gcd_pos_of_pos_right _ ( pos_of_gt hn ) ) ( Ne.symm h_gcd_ne_one ), lt_of_le_of_ne ( Nat.le_of_dvd hn.le ( Int.natCast_dvd_natCast.mp h_gcd_div ) ) h_gcd_ne_n, Int.natCast_dvd_natCast.mp h_gcd_div ⟩

/-- **Pythagorean factor extraction**: Given `a² + b² = c²` with `n | (a² + b²)` but
    `n ∤ c`, extract a nontrivial factor of `n`. -/
theorem factor_of_pythagorean_hyp_partial_dvd
    (n : ℕ) (hn : 1 < n)
    (v : Fin 3 → ℤ)
    (hpyth : IsPythTriple v)
    (h_sum_dvd : (n : ℤ) ∣ v 0 ^ 2 + v 1 ^ 2)
    (h_not_dvd : ¬ (n : ℤ) ∣ v 2) :
    ∃ d : ℕ, 1 < d ∧ d < n ∧ d ∣ n := by
  apply factor_of_square_dvd_not_dvd n hn (v 2)
  · rwa [← hpyth]
  · exact h_not_dvd

/-! ## Part 3: Euclid Parametrization -/

/-- **Euclid's identity**: `(m² - k²)² + (2mk)² = (m² + k²)²` -/
theorem euclidTriple_pythagorean (m k : ℤ) : IsPythTriple (EuclidTriple m k) := by
  exact show (m ^ 2 - k ^ 2) ^ 2 + (2 * m * k) ^ 2 = (m ^ 2 + k ^ 2) ^ 2 by ring

/-! ## Part 4: Berggren Orbit Preservation -/

/-- `Q = 0` iff Pythagorean triple. -/
theorem qform_zero_iff_pyth (v : Fin 3 → ℤ) : QForm v = 0 ↔ IsPythTriple v := by
  unfold QForm IsPythTriple; omega

/-- Each Berggren generator preserves the quadratic form `Q`. -/
theorem berggren_preserves_qform (g : Fin 3) (v : Fin 3 → ℤ) :
    QForm ((BerggrenMat' g).mulVec v) = QForm v := by
  fin_cases g <;> simp +decide [QForm]
  · simp +decide [BerggrenMat', Matrix.mulVec]; ring!
  · simp +decide [BerggrenMat', Matrix.mulVec]; ring!
  · simp +decide [BerggrenMat', Matrix.mulVec]; ring!

/-- The root `(3, 4, 5)` is a Pythagorean triple. -/
theorem root_is_pyth : IsPythTriple rootVec' := by
  exact show (3 : ℤ) ^ 2 + 4 ^ 2 = 5 ^ 2 by decide

/-- **Berggren orbit theorem**: All Berggren-generated triples are Pythagorean. -/
theorem berggren_word_pythagorean' (w : BWord') : IsPythTriple (BWordTriple' w) := by
  induction' w with i w ih
  · exact root_is_pyth
  · have h_eq : BWordTriple' (i :: w) = (BerggrenMat' i).mulVec (BWordTriple' w) := by
      simp [Matrix.mulVec_mulVec, BWordTriple']; rfl
    exact h_eq ▸ berggren_preserves_qform i _ |> fun h =>
      (qform_zero_iff_pyth _).1 <| h.trans <| (qform_zero_iff_pyth _).2 ih

/-! ## Part 5: Reduction Theorems -/

/-- **Factor extraction from collision witness**. -/
theorem factor_of_collision_witness
    (n : ℕ) (hn : 1 < n) (v : Fin 3 → ℤ) (hv : CollisionSideCond n v) :
    ∃ d : ℕ, 1 < d ∧ d < n ∧ d ∣ n := by
  obtain ⟨_, hdvd, hne1, hne2⟩ := hv
  exact square_collision_yields_factor n hn (v 0) (v 1) hdvd hne1 hne2

/-- **Factor extraction from hypotenuse-gcd witness**. -/
theorem factor_of_hyp_gcd_witness
    (n : ℕ) (hn : 1 < n) (v : Fin 3 → ℤ) (hv : HypGcdSideCond n v) :
    ∃ d : ℕ, 1 < d ∧ d < n ∧ d ∣ n := by
  obtain ⟨hpyth, hsum, hndvd⟩ := hv
  exact factor_of_pythagorean_hyp_partial_dvd n hn v hpyth hsum hndvd

/-- **Reduction Theorem (collision)**: For any `n > 1`, there exists a side condition
    on Pythagorean triples such that any triple satisfying it yields a factor. -/
theorem factoring_reduction_collision (n : ℕ) (hn : 1 < n) :
    ∃ C : (Fin 3 → ℤ) → Prop,
      (∀ v, C v → ∃ d : ℕ, 1 < d ∧ d < n ∧ d ∣ n) :=
  ⟨CollisionSideCond n, fun v hv => factor_of_collision_witness n hn v hv⟩

/-- **Reduction Theorem (hypotenuse-gcd)**: For any `n > 1`, there exists a side condition
    on Pythagorean triples such that any triple satisfying it yields a factor. -/
theorem factoring_reduction_hyp_gcd (n : ℕ) (hn : 1 < n) :
    ∃ C : (Fin 3 → ℤ) → Prop,
      (∀ v, C v → ∃ d : ℕ, 1 < d ∧ d < n ∧ d ∣ n) :=
  ⟨HypGcdSideCond n, fun v hv => factor_of_hyp_gcd_witness n hn v hv⟩

/-- **Reduction Theorem (structured instance)**: For any `n > 1`, a `FactoringInstance`
    exists such that any short vector solution yields a factor. -/
theorem factoring_reduces_to_short_vector (n : ℕ) (hn : 1 < n) :
    ∃ I : FactoringInstance,
      I.n = n ∧
      (HasShortVectorSolution I → ∃ d : ℕ, 1 < d ∧ d < n ∧ d ∣ n) := by
  refine ⟨⟨n, 1, CollisionSideCond n⟩, rfl, ?_⟩
  rintro ⟨v, _, hv⟩
  exact factor_of_collision_witness n hn v hv