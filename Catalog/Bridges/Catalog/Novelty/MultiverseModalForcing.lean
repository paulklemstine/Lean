/-
# The Modal Logic of Forcing — Deepening the Multiverse Core

This file goes **deeper** than `MultiverseSetTheory.lean`: instead of only
recording *that* forcing renders atomic sentences independent, we build the
**modal logic** in which forcing statements live.  Following Hamkins–Löwe, we
read the possibility operator `◇p` as *"`p` is forceable"* and the necessity
operator `□p` as *"`p` holds in every forcing extension"*.

The development has two layers.

* **Abstract Kripke layer.**  For any accessibility relation `R` on a type of
  worlds we define the semantic operators `Box` and `Dia` and prove, purely from
  frame conditions, the modal principles
  - `dia_iff_not_box_not` (duality `◇p ↔ ¬□¬p`),
  - `box_K` (the distribution axiom `□(p→q) → □p → □q`),
  - `box_necess` (necessitation),
  - `box_T` (`□p → p`, from reflexivity),
  - `box_four` (`□p → □□p`, from transitivity),
  - `box_dot2` (`◇□p → □◇p`, from confluence/directedness — the **characteristic
    axiom of forcing**, giving `S4.2`),
  - `box_five` (`◇p → □◇p`, from the Euclidean property).

* **Concrete forcing frame.**  We instantiate the abstract layer with the
  accessibility relation generated by single atom *flips* (generic extensions),
  i.e. the reflexive–transitive closure `forcingRel` of `flipStep`.  Because a
  flip is its own inverse, `forcingRel` is an equivalence relation, so the
  forcing frame is reflexive, transitive, confluent **and** Euclidean: it
  validates `T`, `4`, `.2` and `5`.  We then reconnect to sentences, proving that
  from *every* world every atom is *possibly true and possibly false*
  (`forcing_poss_atom_true` / `forcing_poss_atom_false`), a modal restatement of
  the multiverse independence phenomenon, and instantiate it for the Continuum
  Hypothesis.

Everything is proved over `Mathlib` and is self-contained.
-/
import Mathlib

namespace MultiverseModalForcing

open Relation

/-! ## Abstract Kripke layer -/

section Kripke

variable {W : Type*}

/-- Necessity: `Box R P w` holds when `P` holds in every `R`-successor of `w`. -/
def Box (R : W → W → Prop) (P : W → Prop) (w : W) : Prop := ∀ v, R w v → P v

/-- Possibility: `Dia R P w` holds when `P` holds in some `R`-successor of `w`. -/
def Dia (R : W → W → Prop) (P : W → Prop) (w : W) : Prop := ∃ v, R w v ∧ P v

variable {R : W → W → Prop} {P Q : W → Prop} {w : W}

/-- **Duality** `◇p ↔ ¬□¬p`. -/
theorem dia_iff_not_box_not : Dia R P w ↔ ¬ Box R (fun v => ¬ P v) w := by
  constructor
  · rintro ⟨v, hv, hp⟩ hb; exact hb v hv hp
  · intro h; by_contra hc; exact h (fun v hv hp => hc ⟨v, hv, hp⟩)

/-- **Duality** `□p ↔ ¬◇¬p`. -/
theorem box_iff_not_dia_not : Box R P w ↔ ¬ Dia R (fun v => ¬ P v) w := by
  constructor
  · rintro hb ⟨v, hv, hnp⟩; exact hnp (hb v hv)
  · intro h v hv; by_contra hnp; exact h ⟨v, hv, hnp⟩

/-- Monotonicity of `□`. -/
theorem box_mono (h : ∀ v, P v → Q v) (hp : Box R P w) : Box R Q w :=
  fun v hv => h v (hp v hv)

/-- Monotonicity of `◇`. -/
theorem dia_mono (h : ∀ v, P v → Q v) (hp : Dia R P w) : Dia R Q w := by
  obtain ⟨v, hv, hpv⟩ := hp; exact ⟨v, hv, h v hpv⟩

/-- **Necessitation**: a universally true proposition is necessary. -/
theorem box_necess (h : ∀ v, P v) : Box R P w := fun v _ => h v

/-- **Axiom K**: `□(p → q) → □p → □q`. -/
theorem box_K (hpq : Box R (fun v => P v → Q v) w) (hp : Box R P w) : Box R Q w :=
  fun v hv => hpq v hv (hp v hv)

/-- `□` distributes over conjunction. -/
theorem box_and : Box R (fun v => P v ∧ Q v) w ↔ Box R P w ∧ Box R Q w := by
  constructor
  · intro h; exact ⟨fun v hv => (h v hv).1, fun v hv => (h v hv).2⟩
  · rintro ⟨hp, hq⟩ v hv; exact ⟨hp v hv, hq v hv⟩

/-- **Axiom T** (reflexive frames): `□p → p`. -/
theorem box_T (hr : Reflexive R) (hp : Box R P w) : P w := hp w (hr w)

/-- Dual of `T` (reflexive frames): `p → ◇p`. -/
theorem dia_intro (hr : Reflexive R) (hp : P w) : Dia R P w := ⟨w, hr w, hp⟩

/-- **Axiom 4** (transitive frames): `□p → □□p`. -/
theorem box_four (ht : Transitive R) (hp : Box R P w) : Box R (Box R P) w :=
  fun _v hwv u hvu => hp u (ht hwv hvu)

/-- Dual of `4` (transitive frames): `◇◇p → ◇p`. -/
theorem dia_four (ht : Transitive R) (hp : Dia R (Dia R P) w) : Dia R P w := by
  obtain ⟨v, hwv, u, hvu, hpu⟩ := hp; exact ⟨u, ht hwv hvu, hpu⟩

/-- A relation is **confluent** (directed) when any two successors of a point have
    a common successor.  For forcing: any two extensions have a common further
    extension. -/
def Confluent (R : W → W → Prop) : Prop :=
  ∀ x y z, R x y → R x z → ∃ u, R y u ∧ R z u

/-- A relation is **Euclidean** when successors of a point are related. -/
def EuclideanRel (R : W → W → Prop) : Prop :=
  ∀ x y z, R x y → R x z → R y z

/-- **Axiom .2** (confluent frames): `◇□p → □◇p`.  This is the modal principle
    that distinguishes the logic of forcing (`S4.2`). -/
theorem box_dot2 (hc : Confluent R) (hp : Dia R (Box R P) w) : Box R (Dia R P) w := by
  obtain ⟨v, hwv, hbox⟩ := hp
  intro u hwu
  obtain ⟨t, hvt, hut⟩ := hc w v u hwv hwu
  exact ⟨t, hut, hbox t hvt⟩

/-- **Axiom 5** (Euclidean frames): `◇p → □◇p`. -/
theorem box_five (he : EuclideanRel R) (hp : Dia R P w) : Box R (Dia R P) w := by
  obtain ⟨v, hwv, hpv⟩ := hp
  intro u hwu
  exact ⟨v, he w u v hwu hwv, hpv⟩

end Kripke

/-! ## The concrete forcing frame -/

section Forcing

variable {α : Type*} [DecidableEq α]

/-- A `World` is a truth assignment to atomic set-theoretic assertions. -/
abbrev World (α : Type*) := α → Bool

/-- The generic extension of `w` along atom `a`: flip the truth value of `a`. -/
def flip (w : World α) (a : α) : World α :=
  fun x => if x = a then !(w x) else w x

@[simp] theorem flip_self (w : World α) (a : α) : flip w a a = !(w a) := by
  simp [flip]

theorem flip_other (w : World α) {a x : α} (h : x ≠ a) : flip w a x = w x := by
  simp [flip, h]

/-- Flipping the same atom twice returns the original world. -/
@[simp] theorem flip_flip (w : World α) (a : α) : flip (flip w a) a = w := by
  funext x; by_cases h : x = a <;> simp [flip, h]

/-- A single **forcing step**: `v` is a generic extension of `w` along some atom. -/
def flipStep (w v : World α) : Prop := ∃ a, v = flip w a

/-- `flipStep` is symmetric: forcing a single atom is its own inverse. -/
theorem flipStep_symm : Symmetric (flipStep (α := α)) := by
  rintro x y ⟨a, rfl⟩; exact ⟨a, (flip_flip x a).symm⟩

/-- The **forcing accessibility relation**: reachability by finitely many generic
    extensions.  This is the reflexive–transitive closure of `flipStep`. -/
def forcingRel : World α → World α → Prop := ReflTransGen flipStep

theorem forcingRel_refl : Reflexive (forcingRel (α := α)) := by
  intro w; exact ReflTransGen.refl

theorem forcingRel_trans : Transitive (forcingRel (α := α)) := by
  intro a b c h1 h2; exact h1.trans h2

theorem forcingRel_symm : Symmetric (forcingRel (α := α)) :=
  ReflTransGen.symmetric flipStep_symm

/-- The forcing frame is **confluent**: any two extensions of a world share a
    common further extension.  (Here even more: the relation is an equivalence.) -/
theorem forcingRel_confluent : Confluent (forcingRel (α := α)) := by
  intro x y z hxy hxz
  exact ⟨z, forcingRel_trans (forcingRel_symm hxy) hxz, forcingRel_refl z⟩

/-- The forcing frame is **Euclidean**. -/
theorem forcingRel_euclidean : EuclideanRel (forcingRel (α := α)) := by
  intro x y z hxy hxz
  exact forcingRel_trans (forcingRel_symm hxy) hxz

/-- A single flip is a forcing step, hence gives accessibility. -/
theorem forcingRel_flip (w : World α) (a : α) : forcingRel w (flip w a) :=
  ReflTransGen.single ⟨a, rfl⟩

/-! ### Forcing validates the modal axioms

We now specialise the abstract theorems to the concrete forcing frame. -/

/-- Forcing validates **T** (`□p → p`). -/
theorem forcing_T {P : World α → Prop} {w : World α} (hp : Box forcingRel P w) : P w :=
  box_T forcingRel_refl hp

/-- Forcing validates **4** (`□p → □□p`). -/
theorem forcing_four {P : World α → Prop} {w : World α} (hp : Box forcingRel P w) :
    Box forcingRel (Box forcingRel P) w :=
  box_four forcingRel_trans hp

/-- Forcing validates **.2** (`◇□p → □◇p`), the characteristic axiom. -/
theorem forcing_dot2 {P : World α → Prop} {w : World α}
    (hp : Dia forcingRel (Box forcingRel P) w) : Box forcingRel (Dia forcingRel P) w :=
  box_dot2 forcingRel_confluent hp

/-- Forcing validates **5** (`◇p → □◇p`). -/
theorem forcing_five {P : World α → Prop} {w : World α} (hp : Dia forcingRel P w) :
    Box forcingRel (Dia forcingRel P) w :=
  box_five forcingRel_euclidean hp

/-! ### Forcing independence, modally

From every world, every atom is *possibly true* and *possibly false*: forcing
never settles an atom.  This is the modal heart of the multiverse. -/

/-- From any world, atom `a` can be forced **true**: `◇(a = true)`. -/
theorem forcing_poss_atom_true (w : World α) (a : α) :
    Dia forcingRel (fun v => v a = true) w := by
  by_cases h : w a = true
  · exact ⟨w, forcingRel_refl w, h⟩
  · refine ⟨flip w a, forcingRel_flip w a, ?_⟩
    have hw : w a = false := by simpa using h
    simp [flip_self, hw]

/-- From any world, atom `a` can be forced **false**: `◇(a = false)`. -/
theorem forcing_poss_atom_false (w : World α) (a : α) :
    Dia forcingRel (fun v => v a = false) w := by
  by_cases h : w a = false
  · exact ⟨w, forcingRel_refl w, h⟩
  · refine ⟨flip w a, forcingRel_flip w a, ?_⟩
    have hw : w a = true := by simpa using h
    simp [flip_self, hw]

/-- **No atom is necessary**: `¬□(a = true)`, from any world. -/
theorem forcing_atom_not_nec (w : World α) (a : α) :
    ¬ Box forcingRel (fun v => v a = true) w := by
  intro hb
  obtain ⟨v, hv, hfalse⟩ := forcing_poss_atom_false w a
  rw [hb v hv] at hfalse
  exact Bool.noConfusion hfalse

/-- **Every atom is contingent**: possibly true and possibly false at once. -/
theorem forcing_atom_contingent (w : World α) (a : α) :
    Dia forcingRel (fun v => v a = true) w ∧ Dia forcingRel (fun v => v a = false) w :=
  ⟨forcing_poss_atom_true w a, forcing_poss_atom_false w a⟩

/-- Since `◇(a = true)` holds from every world, it is even **necessarily possible**
    (`□◇(a = true)`): a direct consequence of the `.2`/`5` layer. -/
theorem forcing_nec_poss_atom_true (w : World α) (a : α) :
    Box forcingRel (fun v => Dia forcingRel (fun u => u a = true) v) w :=
  fun v _ => forcing_poss_atom_true v a

end Forcing

/-! ## Concrete instance: the Continuum Hypothesis -/

/-- Three atomic set-theoretic assertions. -/
inductive Claim
  | CH      -- the Continuum Hypothesis
  | VeqL    -- the axiom of constructibility `V = L`
  | Meas    -- "there exists a measurable cardinal"
  deriving DecidableEq, Fintype

open Claim

/-- Gödel's constructible universe `L`. -/
def godel : World Claim
  | CH => true
  | VeqL => true
  | Meas => false

/-- **CH is possibly true and possibly false from Gödel's `L`**: the modal form of
    its independence.  Both are instances of `forcing_atom_contingent`. -/
theorem CH_contingent_from_godel :
    Dia forcingRel (fun v => v CH = true) godel ∧
      Dia forcingRel (fun v => v CH = false) godel :=
  forcing_atom_contingent godel CH

/-- **CH is necessarily possible** from Gödel's `L`: `□◇CH`. -/
theorem CH_nec_poss_from_godel :
    Box forcingRel (fun v => Dia forcingRel (fun u => u CH = true) v) godel :=
  forcing_nec_poss_atom_true godel CH

end MultiverseModalForcing