import Mathlib
import Catalog.Bridges.HilbertSpaceBridge

/-!
# Structural bounds for quantum Latin squares of order six

A quantum Latin square is an array of vectors whose rows and columns are
orthonormal bases.  Its cardinality counts one-dimensional rays rather than
chosen vector representatives.  This chapter isolates two mechanisms behind
order-six constructions: the ceiling of twenty-one rays for arrays generated by
a commutative pair operation, and additivity of cardinality for constructions
whose rays lie in disjoint direct summands.

-- !-- Lab Notes -- !--
Hypothesis (Hypothesizer): (1) every commutative two-input construction on six
labels factors through the twenty-one unordered pairs; (2) ray sets supported in
disjoint summands have additive cardinality; (3) orthonormality forces every row
and column to contain six inequivalent rays.  Bold extensions considered were a
classification of all equality cases, rigidity of the unique triple collision
at cardinality nineteen, and a general direct-sum realization theorem.

Experiment (Experimenter): Ordered pairs were reduced to the upper triangle by
swapping coordinates, giving 21 representatives among 36 inputs.  For a disjoint
union of two finite ray-label sets, direct image calculations gave exactly the
sum of their separate cardinalities.  The ray relation was tested against the
inner product: two proportional unit vectors cannot be orthogonal.

Analysis (Analyst): The number 21 is combinatorial rather than analytic: it is
the triangular number `6·7/2`.  Thus any symmetric Schur-product construction is
blocked at 21 independently of the phases in the Hadamard matrix.  Cardinality
23 necessarily uses a mechanism not factoring through unordered pairs.  Direct
sums evade the ceiling because their two ray populations are disjoint by type.

Critique (Critic): These results do not certify the paper's explicit numerical
matrices, whose entries are not reproduced in the supplied statement.  They do
certify the structural upper bound, the direct-sum count `19+4=23`, and basic
nondegeneracy constraints.  No result assumes that a displayed cardinality is
already attained, and zero vectors are excluded where ray arguments require it.

Synthesis (Principal Investigator): The commutative-pair theorem and the
direct-sum theorem form a sharp conceptual dichotomy: 21 is an absolute ceiling
for symmetric pair generation, while disjoint support makes cardinalities add.
The orthonormal-ray theorem anchors both mechanisms in Hilbert-space geometry.
-- !-- Lab Notes -- !--
-/

namespace QuantumLatinSquaresOrderSix

open scoped ComplexConjugate
open Function

/-- Two vectors determine the same ray when one is a nonzero scalar multiple of
 the other. -/
def RayEq {E : Type*} [SMul ℂ E] (v w : E) : Prop :=
  ∃ c : ℂ, c ≠ 0 ∧ w = c • v

lemma rayEq_refl {E : Type*} [AddCommMonoid E] [Module ℂ E] (v : E) : RayEq v v := by
  exact ⟨1, one_ne_zero, by simp⟩

lemma rayEq_symm {E : Type*} [AddCommMonoid E] [Module ℂ E] {v w : E}
    (h : RayEq v w) : RayEq w v := by
  obtain ⟨c, hc, rfl⟩ := h
  exact ⟨c⁻¹, inv_ne_zero hc, by simp [hc]⟩

lemma rayEq_trans {E : Type*} [AddCommMonoid E] [Module ℂ E] {u v w : E}
    (huv : RayEq u v) (hvw : RayEq v w) : RayEq u w := by
  obtain ⟨c, hc, rfl⟩ := huv
  obtain ⟨d, hd, rfl⟩ := hvw
  use d * c
  simp [mul_comm, hc, hd]
  rw [smul_smul, mul_comm]

/-- The upper triangle indexes unordered pairs in a linearly ordered type. -/
def upperPairs (α : Type*) [Fintype α] [LinearOrder α] : Finset (α × α) :=
  Finset.univ.filter fun p => p.1 ≤ p.2

/-
A commutative pair construction has the same image on all ordered pairs as
on upper-triangular representatives.
-/
theorem image_eq_image_upperPairs {α β : Type*} [Fintype α] [LinearOrder α]
    [DecidableEq β] (f : α → α → β) (hcomm : ∀ i j, f i j = f j i) :
    Finset.univ.image (fun p : α × α => f p.1 p.2) =
      (upperPairs α).image (fun p : α × α => f p.1 p.2) := by
  ext x
  simp [upperPairs]
  grind

lemma card_upperPairs_fin_six : (upperPairs (Fin 6)).card = 21 := by
  native_decide

/-
**Symmetric Schur-product ceiling.** Any commutative pair construction from
six labels produces at most twenty-one distinct outputs.
-/
theorem commutative_pair_cardinality_le_twenty_one {β : Type*} [DecidableEq β]
    (f : Fin 6 → Fin 6 → β) (hcomm : ∀ i j, f i j = f j i) :
    (Finset.univ.image (fun p : Fin 6 × Fin 6 => f p.1 p.2)).card ≤ 21 := by
  rw [image_eq_image_upperPairs f hcomm]
  exact Finset.card_image_le.trans (le_of_eq card_upperPairs_fin_six)

/-
If the two image populations are disjoint, tagging the source by a direct
sum makes their cardinalities add exactly.
-/
theorem directSum_image_cardinality {α β ρ : Type*}
    [Fintype α] [Fintype β] [DecidableEq ρ]
    (f : α → ρ) (g : β → ρ)
    (hdisj : Disjoint (Finset.univ.image f) (Finset.univ.image g)) :
    (Finset.univ.image (Sum.elim f g)).card =
      (Finset.univ.image f).card + (Finset.univ.image g).card := by
  rw [← Finset.card_union_of_disjoint hdisj,
    show (Finset.image (Sum.elim f g) Finset.univ : Finset ρ) =
      Finset.image f Finset.univ ∪ Finset.image g Finset.univ from ?_]
  ext x
  simp [Sum.elim]

/-
The numerical direct-sum count used by the order-six construction.
-/
theorem nineteen_plus_four_is_twenty_three
    {α β ρ : Type*} [Fintype α] [Fintype β] [DecidableEq ρ]
    (f : α → ρ) (g : β → ρ)
    (hf : (Finset.univ.image f).card = 19)
    (hg : (Finset.univ.image g).card = 4)
    (hdisj : Disjoint (Finset.univ.image f) (Finset.univ.image g)) :
    (Finset.univ.image (Sum.elim f g)).card = 23 := by
  rw [directSum_image_cardinality f g hdisj, hf, hg]

/-- An order-`n` quantum Latin square: each row and each column is an
orthonormal family in `ℂⁿ`. -/
structure QuantumLatinSquare (n : ℕ) where
  entry : Fin n → Fin n → EuclideanSpace ℂ (Fin n)
  row_orthonormal : ∀ i, Orthonormal ℂ (entry i)
  column_orthonormal : ∀ j, Orthonormal ℂ (fun i => entry i j)

/-
Distinct entries in one row of a quantum Latin square determine distinct
rays.  This is the geometric nondegeneracy behind cardinality counting.
-/
theorem row_ray_inequivalent {n : ℕ} (Q : QuantumLatinSquare n)
    (i j k : Fin n) (hjk : j ≠ k) :
    ¬ RayEq (Q.entry i j) (Q.entry i k) := by
  intro ⟨c, hc⟩
  have hrow := Q.row_orthonormal i
  simp_all +decide [Orthonormal]
  have horth := hrow.2 hjk
  simp_all +decide [inner_smul_right]

/-
The analogous ray separation holds down every column.
-/
theorem column_ray_inequivalent {n : ℕ} (Q : QuantumLatinSquare n)
    (i k j : Fin n) (hik : i ≠ k) :
    ¬ RayEq (Q.entry i j) (Q.entry k j) := by
  intro h
  obtain ⟨c, hc⟩ := h
  have h_orthogonal : inner ℂ (Q.entry i j) (Q.entry k j) = 0 := by
    exact Q.column_orthonormal j |> fun h => h.2 hik
  by_cases h : Q.entry i j = 0 <;> simp_all +decide
  have := Q.column_orthonormal j
  simp_all +decide [orthonormal_iff_ite]
  simpa [ h ] using this i i

/-
Every entry of a quantum Latin square is nonzero.
-/
theorem entry_ne_zero {n : ℕ} (Q : QuantumLatinSquare n) (i j : Fin n) :
    Q.entry i j ≠ 0 := by
  intro hzero
  have hnorm := HilbertSpaceBridge.orthonormal_unit_norm
    (Q.row_orthonormal i) j
  rw [hzero, norm_zero] at hnorm
  norm_num at hnorm

end QuantumLatinSquaresOrderSix