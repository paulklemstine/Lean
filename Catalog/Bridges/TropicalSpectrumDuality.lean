import Mathlib

open Set Function TopologicalSpace Topology

/-! ## Section 1: Kernel Congruences and Evaluation Spectrum -/

/-- The congruence (equivalence relation) induced by a function `φ : A → ℝ`:
    two elements are equivalent iff they have the same image under `φ`. -/
def kerCongr (A : Type*) (φ : A → ℝ) : Setoid A where
  r a b := φ a = φ b
  iseqv := {
    refl := fun _ => rfl
    symm := fun h => h.symm
    trans := fun h₁ h₂ => h₁.trans h₂
  }

/-- The evaluation congruence at a point `x`: two functions are equivalent
    iff they agree at `x`. This is the kernel of the evaluation homomorphism
    `evₓ : A → ℝ` sending `f ↦ eval x f`. -/
def evalCongr (A : Type*) {X : Type*} (eval : X → A → ℝ) (x : X) : Setoid A :=
  kerCongr A (eval x)

/-- Two elements are equivalent under `kerCongr` iff they have equal images. -/
theorem kerCongr_eq_iff (A : Type*) (φ : A → ℝ) (f g : A) :
    (kerCongr A φ).r f g ↔ φ f = φ g := Iff.rfl

/-- Two elements are equivalent under `evalCongr` iff they agree at the point. -/
theorem evalCongr_eq_iff (A : Type*) {X : Type*} (eval : X → A → ℝ)
    (x : X) (f g : A) :
    (evalCongr A eval x).r f g ↔ eval x f = eval x g := Iff.rfl

/-! ## Section 2: The Tropical Evaluation Spectrum

We define the tropical evaluation spectrum as the set of congruences that arise
as evaluation kernels. In the concrete setting, this is naturally indexed by `X` itself.
The spectrum carries a topology generated by "tropical vanishing loci" — sets of
congruences under which given pairs of functions become equivalent. -/

/-- The tropical evaluation spectrum: the range of the evaluation-congruence map.
    Each element is a `Setoid A` together with a proof that it arises as `evalCongr x`
    for some point `x : X`. -/
def TropEvalSpec (A : Type*) {X : Type*} (eval : X → A → ℝ) :=
  Set.range (evalCongr A eval)

/-- The evaluation-to-spectrum map, sending `x` to its evaluation congruence
    viewed as an element of the range. -/
noncomputable def evalToSpec (A : Type*) {X : Type*} (eval : X → A → ℝ) (x : X) :
    TropEvalSpec A eval :=
  ⟨evalCongr A eval x, mem_range_self x⟩

/-- Tropical vanishing locus of a pair `(f, g)`: the set of evaluation congruences
    under which `f` and `g` are equivalent (i.e., the spectrum points where `f = g`). -/
def tropVanishPair (A : Type*) {X : Type*} (eval : X → A → ℝ) (f g : A) :
    Set (TropEvalSpec A eval) :=
  {C | C.val.r f g}

/-! ## Section 3: Injectivity — Evaluation Kernels Separate Points

We use *kernel separation*: the algebra kernel-separates points of `X` if for
any distinct x, y there exist algebra elements f, g with f(x) = g(x) but f(y) ≠ g(y).
This is strictly stronger than value separation and is the correct condition for
injectivity of the congruence map. For algebras containing constants (like C(X, ℝ)),
value separation implies kernel separation. -/

/-
If the algebra kernel-separates points of `X` (for any two distinct points, there
    exist elements that agree at one but disagree at the other), then the
    evaluation-to-congruence map is injective.
-/
theorem evalCongr_injective {A : Type*} {X : Type*} (eval : X → A → ℝ)
    (hksep : ∀ x y : X, x ≠ y → ∃ f g : A, eval x f = eval x g ∧ eval y f ≠ eval y g) :
    Injective (evalCongr A eval) := by
  intro x y hxy;
  contrapose! hksep;
  exact ⟨ x, y, hksep, fun f g hfg => by have := congr_arg ( fun s => s.r f g ) hxy; tauto ⟩

/-
The evaluation-to-spectrum map is injective when the algebra kernel-separates points.
-/
theorem evalToSpec_injective {A : Type*} {X : Type*} (eval : X → A → ℝ)
    (hksep : ∀ x y : X, x ≠ y → ∃ f g : A, eval x f = eval x g ∧ eval y f ≠ eval y g) :
    Injective (evalToSpec A eval) := by
  -- Assume that evalToSpec x = evalToSpec y.
  intro x y hxy
  have h_cong : evalCongr A eval x = evalCongr A eval y := by
    injection hxy
  generalize_proofs at *; (
  exact Classical.not_not.1 fun h => by obtain ⟨ f, g, hf, hg ⟩ := hksep x y h; have := congr_arg ( fun s => s.r f g ) h_cong; simp +decide [ hf, hg ] at this;)

/-
Value separation plus constants implies kernel separation. This provides the
    bridge from the classical separation axiom to our kernel separation condition.
-/
theorem kernel_sep_of_value_sep_and_constants {A : Type*} {X : Type*} (eval : X → A → ℝ)
    (hsep : ∀ x y : X, x ≠ y → ∃ f : A, eval x f ≠ eval y f)
    (hconst : ∀ c : ℝ, ∃ a : A, ∀ x : X, eval x a = c) :
    ∀ x y : X, x ≠ y → ∃ f g : A, eval x f = eval x g ∧ eval y f ≠ eval y g := by
  -- Start with the given x ≠ y. Use hsep to get a function f that separates x and y (eval x f ≠ eval y f).
  intros x y hxy
  obtain ⟨f, hf⟩ : ∃ f, eval x f ≠ eval y f := by
    exact hsep x y hxy
  use f
  use Classical.choose (hconst (eval x f));
  exact ⟨ Eq.symm ( Classical.choose_spec ( hconst ( eval x f ) ) x ), by rw [ Classical.choose_spec ( hconst ( eval x f ) ) y ] ; tauto ⟩

/-! ## Section 4: Preimage Formula and Closedness -/

/-- The preimage of a tropical vanishing locus under the evaluation map
    is exactly the equalizer set `{x | eval x f = eval x g}`.
    This is the bridge between spectral topology and point-set topology. -/
theorem preimage_tropVanishPair {A : Type*} {X : Type*} (eval : X → A → ℝ)
    (f g : A) :
    (evalToSpec A eval) ⁻¹' (tropVanishPair A eval f g) =
      {x : X | eval x f = eval x g} := by
  ext x; simp [evalToSpec, tropVanishPair]

/-- Equalizer sets of continuous evaluation maps are closed.
    This follows from continuity of the evaluation maps and the Hausdorff property of `ℝ`. -/
theorem isClosed_equalizer {A : Type*} {X : Type*} [TopologicalSpace X]
    (eval : X → A → ℝ) (f g : A)
    (hf : Continuous (fun x => eval x f))
    (hg : Continuous (fun x => eval x g)) :
    IsClosed {x : X | eval x f = eval x g} := by
  exact isClosed_eq hf hg

/-! ## Section 5: Topology on the Spectrum and Continuity

We endow the evaluation spectrum with the quotient topology induced by the
evaluation-to-spectrum map. Under this topology, the map is continuous by definition,
and the closed sets are precisely the tropical vanishing loci. -/

/-- The evaluation spectrum with the coinduced (quotient) topology from the evaluation map. -/
noncomputable def tropEvalSpecTopology (A : Type*) {X : Type*}
    [TopologicalSpace X] (eval : X → A → ℝ) :
    TopologicalSpace (TropEvalSpec A eval) :=
  TopologicalSpace.coinduced (evalToSpec A eval) ‹_›

/-
The evaluation-to-spectrum map is continuous with respect to the coinduced topology
    (by definition of the coinduced topology).
-/
theorem continuous_evalToSpec {A : Type*} {X : Type*} [TopologicalSpace X]
    (eval : X → A → ℝ) :
    @Continuous X (TropEvalSpec A eval) _ (tropEvalSpecTopology A eval)
      (evalToSpec A eval) := by
  rw [ continuous_iff_coinduced_le ];
  rfl

/-! ## Section 6: Surjectivity -/

/-
The evaluation-to-spectrum map is surjective by construction.
-/
theorem evalToSpec_surjective {A : Type*} {X : Type*} (eval : X → A → ℝ) :
    Surjective (evalToSpec A eval) := by
  intro ⟨ s, hs ⟩;
  cases hs ; aesop

/-
The evaluation-to-spectrum map is bijective when the algebra kernel-separates points.
-/
theorem evalToSpec_bijective {A : Type*} {X : Type*} (eval : X → A → ℝ)
    (hksep : ∀ x y : X, x ≠ y → ∃ f g : A, eval x f = eval x g ∧ eval y f ≠ eval y g) :
    Bijective (evalToSpec A eval) := by
  exact ⟨ evalToSpec_injective eval hksep, evalToSpec_surjective eval ⟩

/-! ## Section 7: Main Homeomorphism Theorem

The central result: when the algebra kernel-separates points, `X` is homeomorphic to
its tropical evaluation spectrum. This is the tropical analog of the
Gelfand–Kolmogorov theorem.

The proof strategy uses the compact-to-Hausdorff criterion: a continuous bijection
from a compact space to a T₂ space is automatically a homeomorphism.

We first show the coinduced topology on the spectrum is T₂ (it inherits this from X
via the continuous bijection), then apply `Continuous.homeoOfEquivCompactToT2`. -/

/-
The evaluation spectrum (with coinduced topology) is T₂ when `X` is compact T₂
    and the algebra kernel-separates points.
-/
theorem tropEvalSpec_t2 {A : Type*} {X : Type*}
    [TopologicalSpace X] [CompactSpace X] [T2Space X]
    (eval : X → A → ℝ)
    (hksep : ∀ x y : X, x ≠ y → ∃ f g : A, eval x f = eval x g ∧ eval y f ≠ eval y g) :
    @T2Space (TropEvalSpec A eval) (tropEvalSpecTopology A eval) := by
  have := evalToSpec_bijective eval hksep;
  rw [ @t2Space_iff ];
  intro x y hxy;
  obtain ⟨ x', hx' ⟩ := this.2 x; obtain ⟨ y', hy' ⟩ := this.2 y; simp_all +decide [ Set.disjoint_left ] ;
  -- Since $x' \neq y'$, there exist disjoint open sets $U$ and $V$ in $X$ such that $x' \in U$ and $y' \in V$.
  obtain ⟨U, V, hU, hV, hUV⟩ : ∃ U V : Set X, IsOpen U ∧ IsOpen V ∧ x' ∈ U ∧ y' ∈ V ∧ Disjoint U V := by
    exact t2_separation ( show x' ≠ y' from fun h => hxy <| hx'.symm ▸ hy'.symm ▸ h ▸ rfl );
  refine' ⟨ ( evalToSpec A eval ) '' U, _, ( evalToSpec A eval ) '' V, _, _, _, _ ⟩ <;> simp_all +decide [ Set.disjoint_left ];
  · rw [ isOpen_coinduced ];
    rwa [ Set.preimage_image_eq _ this.injective ];
  · rw [ isOpen_coinduced ];
    rwa [ Set.preimage_image_eq _ this.injective ];
  · exact ⟨ x', hUV.1, hx' ⟩;
  · exact ⟨ y', hUV.2.1, hy' ⟩;
  · intro a ha x hx hx' y hy hy'; have := this.1 ( hx'.trans hy'.symm ) ; aesop;

/-- The equivalence between X and the evaluation spectrum, given kernel separation. -/
noncomputable def evalToSpecEquiv {A : Type*} {X : Type*} (eval : X → A → ℝ)
    (hksep : ∀ x y : X, x ≠ y → ∃ f g : A, eval x f = eval x g ∧ eval y f ≠ eval y g) :
    X ≃ TropEvalSpec A eval :=
  Equiv.ofBijective (evalToSpec A eval) (evalToSpec_bijective eval hksep)

/-
**Main Theorem: Tropical Spectrum Duality.**
    For a compact Hausdorff space `X` and an algebra that kernel-separates points,
    the evaluation-to-spectrum map is a homeomorphism from `X` to the tropical evaluation
    spectrum. This establishes that the space can be reconstructed from the algebraic data
    of evaluation congruences, providing the geometric foundation for tropical spectral theory.
-/
noncomputable def evaluation_homeomorph_tropMaxSpec {A : Type*} {X : Type*}
    [TopologicalSpace X] [CompactSpace X] [T2Space X]
    (eval : X → A → ℝ)
    (hksep : ∀ x y : X, x ≠ y → ∃ f g : A, eval x f = eval x g ∧ eval y f ≠ eval y g) :
    @Homeomorph X (TropEvalSpec A eval) _ (tropEvalSpecTopology A eval) :=
  letI : TopologicalSpace (TropEvalSpec A eval) := tropEvalSpecTopology A eval
  haveI : T2Space (TropEvalSpec A eval) := tropEvalSpec_t2 eval hksep
  (continuous_evalToSpec eval).homeoOfEquivCompactToT2 (f := evalToSpecEquiv eval hksep)

/-! ## Section 8: Concrete Instance — Continuous Functions on a Compact Space

We verify the theorem applies to the standard algebra of all continuous real-valued
functions on a compact Hausdorff space. -/

/-- The standard evaluation map for continuous functions. -/
def ContinuousMap.tropEval (X : Type*) [TopologicalSpace X] :
    X → C(X, ℝ) → ℝ := fun x f => f x

/-
Continuous functions kernel-separate points of a normal T₂ space.
    By Urysohn's lemma, for x ≠ y there exists f with f(x) = 0, f(y) = 1.
    Taking g = 0 (constant), we get eval x f = 0 = eval x g but eval y f = 1 ≠ 0 = eval y g.
-/
theorem ContinuousMap.kernel_separates_points {X : Type*} [TopologicalSpace X]
    [T2Space X] [NormalSpace X] :
    ∀ x y : X, x ≠ y →
      ∃ f g : C(X, ℝ), ContinuousMap.tropEval X x f = ContinuousMap.tropEval X x g ∧
        ContinuousMap.tropEval X y f ≠ ContinuousMap.tropEval X y g := by
  intro x y hxy
  obtain ⟨f, hf⟩ : ∃ f : C(X, ℝ), f x = 0 ∧ f y = 1 := by
    have := exists_continuous_zero_one_of_isClosed ( show IsClosed { x } from isClosed_singleton ) ( show IsClosed { y } from isClosed_singleton ) ( by simpa );
    exact ⟨ this.choose, this.choose_spec.1 ( Set.mem_singleton x ), this.choose_spec.2.1 ( Set.mem_singleton y ) ⟩;
  exact ⟨ f, 0, by simp +decide [ hf, tropEval ], by simp +decide [ hf, tropEval ] ⟩

/-
Each component of the standard evaluation map is continuous.
-/
theorem ContinuousMap.tropEval_continuous {X : Type*} [TopologicalSpace X]
    (f : C(X, ℝ)) :
    Continuous (fun x => ContinuousMap.tropEval X x f) := by
  exact f.continuous

/-- **Corollary: Tropical Spectrum Duality for C(X, ℝ).**
    Every compact Hausdorff normal space is homeomorphic to the tropical evaluation
    spectrum of its algebra of continuous real-valued functions. -/
noncomputable def tropicalDuality_CX {X : Type*}
    [TopologicalSpace X] [CompactSpace X] [T2Space X] [NormalSpace X] :
    @Homeomorph X (TropEvalSpec C(X, ℝ) (ContinuousMap.tropEval X)) _
      (tropEvalSpecTopology C(X, ℝ) (ContinuousMap.tropEval X)) :=
  evaluation_homeomorph_tropMaxSpec (ContinuousMap.tropEval X)
    ContinuousMap.kernel_separates_points

/-! ## Section 9: Extended Spectral Structure -/

/-- The tropical vanishing locus respects intersection:
    `V(f₁,g₁) ∩ V(f₂,g₂)` corresponds to simultaneous equality. -/
theorem tropVanishPair_inter {A : Type*} {X : Type*} (eval : X → A → ℝ)
    (f₁ g₁ f₂ g₂ : A) :
    tropVanishPair A eval f₁ g₁ ∩ tropVanishPair A eval f₂ g₂ =
      {C | C.val.r f₁ g₁ ∧ C.val.r f₂ g₂} := by
  ext C; simp [tropVanishPair, Set.mem_inter_iff]

/-- The whole spectrum is the vanishing locus of any element with itself. -/
theorem tropVanishPair_self {A : Type*} {X : Type*} (eval : X → A → ℝ)
    (f : A) :
    tropVanishPair A eval f f = Set.univ := by
  ext C; simp [tropVanishPair]; exact C.val.iseqv.refl f

/-
The evaluation-to-spectrum map reflects the separation property:
    distinct spectrum points correspond to functions that one congruence identifies
    but the other does not.
-/
theorem tropMaxSpec_separation {A : Type*} {X : Type*} (eval : X → A → ℝ)
    (C₁ C₂ : TropEvalSpec A eval) (hne : C₁ ≠ C₂) :
    ∃ f g : A, (C₁.val.r f g ∧ ¬C₂.val.r f g) ∨ (C₂.val.r f g ∧ ¬C₁.val.r f g) := by
  contrapose! hne;
  exact Subtype.ext ( Setoid.ext_iff.2 fun a b => by specialize hne a b; tauto )