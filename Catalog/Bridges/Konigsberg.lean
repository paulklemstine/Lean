--+--+-++++theorem konigsberg_no_eulerian_trail : IsEmpty (EulerianTrail konigsberg) := by
--+--+-++++  constructor
--+--+-++++  intro t
--+--+-++++  have h1 := t.odd_degree_vertices_le_two
--+--+-++++  have h2 := konigsberg_odd_count
