+--+--+-----    Fintype.card { w : V | Odd (G.degree w) } = 0 ∨
+--+--+-----    Fintype.card { w : V | Odd (G.degree w) } = 2 :=
+--+--+-----  hp.card_odd_degree
+--+--+----+/-- **Königsberg Bridge Theorem**: There is no Eulerian trail in the Königsberg graph.
