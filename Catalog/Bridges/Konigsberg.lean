+----++----------/-- The four landmasses of Königsberg. -/
+----++----------inductive Konigsberg : Type
+----++----------  | A  -- North bank
+----++----------  | B  -- South bank
+----++----------  | C  -- Island (Kneiphof)
+----++----------  | D  -- East district
+----++----------  deriving DecidableEq, Fintype
+----++---------+/-- The degree of vertex 2 (southern bank) is 3. -/
+----++---------+theorem konigsberg_degree_2 : konigsberg.degree 2 = 3 := by native_decide
