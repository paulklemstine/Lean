-+-------+----+-+  intro v; fin_cases v <;> native_decide
-+-------+----+-+
-+-------+----+-+/-- The number of odd-degree vertices in the Königsberg graph is 4. -/
-+-------+----+-+theorem konigsberg_odd_count :
-+-------+----+-+    (Finset.univ.filter (fun v : Fin 4 => konigsberg.degree v % 2 = 1)).card = 4 := by
