--+-------+---+---every pair of landmasses had at least one bridge between them. -/
--+-------+---+---def konigsbergGraph : SimpleGraph Konigsberg := ⊤
--+-------+---+---
--+-------+---+---instance : DecidableRel konigsbergGraph.Adj := by
--+-------+---+---  intro u v
