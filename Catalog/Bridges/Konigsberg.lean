+---+----------  intro v
+---+----------  rw [konigsberg_degree]
+---+----------  exact ⟨1, rfl⟩
+---+---------+theorem konigsberg_all_odd : ∀ v : Fin 4, konigsberg.degree v % 2 = 1 := by
+---+---------+  intro v; fin_cases v <;> native_decide
