+----++----------theorem konigsberg_degree (v : Konigsberg) : konigsbergGraph.degree v = 3 := by
+----++----------  fin_cases v <;> simp +decide
+----++---------+/-- The degree of vertex 3 (Lomse island) is 3. -/
+----++---------+theorem konigsberg_degree_3 : konigsberg.degree 3 = 3 := by native_decide
