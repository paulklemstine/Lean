+---++++---/-! ### The Königsberg graph
+---++ +--+/-- The Königsberg bridge graph: 4 vertices, 7 edges. -/
+---++ +--+def konigsberg : Multigraph 4 7 where
+---++ +--+  endpt₁ := ![0, 0, 0, 0, 0, 1, 2]
+---++ +--+  endpt₂ := ![1, 1, 2, 2, 3, 3, 3]
+--- +-+--+
