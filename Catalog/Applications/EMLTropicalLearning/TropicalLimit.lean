import Applications.EMLTropicalLearning.TropicalPWL
import Applications.AbstractAlgebra.Eml

/-!
# The tropical limit of EML (exp–log) networks: Maslov dequantization with a rate

An EML unit is built from the catalog operation `eml x y = exp x - log y`.  A smooth
`k`-term EML aggregation at inverse temperature `T > 0` is the log-sum-exp

`lse T b l = T * log (exp (b / T) + Σ_{y ∈ l} exp (y / T))`,

which is exactly an EML expression (`lse_eq_eml`).  The *tropical limit* is `T → 0⁺`
— equivalently the large-weight limit `s = 1/T → ∞` — in which the smooth unit
degenerates to the max-plus fold `tmax b l` of `TropicalPWL.lean`.

Main results:

* `lse_eq_eml` — the smooth aggregator is generated by the catalog `eml` operation.
* `tmax_le_lse` and `lse_le_tmax_add` — two-sided bounds with the **explicit uniform
  error** `T * log (#terms)`; this quantifies Maslov dequantization.
* `lse_tendsto_tmax` — convergence of the smooth unit to the tropical unit as `T → 0⁺`.
* `lseNeuron_tendsto_tpEval` — pointwise: an EML/softmax neuron converges to the
  tropical polynomial with the same affine terms.
* `lseNeuron_sub_tpEval_le` — the uniform-in-`x` approximation rate `T log k`.
* `largeWeight_tendsto_tmax` — the same statement in the "large weights" scaling
  `s → ∞`, which is the regime of the assignment.
-/

noncomputable section

open Filter Topology EMLTropicalPWL

namespace EMLTropicalLimit

/-! ## Elementary list bounds -/

theorem sum_map_exp_nonneg (f : ℝ → ℝ) (l : List ℝ) :
    0 ≤ (l.map fun y => Real.exp (f y)).sum := by
  induction l with
  | nil => simp
  | cons y ys ih =>
      simp only [List.map_cons, List.sum_cons]
      have := (Real.exp_pos (f y)).le
      linarith

theorem le_sum_map_exp {f : ℝ → ℝ} {l : List ℝ} {y : ℝ} (hy : y ∈ l) :
    Real.exp (f y) ≤ (l.map fun z => Real.exp (f z)).sum := by
  induction l with
  | nil => cases hy
  | cons z zs ih =>
      simp only [List.map_cons, List.sum_cons]
      rcases List.mem_cons.mp hy with h | h
      · have := sum_map_exp_nonneg f zs
        rw [h]
        linarith
      · have h1 := ih h
        have := (Real.exp_pos (f z)).le
        linarith

theorem sum_map_le_length_mul {f : ℝ → ℝ} {l : List ℝ} {M : ℝ}
    (h : ∀ y ∈ l, f y ≤ M) : (l.map f).sum ≤ (l.length : ℝ) * M := by
  induction l with
  | nil => simp
  | cons y ys ih =>
      simp only [List.map_cons, List.sum_cons, List.length_cons]
      have h1 : f y ≤ M := h y (List.mem_cons_self ..)
      have h2 := ih fun z hz => h z (List.mem_cons_of_mem _ hz)
      push_cast
      linarith

/-! ## The EML/log-sum-exp aggregator -/

/-- Smooth (`EML`-generated) aggregator at inverse temperature `T`: a log-sum-exp over
the base value `b` and the entries of `l`. -/
def lse (T b : ℝ) (l : List ℝ) : ℝ :=
  T * Real.log (Real.exp (b / T) + (l.map fun y => Real.exp (y / T)).sum)

/-- The smooth aggregator is an expression in the catalog EML operation
`eml x y = exp x - log y`: exponentials are `eml (·) 1` and the logarithm is
`1 - eml 0 (·)`. -/
theorem lse_eq_eml (T b : ℝ) (l : List ℝ) :
    lse T b l = T * (1 - eml 0 (eml (b / T) 1 + (l.map fun y => eml (y / T) 1).sum)) := by
  simp [lse, eml]

theorem lse_sum_pos (T b : ℝ) (l : List ℝ) :
    0 < Real.exp (b / T) + (l.map fun y => Real.exp (y / T)).sum := by
  have h1 := Real.exp_pos (b / T)
  have h2 := sum_map_exp_nonneg (fun y => y / T) l
  linarith

/-- **Lower dequantization bound.**  The smooth EML aggregator always dominates the
tropical (max-plus) fold. -/
theorem tmax_le_lse {T : ℝ} (hT : 0 < T) (b : ℝ) (l : List ℝ) :
    tmax b l ≤ lse T b l := by
  set M := tmax b l with hM
  have hexp : Real.exp (M / T) ≤ Real.exp (b / T) + (l.map fun y => Real.exp (y / T)).sum := by
    rcases tmax_attained b l with h | h
    · have h2 := sum_map_exp_nonneg (fun y => y / T) l
      rw [hM, h]
      linarith
    · have h1 : Real.exp (M / T) ≤ (l.map fun y => Real.exp (y / T)).sum :=
        le_sum_map_exp (f := fun y => y / T) (hM ▸ h)
      have h2 := (Real.exp_pos (b / T)).le
      linarith
  have hlog : M / T ≤ Real.log (Real.exp (b / T) + (l.map fun y => Real.exp (y / T)).sum) := by
    have := Real.log_le_log (Real.exp_pos _) hexp
    rwa [Real.log_exp] at this
  have := mul_le_mul_of_nonneg_left hlog hT.le
  rw [lse]
  calc M = T * (M / T) := by field_simp
    _ ≤ _ := this

/-- **Upper dequantization bound** with the explicit error `T * log (number of terms)`. -/
theorem lse_le_tmax_add {T : ℝ} (hT : 0 < T) (b : ℝ) (l : List ℝ) :
    lse T b l ≤ tmax b l + T * Real.log (l.length + 1) := by
  set M := tmax b l with hM
  have hterm : ∀ y ∈ l, Real.exp (y / T) ≤ Real.exp (M / T) := fun y hy =>
    Real.exp_le_exp.mpr (by
      have hy' : y ≤ M := le_tmax_of_mem hy
      gcongr)
  have hsum : (l.map fun y => Real.exp (y / T)).sum ≤ (l.length : ℝ) * Real.exp (M / T) :=
    sum_map_le_length_mul hterm
  have hb : Real.exp (b / T) ≤ Real.exp (M / T) := by
    refine Real.exp_le_exp.mpr ?_
    have hbM : b ≤ M := tmax_base_le b l
    gcongr
  have htot : Real.exp (b / T) + (l.map fun y => Real.exp (y / T)).sum
      ≤ ((l.length : ℝ) + 1) * Real.exp (M / T) := by
    have := Real.exp_pos (M / T)
    nlinarith
  have hpos : (0:ℝ) < (l.length : ℝ) + 1 := by positivity
  have hlog : Real.log (Real.exp (b / T) + (l.map fun y => Real.exp (y / T)).sum)
      ≤ Real.log ((l.length : ℝ) + 1) + M / T := by
    have h1 := Real.log_le_log (lse_sum_pos T b l) htot
    rwa [Real.log_mul (ne_of_gt hpos) (Real.exp_ne_zero _), Real.log_exp] at h1
  have := mul_le_mul_of_nonneg_left hlog hT.le
  rw [lse]
  calc T * Real.log (Real.exp (b / T) + (l.map fun y => Real.exp (y / T)).sum)
      ≤ T * (Real.log ((l.length : ℝ) + 1) + M / T) := this
    _ = M + T * Real.log ((l.length : ℝ) + 1) := by field_simp; ring

/-- Two-sided dequantization error bound. -/
theorem abs_lse_sub_tmax_le {T : ℝ} (hT : 0 < T) (b : ℝ) (l : List ℝ) :
    |lse T b l - tmax b l| ≤ T * Real.log (l.length + 1) := by
  have h1 := tmax_le_lse hT b l
  have h2 := lse_le_tmax_add hT b l
  rw [abs_le]
  constructor
  · have : 0 ≤ T * Real.log ((l.length : ℝ) + 1) := by
      have h1 : (1:ℝ) ≤ (l.length : ℝ) + 1 := by
        have : (0:ℝ) ≤ (l.length : ℝ) := Nat.cast_nonneg _
        linarith
      exact mul_nonneg hT.le (Real.log_nonneg h1)
    linarith
  · linarith

/-- **Maslov dequantization.**  As the temperature `T → 0⁺`, the smooth EML aggregator
converges to the tropical (max-plus) fold. -/
theorem lse_tendsto_tmax (b : ℝ) (l : List ℝ) :
    Tendsto (fun T => lse T b l) (𝓝[>] 0) (𝓝 (tmax b l)) := by
  have hlow : ∀ᶠ T in 𝓝[>] (0:ℝ), tmax b l ≤ lse T b l := by
    filter_upwards [self_mem_nhdsWithin] with T hT
    exact tmax_le_lse hT b l
  have hhigh : ∀ᶠ T in 𝓝[>] (0:ℝ), lse T b l ≤ tmax b l + T * Real.log (l.length + 1) := by
    filter_upwards [self_mem_nhdsWithin] with T hT
    exact lse_le_tmax_add hT b l
  have hup : Tendsto (fun T : ℝ => tmax b l + T * Real.log (l.length + 1)) (𝓝[>] 0)
      (𝓝 (tmax b l)) := by
    have : Tendsto (fun T : ℝ => tmax b l + T * Real.log (l.length + 1)) (𝓝 0)
        (𝓝 (tmax b l + 0 * Real.log (l.length + 1))) := by
      exact tendsto_const_nhds.add (tendsto_id.mul tendsto_const_nhds)
    simpa using this.mono_left nhdsWithin_le_nhds
  exact tendsto_of_tendsto_of_tendsto_of_le_of_le' tendsto_const_nhds hup hlow hhigh

/-! ## Large-weight (tropical) limit of an EML neuron -/

/-- The EML/softmax neuron with affine terms `(b, l)` and weight scale `T⁻¹`. -/
def lseNeuron (T : ℝ) (b : ℝ × ℝ) (l : List (ℝ × ℝ)) (x : ℝ) : ℝ :=
  lse T (b.1 * x + b.2) (l.map fun t => t.1 * x + t.2)

/-- **Uniform approximation rate.**  At temperature `T` the EML neuron differs from the
tropical polynomial with the same monomials by at most `T log k`, `k` the number of
tropical monomials — uniformly in the input `x`. -/
theorem lseNeuron_sub_tpEval_le {T : ℝ} (hT : 0 < T) (b : ℝ × ℝ) (l : List (ℝ × ℝ)) (x : ℝ) :
    |lseNeuron T b l x - tpEval b l x| ≤ T * Real.log (l.length + 1) := by
  have h := abs_lse_sub_tmax_le hT (b.1 * x + b.2) (l.map fun t => t.1 * x + t.2)
  simpa [lseNeuron, tpEval, List.length_map] using h

/-- Pointwise tropical limit: the EML neuron dequantizes to a tropical polynomial. -/
theorem lseNeuron_tendsto_tpEval (b : ℝ × ℝ) (l : List (ℝ × ℝ)) (x : ℝ) :
    Tendsto (fun T => lseNeuron T b l x) (𝓝[>] 0) (𝓝 (tpEval b l x)) :=
  lse_tendsto_tmax _ _

/-- The limit object is a tropical polynomial, hence a tropical rational function, hence
exactly realizable by a ReLU network. -/
theorem tropicalLimit_isTropRat (b : ℝ × ℝ) (l : List (ℝ × ℝ)) :
    IsTropRat (fun x => tpEval b l x) ∧ ∃ e : ReluExpr, ∀ x, e.eval x = tpEval b l x := by
  have hpoly : IsTropPoly fun x => tpEval b l x := ⟨b, l, fun _ => rfl⟩
  exact ⟨hpoly.isTropRat, hpoly.isTropRat.exists_reluExpr⟩

/-- Large-weight scaling: with weights of size `s`, an EML unit computes
`s⁻¹ log (exp (s u) + Σ exp (s y))`. -/
def largeWeight (s b : ℝ) (l : List ℝ) : ℝ :=
  s⁻¹ * Real.log (Real.exp (s * b) + (l.map fun y => Real.exp (s * y)).sum)

theorem largeWeight_eq_lse {s : ℝ} (hs : 0 < s) (b : ℝ) (l : List ℝ) :
    largeWeight s b l = lse s⁻¹ b l := by
  have hs' : s ≠ 0 := ne_of_gt hs
  have hdiv : ∀ y : ℝ, y / s⁻¹ = s * y := by
    intro y; field_simp
  simp only [largeWeight, lse, hdiv]

/-- **Tropical limit in the large-weight regime.**  As the weight scale `s → ∞`, the
EML unit converges to the tropical max-plus unit; this is the regime in which EML
training becomes piecewise-linear optimization. -/
theorem largeWeight_tendsto_tmax (b : ℝ) (l : List ℝ) :
    Tendsto (fun s => largeWeight s b l) atTop (𝓝 (tmax b l)) := by
  have hlow : ∀ᶠ s in atTop, tmax b l ≤ largeWeight s b l := by
    filter_upwards [eventually_gt_atTop (0:ℝ)] with s hs
    rw [largeWeight_eq_lse hs]
    exact tmax_le_lse (inv_pos.mpr hs) b l
  have hhigh : ∀ᶠ s in atTop,
      largeWeight s b l ≤ tmax b l + s⁻¹ * Real.log (l.length + 1) := by
    filter_upwards [eventually_gt_atTop (0:ℝ)] with s hs
    rw [largeWeight_eq_lse hs]
    exact lse_le_tmax_add (inv_pos.mpr hs) b l
  have hup : Tendsto (fun s : ℝ => tmax b l + s⁻¹ * Real.log (l.length + 1)) atTop
      (𝓝 (tmax b l)) := by
    have h0 : Tendsto (fun s : ℝ => s⁻¹ * Real.log (l.length + 1)) atTop (𝓝 0) := by
      simpa using (tendsto_inv_atTop_zero.mul tendsto_const_nhds :
        Tendsto (fun s : ℝ => s⁻¹ * Real.log (l.length + 1)) atTop (𝓝 (0 * _)))
    simpa using tendsto_const_nhds.add h0
  exact tendsto_of_tendsto_of_tendsto_of_le_of_le' tendsto_const_nhds hup hlow hhigh

/-! ## Kernel-checked instances -/

example : lse 1 0 [] = 0 := by simp [lse]
example : largeWeight 1 0 [] = 0 := by simp [largeWeight]

end EMLTropicalLimit