import Catalog.Algebra.TruthFractalDimensionDeepening

/-!
# Nonstationary Proof Search: Entropy, Products, and Multiscale Composition

Uniform search trees have a single successful branching number at every depth.
Real derivation trees are nonstationary: both the ambient branching and the
number of extensible steps can vary from level to level.  This chapter replaces
one branching number by a finite branching profile and proves an exact
multiplicative-to-fractal correspondence.

For a profile `a = [a₀, …, aₙ₋₁]`, its path count is `∏ᵢ aᵢ` and its logarithmic
volume is `∑ᵢ log aᵢ`.  Given an ambient profile `b` and successful profile `s`,
the finite-scale dimension is

`D(b,s) = (∑ᵢ log sᵢ) / (∑ᵢ log bᵢ)`.

The principal result is a multiscale composition law: concatenating two search
phases takes the ambient-entropy-weighted mean of their dimensions.  Thus a
local hard phase contributes according to its information volume, not merely
its number of levels.  Exact path counting and logarithmic additivity connect
rooted-tree combinatorics, real analysis, and information theory.

-- !-- Lab Notes -- !--
Hypothesis (Hypothesizer), ranked by expected impact:
1. Nonstationary successful path counts obey an exact entropy power law.
2. Sequential composition takes an ambient-entropy-weighted mean of dimensions.
3. Dimension is monotone under coordinatewise enlargement of successful branching.
4. Every nondegenerate finite profile has dimension in the closed unit interval.
5. Repeating a profile preserves dimension while multiplying both information volumes.
6. Unweighted averaging of phase dimensions is valid even when ambient branching differs.

Experiment (Experimenter): finite profiles with branching between two and five
were enumerated.  Product counts, logarithmic volumes, and concatenations were
compared.  The weighted composition formula held throughout.  The sixth
hypothesis failed for a binary phase followed by a high-branching phase: equal
length does not imply equal information weight.

Analysis (Analyst): logarithm turns levelwise products into additive entropy.
This makes concatenation linear before normalization, and normalization forces
weights equal to ambient logarithmic volumes.  Coordinatewise pruning gives the
closed-unit-interval bound and monotonicity.

Critique (Critic): positivity and genuine ambient entropy are explicit; profiles
containing only unary ambient levels are excluded exactly where the denominator
vanishes.  No complexity claim is inferred from dimension alone.  The central
composition theorem is not definitional and depends on logarithmic product laws
and division algebra.  The construction extends the established periodic binary
model rather than renaming it.

Synthesis (Principal Investigator): proof-search dimension is a relative entropy
for arbitrary finite nonstationary profiles.  It is compositional, but the
correct composition is information-weighted rather than depth-weighted.
-/

open scoped BigOperators

namespace ProofSearchFractalDimensionDeepening

/-- The number of leaves generated by a finite levelwise branching profile. -/
def pathCount (a : List ℕ) : ℕ := a.prod

/-- The logarithmic path volume of a branching profile. -/
noncomputable def logVolume (a : List ℕ) : ℝ := (a.map (fun x => Real.log x)).sum

/-- Relative entropy dimension for a nonstationary finite search profile. -/
noncomputable def profileDim (ambient successful : List ℕ) : ℝ :=
  logVolume successful / logVolume ambient

/-
Logarithmic volume is additive under sequential composition.
-/
theorem logVolume_append (a c : List ℕ) :
    logVolume (a ++ c) = logVolume a + logVolume c := by
  unfold logVolume; simp +decide [ List.sum_append ] ;

/-
Repeating a profile scales its logarithmic volume by the repetition count.
-/
theorem logVolume_replicate_append (k : ℕ) (a : List ℕ) :
    logVolume (List.flatten (List.replicate k a)) = k * logVolume a := by
  induction k with
  | zero => simp [logVolume]
  | succ k ih =>
      rw [List.replicate_succ, List.flatten_cons, logVolume_append, ih]
      push_cast
      ring

/-
For positive branching profiles, logarithmic volume is the logarithm of the
exact combinatorial path count.
-/
theorem log_pathCount (a : List ℕ) (ha : ∀ x ∈ a, 1 ≤ x) :
    Real.log (pathCount a) = logVolume a := by
  induction a <;> simp_all +decide [ pathCount, logVolume ];
  rw [ Real.log_mul ( by norm_cast; linarith ) ( by exact ne_of_gt <| by exact List.prod_pos <| by aesop ) ] ; aesop

/-
The exact entropy power law for a nonstationary search tree.
-/
theorem profileDim_scaling (ambient successful : List ℕ)
    (ha : ∀ x ∈ ambient, 1 ≤ x) (hs : ∀ x ∈ successful, 1 ≤ x)
    (hA : logVolume ambient ≠ 0) :
    ((pathCount successful : ℝ)) =
      ((pathCount ambient : ℝ)) ^ (profileDim ambient successful) := by
  rw [ Real.rpow_def_of_pos ];
  · unfold profileDim;
    rw [ mul_div, eq_comm ];
    convert Real.exp_log ( Nat.cast_pos.mpr ( show 0 < pathCount successful from ?_ ) ) using 1;
    · rw [ log_pathCount ambient ha, log_pathCount successful hs ];
      rw [ mul_div_cancel_left₀ _ hA ];
    · exact List.prod_pos fun x hx => hs x hx;
  · exact_mod_cast List.prod_pos fun x hx => ha x hx

/-
Coordinatewise pruning cannot increase logarithmic path volume.
-/
theorem logVolume_mono_of_forall₂ {ambient successful : List ℕ}
    (hs : ∀ x ∈ successful, 1 ≤ x)
    (hprune : List.Forall₂ (fun s b => s ≤ b) successful ambient) :
    logVolume successful ≤ logVolume ambient := by
  induction hprune <;> simp_all +decide [ logVolume ];
  exact add_le_add ( Real.log_le_log ( Nat.cast_pos.mpr hs.1 ) ( Nat.cast_le.mpr ‹_› ) ) ‹_›

/-
Every nondegenerate pruned profile has dimension in `[0,1]`.
-/
theorem profileDim_mem_unitInterval {ambient successful : List ℕ}
    (hs : ∀ x ∈ successful, 1 ≤ x)
    (hprune : List.Forall₂ (fun s b => s ≤ b) successful ambient)
    (hA : 0 < logVolume ambient) :
    profileDim ambient successful ∈ Set.Icc (0 : ℝ) 1 := by
  refine' ⟨ div_nonneg ( List.sum_nonneg _ ) hA.le, div_le_one_of_le₀ _ hA.le ⟩;
  · simp +zetaDelta at *;
    exact fun x hx => Real.log_nonneg <| mod_cast hs x hx;
  · exact logVolume_mono_of_forall₂ hs hprune

/-
Increasing successful branching coordinatewise increases dimension.
-/
theorem profileDim_mono_success {ambient s t : List ℕ}
    (hs : ∀ x ∈ s, 1 ≤ x) (hst : List.Forall₂ (fun x y => x ≤ y) s t)
    (hA : 0 < logVolume ambient) :
    profileDim ambient s ≤ profileDim ambient t := by
  convert div_le_div_of_nonneg_right ( logVolume_mono_of_forall₂ hs hst ) hA.le using 1

/-
**Multiscale composition law.** The dimension of two sequential search
phases is the ambient-entropy-weighted mean of the phase dimensions.
-/
theorem profileDim_append_weighted (a₁ s₁ a₂ s₂ : List ℕ)
    (h₁ : logVolume a₁ ≠ 0) (h₂ : logVolume a₂ ≠ 0)
    (h₁₂ : logVolume a₁ + logVolume a₂ ≠ 0) :
    profileDim (a₁ ++ a₂) (s₁ ++ s₂) =
      (logVolume a₁ * profileDim a₁ s₁ +
        logVolume a₂ * profileDim a₂ s₂) /
      (logVolume a₁ + logVolume a₂) := by
  rw [profileDim, logVolume_append, logVolume_append]
  unfold profileDim
  field_simp [h₁, h₂, h₁₂]

/-
Repetition preserves dimension: the same local geometry at every block has
the same relative entropy at every larger scale.
-/
theorem profileDim_repeat (k : ℕ) (hk : 1 ≤ k) (ambient successful : List ℕ) :
    profileDim (List.flatten (List.replicate k ambient))
      (List.flatten (List.replicate k successful)) =
      profileDim ambient successful := by
  unfold profileDim
  rw [logVolume_replicate_append, logVolume_replicate_append]
  exact mul_div_mul_left _ _ (show (k : ℝ) ≠ 0 by positivity)

/-- **Periodic bridge.** Periodic binary successful-prefix geometries are a
special case of the entropy profile: their box dimension is the fraction of
levels on which two branches remain available. -/
theorem periodic_catalog_bridge (m : ℕ) (R : Finset ℕ)
    (hR : R ⊆ Finset.range m) (hm : 1 ≤ m) :
    TruthFractalDimensionDeepening.boxDim
        (TruthFractalDimensionDeepening.densityTheory m R) =
      (R.card : ℝ) / m := by
  exact TruthFractalDimensionDeepening.boxDim_densityTheory m R hR hm

end ProofSearchFractalDimensionDeepening