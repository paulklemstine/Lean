--- Ramsey.lean
+++ Ramsey.lean
@@ -177,4 +177,66 @@
 theorem ramsey_three_three : Arrows 6 3 3 ∧ ¬ Arrows 5 3 3 :=
   ⟨arrows_three_three, not_arrows_five_three_three⟩
 
+/-! ## The exact infinite family `R(2, t) = t`
+
+The following results establish, for every `t`, the exact two‑parameter Ramsey
+value `R(2, t) = t`.  The arguments are direct and self‑contained: they use only
+the definition of `Arrows`, basic clique reasoning, and explicit colourings.
+They deliberately do **not** invoke the Erdős–Szekeres machinery above, so there
+is no circular dependency. -/
+
+/-
+**Upper bound `R(2, t) ≤ t`.** For every `t`, `Arrows t 2 t` holds: any
+red/blue colouring of a vertex set of size at least `t` contains a red `2`‑clique
+or a blue `t`‑clique.
+
+The witness is algorithmic: given the vertex set `W`, search for a red edge
+(a pair `u ≠ v` in `W` with `G.Adj u v`).  If one exists, `{u, v}` is a red
+`2`‑clique.  Otherwise `W` is independent in `G`, hence a clique in `Gᶜ`, and any
+`t`‑element subset of `W` is a blue `t`‑clique.
+-/
+theorem arrows_two_t (t : ℕ) : Arrows t 2 t := by
+  intro V _ G W hW;
+  by_cases h : ∃ u v : V, u ≠ v ∧ u ∈ W ∧ v ∈ W ∧ G.Adj u v;
+  · obtain ⟨ u, v, hne, hu, hv, hadj ⟩ := h;
+    refine Or.inl ⟨ { u, v }, ?_, ?_ ⟩ <;> simp_all +decide [ SimpleGraph.isNClique_iff ];
+    aesop_cat;
+  · obtain ⟨ S, hS ⟩ := Finset.exists_subset_card_eq hW;
+    refine Or.inr ⟨ S, hS.1, ?_ ⟩;
+    exact ⟨ fun u hu v hv huv => by_contradiction fun huv' => h ⟨ u, v, huv, hS.1 hu, hS.1 hv, by simpa [ huv ] using huv' ⟩, hS.2 ⟩
+
+/-
+**Lower bound (clean form) `R(2, t+1) > t`.** The all‑blue colouring (`G = ⊥`)
+of a vertex set of size `t` has no red `2`‑clique and no blue `(t+1)`‑clique, so
+`Arrows t 2 (t+1)` fails.
+-/
+theorem not_arrows_two_succ (t : ℕ) : ¬ Arrows t 2 (t + 1) := by
+  intro h
+  specialize h (⊥ : SimpleGraph (Fin t)) Finset.univ
+  simp_all +decide;
+  obtain ⟨ S, hS ⟩ := h; have := Finset.card_le_univ S; simp_all +decide [ SimpleGraph.isNClique_iff ]
+
+/-- **Lower bound `R(2, t) > t - 1`.** For `t ≥ 1`, `Arrows (t-1) 2 t` fails:
+the all‑blue colouring on `t-1` vertices has no red `2`‑clique and (having too
+few vertices) no blue `t`‑clique. -/
+theorem not_arrows_pred_two_t (t : ℕ) (ht : 1 ≤ t) : ¬ Arrows (t - 1) 2 t := by
+  obtain ⟨t, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : t ≠ 0)
+  simpa using not_arrows_two_succ t
+
+/-- **The exact value `R(2, t) = t`** for every `t ≥ 1`: every colouring of a
+set of size `t` contains a red edge or a blue `t`‑clique, but some colouring of a
+set of size `t-1` (the all‑blue one) contains neither. -/
+theorem ramsey_two_t (t : ℕ) (ht : 1 ≤ t) :
+    Arrows t 2 t ∧ ¬ Arrows (t - 1) 2 t :=
+  ⟨arrows_two_t t, not_arrows_pred_two_t t ht⟩
+
+/-
+**Symmetry of the arrow relation.** Swapping the two colour parameters
+preserves truth: `Arrows n s t → Arrows n t s`.  The proof applies the hypothesis
+to the complemented colouring `Gᶜ` and uses `compl_compl`.
+-/
+theorem Arrows.symm {n s t : ℕ} (h : Arrows n s t) : Arrows n t s := by
+  intro V _ G W hW;
+  specialize h Gᶜ W hW ; aesop
+
 
