 /-
 Translation preserves additive Steiner triples in exponent three.
@@ -82,14 +81,9 @@
 theorem steinerThird_translate {A : Type*} [AddCommGroup A]
     (hexp : ∀ t : A, t + t + t = 0) (x y t : A) :
     steinerThird (x + t) (y + t) = steinerThird x y + t := by
