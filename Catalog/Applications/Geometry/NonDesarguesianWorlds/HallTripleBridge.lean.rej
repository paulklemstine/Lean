-      simp +decide [ two_smul, sub_eq_add_neg ];
-      grind
-    rw [h_inv, h_inv'];
-  exact h_inv
+  unfold steinerThird;
+  rw [ neg_eq_iff_add_eq_zero ];
+  convert hexp t using 1 ; abel_nf
 
