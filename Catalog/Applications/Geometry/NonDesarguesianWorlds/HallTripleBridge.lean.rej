   rw [ h_neg, hadd ]
 
 abbrev HallPoint := ZMod 3 × ZMod 3
@@ -117,14 +112,14 @@
 -/
 theorem hall_triple_unique_completion (x y : HallPoint) :
     ∃! z : HallPoint, z = steinerThird x y := by
