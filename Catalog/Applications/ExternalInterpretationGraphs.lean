/-
# The Definability Boundary, II: Universal Property, Expressivity Gap, Graphs

This file continues `Catalog/Applications/ExternalInterpretationDefinability.lean`.
Three further layers of the classification of *external interpretations* that are
recoverable from structural truth:

* **Part A — Universal property.**  The orbit map is the *finest* recoverable
  interpretation: every recoverable interpretation factors through it uniquely
  (`recoverable_factors_uniquely`), and recoverable interpretations are closed
  under post-composition and pairing (`Recoverable.comp`, `Recoverable.pair`).
  Thus the recoverable interpretations of a model form a clone generated by the
  orbit map.
* **Part B — The expressivity gap is real, already in finite models.**  In the
  *trivial* invariant language (only `∅` and the whole model) no non-constant
  interpretation is definable (`not_definable_trivialLang_of_nonconstant`), while
  the orbit-counting language defines every orbit indicator.  Hence whenever a
  model has at least two orbits, adding orbit-counting modalities strictly
  increases expressive power (`counting_strictly_stronger`): the enrichment in
  the finite half of the conjecture is *necessary*, not merely sufficient.
* **Part C — Graphs: a concrete external interpretation test bed.**  We build the
  automorphism group `autGroup Γ` of a simple graph as a subgroup of
  `Equiv.Perm V`, prove that the degree function is orbit-constant and therefore
  recoverable (`degree_recoverable`), and exhibit the boundary concretely:
  - on the complete graph every recoverable interpretation is constant
    (`completeGraph_recoverable_iff_constant`) — maximal symmetry annihilates
    external meaning;
  - on the 3-vertex path the automorphism group is exactly `{1, (0 2)}`
    (`autGroup_P3_eq`), so an interpretation is recoverable iff it identifies
    the two endpoints (`P3_recoverable_iff`); vertex *labels* collide
    (`P3_labels_not_recoverable`) while vertex *degrees* survive.
-/

import Catalog.Applications.ExternalInterpretationDefinability

namespace ExternalInterpretationGraphs

open MulAction SimpleGraph ExternalInterpretationDefinability

universe u v w

variable {G : Type u} {M : Type v} {V : Type w} [Group G] [MulAction G M]

/-! ## Part A — The orbit map is the universal recoverable interpretation -/

/-- The orbit map, sending an element to its structural equivalence class. -/
def orbitMap (G : Type u) (M : Type v) [Group G] [MulAction G M] :
    M → orbitRel.Quotient G M := fun x => Quotient.mk _ x

/-- The orbit map is itself recoverable from structural truth. -/
theorem recoverable_orbitMap : Recoverable G (orbitMap G M) := ⟨id, fun _ => rfl⟩

/-- **Universal property.**  Every recoverable interpretation factors through the
orbit map, and does so in exactly one way. -/
theorem recoverable_factors_uniquely {I : M → V} (h : Recoverable G I) :
    ∃! F : orbitRel.Quotient G M → V, ∀ x : M, F (orbitMap G M x) = I x := by
  obtain ⟨F, hF⟩ := h
  refine ⟨F, hF, ?_⟩
  intro F' hF'
  exact recovery_unique hF' hF

/-- Recoverable interpretations are closed under post-composition: renaming the
external meanings never destroys recoverability. -/
theorem Recoverable.comp {W : Type*} {I : M → V} (φ : V → W) (h : Recoverable G I) :
    Recoverable G (fun x => φ (I x)) := by
  rw [recoverable_iff_orbitConstant] at h ⊢
  intro x y hxy
  show φ (I x) = φ (I y)
  rw [h hxy]

/-- Recoverable interpretations are closed under pairing. -/
theorem Recoverable.pair {W : Type*} {I : M → V} {J : M → W}
    (hI : Recoverable G I) (hJ : Recoverable G J) :
    Recoverable G (fun x => (I x, J x)) := by
  rw [recoverable_iff_orbitConstant] at hI hJ ⊢
  intro x y hxy
  show (I x, J x) = (I y, J y)
  rw [hI hxy, hJ hxy]

/-- Conversely, anything obtained from the orbit map by post-composition is
recoverable: the orbit map generates all recoverable interpretations. -/
theorem recoverable_of_factors (φ : orbitRel.Quotient G M → V) :
    Recoverable G (fun x => φ (orbitMap G M x)) :=
  Recoverable.comp φ recoverable_orbitMap

/-! ## Part B — The expressivity gap: counting modalities are necessary -/

/-- The **trivial invariant language**: only the contradictory and the tautologous
formula.  It is invariant, but blind. -/
def trivialLang (G : Type u) (M : Type v) [Group G] [MulAction G M] : InvLang G M where
  Defble s := s = ∅ ∨ s = Set.univ
  empty_mem := Or.inl rfl
  compl_mem := by
    rintro s (rfl | rfl)
    · exact Or.inr (by simp)
    · exact Or.inl (by simp)
  union_mem := by
    rintro s t (rfl | rfl) (rfl | rfl) <;> simp
  invariant := by
    rintro s (rfl | rfl) g x hx
    · exact absurd hx (Set.notMem_empty x)
    · trivial

/-- In the trivial language no non-constant interpretation is definable. -/
theorem not_definable_trivialLang_of_nonconstant {I : M → V} {x y : M} (hne : I x ≠ I y) :
    ¬ Definable (trivialLang G M) I := by
  intro h
  rcases h (I x) with hemp | huniv
  · have : x ∈ ({z | I z = I x} : Set M) := rfl
    rw [hemp] at this
    exact this
  · have : y ∈ ({z | I z = I x} : Set M) := by rw [huniv]; trivial
    exact hne this.symm

open scoped Classical in
/-- The indicator interpretation of the orbit of `x`. -/
noncomputable def orbitIndicator (G : Type u) [Group G] [MulAction G M] (x : M) : M → Bool :=
  fun z => if z ∈ orbit G x then true else false

lemma orbitIndicator_self (x : M) : orbitIndicator G x x = true := by
  classical
  simp [orbitIndicator, MulAction.mem_orbit_self]

lemma orbitIndicator_eq_false {x y : M} (h : ¬ Indist G x y) : orbitIndicator G x y = false := by
  classical
  have : y ∉ orbit G x := by
    intro hy
    exact h (MulAction.mem_orbit_iff.mp hy)
  simp [orbitIndicator, this]

lemma orbitIndicator_smul (x : M) (g : G) (z : M) :
    orbitIndicator G x (g • z) = orbitIndicator G x z := by
  classical
  by_cases hmem : z ∈ orbit G x
  · have hg : g • z ∈ orbit G x := MulAction.mem_orbit_of_mem_orbit g hmem
    simp [orbitIndicator, hmem, hg]
  · have hg : g • z ∉ orbit G x := by
      intro hcon
      exact hmem (by simpa using MulAction.mem_orbit_of_mem_orbit g⁻¹ hcon)
    simp [orbitIndicator, hmem, hg]

lemma countGen_orbitIndicator_fibre [Finite M] (x : M) (b : Bool) :
    CountGen G M {z | orbitIndicator G x z = b} := by
  refine countGen_of_invariantSet ?_
  intro g z hz
  simp only [Set.mem_setOf_eq] at hz ⊢
  rw [orbitIndicator_smul]
  exact hz

/-- **Counting modalities strictly increase expressive power.**  As soon as a
finite model has two structurally distinguishable elements, the orbit indicator
is definable by a Boolean combination of orbit-counting predicates but is not
definable in the trivial invariant language.  So the finite half of the
conjecture genuinely needs the enrichment of the language. -/
theorem counting_strictly_stronger [Finite M] {x y : M} (hxy : ¬ Indist G x y) :
    ∃ I : M → Bool, (∀ b : Bool, CountGen G M {z | I z = b}) ∧
      Recoverable G I ∧ ¬ Definable (trivialLang G M) I := by
  classical
  refine ⟨orbitIndicator G x, countGen_orbitIndicator_fibre x, ?_, ?_⟩
  · exact (finite_recoverable_iff_definable _).mpr (countGen_orbitIndicator_fibre x)
  · refine not_definable_trivialLang_of_nonconstant (x := x) (y := y) ?_
    rw [orbitIndicator_self, orbitIndicator_eq_false hxy]
    simp

/-! ## Part C — Graphs -/

section Graphs

variable {W : Type*}

/-- The automorphism group of a simple graph, as a subgroup of the symmetric
group of its vertex set. -/
def autGroup (Γ : SimpleGraph W) : Subgroup (Equiv.Perm W) where
  carrier := {σ | ∀ a b, Γ.Adj (σ a) (σ b) ↔ Γ.Adj a b}
  one_mem' := by intro a b; simp
  mul_mem' := by
    intro σ τ hσ hτ a b
    simp only [Equiv.Perm.coe_mul, Function.comp_apply]
    rw [hσ, hτ]
  inv_mem' := by
    intro σ hσ a b
    rw [← hσ (σ⁻¹ a) (σ⁻¹ b)]
    simp

lemma autGroup_adj {Γ : SimpleGraph W} (σ : autGroup Γ) (a b : W) :
    Γ.Adj (σ • a) (σ • b) ↔ Γ.Adj a b := σ.2 a b

/-- An automorphism permutes neighbourhoods. -/
lemma neighborFinset_smul {Γ : SimpleGraph W} [Fintype W] [DecidableEq W] [DecidableRel Γ.Adj]
    (σ : autGroup Γ) (v : W) :
    Γ.neighborFinset (σ • v) = (Γ.neighborFinset v).image (fun u => σ • u) := by
  ext z
  simp only [Finset.mem_image, SimpleGraph.mem_neighborFinset]
  constructor
  · intro h
    refine ⟨(σ : Equiv.Perm W).symm z, ?_, ?_⟩
    · have h2 := σ.2 v ((σ : Equiv.Perm W).symm z)
      simp only [Equiv.apply_symm_apply] at h2
      exact h2.mp h
    · show (σ : Equiv.Perm W) ((σ : Equiv.Perm W).symm z) = z
      simp
  · rintro ⟨u, hu, rfl⟩
    exact (σ.2 v u).mpr hu

/-- Degrees are invariant under graph automorphisms. -/
theorem degree_smul {Γ : SimpleGraph W} [Fintype W] [DecidableRel Γ.Adj]
    (σ : autGroup Γ) (v : W) : Γ.degree (σ • v) = Γ.degree v := by
  classical
  rw [SimpleGraph.degree, SimpleGraph.degree, neighborFinset_smul σ v,
    Finset.card_image_of_injective _ (MulAction.injective σ)]

/-- **Degree is recoverable from structural truth.**  The vertex-degree
interpretation of a finite graph factors through the automorphism orbit space. -/
theorem degree_recoverable (Γ : SimpleGraph W) [Fintype W] [DecidableRel Γ.Adj] :
    Recoverable (autGroup Γ) (fun v => Γ.degree v) := by
  rw [recoverable_iff_orbitConstant]
  rintro x y ⟨g, rfl⟩
  exact (degree_smul g x).symm

/-- Every permutation is an automorphism of the complete graph. -/
lemma mem_autGroup_completeGraph (σ : Equiv.Perm W) : σ ∈ autGroup (completeGraph W) := by
  intro a b
  show σ a ≠ σ b ↔ a ≠ b
  simp

/-- **Maximal symmetry annihilates meaning.**  On a complete graph an external
interpretation is recoverable from structural truth exactly when it is constant:
the graph structure distinguishes no vertex from any other. -/
theorem completeGraph_recoverable_iff_constant {V' : Type*} [DecidableEq W] (I : W → V') :
    Recoverable (autGroup (completeGraph W)) I ↔ ∀ x y : W, I x = I y := by
  rw [recoverable_iff_orbitConstant]
  constructor
  · intro h x y
    by_cases hxy : x = y
    · rw [hxy]
    · refine h ⟨⟨Equiv.swap x y, mem_autGroup_completeGraph _⟩, ?_⟩
      show Equiv.swap x y x = y
      simp
  · intro h x y _
    exact h x y

/-! ### The 3-vertex path: a fully classified example -/

/-- The path `0 — 1 — 2` on three vertices. -/
def P3 : SimpleGraph (Fin 3) where
  Adj a b := a.val + 1 = b.val ∨ b.val + 1 = a.val
  symm := by intro a b h; exact h.symm
  loopless := ⟨by intro a h; omega⟩

instance : DecidableRel P3.Adj := fun _ _ => inferInstanceAs (Decidable (_ ∨ _))

instance decidableMemAutGroupP3 (σ : Equiv.Perm (Fin 3)) : Decidable (σ ∈ autGroup P3) :=
  decidable_of_iff (∀ a b, P3.Adj (σ a) (σ b) ↔ P3.Adj a b) Iff.rfl

/-- The endpoint swap is an automorphism of the path. -/
lemma swap02_mem_autGroup_P3 : Equiv.swap (0 : Fin 3) 2 ∈ autGroup P3 := by
  decide

/-- The automorphism group of the 3-path consists of exactly the identity and the
endpoint swap. -/
theorem autGroup_P3_eq (σ : Equiv.Perm (Fin 3)) :
    σ ∈ autGroup P3 ↔ (σ = 1 ∨ σ = Equiv.swap 0 2) := by
  constructor
  · revert σ; decide
  · rintro (rfl | rfl)
    · exact one_mem _
    · exact swap02_mem_autGroup_P3

/-- **Complete classification for the 3-path.**  An external interpretation of the
path `0 — 1 — 2` is recoverable from structural truth precisely when it assigns
the two endpoints the same meaning. -/
theorem P3_recoverable_iff {V' : Type*} (I : Fin 3 → V') :
    Recoverable (autGroup P3) I ↔ I 0 = I 2 := by
  rw [recoverable_iff_orbitConstant]
  constructor
  · intro h
    refine h ⟨⟨Equiv.swap 0 2, swap02_mem_autGroup_P3⟩, ?_⟩
    show Equiv.swap (0 : Fin 3) 2 0 = 2
    simp
  · rintro h x y ⟨g, rfl⟩
    rcases (autGroup_P3_eq (g : Equiv.Perm (Fin 3))).mp g.2 with hg | hg
    · have : (g : Equiv.Perm (Fin 3)) x = x := by rw [hg]; rfl
      show I x = I ((g : Equiv.Perm (Fin 3)) x)
      rw [this]
    · have hx : (g : Equiv.Perm (Fin 3)) x = Equiv.swap (0 : Fin 3) 2 x := by rw [hg]
      show I x = I ((g : Equiv.Perm (Fin 3)) x)
      rw [hx]
      fin_cases x
      · show I 0 = I (Equiv.swap (0 : Fin 3) 2 0)
        rw [Equiv.swap_apply_left]; exact h
      · show I 1 = I (Equiv.swap (0 : Fin 3) 2 1)
        rw [Equiv.swap_apply_of_ne_of_ne (by decide) (by decide)]
      · show I 2 = I (Equiv.swap (0 : Fin 3) 2 2)
        rw [Equiv.swap_apply_right]; exact h.symm

/-- Vertex *labels* on the path are not recoverable: the two endpoints collide. -/
theorem P3_labels_not_recoverable : ¬ Recoverable (autGroup P3) (fun v : Fin 3 => v) := by
  intro h
  have := (P3_recoverable_iff (fun v : Fin 3 => v)).mp h
  simp at this

/-- Vertex *degrees* on the path are recoverable, and indeed the degree
interpretation separates the midpoint from the endpoints: it is exactly as fine
as structural truth allows. -/
theorem P3_degree_recoverable_and_separating :
    Recoverable (autGroup P3) (fun v => P3.degree v) ∧
      P3.degree 0 = P3.degree 2 ∧ P3.degree 1 ≠ P3.degree 0 :=
  ⟨degree_recoverable P3, by decide, by decide⟩

end Graphs

end ExternalInterpretationGraphs