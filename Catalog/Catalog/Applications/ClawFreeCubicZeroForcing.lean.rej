--- ClawFreeCubicZeroForcing.lean
+++ ClawFreeCubicZeroForcing.lean
@@ -43,41 +43,6 @@
 theorem subset_of_forceStep {G : SimpleGraph V} {S T : Finset V}
     (h : ForceStep G S T) : S ⊆ T := by
   obtain ⟨ u, hu, w, hw, h₁, h₂, rfl ⟩ := h; aesop;
-
-omit [Fintype V] in
-/-- Along any finite sequence of legal forces, the colored set only grows. -/
-theorem subset_of_forceSequence {G : SimpleGraph V} {S T : Finset V}
-    (h : ReflTransGen (ForceStep G) S T) : S ⊆ T := by
-  induction h;
-  · rfl;
-  · exact Finset.Subset.trans ‹_› ( subset_of_forceStep ‹_› )
-
-omit [Fintype V] in
-/-- Consequently, cardinality is monotone along a forcing sequence. -/
-theorem card_le_of_forceSequence {G : SimpleGraph V} {S T : Finset V}
-    (h : ReflTransGen (ForceStep G) S T) : S.card ≤ T.card := by
-  exact Finset.card_le_card (subset_of_forceSequence h)
-
-omit [Fintype V] in
-/-- A forcing sequence whose endpoints have equal size made no net progress. -/
-theorem eq_of_forceSequence_of_card_eq {G : SimpleGraph V} {S T : Finset V}
-    (h : ReflTransGen (ForceStep G) S T) (hcard : S.card = T.card) : S = T := by
-  exact Finset.eq_of_subset_of_card_le ( subset_of_forceSequence h ) hcard.ge
-
-omit [Fintype V] in
-/-- The reachability relation generated by legal forcing moves is antisymmetric. -/
-theorem forceSequence_antisymm {G : SimpleGraph V} {S T : Finset V}
-    (hST : ReflTransGen (ForceStep G) S T)
-    (hTS : ReflTransGen (ForceStep G) T S) : S = T := by
-  apply eq_of_forceSequence_of_card_eq hST;
-  exact le_antisymm ( card_le_of_forceSequence hST ) ( card_le_of_forceSequence hTS )
-
-/-- If `S` can force `T` and `T` can force the whole graph, then `S` is
-zero forcing.  This is the certificate-composition principle. -/
-theorem isZeroForcing_of_forceSequence {G : SimpleGraph V} {S T : Finset V}
-    (hST : ReflTransGen (ForceStep G) S T) (hT : IsZeroForcing G T) :
-    IsZeroForcing G S := by
-  exact hST.trans hT
 
 /-- The zero forcing number is attained by an actual zero forcing set. -/
 
