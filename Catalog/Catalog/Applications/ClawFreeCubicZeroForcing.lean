import Mathlib

/-!
# Claw-free cubic graphs and zero forcing

A finite-set formalization of the color-change rule, together with structural
and extremal results used in the study of claw-free cubic graphs.
-/

open Relation

namespace ClawFreeCubicZeroForcing

variable {V : Type*} [Fintype V] [DecidableEq V]

/-- One legal zero-forcing move: a colored vertex `u` has exactly one
uncolored neighbor `w`, which is then added to the colored set. -/
def ForceStep (G : SimpleGraph V) (S T : Finset V) : Prop :=
  ∃ u ∈ S, ∃ w ∉ S, G.Adj u w ∧
    (∀ z, G.Adj u z → z ∉ S → z = w) ∧ T = insert w S

/-- A set is zero forcing when finitely many legal color changes color every vertex. -/
def IsZeroForcing (G : SimpleGraph V) (S : Finset V) : Prop :=
  ReflTransGen (ForceStep G) S Finset.univ

/-- The zero forcing number, defined as the least size of a zero forcing set. -/
noncomputable def zeroForcingNumber (G : SimpleGraph V) : ℕ := by
  classical
  exact Finset.min' (Finset.image Finset.card (Finset.univ.filter (IsZeroForcing G)))
    (by
      refine ⟨Fintype.card V, ?_⟩
      simp only [Finset.mem_image, Finset.mem_filter, Finset.mem_univ, true_and]
      exact ⟨Finset.univ, ReflTransGen.refl, Finset.card_univ⟩)

omit [Fintype V] in
/-- Every forcing move adds exactly one new colored vertex. -/
theorem card_forceStep {G : SimpleGraph V} {S T : Finset V}
    (h : ForceStep G S T) : T.card = S.card + 1 := by
  obtain ⟨ u, hu, w, hw, h₁, h₂, rfl ⟩ := h; rw [ Finset.card_insert_of_notMem ] ; aesop;

omit [Fintype V] in
/-- A legal forcing process never loses a colored vertex. -/
theorem subset_of_forceStep {G : SimpleGraph V} {S T : Finset V}
    (h : ForceStep G S T) : S ⊆ T := by
  obtain ⟨ u, hu, w, hw, h₁, h₂, rfl ⟩ := h; aesop;

omit [Fintype V] in
/-- Along any finite sequence of legal forces, the colored set only grows. -/
theorem subset_of_forceSequence {G : SimpleGraph V} {S T : Finset V}
    (h : ReflTransGen (ForceStep G) S T) : S ⊆ T := by
  induction h;
  · rfl;
  · exact Finset.Subset.trans ‹_› ( subset_of_forceStep ‹_› )

omit [Fintype V] in
/-- Consequently, cardinality is monotone along a forcing sequence. -/
theorem card_le_of_forceSequence {G : SimpleGraph V} {S T : Finset V}
    (h : ReflTransGen (ForceStep G) S T) : S.card ≤ T.card := by
  exact Finset.card_le_card (subset_of_forceSequence h)

omit [Fintype V] in
/-- A forcing sequence whose endpoints have equal size made no net progress. -/
theorem eq_of_forceSequence_of_card_eq {G : SimpleGraph V} {S T : Finset V}
    (h : ReflTransGen (ForceStep G) S T) (hcard : S.card = T.card) : S = T := by
  exact Finset.eq_of_subset_of_card_le ( subset_of_forceSequence h ) hcard.ge

omit [Fintype V] in
/-- The reachability relation generated by legal forcing moves is antisymmetric. -/
theorem forceSequence_antisymm {G : SimpleGraph V} {S T : Finset V}
    (hST : ReflTransGen (ForceStep G) S T)
    (hTS : ReflTransGen (ForceStep G) T S) : S = T := by
  apply eq_of_forceSequence_of_card_eq hST;
  exact le_antisymm ( card_le_of_forceSequence hST ) ( card_le_of_forceSequence hTS )

/-- If `S` can force `T` and `T` can force the whole graph, then `S` is
zero forcing.  This is the certificate-composition principle. -/
theorem isZeroForcing_of_forceSequence {G : SimpleGraph V} {S T : Finset V}
    (hST : ReflTransGen (ForceStep G) S T) (hT : IsZeroForcing G T) :
    IsZeroForcing G S := by
  exact hST.trans hT

/-- The zero forcing number is attained by an actual zero forcing set. -/
theorem exists_minimal_zeroForcing_set (G : SimpleGraph V) :
    ∃ S : Finset V, IsZeroForcing G S ∧ S.card = zeroForcingNumber G := by
  convert Finset.min'_mem _ _;
  convert Iff.rfl;
  convert Finset.mem_image;
  aesop

/-- A zero forcing certificate gives the expected upper bound on the zero forcing number. -/
theorem zeroForcingNumber_le {G : SimpleGraph V} {S : Finset V}
    (hS : IsZeroForcing G S) : zeroForcingNumber G ≤ S.card := by
  apply Finset.min'_le;
  aesop

/-- Coloring all vertices except `w` is zero forcing as soon as `w` has a neighbor. -/
theorem coSingleton_isZeroForcing (G : SimpleGraph V) (w u : V) (huw : G.Adj u w) :
    IsZeroForcing G (Finset.univ.erase w) := by
  convert ReflTransGen.single _;
  use u;
  aesop

/-- A graph without isolated vertices has zero forcing number at most `|V|-1`.
This applies in particular to every nonempty cubic graph. -/
theorem zeroForcingNumber_le_card_sub_one (G : SimpleGraph V)
    (hneighbor : ∀ w : V, ∃ u, G.Adj u w) (w : V) :
    zeroForcingNumber G ≤ Fintype.card V - 1 := by
  obtain ⟨ u, hu ⟩ := hneighbor w;
  convert zeroForcingNumber_le ( coSingleton_isZeroForcing G w u hu ) using 1;
  grind

/-- In a complete graph, any legal force starts with all but one vertex colored. -/
theorem card_eq_card_sub_one_of_complete_forceStep {S T : Finset V}
    (h : ForceStep (⊤ : SimpleGraph V) S T) :
    S.card = Fintype.card V - 1 := by
  obtain ⟨u, huS, w, hwS, h_adj, h_unique, rfl⟩ := h;
  have h_univ : Finset.univ = S ∪ {w} := by
    grind +suggestions;
  rw [ ← Finset.card_univ, h_univ, Finset.card_union ] ; aesop

/-- Every zero forcing set of a complete graph has at least all but one vertex. -/
theorem complete_zeroForcing_card_lower {S : Finset V}
    (hS : IsZeroForcing (⊤ : SimpleGraph V) S) :
    Fintype.card V - 1 ≤ S.card := by
  contrapose! hS; simp_all +decide [ IsZeroForcing ] ;
  intro h_trans; have := h_trans; exact absurd ( this.cases_head ) ( by
    rintro ( rfl | ⟨ T, hT₁, hT₂ ⟩ ) <;> [ simp_all +decide ; exact absurd ( card_eq_card_sub_one_of_complete_forceStep hT₁ ) ( by omega ) ];
    exact Nat.not_lt_of_ge ( Nat.sub_le _ _ ) hS ) ;

/-- The zero forcing number of a nontrivial finite complete graph is `|V| - 1`. -/
theorem zeroForcingNumber_complete [Nontrivial V] :
    zeroForcingNumber (⊤ : SimpleGraph V) = Fintype.card V - 1 := by
  refine' le_antisymm ( zeroForcingNumber_le_card_sub_one ⊤ _ _ ) ( _ );
  · exact fun w => by obtain ⟨ u, hu ⟩ := exists_ne w; exact ⟨ u, by aesop ⟩ ;
  · exact Classical.arbitrary V;
  · obtain ⟨ S, hS₁, hS₂ ⟩ := exists_minimal_zeroForcing_set ( ⊤ : SimpleGraph V ) ; exact hS₂ ▸ complete_zeroForcing_card_lower hS₁;

/-- `ClawFree G` says that no vertex has three distinct, pairwise nonadjacent neighbors. -/
def ClawFree (G : SimpleGraph V) : Prop :=
  ∀ ⦃v a b c : V⦄,
    G.Adj v a → G.Adj v b → G.Adj v c →
    a ≠ b → a ≠ c → b ≠ c →
    G.Adj a b ∨ G.Adj a c ∨ G.Adj b c

/-- Cubicity expressed by cardinality of each finite neighbor set. -/
def Cubic (G : SimpleGraph V) : Prop :=
  ∀ v, (G.neighborSet v).ncard = 3

omit [Fintype V] [DecidableEq V] in
/-- The basic local structure behind claw-free cubic graph decompositions:
every vertex lies in a triangle. -/
theorem exists_triangle_through_vertex (G : SimpleGraph V)
    (hclaw : ClawFree G) (hcubic : Cubic G) (v : V) :
    ∃ a b, G.Adj v a ∧ G.Adj v b ∧ G.Adj a b := by
  obtain ⟨a, b, c, ha, hb, hc, habc⟩ : ∃ a b c : V, a ∈ G.neighborSet v ∧ b ∈ G.neighborSet v ∧ c ∈ G.neighborSet v ∧ a ≠ b ∧ a ≠ c ∧ b ≠ c := by
    have := hcubic v;
    obtain ⟨ a, b, c, h ⟩ := Set.ncard_eq_three.mp this; use a, b, c; aesop;
  have := hclaw ha hb hc habc.1 habc.2.1 habc.2.2; aesop;

/-- Consequently every claw-free cubic graph has no isolated vertices and obeys
the elementary zero-forcing bound `Z(G) ≤ |V|-1`. -/
theorem clawFree_cubic_zeroForcing_bound (G : SimpleGraph V)
    (hclaw : ClawFree G) (hcubic : Cubic G) (v : V) :
    zeroForcingNumber G ≤ Fintype.card V - 1 := by
  apply zeroForcingNumber_le_card_sub_one G _ v
  intro w
  obtain ⟨a, b, hwa, hwb, hab⟩ :=
    exists_triangle_through_vertex G hclaw hcubic w
  exact ⟨a, hwa.symm⟩

end ClawFreeCubicZeroForcing