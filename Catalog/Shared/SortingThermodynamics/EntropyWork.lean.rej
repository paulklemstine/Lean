 /-!
 # Sorting: decision-tree entropy, reversible history, and Landauer work
@@ -19,6 +18,73 @@
 open Function
 
 namespace SortingEntropyWork
+
+/-- The abstract sorting map on orderings: all input permutations have the same
+sorted output. -/
+def sortingFunction (n : ℕ) : Equiv.Perm (Fin n) → Unit := fun _ => ()
+
+/-- Information lost by a map between finite state spaces, in base-two units. -/
+noncomputable def infoErased {α β : Type*} [Fintype α] [Fintype β]
+    [DecidableEq β] (f : α → β) : ℝ :=
+  Real.logb 2 (Fintype.card α) -
+    Real.logb 2 (Finset.card (Finset.image f Finset.univ))
+
+/-- Landauer work associated with erasing a specified amount of information. -/
+noncomputable def landauerCost (kT bitsErased : ℝ) : ℝ :=
+  kT * Real.log 2 * bitsErased
+
+/-- Landauer work associated with the information loss of a finite map. -/
+noncomputable def landauerGap {α β : Type*} [Fintype α] [Fintype β]
+    [DecidableEq β] (f : α → β) (kT : ℝ) : ℝ :=
+  landauerCost kT (infoErased f)
+
+/-- The abstract sorting map erases exactly the base-two logarithm of `n!`.
+This includes `n = 0`, whose permutation space and factorial both have size one. -/
+theorem sorting_info_erased (n : ℕ) :
+    infoErased (sortingFunction n) = Real.logb 2 n.factorial := by
+  unfold infoErased sortingFunction
+  rw [Fintype.card_perm, Fintype.card_fin, Finset.image_const]
+  · simp
+  · exact Finset.univ_nonempty
+
+/-- Any product-form reversible implementation of abstract sorting has at least
+`n!` possible history values. -/
+theorem sorting_history_lower_bound (n : ℕ) (Aux : Type*) [Fintype Aux]
+    (e : Equiv.Perm (Fin n) ≃ Unit × Aux) :
+    n.factorial ≤ Fintype.card Aux := by
+  rw [← show Fintype.card (Equiv.Perm (Fin n)) = n.factorial by
+    simp [Fintype.card_perm]]
+  exact Fintype.card_le_of_injective (fun σ => (e σ).2) (by
+    intro σ τ h
+    apply e.injective
+    exact Prod.ext (Subsingleton.elim _ _) h)
+
+/-- An explicit reversible realization of sorting: retain the complete input
+permutation as history beside the sorted `Unit` output. -/
+def reversibleSorting (n : ℕ) :
+    Equiv.Perm (Fin n) ≃ Unit × Equiv.Perm (Fin n) :=
+  (Equiv.punitProd _).symm
+
+/-- The reversible realization computes the same visible sorting output. -/
+theorem reversibleSorting_consistent (n : ℕ) :
+    ∀ σ, (reversibleSorting n σ).1 = sortingFunction n σ := by
+  intro σ
+  rfl
+
+/-- Every equivalence between finite state spaces erases zero information. -/
+theorem equivalence_info_erased_zero {α β : Type*} [Fintype α] [Fintype β]
+    [DecidableEq β] (e : α ≃ β) : infoErased e = 0 := by
+  unfold infoErased
+  rw [Finset.image_univ_of_surjective e.surjective, Finset.card_univ,
+    Fintype.card_congr e]
+  ring
+
+/-- The reversible sorting realization has zero Landauer gap: keeping the history
+prevents the many-to-one information loss of the visible sorting map. -/
+theorem reversible_sorting_landauer_gap_zero (n : ℕ) (kT : ℝ) :
+    landauerGap (reversibleSorting n) kT = 0 := by
+  rw [landauerGap, equivalence_info_erased_zero]
+  simp [landauerCost]
 
