import Mathlib
import Bridges.BerggrenTrees.BerggrenPythagoreanCore

/-!
# The Berggren tree as a `GL(2, ℤ)` object: the Euclid lift

The Berggren generators `bergA`, `bergB`, `bergC` (see
`Bridges.BerggrenTrees.BerggrenPythagoreanCore`) act on Pythagorean triples, i.e. on the
null cone of the Lorentz form of signature `(2,1)`.  Since `SO(2,1) ≅ PGL(2,ℝ)`, every such
generator must be the *second symmetric power* of a `2 × 2` integer matrix acting on the
Euclid parameters `(m, n) ↦ (m² - n², 2mn, m² + n²)`.

This file constructs that lift explicitly:

* `U₁ = !![2,-1;1,0]`, `U₂ = !![2,1;1,0]`, `U₃ = !![1,2;0,1]`;
* `euclid_U₁`, `euclid_U₂`, `euclid_U₃`: the lift intertwines the `GL(2,ℤ)`-action on
  parameters with the Berggren action on triples;
* `detU₁`, `detU₂`, `detU₃`: the determinant pattern `(+1, -1, +1)` matching the catalog's
  `det_asymmetry` for the `3 × 3` Berggren matrices;
* the two structural elements of the Berggren group: the *elliptic* `S = U₃⁻¹U₁` of order `4`
  (`S_order_four`) and the *reflection* `R = U₁⁻¹U₂` of order `2`;
* `berggrenGroup`, the subgroup of `GL(2,ℤ)` generated by the three lifted generators.

Everything downstream (braid obstruction, non-universality, silver spectrum, depth bounds)
is phrased in terms of this lift.
-/

namespace BerggrenTQC

open Matrix

/-! ## The three lifted generators -/

/-- Lift of the Berggren generator `A` to the Euclid parameter plane. -/
def U₁ : Matrix (Fin 2) (Fin 2) ℤ := !![2, -1; 1, 0]

/-- Lift of the Berggren generator `B` to the Euclid parameter plane. -/
def U₂ : Matrix (Fin 2) (Fin 2) ℤ := !![2, 1; 1, 0]

/-- Lift of the Berggren generator `C` to the Euclid parameter plane. -/
def U₃ : Matrix (Fin 2) (Fin 2) ℤ := !![1, 2; 0, 1]

/-- The linear action of a `2 × 2` integer matrix on a Euclid parameter pair. -/
def act (M : Matrix (Fin 2) (Fin 2) ℤ) (v : ℤ × ℤ) : ℤ × ℤ :=
  (M 0 0 * v.1 + M 0 1 * v.2, M 1 0 * v.1 + M 1 1 * v.2)

@[simp] theorem act_U₁ (m n : ℤ) : act U₁ (m, n) = (2 * m - n, m) := by
  simp [act, U₁]; ring

@[simp] theorem act_U₂ (m n : ℤ) : act U₂ (m, n) = (2 * m + n, m) := by
  simp [act, U₂]

@[simp] theorem act_U₃ (m n : ℤ) : act U₃ (m, n) = (m + 2 * n, n) := by
  simp [act, U₃]

theorem act_mul (M N : Matrix (Fin 2) (Fin 2) ℤ) (v : ℤ × ℤ) :
    act (M * N) v = act M (act N v) := by
  simp [act, Matrix.mul_apply, Fin.sum_univ_two]
  constructor <;> ring

/-! ## The lift intertwines the two actions -/

theorem euclid_U₁ (m n : ℤ) :
    euclid (act U₁ (m, n)).1 (act U₁ (m, n)).2 =
      bergA (euclid m n).1 (euclid m n).2.1 (euclid m n).2.2 := by
  simp only [act_U₁, euclid, bergA, Prod.mk.injEq]
  refine ⟨by ring, by ring, by ring⟩

theorem euclid_U₂ (m n : ℤ) :
    euclid (act U₂ (m, n)).1 (act U₂ (m, n)).2 =
      bergB (euclid m n).1 (euclid m n).2.1 (euclid m n).2.2 := by
  simp only [act_U₂, euclid, bergB, Prod.mk.injEq]
  refine ⟨by ring, by ring, by ring⟩

theorem euclid_U₃ (m n : ℤ) :
    euclid (act U₃ (m, n)).1 (act U₃ (m, n)).2 =
      bergC (euclid m n).1 (euclid m n).2.1 (euclid m n).2.2 := by
  simp only [act_U₃, euclid, bergC, Prod.mk.injEq]
  refine ⟨by ring, by ring, by ring⟩

/-- The `2 × 2` lift attached to a Berggren step. -/
def lift : BerggrenStep → Matrix (Fin 2) (Fin 2) ℤ
  | .A => U₁
  | .B => U₂
  | .C => U₃

/-- Uniform form of the intertwining statement: every Berggren step is the second symmetric
power of the corresponding `2 × 2` lift. -/
theorem euclid_step (s : BerggrenStep) (m n : ℤ) :
    euclid (act (lift s) (m, n)).1 (act (lift s) (m, n)).2 = applyStep s (euclid m n) := by
  cases s
  · simpa [applyStep, lift, euclid] using euclid_U₁ m n
  · simpa [applyStep, lift, euclid] using euclid_U₂ m n
  · simpa [applyStep, lift, euclid] using euclid_U₃ m n

/-! ## Determinants: the `(+1, -1, +1)` pattern -/

theorem detU₁ : U₁.det = 1 := by simp [U₁, Matrix.det_fin_two_of]

theorem detU₂ : U₂.det = -1 := by simp [U₂, Matrix.det_fin_two_of]

theorem detU₃ : U₃.det = 1 := by simp [U₃, Matrix.det_fin_two_of]

/-- The lifted determinant pattern reproduces the catalog's `det_asymmetry` for the `3 × 3`
Berggren matrices: `B₂` is the orientation-reversing generator. -/
theorem det_pattern : U₁.det = 1 ∧ U₂.det = -1 ∧ U₃.det = 1 := ⟨detU₁, detU₂, detU₃⟩

/-! ## Structural elements: an elliptic element of order 4 and a reflection -/

/-- The elliptic element `S = U₃⁻¹U₁` of the Berggren group. -/
def Selt : Matrix (Fin 2) (Fin 2) ℤ := !![0, -1; 1, 0]

/-- The reflection `R = U₁⁻¹U₂` of the Berggren group. -/
def Relt : Matrix (Fin 2) (Fin 2) ℤ := !![1, 0; 0, -1]

theorem U₃_mul_S : U₃ * Selt = U₁ := by decide

theorem U₁_mul_R : U₁ * Relt = U₂ := by decide

/-- `S` has order `4`: the Berggren group contains a `ℤ/4` of elliptic elements. -/
theorem S_order_four : Selt * Selt * (Selt * Selt) = 1 ∧ Selt * Selt ≠ 1 :=
  ⟨by decide, by decide⟩

/-- `R` is an involution. -/
theorem R_involution : Relt * Relt = 1 := by decide

/-! ## The Berggren group inside `GL(2, ℤ)` -/

/-- `U₁` as a unit of the matrix ring. -/
def g₁ : (Matrix (Fin 2) (Fin 2) ℤ)ˣ :=
  ⟨U₁, !![0, 1; -1, 2], by decide, by decide⟩

/-- `U₂` as a unit of the matrix ring. -/
def g₂ : (Matrix (Fin 2) (Fin 2) ℤ)ˣ :=
  ⟨U₂, !![0, 1; 1, -2], by decide, by decide⟩

/-- `U₃` as a unit of the matrix ring. -/
def g₃ : (Matrix (Fin 2) (Fin 2) ℤ)ˣ :=
  ⟨U₃, !![1, -2; 0, 1], by decide, by decide⟩

/-- The **Berggren group**: the subgroup of `GL(2, ℤ)` generated by the three lifted
Berggren generators. -/
def berggrenGroup : Subgroup (Matrix (Fin 2) (Fin 2) ℤ)ˣ :=
  Subgroup.closure {g₁, g₂, g₃}

theorem g₁_mem : g₁ ∈ berggrenGroup := Subgroup.subset_closure (by simp)

theorem g₂_mem : g₂ ∈ berggrenGroup := Subgroup.subset_closure (by simp)

theorem g₃_mem : g₃ ∈ berggrenGroup := Subgroup.subset_closure (by simp)

end BerggrenTQC