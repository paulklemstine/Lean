/-
Machine-checked: the norm and value identities, and the Jacobian reduction.

Companion to `DimensionalClosure.lean` and `RelationWitness.lean`.  This file closes the
loop on the algebra of the round-47 relation construction for the cubic
`f = X^3 - c` (i.e. `P = 0`, `Q = -c`), so that every algebraic claim behind
`Round47_EllipticReduction.md` is discharged over `Z` rather than asserted:

1. the cone is rational and the parametrisation is `g = (-2u^2, -2uv, v^2)`;
2. `l(m) = v^4 * A(t)` with `A(t) = 4t^4 + 8mt^3 - 4ct + mc` -- so `l(m)` is an integer
   square exactly when `A(u/v)` is a rational square, which is what makes the relation
   space a CURVE rather than a surface;
3. `Norm(g) = v^6 * B(t)` with `B(t) = c^2 - 20ct^3 - 8t^6` -- and `v^6` is a perfect cube,
   so the entire smoothness burden of an NFS relation is on `B(t)`, a degree-6 polynomial
   value rather than a freely varying integer.  This is the step that made the measured
   "1 of 12 generated relations is smooth" unsurprising rather than surprising;
4. the Jacobian of that quartic is `Y^2 = x^3 - 3(mc)x + c^2 + m^3 c`, machine-checked
   from the general long-Weierstrass form `Y^2 = V^2 + UW`.

All proofs are `ring`; none is `decide`, since these are polynomial identities in four
variables and evaluation would not terminate usefully.

An earlier draft of (2) mis-scaled `l(m)` by `v^2` in the constant term.  `ring` caught it.
-/

import Mathlib.Tactic.Ring

namespace Cryptography.FactoringBarriers.RelationAlgebra

set_option linter.unusedVariables false

/-! ## 1 — the cone and its parametrisation, for `f = X^3 - c` -/

/-- `g = (-2u^2, -2uv, v^2)` lies on `g1^2 + 2 g0 g2 = 0`, i.e. `g^2` has no `alpha^2`
component, so `l(alpha) = g^2` is linear. -/
theorem cone_p0 (u v : ℤ) : (-2 * u * v) ^ 2 + 2 * (-2 * u ^ 2) * v ^ 2 = 0 := by ring

/-- The `alpha^1` and `alpha^0` components of `g^2` modulo `X^3 - c`.  At `P = 0` the
`a^1` component is `2 g0 g1 + c g2^2` and the `a^0` component is `g0^2 + 2c g1 g2`. -/
theorem comp1_p0 (c u v : ℤ) :
    2 * (-2 * u ^ 2) * (-2 * u * v) + c * v ^ 4 = 8 * u ^ 3 * v + c * v ^ 4 := by ring

theorem comp0_p0 (c u v : ℤ) :
    (-2 * u ^ 2) ^ 2 + 2 * c * (-2 * u * v) * v ^ 2 = 4 * u ^ 4 - 4 * c * u * v ^ 3 := by ring

/-! ## 2 — `l(m) = v^4 * A(t)`, the statement that makes the locus a curve -/

/-- The quartic.  `l(m)` is an integer square iff `A(u/v)` is a rational square, and
`A` has degree `4`, so `{ l(m) = square }` is a double cover of `P^1`. -/
def A (m c u v : ℤ) : ℤ := 4 * u ^ 4 + 8 * m * u ^ 3 * v - 4 * c * u * v ^ 3 + m * c * v ^ 4

theorem A_homogeneous (m c : ℤ) (k u v : ℤ) : A m c (k * u) (k * v) = k ^ 4 * A m c u v := by
  unfold A
  ring

theorem A_degree_four (m c : ℤ) : A m c 1 0 = 4 := by
  unfold A
  ring

/-- **`l(m) = v^4 * A(u,v)`** under the cone parametrisation. -/
theorem lm_eq (m c u v : ℤ) :
    (8 * u ^ 3 * v + c * v ^ 4) * m + (4 * u ^ 4 - 4 * c * u * v ^ 3) = A m c u v := by
  unfold A
  ring

/-! ## 3 — the norm, and why the smoothness burden is all on `B(t)` -/

/-- `Norm(g) = g0^3 + c g1^3 + c^2 g2^3 - 3c g0 g1 g2` for `alpha^3 = c`.  (From
`x^3 + y^3 + z^3 - 3xyz` with `x = g0`, `y = g1 alpha`, `z = g2 alpha^2`.) -/
theorem norm_p0 (c u v : ℤ) :
    (-2 * u ^ 2) ^ 3 + c * (-2 * u * v) ^ 3 + c ^ 2 * (v ^ 2) ^ 3
      - 3 * c * (-2 * u ^ 2) * (-2 * u * v) * v ^ 2
      = -8 * u ^ 6 - 20 * c * u ^ 3 * v ^ 3 + c ^ 2 * v ^ 6 := by
  ring

/-- **`Norm(g) = v^6 * B(t)`** with `B` a degree-6 form.  Since `v^6` is a perfect cube it
is automatically smooth for every `B`-smoothness bound, so *all* of the smoothness burden
on an NFS relation generated by this construction sits on the polynomial value `B(t)`. -/
def B (c u v : ℤ) : ℤ := c ^ 2 * v ^ 6 - 20 * c * u ^ 3 * v ^ 3 - 8 * u ^ 6

theorem B_homogeneous (c : ℤ) (k u v : ℤ) : B c (k * u) (k * v) = k ^ 6 * B c u v := by
  unfold B
  ring

theorem norm_eq (c u v : ℤ) :
    (-2 * u ^ 2) ^ 3 + c * (-2 * u * v) ^ 3 + c ^ 2 * (v ^ 2) ^ 3
      - 3 * c * (-2 * u ^ 2) * (-2 * u * v) * v ^ 2
      = B c u v := by
  unfold B
  ring

/-- `B` really is degree `6`, not lower: the `u^6` coefficient is `-8`. -/
theorem B_degree_six (c : ℤ) : B c 1 0 = -8 := by
  unfold B
  ring

/-! ## 4 — the Jacobian, from the general form to round 47's -/

-- The general cubic relation condition's Jacobian is in long Weierstrass form
-- `Y^2 = V^2 + UW`, with U, V, W as below.  Stated over Q because V and W carry
-- denominators 2 and 8 and `/` on Z is truncated.

/-- The same quantities over `Q`, where `/` is exact division.  (Over `Z`, `/` is
TRUNCATED, so `x^2 / 2` is not a polynomial expression at all and the undivided
statement is not even true.  This is why the Jacobian identity is proved over `Q` and
the others over `Z`.) -/
def JUq (m P x : ℚ) : ℚ := 2 * x - 2 * m ^ 2 - P
def JVq (m P Q x : ℚ) : ℚ := m * x + m * P / 2 + Q
def JWq (m P Q x : ℚ) : ℚ := x ^ 2 / 2 - P ^ 2 / 8 + m * Q / 2

/-- **At `P = 0`, `Q = -c`, `V^2 + UW` is exactly `x^3 - 3(mc)x + c^2 + m^3 c`.**  This is
the identity that makes `E` the Jacobian of the relation curve rather than an unrelated
elliptic curve. -/
theorem jacobian_reduces (m c x : ℚ) :
    JVq m 0 (-c) x ^ 2 + JUq m 0 x * JWq m 0 (-c) x
      = x ^ 3 - 3 * m * c * x + c ^ 2 + m ^ 3 * c := by
  unfold JVq
  unfold JUq
  unfold JWq
  ring

/-- **The record's own Jacobian point, machine-checked.**  For `m = 20`, `c = 2`,
`P = 0`, `Q = -2`, the quartic's Jacobian is `Y^2 = X^3 - 120X + 16004` and the point
`(X, Y) = (56, 430)` lies on it.  `X = 56` is the image of the record's quartic point
`t = 1, y = 14` under `X = y + 2t^2 + 2mt`, so this ties the machine check back to the
hand-verified witness in `Round46_Handover.md` section 7d. -/
theorem record_jacobian_point :
    (430 : ℚ) ^ 2 = (56 : ℚ) ^ 3 - 120 * 56 + 16004 := by ring

/-- ... and the same point satisfies the long-Weierstrass form `V^2 + UW` it came from. -/
theorem record_point_in_long_form :
    JVq 20 0 (-2 : ℚ) 56 ^ 2 + JUq 20 0 56 * JWq 20 0 (-2 : ℚ) 56 = 430 ^ 2 := by
  unfold JVq
  unfold JUq
  unfold JWq
  ring

end Cryptography.FactoringBarriers.RelationAlgebra
