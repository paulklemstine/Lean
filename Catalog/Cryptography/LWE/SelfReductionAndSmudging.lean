import Mathlib
import Cryptography.LWE.SearchDecisionCore

/-!
# Three Exact Ingredients of the LWE Hardness Argument

Regev's worst-case-to-average-case programme for Learning with Errors is
assembled from a small number of *exact* statistical facts.  Three of them are
proved here, each with no slack.

1. **Noise smudging (flooding).**  Adding a bounded shift `c` to noise drawn
   uniformly from a window of `N` consecutive integers moves the distribution by
   exactly `2c/N` in `ℓ¹`.  This is the mechanism by which a large noise term
   hides a small secret-dependent offset (`smudging_l1_eq`,
   `smudging_l1_le_of_ratio`).

2. **Random self-reducibility of the LWE secret.**  Shifting the secret by a
   uniformly random `t` and correcting the samples turns *any* fixed secret into
   a uniformly random one.  Consequently the success probability of the
   rerandomised solver is the *global average* over secrets, identically for
   every starting secret (`lwe_selfReduction_average`).  This is exactly the
   statement that average-case LWE (uniform secret) is as hard as LWE with an
   adversarially chosen secret.

3. **Exact regularity of `⟨a, s⟩`, for an arbitrary modulus.**  The map
   `a ↦ ⟨a, s⟩` on `ℤ_qⁿ` is surjective precisely when the coordinates of `s`
   generate the unit ideal of `ℤ_q` (`dotHom_surjective_iff_span_top`); when
   they do, `⟨a, s⟩` is *perfectly* uniform — every value has exactly `q^{n-1}`
   preimages (`dot_fiber_card_general`, `dotProduct_uniform_general`).  The
   familiar prime-modulus statement (`s ≠ 0` suffices) drops out as a corollary.
   Over a composite modulus the criterion is genuinely weaker than "some
   coordinate is a unit": `s = (2, 3)` over `ℤ₆` has no unit coordinate yet is
   regular.  This is the reason the `b` component of an LWE sample carries no
   information beyond the noise, and the uniformity engine used inside
   search-to-decision hybrids.

## Main results

* `LWEReduction.smudging_l1_eq` — `ℓ¹` distance of a shifted uniform window is
  exactly `2c/N`.
* `LWEReduction.smudging_l1_le_of_ratio` — the usable form: distance `≤ ε` once
  `2c ≤ εN`.
* `LWEReduction.lwe_shift_secret` — the sample-level secret-shift identity.
* `LWEReduction.lwe_shift_bijective` — secret shifting is a bijection of the
  sample space.
* `LWEReduction.lwe_selfReduction_average` — worst-case secret success equals
  the average-case success.
* `LWEReduction.sum_comp_addHom` — a surjective group homomorphism has
  equinumerous fibers, so pushforward sums factor.
* `LWEReduction.dot_mem_span_iff` — the achievable inner products are exactly
  the ideal generated by the coordinates of the secret.
* `LWEReduction.dotHom_surjective_iff_span_top` — the arbitrary-modulus
  regularity criterion.
* `LWEReduction.dot_fiber_card_general` / `dotProduct_uniform_general` — exact
  uniformity of `⟨a, s⟩` for an arbitrary modulus.
* `LWEReduction.dot_fiber_card_eq`, `dotProduct_uniform`,
  `dotProduct_uniform_prob` — the prime-modulus corollaries.

## References

* Regev, "On Lattices, Learning with Errors, Random Linear Codes, and
  Cryptography", STOC 2005 / JACM 2009.
* Applebaum, Cash, Peikert, Sahai, "Fast Cryptographic Primitives and
  Circular-Secure Encryption Based on Hard Learning Problems", CRYPTO 2009.
-/

open Finset BigOperators Matrix

noncomputable section

namespace LWEReduction

/-! ## Section 1: Noise smudging -/

/-- The uniform probability mass on a finite set of integers (here indexed by
`ℕ`, i.e. a window of consecutive noise values). -/
def unifMass (S : Finset ℕ) (x : ℕ) : ℝ := if x ∈ S then 1 / (S.card : ℝ) else 0

/-- **Smudging lemma, exact form.**  Let the noise be uniform on the window
`{0, …, N-1}` and let it be shifted by `c ≤ N`.  Then the `ℓ¹` distance between
the shifted and unshifted noise distributions is *exactly* `2c/N`.

In particular a secret-dependent offset of size `c` is hidden to within `2c/N`,
which is negligible as soon as the noise window is superpolynomially wider than
the offset. -/
theorem smudging_l1_eq (N c : ℕ) (hN : 0 < N) (hcN : c ≤ N) :
    ∑ x ∈ Finset.Ico 0 (N + c),
      |unifMass (Finset.Ico 0 N) x - unifMass (Finset.Ico c (N + c)) x|
      = 2 * c / N := by
  have hcard1 : ((Finset.Ico 0 N).card : ℝ) = N := by rw [Nat.card_Ico]; simp
  have hcard2 : ((Finset.Ico c (N + c)).card : ℝ) = N := by rw [Nat.card_Ico]; simp
  have hNr : (N : ℝ) ≠ 0 := by positivity
  rw [← Finset.sum_Ico_consecutive _ (Nat.zero_le c) (by omega : c ≤ N + c),
    ← Finset.sum_Ico_consecutive _ hcN (by omega : N ≤ N + c)]
  have h1 : ∑ x ∈ Finset.Ico 0 c,
      |unifMass (Finset.Ico 0 N) x - unifMass (Finset.Ico c (N + c)) x|
      = (c : ℝ) * (1 / (N : ℝ)) := by
    have hterm : ∀ x ∈ Finset.Ico 0 c,
        |unifMass (Finset.Ico 0 N) x - unifMass (Finset.Ico c (N + c)) x| = 1 / (N : ℝ) := by
      intro x hx
      simp only [Finset.mem_Ico] at hx
      have hx1 : x ∈ Finset.Ico 0 N := Finset.mem_Ico.mpr ⟨by omega, by omega⟩
      have hx2 : x ∉ Finset.Ico c (N + c) := by simp only [Finset.mem_Ico]; omega
      rw [unifMass, unifMass, if_pos hx1, if_neg hx2, hcard1, sub_zero,
        abs_of_nonneg (by positivity)]
    rw [Finset.sum_congr rfl hterm, Finset.sum_const, Nat.card_Ico, nsmul_eq_mul]
    simp
  have h2 : ∑ x ∈ Finset.Ico c N,
      |unifMass (Finset.Ico 0 N) x - unifMass (Finset.Ico c (N + c)) x| = 0 := by
    refine Finset.sum_eq_zero fun x hx => ?_
    simp only [Finset.mem_Ico] at hx
    have hx1 : x ∈ Finset.Ico 0 N := Finset.mem_Ico.mpr ⟨by omega, by omega⟩
    have hx2 : x ∈ Finset.Ico c (N + c) := Finset.mem_Ico.mpr ⟨by omega, by omega⟩
    rw [unifMass, unifMass, if_pos hx1, if_pos hx2, hcard1, hcard2, sub_self, abs_zero]
  have h3 : ∑ x ∈ Finset.Ico N (N + c),
      |unifMass (Finset.Ico 0 N) x - unifMass (Finset.Ico c (N + c)) x|
      = (c : ℝ) * (1 / (N : ℝ)) := by
    have hterm : ∀ x ∈ Finset.Ico N (N + c),
        |unifMass (Finset.Ico 0 N) x - unifMass (Finset.Ico c (N + c)) x| = 1 / (N : ℝ) := by
      intro x hx
      simp only [Finset.mem_Ico] at hx
      have hx1 : x ∉ Finset.Ico 0 N := by simp only [Finset.mem_Ico]; omega
      have hx2 : x ∈ Finset.Ico c (N + c) := Finset.mem_Ico.mpr ⟨by omega, by omega⟩
      rw [unifMass, unifMass, if_neg hx1, if_pos hx2, hcard2, zero_sub, abs_neg,
        abs_of_nonneg (by positivity)]
    rw [Finset.sum_congr rfl hterm, Finset.sum_const, Nat.card_Ico, nsmul_eq_mul]
    simp
  rw [h1, h2, h3]
  field_simp
  ring

/-- **Usable smudging bound.**  If the offset is small relative to the noise
window, `2c ≤ εN`, then the shift is `ε`-hidden. -/
theorem smudging_l1_le_of_ratio (N c : ℕ) (hN : 0 < N) (hcN : c ≤ N) (ε : ℝ)
    (hratio : 2 * (c : ℝ) ≤ ε * N) :
    ∑ x ∈ Finset.Ico 0 (N + c),
      |unifMass (Finset.Ico 0 N) x - unifMass (Finset.Ico c (N + c)) x| ≤ ε := by
  rw [smudging_l1_eq N c hN hcN]
  have hNr : (0 : ℝ) < N := by exact_mod_cast hN
  rw [div_le_iff₀ hNr]
  linarith

/-! ## Section 2: Random self-reducibility of the LWE secret -/

variable {n q : ℕ}

/-- An LWE sample value `b = ⟨a, s⟩ + e`. -/
def lweSample (a s : Fin n → ZMod q) (e : ZMod q) : ZMod q := a ⬝ᵥ s + e

/-- **Secret shift identity.**  Adding `⟨a, t⟩` to a sample for secret `s`
produces exactly a sample for secret `s + t`, with the *same* error.  The
rerandomisation is therefore error-preserving. -/
theorem lwe_shift_secret (a s t : Fin n → ZMod q) (e : ZMod q) :
    lweSample a s e + a ⬝ᵥ t = lweSample a (s + t) e := by
  simp only [lweSample, dotProduct_add]
  ring

/-- **Secret shifting is a bijection of the sample space.**  Hence it maps the
uniform distribution on samples to itself, and LWE instances for secret `s` to
LWE instances for secret `s + t` reversibly. -/
theorem lwe_shift_bijective (t : Fin n → ZMod q) :
    Function.Bijective
      (fun p : (Fin n → ZMod q) × ZMod q => (p.1, p.2 + p.1 ⬝ᵥ t)) := by
  constructor
  · rintro ⟨a₁, b₁⟩ ⟨a₂, b₂⟩ h
    simp only [Prod.mk.injEq] at h
    obtain ⟨ha, hb⟩ := h
    subst ha
    simp only [add_left_inj] at hb
    simp [hb]
  · rintro ⟨a, b⟩
    exact ⟨(a, b - a ⬝ᵥ t), by simp⟩

/-- **Random self-reducibility.**  For any success functional `succ` on secrets,
the average success of the rerandomised solver started at secret `s` — namely
the average of `succ (s + t)` over a uniform shift `t` — is the *global* average
of `succ`, independently of `s`.

Concretely: worst-case-secret LWE is no harder than uniform-secret LWE. -/
theorem lwe_selfReduction_average [NeZero q] (succ : (Fin n → ZMod q) → ℝ)
    (s : Fin n → ZMod q) :
    ∑ t : Fin n → ZMod q, succ (s + t) = ∑ s' : Fin n → ZMod q, succ s' :=
  Equiv.sum_comp (Equiv.addLeft s) succ

/-- The averaged form: the mean success over a uniformly random shift equals the
mean success over a uniformly random secret, for every starting secret. -/
theorem lwe_selfReduction_mean [NeZero q] (succ : (Fin n → ZMod q) → ℝ)
    (s : Fin n → ZMod q) :
    (∑ t : Fin n → ZMod q, succ (s + t)) / (Fintype.card (Fin n → ZMod q) : ℝ)
      = (∑ s' : Fin n → ZMod q, succ s') / (Fintype.card (Fin n → ZMod q) : ℝ) := by
  rw [lwe_selfReduction_average succ s]

/-! ## Section 3: Exact regularity of the inner product `⟨a, s⟩` -/

/-- All fibers of a surjective homomorphism of finite abelian groups have the
same cardinality. -/
theorem fiber_card_const {G H : Type*} [Fintype G] [DecidableEq G] [Fintype H] [DecidableEq H]
    [AddCommGroup G] [AddCommGroup H] (φ : G →+ H) (y : H) (a0 : G) (ha0 : φ a0 = y) :
    #{a : G | φ a = y} = #{a : G | φ a = 0} := by
  refine Finset.card_nbij' (fun a => a - a0) (fun b => b + a0) ?_ ?_ ?_ ?_
  · intro a ha
    simp only [Finset.coe_filter, Set.mem_setOf_eq, Finset.mem_univ, true_and] at ha ⊢
    simp [map_sub, ha, ha0]
  · intro b hb
    simp only [Finset.coe_filter, Set.mem_setOf_eq, Finset.mem_univ, true_and] at hb ⊢
    simp [map_add, hb, ha0]
  · intro a _; simp
  · intro b _; simp

/-- **Pushforward of a sum along a surjective homomorphism.**  Summing a
statistic of `φ a` over all `a` is the same as summing over the target, weighted
by the (constant) fiber size. -/
theorem sum_comp_addHom {G H : Type*} [Fintype G] [DecidableEq G] [Fintype H] [DecidableEq H]
    [AddCommGroup G] [AddCommGroup H] (φ : G →+ H) (hsurj : Function.Surjective φ)
    (f : H → ℝ) :
    ∑ a : G, f (φ a) = (#{a : G | φ a = 0} : ℝ) * ∑ y : H, f y := by
  classical
  have h := Finset.sum_fiberwise (Finset.univ : Finset G) (fun a => φ a) (fun a => f (φ a))
  rw [← h, Finset.mul_sum]
  refine Finset.sum_congr rfl fun y _ => ?_
  obtain ⟨a0, ha0⟩ := hsurj y
  have hc : #{a ∈ (Finset.univ : Finset G) | φ a = y} = #{a : G | φ a = 0} :=
    fiber_card_const φ y a0 ha0
  rw [Finset.sum_congr rfl (fun a ha => by
    simp only [Finset.mem_filter] at ha
    rw [ha.2]), Finset.sum_const, hc, nsmul_eq_mul]

/-- The inner product with a fixed secret, as a group homomorphism. -/
def dotHom {p n : ℕ} (s : Fin n → ZMod p) : (Fin n → ZMod p) →+ ZMod p where
  toFun a := a ⬝ᵥ s
  map_zero' := by simp
  map_add' a b := by simp [add_dotProduct]

/-- For a prime modulus, a nonzero secret makes `a ↦ ⟨a, s⟩` surjective. -/
theorem dotHom_surjective {p n : ℕ} [Fact (Nat.Prime p)] (s : Fin n → ZMod p) (hs : s ≠ 0) :
    Function.Surjective (dotHom s) := by
  obtain ⟨i, hi⟩ : ∃ i, s i ≠ 0 := by
    by_contra hc
    push_neg at hc
    exact hs (funext hc)
  intro y
  refine ⟨fun j => if j = i then y * (s i)⁻¹ else 0, ?_⟩
  simp only [dotHom, AddMonoidHom.coe_mk, ZeroHom.coe_mk, dotProduct]
  rw [Finset.sum_eq_single i]
  · rw [if_pos rfl]; field_simp
  · intro b _ hb; simp [hb]
  · intro hc; exact absurd (Finset.mem_univ i) hc

/-! ### Arbitrary modulus: the ideal criterion -/

/-- The set of achievable inner products `⟨a, s⟩` is exactly the ideal generated
by the coordinates of the secret. -/
theorem dot_mem_span_iff {q n : ℕ} (s : Fin n → ZMod q) (y : ZMod q) :
    (∃ a, a ⬝ᵥ s = y) ↔ y ∈ Ideal.span (Set.range s) := by
  rw [Ideal.span, Submodule.mem_span_range_iff_exists_fun]
  simp [dotProduct, smul_eq_mul]

/-- **Regularity criterion for an arbitrary modulus.**  The inner product map
`a ↦ ⟨a, s⟩` is surjective iff the coordinates of the secret generate the unit
ideal of `ℤ_q`.  Over a prime modulus this reduces to `s ≠ 0`, but over a
composite modulus it is genuinely weaker: `s = (2, 3)` over `ℤ₆` has no unit
coordinate and yet `2·2 + 1·3 = 1`, so it generates `⊤`. -/
theorem dotHom_surjective_iff_span_top {q n : ℕ} (s : Fin n → ZMod q) :
    Function.Surjective (dotHom s) ↔ Ideal.span (Set.range s) = ⊤ := by
  constructor
  · intro h
    rw [Ideal.eq_top_iff_one]
    exact (dot_mem_span_iff s 1).mp (h 1)
  · intro h y
    exact (dot_mem_span_iff s y).mpr (h ▸ Submodule.mem_top)

/-- A single unit coordinate already forces regularity. -/
theorem dotHom_surjective_of_isUnit {q n : ℕ} (s : Fin n → ZMod q) (i : Fin n)
    (hi : IsUnit (s i)) : Function.Surjective (dotHom s) := by
  rw [dotHom_surjective_iff_span_top]
  exact Ideal.eq_top_of_isUnit_mem _ (Ideal.subset_span ⟨i, rfl⟩) hi

/-- **Exact kernel count, arbitrary modulus.**  Whenever `a ↦ ⟨a, s⟩` is
surjective, exactly `q^{n-1}` of the `q^n` vectors `a` satisfy `⟨a, s⟩ = 0`. -/
theorem dot_kernel_card_general {q n : ℕ} [NeZero q] (hn : 0 < n)
    (s : Fin n → ZMod q) (hsurj : Function.Surjective (dotHom s)) :
    #{a : Fin n → ZMod q | dotHom s a = 0} = q ^ (n - 1) := by
  set k := #{a : Fin n → ZMod q | dotHom s a = 0} with hk
  have hone := sum_comp_addHom (dotHom s) hsurj (fun _ => (1 : ℝ))
  simp only [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, mul_one] at hone
  have hcardG : (Fintype.card (Fin n → ZMod q)) = q ^ n := by
    rw [Fintype.card_fun, ZMod.card, Fintype.card_fin]
  have hcardH : (Fintype.card (ZMod q)) = q := ZMod.card q
  rw [hcardG, hcardH] at hone
  have hnat : q ^ n = k * q := by exact_mod_cast hone
  have hpow : q ^ n = q ^ (n - 1) * q := by
    rw [← pow_succ]
    congr 1
    omega
  have hq0 : 0 < q := Nat.pos_of_ne_zero (NeZero.ne q)
  have hmul : k * q = q ^ (n - 1) * q := by omega
  exact Nat.eq_of_mul_eq_mul_right hq0 hmul

/-- **Exact regularity, arbitrary modulus.**  Every value of `⟨a, s⟩` has exactly
`q^{n-1}` preimages, provided the secret generates the unit ideal. -/
theorem dot_fiber_card_general {q n : ℕ} [NeZero q] (hn : 0 < n)
    (s : Fin n → ZMod q) (hsurj : Function.Surjective (dotHom s)) (y : ZMod q) :
    #{a : Fin n → ZMod q | a ⬝ᵥ s = y} = q ^ (n - 1) := by
  obtain ⟨a0, ha0⟩ := hsurj y
  have h := fiber_card_const (dotHom s) y a0 ha0
  rw [← dot_kernel_card_general hn s hsurj, ← h]
  rfl

/-- **Exact uniformity of the inner product, arbitrary modulus.** -/
theorem dotProduct_uniform_general {q n : ℕ} [NeZero q] (hn : 0 < n)
    (s : Fin n → ZMod q) (hsurj : Function.Surjective (dotHom s)) (f : ZMod q → ℝ) :
    ∑ a : Fin n → ZMod q, f (a ⬝ᵥ s) = (q : ℝ) ^ (n - 1) * ∑ y : ZMod q, f y := by
  have h := sum_comp_addHom (dotHom s) hsurj f
  rw [dot_kernel_card_general hn s hsurj] at h
  simpa using h

/-! ### The prime-modulus case, as a corollary -/

/-- Every value is hit equally often: `#{a : ⟨a,s⟩ = y} = p^{n-1}`. -/
theorem dot_fiber_card_eq {p n : ℕ} [Fact (Nat.Prime p)] (hn : 0 < n)
    (s : Fin n → ZMod p) (hs : s ≠ 0) (y : ZMod p) :
    #{a : Fin n → ZMod p | a ⬝ᵥ s = y} = p ^ (n - 1) := by
  haveI : NeZero p := ⟨(Fact.out : Nat.Prime p).ne_zero⟩
  exact dot_fiber_card_general hn s (dotHom_surjective s hs) y

/-- **Exact regularity of the LWE inner product.**  For a prime modulus and any
nonzero secret `s`, the value `⟨a, s⟩` is perfectly uniform as `a` ranges over
`ℤ_pⁿ`: for every statistic `f`,

  `∑_a f(⟨a, s⟩) = p^{n-1} · ∑_y f(y)`. -/
theorem dotProduct_uniform {p n : ℕ} [Fact (Nat.Prime p)] (hn : 0 < n)
    (s : Fin n → ZMod p) (hs : s ≠ 0) (f : ZMod p → ℝ) :
    ∑ a : Fin n → ZMod p, f (a ⬝ᵥ s) = (p : ℝ) ^ (n - 1) * ∑ y : ZMod p, f y := by
  haveI : NeZero p := ⟨(Fact.out : Nat.Prime p).ne_zero⟩
  exact dotProduct_uniform_general hn s (dotHom_surjective s hs) f

/-- Probability form: the distribution of `⟨a, s⟩` for uniform `a` is exactly
the uniform distribution on `ℤ_p`. -/
theorem dotProduct_uniform_prob {p n : ℕ} [Fact (Nat.Prime p)] (hn : 0 < n)
    (s : Fin n → ZMod p) (hs : s ≠ 0) (f : ZMod p → ℝ) :
    (∑ a : Fin n → ZMod p, f (a ⬝ᵥ s)) / (p : ℝ) ^ n
      = (∑ y : ZMod p, f y) / (p : ℝ) := by
  have hp0 : (0 : ℝ) < p := by exact_mod_cast (Fact.out : Nat.Prime p).pos
  have hsplit : (p : ℝ) ^ n = (p : ℝ) ^ (n - 1) * p := by
    rw [← pow_succ]
    congr 1
    omega
  rw [dotProduct_uniform hn s hs f, hsplit]
  field_simp


/-- **Consequence for LWE samples.**  For a nonzero secret over a prime modulus,
the `b`-component `⟨a, s⟩ + e` of an LWE sample is uniform for every fixed error
`e`: the secret is perfectly masked by the uniform choice of `a`. -/
theorem lweSample_uniform {p n : ℕ} [Fact (Nat.Prime p)] (hn : 0 < n)
    (s : Fin n → ZMod p) (hs : s ≠ 0) (e : ZMod p) (f : ZMod p → ℝ) :
    ∑ a : Fin n → ZMod p, f (lweSample a s e) = (p : ℝ) ^ (n - 1) * ∑ y : ZMod p, f y := by
  have hshift : ∑ y : ZMod p, f (y + e) = ∑ y : ZMod p, f y :=
    Equiv.sum_comp (Equiv.addRight e) f
  have h := dotProduct_uniform hn s hs (fun y => f (y + e))
  simpa [lweSample, hshift] using h

end LWEReduction

end

