#print axioms LWEReduction.sum_comp_addHom
#print axioms LWEReduction.dotHom_surjective_iff_span_top
#print axioms LWEReduction.dot_fiber_card_general
#print axioms LWEReduction.dotProduct_uniform_general
#print axioms LWEReduction.dot_fiber_card_eq
#print axioms LWEReduction.dotProduct_uniform
#print axioms LWEReduction.lweSample_uniform