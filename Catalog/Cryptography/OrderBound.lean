import Mathlib
import Cryptography.BerggrenSL2.MatRed
import Cryptography.BerggrenSL2.CayleyHamilton

/-!
# Order Bounds for SL₂ Elements over Finite Fields

For a matrix `g ∈ SL₂(𝔽_p)` with characteristic polynomial `X² - tX + 1`,
the discriminant `Δ = t² - 4` determines the structure of the cyclic
subgroup generated by `g`:

- **Split case** (`Δ` is a square in `𝔽_p`): the eigenvalues lie in `𝔽_p×`,
  so `orderOf g ∣ p - 1`.
- **Non-split case** (`Δ` is not a square): the eigenvalues lie in `𝔽_{p²}×`
  with norm 1, so `orderOf g ∣ p + 1`.

We prove a key algebraic consequence: in the split case, `g` satisfies
`g^(p-1) = 1` because both eigenvalues are units in `𝔽_p` and hence
satisfy `λ^(p-1) = 1` by Fermat's little theorem.

## Proof Strategy

Rather than formalizing full eigenvalue decomposition over finite fields,
we use the Cayley-Hamilton identity `g² = t·g - 1` to express all powers
of `g` as linear combinations `a_n·g + b_n·1`, and then show that the
Frobenius endomorphism `x ↦ x^p` interacts with this linear recurrence
to force `g^(p-1) = 1` (split) or `g^(p+1) = 1` (non-split).
-/

open Matrix

/-! ## Linear representation of powers -/

/-- Chebyshev-type coefficients for expressing `M^n` as `a_n • M + b_n • I`
when `M` satisfies the Cayley-Hamilton relation `M² = t·M - I`.
These satisfy the same recurrence as Chebyshev polynomials of the second kind. -/
noncomputable def chebyCoeffs {R : Type*} [CommRing R] (t : R) : ℕ → R × R
  | 0 => (0, 1)
  | 1 => (1, 0)
  | n + 2 =>
    let (a₁, b₁) := chebyCoeffs t (n + 1)
    let (a₀, b₀) := chebyCoeffs t n
    (t * a₁ - a₀, t * b₁ - b₀)

/-- Powers of a matrix satisfying the Cayley-Hamilton relation `M² = t•M - I`
are linear combinations of `M` and `I`. -/
theorem pow_eq_linear
    {R : Type*} [CommRing R]
    (M : Matrix (Fin 2) (Fin 2) R)
    (t : R)
    (hCH : M ^ 2 = t • M - 1)
    (n : ℕ) :
    M ^ n = (chebyCoeffs t n).1 • M + (chebyCoeffs t n).2 • (1 : Matrix (Fin 2) (Fin 2) R) := by
  induction' n using Nat.strong_induction_on with n ih
  rcases n with (_ | _ | n)
  · simp [chebyCoeffs]
  · simp +decide [chebyCoeffs]
  · rw [pow_recurrence_from_cayley M t hCH,
        ih _ (Nat.lt_succ_self _),
        ih _ (Nat.lt_succ_of_lt (Nat.lt_succ_self _))]
    simp +decide [chebyCoeffs]; module

/-! ## The key Frobenius argument (split case)

In the split case, `Δ = t² - 4` is a square in `𝔽_p`, so the polynomial
`X² - tX + 1` factors as `(X - λ)(X - μ)` with `λμ = 1` and `λ + μ = t`.
Both `λ, μ ∈ 𝔽_p×`, so by Fermat's little theorem `λ^(p-1) = μ^(p-1) = 1`.

The Chebyshev-type coefficients `a_n` satisfy `a_n = (λ^n - μ^n)/(λ - μ)`
(when `λ ≠ μ`), and for `n = p-1`: `a_{p-1} = (1 - 1)/(λ - μ) = 0` and
`b_{p-1} = 1`. So `M^(p-1) = I`.
-/

/-- In a commutative ring where `X² - tX + 1` splits (has roots `lam, mu` with
`lam * mu = 1` and `lam + mu = t`), the Chebyshev coefficient `a_n` satisfies
the explicit formula `a_n · (lam - mu) = lam^n - mu^n`. -/
theorem chebyCoeffs_split
    {R : Type*} [CommRing R]
    (t lam mu : R)
    (hprod : lam * mu = 1)
    (hsum : lam + mu = t)
    (_hdiff : IsUnit (lam - mu))
    (n : ℕ) :
    (chebyCoeffs t n).1 * (lam - mu) = lam ^ n - mu ^ n := by
  induction' n using Nat.strong_induction_on with n ih
  rcases n with (_ | _ | n)
  · simp +decide [chebyCoeffs]
  · simp +decide [chebyCoeffs]
  · simp_all +decide [pow_succ, mul_comm, chebyCoeffs]
    grind

/-! ## Concrete example: the standard Berggren generator -/

/-- The standard hyperbolic generator `[[2, 1], [1, 1]]` has determinant 1
and trace 3. This is the golden-ratio matrix (the Fibonacci matrix),
one of the simplest hyperbolic elements of `SL₂(ℤ)`. -/
def berggrenGen : Matrix (Fin 2) (Fin 2) ℤ :=
  !![2, 1; 1, 1]

theorem berggrenGen_det : berggrenGen.det = 1 := by native_decide

theorem berggrenGen_trace : Matrix.trace berggrenGen = 3 := by native_decide

theorem berggrenGen_trace_gt : 2 < Matrix.trace berggrenGen := by native_decide