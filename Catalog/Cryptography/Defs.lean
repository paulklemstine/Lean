+---+--++-    expressing the commutativity of the two simple-root propagation
+---+--++-    operators on the dominant chamber. -/
+---+--++-def AdjacentFacetCompatible (D : TropDatum) : Prop :=
+---+--++-  ∀ a b : ℕ, D (a + 1, b + 1) + D (a, b) = D (a + 1, b) + D (a, b + 1)
+---+--++-
