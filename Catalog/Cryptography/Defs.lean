++-------------++theorem sort₃_of_dominant {a b c : ℤ} (h1 : a ≥ b) (h2 : b ≥ c) :
++-------------++    sort₃ a b c = (a, b, c) := by
++-------------++  simp only [sort₃, Prod.mk.injEq]; constructor <;> [skip; constructor] <;> omega
