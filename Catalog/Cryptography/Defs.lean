+-------++---++theorem toGL3Dom_of_dominant {a b c : ℤ} (h1 : a ≥ b) (h2 : b ≥ c) :
+-------++---++    toGL3Dom a b c = ⟨(a, b, c), h1, h2⟩ := by
+-------++---++  simp only [toGL3Dom]
+-------++---++  exact Subtype.ext (sort₃_of_dominant h1 h2)
