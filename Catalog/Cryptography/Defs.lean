++-------------++theorem sort₃_sum (a b c : ℤ) :
++-------------++    (sort₃ a b c).1 + (sort₃ a b c).2.1 + (sort₃ a b c).2.2 = a + b + c := by
++-------------++  simp only [sort₃]; omega
