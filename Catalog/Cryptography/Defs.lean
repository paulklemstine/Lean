----+-++++-+/-- Lift a support datum to a tropical Hecke function. -/
----+-++++-+def satakeExtendHecke (h : SupportDatum) : TropicalHeckeGL3 :=
----+-++++-+  ⟨satakeExtend h, satakeExtend_invariant h⟩
