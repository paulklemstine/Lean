+-+--+--@[ext]
+-+--+--structure TropHecke where
+-+--+--  /-- Generator coefficients along the first simple-coroot direction. -/
+-+--+--  edge1 : ℕ → ℝ
+-+--+--  /-- Generator coefficients along the second simple-coroot direction. -/
+-+--+--  edge2 : ℕ → ℝ
