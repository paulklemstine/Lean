+----+-+--+--+/-- Sort three integers into weakly decreasing order: (max, mid, min). -/
+----+-+--+--+def sort₃ (a b c : ℤ) : ℤ × ℤ × ℤ :=
+----+-+--+--+  (max a (max b c),
+----+-+--+--+   a + b + c - max a (max b c) - min a (min b c),
+----+-+--+--+   min a (min b c))
+----+-+--+--+
+----+-+--+--+theorem sort₃_fst_ge_snd (a b c : ℤ) : (sort₃ a b c).1 ≥ (sort₃ a b c).2.1 := by
+----+-+--+--+  simp only [sort₃]; omega
+----+-+--+--+
