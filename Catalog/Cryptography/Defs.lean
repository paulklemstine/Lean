-------+---+-/-- Bounded support: the datum vanishes above a given height. -/
-------+---+-def BoundedSupport (N : ℕ) (D : TropDatum) : Prop :=
-------+---+-  ∀ p : DomWt, N < p.1 + p.2 → D p = 0
