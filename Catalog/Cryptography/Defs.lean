+---+--++-    are independent of the first coordinate. This corresponds to the
+---+--++-    rank-2 Levi subgroup for the simple root α₂. -/
+---+--++-def Levi23Compatible (D : TropDatum) : Prop :=
+---+--++-  ∀ a b : ℕ, D (a, b + 1) - D (a, b) = D (0, b + 1) - D (0, b)
+---+--++-
