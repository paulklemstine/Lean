----+-++++-+/-- A tropical Hecke function for GL₃ is an S₃-invariant function ℤ³ → ℤ. -/
----+-++++-+def TropicalHeckeGL3 := { f : ℤ → ℤ → ℤ → ℤ // IsS3Invariant f }
