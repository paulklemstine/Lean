+------+--+-----/-- Bounded support for Hecke elements: both edge functions vanish beyond height N. -/
+------+--+-----def HeckeBoundedSupport (N : ℕ) (h : TropHecke) : Prop :=
+------+--+-----  (∀ a, N < a → h.edge1 a = 0) ∧ (∀ b, N < b → h.edge2 b = 0)
