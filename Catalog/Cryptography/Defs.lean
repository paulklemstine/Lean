------------+++def kthLargest {C : ℕ} (s : Fin C → ℝ) (k : ℕ) : ℝ :=
------------+++  if h : k < C then
------------+++    ((univ : Finset (Fin C)).powersetCard (k + 1)).sup'
------------+++      (powersetCard_univ_nonempty k h)
------------+++      (fun S => if hne : S.Nonempty then S.inf' hne s else 0)
------------+++  else 0
