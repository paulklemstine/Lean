+------+----++-    topkMargin' f x S hS hSc ≤ scoreGap f x i j := by
+------+----++-  apply Finset.min'_le
+------+----++-  simp only [crossGaps, Finset.mem_image, Finset.mem_product, finCompl,
+------+----++-    Finset.mem_filter, Finset.mem_univ, true_and]
