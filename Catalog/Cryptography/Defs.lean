--+--+++-+theorem s3_inv_eq_at_sort (f : ℤ → ℤ → ℤ → ℤ) (hf : IsS3Invariant f) (a b c : ℤ) :
--+--+++-+    f a b c = f (sort₃ a b c).1 (sort₃ a b c).2.1 (sort₃ a b c).2.2 := by
--+--+++-+  unfold sort₃; have := hf.1; have := hf.2; simp_all +decide [max_def, min_def] ;
