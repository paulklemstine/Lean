++------+-++/-! ## Dominant Coweights -/
++----+- -++theorem sort₃_cycle (a b c : ℤ) : sort₃ b c a = sort₃ a b c := by
++----+- -++  simp only [sort₃, Prod.mk.injEq]; constructor <;> [skip; constructor] <;> omega
