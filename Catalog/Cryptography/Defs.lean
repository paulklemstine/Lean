++-+----------++def GL3Dom := { μ : ℤ × ℤ × ℤ // μ.1 ≥ μ.2.1 ∧ μ.2.1 ≥ μ.2.2 }
++-+----------++
++-+----------++instance : DecidableEq GL3Dom := Subtype.instDecidableEq
