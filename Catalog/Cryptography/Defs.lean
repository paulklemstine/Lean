-------------+-/-- Height of a dominant coweight: `height(a, b) = a + b = λ₁`. -/
-------------+-def height (p : DomWt) : ℕ := p.1 + p.2
-----------+-++
----------- -++theorem sort₃_snd_ge_thd (a b c : ℤ) : (sort₃ a b c).2.1 ≥ (sort₃ a b c).2.2 := by
