+----------------++   by constructor <;> [linarith [μ.2.1, ν.2.1]; linarith [μ.2.2, ν.2.2]]⟩
+----------------++
+----------------++instance : Add GL3Dom := ⟨GL3Dom.add⟩
+----------------++
+----------------++@[simp] theorem GL3Dom.add_val (μ ν : GL3Dom) :
+----------------++    (μ + ν).1 = (μ.1.1 + ν.1.1, μ.1.2.1 + ν.1.2.1, μ.1.2.2 + ν.1.2.2) := rfl
+----------------++
