---------+-++  exact Subtype.ext (sort₃_swap12 a b c)
---------+-++
---------+-++/-- toGL3Dom is invariant under the 3-cycle. -/
---------+-++theorem toGL3Dom_cycle (a b c : ℤ) : toGL3Dom b c a = toGL3Dom a b c := by
