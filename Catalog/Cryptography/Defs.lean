------++++
------++++/-- toGL3Dom is invariant under transposition (12). -/
------++++theorem toGL3Dom_swap12 (a b c : ℤ) : toGL3Dom b a c = toGL3Dom a b c := by
------++++  exact Subtype.ext (sort₃_swap12 a b c)
