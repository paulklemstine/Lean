------------++-    (S : Finset (Fin n))
------------++-    (hS : S.Nonempty) (hSc : (finCompl S).Nonempty) :
------------++-    (crossGaps f x S).Nonempty := by
------------++-  rcases hS with ⟨i, hi⟩; rcases hSc with ⟨j, hj⟩
