++----+---++end GL3TropicalSatake++-/-- Positive top-k margin implies `StrictTopKSet`. -/
++----+--++-theorem strictTopKSet_of_pos_margin {α : Type*} {f : α → Fin n → ℝ} {x : α}
++----+--++-    {S : Finset (Fin n)}
++----+--++-    {hS : S.Nonempty} {hSc : (finCompl S).Nonempty}
++----+--++-    (hpos : 0 < topkMargin' f x S hS hSc) :
