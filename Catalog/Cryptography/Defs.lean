----+-+----+/-! ## Auxiliary lemmas for powersetCard -/
----+-+----+
----+-+----+/-- Nonemptiness of powersetCard when k+1 ≤ C -/
----+-+----+lemma powersetCard_univ_nonempty {C : ℕ} (k : ℕ) (h : k < C) :
----+-+----+    ((univ : Finset (Fin C)).powersetCard (k + 1)).Nonempty := by
