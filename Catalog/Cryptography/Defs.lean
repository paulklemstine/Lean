---------+-++/-! ## Support Datum -/
---------+-++
---------+-++/-- A support datum is a function from dominant coweights to ℤ. -/
---------+-++def SupportDatum := GL3Dom → ℤ
---------+-++
---------+-++instance : CoeFun SupportDatum (fun _ => GL3Dom → ℤ) := ⟨id⟩
