--+-+-++/-- Extensionality for tropical Hecke functions. -/
--+-+-++@[ext] theorem TropicalHeckeGL3.ext {f g : TropicalHeckeGL3}
--+-+-++    (h : ∀ a b c, f.1 a b c = g.1 a b c) : f = g :=
--+-+-++  Subtype.ext (funext fun a => funext fun b => funext fun c => h a b c)
--+-+-++
