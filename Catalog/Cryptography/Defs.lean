++-------------+---theorem topkMargin'_le_scoreGap {α : Type*} {f : α → Fin n → ℝ} {x : α}
++-------------+---    {S : Finset (Fin n)}
++-------------+---    {hS : S.Nonempty} {hSc : (finCompl S).Nonempty}
