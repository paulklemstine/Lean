import Cryptography.FHE.NoiseGauge
import Cryptography.FHE.RingLWE

/-!
# Exact noise accumulation in BGV/BFV homomorphic evaluation

This file develops the *quantitative* layer that the catalog file
`Cryptography.FHE.RingLWE` leaves abstract: it tracks the actual size of the
decryption noise through homomorphic addition, multiplication, relinearization
(key switching) and bootstrapping, and proves that a circuit decrypts correctly
whenever an explicitly computed noise bound stays below the decoding radius.

## The model

A ciphertext is a **polynomial in the secret key**: `c = c₀ + c₁ X + c₂ X² + …`
with *phase* `phase s c = c.eval s`.  This is the standard "extended
ciphertext" view: fresh BGV/BFV ciphertexts have degree `1`, and multiplication
of ciphertexts is exactly multiplication of these polynomials, so that

* `phase s (c + d) = phase s c + phase s d`,
* `phase s (c * d) = phase s c * phase s d`,

i.e. **the phase map is a ring homomorphism** (`phaseHom`).  Relinearization is
modelled as *any* map `relin` that changes the phase by a small element of the
ideal `(t)` generated by the plaintext modulus — exactly what BGV key switching
guarantees.  Correctness then splits into two independent obligations:

* an *algebraic* one: the phase, read modulo `t`, is the plaintext circuit value
  (`NoiseCkt.phase_eval_mod`), true at every noise level;
* an *analytic* one: the phase norm stays under the decoding radius
  (`NoiseCkt.noise_evalEnc_le`).

The main theorem `NoiseCkt.decrypt_evalEnc` combines them.

## Main results

* `phaseHom` — the phase is a ring homomorphism in the extended-ciphertext model,
  compatible with the two-component ciphertexts of `RingLWEFHE`.
* `bgv_mul_noise_exact` / `bgv_mul_noise_bound` — the exact BGV multiplication
  noise term `e·m' + m·e' + t·e·e'` and its gauge bound.
* `NoiseCkt.noise_evalEnc_le` — the master accumulation theorem: the noise of an
  evaluated circuit is bounded by the syntactically computed `noiseBound`.
* `NoiseCkt.phase_eval_mod` — relinearization never disturbs the plaintext.
* `NoiseCkt.decrypt_evalEnc` — full correctness of noisy homomorphic evaluation.
* `noiseBound_le_iter` — the doubly exponential depth bound
  `γ·N_d ≤ (γ·B)^(2^d)` in the relinearization-free regime, and
  `mulChain_noise_eq` showing that this bound is *attained* over `ℤ`.
-/

namespace FHENoise

open Polynomial

noncomputable section

variable {R : Type*} [CommRing R]

/-! ## 1. Ciphertexts as polynomials in the secret key -/

/-- An *extended ciphertext*: the tuple `(c₀, c₁, …)` viewed as a polynomial in
the secret key.  Fresh ciphertexts have degree ≤ 1. -/
abbrev Cipher (R : Type*) [CommRing R] := Polynomial R

/-- The phase (decryption function before decoding) of an extended ciphertext. -/
def phase (s : R) (c : Cipher R) : R := c.eval s

/-- The phase map is a ring homomorphism: this single fact is what makes
homomorphic addition and multiplication work at all. -/
def phaseHom (s : R) : Cipher R →+* R := Polynomial.evalRingHom s

@[simp] lemma phaseHom_apply (s : R) (c : Cipher R) : phaseHom s c = phase s c := rfl

@[simp] lemma phase_add (s : R) (c d : Cipher R) :
    phase s (c + d) = phase s c + phase s d := by
  simp [phase]

@[simp] lemma phase_C (s a : R) : phase s (C a) = a := by simp [phase]

@[simp] lemma phase_mul (s : R) (c d : Cipher R) :
    phase s (c * d) = phase s c * phase s d := by
  simp [phase]

/-- Embedding of the catalog's two-component ciphertexts `(a, b)` into the
extended model: `(a,b) ↦ b - a·X`. -/
def ofPair (c : RingLWEFHE.Ciphertext R) : Cipher R := C c.b - C c.a * X

/-- The extended-model phase of an embedded two-component ciphertext is the
catalog's phase `b - a·s`. -/
lemma phase_ofPair (s : R) (c : RingLWEFHE.Ciphertext R) :
    phase s (ofPair c) = RingLWEFHE.phase s c := by
  simp [phase, ofPair, RingLWEFHE.phase]

/-- The embedding is additive, matching `RingLWEFHE.addCipher`. -/
lemma ofPair_add (c d : RingLWEFHE.Ciphertext R) :
    ofPair (RingLWEFHE.addCipher c d) = ofPair c + ofPair d := by
  simp [ofPair, RingLWEFHE.addCipher, C_add]
  ring

/-! ## 2. Noise of a ciphertext relative to a gauge -/

variable (G : NoiseGauge R)

/-- The noise level of a ciphertext: the gauge size of its phase. -/
def noise (G : NoiseGauge R) (s : R) (c : Cipher R) : ℝ := G.nu (phase s c)

lemma noise_nonneg (s : R) (c : Cipher R) : 0 ≤ noise G s c := G.nu_nonneg _

/-- **Additive noise growth**: noise adds. -/
theorem noise_add_le (s : R) (c d : Cipher R) :
    noise G s (c + d) ≤ noise G s c + noise G s d := by
  simpa [noise] using G.nu_add_le (phase s c) (phase s d)

/-- **Multiplicative noise growth**: noise multiplies, up to the ring expansion
factor `γ`. -/
theorem noise_mul_le (s : R) (c d : Cipher R) :
    noise G s (c * d) ≤ G.gamma * noise G s c * noise G s d := by
  simpa [noise] using G.nu_mul_le (phase s c) (phase s d)

/-- **Key-switching / relinearization noise**: a degree-reduction map that
perturbs the phase by at most `D` raises the noise by at most `D`. -/
theorem noise_relin_le {D : ℝ} (s : R) (relin : Cipher R → Cipher R)
    (hrelin : ∀ c, G.nu (phase s (relin c) - phase s c) ≤ D) (c : Cipher R) :
    noise G s (relin c) ≤ noise G s c + D := by
  simp only [noise]
  exact le_trans (G.nu_le_of_sub _ _) (by linarith [hrelin c])

/-- Noise of a finite sum of ciphertexts (packed additions). -/
theorem noise_sum_le {ι : Type*} (s : R) (T : Finset ι) (f : ι → Cipher R) :
    noise G s (∑ i ∈ T, f i) ≤ ∑ i ∈ T, noise G s (f i) := by
  classical
  have hsum : phase s (∑ i ∈ T, f i) = ∑ i ∈ T, phase s (f i) := by
    simp [phase, Polynomial.eval_finset_sum]
  simpa [noise, hsum] using G.nu_sum_le T fun i => phase s (f i)

/-! ## 3. The exact BGV multiplication noise term -/

/-- **Exact BGV multiplication identity.**  If two phases are `m + t·e` and
`m' + t·e'`, the product phase is `m·m' + t·(e·m' + m·e' + t·e·e')`: the new
noise term is *exactly* `e·m' + m·e' + t·e·e'`. -/
theorem bgv_mul_noise_exact (t m e m' e' : R) :
    (m + t * e) * (m' + t * e') = m * m' + t * (e * m' + m * e' + t * (e * e')) := by
  ring

/-- Gauge bound for the exact BGV multiplication noise term.  The quadratic term
carries two factors of the expansion factor `γ`, which is the source of the
`γ²`-type blow-up in ring-based schemes. -/
theorem bgv_mul_noise_bound (t m e m' e' : R) {mu mu' eps eps' tau : ℝ}
    (hm : G.nu m ≤ mu) (hm' : G.nu m' ≤ mu') (he : G.nu e ≤ eps)
    (he' : G.nu e' ≤ eps') (ht : G.nu t ≤ tau) :
    G.nu (e * m' + m * e' + t * (e * e')) ≤
      G.gamma * (eps * mu' + mu * eps') + G.gamma ^ 2 * tau * (eps * eps') := by
  have hnn := G.nu_nonneg
  have h1 : G.nu (e * m') ≤ G.gamma * eps * mu' := G.nu_mul_le_bounds he hm'
  have h2 : G.nu (m * e') ≤ G.gamma * mu * eps' := G.nu_mul_le_bounds hm he'
  have hee : G.nu (e * e') ≤ G.gamma * eps * eps' := G.nu_mul_le_bounds he he'
  have h3 : G.nu (t * (e * e')) ≤ G.gamma * tau * (G.gamma * eps * eps') :=
    G.nu_mul_le_bounds ht hee
  have hsum := G.nu_add_le (e * m' + m * e') (t * (e * e'))
  have hsum2 := G.nu_add_le (e * m') (m * e')
  have hring1 : G.gamma * eps * mu' + G.gamma * mu * eps' =
      G.gamma * (eps * mu' + mu * eps') := by ring
  have hring2 : G.gamma * tau * (G.gamma * eps * eps') =
      G.gamma ^ 2 * tau * (eps * eps') := by ring
  linarith

/-! ## 4. Circuits, evaluation with relinearization, and the master bound -/

/-- Arithmetic circuits over ciphertext wires. -/
inductive NoiseCkt where
  | leaf : ℕ → NoiseCkt
  | add : NoiseCkt → NoiseCkt → NoiseCkt
  | mul : NoiseCkt → NoiseCkt → NoiseCkt
  deriving Inhabited

namespace NoiseCkt

/-- Multiplicative depth. -/
def mulDepth : NoiseCkt → ℕ
  | .leaf _ => 0
  | .add f g => max f.mulDepth g.mulDepth
  | .mul f g => max f.mulDepth g.mulDepth + 1

/-- Number of input wires (with multiplicity). -/
def leafCount : NoiseCkt → ℕ
  | .leaf _ => 1
  | .add f g => f.leafCount + g.leafCount
  | .mul f g => f.leafCount + g.leafCount

/-- Homomorphic evaluation: additions are free, multiplications are followed by
relinearization. -/
def evalEnc (relin : Cipher R → Cipher R) (rho : ℕ → Cipher R) : NoiseCkt → Cipher R
  | .leaf i => rho i
  | .add f g => f.evalEnc relin rho + g.evalEnc relin rho
  | .mul f g => relin (f.evalEnc relin rho * g.evalEnc relin rho)

/-- Plaintext semantics in an arbitrary commutative ring (used for the message
ring `R ⧸ (t)`). -/
def evalPlain {M : Type*} [CommRing M] (v : ℕ → M) : NoiseCkt → M
  | .leaf i => v i
  | .add f g => f.evalPlain v + g.evalPlain v
  | .mul f g => f.evalPlain v * g.evalPlain v

/-- The syntactic noise bound of a circuit: leaves contribute their own bound,
additions add, multiplications multiply (with the expansion factor) and pay the
relinearization surcharge `D`. -/
def noiseBound (gamma D : ℝ) (beta : ℕ → ℝ) : NoiseCkt → ℝ
  | .leaf i => beta i
  | .add f g => f.noiseBound gamma D beta + g.noiseBound gamma D beta
  | .mul f g => gamma * (f.noiseBound gamma D beta) * (g.noiseBound gamma D beta) + D

lemma noiseBound_nonneg {gamma D : ℝ} {beta : ℕ → ℝ} (hg : 0 ≤ gamma) (hD : 0 ≤ D)
    (hbeta : ∀ i, 0 ≤ beta i) : ∀ f : NoiseCkt, 0 ≤ f.noiseBound gamma D beta
  | .leaf i => hbeta i
  | .add f g => by
      have := noiseBound_nonneg hg hD hbeta f
      have := noiseBound_nonneg hg hD hbeta g
      simp only [noiseBound]; linarith
  | .mul f g => by
      have h1 := noiseBound_nonneg hg hD hbeta f
      have h2 := noiseBound_nonneg hg hD hbeta g
      have : 0 ≤ gamma * f.noiseBound gamma D beta * g.noiseBound gamma D beta :=
        mul_nonneg (mul_nonneg hg h1) h2
      simp only [noiseBound]; linarith

/-- Monotonicity of the syntactic bound in the leaf bounds. -/
lemma noiseBound_mono {gamma D : ℝ} {beta beta' : ℕ → ℝ} (hg : 0 ≤ gamma) (hD : 0 ≤ D)
    (hbeta : ∀ i, 0 ≤ beta i) (hle : ∀ i, beta i ≤ beta' i) :
    ∀ f : NoiseCkt, f.noiseBound gamma D beta ≤ f.noiseBound gamma D beta'
  | .leaf i => hle i
  | .add f g => by
      have := noiseBound_mono hg hD hbeta hle f
      have := noiseBound_mono hg hD hbeta hle g
      simp only [noiseBound]; linarith
  | .mul f g => by
      have h1 := noiseBound_mono hg hD hbeta hle f
      have h2 := noiseBound_mono hg hD hbeta hle g
      have p2 := noiseBound_nonneg hg hD hbeta g
      have hbeta' : ∀ i, 0 ≤ beta' i := fun i => le_trans (hbeta i) (hle i)
      have p1' := noiseBound_nonneg hg hD hbeta' f
      have hmm := mul_le_mul h1 h2 p2 p1'
      simp only [noiseBound]
      nlinarith [hmm, hg]

/-- **Master noise accumulation theorem.**  With leaf noises bounded by `β` and
a relinearization step of noise cost at most `D`, the noise after homomorphic
evaluation of any circuit is bounded by the syntactically computed
`noiseBound`. -/
theorem noise_evalEnc_le {D : ℝ} (G : NoiseGauge R) (s : R)
    (relin : Cipher R → Cipher R)
    (hrelin : ∀ c, G.nu (phase s (relin c) - phase s c) ≤ D)
    (rho : ℕ → Cipher R) (beta : ℕ → ℝ) (hleaf : ∀ i, noise G s (rho i) ≤ beta i) :
    ∀ f : NoiseCkt, noise G s (f.evalEnc relin rho) ≤ f.noiseBound G.gamma D beta
  | .leaf i => hleaf i
  | .add f g => by
      have h1 := noise_evalEnc_le G s relin hrelin rho beta hleaf f
      have h2 := noise_evalEnc_le G s relin hrelin rho beta hleaf g
      have := noise_add_le G s (f.evalEnc relin rho) (g.evalEnc relin rho)
      simp only [evalEnc, noiseBound]
      linarith
  | .mul f g => by
      have h1 := noise_evalEnc_le G s relin hrelin rho beta hleaf f
      have h2 := noise_evalEnc_le G s relin hrelin rho beta hleaf g
      have hprod := noise_mul_le G s (f.evalEnc relin rho) (g.evalEnc relin rho)
      have hrel := noise_relin_le G s relin hrelin
        (f.evalEnc relin rho * g.evalEnc relin rho)
      have n1 := noise_nonneg G s (f.evalEnc relin rho)
      have n2 := noise_nonneg G s (g.evalEnc relin rho)
      have hg := G.gamma_nonneg
      have hbf := noiseBound_nonneg hg (le_trans (G.nu_nonneg _) (hrelin 0))
        (fun i => le_trans (noise_nonneg G s (rho i)) (hleaf i)) f
      have hmm := mul_le_mul h1 h2 n2 hbf
      simp only [evalEnc, noiseBound]
      nlinarith [hmm, hg, hprod, hrel]

/-! ## 5. The algebraic layer: relinearization never disturbs the plaintext -/

/-- **Plaintext preservation.**  Let `φ : R →+* M` be the plaintext-extraction
homomorphism (in BGV, reduction modulo the plaintext modulus `t`).  If
relinearization changes phases only inside `ker φ`, then the phase of an
evaluated circuit carries exactly the plaintext circuit value — at *any* noise
level. -/
theorem phase_eval_mod {M : Type*} [CommRing M] (s : R) (pi : R →+* M)
    (relin : Cipher R → Cipher R)
    (hrelin : ∀ c, pi (phase s (relin c)) = pi (phase s c))
    (rho : ℕ → Cipher R) :
    ∀ f : NoiseCkt,
      pi (phase s (f.evalEnc relin rho)) = f.evalPlain (fun i => pi (phase s (rho i)))
  | .leaf i => rfl
  | .add f g => by
      simp only [evalEnc, evalPlain, phase_add, map_add,
        phase_eval_mod s pi relin hrelin rho f, phase_eval_mod s pi relin hrelin rho g]
  | .mul f g => by
      simp only [evalEnc, evalPlain, hrelin, phase_mul, map_mul,
        phase_eval_mod s pi relin hrelin rho f, phase_eval_mod s pi relin hrelin rho g]

/-- **Full correctness of noisy homomorphic evaluation.**  A decoder `dec` that
recovers the plaintext class from any phase of gauge size `< T` returns the
plaintext circuit value, provided the syntactic noise bound stays below `T`. -/
theorem decrypt_evalEnc {M : Type*} [CommRing M] {D T : ℝ} (G : NoiseGauge R) (s : R)
    (pi : R →+* M) (dec : R → M)
    (hdec : ∀ x, G.nu x < T → dec x = pi x)
    (relin : Cipher R → Cipher R)
    (hrelinN : ∀ c, G.nu (phase s (relin c) - phase s c) ≤ D)
    (hrelinP : ∀ c, pi (phase s (relin c)) = pi (phase s c))
    (rho : ℕ → Cipher R) (beta : ℕ → ℝ) (hleaf : ∀ i, noise G s (rho i) ≤ beta i)
    (f : NoiseCkt) (hbudget : f.noiseBound G.gamma D beta < T) :
    dec (phase s (f.evalEnc relin rho)) = f.evalPlain (fun i => pi (phase s (rho i))) := by
  have hnoise := noise_evalEnc_le G s relin hrelinN rho beta hleaf f
  rw [hdec _ (lt_of_le_of_lt hnoise hbudget)]
  exact phase_eval_mod s pi relin hrelinP rho f

/-! ## 5b. Modular composition of noise budgets -/

/-- Substitution of subcircuits into the input wires of a circuit. -/
def subst (f : NoiseCkt) (g : ℕ → NoiseCkt) : NoiseCkt :=
  match f with
  | .leaf i => g i
  | .add f₁ f₂ => .add (subst f₁ g) (subst f₂ g)
  | .mul f₁ f₂ => .mul (subst f₁ g) (subst f₂ g)

/-- Homomorphic evaluation respects substitution. -/
theorem evalEnc_subst (relin : Cipher R → Cipher R) (rho : ℕ → Cipher R)
    (g : ℕ → NoiseCkt) :
    ∀ f : NoiseCkt, (f.subst g).evalEnc relin rho
      = f.evalEnc relin (fun i => (g i).evalEnc relin rho)
  | .leaf i => rfl
  | .add f₁ f₂ => by
      simp only [subst, evalEnc, evalEnc_subst relin rho g f₁, evalEnc_subst relin rho g f₂]
  | .mul f₁ f₂ => by
      simp only [subst, evalEnc, evalEnc_subst relin rho g f₁, evalEnc_subst relin rho g f₂]

/-- **Compositionality of the noise budget.**  The budget of a substituted
circuit is the budget of the outer circuit evaluated on the budgets of the inner
ones: noise accounting is a fold over the circuit, so it composes exactly. -/
theorem noiseBound_subst (gamma D : ℝ) (beta : ℕ → ℝ) (g : ℕ → NoiseCkt) :
    ∀ f : NoiseCkt, (f.subst g).noiseBound gamma D beta
      = f.noiseBound gamma D (fun i => (g i).noiseBound gamma D beta)
  | .leaf i => rfl
  | .add f₁ f₂ => by
      simp only [subst, noiseBound, noiseBound_subst gamma D beta g f₁,
        noiseBound_subst gamma D beta g f₂]
  | .mul f₁ f₂ => by
      simp only [subst, noiseBound, noiseBound_subst gamma D beta g f₁,
        noiseBound_subst gamma D beta g f₂]

/-- Multiplicative depths add under substitution. -/
theorem mulDepth_subst_le (g : ℕ → NoiseCkt) (Dg : ℕ) (hg : ∀ i, (g i).mulDepth ≤ Dg) :
    ∀ f : NoiseCkt, (f.subst g).mulDepth ≤ f.mulDepth + Dg
  | .leaf i => by simpa [subst, mulDepth] using hg i
  | .add f₁ f₂ => by
      have h1 := mulDepth_subst_le g Dg hg f₁
      have h2 := mulDepth_subst_le g Dg hg f₂
      simp only [subst, mulDepth]
      omega
  | .mul f₁ f₂ => by
      have h1 := mulDepth_subst_le g Dg hg f₁
      have h2 := mulDepth_subst_le g Dg hg f₂
      simp only [subst, mulDepth]
      omega

end NoiseCkt

/-! ## 6. Depth: the doubly exponential bound and its sharpness -/

/-- The relinearization-free noise iteration: `x ↦ γ x²`, `d` times. -/
def iterNoise (gamma : ℝ) : ℕ → ℝ → ℝ
  | 0, x => x
  | (d + 1), x => gamma * (iterNoise gamma d x) ^ 2

/-- Closed form: `γ · iterNoise γ d x = (γ x)^(2^d)`.  The *normalized* noise is
raised to the power `2^d` at multiplicative depth `d`: noise growth is doubly
exponential in depth. -/
theorem gamma_iterNoise (gamma x : ℝ) :
    ∀ d : ℕ, gamma * iterNoise gamma d x = (gamma * x) ^ (2 ^ d)
  | 0 => by simp [iterNoise]
  | (d + 1) => by
      have ih := gamma_iterNoise gamma x d
      have hsq : gamma * (gamma * iterNoise gamma d x ^ 2) =
          (gamma * iterNoise gamma d x) ^ 2 := by ring
      rw [iterNoise, hsq, ih, ← pow_mul, pow_succ]

lemma iterNoise_nonneg {gamma : ℝ} (hg : 0 ≤ gamma) {x : ℝ} (hx : 0 ≤ x) :
    ∀ d, 0 ≤ iterNoise gamma d x
  | 0 => hx
  | (d + 1) => by
      have := iterNoise_nonneg hg hx d
      simp only [iterNoise]
      positivity

lemma one_le_iterNoise {gamma x : ℝ} (hg : 1 ≤ gamma) (hx : 1 ≤ x) :
    ∀ d, 1 ≤ iterNoise gamma d x
  | 0 => hx
  | (d + 1) => by
      have ih := one_le_iterNoise hg hx d
      simp only [iterNoise]
      nlinarith

lemma iterNoise_mono_input {gamma : ℝ} (hg : 0 ≤ gamma) {x y : ℝ} (hx : 0 ≤ x)
    (hxy : x ≤ y) : ∀ d, iterNoise gamma d x ≤ iterNoise gamma d y
  | 0 => hxy
  | (d + 1) => by
      have ih := iterNoise_mono_input hg hx hxy d
      have h0 := iterNoise_nonneg hg hx d
      have hsq := mul_self_le_mul_self h0 ih
      simp only [iterNoise]
      nlinarith [hsq, hg]

lemma iterNoise_mono_depth {gamma x : ℝ} (hg : 1 ≤ gamma) (hx : 1 ≤ x) :
    ∀ {d e : ℕ}, d ≤ e → iterNoise gamma d x ≤ iterNoise gamma e x := by
  intro d e hde
  induction e with
  | zero => simp_all
  | succ k ih =>
      rcases Nat.lt_or_ge d (k + 1) with h | h
      · have hk : d ≤ k := Nat.lt_succ_iff.mp h
        have h1 := ih hk
        have h2 := one_le_iterNoise hg hx k
        simp only [iterNoise]
        nlinarith
      · have : d = k + 1 := le_antisymm hde h
        subst this
        exact le_refl _

/-- The iteration is superadditive: splitting a noise budget between two
subcircuits never helps.  (Additions are therefore correctly charged to the
leaf count.) -/
lemma iterNoise_superadd {gamma : ℝ} (hg : 0 ≤ gamma) {x y : ℝ} (hx : 0 ≤ x) (hy : 0 ≤ y) :
    ∀ d, iterNoise gamma d x + iterNoise gamma d y ≤ iterNoise gamma d (x + y)
  | 0 => by simp [iterNoise]
  | (d + 1) => by
      have ih := iterNoise_superadd hg hx hy d
      have hx0 := iterNoise_nonneg hg hx d
      have hy0 := iterNoise_nonneg hg hy d
      have hxy0 := iterNoise_nonneg hg (by linarith : (0:ℝ) ≤ x + y) d
      have hsq := mul_self_le_mul_self (by linarith : (0:ℝ) ≤
        iterNoise gamma d x + iterNoise gamma d y) ih
      simp only [iterNoise]
      nlinarith [hsq, hg, mul_nonneg hx0 hy0]

namespace NoiseCkt

lemma one_le_leafCount (f : NoiseCkt) : 1 ≤ f.leafCount := by
  induction f with
  | leaf i => simp [leafCount]
  | add f g ihf ihg => simp only [leafCount]; omega
  | mul f g ihf ihg => simp only [leafCount]; omega

/-- **Depth–width noise bound.**  In the relinearization-free regime (`D = 0`)
a circuit with `L` leaves of noise at most `B ≥ 1` and multiplicative depth `d`
has noise at most `iterNoise γ d (L·B)`; equivalently, by `gamma_iterNoise`,
the normalized noise is at most `(γ L B)^(2^d)`. -/
theorem noiseBound_le_iter {gamma B : ℝ} (hg : 1 ≤ gamma) (hB : 1 ≤ B) :
    ∀ f : NoiseCkt,
      f.noiseBound gamma 0 (fun _ => B) ≤ iterNoise gamma f.mulDepth (f.leafCount * B)
  | .leaf i => by simp [noiseBound, leafCount, mulDepth, iterNoise]
  | .add f g => by
      have h1 := noiseBound_le_iter hg hB f
      have h2 := noiseBound_le_iter hg hB g
      have hg0 : (0:ℝ) ≤ gamma := by linarith
      have hLf : (1:ℝ) ≤ (f.leafCount : ℝ) * B := by
        have : (1:ℝ) ≤ (f.leafCount : ℝ) := by exact_mod_cast f.one_le_leafCount
        nlinarith
      have hLg : (1:ℝ) ≤ (g.leafCount : ℝ) * B := by
        have : (1:ℝ) ≤ (g.leafCount : ℝ) := by exact_mod_cast g.one_le_leafCount
        nlinarith
      have d1 : iterNoise gamma f.mulDepth ((f.leafCount : ℝ) * B) ≤
          iterNoise gamma (max f.mulDepth g.mulDepth) ((f.leafCount : ℝ) * B) :=
        iterNoise_mono_depth hg hLf (le_max_left _ _)
      have d2 : iterNoise gamma g.mulDepth ((g.leafCount : ℝ) * B) ≤
          iterNoise gamma (max f.mulDepth g.mulDepth) ((g.leafCount : ℝ) * B) :=
        iterNoise_mono_depth hg hLg (le_max_right _ _)
      have hsuper := iterNoise_superadd hg0 (by linarith : (0:ℝ) ≤ (f.leafCount : ℝ) * B)
        (by linarith : (0:ℝ) ≤ (g.leafCount : ℝ) * B) (max f.mulDepth g.mulDepth)
      have hcast : ((f.leafCount + g.leafCount : ℕ) : ℝ) * B =
          (f.leafCount : ℝ) * B + (g.leafCount : ℝ) * B := by push_cast; ring
      simp only [noiseBound, mulDepth, leafCount, hcast]
      linarith
  | .mul f g => by
      have h1 := noiseBound_le_iter hg hB f
      have h2 := noiseBound_le_iter hg hB g
      have hg0 : (0:ℝ) ≤ gamma := by linarith
      have hLf : (1:ℝ) ≤ (f.leafCount : ℝ) * B := by
        have : (1:ℝ) ≤ (f.leafCount : ℝ) := by exact_mod_cast f.one_le_leafCount
        nlinarith
      have hLg : (1:ℝ) ≤ (g.leafCount : ℝ) * B := by
        have : (1:ℝ) ≤ (g.leafCount : ℝ) := by exact_mod_cast g.one_le_leafCount
        nlinarith
      have hsumL : (1:ℝ) ≤ (f.leafCount : ℝ) * B + (g.leafCount : ℝ) * B := by linarith
      have d1 : iterNoise gamma f.mulDepth ((f.leafCount : ℝ) * B) ≤
          iterNoise gamma (max f.mulDepth g.mulDepth)
            ((f.leafCount : ℝ) * B + (g.leafCount : ℝ) * B) := by
        refine le_trans (iterNoise_mono_depth hg hLf (le_max_left f.mulDepth g.mulDepth)) ?_
        exact iterNoise_mono_input hg0 (by linarith) (by linarith) _
      have d2 : iterNoise gamma g.mulDepth ((g.leafCount : ℝ) * B) ≤
          iterNoise gamma (max f.mulDepth g.mulDepth)
            ((f.leafCount : ℝ) * B + (g.leafCount : ℝ) * B) := by
        refine le_trans (iterNoise_mono_depth hg hLg (le_max_right f.mulDepth g.mulDepth)) ?_
        exact iterNoise_mono_input hg0 (by linarith) (by linarith) _
      have p1 := noiseBound_nonneg hg0 (le_refl (0:ℝ))
        (fun _ => by linarith : ∀ _ : ℕ, (0:ℝ) ≤ B) f
      have p2 := noiseBound_nonneg hg0 (le_refl (0:ℝ))
        (fun _ => by linarith : ∀ _ : ℕ, (0:ℝ) ≤ B) g
      have hpos : 0 ≤ iterNoise gamma (max f.mulDepth g.mulDepth)
          ((f.leafCount : ℝ) * B + (g.leafCount : ℝ) * B) :=
        iterNoise_nonneg hg0 (by linarith) _
      have hcast : ((f.leafCount + g.leafCount : ℕ) : ℝ) * B =
          (f.leafCount : ℝ) * B + (g.leafCount : ℝ) * B := by push_cast; ring
      have hfX := le_trans h1 d1
      have hgX := le_trans h2 d2
      have hprod := mul_le_mul hfX hgX p2 hpos
      simp only [noiseBound, mulDepth, leafCount, hcast, iterNoise]
      nlinarith [hprod, hg0, hpos]

/-- The balanced squaring circuit of multiplicative depth `d`. -/
def sqChain : ℕ → NoiseCkt
  | 0 => .leaf 0
  | (d + 1) => .mul (sqChain d) (sqChain d)

@[simp] lemma sqChain_mulDepth : ∀ d, (sqChain d).mulDepth = d
  | 0 => rfl
  | (d + 1) => by simp [sqChain, mulDepth, sqChain_mulDepth d]

/-- **Sharpness of the doubly exponential bound.**  Over `ℤ` with the absolute
value gauge (`γ = 1`) and noiseless relinearization, the depth-`d` squaring
circuit applied to a ciphertext of phase `b` has noise *exactly* `|b|^(2^d)`.
Hence `noiseBound_le_iter` cannot be improved. -/
theorem sqChain_noise_eq (s b : ℤ) (rho : ℕ → Cipher ℤ) (hrho : phase s (rho 0) = b) :
    ∀ d, noise intGauge s ((sqChain d).evalEnc id rho) = |(b : ℝ)| ^ (2 ^ d)
  | 0 => by simp [sqChain, evalEnc, noise, hrho]
  | (d + 1) => by
      have ih := sqChain_noise_eq s b rho hrho d
      set x := phase s ((sqChain d).evalEnc id rho) with hxdef
      have hphase : phase s ((sqChain (d + 1)).evalEnc id rho) = x * x := by
        simp [sqChain, evalEnc, hxdef]
      have h2 : (2 : ℕ) ^ (d + 1) = 2 ^ d + 2 ^ d := by ring
      simp only [noise, hphase, intGauge_nu] at ih ⊢
      push_cast
      rw [abs_mul, ih, h2, pow_add]

end NoiseCkt

end

