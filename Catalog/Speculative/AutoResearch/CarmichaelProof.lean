-----------+----+-------+  | fuel + 1 =>
-----------+----+-------+    if m ≤ 1 then r
-----------+----+-------+    else
-----------+----+-------+      let g := Nat.gcd r m
-----------+----+-------+      if g ≤ 1 then r
-----------+----+-------+      else stripAllAux (r / g) m fuel
