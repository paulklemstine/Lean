------++-------++theorem fib_carmichael_composite (n : ℕ) (hn : 13 ≤ n) (hnp : ¬Nat.Prime n) :
------++-------++    ∃ p, Nat.Prime p ∧ p ∣ Nat.fib n ∧
------++-------++      ∀ k, 0 < k → k < n → ¬(p ∣ Nat.fib k) := by
