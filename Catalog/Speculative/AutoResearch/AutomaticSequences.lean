import Mathlib

/-!
# Automatic Sequences and the Decidability Boundary

## Overview

An automatic sequence is one generated by a Deterministic Finite Automaton with Output (DFAO).
We formalize DFAOs, the sequences they generate, and prove that fundamental decision problems
are decidable for automatic sequences—in stark contrast to the undecidability of the general
halting problem.

## Main Results

* `DFAO` — Deterministic Finite Automaton with Output
* `thueMorse` — The Thue-Morse sequence via binary digit sum parity
* `thueMorse_double` — t(2n) = t(n) (self-similar structure)
* `thueMorse_double_succ_ne` — t(2n+1) ≠ t(n) (complementation)
* `DFAO.sequence_range_finite` — The image of any DFAO sequence is finite
* `thueMorse_not_eventually_periodic` — Thue-Morse is not eventually periodic
* `eventually_periodic_implies_recurrence` — Cross-domain bridge to algebra
* `AlphabetMorphism.iterate_length_uniform` — Uniform morphism iterates grow as k^n
-/

open Finset Function

namespace AutomaticSequences

/-! ## Part 1: DFAO and Automatic Sequences -/

/-- A Deterministic Finite Automaton with Output (DFAO).
    `n` is the number of states, `k` is the alphabet size,
    `α` is the output type. -/
structure DFAO (n : ℕ) (k : ℕ) (α : Type*) where
  transition : Fin n → Fin k → Fin n
  initial : Fin n
  output : Fin n → α

variable {n k : ℕ} {α : Type*}

/-- Run a DFAO from a given state on a list of input symbols. -/
def DFAO.runFrom (M : DFAO n k α) (s : Fin n) : List (Fin k) → Fin n
  | [] => s
  | d :: ds => M.runFrom (M.transition s d) ds

/-- Run a DFAO from its initial state. -/
def DFAO.run (M : DFAO n k α) (input : List (Fin k)) : Fin n :=
  M.runFrom M.initial input

/-- The output of a DFAO on a given input. -/
def DFAO.eval (M : DFAO n k α) (input : List (Fin k)) : α :=
  M.output (M.run input)

@[simp]
theorem DFAO.runFrom_nil (M : DFAO n k α) (s : Fin n) :
    M.runFrom s [] = s := rfl

@[simp]
theorem DFAO.runFrom_singleton (M : DFAO n k α) (s : Fin n) (d : Fin k) :
    M.runFrom s [d] = M.transition s d := rfl

/-- `runFrom` on concatenation equals running sequentially. -/
theorem DFAO.runFrom_append (M : DFAO n k α) (s : Fin n)
    (xs ys : List (Fin k)) :
    M.runFrom s (xs ++ ys) = M.runFrom (M.runFrom s xs) ys := by
  induction xs generalizing s <;> aesop

/-! ## Part 2: Base-k Representation -/

/-- Convert a natural number to its base-k digit list (least significant digit first). -/
def toBaseK (k : ℕ) (hk : 2 ≤ k) : ℕ → List (Fin k)
  | 0 => []
  | m + 1 =>
    have h1 : (m + 1) / k < m + 1 := Nat.div_lt_self (by omega) (by omega)
    ⟨(m + 1) % k, Nat.mod_lt _ (by omega)⟩ :: toBaseK k hk ((m + 1) / k)

/-- The sequence generated by a DFAO on base-k representations. -/
def DFAO.sequence (M : DFAO n k α) (hk : 2 ≤ k) (m : ℕ) : α :=
  M.eval (toBaseK k hk m)

/-- A sequence is k-automatic if it is generated by some DFAO. -/
def IsKAutomatic (k : ℕ) (hk : 2 ≤ k) (seq : ℕ → α) : Prop :=
  ∃ (n : ℕ) (_ : 0 < n) (M : DFAO n k α), ∀ m, M.sequence hk m = seq m

/-! ## Part 3: The Thue-Morse Sequence -/

/-- Count 1-bits in the binary representation of n. -/
def bitSum : ℕ → ℕ
  | 0 => 0
  | m + 1 =>
    have : (m + 1) / 2 < m + 1 := Nat.div_lt_self (by omega) (by omega)
    ((m + 1) % 2) + bitSum ((m + 1) / 2)

/-- The Thue-Morse sequence: t(n) = popcount(n) mod 2. -/
def thueMorse (m : ℕ) : ℕ := bitSum m % 2

/-- The Thue-Morse sequence only takes values 0 and 1. -/
theorem thueMorse_bounded (m : ℕ) : thueMorse m = 0 ∨ thueMorse m = 1 :=
  Nat.mod_two_eq_zero_or_one _

/-
bitSum(2m) = bitSum(m).
-/
theorem bitSum_double (m : ℕ) : bitSum (2 * m) = bitSum m := by
  -- Consider two cases: $m = 0$ and $m > 0$.
  by_cases hm : m = 0;
  · aesop;
  · -- Since $m \neq 0$, we can write $m = n + 1$ for some $n$.
    obtain ⟨n, rfl⟩ : ∃ n, m = n + 1 := Nat.exists_eq_succ_of_ne_zero hm;
    rw [ show 2 * ( n + 1 ) = 2 * n + 2 by ring, bitSum ];
    norm_num [ Nat.add_mod, Nat.add_div ]

/-
bitSum(2m+1) = bitSum(m) + 1.
-/
theorem bitSum_double_succ (m : ℕ) : bitSum (2 * m + 1) = bitSum m + 1 := by
  rw [ bitSum ];
  grind

/-- t(2n) = t(n). -/
theorem thueMorse_double (m : ℕ) : thueMorse (2 * m) = thueMorse m := by
  simp [thueMorse, bitSum_double]

/-- t(2n+1) ≠ t(n). -/
theorem thueMorse_double_succ_ne (m : ℕ) : thueMorse (2 * m + 1) ≠ thueMorse m := by
  unfold thueMorse; rw [bitSum_double_succ]; omega

/-! ## Part 4: Reachability and Decidability -/

/-- A state is reachable if there exists an input reaching it from initial. -/
def DFAO.IsReachable (M : DFAO n k α) (s : Fin n) : Prop :=
  ∃ input : List (Fin k), M.runFrom M.initial input = s

/-- The initial state is reachable. -/
theorem DFAO.initial_reachable (M : DFAO n k α) : M.IsReachable M.initial :=
  ⟨[], rfl⟩

/-- Reachability is closed under transitions. -/
theorem DFAO.reachable_step (M : DFAO n k α) (s : Fin n) (d : Fin k)
    (h : M.IsReachable s) : M.IsReachable (M.transition s d) := by
  obtain ⟨input, hinput⟩ := h
  exact ⟨input ++ [d], by rw [DFAO.runFrom_append, hinput]; rfl⟩

/-- Running the DFAO on any toBaseK encoding produces a reachable state. -/
theorem DFAO.run_reachable (M : DFAO n k α) (hk : 2 ≤ k) (m : ℕ) :
    M.IsReachable (M.run (toBaseK k hk m)) :=
  ⟨_, rfl⟩

/-
**Finiteness of DFAO sequence range**: The image of any DFAO-generated sequence
    is contained in the finite image of the output function.
-/
theorem DFAO.sequence_range_finite (M : DFAO n k α) (hk : 2 ≤ k) :
    Set.Finite (Set.range (M.sequence hk)) := by
  -- The set of reachable states is finite, so the image of the output function on these states is also finite.
  have h_output_finite : Set.Finite (Set.image M.output {s : Fin n | M.IsReachable s}) := by
    exact Set.toFinite _;
  exact h_output_finite.subset fun x hx => by obtain ⟨ m, rfl ⟩ := hx; exact ⟨ _, DFAO.run_reachable M hk m, rfl ⟩ ;

/-
Any value in the sequence is an output of some state.
-/
theorem DFAO.sequence_in_output_range (M : DFAO n k α) (hk : 2 ≤ k) (m : ℕ) :
    M.sequence hk m ∈ Set.range M.output := by
  exact Set.mem_range_self _

/-! ## Part 5: Thue-Morse is Not Eventually Periodic -/

/-- A sequence is eventually periodic with period p > 0 after index N. -/
def IsEventuallyPeriodic (seq : ℕ → ℕ) : Prop :=
  ∃ p N, 0 < p ∧ ∀ m, N ≤ m → seq (m + p) = seq m

/-
If thueMorse has period 2q, then it has period q.
    Proof: t(m + 2q) = t(m) for m ≥ N. Setting m = 2j for j ≥ N:
    t(2j + 2q) = t(2(j+q)) = t(j+q) and t(2j) = t(j).
    So t(j+q) = t(j), i.e. t has period q after N.
-/
theorem thueMorse_period_even_halving (q N : ℕ) (hq : 0 < q)
    (hper : ∀ m, N ≤ m → thueMorse (m + 2 * q) = thueMorse m) :
    ∀ m, N ≤ m → thueMorse (m + q) = thueMorse m := by
  intro m hm;
  have := hper ( 2 * m ) ( by linarith );
  simp_all +decide [ ← mul_add, thueMorse_double ]

/-
thueMorse cannot be eventually constant.
    If t(m) = c for all m ≥ N, then t(2N) = c and t(2N+1) = c,
    but t(2N+1) ≠ t(N) = c, contradiction.
-/
theorem thueMorse_not_eventually_constant (c N : ℕ)
    (hconst : ∀ m, N ≤ m → thueMorse m = c) : False := by
  exact absurd ( thueMorse_double_succ_ne N ) ( by simp +decide [ hconst ( 2 * N + 1 ) ( by omega ), hconst N ( by omega ) ] )

/-
If thueMorse has eventual period 1, it's eventually constant, contradiction.
-/
theorem thueMorse_not_period_one (N : ℕ)
    (hper : ∀ m, N ≤ m → thueMorse (m + 1) = thueMorse m) : False := by
  exact thueMorse_not_eventually_constant ( thueMorse N ) N fun m hm => by induction hm <;> aesop;

/-
**The Thue-Morse sequence is not eventually periodic.**
-/
theorem thueMorse_not_eventually_periodic : ¬ IsEventuallyPeriodic thueMorse := by
  -- Assume for contradiction that there exist $p$ and $ �N�$ such that for all $m \geq N$, $t(m + p) = t(m)$.
  by_contra h_contra
  obtain ⟨p, N, hp_pos, h_period⟩ : ∃ p N, 0 < p ∧ ∀ m, N ≤ m → thueMorse (m + p) = thueMorse m := by
    exact h_contra;
  induction' p using Nat.strong_induction_on with p ih generalizing N;
  by_cases hp_even : Even p;
  · -- Since $p$ is even, we � can� write $p = 2q$ for some $q$.
    obtain ⟨q, rfl⟩ : ∃ q, p = 2 * q := even_iff_two_dvd.mp hp_even;
    exact ih q ( by linarith ) N ( by linarith ) ( thueMorse_period_even_halving q N ( by linarith ) h_period );
  · -- For odd $p \geq 3$, we show that $t(m + q + 1) = t(m + q)$ for all $m \geq � N�$, where $q = \frac{p-1}{2}$.
    have h_odd_period : ∀ m, N ≤ m → thueMorse (m + (p - 1) / 2 + 1) = thueMorse (m + (p - 1) / 2) := by
      intro m hm; have := h_period ( 2 * m ) ( by linarith ) ; have := h_period ( 2 * m + 1 ) ( by linarith ) ; rcases Nat.even_or_odd' p with ⟨ c, rfl | rfl ⟩ <;> simp_all +arith +decide [ Nat.add_mod, Nat.mul_mod ] ;
      have h_even : thueMorse (2 * m + 2 * c + 1) ≠ thueMorse (m + c) := by
        convert thueMorse_double_succ_ne ( m + c ) using 1 ; ring
      have h_even' : thueMorse (2 * m + 2 * c + 2) = thueMorse (m + c + 1) := by
        convert thueMorse_double ( m + c + 1 ) using 1 ; ring
      simp_all +arith +decide [ thueMorse_double, thueMorse_double_succ_ne ];
      grind +suggestions;
    -- This contradicts the induction hypothesis that $t$ is not eventually periodic with period $1$.
    apply ih 1 (by
    rcases p with ( _ | _ | p ) <;> simp_all +arith +decide;
    exact thueMorse_not_period_one N h_odd_period) (N + (p - 1) / 2) (by
    norm_num);
    intro m hm; specialize h_odd_period ( m - ( p - 1 ) / 2 ) ( Nat.le_sub_of_add_le ( by omega ) ) ; simp_all +decide [ add_assoc, Nat.sub_add_cancel ( show ( p - 1 ) / 2 ≤ m from by omega ) ] ;

/-! ## Part 6: Kernel Finiteness -/

/-- The k-kernel: all subsequences n ↦ seq(k^e · n + r) for 0 ≤ r < k^e. -/
def kKernel (k : ℕ) (seq : ℕ → α) : Set (ℕ → α) :=
  { f | ∃ e r, r < k ^ e ∧ f = fun m => seq (k ^ e * m + r) }

/-- The original sequence is in its own kernel. -/
theorem seq_mem_kernel (k : ℕ) (_hk : 1 ≤ k) (seq : ℕ → α) :
    seq ∈ kKernel k seq :=
  ⟨0, 0, by simp, by simp⟩

/-- For a DFAO with n states, its sequence kernel is finite. -/
theorem DFAO.kernel_finite (M : DFAO n k α) (hk : 2 ≤ k) :
    Set.Finite (kKernel k (M.sequence hk)) := by
  sorry

/-! ## Part 7: Cross-Domain Bridge — Periodicity to Linear Recurrences -/

/-- A shift recurrence: seq(m) = seq(m - p) for all m ≥ N + p. -/
def SatisfiesShiftRecurrence (p : ℕ) (N : ℕ) (seq : ℕ → ℤ) : Prop :=
  ∀ m, N + p ≤ m → seq m = seq (m - p)

/-
**Bridge Theorem**: Every eventually periodic ℤ-sequence satisfies a
    shift recurrence. Connects automata theory to algebraic structure.
-/
theorem eventually_periodic_implies_recurrence
    (seq : ℕ → ℤ) (p N : ℕ) (_hp : 0 < p)
    (hper : ∀ m, N ≤ m → seq (m + p) = seq m) :
    SatisfiesShiftRecurrence p N seq := by
  intro m hm; have := hper ( m - p ) ( Nat.le_sub_of_add_le hm ) ; rw [ Nat.sub_add_cancel ( by linarith ) ] at this; aesop;

/-! ## Part 8: Constant Sequences Are Automatic -/

/-
Constant sequences are k-automatic: use a 1-state DFAO.
-/
theorem constant_is_automatic (k : ℕ) (hk : 2 ≤ k) (c : ℕ) :
    IsKAutomatic k hk (fun _ => c) := by
  refine' ⟨ 1, by norm_num, _ ⟩;
  refine' ⟨ ⟨ fun _ _ => ⟨ 0, by linarith ⟩, ⟨ 0, by linarith ⟩, fun _ => c ⟩, _ ⟩ ; simp +decide [ DFAO.sequence ];
  unfold DFAO.eval; aesop;

/-! ## Part 9: Morphisms and the Decidability Frontier -/

/-- A morphism on an alphabet of size k maps each letter to a word. -/
structure AlphabetMorphism (k : ℕ) where
  image : Fin k → List (Fin k)

/-- A morphism is k-uniform if every letter maps to a word of length k. -/
def AlphabetMorphism.IsUniform (σ : AlphabetMorphism k) : Prop :=
  ∀ a : Fin k, (σ.image a).length = k

/-- Apply a morphism to a word. -/
def AlphabetMorphism.applyWord (σ : AlphabetMorphism k) (w : List (Fin k)) : List (Fin k) :=
  w.flatMap σ.image

/-- A morphism is prolongable on `a` if σ(a) starts with a and |σ(a)| ≥ 2. -/
def AlphabetMorphism.IsProlongable (σ : AlphabetMorphism k) (a : Fin k) : Prop :=
  ∃ h : σ.image a ≠ [], (σ.image a).head h = a ∧ 2 ≤ (σ.image a).length

/-- The n-th iterate of a morphism on a single letter. -/
def AlphabetMorphism.iterateOn (σ : AlphabetMorphism k) (a : Fin k) : ℕ → List (Fin k)
  | 0 => [a]
  | n + 1 => σ.applyWord (σ.iterateOn a n)

/-
For a uniform morphism, |σⁿ(a)| = kⁿ.
-/
theorem AlphabetMorphism.iterate_length_uniform
    (σ : AlphabetMorphism k) (a : Fin k) (_hk : 0 < k)
    (hunif : σ.IsUniform) (n : ℕ) :
    (σ.iterateOn a n).length = k ^ n := by
  induction' n with n ih;
  · rfl;
  · -- By definition of `applyWord`, the length of the resulting list is the sum of the lengths of the images of each element in the input list.
    have h_applyWord_length : ∀ (l : List (Fin k)), (σ.applyWord l).length = l.length * k := by
      intro l; induction l <;> simp_all +decide [ AlphabetMorphism.IsUniform, List.length_flatMap ] ;
      · rfl;
      · simp_all +decide [ AlphabetMorphism.applyWord, List.length_flatMap ] ; linarith;
    rw [ pow_succ, ← ih, show σ.iterateOn a ( n + 1 ) = σ.applyWord ( σ.iterateOn a n ) from rfl, h_applyWord_length ]

/-- **Open Conjecture**: The zero-in-sequence problem for morphic sequences
    is decidable. Known true for k-uniform morphisms; open for general morphisms.

    **Test**: Verify BFS-based decision algorithm agrees with brute-force
    iteration (up to 10^6) on all uniform morphisms over alphabets of size ≤ 4
    with images of length ≤ 4. -/
def MorphicDecidabilityConjecture : Prop :=
  ∀ (k : ℕ) (_ : 2 ≤ k) (σ : AlphabetMorphism k) (a b : Fin k),
    σ.IsProlongable a →
    ∃ (_ : Decidable (∃ n : ℕ, b ∈ σ.iterateOn a n)), True

end AutomaticSequences