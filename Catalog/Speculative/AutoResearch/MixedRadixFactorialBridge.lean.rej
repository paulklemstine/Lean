 /-- **The factorial uniqueness theorem, re-derived from the general one.**
 
@@ -64,10 +58,6 @@
 theorem factorial_value_unique_via_mixed {c d : Nat → Nat} {k : Nat}
     (hc : FactorialNumberSystem.Valid c k) (hd : FactorialNumberSystem.Valid d k)
