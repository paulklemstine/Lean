+  have hab' : ∃ k, 0 < k ∧ a * b ∣ Nat.fib k := by
+    obtain ⟨ k₁, hk₁ ⟩ := ha
+    obtain ⟨ k₂, hk₂ ⟩ := hb
+    use Nat.lcm k₁ k₂;
+    exact ⟨ Nat.lcm_pos hk₁.1 hk₂.1, Nat.Coprime.mul_dvd_of_dvd_of_dvd hab ( dvd_trans hk₁.2 <| Nat.fib_dvd _ _ <| Nat.dvd_lcm_left _ _ ) ( dvd_trans hk₂.2 <| Nat.fib_dvd _ _ <| Nat.dvd_lcm_right _ _ ) ⟩;
+  -- Prove the key equivalence for all k: a*b ∣ Nat.fib k ↔ Nat.lcm (fibEntryPt a) (fibEntryPt b) ∣ k.
+  have h_equiv : ∀ k, a * b ∣ Nat.fib k ↔ Nat.lcm (fibEntryPt a) (fibEntryPt b) ∣ k := by
+    intro k;
+    rw [ Nat.lcm_dvd_iff ];
+    rw [ ← fib_dvd_iff_entryPt_dvd ha k, ← fib_dvd_iff_entryPt_dvd hb k ];
+    exact ⟨ fun h => ⟨ dvd_of_mul_right_dvd h, dvd_of_mul_left_dvd h ⟩, fun h => hab.mul_dvd_of_dvd_of_dvd h.1 h.2 ⟩;
