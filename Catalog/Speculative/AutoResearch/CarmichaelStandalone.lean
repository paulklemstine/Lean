--+-----+------+---+    · exact dvd_trans (ih (r / Nat.gcd r m)) (Nat.div_dvd_of_dvd (Nat.gcd_dvd_left r m))
--+-----+------+---+
--+-----+------+---+lemma primPart_dvd (n : ℕ) : primPart n ∣ Nat.fib n := by
--+-----+------+---+  simp [primPart]
--+-----+------+---+  induction (propDivs n) using List.reverseRecOn with
--+-----+------+---+  | nil => simp [List.foldl]
--+-----+------+---+  | append_singleton d l ih =>
--+-----+------+---+    simp [List.foldl]
