import Mathlib

/-!
# Spectral Realization Theory for Quantum Walks on Finite Alphabets

## Overview

This module establishes the spectral compression and minimal realization theory
for quantum walks generated by a finite alphabet of linear operators on a
finite-dimensional space.

## Main Results

- `reachableSubmodule_fg`: Finite generation (Theorem A)
- `exists_stabilization_depth`: Rank stabilization
- `obsEquiv_iff_sub_mem_obsKernel`: Observational equivalence (Theorem B)
- `FiniteRealization`: Realization structure (Theorem C)
- `amplitude_determined_by_reachable`: Reconstruction (Theorem D)
- `berggren_quantum_walk_spectral_duality`: Main duality theorem
-/

noncomputable section

open BigOperators Finset

variable {𝕂 : Type*} [Field 𝕂]
variable {Gen : Type*} [Fintype Gen] [DecidableEq Gen]
variable {V : Type*} [AddCommGroup V] [Module 𝕂 V]

/-! ## Section 1: Word Evaluation -/

/-- Evaluate a word as a composition of linear maps.
    `evalWordLin step [g₁, g₂, ..., gₖ] = step g₁ ∘ step g₂ ∘ ... ∘ step gₖ` -/
def evalWordLin (step : Gen → V →ₗ[𝕂] V) : List Gen → V →ₗ[𝕂] V
  | [] => LinearMap.id
  | g :: w => (step g).comp (evalWordLin step w)

@[simp]
theorem evalWordLin_nil (step : Gen → V →ₗ[𝕂] V) :
    evalWordLin step [] = LinearMap.id := rfl

@[simp]
theorem evalWordLin_cons (step : Gen → V →ₗ[𝕂] V) (g : Gen) (w : List Gen) :
    evalWordLin step (g :: w) = (step g).comp (evalWordLin step w) := rfl

theorem evalWordLin_append (step : Gen → V →ₗ[𝕂] V) (w₁ w₂ : List Gen) :
    evalWordLin step (w₁ ++ w₂) = (evalWordLin step w₁).comp (evalWordLin step w₂) := by
  induction w₁ with
  | nil => simp
  | cons g w₁ ih => simp only [List.cons_append, evalWordLin_cons]; rw [ih, LinearMap.comp_assoc]

/-- Apply a word to a state vector. -/
def evalWordState (step : Gen → V →ₗ[𝕂] V) (ψ : V) (w : List Gen) : V :=
  evalWordLin step w ψ

@[simp]
theorem evalWordState_nil (step : Gen → V →ₗ[𝕂] V) (ψ : V) :
    evalWordState step ψ [] = ψ := rfl

@[simp]
theorem evalWordState_cons (step : Gen → V →ₗ[𝕂] V) (g : Gen) (w : List Gen) (ψ : V) :
    evalWordState step ψ (g :: w) = step g (evalWordState step ψ w) := rfl

theorem evalWordState_append (step : Gen → V →ₗ[𝕂] V) (w₁ w₂ : List Gen) (ψ : V) :
    evalWordState step ψ (w₁ ++ w₂) = evalWordState step (evalWordState step ψ w₂) w₁ := by
  induction w₁ with
  | nil => rfl
  | cons g w₁ ih =>
    simp only [List.cons_append, evalWordState_cons]
    exact congr_arg _ ih

/-! ## Section 2: Amplitude -/

/-- The amplitude of a word: obs(step(w) ψ₀). -/
def amplitudeLin (step : Gen → V →ₗ[𝕂] V) (obs : V →ₗ[𝕂] 𝕂) (ψ₀ : V) (w : List Gen) : 𝕂 :=
  obs (evalWordState step ψ₀ w)

theorem amplitudeLin_nil (step : Gen → V →ₗ[𝕂] V) (obs : V →ₗ[𝕂] 𝕂) (ψ₀ : V) :
    amplitudeLin step obs ψ₀ [] = obs ψ₀ := rfl

theorem amplitudeLin_add (step : Gen → V →ₗ[𝕂] V) (obs : V →ₗ[𝕂] 𝕂) (ψ φ : V)
    (w : List Gen) :
    amplitudeLin step obs (ψ + φ) w = amplitudeLin step obs ψ w + amplitudeLin step obs φ w := by
  simp only [amplitudeLin, evalWordState, map_add]

theorem amplitudeLin_smul (step : Gen → V →ₗ[𝕂] V) (obs : V →ₗ[𝕂] 𝕂) (c : 𝕂) (ψ : V)
    (w : List Gen) :
    amplitudeLin step obs (c • ψ) w = c • amplitudeLin step obs ψ w := by
  simp only [amplitudeLin, evalWordState, LinearMap.map_smul]

theorem amplitudeLin_zero (step : Gen → V →ₗ[𝕂] V) (obs : V →ₗ[𝕂] 𝕂) (w : List Gen) :
    amplitudeLin step obs 0 w = 0 := by
  simp [amplitudeLin, evalWordState]

theorem amplitudeLin_sub (step : Gen → V →ₗ[𝕂] V) (obs : V →ₗ[𝕂] 𝕂) (ψ φ : V)
    (w : List Gen) :
    amplitudeLin step obs (ψ - φ) w = amplitudeLin step obs ψ w - amplitudeLin step obs φ w := by
  simp only [amplitudeLin, evalWordState, map_sub]

/-! ## Section 3: Reachable Transfer Submodule -/

def reachableSet (step : Gen → V →ₗ[𝕂] V) (ψ₀ : V) : Set V :=
  { ψ | ∃ w : List Gen, evalWordState step ψ₀ w = ψ }

def reachableSubmodule (step : Gen → V →ₗ[𝕂] V) (ψ₀ : V) : Submodule 𝕂 V :=
  Submodule.span 𝕂 (reachableSet step ψ₀)

theorem mem_reachableSet_self (step : Gen → V →ₗ[𝕂] V) (ψ₀ : V) :
    ψ₀ ∈ reachableSet step ψ₀ := ⟨[], rfl⟩

theorem step_mem_reachableSet (step : Gen → V →ₗ[𝕂] V) (ψ₀ : V)
    (g : Gen) {ψ : V} (hψ : ψ ∈ reachableSet step ψ₀) :
    step g ψ ∈ reachableSet step ψ₀ := by
  obtain ⟨w, rfl⟩ := hψ; exact ⟨g :: w, rfl⟩

/-- **Theorem A (invariance)**: The reachable submodule is step-invariant. -/
theorem reachableSubmodule_invariant (step : Gen → V →ₗ[𝕂] V) (ψ₀ : V) (g : Gen) :
    (reachableSubmodule step ψ₀).map (step g) ≤ reachableSubmodule step ψ₀ := by
  apply Submodule.map_le_iff_le_comap.mpr
  apply Submodule.span_le.mpr
  intro ψ hψ
  show (step g) ψ ∈ reachableSubmodule step ψ₀
  exact Submodule.subset_span (step_mem_reachableSet step ψ₀ g hψ)

theorem evalWordState_mem_reachableSubmodule (step : Gen → V →ₗ[𝕂] V) (ψ₀ : V)
    (w : List Gen) :
    evalWordState step ψ₀ w ∈ reachableSubmodule step ψ₀ :=
  Submodule.subset_span ⟨w, rfl⟩

/-- **Theorem A (finite generation)**: The reachable submodule is finitely generated
    when V is finite-dimensional. This is the spectral compression theorem. -/
theorem reachableSubmodule_fg [FiniteDimensional 𝕂 V]
    (step : Gen → V →ₗ[𝕂] V) (ψ₀ : V) :
    (reachableSubmodule step ψ₀).FG :=
  IsNoetherian.noetherian _

/-! ## Section 4: Truncated Submodules and Stabilization -/

/-- States reachable by words of length at most n. -/
def reachableSetUpTo (step : Gen → V →ₗ[𝕂] V) (ψ₀ : V) (n : ℕ) : Set V :=
  { ψ | ∃ w : List Gen, w.length ≤ n ∧ evalWordState step ψ₀ w = ψ }

/-- Truncated reachable submodule. -/
def reachableSubmoduleUpTo (step : Gen → V →ₗ[𝕂] V) (ψ₀ : V) (n : ℕ) : Submodule 𝕂 V :=
  Submodule.span 𝕂 (reachableSetUpTo step ψ₀ n)

omit [Fintype Gen] [DecidableEq Gen] in
theorem reachableSubmoduleUpTo_mono (step : Gen → V →ₗ[𝕂] V) (ψ₀ : V) {m n : ℕ} (h : m ≤ n) :
    reachableSubmoduleUpTo step ψ₀ m ≤ reachableSubmoduleUpTo step ψ₀ n := by
  apply Submodule.span_mono
  intro ψ hψ
  obtain ⟨w, hw, rfl⟩ := hψ
  exact ⟨w, le_trans hw h, rfl⟩

omit [Fintype Gen] [DecidableEq Gen] in
theorem reachableSubmodule_eq_iSup (step : Gen → V →ₗ[𝕂] V) (ψ₀ : V) :
    reachableSubmodule step ψ₀ = ⨆ n, reachableSubmoduleUpTo step ψ₀ n := by
  apply le_antisymm
  · apply Submodule.span_le.mpr
    intro ψ hψ
    obtain ⟨w, rfl⟩ := hψ
    exact Submodule.mem_iSup_of_mem w.length (Submodule.subset_span ⟨w, le_refl _, rfl⟩)
  · apply iSup_le
    intro n
    apply Submodule.span_mono
    intro ψ hψ
    obtain ⟨w, _, rfl⟩ := hψ
    exact ⟨w, rfl⟩

/-- **Rank stabilization**: Truncated submodules stabilize at finite depth. -/
theorem exists_stabilization_depth [FiniteDimensional 𝕂 V]
    (step : Gen → V →ₗ[𝕂] V) (ψ₀ : V) :
    ∃ N : ℕ, ∀ n ≥ N,
      reachableSubmoduleUpTo step ψ₀ n = reachableSubmoduleUpTo step ψ₀ N := by
  have hmono : Monotone (reachableSubmoduleUpTo step ψ₀) :=
    fun _ _ h => reachableSubmoduleUpTo_mono step ψ₀ h
  obtain ⟨N, hN⟩ := (monotone_stabilizes_iff_noetherian (R := 𝕂) (M := V)).mpr inferInstance
    ⟨reachableSubmoduleUpTo step ψ₀, hmono⟩
  exact ⟨N, fun n hn => (hN n hn).symm⟩

/-- After stabilization, the truncation equals the full reachable submodule. -/
theorem reachableSubmoduleUpTo_eq_full [FiniteDimensional 𝕂 V]
    (step : Gen → V →ₗ[𝕂] V) (ψ₀ : V) :
    ∃ N : ℕ, reachableSubmoduleUpTo step ψ₀ N = reachableSubmodule step ψ₀ := by
  obtain ⟨N, hN⟩ := exists_stabilization_depth step ψ₀
  refine ⟨N, ?_⟩
  rw [reachableSubmodule_eq_iSup]
  apply le_antisymm
  · exact le_iSup_of_le N (le_refl _)
  · apply iSup_le
    intro n
    by_cases h : n ≤ N
    · exact reachableSubmoduleUpTo_mono step ψ₀ h
    · push_neg at h; rw [hN n (le_of_lt h)]

/-! ## Section 5: Observational Equivalence (Theorem B) -/

/-- Two states are observationally equivalent if they produce identical amplitudes. -/
def obsEquiv (step : Gen → V →ₗ[𝕂] V) (obs : V →ₗ[𝕂] 𝕂) (ψ φ : V) : Prop :=
  ∀ w : List Gen, amplitudeLin step obs ψ w = amplitudeLin step obs φ w

/-- The observation kernel: states whose all future amplitudes vanish. -/
def obsKernel (step : Gen → V →ₗ[𝕂] V) (obs : V →ₗ[𝕂] 𝕂) : Submodule 𝕂 V where
  carrier := { ψ | ∀ w : List Gen, amplitudeLin step obs ψ w = 0 }
  add_mem' {a b} ha hb w := by
    rw [amplitudeLin_add, ha w, hb w, add_zero]
  zero_mem' w := amplitudeLin_zero step obs w
  smul_mem' c _ hψ w := by rw [amplitudeLin_smul, hψ w, smul_zero]

/-- **Theorem B**: Observational equivalence ↔ difference in observation kernel. -/
theorem obsEquiv_iff_sub_mem_obsKernel (step : Gen → V →ₗ[𝕂] V) (obs : V →ₗ[𝕂] 𝕂)
    (ψ φ : V) :
    obsEquiv step obs ψ φ ↔ ψ - φ ∈ obsKernel step obs := by
  constructor
  · intro h w
    rw [amplitudeLin_sub, h w, sub_self]
  · intro h w
    have hw := h w
    rw [amplitudeLin_sub] at hw
    exact sub_eq_zero.mp hw

/-
The observation kernel is step-invariant: if all future amplitudes of ψ vanish,
    then all future amplitudes of step(g)(ψ) also vanish.
-/
theorem obsKernel_step_invariant (step : Gen → V →ₗ[𝕂] V) (obs : V →ₗ[𝕂] 𝕂)
    (g : Gen) (ψ : V) (hψ : ψ ∈ obsKernel step obs) :
    step g ψ ∈ obsKernel step obs := by
      intro w;
      convert hψ ( w ++ [ g ] ) using 1;
      unfold amplitudeLin; simp +decide [ evalWordState_append ] ;

/-- The observation kernel as an intersection of word-indexed kernels. -/
theorem obsKernel_eq_iInf (step : Gen → V →ₗ[𝕂] V) (obs : V →ₗ[𝕂] 𝕂) :
    obsKernel step obs = ⨅ w : List Gen, LinearMap.ker (obs.comp (evalWordLin step w)) := by
  ext ψ
  simp only [Submodule.mem_iInf, LinearMap.mem_ker, LinearMap.comp_apply]
  rfl

/-! ## Section 6: Finite Realization (Theorem C) -/

/-- A finite-dimensional realization of a word-indexed functional. -/
structure FiniteRealization (𝕂 : Type*) [Field 𝕂] (Gen : Type*) where
  V : Type*
  instACG : AddCommGroup V
  instMod : Module 𝕂 V
  instFD : FiniteDimensional 𝕂 V
  T : Gen → V →ₗ[𝕂] V
  init : V
  out : V →ₗ[𝕂] 𝕂

attribute [instance] FiniteRealization.instACG FiniteRealization.instMod
  FiniteRealization.instFD

/-- Evaluate a word in a realization. -/
def FiniteRealization.evalW (R : FiniteRealization 𝕂 Gen) : List Gen → R.V
  | [] => R.init
  | g :: w => R.T g (R.evalW w)

/-- A realization realizes f if out(T_w init) = f(w) for all words w. -/
def FiniteRealization.realizes (R : FiniteRealization 𝕂 Gen) (f : List Gen → 𝕂) : Prop :=
  ∀ w : List Gen, R.out (R.evalW w) = f w

/-- The dimension of a realization. -/
def FiniteRealization.fdim (R : FiniteRealization 𝕂 Gen) : ℕ :=
  Module.finrank 𝕂 R.V

/-! ## Section 7: Reconstruction (Theorem D) -/

/-- **Theorem D**: All amplitudes are determined by a finite spanning set
    from the reachable submodule. For any word w, the state evalWordState ψ₀ w
    lies in a finitely generated submodule spanned by states from bounded-length words. -/
theorem amplitude_determined_by_reachable [FiniteDimensional 𝕂 V]
    (step : Gen → V →ₗ[𝕂] V) (obs : V →ₗ[𝕂] 𝕂) (ψ₀ : V) (w : List Gen) :
    ∃ (N : ℕ) (S : Finset V),
      (∀ v ∈ S, v ∈ reachableSubmoduleUpTo step ψ₀ N) ∧
      evalWordState step ψ₀ w ∈ Submodule.span 𝕂 (↑S : Set V) := by
  obtain ⟨N, hN⟩ := reachableSubmoduleUpTo_eq_full step ψ₀
  have hmem : evalWordState step ψ₀ w ∈ reachableSubmodule step ψ₀ :=
    evalWordState_mem_reachableSubmodule step ψ₀ w
  rw [← hN] at hmem
  obtain ⟨S, hS⟩ := (IsNoetherian.noetherian (reachableSubmoduleUpTo step ψ₀ N) :
    (reachableSubmoduleUpTo step ψ₀ N).FG)
  exact ⟨N, S, fun v hv => hS ▸ Submodule.subset_span hv, hS ▸ hmem⟩

/-! ## Section 8: Berggren Specialization -/

/-- The Berggren generator type (3 generators for the triple tree). -/
inductive BGen : Type
  | A | B | C
  deriving DecidableEq, Fintype, Inhabited

/-- **Main Theorem**: Berggren quantum walk spectral duality package.

    For a quantum walk on a finite-dimensional complex vector space V with
    three Berggren generators, this theorem establishes all four components
    of the spectral duality:

    1. **Spectral compression** (Theorem A): The reachable submodule is
       finitely generated, so the infinite Berggren tree of states collapses
       to a finite-dimensional transfer space.

    2. **Stabilization**: The truncated reachable submodules (words of length ≤ N)
       stabilize, meaning finite-depth exploration suffices.

    3. **Reachability**: Every word-reachable state lies in the reachable submodule.

    4. **Observational characterization** (Theorem B): Two states are
       observationally equivalent (same amplitude on all words) iff their
       difference lies in the observation kernel. -/
theorem berggren_quantum_walk_spectral_duality
    (V : Type*) [AddCommGroup V] [Module ℂ V] [FiniteDimensional ℂ V]
    (step : BGen → V →ₗ[ℂ] V)
    (obs : V →ₗ[ℂ] ℂ)
    (ψ₀ : V) :
    -- 1. Spectral compression
    (reachableSubmodule step ψ₀).FG ∧
    -- 2. Stabilization at finite depth
    (∃ N : ℕ, reachableSubmoduleUpTo step ψ₀ N = reachableSubmodule step ψ₀) ∧
    -- 3. Reachability
    (∀ w : List BGen, evalWordState step ψ₀ w ∈ reachableSubmodule step ψ₀) ∧
    -- 4. Observational characterization
    (∀ ψ φ : V, obsEquiv step obs ψ φ ↔ ψ - φ ∈ obsKernel step obs) := by
  exact ⟨reachableSubmodule_fg step ψ₀,
    reachableSubmoduleUpTo_eq_full step ψ₀,
    fun w => evalWordState_mem_reachableSubmodule step ψ₀ w,
    fun ψ φ => obsEquiv_iff_sub_mem_obsKernel step obs ψ φ⟩

end