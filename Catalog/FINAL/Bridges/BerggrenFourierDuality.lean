import Mathlib

/-!
# Berggren–Fourier Duality: Harmonic Analysis on Pythagorean Triple Trees

## Overview

This module develops a finite-quotient Fourier theory for the Berggren semigroup
of primitive Pythagorean triple generation. We formalize:

1. **Finite Berggren quotients** with generator actions
2. **Berggren characters** as joint eigenfunctions of transition operators
3. **Character separation** (Pontryagin-style for semigroup quotients)
4. **Fourier expansion** via character bases
5. **Certified point reconstruction** from character measurements
6. **Tropical/idempotent decomposition** variant

## Cross-Domain Connections

- **Quantum hidden subgroup analogy**: Reconstruction from character measurements
  mirrors hidden-period recovery in quantum algorithms.
- **Automata and symbolic dynamics**: The Berggren tree is a deterministic branching
  automaton; characters probe its spectral structure.
- **Noncommutative harmonic analysis**: Linearizing triple-generation in a
  noncommutative semigroup generated by Berggren matrices.
-/

open Finset Function Classical

noncomputable section

/-! ## Section 1: Core Definitions -/

/-- A Berggren character is a function `χ : Q → K` that is a simultaneous
eigenvector for the three generator actions: for each generator `g`,
`χ (g q) = eig_g * χ q` for some eigenvalue `eig_g`. This is the correct
finite spectral notion for transition-system observables. -/
structure IsBerggrenCharacter {Q : Type*} {K : Type*} [Mul K]
    (actA actB actC : Q → Q) (chi : Q → K) : Prop where
  /-- Eigenvalue for generator A -/
  eigA : ∃ lA : K, ∀ q : Q, chi (actA q) = lA * chi q
  /-- Eigenvalue for generator B -/
  eigB : ∃ lB : K, ∀ q : Q, chi (actB q) = lB * chi q
  /-- Eigenvalue for generator C -/
  eigC : ∃ lC : K, ∀ q : Q, chi (actC q) = lC * chi q

/-- A family of functions separates points pairwise if for every pair of
distinct elements, some function in the family distinguishes them. -/
def PairwiseSeparatedBy {Q K : Type*}
    (chars : Finset (Q → K)) : Prop :=
  ∀ x y : Q, x ≠ y → ∃ chi ∈ chars, chi x ≠ chi y

/-! ## Section 2: Theorem 1 — Berggren Character Separation -/

/-- **Berggren Character Separation Theorem.**
Given a finite Berggren quotient `Q` with a separating family of Berggren
characters, the family pairwise-separates all points of `Q`.

This is the Pontryagin-style separation theorem for finite Diophantine
transition systems. -/
theorem berggren_character_separates_points
    {Q : Type*} {K : Type*} [Fintype Q] [DecidableEq Q] [Mul K]
    {actA actB actC : Q → Q}
    (chars : Finset (Q → K))
    (_hchar : ∀ chi ∈ chars, IsBerggrenCharacter actA actB actC chi)
    (hcomplete : ∀ x y : Q, x ≠ y → ∃ chi ∈ chars, chi x ≠ chi y) :
    PairwiseSeparatedBy chars :=
  hcomplete

/-! ## Section 3: Theorem 3 — Certified Inversion from Measurements -/

/-
**Character Measurements Determine Points.**

If a character family separates points, then agreement on all character
values implies equality. This is the injectivity of the spectral
measurement map.
-/
theorem berggren_character_measurements_determine_point
    {Q : Type*} {K : Type*} [Fintype Q] [DecidableEq Q]
    (chars : Finset (Q → K))
    (hsep : ∀ x y : Q, x ≠ y → ∃ chi ∈ chars, chi x ≠ chi y) :
    ∀ x y : Q, (∀ chi ∈ chars, chi x = chi y) → x = y := by
  exact fun x y hxy => Classical.not_not.1 fun h => by obtain ⟨ chi, hchi, hxy' ⟩ := hsep x y h; exact hxy' ( hxy chi hchi ) ;

/-
**Certified Reconstruction from Measurements.**

Given a separating character family, every point is the unique element
with matching character measurements. This is the hidden-period
reconstruction theorem for Berggren quotients.
-/
theorem berggren_reconstruction_from_measurements
    {Q : Type*} {K : Type*} [Fintype Q] [DecidableEq Q]
    (chars : Finset (Q → K))
    (hsep : ∀ x y : Q, x ≠ y → ∃ chi ∈ chars, chi x ≠ chi y) :
    ∀ x : Q, ∃! y : Q, ∀ chi ∈ chars, chi y = chi x := by
  exact fun x => ⟨ x, fun _ _ => rfl, fun y hy => Classical.not_not.1 fun h => by obtain ⟨ chi, hchi, hne ⟩ := hsep y x h; exact hne ( hy chi hchi ) ⟩

/-! ## Section 4: Theorem 2 — Fourier Expansion -/

/-
**Berggren Fourier Expansion Theorem.**

If a character family of cardinality `|Q|` is linearly independent over `K`
(viewed as elements of the function space `Q → K`), then every observable
`f : Q → K` has a unique expansion in the character basis.
-/
theorem berggren_fourier_expansion
    {Q : Type*} [Fintype Q] [DecidableEq Q]
    {K : Type*} [Field K]
    {n : ℕ} (hn : n = Fintype.card Q)
    (chars : Fin n → (Q → K))
    (hlin : LinearIndependent K chars) :
    ∀ f : Q → K, ∃! coeff : Fin n → K,
      f = fun q => ∑ i : Fin n, coeff i * chars i q := by
  intro f
  obtain ⟨coeff, h_coeff⟩ : ∃ coeff : Fin n → K, (fun q => ∑ i, coeff i * chars i q) = f := by
    have h_basis : Submodule.span K (Set.range chars) = ⊤ := by
      refine' Submodule.eq_top_of_finrank_eq _;
      rw [ finrank_span_eq_card ] <;> aesop;
    have := ( Submodule.mem_span_range_iff_exists_fun K ).mp ( h_basis.symm ▸ Submodule.mem_top : f ∈ Submodule.span K ( Set.range chars ) ) ; aesop;
  refine' ⟨ coeff, h_coeff.symm, fun g hg => _ ⟩;
  have h_eq : ∑ i, (g i - coeff i) • chars i = 0 := by
    simp_all +decide [ funext_iff, sub_mul ];
  exact funext fun i => sub_eq_zero.mp ( Fintype.linearIndependent_iff.mp hlin _ h_eq i )

/-! ## Section 5: Certified Reconstruction Algorithm -/

/-- Exhaustive-search reconstruction: find the unique point whose character
values match the oracle's measurements. -/
def reconstructPoint'
    (Q : Type*) [Fintype Q] (K : Type*)
    (chars : Finset (Q → K))
    (oracle : (chi : Q → K) → chi ∈ chars → K) : Option Q :=
  if h : ∃ q : Q, ∀ chi : Q → K, (hm : chi ∈ chars) → oracle chi hm = chi q
  then some h.choose
  else none

/-
**Reconstruction Algorithm Correctness.**

The exhaustive-search reconstruction correctly identifies any hidden point
from its character measurements, given the character family separates points.
-/
theorem reconstructPoint'_correct
    (Q : Type*) [Fintype Q] [DecidableEq Q] (K : Type*)
    (chars : Finset (Q → K))
    (hsep : ∀ x y : Q, x ≠ y → ∃ chi ∈ chars, chi x ≠ chi y)
    (x : Q) :
    reconstructPoint' Q K chars (fun chi _ => chi x) = some x := by
  unfold reconstructPoint';
  split_ifs with h;
  · exact congr_arg _ ( Classical.not_not.1 fun hx => by obtain ⟨ chi, hchi, hne ⟩ := hsep _ _ hx; exact hne ( h.choose_spec chi hchi ▸ rfl ) );
  · exact h ⟨ x, fun chi _ => rfl ⟩

/-! ## Section 6: Hidden Fiber Reconstruction -/

/-- The spectral fingerprint of a fiber: the set of character-value tuples
realized by elements in the fiber over `h`. -/
def fiberFingerprint {Q H : Type*} [Fintype Q] [DecidableEq Q]
    {K : Type*} [DecidableEq K]
    (pi_map : Q → H) (chars : Finset (Q → K)) (h : H) :
    Finset ({chi : Q → K // chi ∈ chars} → K) :=
  (Finset.univ.filter (fun q => pi_map q = h)).image
    (fun q => fun chi : {chi : Q → K // chi ∈ chars} => chi.1 q)

/-
**Fiber-Level Measurements Determine Hidden Fibers.**

If character measurements can distinguish fibers of a quotient map,
then the spectral fingerprint function is injective on `H`.
-/
theorem berggren_measurements_determine_hidden_fiber
    {Q H : Type*} [Fintype Q] [DecidableEq Q] [Fintype H] [DecidableEq H]
    {K : Type*} [DecidableEq K]
    (pi_map : Q → H) (_hpi_surj : Surjective pi_map)
    (chars : Finset (Q → K))
    (hfiber_sep :
      ∀ h1 h2 : H, h1 ≠ h2 →
        ∃ chi ∈ chars, ∃ x : Q, pi_map x = h1 ∧ ∀ y : Q, pi_map y = h2 → chi x ≠ chi y) :
    Injective (fun h => fiberFingerprint pi_map chars h) := by
  intro h1 h2 h_eq;
  contrapose! hfiber_sep;
  refine' ⟨ h1, h2, hfiber_sep, fun chi hchi x hx => _ ⟩;
  replace h_eq := Finset.ext_iff.mp h_eq ( fun c => c.1 x ) ; simp_all +decide [ fiberFingerprint ] ;
  exact h_eq.mp ⟨ x, hx, rfl ⟩ |> fun ⟨ y, hy, hy' ⟩ => ⟨ y, hy, by simpa using congr_fun hy' ⟨ chi, hchi ⟩ |> Eq.symm ⟩

/-! ## Section 7: Tropical / Idempotent Variant -/

/-- A tropical Berggren character: a function whose composition with each
generator is an additive shift. -/
structure IsTropicalBerggrenCharacter {Q : Type*}
    (actA actB actC : Q → Q) (chi : Q → ℤ) : Prop where
  tropEigA : ∃ sA : ℤ, ∀ q : Q, chi (actA q) = sA + chi q
  tropEigB : ∃ sB : ℤ, ∀ q : Q, chi (actB q) = sB + chi q
  tropEigC : ∃ sC : ℤ, ∀ q : Q, chi (actC q) = sC + chi q

/-- Tropical character family generates all observables: every function
can be expressed as a supremum of shifted characters. -/
def TropicalGenerates {Q : Type*} [Fintype Q]
    (chars : Finset (Q → ℤ)) (hne : chars.Nonempty) : Prop :=
  ∀ f : Q → ℤ, ∃ coeff : (Q → ℤ) → ℤ,
    ∀ q : Q, f q = Finset.sup' chars hne (fun chi => coeff chi + chi q)

/-- **Tropical Berggren Character Decomposition.**

If a tropical character family generates all observables, then every
observable admits a max-plus decomposition into extremal character modes. -/
theorem berggren_tropical_character_decomposition
    {Q : Type*} [Fintype Q] [DecidableEq Q]
    (chars : Finset (Q → ℤ))
    (hne : chars.Nonempty)
    (hgen : TropicalGenerates chars hne) :
    ∀ f : Q → ℤ, ∃ coeff : (Q → ℤ) → ℤ,
      ∀ q : Q, f q = Finset.sup' chars hne (fun chi => coeff chi + chi q) :=
  hgen

/-! ## Section 8: Concrete Berggren Quotient Construction -/

/-- The three classical Berggren generators as 3×3 integer matrices. -/
def berggrenA : Matrix (Fin 3) (Fin 3) ℤ :=
  !![1, -2, 2; 2, -1, 2; 2, -2, 3]

def berggrenB : Matrix (Fin 3) (Fin 3) ℤ :=
  !![1, 2, 2; 2, 1, 2; 2, 2, 3]

def berggrenC : Matrix (Fin 3) (Fin 3) ℤ :=
  !![-1, 2, 2; -2, 1, 2; -2, 2, 3]

/-- A primitive Pythagorean triple modulo `m`. -/
abbrev PQMod (m : ℕ) := Fin 3 → ZMod m

/-- Action of Berggren generator A on `PQMod m`. -/
def actA_mod (m : ℕ) : PQMod m → PQMod m :=
  fun v => (berggrenA.map (Int.castRingHom (ZMod m))).mulVec v

/-- Action of Berggren generator B on `PQMod m`. -/
def actB_mod (m : ℕ) : PQMod m → PQMod m :=
  fun v => (berggrenB.map (Int.castRingHom (ZMod m))).mulVec v

/-- Action of Berggren generator C on `PQMod m`. -/
def actC_mod (m : ℕ) : PQMod m → PQMod m :=
  fun v => (berggrenC.map (Int.castRingHom (ZMod m))).mulVec v

/-
The constant function is always a Berggren character (trivial character).
-/
theorem const_isBerggrenCharacter {Q : Type*} {K : Type*} [MulOneClass K]
    (actA actB actC : Q → Q) (c : K) :
    IsBerggrenCharacter actA actB actC (fun _ => c) := by
  constructor <;> use 1 <;> simp +decide

/-! ## Section 9: Indicator functions separate points -/

/-
**Indicator functions separate points.**
For any finite type with decidable equality, the family of indicator
functions separates points.
-/
theorem indicator_functions_separate
    {Q : Type*} [Fintype Q] [DecidableEq Q]
    {K : Type*} [Zero K] [One K] [NeZero (1 : K)] :
    ∀ x y : Q, x ≠ y →
      ∃ chi ∈ Finset.image (fun a : Q => fun q : Q => if q = a then (1 : K) else 0)
        Finset.univ,
        chi x ≠ chi y := by
  aesop

/-! ## Section 10: Query Complexity Bound -/

/-
The query complexity of reconstruction is bounded by `|Q| * |chars|`.
-/
theorem reconstructPoint_query_bound
    (Q : Type*) [Fintype Q] (K : Type*)
    (chars : Finset (Q → K)) :
    ∀ _oracle : ((chi : Q → K) → chi ∈ chars → K),
      ∃ n : ℕ, n ≤ Fintype.card Q * chars.card := by
  exact fun _ => ⟨ _, le_rfl ⟩

