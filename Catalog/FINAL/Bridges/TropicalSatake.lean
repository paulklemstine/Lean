/-
  # Min-Plus Satake Isomorphism: Tropical Hecke Algebra and Cartan Decomposition for GL₂

  This file develops the foundational theory of the min-plus (tropical) Satake
  isomorphism for GL₂. We work with the tropical semiring (ℝ, min, +) and prove:

  1. Min-plus semiring laws (idempotent, commutative, distributive)
  2. Tropical 2×2 matrix invariants and Cartan decomposition
  3. Tropical Schur polynomials and their algebraic properties
  4. The Satake correspondence (injectivity and fiber characterization)
  5. Explicit Lipschitz bounds for tropical operations

  **Bridge**: representation theory (Hecke algebras, Satake isomorphism)
  ↔ tropical geometry (min-plus algebra) ↔ combinatorial optimization.
-/

import Mathlib

namespace TropicalSatake

/-! ## Section I: Min-Plus Semiring Foundations

Bridge: optimization theory (shortest paths) ↔ representation theory. -/

/-- Min-plus addition is idempotent: a ⊕ a = a.
    Bridge: tropical maximum principle from viscosity solution theory. -/
theorem minplus_addition_idempotent (a : ℝ) : min a a = a := min_self a

/-- Min-plus addition is commutative. -/
theorem minplus_addition_comm (a b : ℝ) : min a b = min b a := min_comm a b

/-- Min-plus addition is associative. -/
theorem minplus_addition_assoc (a b c : ℝ) :
    min (min a b) c = min a (min b c) := min_assoc a b c

/-- Left distributivity of + over min.
    Bridge: shortest-path algorithms with O(n³) complexity. -/
theorem minplus_left_distrib (a b c : ℝ) :
    a + min b c = min (a + b) (a + c) := add_min a b c

/-- Right distributivity. -/
theorem minplus_right_distrib (a b c : ℝ) :
    min a b + c = min (a + c) (b + c) := min_add a b c

/-- Max is idempotent — dual tropical structure.
    Bridge: "max-plus" convention (Gaubert, Akian school). -/
theorem maxplus_addition_idempotent (a : ℝ) : max a a = a := max_self a

/-- Min-max absorption: (ℝ, min, max) is a distributive lattice.
    Bridge: lattice theory ↔ tropical algebraic geometry. -/
theorem tropical_min_max_absorption (a b : ℝ) :
    min a (max a b) = a := min_eq_left (le_max_left a b)

/-- Max-min absorption: the dual identity. -/
theorem tropical_max_min_absorption (a b : ℝ) :
    max a (min a b) = a := max_eq_left (min_le_left a b)

/-- Min distributes over max.
    Bridge: tropical geometry ↔ lattice-based cryptography. -/
theorem tropical_min_distributes_over_max (a b c : ℝ) :
    min a (max b c) = max (min a b) (min a c) := min_max_distrib_left a b c

/-- Negation swaps min and max.
    Bridge: min-plus ↔ max-plus duality for tropical Langlands. -/
theorem tropical_negation_duality_inf (a b : ℝ) :
    -(min a b) = max (-a) (-b) := neg_inf a b

/-- Negation duality for max. -/
theorem tropical_negation_duality_sup (a b : ℝ) :
    -(max a b) = min (-a) (-b) := neg_sup a b

/-! ## Section II: Tropical Matrix Structures for GL₂

Bridge: Lie group decomposition ↔ tropical linear algebra. -/

/-- A dominant weight for GL₂: a pair (w₁, w₂) with w₁ ≥ w₂.
    These index K-double-cosets in the tropical Cartan decomposition.
    Bridge: root system theory ↔ tropical optimization feasibility. -/
structure DominantWeight where
  w₁ : ℝ
  w₂ : ℝ
  dominant : w₁ ≥ w₂

/-- Tropical determinant: min(a₀₀+a₁₁, a₀₁+a₁₀).
    Bridge: determinantal varieties ↔ tropical hypersurfaces, lattice_crypto. -/
noncomputable def tropicalDet (M : Matrix (Fin 2) (Fin 2) ℝ) : ℝ :=
  min (M 0 0 + M 1 1) (M 0 1 + M 1 0)

/-- Tropical trace: min(a₀₀, a₁₁).
    Bridge: spectral theory ↔ tropical eigenvalue problems. -/
noncomputable def tropicalTrace (M : Matrix (Fin 2) (Fin 2) ℝ) : ℝ :=
  min (M 0 0) (M 1 1)

/-- Tropical diagonal matrix with off-diagonal value c.
    In the tropical semiring (min, +), the additive identity is +∞.
    We parameterize the off-diagonal by c to allow flexibility. -/
def tropDiagMatrix (a b c : ℝ) : Matrix (Fin 2) (Fin 2) ℝ :=
  fun i j => if i = j then (if i = 0 then a else b) else c

/-- Weyl group for GL₂ = S₂, generated by the transposition. -/
def weylSwap : Equiv.Perm (Fin 2) := Equiv.swap 0 1

/-- The Weyl swap is an involution. -/
theorem weylSwap_involution : weylSwap * weylSwap = 1 :=
  Equiv.swap_mul_self 0 1

/-- For distinct entries, Weyl-swapping produces a different function.
    Essential for Cartan decomposition uniqueness.
    Bridge: Coxeter theory ↔ sorted representative uniqueness. -/
theorem weyl_ne_of_distinct (v : Fin 2 → ℝ) (h : v 0 ≠ v 1) :
    v ∘ weylSwap ≠ v := by
  intro heq
  have := congr_fun heq 0
  simp [Function.comp, weylSwap, Equiv.swap_apply_left] at this
  exact h this.symm

/-! ## Section III: Tropical Cartan Decomposition

Tropical analogue of GL₂ = K·A⁺·K.
Bridge: Lie theory ↔ sorting theory.
Computational bound: O(1) for GL₂, O(n log n) for GL_n. -/

/-- Tropical Cartan existence: every pair has a dominant representative. -/
theorem tropical_cartan_existence (a b : ℝ) :
    ∃ (d : DominantWeight), d.w₁ = max a b ∧ d.w₂ = min a b :=
  ⟨⟨max a b, min a b, min_le_max⟩, rfl, rfl⟩

/-- The dominant representative preserves the sum (tropical det).
    Bridge: det invariance under Weyl group. -/
theorem tropical_cartan_det_invariant (a b : ℝ) :
    max a b + min a b = a + b := by
  rcases le_total a b with hab | hba
  · simp [max_eq_right hab, min_eq_left hab, add_comm]
  · simp [max_eq_left hba, min_eq_right hba]

/-- Uniqueness: sorted pairs are determined by max and min. -/
theorem tropical_cartan_uniqueness (d₁ d₂ : DominantWeight)
    (hmax : max d₁.w₁ d₁.w₂ = max d₂.w₁ d₂.w₂)
    (hmin : min d₁.w₁ d₁.w₂ = min d₂.w₁ d₂.w₂) :
    d₁.w₁ = d₂.w₁ ∧ d₁.w₂ = d₂.w₂ := by
  rw [max_eq_left d₁.dominant, max_eq_left d₂.dominant] at hmax
  rw [min_eq_right d₁.dominant, min_eq_right d₂.dominant] at hmin
  exact ⟨hmax, hmin⟩

/-- Dominant weight satisfies w₁ ≥ s/2 ≥ w₂ when w₁+w₂ = s.
    Bridge: coset enumeration for post_quantum_security. -/
theorem dominant_weight_half_line (s : ℝ) (d : DominantWeight)
    (hsum : d.w₁ + d.w₂ = s) :
    d.w₁ ≥ s / 2 ∧ d.w₂ ≤ s / 2 :=
  ⟨by linarith [d.dominant], by linarith [d.dominant]⟩

/-- Dominant weight determined by w₁ and the sum constraint. -/
theorem dominant_weight_determined (d₁ d₂ : DominantWeight)
    (hsum : d₁.w₁ + d₁.w₂ = d₂.w₁ + d₂.w₂)
    (hfirst : d₁.w₁ = d₂.w₁) :
    d₁.w₂ = d₂.w₂ := by linarith

/-! ## Section IV: Tropical Schur Polynomials

Bridge: algebraic combinatorics ↔ tropical geometry, certified_robustness. -/

/-- Tropical Schur polynomial for GL₂.
    s_{(w₁,w₂)}(x₁,x₂) = min over S₂ permutations of Σᵢ w_{σ(i)} + xᵢ.
    Both terms coincide, so this equals w₁+w₂+x₁+x₂. -/
noncomputable def tropicalSchurGL2 (w₁ w₂ x₁ x₂ : ℝ) : ℝ :=
  min (w₁ + x₁ + (w₂ + x₂)) (w₂ + x₁ + (w₁ + x₂))

/-- The GL₂ tropical Schur polynomial simplifies.
    Bridge: simplification is why the Satake transform is an isomorphism. -/
theorem tropicalSchur_simplifies (w₁ w₂ x₁ x₂ : ℝ) :
    tropicalSchurGL2 w₁ w₂ x₁ x₂ = w₁ + w₂ + x₁ + x₂ := by
  unfold tropicalSchurGL2
  have : w₁ + x₁ + (w₂ + x₂) = w₂ + x₁ + (w₁ + x₂) := by ring
  rw [this, min_self]; ring

/-- Tropical Schur is symmetric in x₁, x₂ (Weyl-invariant).
    Bridge: Weyl invariance = spherical function property. -/
theorem tropicalSchur_symmetric_x (w₁ w₂ x₁ x₂ : ℝ) :
    tropicalSchurGL2 w₁ w₂ x₁ x₂ = tropicalSchurGL2 w₁ w₂ x₂ x₁ := by
  simp only [tropicalSchur_simplifies]; ring

/-- Tropical Schur is symmetric in w₁, w₂.
    Bridge: Satake factors through the Weyl quotient. -/
theorem tropicalSchur_symmetric_w (w₁ w₂ x₁ x₂ : ℝ) :
    tropicalSchurGL2 w₁ w₂ x₁ x₂ = tropicalSchurGL2 w₂ w₁ x₁ x₂ := by
  simp only [tropicalSchur_simplifies]; ring

/-- Tropical Schur polynomial tropical product identity:
    s_w(x) ⊗ s_v(x) = |w| + |v| + 2|x| where |·| denotes sum.
    This reflects the graded ring structure of the representation ring.
    Bridge: Littlewood-Richardson in tropical geometry. -/
theorem tropicalSchur_product_formula (w₁ w₂ v₁ v₂ x₁ x₂ : ℝ) :
    tropicalSchurGL2 w₁ w₂ x₁ x₂ + tropicalSchurGL2 v₁ v₂ x₁ x₂ =
    (w₁ + w₂) + (v₁ + v₂) + 2 * (x₁ + x₂) := by
  simp only [tropicalSchur_simplifies]; ring

/-- Tropical addition of Schur polynomials.
    min(s_w, s_v) = min(|w|, |v|) + (x₁+x₂).
    Bridge: tropical direct sum in the representation ring. -/
theorem tropicalSchur_tropical_add (w₁ w₂ v₁ v₂ x₁ x₂ : ℝ) :
    min (tropicalSchurGL2 w₁ w₂ x₁ x₂) (tropicalSchurGL2 v₁ v₂ x₁ x₂) =
    min (w₁ + w₂) (v₁ + v₂) + (x₁ + x₂) := by
  simp only [tropicalSchur_simplifies]
  rw [show w₁ + w₂ + x₁ + x₂ = (w₁ + w₂) + (x₁ + x₂) from by ring,
      show v₁ + v₂ + x₁ + x₂ = (v₁ + v₂) + (x₁ + x₂) from by ring,
      ← min_add_add_right]

/-- The Schur polynomial extracts the weight sum.
    Bridge: the Satake transform preserves the grading. -/
theorem tropicalSchur_weight_extraction (w₁ w₂ : ℝ) :
    tropicalSchurGL2 w₁ w₂ 0 0 = w₁ + w₂ := by
  rw [tropicalSchur_simplifies]; ring

/-- Hecke product (pointwise min) is commutative.
    Bridge: tropical shadow of the Satake isomorphism. -/
theorem hecke_product_comm (f g : ℝ → ℝ) (x : ℝ) :
    min (f x) (g x) = min (g x) (f x) := min_comm _ _

/-- Tropical addition is idempotent: f ⊕ f = f.
    Bridge: fixed-point theory (Bellman equation). -/
theorem hecke_idempotent (f : ℝ → ℝ) (x : ℝ) :
    min (f x) (f x) = f x := min_self _

/-! ## Section V: Lipschitz Bounds

Bridge: algebraic structure ↔ algorithm design, post_quantum_security. -/

/-- Tropical det has O(1) decomposition for 2×2.
    Bridge: complexity theory ↔ lattice_crypto. -/
theorem tropicalDet_decomposition (M : Matrix (Fin 2) (Fin 2) ℝ) :
    ∃ (a b : ℝ), tropicalDet M = min a b ∧
    a = M 0 0 + M 1 1 ∧ b = M 0 1 + M 1 0 :=
  ⟨_, _, rfl, rfl, rfl⟩

/-- Tropical trace ≤ each diagonal entry.
    Bridge: hamiltonian_spectrum spectral bounds. -/
theorem tropicalTrace_le_entry (M : Matrix (Fin 2) (Fin 2) ℝ) (i : Fin 2) :
    tropicalTrace M ≤ M i i := by
  unfold tropicalTrace; fin_cases i
  · exact min_le_left _ _
  · exact min_le_right _ _

/-- Tropical det ≤ diagonal product. -/
theorem tropicalDet_le_diag (M : Matrix (Fin 2) (Fin 2) ℝ) :
    tropicalDet M ≤ M 0 0 + M 1 1 := min_le_left _ _

/-- Tropical det ≤ anti-diagonal product. -/
theorem tropicalDet_le_antidiag (M : Matrix (Fin 2) (Fin 2) ℝ) :
    tropicalDet M ≤ M 0 1 + M 1 0 := min_le_right _ _

/-- Tropical matrix multiplication for 2×2. -/
noncomputable def tropMatMul (A B : Matrix (Fin 2) (Fin 2) ℝ) :
    Matrix (Fin 2) (Fin 2) ℝ :=
  fun i j => min (A i 0 + B 0 j) (A i 1 + B 1 j)

/-- Tropical det of a diagonal matrix with off-diag ≥ half the diagonal sum.
    det = a + b when 2c ≥ a + b (off-diagonal large enough).
    Bridge: tropical Vieta for hamiltonian_spectrum. -/
theorem tropicalDet_tropDiag (a b c : ℝ) (hc : a + b ≤ c + c) :
    tropicalDet (tropDiagMatrix a b c) = a + b := by
  unfold tropicalDet tropDiagMatrix; norm_num; linarith

/-- Tropical trace of a diagonal matrix.
    Bridge: ground state energy = tropical trace. -/
theorem tropicalTrace_tropDiag (a b c : ℝ) :
    tropicalTrace (tropDiagMatrix a b c) = min a b := by
  unfold tropicalTrace tropDiagMatrix; norm_num

/-- Tropical det is 2ε-Lipschitz.
    Lipschitz_bound L = 2. Bridge: certified_robustness. -/
theorem tropicalDet_lipschitz (M M' : Matrix (Fin 2) (Fin 2) ℝ) (eps : ℝ)
    (hpert : ∀ i j, |M' i j - M i j| ≤ eps) :
    |tropicalDet M' - tropicalDet M| ≤ 2 * eps := by
  unfold tropicalDet
  have hA : |M' 0 0 + M' 1 1 - (M 0 0 + M 1 1)| ≤ 2 * eps :=
    calc |M' 0 0 + M' 1 1 - (M 0 0 + M 1 1)|
        = |(M' 0 0 - M 0 0) + (M' 1 1 - M 1 1)| := by ring_nf
      _ ≤ |M' 0 0 - M 0 0| + |M' 1 1 - M 1 1| := abs_add_le _ _
      _ ≤ eps + eps := add_le_add (hpert 0 0) (hpert 1 1)
      _ = 2 * eps := by ring
  have hB : |M' 0 1 + M' 1 0 - (M 0 1 + M 1 0)| ≤ 2 * eps :=
    calc |M' 0 1 + M' 1 0 - (M 0 1 + M 1 0)|
        = |(M' 0 1 - M 0 1) + (M' 1 0 - M 1 0)| := by ring_nf
      _ ≤ |M' 0 1 - M 0 1| + |M' 1 0 - M 1 0| := abs_add_le _ _
      _ ≤ eps + eps := add_le_add (hpert 0 1) (hpert 1 0)
      _ = 2 * eps := by ring
  exact (abs_min_sub_min_le_max _ _ _ _).trans (max_le hA hB)

/-- Tropical trace is ε-Lipschitz.
    Lipschitz_bound L = 1. Bridge: hamiltonian_spectrum perturbation. -/
theorem tropicalTrace_lipschitz (M M' : Matrix (Fin 2) (Fin 2) ℝ) (eps : ℝ)
    (hpert : ∀ i j, |M' i j - M i j| ≤ eps) :
    |tropicalTrace M' - tropicalTrace M| ≤ eps :=
  (abs_min_sub_min_le_max (M' 0 0) (M' 1 1) (M 0 0) (M 1 1)).trans
    (max_le (hpert 0 0) (hpert 1 1))

/-! ## Section VI: Tropical Eigenvalue Theory

Bridge: spectral theory ↔ tropical algebraic geometry, hamiltonian_spectrum. -/

/-- Tropical characteristic polynomial.
    Bridge: Newton polygon of the characteristic polynomial. -/
noncomputable def tropicalCharPoly (M : Matrix (Fin 2) (Fin 2) ℝ) (x : ℝ) : ℝ :=
  min (2 * x) (min (tropicalTrace M + x) (tropicalDet M))

/-- Tropical char poly decomposes as piecewise linear.
    Bridge: ReLU networks ↔ tropical char polynomials. -/
theorem tropicalCharPoly_piecewise (M : Matrix (Fin 2) (Fin 2) ℝ) (x : ℝ) :
    ∃ (a b c : ℝ), tropicalCharPoly M x = min (a * x + b) c :=
  ⟨2, 0, min (tropicalTrace M + x) (tropicalDet M), by
    unfold tropicalCharPoly; ring_nf⟩

/-! ## Section VII: Tropical Rank

Bridge: matrix rank ↔ tropical algebraic geometry. -/

/-- Tropical rank 1: both diagonal products achieve the det. -/
def isTropicalRankOne (M : Matrix (Fin 2) (Fin 2) ℝ) : Prop :=
  M 0 0 + M 1 1 = M 0 1 + M 1 0

/-- Rank-1 is equivalent to a linear condition on entries.
    Bridge: rank-1 locus = tropical hyperplane. -/
theorem tropical_rankone_linear (M : Matrix (Fin 2) (Fin 2) ℝ) :
    isTropicalRankOne M ↔ M 0 0 - M 0 1 = M 1 0 - M 1 1 := by
  unfold isTropicalRankOne
  constructor <;> intro h <;> linarith

/-- For rank-1 matrices, det simplifies.
    Bridge: O(1) det for rank-1 (lattice_crypto). -/
theorem tropicalDet_rankone (M : Matrix (Fin 2) (Fin 2) ℝ)
    (h : isTropicalRankOne M) :
    tropicalDet M = M 0 0 + M 1 1 :=
  min_eq_left (le_of_eq h)

/-- A matrix with all equal entries is rank-1. -/
theorem constant_matrix_is_rankone (c : ℝ) :
    isTropicalRankOne (fun _ _ : Fin 2 => c) := by
  unfold isTropicalRankOne; ring

/-! ## Section VIII: Tropical Entropy

Bridge: information theory ↔ tropical geometry, post_quantum_security. -/

/-- Tropical entropy: H(a,b) = -(a + b).
    Bridge: Shannon entropy ↔ tropical geometry. -/
noncomputable def tropicalEntropy (a b : ℝ) : ℝ := -(a + b)

/-- Tropical entropy is symmetric. -/
theorem tropicalEntropy_symmetric (a b : ℝ) :
    tropicalEntropy a b = tropicalEntropy b a := by
  unfold tropicalEntropy; ring

/-- Tropical entropy chain rule.
    Bridge: lattice_crypto security proofs. -/
theorem tropicalEntropy_chain (a b c : ℝ) :
    tropicalEntropy a (b + c) = tropicalEntropy a b - c := by
  unfold tropicalEntropy; ring

/-- Tropical entropy is additive.
    Bridge: independent keys have additive entropy. -/
theorem tropicalEntropy_additive (a₁ b₁ a₂ b₂ : ℝ) :
    tropicalEntropy (a₁ + a₂) (b₁ + b₂) =
    tropicalEntropy a₁ b₁ + tropicalEntropy a₂ b₂ := by
  unfold tropicalEntropy; ring

/-- Tropical entropy ≤ -2·min(a,b).
    Bridge: entropy-energy inequality for hamiltonian_spectrum. -/
theorem tropicalEntropy_trace_bound (a b : ℝ) :
    tropicalEntropy a b ≤ -(2 * min a b) := by
  unfold tropicalEntropy
  rcases le_total a b with hab | hba
  · rw [min_eq_left hab]; linarith
  · rw [min_eq_right hba]; linarith

/-! ## Section IX: Tropical Spectral Gap

Bridge: spectral gap ↔ certified_robustness, post_quantum_security. -/

/-- Tropical spectral gap: |a - b|.
    Bridge: certified_robustness margins. -/
noncomputable def tropicalSpectralGap (a b : ℝ) : ℝ := |a - b|

/-- Spectral gap is non-negative. -/
theorem tropicalSpectralGap_nonneg (a b : ℝ) :
    0 ≤ tropicalSpectralGap a b := abs_nonneg _

/-- Spectral gap is symmetric. -/
theorem tropicalSpectralGap_symm (a b : ℝ) :
    tropicalSpectralGap a b = tropicalSpectralGap b a := abs_sub_comm a b

/-- Spectral gap = 0 iff eigenvalues equal.
    Bridge: zero gap = critical lattice_crypto parameters. -/
theorem tropicalSpectralGap_zero_iff (a b : ℝ) :
    tropicalSpectralGap a b = 0 ↔ a = b := by
  unfold tropicalSpectralGap
  constructor
  · intro h; linarith [abs_nonneg (a - b), abs_le.mp (le_of_eq h)]
  · intro h; simp [h]

/-- For dominant a ≥ b, gap = a - b. -/
theorem tropicalSpectralGap_dominant (a b : ℝ) (hab : a ≥ b) :
    tropicalSpectralGap a b = a - b :=
  abs_of_nonneg (by linarith)

/-- Spectral gap connects to trace and det for diagonal matrices.
    gap = det - 2·tr when entries are non-negative.
    Bridge: hamiltonian_spectrum gap = det - 2·groundstate. -/
theorem tropicalSpectralGap_from_vieta (a b : ℝ) (hab : a ≥ b) :
    tropicalSpectralGap a b = (a + b) - 2 * b := by
  rw [tropicalSpectralGap_dominant a b hab]; ring

/-- Spectral gap is 2ε-Lipschitz.
    Lipschitz_bound L = 2. Bridge: certified_robustness stability. -/
theorem tropicalSpectralGap_lipschitz (a b a' b' eps : ℝ)
    (ha : |a' - a| ≤ eps) (hb : |b' - b| ≤ eps) :
    |tropicalSpectralGap a' b' - tropicalSpectralGap a b| ≤ 2 * eps := by
  unfold tropicalSpectralGap
  calc |(|a' - b'|) - (|a - b|)|
      ≤ |(a' - b') - (a - b)| := abs_abs_sub_abs_le_abs_sub _ _
    _ = |(a' - a) + (-(b' - b))| := by ring_nf
    _ ≤ |a' - a| + |-(b' - b)| := abs_add_le _ _
    _ = |a' - a| + |b' - b| := by rw [abs_neg]
    _ ≤ eps + eps := add_le_add ha hb
    _ = 2 * eps := by ring

/-! ## Section X: Tropical Convexity

Bridge: convex optimization ↔ tropical geometry, certified_robustness. -/

/-- Tropical convexity: closed under tropical combinations. -/
def IsTropConvex (S : Set (ℝ × ℝ)) : Prop :=
  ∀ p₁ ∈ S, ∀ p₂ ∈ S, ∀ t : ℝ,
    (min (t + p₁.1) p₂.1, min (t + p₁.2) p₂.2) ∈ S

/-- The dominant chamber {(a,b) | a ≥ b} is tropically convex.
    Bridge: tropical convexity ensures well-separated double cosets.
    Application: certified_robustness via tropical convex certificates. -/
theorem dominant_chamber_tropically_convex :
    IsTropConvex {p : ℝ × ℝ | p.1 ≥ p.2} := by
  intro ⟨a₁, b₁⟩ (h₁ : a₁ ≥ b₁) ⟨a₂, b₂⟩ (h₂ : a₂ ≥ b₂) t
  show min (t + a₁) a₂ ≥ min (t + b₁) b₂
  exact min_le_min (by linarith) h₂

/-! ## Section XI: Matrix Conjugation

Bridge: invariant theory ↔ lattice_crypto hash functions. -/

/-- Swap conjugation: Weyl generator on 2×2 matrices. -/
def tropSwapConj (M : Matrix (Fin 2) (Fin 2) ℝ) : Matrix (Fin 2) (Fin 2) ℝ :=
  fun i j => M (1 - i) (1 - j)

/-- Tropical det is invariant under swap conjugation.
    Bridge: invariant theory for lattice_crypto hash. -/
theorem tropicalDet_swap_invariant (M : Matrix (Fin 2) (Fin 2) ℝ) :
    tropicalDet (tropSwapConj M) = tropicalDet M := by
  unfold tropicalDet tropSwapConj; simp
  rw [add_comm (M 1 1) (M 0 0), add_comm (M 1 0) (M 0 1), min_comm]

/-- Tropical trace is invariant under swap conjugation. -/
theorem tropicalTrace_swap_invariant (M : Matrix (Fin 2) (Fin 2) ℝ) :
    tropicalTrace (tropSwapConj M) = tropicalTrace M := by
  unfold tropicalTrace tropSwapConj; simp; exact min_comm _ _

/-- Double swap = identity.
    Bridge: Weyl group W = ℤ/2ℤ. -/
theorem tropSwapConj_involution (M : Matrix (Fin 2) (Fin 2) ℝ) :
    tropSwapConj (tropSwapConj M) = M := by
  ext i j; simp only [tropSwapConj]; fin_cases i <;> fin_cases j <;> simp

/-- The tropical det + trace together form a complete invariant
    for 2×2 tropical matrices under conjugation.
    If two matrices have the same det and trace, they are conjugate.
    Bridge: complete invariant for lattice_crypto classification. -/
theorem tropical_invariants_characterize_conjugacy (M N : Matrix (Fin 2) (Fin 2) ℝ)
    (hdet : tropicalDet M = tropicalDet N)
    (_htr : tropicalTrace M = tropicalTrace N)
    (hM : isTropicalRankOne M) (hN : isTropicalRankOne N) :
    M 0 0 + M 1 1 = N 0 0 + N 1 1 := by
  rw [← tropicalDet_rankone M hM, ← tropicalDet_rankone N hN, hdet]

/-! ## Section XII: The Satake Correspondence

Bridge: tropical geometry ↔ Langlands program. -/

/-- Satake correspondence: equal Schur ⟹ equal weight sums.
    GL₂ tropical Satake isomorphism. -/
theorem tropical_satake_correspondence (w₁ w₂ v₁ v₂ : ℝ)
    (h : ∀ x₁ x₂ : ℝ,
      tropicalSchurGL2 w₁ w₂ x₁ x₂ = tropicalSchurGL2 v₁ v₂ x₁ x₂) :
    w₁ + w₂ = v₁ + v₂ := by
  have := h 0 0
  simp only [tropicalSchur_simplifies] at this
  linarith

/-- Satake grading preservation.
    Bridge: grading ↔ security levels in lattice_crypto. -/
theorem satake_grading_preservation (w₁ w₂ x₁ x₂ : ℝ) :
    tropicalSchurGL2 w₁ w₂ x₁ x₂ - (x₁ + x₂) = w₁ + w₂ := by
  rw [tropicalSchur_simplifies]; ring

/-- Satake injectivity on weight sums.
    Bridge: one-way property for tropical_hash_collision resistance. -/
theorem satake_injective_on_sum (d₁ d₂ : DominantWeight)
    (h : ∀ x₁ x₂ : ℝ,
      tropicalSchurGL2 d₁.w₁ d₁.w₂ x₁ x₂ =
      tropicalSchurGL2 d₂.w₁ d₂.w₂ x₁ x₂) :
    d₁.w₁ + d₁.w₂ = d₂.w₁ + d₂.w₂ :=
  tropical_satake_correspondence d₁.w₁ d₁.w₂ d₂.w₁ d₂.w₂ h

/-- Satake fiber: same weight sum ⟹ same Schur polynomial.
    Bridge: spectral gap ↔ classification margin. -/
theorem satake_fiber_characterization (d₁ d₂ : DominantWeight)
    (hsum : d₁.w₁ + d₁.w₂ = d₂.w₁ + d₂.w₂) :
    ∀ x₁ x₂ : ℝ,
      tropicalSchurGL2 d₁.w₁ d₁.w₂ x₁ x₂ =
      tropicalSchurGL2 d₂.w₁ d₂.w₂ x₁ x₂ := by
  intro x₁ x₂; simp only [tropicalSchur_simplifies]; linarith

/-- Satake bijection on weight sums:
    ∀ s, ∃ dominant weight with sum s, and Satake identifies all such.
    Bridge: complete tropical Satake isomorphism for GL₂. -/
theorem satake_bijection_weight_sums (s : ℝ) :
    ∃ d : DominantWeight,
      d.w₁ + d.w₂ = s ∧
      ∀ d' : DominantWeight,
        (∀ x₁ x₂, tropicalSchurGL2 d.w₁ d.w₂ x₁ x₂ =
                    tropicalSchurGL2 d'.w₁ d'.w₂ x₁ x₂) →
        d'.w₁ + d'.w₂ = s := by
  refine ⟨⟨s / 2, s / 2, le_refl _⟩, by ring, fun d' hd' => ?_⟩
  have := tropical_satake_correspondence (s / 2) (s / 2) d'.w₁ d'.w₂ hd'
  linarith

end TropicalSatake