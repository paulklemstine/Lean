# EML Congruence Hilbert Basis: Specialization to Idempotent Semiring Algebras

This file specializes the general finite-presentation theory of semiring congruences
(from `Algebra.IdempotentCongruenceBasis`) to the setting of idempotent (EML-style)
semiring algebras.

## Main contributions

* **Idempotent semiring congruences**: We define congruences for idempotent semirings
  (where `a + a = a`) and show all general basis results specialize cleanly.
* **Vanishing congruences**: The congruence generated by evaluating at a point and
  identifying functions with the same value.
* **Elimination**: Stability of finite generation under one-generator elimination.
* **Tropical syzygy interface**: The redundancy predicate and iterative reduction.

## Context

In EML (Exponential-Max-Linear) algebra, the semiring operations are typically
`max` (addition) and `+` (multiplication), making the algebra idempotent.
Congruences in this setting encode tropical vanishing loci and bend relations.
The reduced basis theorem says these geometric objects always have finite,
minimal, algorithmically extractable presentations.
-/

import Mathlib
import Algebra.IdempotentCongruenceBasis

open Finset

/-! ## Idempotent Semiring Congruences -/

/-- A semiring is idempotent (with respect to addition) if `a + a = a` for all `a`. -/
class IdempotentAdd (A : Type*) [Add A] : Prop where
  add_idem : ∀ a : A, a + a = a

/-- In an idempotent-additive semiring, the generated congruence inherits idempotency
    of the underlying semiring. This is a specialization marker. -/
def SemiringCongruence.isIdempotentGenerated
    {A : Type*} [Semiring A] [IdempotentAdd A]
    (S : Finset (RelPair A)) : SemiringCongruence A :=
  SemiringCongruence.generatedBy S

/-- A vanishing congruence identifies elements that "vanish" at a common locus.
    In the EML/tropical setting, this corresponds to functions having the same
    value on a tropical variety. -/
structure IsVanishingCongruence {A : Type*} [Semiring A]
    (C : SemiringCongruence A) : Prop where
  /-- The congruence contains all reflexive pairs (automatic from congruence axioms) -/
  contains_diagonal : ∀ a, C.r a a
  /-- Vanishing compatibility: if a ~ b and c ~ d, then a + c ~ b + d -/
  vanishing_add : ∀ {a b c d}, C.r a b → C.r c d → C.r (a + c) (b + d)

/-- Every semiring congruence is trivially a vanishing congruence. -/
theorem every_congruence_is_vanishing {A : Type*} [Semiring A]
    (C : SemiringCongruence A) : IsVanishingCongruence C :=
  ⟨C.refl', fun h1 h2 => C.add' h1 h2⟩

/-! ## Elimination Theory -/

/-- Elimination of one generator preserves finite generation.
    Given a finitely generated congruence `C` and a pair `p`, the congruence
    generated by removing `p` from the generators either equals `C` (if `p`
    is redundant) or is a proper sub-congruence. -/
theorem elimination_step_fg
    {A : Type*} [DecidableEq A] [Semiring A]
    (S : Finset (RelPair A)) (p : RelPair A) (_hp : p ∈ S) :
    IsFinitelyGeneratedCongruence (SemiringCongruence.generatedBy (S.erase p)) := by
  exact ⟨S.erase p, rfl⟩

/-- After elimination, the resulting congruence is a sub-congruence of the original. -/
theorem elimination_sub_congruence
    {A : Type*} [DecidableEq A] [Semiring A]
    (S : Finset (RelPair A)) (p : RelPair A) (_hp : p ∈ S) :
    SemiringCongruence.generatedBy (S.erase p) ≤
      SemiringCongruence.generatedBy S := by
  exact SemiringCongruence.generatedBy_mono (Finset.erase_subset p S)

/-- The full elimination theorem: iteratively eliminating redundant generators
    from a finite generating set produces a reduced basis. -/
theorem elimination_produces_reduced_basis
    {A : Type*} [DecidableEq A] [Semiring A]
    (S : Finset (RelPair A)) :
    ∃ B : Finset (RelPair A), B ⊆ S ∧
      IsReducedCongruenceBasis (SemiringCongruence.generatedBy S) B := by
  obtain ⟨B, hB_sub, hB_gen, hB_min⟩ := exists_minimal_generating_subfinset S
  exact ⟨B, hB_sub, ⟨hB_gen, fun T hT => hB_min T hT⟩⟩

/-! ## Tropical Syzygy Interface -/

/-- A syzygy certificate for a pair `p` relative to basis `B` witnesses that `p`
    is derivable from `B` — i.e., `p` is redundant. -/
def HasSyzygyCertificate {A : Type*} [Semiring A]
    (p : RelPair A) (B : Finset (RelPair A)) : Prop :=
  (SemiringCongruence.generatedBy B).r p.1 p.2

/-
If a pair has a syzygy certificate, it is redundant.
-/
theorem syzygy_implies_redundant
    {A : Type*} [DecidableEq A] [Semiring A]
    {p : RelPair A} {B : Finset (RelPair A)} :
    HasSyzygyCertificate p B →
    SemiringCongruence.generatedBy (insert p B) =
      SemiringCongruence.generatedBy B := by
  intro hp
  apply SemiringCongruence.ext;
  ext a b; constructor <;> intro h <;> simp_all +decide [ SemiringCongruence.generatedBy ] ;
  · induction h;
    all_goals try { exact? };
    cases ‹_› ; aesop;
    exact CongDerives.of_mem ‹_›;
  · exact CongDerives.mono ( by aesop_cat ) h

/-
Conversely, if a pair is not redundant, it has no syzygy certificate
    from the remaining generators.
-/
theorem not_redundant_iff_no_syzygy
    {A : Type*} [DecidableEq A] [Semiring A]
    {p : RelPair A} {B : Finset (RelPair A)} (hp : p ∉ B) :
    ¬ HasSyzygyCertificate p B ↔
    SemiringCongruence.generatedBy (insert p B) ≠
      SemiringCongruence.generatedBy B := by
  constructor <;> intro h;
  · contrapose! h;
    have h_redundant : (SemiringCongruence.generatedBy (insert p B)).r p.1 p.2 := by
      exact CongDerives.of_mem ( Finset.mem_insert_self _ _ );
    aesop;
  · exact fun h' => h <| syzygy_implies_redundant h'

/-! ## Application: Concrete Idempotent Algebras -/

/-- For any semiring (including tropical algebras), congruence basis extraction works. -/
theorem any_semiring_reduced_basis_exists {A : Type*} [Semiring A]
    (S : Finset (RelPair A)) :
    ∃ B : Finset (RelPair A),
      IsReducedCongruenceBasis (SemiringCongruence.generatedBy S) B := by
  exact reduced_basis_exists _ ⟨S, rfl⟩

/-! ## Summary of the Congruence Hilbert Basis Program -/

/-
**Main theorem (Idempotent Hilbert Basis)**: Every finitely generated semiring
    congruence — in particular, every congruence arising from an idempotent/EML
    algebra — admits a finite reduced (inclusion-minimal) basis. This basis is:
    - A subset of any given generating set
    - Unique up to congruence equivalence
    - Extractable by iterative redundancy elimination

    This is the algebraic analogue of the Hilbert Basis Theorem for congruences,
    and the finite-presentation theorem that connects tropical/EML geometry
    to computation.
-/
theorem idempotent_hilbert_basis_theorem
    {A : Type*} [Semiring A]
    (C : SemiringCongruence A)
    (hfg : IsFinitelyGeneratedCongruence C) :
    ∃ B : Finset (RelPair A),
      IsReducedCongruenceBasis C B ∧
      (∀ B', IsReducedCongruenceBasis C B' → BasisEquivalent B B') := by
  obtain ⟨ B, hB ⟩ := fg_congruence_has_reduced_basis C hfg;
  exact ⟨ B, hB, fun B' hB' => reduced_basis_minimal_up_to_congruence_equivalence hB hB' ⟩