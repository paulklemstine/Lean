/-! ## Section 17: Algebraic Identities -/

/-- The first component of A⁻¹ equals σ₁. -/
theorem invA_first_eq_sigma1 (a b c : ℤ) :
    (berggrenInvA a b c).1 = sigma1 a b c := by
  unfold berggrenInvA sigma1; ring

/-- The second component of A⁻¹ equals -σ₂. -/
theorem invA_second_eq_neg_sigma2 (a b c : ℤ) :
    (berggrenInvA a b c).2.1 = -sigma2 a b c := by
  unfold berggrenInvA sigma2; ring

/-- The first component of B⁻¹ equals σ₁. -/
theorem invB_first_eq_sigma1 (a b c : ℤ) :
    (berggrenInvB a b c).1 = sigma1 a b c := by
  unfold berggrenInvB sigma1; ring

/-- The second component of B⁻¹ equals σ₂. -/
theorem invB_second_eq_sigma2 (a b c : ℤ) :
    (berggrenInvB a b c).2.1 = sigma2 a b c := by
  unfold berggrenInvB sigma2; ring

/-- The first component of C⁻¹ equals -σ₁. -/
theorem invC_first_eq_neg_sigma1 (a b c : ℤ) :
    (berggrenInvC a b c).1 = -sigma1 a b c := by
  unfold berggrenInvC sigma1; ring

/-- The second component of C⁻¹ equals σ₂. -/
theorem invC_second_eq_sigma2 (a b c : ℤ) :
    (berggrenInvC a b c).2.1 = sigma2 a b c := by
  unfold berggrenInvC sigma2; ring

/-! ## Section 18: Symmetry Properties -/

/-- Swapping a ↔ b and applying A gives the same result as applying C with swapped output.
This reflects the symmetry (a,b) ↔ (b,a) in the Berggren tree.
Bridge: connects Pythagorean symmetry to quantum_walk time-reversal. -/
theorem fwdA_swap_eq_fwdC (a b c : ℤ) :
    berggrenFwdA b a c = let (x, y, z) := berggrenFwdC a b c; (y, x, z) := by
  unfold berggrenFwdA berggrenFwdC; ext1; ring; ext1 <;> ring

/-- The B-transform is symmetric: swapping a ↔ b just swaps the first two components. -/
theorem fwdB_swap (a b c : ℤ) :
    berggrenFwdB b a c = let (x, y, z) := berggrenFwdB a b c; (y, x, z) := by
  unfold berggrenFwdB; ext1; ring; ext1 <;> ring

/-- Forward B growth bound: c' ≥ 3c + 4 for positive triples.
Bridge: connects hypotenuse growth to lattice_crypto key expansion. -/
theorem fwdB_hyp_growth_bound (a b c : ℤ) (ha : 0 < a) (hb : 0 < b) :
    (berggrenFwdB a b c).2.2 ≥ 3*c + 4 := by
  unfold berggrenFwdB; linarith

/-
c ≥ 5 for any primitive Pythagorean triple with a ≠ b.
Bridge: connects to quantum_walk minimum depth in the Berggren tree.
-/
theorem hyp_ge_five (a b c : ℤ) (h : IsPythagorean a b c)
    (ha : 0 < a) (hb : 0 < b) (hc : 0 < c) (hcop : Int.gcd a b = 1)
    (hab : a ≠ b) :
    5 ≤ c := by
  by_contra! h;
  interval_cases c <;> ( have := ( show a ≤ 5 by nlinarith [ ‹IsPythagorean a b _›.symm ] ) ; ( have := ( show b ≤ 5 by nlinarith [ ‹IsPythagorean a b _›.symm ] ) ; interval_cases a <;> interval_cases b <;> norm_num at *; ) );
  all_goals unfold IsPythagorean at *; contradiction;