/-
# Conductor-free universality of the prime rungs of the abelian ladder

The degree-11 rung (`Q(ζ₂₃)⁺`, `Shared.AbelianLadderRealCyclotomic`) and the
degree-7 rung (the septic subfield of `Q(ζ₂₉)`,
`Physics.AbelianLadderDegreeSeven`) were each established by hand, with two
different subgroup constructions.  This file proves that **neither the conductor
nor the construction matters**: for every prime degree `q` and every prime
conductor `f ≡ 1 (mod q)`, the degree-`q` subfield of `Q(ζ_f)` has

* splitting density exactly `1/q` (`card_split_classes`);
* Frobenius-type entropy exactly `H(T) = log₂ q − ((q−1)/q) log₂ (q−1)`,
  independent of `f` (`uEnt_powDeg_eq_typeEntropy`, `rung_entropy_conductor_free`);
* full pinning: the Frobenius class in the Galois group of the subfield
  determines the residue degree, so `I(class ; T) = H(T)`
  (`full_pinning_universal`, `mutInfo_powDeg_eq_typeEntropy`).

The engine is a purely group-theoretic count: in a finite cyclic group the group
of `q`-th powers is the cyclic subgroup generated by `g^q`
(`powRange_eq_zpowers`), hence has order `|G| / gcd(|G|, q)`
(`card_powRange_cyclic`).

Two consequences are recorded explicitly: the degree-7 rung of conductor `29` and
the degree-7 rung of conductor `43` have literally the same entropy
(`deg7_conductor_29_43_agree`), and the degree-11 rung of conductor `23`
reappears as a special case (`deg11_conductor_23_entropy`).
-/
import Physics.AbelianLadderDegreeSeven

namespace AbelianLadder

open Finset CyclicTypeChannel

/-! ## 1. The group of `q`-th powers in a finite cyclic group -/

/-- In a cyclic group with generator `g`, the `q`-th powers are exactly the
powers of `g ^ q`. -/
theorem powRange_eq_zpowers {G : Type*} [CommGroup G] {g : G}
    (hg : ∀ x : G, x ∈ Subgroup.zpowers g) (q : ℕ) :
    (powMonoidHom q : G →* G).range = Subgroup.zpowers (g ^ q) := by
  ext x
  simp only [MonoidHom.mem_range, powMonoidHom_apply, Subgroup.mem_zpowers_iff]
  constructor
  · rintro ⟨v, rfl⟩
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.1 (hg v)
    exact ⟨k, by group⟩
  · rintro ⟨k, rfl⟩
    exact ⟨g ^ k, by group⟩

/-- **The order of the group of `q`-th powers** in a finite cyclic group. -/
theorem card_powRange_cyclic {G : Type*} [CommGroup G] [Finite G] [IsCyclic G] (q : ℕ) :
    Nat.card ((powMonoidHom q : G →* G).range) = Nat.card G / Nat.gcd (Nat.card G) q := by
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := G)
  have hord : orderOf g = Nat.card G := orderOf_eq_card_of_forall_mem_zpowers hg
  rw [powRange_eq_zpowers hg q, Nat.card_zpowers, orderOf_pow, hord]

/-! ## 2. The prime rung: conductor `f`, degree `q` -/

variable {f q : ℕ}

theorem card_units_prime [NeZero f] (hf : f.Prime) : Fintype.card (ZMod f)ˣ = f - 1 := by
  rw [ZMod.card_units_eq_totient, Nat.totient_prime hf]

/-- The number of Frobenius classes that split completely is `(f-1)/q`. -/
theorem card_powSub_prime [NeZero f] (hf : f.Prime) (hqf : q ∣ f - 1) :
    Nat.card (powSub f q) = (f - 1) / q := by
  haveI := Fact.mk hf
  have hcard : Nat.card (ZMod f)ˣ = f - 1 := by
    rw [Nat.card_eq_fintype_card, card_units_prime hf]
  rw [powSub, card_powRange_cyclic, hcard, Nat.gcd_eq_right hqf]

/-- The split classes form the subgroup of `q`-th powers, of size `(f-1)/q`:
**the splitting density of a prime rung is `1/q`**. -/
theorem card_split_classes [NeZero f] (hf : f.Prime) (hqf : q ∣ f - 1) :
    #{u ∈ (univ : Finset (ZMod f)ˣ) | powDeg f q u = 1} = (f - 1) / q := by
  classical
  have hset : {u ∈ (univ : Finset (ZMod f)ˣ) | powDeg f q u = 1}
      = {u ∈ (univ : Finset (ZMod f)ˣ) | u ∈ powSub f q} :=
    Finset.filter_congr fun u _ => by simp [powDeg_eq_one_iff]
  have hcard : #{u ∈ (univ : Finset (ZMod f)ˣ) | u ∈ powSub f q} = Nat.card (powSub f q) := by
    rw [Nat.card_eq_fintype_card, Fintype.card_subtype]
  rw [hset, hcard, card_powSub_prime hf hqf]

/-- **The Frobenius-type entropy of a prime rung.** -/
theorem uEnt_powDeg_eq_binEnt [NeZero f] (hf : f.Prime) (hq : q.Prime) (hqf : q ∣ f - 1) :
    uEnt (univ : Finset (ZMod f)ˣ) (powDeg f q) = binEnt (f - 1) ((f - 1) / q) := by
  have h := uEnt_binary (s := (univ : Finset (ZMod f)ˣ)) (g := powDeg f q)
    (v := 1) (w := q) (hq.one_lt.ne) (fun u _ => powDeg_prime_dichotomy f hq u)
  rw [h, card_split_classes hf hqf, Finset.card_univ, card_units_prime hf]

/-- **Conductor-freeness.** The type entropy of the degree-`q` rung is
`H(T) = log₂ q − ((q−1)/q) log₂ (q−1)` for *every* admissible conductor. -/
theorem uEnt_powDeg_eq_typeEntropy [NeZero f] (hf : f.Prime) (hq : q.Prime) (hqf : q ∣ f - 1) :
    uEnt (univ : Finset (ZMod f)ˣ) (powDeg f q) = typeEntropy q := by
  obtain ⟨c, hc⟩ := hqf
  have hf1 : 1 ≤ f := hf.one_lt.le
  have hc0 : 0 < c := by
    rcases Nat.eq_zero_or_pos c with rfl | h
    · exfalso
      have : f = 1 := by omega
      exact hf.one_lt.ne' this
    · exact h
  have hdiv : (f - 1) / q = c := by rw [hc, Nat.mul_div_cancel_left c hq.pos]
  rw [uEnt_powDeg_eq_binEnt hf hq ⟨c, hc⟩, hdiv, hc, typeEntropy_prime_eq_binEnt hq,
    Nat.mul_comm q c]
  simpa using binEnt_scale (N := q) (m := 1) (c := c) hc0 Nat.one_pos hq.one_lt

/-- **Two conductors, one entropy.** -/
theorem rung_entropy_conductor_free {f' : ℕ} [NeZero f] [NeZero f'] (hf : f.Prime) (hf' : f'.Prime)
    (hq : q.Prime) (hqf : q ∣ f - 1) (hqf' : q ∣ f' - 1) :
    uEnt (univ : Finset (ZMod f)ˣ) (powDeg f q) = uEnt (univ : Finset (ZMod f')ˣ) (powDeg f' q) := by
  rw [uEnt_powDeg_eq_typeEntropy hf hq hqf, uEnt_powDeg_eq_typeEntropy hf' hq hqf']

/-! ## 3. Full pinning at every prime rung -/

open scoped Classical in
/-- The Frobenius class of `u` in the Galois group of the degree-`q` subfield. -/
noncomputable def frobClass (f q : ℕ) (u : (ZMod f)ˣ) : (ZMod f)ˣ ⧸ powSub f q :=
  QuotientGroup.mk' (powSub f q) u

open scoped Classical in
/-- **FULL PINNING AT EVERY PRIME RUNG.** The Frobenius class in
`Gal(K_q/Q) = (Z/f)ˣ / ((Z/f)ˣ)^q` determines the residue degree, so the
conditional entropy of the type vanishes — no conductor and no primality of `q`
is needed for this half. -/
theorem full_pinning_universal (f q : ℕ) [NeZero f] :
    condEnt (univ : Finset (ZMod f)ˣ) (powDeg f q) (frobClass f q) = 0 := by
  refine condEnt_eq_zero_of_determines fun u _ v _ huv => ?_
  obtain ⟨w, hw, rfl⟩ := (QuotientGroup.mk'_eq_mk' _).1 huv
  exact (powDeg_mul_mem hw).symm

open scoped Classical in
/-- **The channel of a prime rung attains its cap.** -/
theorem mutInfo_powDeg_eq_typeEntropy [NeZero f] (hf : f.Prime) (hq : q.Prime) (hqf : q ∣ f - 1) :
    mutInfo (univ : Finset (ZMod f)ˣ) (powDeg f q) (frobClass f q) = typeEntropy q := by
  rw [mutInfo, full_pinning_universal f q, sub_zero, uEnt_powDeg_eq_typeEntropy hf hq hqf]

/-! ## 4. Instances along the ladder -/

/-- The degree-7 rungs of conductor `29` and conductor `43` carry exactly the same
type entropy: the rung is an invariant of the degree alone. -/
theorem deg7_conductor_29_43_agree :
    uEnt (univ : Finset (ZMod 29)ˣ) (powDeg 29 7)
      = uEnt (univ : Finset (ZMod 43)ˣ) (powDeg 43 7) :=
  rung_entropy_conductor_free (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    (by norm_num)

/-- The degree-7 rung of conductor `43`, a rung never computed by hand, has the
same `0.5916 < H(T) < 0.5918` bracket. -/
theorem deg7_conductor_43_bracket :
    0.5916 < uEnt (univ : Finset (ZMod 43)ˣ) (powDeg 43 7) ∧
      uEnt (univ : Finset (ZMod 43)ˣ) (powDeg 43 7) < 0.5918 := by
  rw [uEnt_powDeg_eq_typeEntropy (by norm_num) (by norm_num) (by norm_num)]
  exact typeEntropy_seven_bracket

/-- The degree-11 rung of conductor `23` — previously proved by hand through the
real cyclotomic construction — is a special case. -/
theorem deg11_conductor_23_entropy :
    uEnt (univ : Finset (ZMod 23)ˣ) (powDeg 23 11) = typeEntropy 11 :=
  uEnt_powDeg_eq_typeEntropy (by norm_num) (by norm_num) (by norm_num)

/-- The degree-3 rung of conductor `7` and the degree-5 rung of conductor `11`,
for completeness of the low ladder. -/
theorem deg3_conductor_7_entropy :
    uEnt (univ : Finset (ZMod 7)ˣ) (powDeg 7 3) = typeEntropy 3 :=
  uEnt_powDeg_eq_typeEntropy (by norm_num) (by norm_num) (by norm_num)

theorem deg5_conductor_11_entropy :
    uEnt (univ : Finset (ZMod 11)ˣ) (powDeg 11 5) = typeEntropy 5 :=
  uEnt_powDeg_eq_typeEntropy (by norm_num) (by norm_num) (by norm_num)

end AbelianLadder