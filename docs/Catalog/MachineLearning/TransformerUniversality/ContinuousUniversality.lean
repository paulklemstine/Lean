import Mathlib

/-!
# Genuine continuous universality on compact sequence domains

`Catalog/MachineLearning/TransformerArchitecture.lean` proves *exact* universality on a finite
domain, and `FiniteLookupSeparation.lean` shows that a quantized finite lookup table can never
be a continuous universal approximator (its uniform error against the identity on `[0,1]` is
at least `1/(2N)`).  This file supplies the missing genuine continuous statement.

The architecture considered here is the closure of the linear-attention *readouts*
`x ↦ ∑ i a, w i a * x i a` under sums and products; products model multiplicative
(gated / feed-forward) mixing layers, and the whole class is the `ℝ`-subalgebra
`attentionAlgebra` of `C(X, ℝ)` generated by the readouts.

Main results:

* `attentionAlgebra_separatesPoints` — readouts already separate sequences;
* `attention_uniform_universal` — **uniform universal approximation**: every continuous
  real-valued functional of a sequence is uniformly `ε`-approximated on every compact set of
  sequences by an element of `attentionAlgebra`;
* `attention_seq2seq_uniform_universal` — the sequence-to-sequence version, uniform in all
  output positions and features simultaneously.

Taken with the separation theorem, this delimits the situation exactly: exact finite lookup is
*not* the continuous theorem, and the continuous theorem needs the multiplicative structure,
not just attention selection.
-/

open scoped BigOperators

namespace ContinuousUniversality

variable {ι κ : Type*} [Fintype ι] [Fintype κ]

/-- The space of length-`ι` sequences of `κ`-dimensional feature vectors. -/
abbrev Seq (ι κ : Type*) := ι → κ → ℝ

/-- A single linear-attention readout with fixed weights, as a continuous map. -/
noncomputable def readoutCM (w : Seq ι κ) : C(Seq ι κ, ℝ) where
  toFun x := ∑ i, ∑ a, w i a * x i a
  continuous_toFun := by
    apply continuous_finset_sum
    intro i _
    apply continuous_finset_sum
    intro a _
    exact continuous_const.mul ((continuous_apply a).comp (continuous_apply i))

/-- The architecture class: the `ℝ`-subalgebra of continuous functionals generated by linear
attention readouts.  Its elements are exactly the finite sums of finite products of readouts,
i.e. attention heads followed by multiplicative mixing. -/
noncomputable def attentionAlgebra (ι κ : Type*) [Fintype ι] [Fintype κ] :
    Subalgebra ℝ C(Seq ι κ, ℝ) :=
  Algebra.adjoin ℝ (Set.range (readoutCM (ι := ι) (κ := κ)))

/-- One-hot weights turn a readout into a coordinate evaluation. -/
theorem readoutCM_oneHot [DecidableEq ι] [DecidableEq κ] (i₀ : ι) (a₀ : κ) (x : Seq ι κ) :
    readoutCM (fun i a => if i = i₀ ∧ a = a₀ then (1:ℝ) else 0) x = x i₀ a₀ := by
  show ∑ i, ∑ a, (if i = i₀ ∧ a = a₀ then (1:ℝ) else 0) * x i a = x i₀ a₀
  rw [Finset.sum_eq_single i₀]
  · rw [Finset.sum_eq_single a₀]
    · simp
    · intro a _ ha; simp [ha]
    · intro h; exact absurd (Finset.mem_univ a₀) h
  · intro i _ hi
    apply Finset.sum_eq_zero
    intro a _
    simp [hi]
  · intro h; exact absurd (Finset.mem_univ i₀) h

/-- **Readouts separate sequences.** -/
theorem attentionAlgebra_separatesPoints :
    (attentionAlgebra ι κ).SeparatesPoints := by
  classical
  intro x y hxy
  obtain ⟨i₀, hi⟩ : ∃ i, x i ≠ y i := by
    by_contra h
    push_neg at h
    exact hxy (funext h)
  obtain ⟨a₀, ha⟩ : ∃ a, x i₀ a ≠ y i₀ a := by
    by_contra h
    push_neg at h
    exact hi (funext h)
  refine ⟨readoutCM (fun i a => if i = i₀ ∧ a = a₀ then (1:ℝ) else 0), ?_, ?_⟩
  · exact ⟨readoutCM (fun i a => if i = i₀ ∧ a = a₀ then (1:ℝ) else 0),
      Algebra.subset_adjoin ⟨_, rfl⟩, rfl⟩
  · rw [readoutCM_oneHot, readoutCM_oneHot]
    exact ha

/-- **Uniform universal approximation on compact sequence domains.**
Every continuous real functional of a sequence is uniformly approximated, to any accuracy, on
any compact set of sequences, by a sum of products of linear-attention readouts. -/
theorem attention_uniform_universal (g : C(Seq ι κ, ℝ)) {K : Set (Seq ι κ)}
    (hK : IsCompact K) {eps : ℝ} (heps : 0 < eps) :
    ∃ p ∈ attentionAlgebra ι κ, ∀ x ∈ K, |(p : Seq ι κ → ℝ) x - g x| < eps := by
  obtain ⟨p, hp, hclose⟩ :=
    ContinuousMap.exists_mem_subalgebra_near_continuous_of_isCompact_of_separatesPoints
      (A := attentionAlgebra ι κ) attentionAlgebra_separatesPoints g hK heps
  exact ⟨p, hp, fun x hx => by simpa [Real.norm_eq_abs] using hclose x hx⟩

/-- **Continuous sequence-to-sequence universality.**  Every continuous map from sequences to
sequences is uniformly approximated on every compact domain, simultaneously in all output
positions and features. -/
theorem attention_seq2seq_uniform_universal
    (F : Seq ι κ → Seq ι κ) (hF : ∀ i a, Continuous fun x => F x i a)
    {K : Set (Seq ι κ)} (hK : IsCompact K) {eps : ℝ} (heps : 0 < eps) :
    ∃ P : ι → κ → C(Seq ι κ, ℝ),
      (∀ i a, P i a ∈ attentionAlgebra ι κ) ∧
      ∀ x ∈ K, ∀ i a, |(P i a : Seq ι κ → ℝ) x - F x i a| < eps := by
  choose P hP hclose using fun (i : ι) (a : κ) =>
    attention_uniform_universal (ι := ι) (κ := κ) ⟨fun x => F x i a, hF i a⟩ hK heps
  exact ⟨P, hP, fun x hx i a => hclose i a x hx⟩

/-- The exact finite lookup theorem is a statement about a finite domain; on a compact
*infinite* domain the readout algebra is what does the approximating.  This lemma records that
every readout is itself in the class, so the continuous theorem strictly extends the linear
attention layer. -/
theorem readout_mem_attentionAlgebra (w : Seq ι κ) :
    readoutCM w ∈ attentionAlgebra ι κ :=
  Algebra.subset_adjoin ⟨w, rfl⟩

end ContinuousUniversality