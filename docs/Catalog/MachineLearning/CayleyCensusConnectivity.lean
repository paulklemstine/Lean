import MachineLearning.CayleyCensusMoments

/-!
# The support of the census is the subgroup generated by the connection set

The invariance results of `MachineLearning.CayleyCensusInvariance` say what the
census cannot see.  This file says what it *does* see: its support recovers the
subgroup generated by the connection set.

For an inversion-closed `S`, the set of `g` reached by at least one `S`-word,
`{g | ∃ n, 0 < walkCount S n g}`, is a subgroup (`reachableSubgroup`), and it
equals `Subgroup.closure S` (`mem_closure_iff_exists_walkCount_pos`).  Two
consequences are recorded: the Cayley graph is connected exactly when `S`
generates (`walkCount_pos_of_closure_eq_top`), and the census of a
non-generating connection set vanishes identically off the generated subgroup
(`walkCount_eq_zero_of_not_mem_closure`).

The multiplicative step uses the concatenation law `walkCount_add`: a single
term of that convolution already witnesses positivity, which is where
`Finset.single_le_sum` enters.

## Main results

* `reachableSubgroup`
* `mem_closure_iff_exists_walkCount_pos`
* `walkCount_pos_of_closure_eq_top`
* `walkCount_eq_zero_of_not_mem_closure`
-/

namespace CayleyCensus

variable {G : Type*} [Group G] [Fintype G] [DecidableEq G]

/-- Positivity is inherited by products: concatenating an `m`-word to `g` with an
`n`-word to `h` gives an `(m+n)`-word to `g * h`. -/
theorem walkCount_mul_pos {S : Finset G} {m n : ℕ} {g h : G}
    (hg : 0 < walkCount S m g) (hh : 0 < walkCount S n h) :
    0 < walkCount S (m + n) (g * h) := by
  rw [walkCount_add]
  have hterm : walkCount S m g * walkCount S n (g⁻¹ * (g * h))
      ≤ ∑ k : G, walkCount S m k * walkCount S n (k⁻¹ * (g * h)) :=
    Finset.single_le_sum (f := fun k => walkCount S m k * walkCount S n (k⁻¹ * (g * h)))
      (fun _ _ => Nat.zero_le _) (Finset.mem_univ g)
  have hpos : 0 < walkCount S m g * walkCount S n (g⁻¹ * (g * h)) := by
    rw [inv_mul_cancel_left]
    exact Nat.mul_pos hg hh
  exact lt_of_lt_of_le hpos hterm

/-- The elements reachable by some `S`-word form a subgroup, provided `S` is
inversion closed. -/
def reachableSubgroup {S : Finset G} (hS : InvClosed S) : Subgroup G where
  carrier := {g | ∃ n, 0 < walkCount S n g}
  one_mem' := ⟨0, by simp⟩
  mul_mem' := by
    rintro a b ⟨m, hm⟩ ⟨n, hn⟩
    exact ⟨m + n, walkCount_mul_pos hm hn⟩
  inv_mem' := by
    rintro a ⟨n, hn⟩
    exact ⟨n, by rwa [walkCount_inv hS]⟩

@[simp] theorem mem_reachableSubgroup {S : Finset G} (hS : InvClosed S) (g : G) :
    g ∈ reachableSubgroup hS ↔ ∃ n, 0 < walkCount S n g := Iff.rfl

omit [Fintype G] in
/-- Every element reached by an `S`-word lies in the subgroup generated by `S`.
The induction peels off the first letter of the word. -/
theorem mem_closure_of_walkCount_pos {S : Finset G} (n : ℕ) (g : G)
    (hn : 0 < walkCount S n g) : g ∈ Subgroup.closure (S : Set G) := by
  induction n generalizing g with
  | zero =>
      by_cases hg : g = 1
      · rw [hg]; exact one_mem _
      · rw [walkCount_zero, if_neg hg] at hn; exact absurd hn (lt_irrefl 0)
  | succ n ih =>
      rw [walkCount_succ] at hn
      obtain ⟨s, hsS, hs⟩ := Finset.exists_ne_zero_of_sum_ne_zero hn.ne'
      have hmem : s⁻¹ * g ∈ Subgroup.closure (S : Set G) :=
        ih _ (Nat.pos_of_ne_zero hs)
      have hsmem : s ∈ Subgroup.closure (S : Set G) :=
        Subgroup.subset_closure (by exact_mod_cast hsS)
      have := mul_mem hsmem hmem
      rwa [mul_inv_cancel_left] at this

/-- **The support of the census is the generated subgroup.** -/
theorem mem_closure_iff_exists_walkCount_pos {S : Finset G} (hS : InvClosed S) (g : G) :
    g ∈ Subgroup.closure (S : Set G) ↔ ∃ n, 0 < walkCount S n g := by
  constructor
  · intro hg
    have hle : Subgroup.closure (S : Set G) ≤ reachableSubgroup hS := by
      refine Subgroup.closure_le _ |>.mpr ?_
      intro s hs
      exact ⟨1, by rw [walkCount_one, if_pos (by exact_mod_cast hs)]; exact Nat.one_pos⟩
    exact hle hg
  · rintro ⟨n, hn⟩
    exact mem_closure_of_walkCount_pos n g hn

/-- If the connection set generates the group, every element is reached at some
length: the Cayley graph is connected. -/
theorem walkCount_pos_of_closure_eq_top {S : Finset G} (hS : InvClosed S)
    (htop : Subgroup.closure (S : Set G) = ⊤) (g : G) : ∃ n, 0 < walkCount S n g :=
  (mem_closure_iff_exists_walkCount_pos hS g).mp (by rw [htop]; exact Subgroup.mem_top g)

/-- Conversely, outside the generated subgroup the census vanishes identically:
the census rows of such elements are the zero row. -/
theorem walkCount_eq_zero_of_not_mem_closure {S : Finset G} (hS : InvClosed S) {g : G}
    (hg : g ∉ Subgroup.closure (S : Set G)) (n : ℕ) : walkCount S n g = 0 := by
  by_contra hne
  exact hg ((mem_closure_iff_exists_walkCount_pos hS g).mpr ⟨n, Nat.pos_of_ne_zero hne⟩)

end CayleyCensus