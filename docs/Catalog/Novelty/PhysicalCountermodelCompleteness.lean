import Bridges.QuantumSystems.LogicPhysicsBridge

/-!
# A nonempty operational countermodel, and the exact completeness boundary

This file answers two of the proposed future directions for the logic–physics
consistency thread, inside the catalog's existing `LogicPhysics` interface
(`ProofSystem`, `Semantics`, `Consistent`, `PhysicallyConsistent`, `Sound`,
`FalsumSound`, `Complete`).

**(3) Constructive physical countermodel.**  Cycle 0 separated mathematical from
physical consistency with an *empty* world type (`math_consistency_not_sufficient`),
a witness one may reasonably dismiss as degenerate.  Here the separation is realized
by a nonempty, finitely presented operational semantics: a two-state switch whose
state space `Bool` is the reachability set of the one-line transition function
`not`.  The finite theory `{on, off}` is mathematically consistent, the semantics is
fully sound, yet no operational state realizes both constraints
(`constructive_physical_countermodel`).  So realizability is a strictly stronger
demand than consistency even for nonempty, finite, decidable physics.

**(4) Completeness boundary for physical semantics.**  We characterize exactly when
the two consistency notions coincide:

`(∀ T, Consistent P T ↔ PhysicallyConsistent M T) ↔ (FalsumSound M ∧ Complete M)`
  (`consistency_equivalence_iff`),

and we show the characterization is sharp on both sides:

* the switch semantics is sound (hence falsum-sound) but incomplete, and the
  equivalence fails (`switch_incomplete`);
* a complete semantics that is not falsum-sound also breaks the equivalence
  (`complete_without_falsumSound_fails`);
* *full* soundness is **not** part of the boundary: there is a semantics satisfying
  the equivalence for every theory which is nevertheless unsound
  (`equivalence_without_full_soundness`).

Finally, any semantics meeting the boundary automatically has a nonempty class of
worlds as soon as the empty theory is consistent (`complete_world_nonempty`),
which is precisely why the degenerate empty-world witness of cycle 0 could never
satisfy the boundary conditions.
-/

namespace LogicPhysics

/-! ## §1. The completeness boundary -/

/-- **The exact completeness boundary.**  For a semantics `M` of a proof system `P`,
mathematical and physical consistency agree on *every* theory if and only if `M` is
falsum-sound and complete.  Note that only falsum-soundness — honesty about
contradictions — appears; full soundness is not part of the characterization
(see `equivalence_without_full_soundness`). -/
theorem consistency_equivalence_iff {S : Type} {P : ProofSystem S} (M : Semantics P) :
    (∀ T : Set S, Consistent P T ↔ PhysicallyConsistent M T) ↔
      (FalsumSound M ∧ Complete M) := by
  constructor
  · intro h
    refine ⟨?_, ?_⟩
    · intro Γ w hpr hsat
      exact absurd hpr ((h Γ).2 ⟨w, hsat⟩)
    · intro T hT
      exact (h T).1 hT
  · rintro ⟨hfs, hc⟩ T
    exact ⟨fun hT => hc T hT, fun hT => model_implies_consistency_weak M hfs hT⟩

/-- A semantics meeting the boundary has a **nonempty** class of worlds, provided the
empty theory is consistent.  Hence the empty-world separation of cycle 0 is never a
boundary case. -/
theorem complete_world_nonempty {S : Type} {P : ProofSystem S} (M : Semantics P)
    (hc : Complete M) (h : Consistent P (∅ : Set S)) : Nonempty M.World := by
  obtain ⟨w, _⟩ := hc ∅ h
  exact ⟨w⟩

/-! ## §2. A nonempty, finitely presented operational semantics

The physics is a **two-state switch**.  Its operational semantics is finitely
presented: the state space is `Bool`, the single transition is `not`, and both states
are reachable.  The language has three sentences: falsum and the two observation
constraints "the switch reads on" and "the switch reads off". -/

/-- The three sentences of the switch language. -/
inductive Switch
  /-- Falsum. -/
  | falsum : Switch
  /-- "The switch reads on." -/
  | on : Switch
  /-- "The switch reads off." -/
  | off : Switch
  deriving DecidableEq

/-- The single transition of the operational semantics: toggling the switch. -/
def switchStep (w : Bool) : Bool := !w

/-- The operational state space is generated by the transition from the initial
state: both states are reachable, so the semantics is finitely presented and
nondegenerate. -/
theorem switchStep_reachable (w : Bool) : ∃ n : ℕ, switchStep^[n] true = w := by
  cases w
  · exact ⟨1, rfl⟩
  · exact ⟨0, rfl⟩

/-- The proof system of the switch language: hypotheses are derivable, and falsum
explodes (ex falso). -/
def switchSys : ProofSystem Switch where
  bot := Switch.falsum
  Proves := fun Γ φ => φ ∈ Γ ∨ Switch.falsum ∈ Γ
  mono := by
    rintro Γ Δ φ hsub (h | h)
    · exact Or.inl (hsub h)
    · exact Or.inr (hsub h)
  assumption := fun h => Or.inl h

/-- The operational semantics: the worlds are the two reachable machine states, an
observation constraint holds exactly when the state matches it, and no state realizes
falsum. -/
def switchSem : Semantics switchSys where
  World := Bool
  sat := fun w φ =>
    match φ with
    | Switch.falsum => False
    | Switch.on => w = true
    | Switch.off => w = false
  bot_unsat := by intro w h; exact h

/-- The class of physical worlds is nonempty. -/
theorem switchSem_nonempty : Nonempty switchSem.World := ⟨true⟩

/-- The class of physical worlds is finite. -/
theorem switchSem_finite : Finite switchSem.World := by
  unfold switchSem
  infer_instance

/-- **The operational semantics is fully sound.** -/
theorem switchSem_sound : Sound switchSem := by
  rintro Γ φ w (h | h) hsat
  · exact hsat φ h
  · exact absurd (hsat Switch.falsum h) (switchSem.bot_unsat w)

/-- The finite theory of the countermodel: the switch is simultaneously constrained
to read on and to read off. -/
def switchTheory : Set Switch := {Switch.on, Switch.off}

/-- The constraint set is finite. -/
theorem switchTheory_finite : switchTheory.Finite :=
  (Set.finite_singleton Switch.off).insert Switch.on

/-- **The constraint set is mathematically consistent**: the proof system cannot
derive falsum from it, since falsum is not among the constraints. -/
theorem switchTheory_consistent : Consistent switchSys switchTheory := by
  rintro (h | h) <;> · rcases h with h | h <;> exact Switch.noConfusion h

/-- **But no operational state realizes it**: a state reads on or reads off, never
both.  This is the constructive replacement for the empty-world witness. -/
theorem switchTheory_not_realizable : ¬ PhysicallyConsistent switchSem switchTheory := by
  rintro ⟨w, hw⟩
  have h1 : w = true := hw Switch.on (Or.inl rfl)
  have h2 : w = false := hw Switch.off (Or.inr rfl)
  rw [h1] at h2
  exact Bool.noConfusion h2

/-- **Future Direction 3, answered.**  Mathematical consistency fails to imply
physical realizability already for a nonempty, finite, fully sound operational
semantics and a finite constraint set: the two-state switch constrained to read on
and off at once. -/
theorem constructive_physical_countermodel :
    ∃ (P : ProofSystem Switch) (M : Semantics P) (T : Set Switch),
      Nonempty M.World ∧ Finite M.World ∧ Sound M ∧ T.Finite ∧
        Consistent P T ∧ ¬ PhysicallyConsistent M T :=
  ⟨switchSys, switchSem, switchTheory, switchSem_nonempty, switchSem_finite,
    switchSem_sound, switchTheory_finite, switchTheory_consistent,
    switchTheory_not_realizable⟩

/-- The switch physics is **incomplete**, and hence sits strictly inside the
completeness boundary: it is sound, but the consistency equivalence fails for the
theory `{on, off}`. -/
theorem switch_incomplete :
    ¬ Complete switchSem ∧
      ¬ (∀ T : Set Switch, Consistent switchSys T ↔ PhysicallyConsistent switchSem T) := by
  constructor
  · intro hc
    exact switchTheory_not_realizable (hc switchTheory switchTheory_consistent)
  · intro h
    exact switchTheory_not_realizable ((h switchTheory).1 switchTheory_consistent)

/-! ## §3. Sharpness of the boundary -/

/-- **Completeness alone is not enough.**  A semantics can realize every consistent
theory and still break the equivalence, by failing falsum-soundness: with the
explosive rule "everything follows from sentence `1`", the theory `{1}` is
inconsistent yet realized. -/
theorem complete_without_falsumSound_fails :
    ∃ (P : ProofSystem ℕ) (M : Semantics P),
      Complete M ∧ ¬ FalsumSound M ∧
        ¬ (∀ T : Set ℕ, Consistent P T ↔ PhysicallyConsistent M T) := by
  let P : ProofSystem ℕ :=
    { bot := 0
      Proves := fun Γ φ => φ ∈ Γ ∨ 1 ∈ Γ
      mono := by
        rintro Γ Δ φ hsub (h | h)
        · exact Or.inl (hsub h)
        · exact Or.inr (hsub h)
      assumption := fun h => Or.inl h }
  let M : Semantics P :=
    { World := Unit
      sat := fun _ φ => φ ≠ 0
      bot_unsat := by intro _ h; exact h rfl }
  have hsat1 : ∀ ψ ∈ ({1} : Set ℕ), M.sat () ψ := by
    intro ψ hψ
    simp only [Set.mem_singleton_iff] at hψ
    subst hψ
    exact one_ne_zero
  refine ⟨P, M, ?_, ?_, ?_⟩
  · intro T hT
    refine ⟨(), ?_⟩
    intro φ hφ hzero
    have h0 : (0 : ℕ) ∈ T := hzero ▸ hφ
    exact hT (Or.inl h0)
  · intro hfs
    exact (hfs (Γ := {1}) () (Or.inr rfl) hsat1) rfl
  · intro h
    have hincon : ¬ Consistent P ({1} : Set ℕ) := by
      intro hcon
      exact hcon (Or.inr rfl)
    exact hincon ((h {1}).2 ⟨(), hsat1⟩)

/-- **Full soundness is not part of the boundary.**  Here is a semantics for which
mathematical and physical consistency agree on *every* theory, although it is not
sound: the world `false` satisfies the premise `1` of the derivation rule while
refuting its conclusion `2`.  Falsum-soundness and completeness, the two boundary
conditions, do hold. -/
theorem equivalence_without_full_soundness :
    ∃ (P : ProofSystem ℕ) (M : Semantics P),
      (∀ T : Set ℕ, Consistent P T ↔ PhysicallyConsistent M T) ∧
        FalsumSound M ∧ Complete M ∧ ¬ Sound M := by
  let P : ProofSystem ℕ :=
    { bot := 0
      Proves := fun Γ φ => φ ∈ Γ ∨ (1 ∈ Γ ∧ φ = 2)
      mono := by
        rintro Γ Δ φ hsub (h | ⟨h1, h2⟩)
        · exact Or.inl (hsub h)
        · exact Or.inr ⟨hsub h1, h2⟩
      assumption := fun h => Or.inl h }
  let M : Semantics P :=
    { World := Bool
      sat := fun w φ => φ ≠ 0 ∧ (w = true ∨ φ ≠ 2)
      bot_unsat := by rintro w ⟨h, -⟩; exact h rfl }
  have hfs : FalsumSound M := by
    rintro Γ w (h | ⟨-, h2⟩) hsat
    · exact hsat 0 h
    · exact absurd h2 (by norm_num)
  have hcomp : Complete M := by
    intro T hT
    refine ⟨true, ?_⟩
    refine fun φ hφ => ⟨?_, Or.inl rfl⟩
    intro hzero
    have h0 : (0 : ℕ) ∈ T := hzero ▸ hφ
    exact hT (Or.inl h0)
  refine ⟨P, M, ?_, hfs, hcomp, ?_⟩
  · exact (consistency_equivalence_iff M).2 ⟨hfs, hcomp⟩
  · intro hs
    have hsat : ∀ ψ ∈ ({1} : Set ℕ), M.sat false ψ := by
      intro ψ hψ
      simp only [Set.mem_singleton_iff] at hψ
      subst hψ
      exact ⟨one_ne_zero, Or.inr (by norm_num)⟩
    have := hs (Γ := {1}) (φ := 2) false (Or.inr ⟨rfl, rfl⟩) hsat
    rcases this.2 with h | h
    · exact Bool.noConfusion h
    · exact h rfl

/-- **Summary of the boundary (Future Direction 4).**  Falsum-soundness together with
completeness is a necessary and sufficient semantic condition for the two consistency
notions to coincide; each condition alone fails, and full soundness is strictly
stronger than needed. -/
theorem completeness_boundary_summary :
    (∀ {S : Type} {P : ProofSystem S} (M : Semantics P),
        (∀ T : Set S, Consistent P T ↔ PhysicallyConsistent M T) ↔
          (FalsumSound M ∧ Complete M)) ∧
      (∃ (P : ProofSystem Switch) (M : Semantics P),
        Sound M ∧ ¬ (∀ T : Set Switch, Consistent P T ↔ PhysicallyConsistent M T)) ∧
      (∃ (P : ProofSystem ℕ) (M : Semantics P),
        Complete M ∧ ¬ (∀ T : Set ℕ, Consistent P T ↔ PhysicallyConsistent M T)) ∧
      (∃ (P : ProofSystem ℕ) (M : Semantics P),
        (∀ T : Set ℕ, Consistent P T ↔ PhysicallyConsistent M T) ∧ ¬ Sound M) := by
  refine ⟨fun M => consistency_equivalence_iff M, ⟨switchSys, switchSem,
      switchSem_sound, switch_incomplete.2⟩, ?_, ?_⟩
  · obtain ⟨P, M, hc, -, hne⟩ := complete_without_falsumSound_fails
    exact ⟨P, M, hc, hne⟩
  · obtain ⟨P, M, heq, -, -, hns⟩ := equivalence_without_full_soundness
    exact ⟨P, M, heq, hns⟩

end LogicPhysics