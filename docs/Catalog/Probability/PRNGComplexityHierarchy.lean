import Probability.PRNGBerlekampMassey
import Probability.PRNGLinearComplexity

/-!
# The linear complexity hierarchy and its saturation at `n = 2L`

Two facts about the family `lfsrWords K L n` of length-`n` files generated by an
order-`L` LFSR, both first observed numerically (see `ComputationalEvidence.md`)
and proved here.

* **Nesting.** `lfsrWords_subset_succ`: an order-`L` file is also an
  order-`(L+1)` file (pad the taps with a leading zero).  Hence
  `lowComplexityWords_eq_lfsrWords`: the union over all orders `≤ M` is just the
  order-`M` family — the classifier hierarchy is a genuine filtration, and the
  quantitative bound `q^{2M+1}` of `PRNGLinearComplexity` can be sharpened to the
  single-order bound `q^{2M}`.

* **Saturation.** `card_lfsrWords_saturate`: for `n ≥ 2L` the number of
  order-`L` files of length `n` does not depend on `n`.  Longer observation
  windows reveal no new order-`L` files: `2L` symbols already separate them all.
  This is the counting shadow of the `2L` determination theorem.
-/

namespace Catalog.Probability.SeedRec

variable {K : Type*} [CommRing K] {L m n : ℕ}

/-- Padding the taps with a leading zero turns an order-`L` recurrence into an
order-`(L+1)` recurrence for the same stream. -/
theorem satisfiesLFSR_succ (c : Fin L → K) (y : ℕ → K) (h : SatisfiesLFSR c y) :
    SatisfiesLFSR (Fin.cons 0 c) y := by
  intro t
  rw [Fin.sum_univ_succ]
  simp only [Fin.cons_zero, Fin.cons_succ, Fin.val_zero, Fin.val_succ, zero_mul, zero_add]
  have hshift : ∀ j : Fin L, t + ((j : ℕ) + 1) = t + 1 + (j : ℕ) := by
    intro j; omega
  simp only [hshift]
  rw [← h (t + 1)]
  congr 1
  omega

/-- Truncating a file to its first `m` symbols. -/
def restrictWord (h : m ≤ n) (x : Fin n → K) : Fin m → K :=
  fun i => x ⟨(i : ℕ), lt_of_lt_of_le i.isLt h⟩

theorem restrictWord_pref {S α : Type*} (g : PRNG S α) (h : m ≤ n) (s : S) :
    restrictWord h (g.pref n s) = g.pref m s := by
  funext i
  rfl

variable (K) [Fintype K] [DecidableEq K]

/-- **Nesting of the complexity hierarchy.** Every order-`L` file is an
order-`(L + 1)` file. -/
theorem lfsrWords_subset_succ (L n : ℕ) [NeZero L] :
    lfsrWords K L n ⊆ lfsrWords K (L + 1) n := by
  intro x hx
  rw [mem_lfsrWords] at hx
  obtain ⟨c, σ, rfl⟩ := hx
  have hsat : SatisfiesLFSR (Fin.cons 0 c) ((lfsrPRNG c).stream σ) :=
    satisfiesLFSR_succ c _ (satisfiesLFSR_stream c σ)
  obtain ⟨τ, hτ⟩ := (lfsr_detect (Fin.cons 0 c) ((lfsrPRNG c).stream σ)).1 hsat
  rw [mem_lfsrWords]
  refine ⟨Fin.cons 0 c, τ, ?_⟩
  funext i
  exact hτ (i : ℕ)

theorem lfsrWords_monotone (n : ℕ) : ∀ {L M : ℕ}, 0 < L → L ≤ M →
    lfsrWords K L n ⊆ lfsrWords K M n := by
  intro L M hL hLM
  obtain ⟨d, rfl⟩ : ∃ d, M = L + d := ⟨M - L, by omega⟩
  induction d with
  | zero => exact fun x hx => hx
  | succ d ih =>
      have : NeZero (L + d) := ⟨by omega⟩
      exact fun x hx =>
        lfsrWords_subset_succ K (L + d) n (ih (by omega) hx)

/-- The union over all orders `≤ M` collapses to the single order `M`. -/
theorem lowComplexityWords_eq_lfsrWords (M n : ℕ) (hM : 0 < M) :
    lowComplexityWords K M n = lfsrWords K M n := by
  ext x
  rw [mem_lowComplexityWords]
  constructor
  · rintro ⟨m, hm, hx⟩
    exact lfsrWords_monotone K n (Nat.succ_pos m) (by omega) hx
  · intro hx
    exact ⟨M - 1, by omega, by rwa [show M - 1 + 1 = M from by omega]⟩

/-- Sharpened rarity bound: at most `q^{2M}` files of length `n` have linear
complexity `≤ M`. -/
theorem card_lowComplexityWords_le' (M n : ℕ) (hM : 0 < M) :
    (lowComplexityWords K M n).card ≤ Fintype.card K ^ (2 * M) := by
  rw [lowComplexityWords_eq_lfsrWords K M n hM]
  exact card_lfsrWords_le K M n

section Saturation

variable [Nontrivial K] (L n : ℕ) [NeZero L]

omit [Nontrivial K] [NeZero L] in
theorem image_restrictWord_lfsrWords (h : 2 * L ≤ n) :
    (lfsrWords K L n).image (restrictWord h) = lfsrWords K L (2 * L) := by
  ext x
  simp only [Finset.mem_image, mem_lfsrWords]
  constructor
  · rintro ⟨z, ⟨c, σ, rfl⟩, rfl⟩
    exact ⟨c, σ, restrictWord_pref (lfsrPRNG c) h σ⟩
  · rintro ⟨c, σ, rfl⟩
    exact ⟨(lfsrPRNG c).pref n σ, ⟨c, σ, rfl⟩, restrictWord_pref (lfsrPRNG c) h σ⟩

/-- **`2L` symbols separate order-`L` files.** Truncation to the first `2L`
symbols is injective on the order-`L` family. -/
theorem restrictWord_injOn_lfsrWords (h : 2 * L ≤ n) :
    Set.InjOn (restrictWord h) (lfsrWords K L n : Set (Fin n → K)) := by
  intro x hx x' hx' hxx
  simp only [Finset.mem_coe, mem_lfsrWords] at hx hx'
  obtain ⟨c, σ, rfl⟩ := hx
  obtain ⟨c', σ', rfl⟩ := hx'
  have hagree : ∀ t < 2 * L, (lfsrPRNG c).stream σ t = (lfsrPRNG c').stream σ' t := by
    intro t ht
    have := congrFun hxx ⟨t, ht⟩
    simpa [restrictWord, PRNG.pref] using this
  funext i
  exact lfsr_stream_determined_by_two_L c c' σ σ' hagree (i : ℕ)

/-- **Saturation.** Beyond `n = 2L` symbols the order-`L` family stops growing:
observing more of the file reveals no further order-`L` candidates. -/
theorem card_lfsrWords_saturate (h : 2 * L ≤ n) :
    (lfsrWords K L n).card = (lfsrWords K L (2 * L)).card := by
  rw [← image_restrictWord_lfsrWords K L n h,
    Finset.card_image_of_injOn (restrictWord_injOn_lfsrWords K L n h)]

end Saturation


section LowerBound

/-- **The order-`L` family is exponentially large.** Already the zero-tap
registers contribute `|K|^L` distinct files, so seed compression really does
cover exponentially many files — the counting bounds above are not vacuous. -/
theorem card_lfsrWords_ge (h : L ≤ n) :
    Fintype.card K ^ L ≤ (lfsrWords K L n).card := by
  classical
  have hinj : Function.Injective fun σ : Fin L → K => (lfsrPRNG (0 : Fin L → K)).pref n σ := by
    intro σ σ' hσ
    have : restrictWord h ((lfsrPRNG (0 : Fin L → K)).pref n σ)
        = restrictWord h ((lfsrPRNG (0 : Fin L → K)).pref n σ') :=
      congrArg (restrictWord h) hσ
    rw [restrictWord_pref, restrictWord_pref] at this
    exact lfsr_pref_injective (0 : Fin L → K) this
  have hsub : (Finset.univ.image fun σ : Fin L → K => (lfsrPRNG (0 : Fin L → K)).pref n σ)
      ⊆ lfsrWords K L n := by
    intro x hx
    simp only [Finset.mem_image] at hx
    obtain ⟨σ, -, rfl⟩ := hx
    rw [mem_lfsrWords]
    exact ⟨0, σ, rfl⟩
  have hcard := Finset.card_le_card hsub
  rwa [Finset.card_image_of_injective _ hinj, Finset.card_univ, Fintype.card_fun,
    Fintype.card_fin] at hcard

end LowerBound

end Catalog.Probability.SeedRec