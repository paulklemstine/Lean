import Cryptography.TypeChannelMilestone.UnifiedLaw
import Cryptography.NonabelianTypeChannel.Fields

/-!
# Degree six: the first nonabelian sextic type channels (open problem 4 of paper 116)

The milestone lists "degree-6 nonabelian type channel" as open.  This file closes it for
the two basic nonabelian sextic Galois groups, in exact closed form.

## The fields

* `x⁶ − 2`: roots `α ζ^k` (`ζ = e^{2πi/6}`), Galois group `D₆` (order 12) acting on
  `k ∈ ℤ/6` by the affine maps `k ↦ k + a` and `k ↦ a − k` (`hexPerm`).  Its derived
  subgroup is the rotation subgroup `C₃ = {k ↦ k + 2j}` and `D₆^ab = C₂ × C₂`.
* The Galois closure of `x³ − 2` (a sextic field, e.g. generated by `∛2 + ω`), Galois
  group `S₃` acting *regularly* on its six conjugates (`S3reg`).

## A faithful sextic splitting type

The catalog readout `splitType = (#fixed points, #points on 2-cycles)` is faithful only up
to degree 4.  In degree 6 it merges the cycle types `6` and `3²`.  We use
`cycleType6 = (#fixed, #points on 2-cycles, #points on 3-cycles)`, which separates all
eleven cycle types of `S₆` (a finite check on the partitions of `6`; the instance relevant
here is `splitType_unfaithful_deg6`).

## Results (`L = log₂ 3`)

| field | `G` | `H(T)` | `I(coset ; T)` | cap `log₂[G:G']` | loss |
|---|---|---|---|---|---|
| `x⁶ − 2` | `D₆` | `1 + 3L/4` | `4/3 + L/4 ≈ 1.7296` | `2` | `2/3 − L/4` |
| closure of `x³ − 2` | `S₃` regular | `2/3 + L/2` | `1` | `1` | `0` |

* `D6_channel`, `D6_loss`, `D6_incomplete` — the `D₆` channel is incomplete: the type
  `2³` occurs both for the half-turn (a rotation) and for the edge reflections.
* `D6_coarse_channel`, `D6_faithful_gain` — with the degree-4 readout the channel would
  be measured as `1 + L/4`: exactly `1/3` bit is lost by the unfaithful readout.  This is a
  concrete warning for any degree-6 experiment re-using the quartic type encoding.
* `S3reg_channel`, `S3reg_entropy_eq_cubic` — **cross-degree universality**: the regular
  sextic realisation of `S₃` has *the same* type entropy and *the same* one-bit channel as
  the cubic realisation `x³ + x + 1`.
-/

namespace TypeChannel

open Finset Real

set_option maxRecDepth 4000000

/-- A faithful splitting type in degree six. -/
def cycleType6 (g : Equiv.Perm (Fin 6)) : ℕ × ℕ × ℕ :=
  ((univ.filter (fun x : Fin 6 => g x = x)).card,
   (univ.filter (fun x : Fin 6 => g x ≠ x ∧ g (g x) = x)).card,
   (univ.filter (fun x : Fin 6 => g x ≠ x ∧ g (g (g x)) = x)).card)

/-- The affine permutations of `ℤ/6`: `k ↦ k + a` and `k ↦ a − k`. -/
def hexPerm (p : Bool × Fin 6) : Equiv.Perm (Fin 6) :=
  if p.1 then Equiv.subLeft p.2 else Equiv.addRight p.2

/-- `D₆`, the Galois group of `x⁶ − 2`, acting on the roots `α ζ^k`. -/
def D6 : Finset (Equiv.Perm (Fin 6)) :=
  {hexPerm (false, 0), hexPerm (false, 1), hexPerm (false, 2), hexPerm (false, 3),
   hexPerm (false, 4), hexPerm (false, 5), hexPerm (true, 0), hexPerm (true, 1),
   hexPerm (true, 2), hexPerm (true, 3), hexPerm (true, 4), hexPerm (true, 5)}

/-- The rotation subgroup `C₃ = {k ↦ k + 2j}`: the derived subgroup of `D₆`. -/
def C3hex : Finset (Equiv.Perm (Fin 6)) :=
  {hexPerm (false, 0), hexPerm (false, 2), hexPerm (false, 4)}

/-- `S₃` acting regularly on six points: the Galois group of the Galois closure of
`x³ − 2` acting on the six conjugates of a primitive element. -/
def S3reg : Finset (Equiv.Perm (Fin 6)) :=
  {hexPerm (false, 0), hexPerm (false, 2), hexPerm (false, 4),
   hexPerm (true, 1), hexPerm (true, 3), hexPerm (true, 5)}

/-- The `C₂ × C₂` coset readout of `D₆ / C₃`: parity of the translation part together
with orientation. -/
def d6Idx (g : Equiv.Perm (Fin 6)) : ℕ :=
  (g 0 : ℕ) % 2 + 2 * (if g 1 = g 0 + 1 then 0 else 1)

set_option maxHeartbeats 4000000 in
lemma D6_isSubgroup : IsSubgroupFinset D6 := ⟨by decide, by decide, by decide⟩
lemma C3hex_isSubgroup : IsSubgroupFinset C3hex := ⟨by decide, by decide, by decide⟩
lemma S3reg_isSubgroup : IsSubgroupFinset S3reg := ⟨by decide, by decide, by decide⟩
set_option maxHeartbeats 4000000 in
lemma D6_derived : IsDerivedFinset D6 C3hex := ⟨by decide, by decide, by decide⟩
lemma S3reg_derived : IsDerivedFinset S3reg C3hex := ⟨by decide, by decide, by decide⟩
lemma D6_coset : IsCosetReadout D6 C3hex d6Idx := by unfold IsCosetReadout; decide
lemma S3reg_coset : IsCosetReadout S3reg C3hex signIdx := by unfold IsCosetReadout; decide

/-- `D₆` is nonabelian (so this is a genuinely nonabelian sextic). -/
theorem D6_nonabelian : ¬ ∀ a ∈ D6, ∀ b ∈ D6, a * b = b * a := by decide

/-- `S₃` acts regularly: no nonidentity element fixes a conjugate. -/
theorem S3reg_regular : ∀ g ∈ S3reg, g ≠ 1 → ∀ x : Fin 6, g x ≠ x := by decide

/-- **The quartic readout is unfaithful in degree six**: it cannot tell the 6-cycle
`k ↦ k + 1` from the double 3-cycle `k ↦ k + 2`, while `cycleType6` can. -/
theorem splitType_unfaithful_deg6 :
    splitType (hexPerm (false, 1)) = splitType (hexPerm (false, 2)) ∧
      cycleType6 (hexPerm (false, 1)) ≠ cycleType6 (hexPerm (false, 2)) := by decide

/-! ### `D₆`: the Galois group of `x⁶ − 2` -/

theorem D6_card : D6.card = 12 := by decide

theorem D6_entropy_type : entropy D6 cycleType6 = 1 + 3/4 * logb 2 3 := by
  rw [entropy_eq_sumList (A := [(6,0,0),(0,0,6),(0,0,0),(0,6,0),(2,4,0)]) (L := [1,2,2,4,3])
      (by decide) (by decide) (by decide), D6_card]
  simp only [List.map, List.sum_cons, List.sum_nil, Nat.cast_ofNat, Nat.cast_one]
  rw [neg_prob_logb_real 1 12 (by norm_num) (by norm_num),
      neg_prob_logb_real 2 12 (by norm_num) (by norm_num),
      neg_prob_logb_real 4 12 (by norm_num) (by norm_num),
      neg_prob_logb_real 3 12 (by norm_num) (by norm_num)]
  rw [logb2_twelve, logb2_two, logb2_four]
  simp only [Real.logb_one]
  ring

theorem D6_entropy_coset : entropy D6 d6Idx = 2 := by
  have himg : (D6.image d6Idx).card = 4 := by decide
  rw [entropy_cosetReadout D6_isSubgroup C3hex_isSubgroup D6_derived.subset D6_coset, himg]
  simpa using logb2_four

theorem D6_entropy_joint : entropy D6 (pairObs d6Idx cycleType6) = 5/3 + 1/2 * logb 2 3 := by
  rw [entropy_eq_sumList
      (A := [(0,(6,0,0)),(0,(0,0,6)),(1,(0,0,0)),(1,(0,6,0)),(2,(2,4,0)),(3,(0,6,0))])
      (L := [1,2,2,1,3,3]) (by decide) (by decide) (by decide), D6_card]
  simp only [List.map, List.sum_cons, List.sum_nil, Nat.cast_ofNat, Nat.cast_one]
  rw [neg_prob_logb_real 1 12 (by norm_num) (by norm_num),
      neg_prob_logb_real 2 12 (by norm_num) (by norm_num),
      neg_prob_logb_real 3 12 (by norm_num) (by norm_num)]
  rw [logb2_twelve, logb2_two]
  simp only [Real.logb_one]
  ring

/-- **The `D₆` sextic channel**: `4/3 + (1/4)·log₂3 ≈ 1.7296` bits. -/
theorem D6_channel : mutualInfo D6 d6Idx cycleType6 = 4/3 + 1/4 * logb 2 3 := by
  rw [mutualInfo, D6_entropy_coset, D6_entropy_type, D6_entropy_joint]
  ring

/-- The `D₆` loss `2/3 − (1/4)·log₂3 ≈ 0.2704` bits, which is strictly positive. -/
theorem D6_loss :
    logb 2 (D6.image d6Idx).card - mutualInfo D6 d6Idx cycleType6 = 2/3 - 1/4 * logb 2 3 ∧
      0 < 2/3 - 1/4 * logb 2 3 := by
  have himg : (D6.image d6Idx).card = 4 := by decide
  refine ⟨?_, by linarith [logb2_three_lt_two]⟩
  rw [himg, D6_channel]
  have : logb 2 ((4:ℕ) : ℝ) = 2 := by simpa using logb2_four
  rw [this]
  ring

/-- Structural reason for the loss: the type `2³` occurs in two different cosets
(the half-turn `k ↦ k + 3` and the edge reflections `k ↦ 1 − k`). -/
theorem D6_incomplete :
    mutualInfo D6 d6Idx cycleType6 ≠ logb 2 (D6.image d6Idx).card := by
  intro h
  have hdet := (typeChannel_complete_iff (T := cycleType6) D6_isSubgroup C3hex_isSubgroup
    D6_derived.subset D6_coset).mp h
  have := hdet (hexPerm (false, 3)) (by decide) (hexPerm (true, 1)) (by decide) (by decide)
  revert this
  decide

theorem D6_entropy_coarse_type : entropy D6 splitType = 2/3 + 3/4 * logb 2 3 := by
  rw [entropy_eq_sumList (A := [(6,0),(0,0),(0,6),(2,4)]) (L := [1,4,4,3])
      (by decide) (by decide) (by decide), D6_card]
  simp only [List.map, List.sum_cons, List.sum_nil, Nat.cast_ofNat, Nat.cast_one]
  rw [neg_prob_logb_real 1 12 (by norm_num) (by norm_num),
      neg_prob_logb_real 4 12 (by norm_num) (by norm_num),
      neg_prob_logb_real 3 12 (by norm_num) (by norm_num)]
  rw [logb2_twelve, logb2_four]
  simp only [Real.logb_one]
  ring

set_option maxHeartbeats 1000000 in
theorem D6_entropy_coarse_joint :
    entropy D6 (pairObs d6Idx splitType) = 5/3 + 1/2 * logb 2 3 := by
  rw [entropy_eq_sumList
      (A := [(0,(6,0)),(0,(0,0)),(1,(0,0)),(1,(0,6)),(2,(2,4)),(3,(0,6))])
      (L := [1,2,2,1,3,3]) (by decide) (by decide) (by decide), D6_card]
  simp only [List.map, List.sum_cons, List.sum_nil, Nat.cast_ofNat, Nat.cast_one]
  rw [neg_prob_logb_real 1 12 (by norm_num) (by norm_num),
      neg_prob_logb_real 2 12 (by norm_num) (by norm_num),
      neg_prob_logb_real 3 12 (by norm_num) (by norm_num)]
  rw [logb2_twelve, logb2_two]
  simp only [Real.logb_one]
  ring

/-- With the quartic readout `splitType` the `D₆` channel would be measured as
`1 + (1/4)·log₂3`. -/
theorem D6_coarse_channel : mutualInfo D6 d6Idx splitType = 1 + 1/4 * logb 2 3 := by
  rw [mutualInfo, D6_entropy_coset, D6_entropy_coarse_type, D6_entropy_coarse_joint]
  ring

/-- **Faithfulness matters in degree six.**  The unfaithful quartic readout loses exactly
`1/3` bit of the `D₆` channel. -/
theorem D6_faithful_gain :
    mutualInfo D6 d6Idx cycleType6 - mutualInfo D6 d6Idx splitType = 1/3 := by
  rw [D6_channel, D6_coarse_channel]; ring

/-- The general sandwich, instantiated: `H(T) − log₂|C₃| ≤ I ≤ log₂ 4`. -/
theorem D6_sandwich :
    max 0 (entropy D6 cycleType6 - logb 2 C3hex.card) ≤ mutualInfo D6 d6Idx cycleType6 ∧
      mutualInfo D6 d6Idx cycleType6 ≤
        min (entropy D6 cycleType6) (logb 2 (D6.image d6Idx).card) :=
  typeChannel_sandwich D6_isSubgroup C3hex_isSubgroup D6_derived.subset D6_coset cycleType6

/-! ### `S₃` regular: the Galois closure of `x³ − 2` -/

theorem S3reg_entropy_type : entropy S3reg cycleType6 = 2/3 + 1/2 * logb 2 3 := by
  have hcard : S3reg.card = 6 := by decide
  rw [entropy_eq_sumList (A := [(6,0,0),(0,0,6),(0,6,0)]) (L := [1,2,3])
      (by decide) (by decide) (by decide), hcard]
  simp only [List.map, List.sum_cons, List.sum_nil, Nat.cast_ofNat, Nat.cast_one]
  rw [neg_prob_logb_real 1 6 (by norm_num) (by norm_num),
      neg_prob_logb_real 2 6 (by norm_num) (by norm_num),
      neg_prob_logb_real 3 6 (by norm_num) (by norm_num)]
  rw [logb2_six, logb2_two]
  simp only [Real.logb_one]
  ring

/-- The regular sextic `S₃` channel is complete: one bit. -/
theorem S3reg_channel : mutualInfo S3reg signIdx cycleType6 = 1 := by
  have himg : (S3reg.image signIdx).card = 2 := by decide
  have hdet : ∀ a ∈ S3reg, ∀ b ∈ S3reg, cycleType6 a = cycleType6 b → signIdx a = signIdx b := by
    decide
  rw [(typeChannel_complete_iff S3reg_isSubgroup C3hex_isSubgroup S3reg_derived.subset
    S3reg_coset).mpr hdet, himg]
  simp

/-- **Cross-degree universality for `S₃`.**  The regular sextic realisation and the cubic
realisation `x³ + x + 1` of `S₃` have identical type entropies and identical channels. -/
theorem S3reg_entropy_eq_cubic :
    entropy S3reg cycleType6 = entropy S3 splitType ∧
      mutualInfo S3reg signIdx cycleType6 = mutualInfo S3 signIdx splitType := by
  rw [S3reg_entropy_type, S3_entropy_type, S3reg_channel, S3_channel]
  exact ⟨rfl, rfl⟩

end TypeChannel