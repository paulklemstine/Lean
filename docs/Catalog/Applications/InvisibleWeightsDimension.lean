import Mathlib
import Applications.InvisibleWeightVectors
import Applications.PowerSumInversion

/-!
# The invisible space has dimension exactly `N + 1 - K`

`Applications/InvisibleWeightVectors.lean` produced an explicit family of `N + 1 - K`
invisible weight vectors (`binWeight K i`, `i < N + 1 - K`), showed that every invisible
vector is a combination of them, and showed the combination is unique.  This file packages
those two facts as a genuine linear-algebra statement:

* `invisibleSpace N K` — the `ℚ`-subspace of `ℕ → ℚ` consisting of the vectors supported on
  the nodes `{0,…,N}` that are invisible to the window `k < K`;
* `invisibleBasis` — the shifted binomial vectors form a basis of it;
* `finrank_invisibleSpace` — **`dim invisibleSpace N K = N + 1 - K`**.

The two extreme cases are exactly the two catalog statements: `K = N + 1` gives dimension
`0`, i.e. the Lagrange engine `eq_zero_of_powerSums_zero`; `K = N` gives dimension `1`,
i.e. the fact that the alternating binomial pair is the *only* near miss at the sharp
window, up to scaling.

-- !-- Lab Notes -- !--

HYPOTHESIS (Hypothesizer).  Counting degrees of freedom, the truncated moment map
`ℚ^{N+1} → ℚ^K` should be surjective (Vandermonde), so its kernel should have dimension
exactly `N + 1 - K`.

EXPERIMENT (Experimenter).  Proved as `finrank_invisibleSpace`, not by proving surjectivity
but by exhibiting the basis directly: independence is the unitriangularity of
`binWeight K i` (top entry `1` at node `i + K`), spanning is the structure theorem.  As a
corollary, the moment map is onto (`exists_weight_of_moments`, built from the
inverse-Vandermonde columns of `PowerSumInversion`), giving rank `K` and nullity
`N + 1 - K`.

ANALYSIS (Analyst).  The dimension formula interpolates the two catalog corners
(`dim = 0` at `K = N+1`, `dim = 1` at `K = N`) and shows the growth is exactly linear:
each unit of window shortening buys precisely one new near-miss direction, generated by a
translate of the previous one.

CRITIQUE (Critic).  `invisibleSpace` must include the support condition `e j = 0` for
`j > N`; without it the "space" is infinite dimensional for trivial reasons (the moments
only see `j ≤ N`), so the dimension statement would be false.  This boundary is recorded in
`invisibleSpace_support`.
-/

open Finset

namespace InvisibleWeights

/-! ## The space of invisible vectors -/

/-- The `ℚ`-subspace of weight vectors supported on the nodes `{0,…,N}` and invisible to
the power-sum window `k < K`. -/
def invisibleSpace (N K : ℕ) : Submodule ℚ (ℕ → ℚ) where
  carrier := {e | (∀ j, N < j → e j = 0) ∧ Invisible N K e}
  add_mem' := by
    rintro a b ⟨ha0, ha⟩ ⟨hb0, hb⟩
    refine ⟨fun j hj => by simp [ha0 j hj, hb0 j hj], fun k hk => ?_⟩
    show moment N (fun j => a j + b j) k = 0
    rw [moment_add, ha k hk, hb k hk, add_zero]
  zero_mem' := ⟨fun _ _ => rfl, fun k _ => by simp [moment]⟩
  smul_mem' := by
    rintro c a ⟨ha0, ha⟩
    refine ⟨fun j hj => by simp [ha0 j hj], fun k hk => ?_⟩
    show moment N (fun j => c * a j) k = 0
    rw [moment_smul, ha k hk, mul_zero]

lemma invisibleSpace_support {N K : ℕ} {e : ℕ → ℚ} (he : e ∈ invisibleSpace N K) :
    ∀ j, N < j → e j = 0 := he.1

lemma invisibleSpace_invisible {N K : ℕ} {e : ℕ → ℚ} (he : e ∈ invisibleSpace N K) :
    Invisible N K e := he.2

lemma mem_invisibleSpace_iff {N K : ℕ} {e : ℕ → ℚ} :
    e ∈ invisibleSpace N K ↔ (∀ j, N < j → e j = 0) ∧ Invisible N K e := Iff.rfl

/-- The shifted binomial vectors, as elements of the invisible space. -/
def binVec (N K : ℕ) (i : Fin (N + 1 - K)) : invisibleSpace N K :=
  ⟨binWeight K (i : ℕ), by
    have hiN : (i : ℕ) + K ≤ N := by have := i.2; omega
    exact ⟨fun j hj => binWeight_of_gt (by omega), binWeight_invisible hiN⟩⟩

@[simp] lemma binVec_coe (N K : ℕ) (i : Fin (N + 1 - K)) :
    ((binVec N K i : invisibleSpace N K) : ℕ → ℚ) = binWeight K (i : ℕ) := rfl

/-! ## The basis -/

theorem binVec_linearIndependent (N K : ℕ) : LinearIndependent ℚ (binVec N K) := by
  rw [Fintype.linearIndependent_iff]
  intro g hg i
  have hval : ∀ j, ∑ i ∈ range (N + 1 - K),
      (if h : i < N + 1 - K then g ⟨i, h⟩ else 0) * binWeight K i j = 0 := by
    intro j
    have hg' := congrArg (fun (v : invisibleSpace N K) => (v : ℕ → ℚ) j) hg
    simp only [Submodule.coe_zero, Pi.zero_apply, AddSubmonoidClass.coe_finset_sum,
      Finset.sum_apply, SetLike.val_smul, Pi.smul_apply, smul_eq_mul, binVec_coe] at hg'
    calc ∑ i ∈ range (N + 1 - K),
          (if h : i < N + 1 - K then g ⟨i, h⟩ else 0) * binWeight K i j
        = ∑ x : Fin (N + 1 - K), g x * binWeight K (x : ℕ) j := by
          rw [← Fin.sum_univ_eq_sum_range
            (fun i => (if h : i < N + 1 - K then g ⟨i, h⟩ else 0) * binWeight K i j) (N + 1 - K)]
          exact Finset.sum_congr rfl fun i _ => by simp [i.2]
      _ = 0 := hg'
  have h0 := coeffs_unique (K := K) (N := N)
    (fun i => if h : i < N + 1 - K then g ⟨i, h⟩ else 0) (N + 1 - K) le_rfl
    (fun j _ => hval j) i i.2
  simpa [i.2] using h0

theorem binVec_span (N K : ℕ) :
    ⊤ ≤ Submodule.span ℚ (Set.range (binVec N K)) := by
  rintro ⟨e, he0, he⟩ -
  rw [Submodule.mem_span_range_iff_exists_fun]
  obtain ⟨c, hc⟩ := exists_coeffs_of_invisible he
  refine ⟨fun i => c (i : ℕ), ?_⟩
  refine Subtype.ext (funext fun j => ?_)
  rw [AddSubmonoidClass.coe_finset_sum]
  simp only [Finset.sum_apply, SetLike.val_smul, Pi.smul_apply, smul_eq_mul, binVec_coe]
  rw [Fin.sum_univ_eq_sum_range (fun i => c i * binWeight K i j) (N + 1 - K)]
  by_cases hj : j ≤ N
  · exact (hc j hj).symm
  · rw [he0 j (by omega)]
    refine Finset.sum_eq_zero fun i hi => ?_
    have hij : i + K < j := by have := mem_range.mp hi; omega
    rw [binWeight_of_gt hij, mul_zero]

/-- **The shifted binomial vectors form a basis of the invisible space.** -/
noncomputable def invisibleBasis (N K : ℕ) :
    Module.Basis (Fin (N + 1 - K)) ℚ (invisibleSpace N K) :=
  Module.Basis.mk (binVec_linearIndependent N K) (binVec_span N K)

/-- **Exact dimension of the invisible space.**  For every window length `K`, the space of
weight vectors on `{0,…,N}` invisible to `p_0, …, p_{K-1}` has dimension `N + 1 - K`. -/
theorem finrank_invisibleSpace (N K : ℕ) :
    Module.finrank ℚ (invisibleSpace N K) = N + 1 - K := by
  rw [Module.finrank_eq_card_basis (invisibleBasis N K), Fintype.card_fin]

/-- Corner case `K = N + 1`: the invisible space is trivial — this *is* the Lagrange engine
`eq_zero_of_powerSums_zero`, recovered as a dimension count. -/
theorem finrank_invisibleSpace_top (N : ℕ) :
    Module.finrank ℚ (invisibleSpace N (N + 1)) = 0 := by
  rw [finrank_invisibleSpace]
  omega

/-- Corner case `K = N`: the invisible space is a line, spanned by the catalog's alternating
binomial vector.  So at the sharp window the near miss is unique up to scaling. -/
theorem finrank_invisibleSpace_sharp (N : ℕ) :
    Module.finrank ℚ (invisibleSpace N N) = 1 := by
  rw [finrank_invisibleSpace]
  omega

/-! ## Surjectivity of the truncated moment map -/

/-- **The truncated moment map is onto.**  For `K ≤ N + 1` every prescribed list of values
`m_0, …, m_{K-1}` is realised by a weight vector supported on the nodes `{0,…,N}`.  Together
with `finrank_invisibleSpace` this is the rank–nullity statement for the moment map:
rank `K`, nullity `N + 1 - K`.  The preimage is built from the columns of the inverse
Vandermonde matrix of `Applications/PowerSumInversion.lean`. -/
theorem exists_weight_of_moments {N K : ℕ} (hK : K ≤ N + 1) (m : ℕ → ℚ) :
    ∃ e : ℕ → ℚ, (∀ j, N < j → e j = 0) ∧ ∀ k < K, moment N e k = m k := by
  classical
  refine ⟨fun j => if j ≤ N then ∑ k' ∈ range K, m k' * PowerSumInversion.vanInv N j k' else 0,
    fun j hj => if_neg (by omega), fun k hk => ?_⟩
  have hkN : k ≤ N := by omega
  rw [moment]
  have hexp : ∀ j ∈ range (N + 1),
      (if j ≤ N then ∑ k' ∈ range K, m k' * PowerSumInversion.vanInv N j k' else 0) * (j : ℚ) ^ k
        = ∑ k' ∈ range K, m k' * (PowerSumInversion.vanInv N j k' * (j : ℚ) ^ k) := by
    intro j hj
    rw [if_pos (Nat.lt_succ_iff.mp (mem_range.mp hj)), Finset.sum_mul]
    exact Finset.sum_congr rfl fun k' _ => by ring
  rw [Finset.sum_congr rfl hexp, Finset.sum_comm]
  have hdual : ∀ k' ∈ range K,
      ∑ j ∈ range (N + 1), m k' * (PowerSumInversion.vanInv N j k' * (j : ℚ) ^ k)
        = m k' * (if k = k' then 1 else 0) := by
    intro k' hk'
    rw [← Finset.mul_sum,
      PowerSumInversion.vanInv_delta_dual hkN (by have := mem_range.mp hk'; omega)]
  rw [Finset.sum_congr rfl hdual]
  simp [mul_ite, Finset.sum_ite_eq, mem_range.mpr hk]

/-- Every unit of window shortening adds exactly one dimension. -/
theorem finrank_invisibleSpace_step {N K : ℕ} (hK : K ≤ N) :
    Module.finrank ℚ (invisibleSpace N K)
      = Module.finrank ℚ (invisibleSpace N (K + 1)) + 1 := by
  rw [finrank_invisibleSpace, finrank_invisibleSpace]
  omega

end InvisibleWeights