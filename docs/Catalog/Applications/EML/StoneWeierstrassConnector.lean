import Mathlib

/-!
# Exp-log coordinates, Stone–Weierstrass, and quantitative interpolation

This file gives a precise bridge between exp-log networks and classical approximation
on compact spaces.  If a compact space embeds continuously into `ℝⁿ`, the algebra
generated by exponentials of its coordinates is dense in its continuous real-valued
functions.  Thus a particularly small EML fragment already satisfies Stone–Weierstrass.

It also records the quantitative mesh estimate behind the exponent `n / α` in
Jackson-type sampling rates, and an exact width-two EML representation of `x²`.
-/

noncomputable section

open scoped NNReal Topology
open Set Real ContinuousMap

namespace EMLStoneWeierstrassConnector

section Density

variable {X : Type*} [TopologicalSpace X]

/-- A continuous exponential coordinate associated to a continuous map into `ℝⁿ`. -/
def expCoordinate {n : ℕ} (ι : C(X, Fin n → ℝ)) (i : Fin n) : C(X, ℝ) where
  toFun x := Real.exp (ι x i)
  continuous_toFun := Real.continuous_exp.comp ((continuous_apply i).comp ι.continuous)

/-- Exponentials of coordinates separate points whenever the coordinate map is injective. -/
theorem expCoordinate_separates {n : ℕ} (ι : C(X, Fin n → ℝ))
    (hι : Function.Injective ι) :
    (Algebra.adjoin ℝ (Set.range (expCoordinate ι))).SeparatesPoints := by
  intro x y hxy
  -- Since ι is injective and x ≠ y, ι x ≠ ι y
  have hne : ι x ≠ ι y := hι.ne hxy
  -- So ∃ i, (ι x) i ≠ (ι y) i
  obtain ⟨i, hi⟩ : ∃ i : Fin n, (ι x) i ≠ (ι y) i := Function.ne_iff.mp hne
  -- expCoordinate ι i is in the range, hence in the adjoin
  refine ⟨expCoordinate ι i, ?_, ?_⟩
  · refine Set.mem_image_of_mem _ (Algebra.subset_adjoin (Set.mem_range_self i))
  · intro heq
    have := Real.exp_injective heq
    exact hi this

/-- **EML–Stone–Weierstrass connector.** On a compact space continuously embedded
in `ℝⁿ`, the algebra generated only by exp, coordinate projections, constants,
addition, and multiplication is dense in all continuous real-valued functions. -/
theorem expCoordinateAlgebra_dense {n : ℕ} [CompactSpace X]
    (ι : C(X, Fin n → ℝ)) (hι : Function.Injective ι) :
    (Algebra.adjoin ℝ (Set.range (expCoordinate ι))).topologicalClosure = ⊤ := by
  exact ContinuousMap.subalgebra_topologicalClosure_eq_top_of_separatesPoints _
    (expCoordinate_separates ι hι)

end Density

section ExplicitSeparation

/-- The scalar exp-log neuron from the mission statement. -/
def expLogNeuron (a b c t : ℝ) : ℝ := Real.exp a * Real.log (b * t + c)

/-- A single exp-log neuron separates any two distinct scalar inputs, with an
explicit positive shift making both logarithm arguments positive. -/
theorem expLogNeuron_separates {x y : ℝ} (hxy : x ≠ y) :
    ∃ a b c : ℝ,
      0 < b ∧ 0 < b * x + c ∧ 0 < b * y + c ∧
        expLogNeuron a b c x ≠ expLogNeuron a b c y := by
  use 0, 1, |x| + |y| + 1
  refine ⟨by norm_num, ?_, ?_, ?_⟩
  · -- 0 < x + |x| + |y| + 1
    cases abs_cases x <;> cases abs_cases y <;> linarith
  · -- 0 < y + |x| + |y| + 1
    cases abs_cases x <;> cases abs_cases y <;> linarith
  · -- exp(0) * log(x + |x| + |y| + 1) ≠ exp(0) * log(y + |x| + |y| + 1)
    simp [expLogNeuron]
    have hpos_x : 0 < x + (|x| + |y| + 1) := by cases abs_cases x <;> cases abs_cases y <;> linarith
    have hpos_y : 0 < y + (|x| + |y| + 1) := by cases abs_cases x <;> cases abs_cases y <;> linarith
    have hne : x + (|x| + |y| + 1) ≠ y + (|x| + |y| + 1) := by
      intro h
      exact hxy (by linarith)
    have hlog_ne : Real.log (x + (|x| + |y| + 1)) ≠ Real.log (y + (|x| + |y| + 1)) := by
      intro h
      exact hne (Real.log_injOn_pos hpos_x hpos_y h)
    exact hlog_ne

/-- Distinct vectors are separated by applying one explicit scalar exp-log neuron
to a coordinate on which they differ. -/
theorem expLogNeuron_separates_vectors {n : ℕ} {x y : Fin n → ℝ} (hxy : x ≠ y) :
    ∃ i : Fin n, ∃ a b c : ℝ,
      0 < b ∧ 0 < b * x i + c ∧ 0 < b * y i + c ∧
        expLogNeuron a b c (x i) ≠ expLogNeuron a b c (y i) := by
  have h_diff : ∃ i : Fin n, x i ≠ y i := by
    by_contra h
    push_neg at h
    exact hxy (funext h)
  obtain ⟨i, hi⟩ := h_diff
  obtain ⟨a, b, c, hb, hx, hy, hne⟩ := expLogNeuron_separates hi
  exact ⟨i, a, b, c, hb, hx, hy, hne⟩

end ExplicitSeparation

section QuantitativeMesh

/-- A Cartesian mesh with `m` choices in each of `d` coordinates has exactly
`m^d` sample sites.  Together with `holder_mesh_error`, choosing
`δ = (ε/(2L))^(1/α)` yields the characteristic sample-count exponent `d/α`. -/
theorem cartesianMesh_card (d m : ℕ) :
    Fintype.card (Fin d → Fin m) = m ^ d := by
  simp

/-- Hölder control in the elementary form needed for a mesh argument. -/
def HolderControl (α L : ℝ) (f : ℝ → ℝ) : Prop :=
  ∀ x y, |f x - f y| ≤ L * |x - y| ^ α

/-- Quantitative interpolation bridge: two `α`-Hölder functions which agree at a
nearby sample differ by at most `2 L δ^α`.  A `δ`-mesh in dimension `d` has
order `δ⁻ᵈ` samples, explaining the exponent `d/α`; realizing an interpolant
with comparable EML width is a separate representation theorem. -/
theorem holder_mesh_error {f g : ℝ → ℝ} {α L δ x s : ℝ}
    (hα : 0 ≤ α) (hL : 0 ≤ L)
    (hf : HolderControl α L f) (hg : HolderControl α L g)
    (hxs : |x - s| ≤ δ) (hmatch : f s = g s) :
    |f x - g x| ≤ 2 * L * δ ^ α := by
  have key : f x - g x = (f x - f s) - (g x - g s) := by rw [hmatch]; ring
  rw [key]
  have h2 : |(f x - f s) - (g x - g s)| ≤ |f x - f s| + |g x - g s| := by
    have a := abs_add_le (f x - f s) (-(g x - g s))
    rwa [abs_neg] at a
  have h3 : |f x - f s| ≤ L * |x - s| ^ α := hf x s
  have h4 : |g x - g s| ≤ L * |x - s| ^ α := hg x s
  have h5 : L * |x - s| ^ α + L * |x - s| ^ α = 2 * L * |x - s| ^ α := by ring
  have h6 : 2 * L * |x - s| ^ α ≤ 2 * L * δ ^ α := by
    apply mul_le_mul_of_nonneg_left _ (by positivity)
    exact rpow_le_rpow (abs_nonneg _) hxs hα
  linarith

end QuantitativeMesh

section ExactSquare

/-- A minimal syntax for finite EML expressions. -/
inductive EMLTerm where
  | const (c : ℝ)
  | var
  | add (p q : EMLTerm)
  | mul (p q : EMLTerm)
  | exp (p : EMLTerm)
  | log (p : EMLTerm)

/-- Semantics of an EML expression. -/
def EMLTerm.eval : EMLTerm → ℝ → ℝ
  | .const c, _ => c
  | .var, x => x
  | .add p q, x => p.eval x + q.eval x
  | .mul p q, x => p.eval x * q.eval x
  | .exp p, x => Real.exp (p.eval x)
  | .log p, x => Real.log (p.eval x)

/-- Leaf width of an expression tree. -/
def EMLTerm.width : EMLTerm → ℕ
  | .const _ => 1
  | .var => 1
  | .add p q => p.width + q.width
  | .mul p q => p.width + q.width
  | .exp p => p.width
  | .log p => p.width

/-- The width-two EML expression computing the square. -/
def squareTerm : EMLTerm := .mul .var .var

theorem squareTerm_width : squareTerm.width = 2 := by
  rfl

/-- `x²` needs no approximation error in the EML grammar: multiplication gives an
exact width-two network, uniformly on `[0,1]` (and in fact on all of `ℝ`). -/
theorem squareTerm_exact (x : ℝ) : squareTerm.eval x = x ^ 2 := by
  simp [squareTerm, EMLTerm.eval, pow_two]

/-- For every width budget at least two and every requested accuracy, an explicit
EML term of width at most that budget approximates `x²` uniformly with error zero. -/
theorem square_approximation_with_width_budget (n : ℕ) (hn : 2 ≤ n) (ε : ℝ)
    (hε : 0 ≤ ε) :
    ∃ p : EMLTerm, p.width ≤ n ∧
      ∀ x ∈ Set.Icc (0 : ℝ) 1, |p.eval x - x ^ 2| ≤ ε := by
  refine ⟨squareTerm, ?_, ?_⟩
  · simpa [squareTerm_width] using hn
  · intro x _hx
    rw [squareTerm_exact, sub_self, abs_zero]
    exact hε

end ExactSquare

end EMLStoneWeierstrassConnector