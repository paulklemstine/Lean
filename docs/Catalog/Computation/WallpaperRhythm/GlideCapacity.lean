import Computation.WallpaperRhythm.QuarterTurnCapacity

/-!
# Glide reflections of a toroidal drum grid

Translations, rotations and reflections of the time–pitch torus were counted in
`Computation.WallpaperRhythm.OrbitCounting` and
`Computation.WallpaperRhythm.QuarterTurnCapacity`.  The remaining generator of a
planar crystallographic group is the *glide reflection*: a reflection composed
with a translation by half a period, which is a symmetry of no point of the
plane.  Musically it is the "inverted answer displaced by half a bar".

This file adds the missing count.  On the `p × q` torus with `p` even the glide

    γ(t, n) = (t + p/2, -n)

is an involution with **no** fixed cell, so Burnside gives exactly `p * q / 2`
orbits and `2 ^ (p * q / 2)` invariant patterns.

## Main results

* `Glides` — the abstract group of order two generated by a glide.
* `glideZMod`, `glideAction` — the glide and its action on the torus.
* `fixedBy_glide_eq_empty` — a glide reflection of a torus is fixed-point free.
* `card_pattern_glide` — the glide capacity is exactly `2 ^ (p * q / 2)`, with
  the numeric instances `card_pattern_glide_four_three` (`2 ^ 6 = 64`) and
  `card_pattern_glide_two_two` (`2 ^ 2 = 4`).
-/

namespace WallpaperRhythm
namespace GlideCapacity

open MulAction OrbitCounting

/-! ## The group of order two generated by a glide -/

/-- The abstract group of order two, acting on a torus by a glide reflection.  It
is a type of its own so that its action cannot clash with the other actions of
this development. -/
def Glides : Type := Multiplicative (ZMod 2)

namespace Glides

instance : Group Glides := inferInstanceAs (Group (Multiplicative (ZMod 2)))
instance : Fintype Glides := inferInstanceAs (Fintype (Multiplicative (ZMod 2)))
instance : DecidableEq Glides := inferInstanceAs (DecidableEq (Multiplicative (ZMod 2)))

/-- The element performing `a` glides. -/
def ofFlips (a : ZMod 2) : Glides := (Multiplicative.ofAdd a : Multiplicative (ZMod 2))

/-- The number of glides an element performs, as a natural number `< 2`. -/
def exp (g : Glides) : ℕ :=
  ZMod.val (Multiplicative.toAdd (g : Multiplicative (ZMod 2)))

@[simp] theorem exp_ofFlips (a : ZMod 2) : exp (ofFlips a) = a.val := rfl

theorem exp_mul (g h : Glides) : exp (g * h) = (exp g + exp h) % 2 := by
  show ZMod.val (Multiplicative.toAdd (g : Multiplicative (ZMod 2))
      + Multiplicative.toAdd (h : Multiplicative (ZMod 2))) = _
  rw [ZMod.val_add]
  rfl

@[simp] theorem exp_one : exp (1 : Glides) = 0 := rfl

theorem card_glides : Nat.card Glides = 2 := by
  show Nat.card (Multiplicative (ZMod 2)) = 2
  simp [Nat.card_eq_fintype_card]

theorem univ_eq : (Finset.univ : Finset Glides) = {ofFlips 0, ofFlips 1} := by
  decide

end Glides

open Glides

/-- Iterating an involution only depends on the exponent modulo two. -/
theorem iterate_mod_two {β : Type*} {f : β → β} (hf : ∀ v, f^[2] v = v) (m : ℕ) (v : β) :
    f^[m] v = f^[m % 2] v := by
  conv_lhs => rw [← Nat.div_add_mod m 2]
  rw [Function.iterate_add_apply]
  generalize f^[m % 2] v = w
  induction m / 2 with
  | zero => simp
  | succ k ih => rw [Nat.mul_succ, Function.iterate_add_apply, hf, ih]

/-! ## The glide reflection of a torus -/

/-- The glide reflection `(t, n) ↦ (t + p/2, -n)` of the `p × q` time–pitch
torus. -/
def glideZMod (p q : ℕ) (v : ZMod p × ZMod q) : ZMod p × ZMod q :=
  (v.1 + ((p / 2 : ℕ) : ZMod p), -v.2)

/-- On a torus of even time period a glide reflection is an involution. -/
theorem glideZMod_iterate_two {p : ℕ} (q : ℕ) (hp : Even p) (v : ZMod p × ZMod q) :
    (glideZMod p q)^[2] v = v := by
  have hhalf : ((p / 2 : ℕ) : ZMod p) + ((p / 2 : ℕ) : ZMod p) = 0 := by
    rw [← Nat.cast_add]
    obtain ⟨m, hm⟩ := hp
    have : p / 2 + p / 2 = p := by omega
    rw [this, ZMod.natCast_self]
  show glideZMod p q (glideZMod p q v) = v
  simp only [glideZMod, neg_neg, add_assoc, hhalf, add_zero]

variable (p q : ℕ)

/-- **The glide action.**  The group of order two acts on the `p × q` torus with `p`
even, the generator acting by the glide reflection. -/
instance glideAction [hp : Fact (Even p)] : MulAction Glides (ZMod p × ZMod q) where
  smul g v := (glideZMod p q)^[exp g] v
  one_smul v := by
    show (glideZMod p q)^[exp (1 : Glides)] v = v
    rw [exp_one]
    rfl
  mul_smul g h v := by
    show (glideZMod p q)^[exp (g * h)] v
      = (glideZMod p q)^[exp g] ((glideZMod p q)^[exp h] v)
    rw [← Function.iterate_add_apply, exp_mul]
    exact (iterate_mod_two (glideZMod_iterate_two q hp.out) _ v).symm

theorem glide_smul [Fact (Even p)] (g : Glides) (v : ZMod p × ZMod q) :
    g • v = (glideZMod p q)^[exp g] v := rfl

theorem fixedBy_glide_one [Fact (Even p)] :
    fixedBy (ZMod p × ZMod q) (ofFlips 0) = Set.univ := by
  ext v
  simp only [mem_fixedBy, glide_smul, exp_ofFlips, Set.mem_univ, iff_true]
  show (glideZMod p q)^[(0 : ZMod 2).val] v = v
  rfl

/-- **A glide reflection of a torus is fixed-point free.**  This is the defining
feature of a glide: no cell is a symmetry centre. -/
theorem fixedBy_glide_eq_empty [NeZero p] [Fact (Even p)] :
    fixedBy (ZMod p × ZMod q) (ofFlips 1) = ∅ := by
  have hp2 : 2 ≤ p := by
    have h2 : p % 2 = 0 := Nat.even_iff.mp (Fact.out (p := Even p))
    have hne : p ≠ 0 := NeZero.ne p
    omega
  have hval : ((1 : ZMod 2)).val = 1 := rfl
  ext v
  simp only [mem_fixedBy, glide_smul, exp_ofFlips, hval, Function.iterate_one,
    Set.mem_empty_iff_false, iff_false]
  intro h
  have h1 : v.1 + ((p / 2 : ℕ) : ZMod p) = v.1 := congrArg Prod.fst h
  have hzero : ((p / 2 : ℕ) : ZMod p) = 0 := by
    have := add_left_cancel (a := v.1) (b := ((p / 2 : ℕ) : ZMod p)) (c := 0)
    simpa using this (by simpa using h1)
  rw [ZMod.natCast_eq_zero_iff] at hzero
  have hlt : p / 2 < p := by omega
  have hpos : 0 < p / 2 := by omega
  exact absurd (Nat.le_of_dvd hpos hzero) (by omega)

/-- **Glide capacity of a toroidal drum grid.**  On the `p × q` torus with `p` even
the patterns invariant under the glide reflection `(t, n) ↦ (t + p/2, -n)` number
exactly `2 ^ (p * q / 2)`. -/
theorem card_pattern_glide [NeZero p] [NeZero q] [Fact (Even p)] :
    Nat.card (GroupInvariantPattern Glides (ZMod p × ZMod q)) = 2 ^ (p * q / 2) := by
  classical
  have hsum : (∑ g : Glides, Nat.card (fixedBy (ZMod p × ZMod q) g)) = p * q := by
    rw [Glides.univ_eq, Finset.sum_insert (by decide), Finset.sum_singleton,
      fixedBy_glide_one p q, fixedBy_glide_eq_empty p q]
    simp [Nat.card_eq_fintype_card, ZMod.card]
  rw [card_groupInvariantPattern_burnside, hsum, Glides.card_glides]

instance : Fact (Even 4) := ⟨by decide⟩

instance : Fact (Even 2) := ⟨by decide⟩

/-- The `4 × 3` torus carries exactly `2 ^ 6 = 64` glide-invariant patterns. -/
theorem card_pattern_glide_four_three :
    Nat.card (GroupInvariantPattern Glides (ZMod 4 × ZMod 3)) = 64 := by
  rw [card_pattern_glide 4 3]
  norm_num

/-- The `2 × 2` torus carries exactly `2 ^ 2 = 4` glide-invariant patterns. -/
theorem card_pattern_glide_two_two :
    Nat.card (GroupInvariantPattern Glides (ZMod 2 × ZMod 2)) = 4 := by
  rw [card_pattern_glide 2 2]
  norm_num

end GlideCapacity
end WallpaperRhythm