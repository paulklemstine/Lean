import Mathlib
import Geometry.MissingDataCohomology

/-!
# The calibration obstruction of an arbitrary nerve is its first Betti number

`Catalog/Computation/DatabaseHolonomy.lean` and
`Catalog/Computation/DatabaseNerveBetti.lean` compute the calibration
cohomology of two special overlap patterns: the `m`-cycle (`dim H¹ = 1`) and the
star (`dim H¹ = 0`).  The general statement was left as a conjecture in
`FUTURE_DIRECTIONS.md`.  This file proves it, for an arbitrary finite overlap
pattern (a finite *multigraph* of data sources, given as a finite family of
oriented overlaps `E : ι → V × V`):

  `dim H¹ + #sources = #overlaps + #(connected components of the nerve)`,

that is, `dim H¹ = b₁(nerve) = |E| − |V| + c`, in every characteristic.

Main results.
* `finrank_ker_dNerve` — the calibrations invisible on all overlaps are exactly
  the functions constant on connected components of the nerve, so the kernel of
  the coboundary has dimension the number of components.
* `finrank_H1_nerve` — the Betti-number formula.
* `finrank_H1_nerve_connected` — for a connected nerve, `dim H¹ = |E| − |V| + 1`.
* `h1_vanishes_iff_forest` — the calibration problem is always solvable exactly
  when the nerve is a forest (`|E| + c = |V|`).
* `finrank_H1_theta` — a worked instance with `dim H¹ = 2`: two data sources
  compared through three independent overlaps carry two independent unfixable
  inconsistencies.  Redundant comparisons, not missing data, create obstructions.

-- !-- Lab Notes -- !--
Hypothesis (C1 of the previous cycle): for an arbitrary overlap graph the
calibration complex has `dim H¹ = b₁(nerve)`.
Experiment: replace the two hand-computed nerves by an arbitrary finite family
of oriented overlaps and compute the kernel of the coboundary
`(d s) i = s (E i).1 − s (E i).2` directly.
Analysis: `s` lies in the kernel iff `s` is constant along every overlap, hence
constant on every class of the equivalence relation generated by the overlaps;
pulling back along `Quotient.mk` is an injective linear map onto that kernel, so
`dim ker = c`.  Rank–nullity plus the catalog's `finrank_H1_formula` gives
`dim H¹ = |ι| − |V| + c`.  No finiteness or characteristic assumption on the
field is used, and multiple overlaps between the same pair of sources are
allowed — indeed `finrank_H1_theta` shows they raise the obstruction dimension.
Critique: the model keeps triple overlaps empty (`C² = 0`); a nerve with
nonempty triple overlaps would add a `d¹` term and could only lower `dim H¹`.
The result is therefore an upper bound for the general simplicial situation and
an equality for nerves of dimension one.
Synthesis: the previous cycle's cycle/star dichotomy is the two extreme cases of
one formula; the number of independent unfixable calibration inconsistencies in
a data-integration problem is a topological invariant of the overlap pattern.
-- !-- Lab Notes -- !--
-/

open MissingDataCohomology

namespace DatabaseNerveGeneral

variable (𝕜 : Type*) [Field 𝕜] {V ι : Type*}

/-! ### The nerve of a family of pairwise overlaps -/

/-- Two sources are directly comparable when some overlap relates them. -/
def edgeRel (E : ι → V × V) : V → V → Prop := fun a b => ∃ i, E i = (a, b)

/-- Connectivity in the nerve: the equivalence relation generated by the
overlaps. -/
def nerveSetoid (E : ι → V × V) : Setoid V := Relation.EqvGen.setoid (edgeRel E)

/-- The connected components of the nerve. -/
abbrev Comp (E : ι → V × V) := Quotient (nerveSetoid E)

/-- The calibration coboundary: a per-source recalibration `s` induces on each
overlap the offset between the two calibrations it compares. -/
def dNerve (E : ι → V × V) : (V → 𝕜) →ₗ[𝕜] (ι → 𝕜) where
  toFun s := fun i => s (E i).1 - s (E i).2
  map_add' s t := by funext i; simp; ring
  map_smul' a s := by funext i; simp; ring

@[simp] lemma dNerve_apply (E : ι → V × V) (s : V → 𝕜) (i : ι) :
    dNerve 𝕜 E s i = s (E i).1 - s (E i).2 := rfl

lemma mem_ker_dNerve_iff (E : ι → V × V) (s : V → 𝕜) :
    s ∈ LinearMap.ker (dNerve 𝕜 E) ↔ ∀ i, s (E i).1 = s (E i).2 := by
  constructor
  · intro hs i
    have := congrFun (LinearMap.mem_ker.1 hs) i
    simpa [sub_eq_zero] using this
  · intro h
    apply LinearMap.mem_ker.2
    funext i
    simp [h i]

omit [Field 𝕜] in
/-- A calibration invisible on every overlap is constant on each connected
component of the nerve. -/
lemma const_on_comp {E : ι → V × V} {s : V → 𝕜} (hs : ∀ i, s (E i).1 = s (E i).2)
    {a b : V} (hab : (nerveSetoid E).r a b) : s a = s b := by
  induction hab with
  | rel x y hxy =>
      obtain ⟨i, hi⟩ := hxy
      have h := hs i
      rw [hi] at h
      exact h
  | refl x => rfl
  | symm x y _ ih => exact ih.symm
  | trans x y z _ _ ih₁ ih₂ => exact ih₁.trans ih₂

/-- Pulling a function back from the components of the nerve. -/
noncomputable def pullback (E : ι → V × V) :
    (Comp E → 𝕜) →ₗ[𝕜] (V → 𝕜) :=
  LinearMap.funLeft 𝕜 𝕜 (fun v : V => (Quotient.mk (nerveSetoid E) v))

lemma pullback_injective (E : ι → V × V) : Function.Injective (pullback 𝕜 E) :=
  LinearMap.funLeft_injective_of_surjective 𝕜 𝕜 _ (Quotient.mk_surjective)

/-- **The invisible calibrations are exactly the locally constant ones.** -/
theorem range_pullback (E : ι → V × V) :
    LinearMap.range (pullback 𝕜 E) = LinearMap.ker (dNerve 𝕜 E) := by
  apply le_antisymm
  · rintro _ ⟨g, rfl⟩
    refine (mem_ker_dNerve_iff 𝕜 E _).2 fun i => ?_
    have : (nerveSetoid E).r (E i).1 (E i).2 :=
      Relation.EqvGen.rel _ _ ⟨i, by simp⟩
    exact congrArg g (Quotient.sound this)
  · intro s hs
    have h := (mem_ker_dNerve_iff 𝕜 E s).1 hs
    refine ⟨Quotient.lift s (fun a b hab => const_on_comp 𝕜 h hab), ?_⟩
    funext v
    rfl

/-- **The kernel of the calibration coboundary has dimension the number of
connected components of the nerve.** -/
theorem finrank_ker_dNerve (E : ι → V × V) [Finite V] :
    Module.finrank 𝕜 (LinearMap.ker (dNerve 𝕜 E)) = Nat.card (Comp E) := by
  classical
  haveI : Fintype (Comp E) := Fintype.ofFinite _
  have hiso : (Comp E → 𝕜) ≃ₗ[𝕜] LinearMap.range (pullback 𝕜 E) :=
    LinearEquiv.ofInjective _ (pullback_injective 𝕜 E)
  have h1 : Module.finrank 𝕜 (LinearMap.range (pullback 𝕜 E))
      = Module.finrank 𝕜 (Comp E → 𝕜) := (hiso.finrank_eq).symm
  rw [← range_pullback 𝕜 E, h1, Module.finrank_fintype_fun_eq_card,
    Nat.card_eq_fintype_card]

/-! ### The cohomology of an arbitrary nerve -/

/-- The calibration complex of an arbitrary finite family of pairwise overlaps
between data sources.  Triple overlaps are empty, so there is no degree-two
constraint. -/
def nerveComplex [Fintype V] [Fintype ι] (E : ι → V × V) : DataComplex 𝕜 where
  C0 := V → 𝕜
  C1 := ι → 𝕜
  C2 := Fin 0 → 𝕜
  d0 := dNerve 𝕜 E
  d1 := 0
  d_sq := by simp

/-- **The calibration obstruction is the first Betti number of the nerve.**
For an arbitrary finite overlap pattern between data sources, over an arbitrary
field,
`dim H¹ + #sources = #overlaps + #components`, i.e. `dim H¹ = |E| − |V| + c`. -/
theorem finrank_H1_nerve [Fintype V] [Fintype ι] (E : ι → V × V) :
    Module.finrank 𝕜 (nerveComplex 𝕜 E).H1 + Fintype.card V
      = Fintype.card ι + Nat.card (Comp E) := by
  have hform := (nerveComplex 𝕜 E).finrank_H1_formula
  have hd1 : Module.finrank 𝕜 (LinearMap.range (nerveComplex 𝕜 E).d1) = 0 := by
    simp [nerveComplex]
  have hC1 : Module.finrank 𝕜 (nerveComplex 𝕜 E).C1 = Fintype.card ι := by
    simp [nerveComplex]
  have hC0 : Module.finrank 𝕜 (nerveComplex 𝕜 E).C0 = Fintype.card V := by
    simp [nerveComplex]
  have hrn := LinearMap.finrank_range_add_finrank_ker (nerveComplex 𝕜 E).d0
  have hker : Module.finrank 𝕜 (LinearMap.ker (nerveComplex 𝕜 E).d0) = Nat.card (Comp E) :=
    finrank_ker_dNerve 𝕜 E
  rw [hker, hC0] at hrn
  rw [hd1, hC1] at hform
  omega

/-- A nerve is connected when every two sources are linked by a chain of
overlaps. -/
def NerveConnected (E : ι → V × V) : Prop := ∀ a b : V, (nerveSetoid E).r a b

lemma card_comp_of_connected [Nonempty V] {E : ι → V × V} (h : NerveConnected E) :
    Nat.card (Comp E) = 1 := by
  haveI : Subsingleton (Comp E) := by
    constructor
    intro x y
    induction x using Quotient.inductionOn with
    | h a =>
        induction y using Quotient.inductionOn with
        | h b => exact Quotient.sound (h a b)
  haveI : Nonempty (Comp E) := ⟨Quotient.mk _ (Classical.arbitrary V)⟩
  haveI : Unique (Comp E) := uniqueOfSubsingleton (Classical.arbitrary (Comp E))
  simp

/-- **Betti-number formula for a connected nerve.** With `V` sources pairwise
compared through `ι` overlaps forming a connected pattern, the number of
independent unfixable calibration inconsistencies is `|ι| − |V| + 1`. -/
theorem finrank_H1_nerve_connected [Fintype V] [Nonempty V] [Fintype ι] (E : ι → V × V)
    (h : NerveConnected E) :
    Module.finrank 𝕜 (nerveComplex 𝕜 E).H1 + Fintype.card V = Fintype.card ι + 1 := by
  rw [finrank_H1_nerve 𝕜 E, card_comp_of_connected h]

/-- **Solvability criterion.** All prescribed offsets can be realised by
per-source recalibrations exactly when the nerve is a forest, i.e. when the
number of overlaps plus the number of components equals the number of
sources. -/
theorem h1_vanishes_iff_forest [Fintype V] [Fintype ι] (E : ι → V × V) :
    Module.finrank 𝕜 (nerveComplex 𝕜 E).H1 = 0
      ↔ Fintype.card ι + Nat.card (Comp E) = Fintype.card V := by
  have h := finrank_H1_nerve 𝕜 E
  omega

/-! ### A worked instance: redundant comparisons create obstructions -/

/-- Two data sources compared through three independent overlaps (a "theta"
nerve): `V = Fin 2`, three parallel overlaps. -/
def thetaEdges : Fin 3 → Fin 2 × Fin 2 := fun _ => (0, 1)

lemma thetaConnected : NerveConnected thetaEdges := by
  have h01 : (nerveSetoid thetaEdges).r 0 1 :=
    Relation.EqvGen.rel _ _ ⟨0, rfl⟩
  intro a b
  fin_cases a <;> fin_cases b
  · exact Relation.EqvGen.refl _
  · exact h01
  · exact Relation.EqvGen.symm _ _ h01
  · exact Relation.EqvGen.refl _

/-- **Two independent inconsistencies from redundant comparisons.** Two sources
whose calibrations are compared in three independent ways carry a
two-dimensional obstruction: `dim H¹ = 3 − 2 + 1 = 2`.  No data is missing here;
the obstruction is created purely by the redundancy of the overlap pattern. -/
theorem finrank_H1_theta :
    Module.finrank 𝕜 (nerveComplex 𝕜 thetaEdges).H1 = 2 := by
  have h := finrank_H1_nerve_connected 𝕜 thetaEdges thetaConnected
  simp only [Fintype.card_fin] at h
  omega

/-! ### Consistency with the previously computed cyclic nerve -/

/-- The `m`-cycle as a family of oriented overlaps. -/
def cycleEdges (m : ℕ) [NeZero m] : ZMod m → ZMod m × ZMod m := fun i => (i, i + 1)

lemma cycleConnected (m : ℕ) [NeZero m] : NerveConnected (cycleEdges m) := by
  have step : ∀ i : ZMod m, (nerveSetoid (cycleEdges m)).r i (i + 1) := fun i =>
    Relation.EqvGen.rel _ _ ⟨i, rfl⟩
  have hnat : ∀ n : ℕ, (nerveSetoid (cycleEdges m)).r 0 ((n : ℕ) : ZMod m) := by
    intro n
    induction n with
    | zero => simpa using Relation.EqvGen.refl (0 : ZMod m)
    | succ n ih =>
        have h := step ((n : ℕ) : ZMod m)
        have := Relation.EqvGen.trans _ _ _ ih h
        simpa [Nat.cast_succ] using this
  intro a b
  have ha := hnat a.val
  have hb := hnat b.val
  rw [ZMod.natCast_rightInverse a] at ha
  rw [ZMod.natCast_rightInverse b] at hb
  exact Relation.EqvGen.trans _ _ _ (Relation.EqvGen.symm _ _ ha) hb

/-- **The cycle formula, recovered from the general Betti-number theorem.** For
`m` sources arranged in a cycle the general formula gives `dim H¹ = 1`, in
agreement with `DatabaseNerveBetti.finrank_H1_cycle`, which was proved by an
independent explicit computation. -/
theorem finrank_H1_cycleEdges (m : ℕ) [NeZero m] :
    Module.finrank 𝕜 (nerveComplex 𝕜 (cycleEdges m)).H1 = 1 := by
  have h := finrank_H1_nerve_connected 𝕜 (cycleEdges m) (cycleConnected m)
  have hcard : Fintype.card (ZMod m) = m := ZMod.card m
  rw [hcard] at h
  omega

end DatabaseNerveGeneral