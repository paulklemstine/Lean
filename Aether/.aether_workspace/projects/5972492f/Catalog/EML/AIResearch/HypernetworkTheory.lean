/-- Standard hypernetwork: maps context → target weights -/
def stdHypernetParams (contextDim targetWeights : ℕ) : ℕ :=
  contextDim * targetWeights

/-- EML hypernetwork: compressed mapping -/
def emlHypernetParams (contextDim targetWeights : ℕ) : ℕ :=
  4 * targetWeights

/-- [Section: ## §1. Hypernetwork Architecture] -/
theorem eml_hypernet_compact (cd tw : ℕ) (hcd : 4 ≤ cd) :
    emlHypernetParams cd tw ≤ stdHypernetParams cd tw := by
  -- Since $cd \geq 4$, we have $4 * tw \leq cd * tw$ for any $tw \geq 0$.
  apply Nat.mul_le_mul_right tw hcd

/-- Standard target network weights -/
def stdTargetParams (numLayers d_model : ℕ) : ℕ :=
  numLayers * (d_model * d_model)

/-- EML target network weights (generated by hypernetwork) -/
def emlTargetParams (numLayers d_model : ℕ) : ℕ :=
  numLayers * (4 * d_model)

/-- [Section: ## §2. Target Weight Generation] -/
theorem eml_target_compact (nL dm : ℕ) (hdm : 4 ≤ dm) :
    emlTargetParams nL dm ≤ stdTargetParams nL dm := by
  -- By dividing both sides of the inequality by $nL$ (assuming $nL \neq 0$), we get $4 * dm \leq dm * dm$.
  have h_div : 4 * dm ≤ dm * dm := by
    -- Since $dm \geq 4$, we can divide both sides of the inequality $4 * dm \leq dm * dm$ by $dm$ (which is positive), yielding $4 \leq dm$.
    nlinarith;
  -- Since $nL$ is a natural number, multiplying both sides of the inequality $4 * dm \leq dm * dm$ by $nL$ preserves the inequality.
  apply Nat.mul_le_mul_left nL h_div

/-- Cost of generating weights dynamically -/
def weightGenCost (hypernetCost targetSize : ℕ) : ℕ :=
  hypernetCost + targetSize

/-- [Section: ## §3. Dynamic Weight Cost] -/
theorem eml_weight_gen_cheaper (hc_eml hc_std ts_eml ts_std : ℕ)
    (hhc : hc_eml ≤ hc_std) (hts : ts_eml ≤ ts_std) :
    weightGenCost hc_eml ts_eml ≤ weightGenCost hc_std ts_std := by
  -- By definition of weightGenCost, we have weightGenCost hc_eml ts_eml = hc_eml + ts_eml and weightGenCost hc_std ts_std = hc_std + ts_std.
  simp [weightGenCost];
  grind +splitImp

/-- Cost of serving N tasks with a hypernetwork -/
def multiTaskHyperCost (numTasks hypernetSize : ℕ) : ℕ :=
  hypernetSize + numTasks  -- shared hypernet + task embeddings

/-- Cost of serving N tasks with separate models -/
def multiTaskSeparateCost (numTasks modelSize : ℕ) : ℕ :=
  numTasks * modelSize

/-- [Section: ## §4. Multi-Task Hypernetwork] -/
theorem hypernet_scales_better (nt hs ms : ℕ) (hnt : 1 ≤ nt) (hms : hs + nt ≤ nt * ms) :
    multiTaskHyperCost nt hs ≤ multiTaskSeparateCost nt ms := by
  -- By definition of multiTaskHyperCost and multiTaskSeparateCost, we can rewrite the goal using hms.
  convert hms using 1

/-- Total hypernetwork system: hypernet + generated target -/
def totalHyperSystem (hyperParams targetParams : ℕ) : ℕ :=
  hyperParams + targetParams

/-- [Section: ## §5. Compound Compression] -/
theorem eml_total_hyper_compact (hp_eml hp_std tp_eml tp_std : ℕ)
    (hhp : hp_eml ≤ hp_std) (htp : tp_eml ≤ tp_std) :
    totalHyperSystem hp_eml tp_eml ≤ totalHyperSystem hp_std tp_std := by
