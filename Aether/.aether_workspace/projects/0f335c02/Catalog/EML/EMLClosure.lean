/-
# EML Stone–Weierstrass Theorem

This file proves that the subalgebra generated by EML (Exponential-Multiplicative-Logarithmic)
functions on any nonempty compact subset of `Fin n → ℝ` is dense in the space of all continuous
real-valued functions, via the Stone–Weierstrass theorem.

## Main result

`eml_stoneWeierstrass`: The EML-generated subalgebra separates points and its topological
closure equals the full algebra `C(K, ℝ)`, establishing EML as a universal approximator.
-/

import Mathlib

open scoped BigOperators
open Finset

set_option maxHeartbeats 4000000

noncomputable section

variable {n : ℕ}

/-- The affine functional `x ↦ ∑ i, w i * x i + b`, continuous on any subtype of `Fin n → ℝ`. -/
def emlAffineCont (K : Set (Fin n → ℝ)) (w : Fin n → ℝ) (b : ℝ) : C(↥K, ℝ) :=
  ⟨fun x => ∑ i, w i * (x : Fin n → ℝ) i + b,
   (continuous_finset_sum _ (fun i _ =>
     continuous_const.mul ((continuous_apply i).comp continuous_subtype_val))).add continuous_const⟩

/-- The EML exponential generator: `x ↦ exp(∑ i, w i * x i + b)`. -/
def emlExpGen (K : Set (Fin n → ℝ)) (w : Fin n → ℝ) (b : ℝ) : C(↥K, ℝ) :=
  ⟨fun x => Real.exp (emlAffineCont K w b x),
   Real.continuous_exp.comp (emlAffineCont K w b).continuous⟩

/-- The EML generators: exponential functions of affine functionals. -/
def emlGenerators (K : Set (Fin n → ℝ)) : Set C(↥K, ℝ) :=
  {f | ∃ (w : Fin n → ℝ) (b : ℝ), f = emlExpGen K w b}

/-- The EML subalgebra: the ℝ-subalgebra of C(K, ℝ) generated by exponential generators. -/
def emlSubalgebra (K : Set (Fin n → ℝ)) : Subalgebra ℝ C(↥K, ℝ) :=
  Algebra.adjoin ℝ (emlGenerators K)

/-! ## Step 1: The EML subalgebra separates points -/

/-
The sum `∑ i, (x i - y i)^2` is positive when `x ≠ y`.
-/
lemma sum_sq_pos_of_ne {x y : Fin n → ℝ} (hne : x ≠ y) :
    0 < ∑ i : Fin n, (x i - y i) ^ 2 := by
  exact lt_of_le_of_ne ( Finset.sum_nonneg fun i _ => sq_nonneg _ ) ( Ne.symm fun h => hne <| funext fun i => by simpa [ sub_eq_zero ] using Finset.sum_eq_zero_iff_of_nonneg ( fun _ _ => sq_nonneg _ ) |>.1 h i )

/-
Key computation: the difference of the affine functional at x and y equals `∑ (xᵢ-yᵢ)²`
    when `w i = x i - y i` and `b = 0`.
-/
lemma emlAffine_diff_eq_sum_sq (K : Set (Fin n → ℝ))
    (x y : Fin n → ℝ) (hx : x ∈ K) (hy : y ∈ K) :
    emlAffineCont K (fun i => x i - y i) 0 ⟨x, hx⟩ -
    emlAffineCont K (fun i => x i - y i) 0 ⟨y, hy⟩ =
    ∑ i : Fin n, (x i - y i) ^ 2 := by
  unfold emlAffineCont; norm_num [ sub_mul, sq ] ;
  simpa only [ mul_sub, Finset.sum_sub_distrib ] using by ring;

/-
The exp generator separates distinct points of K.
-/
lemma emlExpGen_separates (K : Set (Fin n → ℝ))
    {x y : Fin n → ℝ} (hx : x ∈ K) (hy : y ∈ K) (hne : x ≠ y) :
    emlExpGen K (fun i => x i - y i) 0 ⟨x, hx⟩ ≠
    emlExpGen K (fun i => x i - y i) 0 ⟨y, hy⟩ := by
  -- By definition of exponential generator, we know that it separates distinct points.
  by_contra h_eq;
  exact hne <| by simpa using sum_sq_pos_of_ne hne |> fun h => by have := emlAffine_diff_eq_sum_sq K x y hx hy; exact absurd h_eq <| ne_of_gt <| Real.exp_lt_exp.mpr <| by linarith;

/-
The EML subalgebra separates points of K.
-/
theorem emlSubalgebra_separatesPoints (K : Set (Fin n → ℝ))
    (hK : IsCompact K) :
    letI : CompactSpace ↥K := isCompact_iff_compactSpace.mp hK;
    (emlSubalgebra K).SeparatesPoints := by
  have h_separates : ∀ x y : ↥K, x ≠ y → ∃ f ∈ emlGenerators K, f x ≠ f y := by
    exact fun x y hxy => ⟨ _, ⟨ _, _, rfl ⟩, emlExpGen_separates K x.2 y.2 ( by simpa [ Subtype.ext_iff ] using hxy ) ⟩;
  intro x y hxy;
  obtain ⟨ f, hf₁, hf₂ ⟩ := h_separates x y hxy;
  exact ⟨ f, ⟨ f, Algebra.subset_adjoin hf₁, rfl ⟩, hf₂ ⟩

/-! ## Step 2: Apply Stone–Weierstrass for density -/

/-- **EML Stone–Weierstrass Theorem.**
The EML-generated subalgebra on any nonempty compact subset of `Fin n → ℝ`
separates points and has topological closure equal to `C(K, ℝ)`,
establishing EML as a universal approximator.

More precisely:
1. The subalgebra separates points: for distinct `x, y ∈ K`, there is an EML generator
   taking different values at `x` and `y`.
2. The topological closure of the subalgebra is `⊤ = C(K, ℝ)` (by Stone–Weierstrass).
-/
theorem eml_stoneWeierstrass (_hn : 1 ≤ n) (K : Set (Fin n → ℝ))
    (hK : IsCompact K) (_hKne : K.Nonempty) :
    letI : CompactSpace ↥K := isCompact_iff_compactSpace.mp hK;
    (emlSubalgebra K).SeparatesPoints ∧
    (emlSubalgebra K).topologicalClosure = ⊤ := by
  letI : CompactSpace ↥K := isCompact_iff_compactSpace.mp hK
  constructor
  · exact emlSubalgebra_separatesPoints K hK
  · exact ContinuousMap.subalgebra_topologicalClosure_eq_top_of_separatesPoints _
      (emlSubalgebra_separatesPoints K hK)

end