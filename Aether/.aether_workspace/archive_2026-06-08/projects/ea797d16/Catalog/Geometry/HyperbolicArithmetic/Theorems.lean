import Mathlib
import Geometry.HyperbolicArithmetic.Defs

/-!
# Hyperbolic Arithmetic: Deep Theorems

This module proves substantive theorems about the arithmetic structure of hyperbolic
lattices, including:

* The **Fricke trace identity** connecting SL₂(ℤ) traces to the Markov cubic surface
* The **Chebyshev trace recurrence** for powers of SL₂ elements
* The **trace growth** theorem for powers of hyperbolic elements
* The **Vieta involution** preserving the Markov surface
* A **falsifiable conjecture** on hyperbolic lattice point counting
-/

noncomputable section

open Real Complex SL2Z_elem

/-! ## The Fricke Trace Identity -/

/-
**The Fricke trace identity**: For any g, h ∈ SL₂(ℤ),
    tr(g)² + tr(h)² + tr(gh)² - tr(g)·tr(h)·tr(gh) = tr(ghg⁻¹h⁻¹) + 2.
-/
theorem fricke_trace_identity (g h : SL2Z_elem) :
    g.tr ^ 2 + h.tr ^ 2 + (SL2Z_elem.mul g h).tr ^ 2
    - g.tr * h.tr * (SL2Z_elem.mul g h).tr
    = (SL2Z_elem.mul (SL2Z_elem.mul (SL2Z_elem.mul g h) (SL2Z_elem.inv g)) (SL2Z_elem.inv h)).tr + 2 := by
  -- By definition of $g$ and $h$, we know that their traces are integers.
  obtain ⟨a, b, c, d, hd⟩ := g
  obtain ⟨e, f, g', h', hd'⟩ := h;
  unfold SL2Z_elem.tr SL2Z_elem.mul SL2Z_elem.inv; ring;
  grind

/-
**Fricke → Markov**: if the commutator has trace -2, the Fricke character
    lies on the Markov surface x² + y² + z² - xyz = 0.
-/
theorem fricke_implies_markov (g h : SL2Z_elem)
    (hcomm : (SL2Z_elem.mul (SL2Z_elem.mul (SL2Z_elem.mul g h) (SL2Z_elem.inv g))
      (SL2Z_elem.inv h)).tr = -2) :
    onMarkovSurface g.tr h.tr (SL2Z_elem.mul g h).tr 0 := by
  unfold onMarkovSurface;
  linarith [ fricke_trace_identity g h ]

/-! ## Trace Growth for Powers -/

/-- Power of an SL₂(ℤ) element. -/
def SL2Z_pow (g : SL2Z_elem) : ℕ → SL2Z_elem
  | 0 => SL2Z_elem.id
  | n + 1 => SL2Z_elem.mul g (SL2Z_pow g n)

/-
g^(m+n) = g^m · g^n.
-/
theorem SL2Z_pow_add (g : SL2Z_elem) (m n : ℕ) :
    SL2Z_pow g (m + n) = SL2Z_elem.mul (SL2Z_pow g m) (SL2Z_pow g n) := by
  induction' m with m ih;
  · simp +decide [ SL2Z_pow ];
    exact?;
  · simp_all +decide [ Nat.succ_add, SL2Z_pow ];
    exact?

/-
**Chebyshev trace recurrence**: tr(gⁿ⁺²) = tr(g) · tr(gⁿ⁺¹) - tr(gⁿ).
-/
theorem chebyshev_trace_recurrence (g : SL2Z_elem) (n : ℕ) :
    (SL2Z_pow g (n + 2)).tr = g.tr * (SL2Z_pow g (n + 1)).tr - (SL2Z_pow g n).tr := by
  unfold SL2Z_elem.tr;
  rw [ show SL2Z_pow g ( n + 2 ) = SL2Z_elem.mul g ( SL2Z_pow g ( n + 1 ) ) from rfl, show SL2Z_pow g ( n + 1 ) = SL2Z_elem.mul g ( SL2Z_pow g n ) from rfl ];
  unfold SL2Z_elem.mul;
  grind +suggestions

/-- tr(g⁰) = 2. -/
theorem tr_pow_zero (g : SL2Z_elem) : (SL2Z_pow g 0).tr = 2 := by
  simp [SL2Z_pow, SL2Z_elem.id, SL2Z_elem.tr]

/-- tr(g¹) = tr(g). -/
theorem tr_pow_one (g : SL2Z_elem) : (SL2Z_pow g 1).tr = g.tr := by
  simp [SL2Z_pow, SL2Z_elem.mul, SL2Z_elem.id, SL2Z_elem.tr]

/-
For hyperbolic g with tr(g) ≥ 3 and n ≥ 1: tr(gⁿ) ≥ n·(tr(g)-1) + 1.
-/
theorem trace_growth_hyperbolic (g : SL2Z_elem) (hg : g.tr ≥ 3) (n : ℕ) (hn : n ≥ 1) :
    (SL2Z_pow g n).tr ≥ n * (g.tr - 1) + 1 := by
  -- By induction on $n$, we can prove that $tr(g^n) \geq n \cdot (tr(g) - 1) + 1$ for all $n \geq 1$.
  have h_ind : ∀ n ≥ 1, (SL2Z_pow g n).tr ≥ n * (g.tr - 1) + 1 ∧ (SL2Z_pow g n).tr ≥ (SL2Z_pow g (n - 1)).tr + 1 := by
    intro n hn;
    induction hn <;> simp_all +decide [ tr_pow_zero, tr_pow_one, chebyshev_trace_recurrence ];
    rename_i k hk ih; rcases k with ( _ | k ) <;> simp_all +decide [ chebyshev_trace_recurrence ] ;
    constructor <;> nlinarith [ sq_nonneg ( g.tr - 2 : ) ]
  generalize_proofs at *;
  exact h_ind n hn |>.1

/-! ## The Vieta Involution -/

/-
**Vieta involution preserves the Markov surface**:
    if x² + y² + z² - xyz = κ then x² + y² + (xy-z)² - xy(xy-z) = κ.
-/
theorem vieta_involution (x y z κ : ℤ) (h : onMarkovSurface x y z κ) :
    onMarkovSurface x y (x * y - z) κ := by
  unfold onMarkovSurface at *; linarith;

/-- The Vieta involution is an involution: applying twice returns z. -/
theorem vieta_involution_invol (x y z : ℤ) :
    x * y - (x * y - z) = z := by ring

/-- (1,1,1) lies on the Markov surface x²+y²+z² - xyz = κ with κ = 2. -/
theorem markov_root_on_surface : onMarkovSurface 1 1 1 2 := by
  unfold onMarkovSurface; ring

/-- Applying Vieta to (1,1,1): (1,1,0) lies on the surface with κ = 2. -/
theorem vieta_from_root : onMarkovSurface 1 1 0 2 := by
  have h := vieta_involution 1 1 1 2 markov_root_on_surface
  simp at h; exact h

/-! ## The Modular Lattice -/

/-- The **standard modular lattice** generated by S and T at the origin. -/
def modularLattice : HyperbolicLattice where
  basePoint := DiskPoint.origin
  generators := [SL2Z_elem.S, SL2Z_elem.T]
  gen_nontrivial := by
    intro g hg
    simp at hg
    rcases hg with rfl | rfl
    · intro h; have := congr_arg SL2Z_elem.b h; simp [SL2Z_elem.S, SL2Z_elem.id] at this
    · intro h; have := congr_arg SL2Z_elem.b h; simp [SL2Z_elem.T, SL2Z_elem.id] at this

/-- **ST ≠ TS**: the modular group is non-abelian. -/
theorem ST_ne_TS : SL2Z_elem.mul SL2Z_elem.S SL2Z_elem.T ≠
    SL2Z_elem.mul SL2Z_elem.T SL2Z_elem.S := by
  intro h
  have := congr_arg SL2Z_elem.a h
  simp [SL2Z_elem.mul, SL2Z_elem.S, SL2Z_elem.T] at this

/-- The commutator [S,T] = STS⁻¹T⁻¹ has trace 3. -/
theorem commutator_ST_trace :
    (SL2Z_elem.mul
      (SL2Z_elem.mul (SL2Z_elem.mul SL2Z_elem.S SL2Z_elem.T) (SL2Z_elem.inv SL2Z_elem.S))
      (SL2Z_elem.inv SL2Z_elem.T)).tr = 3 := by
  simp [SL2Z_elem.mul, SL2Z_elem.inv, SL2Z_elem.S, SL2Z_elem.T, SL2Z_elem.tr]

/-
The identity has zero displacement at any base point.
-/
theorem displacement_id (z₀ : DiskPoint) : displacementLength SL2Z_elem.id z₀ = 0 := by
  unfold displacementLength SL2Z_elem.id;
  unfold SL2Z_elem.möbiusAct; norm_num [ hypDist_self ] ;

/-! ## Trace Spectrum -/

/-- The trace spectrum: all traces of elements of SL₂(ℤ). -/
def traceSpectrum : Set ℤ :=
  {t : ℤ | ∃ g : SL2Z_elem, g.tr = t}

/-- Every natural number n maps to trace n+2 via the upper-triangular matrix
    [[n+1, n], [1, 1]]. -/
theorem trace_ge_two_in_spectrum (n : ℕ) :
    ((n : ℤ) + 2) ∈ traceSpectrum := by
  refine ⟨⟨(n : ℤ) + 1, n, 1, 1, by ring⟩, ?_⟩
  simp [SL2Z_elem.tr]; ring

/-- Trace 0 is achieved by S. -/
theorem trace_zero_in_spectrum : (0 : ℤ) ∈ traceSpectrum :=
  ⟨SL2Z_elem.S, by simp [SL2Z_elem.tr, SL2Z_elem.S]⟩

/-- Trace 1 is achieved by ST. -/
theorem trace_one_in_spectrum : (1 : ℤ) ∈ traceSpectrum :=
  ⟨SL2Z_elem.mul SL2Z_elem.S SL2Z_elem.T,
   by simp [SL2Z_elem.tr, SL2Z_elem.mul, SL2Z_elem.S, SL2Z_elem.T]⟩

/-
**Every integer is a trace of some element of SL₂(ℤ)**.
-/
theorem trace_spectrum_is_all : traceSpectrum = Set.univ := by
  -- By definition of $traceSpectrum$, we know that every integer is in $traceSpectrum$.
  ext t
  simp [traceSpectrum];
  exact ⟨ ⟨ t - 1, t - 2, 1, 1, by ring ⟩, by simp +decide [ SL2Z_elem.tr ] ⟩

/-! ## Falsifiable Conjecture -/

/-- **Hyperbolic Lattice Point Counting Conjecture**:

    For the modular group PSL(2,ℤ) acting on the Poincaré disk, the number of
    orbit points within hyperbolic distance R of the origin satisfies:

      N(R) / e^R → 3/π   as R → ∞

    **Testable prediction**: Enumerate orbit points by word length in {S, T, S⁻¹, T⁻¹}.
    For word length ≤ 10, compute hyperbolic distances and count N(R).
    The ratio N(R)/e^R should approximate 3/π ≈ 0.9549...

    This follows from the general lattice point counting theorem (Lax-Phillips, 1982)
    applied to PSL(2,ℤ), where the constant depends on the fundamental domain area π/3.

    To computationally test: for R in {2, 4, 6, 8, 10}, compute N(R) by BFS over
    the Cayley graph, and verify N(R)/e^R approaches 3/π. -/
def counting_conjecture_constant : ℝ := 3 / Real.pi

end