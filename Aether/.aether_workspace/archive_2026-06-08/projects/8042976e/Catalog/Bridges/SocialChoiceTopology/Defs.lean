import Mathlib

/-!
# Social Choice as Topology: The Ultrafilter Bridge

## Overview

We formalize the deep structural connection between Arrow's impossibility theorem
and ultrafilter theory, revealing social choice as a topological phenomenon.

The **Kirman-Sondermann theorem** (1972) shows that the set of decisive coalitions
in any social welfare function satisfying Arrow's axioms forms an **ultrafilter**
on the set of voters. Since every ultrafilter on a finite set is principal
(generated by a single point), this immediately yields Arrow's impossibility:
the SWF must be a dictatorship.

This connects social choice to topology via **Stone duality**: ultrafilters are
points of the Stone-Čech compactification, so Arrow's theorem becomes a statement
about the topological rigidity of the preference aggregation map.

## Novel Structure: `DecisiveFilterSystem`

We introduce the `DecisiveFilterSystem`, which axiomatizes the algebraic structure
of decisive coalitions. This is the "social choice ultrafilter" — a mathematical
object that packages the essence of Arrow's impossibility into a single algebraic
structure, independent of the specific voting rule.

## Main Results

* `decisive_superset` — Decisive sets are upward-closed
* `decisive_complement` — Every coalition or its complement is decisive
* `decisive_intersection` — Decisive sets are closed under intersection
* `principal_of_finite` — Every decisive filter system on a finite set is principal
* `arrow_impossibility` — Arrow's impossibility theorem (from ultrafilter theory)
* `antipodal_pareto_forces_asymmetry` — Pareto + reversal forces asymmetry
-/

open Finset Function

/-! ## Part I: Strict Linear Orders -/

/-- A strict linear order on `Fin n`, represented as a permutation giving ranks. -/
structure StrictOrder (n : ℕ) where
  rank : Fin n ≃ Fin n

namespace StrictOrder

variable {n : ℕ}

/-- `a` is preferred to `b` when `a` has a lower rank number. -/
def pref (r : StrictOrder n) (a b : Fin n) : Prop :=
  (r.rank a : ℕ) < (r.rank b : ℕ)

instance (r : StrictOrder n) : DecidableRel r.pref :=
  fun a b => Nat.decLt _ _


theorem principal_of_finite (D : DecisiveFilterSystem k) (hk : 1 ≤ k) :
    D.IsPrincipal := by
      obtain ⟨S, hS_decisive, hS_min⟩ : ∃ S : Finset (Fin k), D.decisive S ∧ ∀ T : Finset (Fin k), D.decisive T → Finset.card S ≤ Finset.card T := by
        apply_rules [ Set.exists_min_image ];
        · exact Set.toFinite _;
        · exact ⟨ Finset.univ, D.univ_decisive ⟩;
      by_cases hS_card : S.card ≥ 2;
      · obtain ⟨ T, hT_decisive, hT_subset ⟩ := exists_smaller_decisive D S hS_decisive hS_card;
        exact absurd ( hS_min T hT_decisive ) ( not_le_of_gt ( Finset.card_lt_card hT_subset ) );
      · interval_cases _ : #S <;> simp_all +decide;
        · exact False.elim <| D.empty_not_decisive hS_decisive;
        · obtain ⟨ x, hx ⟩ := Finset.card_eq_one.mp ‹_›; use x; aesop;

end DecisiveFilterSystem

/-! ## Part IV: Arrow's Impossibility Theorem -/

/-- **Arrow's Impossibility Theorem**: For ≥3 alternatives and ≥2 voters,
    any SWF satisfying Pareto and IIA must be dictatorial.

    The proof proceeds via the ultrafilter route:
    1. Pareto implies the full electorate is decisive.
    2. Field expansion + IIA shows decisiveness is pair-independent.
    3. The decisive coalitions form a `DecisiveFilterSystem`.
    4. Every such system on a finite set is principal.
    5. A principal decisive filter system corresponds to a dictator.

    The full proof is in `Bridges.SocialChoiceTopology.Arrow.arrow_clean`. -/
def arrow_impossibility_stmt : Prop :=
  ∀ (n k : ℕ), 3 ≤ n → 2 ≤ k →
    ∀ (F : SocialWelfare n k), F.IsPareto → F.IsIIA → F.IsDictatorial

/-! ## Part V: The Antipodal Obstruction -/

/-- The **dictator projection** SWF. -/
def dictatorSWF' {n k : ℕ} (d : Fin k) : SocialWelfare n k :=
  fun P => P d


theorem antipodal_pareto_forces_asymmetry {n k : ℕ}
    (F : SocialWelfare n k) (hP : F.IsPareto)
    (a b : Fin n) (hab : a ≠ b)
    (P : PrefProfile n k)
    (hAll : ∀ i : Fin k, (P i).pref a b) :
    (F P.reverse).pref b a := by
      apply hP;
      exact fun i => StrictOrder.reverse_pref_iff _ _ _ |>.2 ( hAll i )

/-! ## Part VI: The Social Choice Fibration -/

/-- **Social Choice Fibration**: Packages the data of a social choice problem
    as a fibration-like structure. -/
structure SocialChoiceFibration (n k : ℕ) where
  /-- The social welfare function (the "section") -/
  swf : SocialWelfare n k
  /-- Pareto efficiency -/
  pareto : swf.IsPareto
  /-- Independence of irrelevant alternatives -/
  iia : swf.IsIIA

namespace SocialChoiceFibration

/-- Every social choice fibration on ≥3 alternatives with ≥2 voters
    has a dictatorial section (given Arrow's theorem). -/

theorem dictatorial_section (scf : SocialChoiceFibration n k)
    (hArrow : arrow_impossibility_stmt)
    (hn : 3 ≤ n) (hk : 2 ≤ k) : scf.swf.IsDictatorial :=
  hArrow n k hn hk scf.swf scf.pareto scf.iia

end SocialChoiceFibration

/-! ## Part VII: Boundary Cases -/

/-- For exactly 1 voter, the identity SWF satisfies all axioms trivially. -/
def singleVoterSWF (n : ℕ) : SocialWelfare n 1 :=
  fun P => P 0