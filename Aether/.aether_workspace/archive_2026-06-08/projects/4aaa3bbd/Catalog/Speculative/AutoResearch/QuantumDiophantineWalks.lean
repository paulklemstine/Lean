/-! ## Section 1: Core Definitions — Minkowski Geometry on ℤ³ -/

/-- The Minkowski quadratic form Q(a,b,c) = a² + b² − c².
    The null cone Q = 0 parametrizes Pythagorean triples.
    Bridge: number theory (Diophantine equations) ↔ physics (Minkowski spacetime). -/
def minkowskiQ (a b c : ℤ) : ℤ := a ^ 2 + b ^ 2 - c ^ 2

/-- The Minkowski bilinear form B(u,v) = u₀v₀ + u₁v₁ − u₂v₂.
    Bridge: polarization of the quadratic form ↔ inner product in Lorentz signature. -/
def minkowskiB (u v : Fin 3 → ℤ) : ℤ := u 0 * v 0 + u 1 * v 1 - u 2 * v 2

/-- The Minkowski metric tensor η = diag(1,1,−1) as a 3×3 integer matrix. -/
def eta : Matrix (Fin 3) (Fin 3) ℤ := !![1, 0, 0; 0, 1, 0; 0, 0, -1]

/-- Berggren matrix A₁ (first generator of the Pythagorean triple tree). -/
def A₁ : Matrix (Fin 3) (Fin 3) ℤ := !![1, -2, 2; 2, -1, 2; 2, -2, 3]

/-- Berggren matrix A₂ (second generator). -/
def A₂ : Matrix (Fin 3) (Fin 3) ℤ := !![1, 2, 2; 2, 1, 2; 2, 2, 3]

/-- Berggren matrix A₃ (third generator). -/
def A₃ : Matrix (Fin 3) (Fin 3) ℤ := !![-1, 2, 2; -2, 1, 2; -2, 2, 3]

/-- A Pythagorean triple is an integer triple satisfying a² + b² = c². -/
def IsPythagoreanTriple (a b c : ℤ) : Prop := a ^ 2 + b ^ 2 = c ^ 2

/-- The integer Lorentz group O(2,1;ℤ): matrices M such that MᵀηM = η. -/
def IntLorentzGroup : Set (Matrix (Fin 3) (Fin 3) ℤ) :=
  {M | M.transpose * eta * M = eta}

/-- The proper integer Lorentz group SO⁺(2,1;ℤ): det M = 1. -/
def IntLorentzGroupProper : Set (Matrix (Fin 3) (Fin 3) ℤ) :=
  {M | M.transpose * eta * M = eta ∧ M.det = 1}

/-- A word in the Berggren free monoid. -/
abbrev BerggrenWord := List (Fin 3)

/-- Generator matrix selector. -/
def genMatrix : Fin 3 → Matrix (Fin 3) (Fin 3) ℤ
  | 0 => A₁
  | 1 => A₂
  | 2 => A₃

/-- The product of matrices along a word. -/
def wordToMatrix : BerggrenWord → Matrix (Fin 3) (Fin 3) ℤ
  | [] => 1
  | g :: gs => genMatrix g * wordToMatrix gs

/-- Berggren child A₁: explicit coordinate formulas. -/
def childA₁ (a b c : ℤ) : ℤ × ℤ × ℤ := (a - 2*b + 2*c, 2*a - b + 2*c, 2*a - 2*b + 3*c)
/-- Berggren child A₂. -/
def childA₂ (a b c : ℤ) : ℤ × ℤ × ℤ := (a + 2*b + 2*c, 2*a + b + 2*c, 2*a + 2*b + 3*c)
/-- Berggren child A₃. -/
def childA₃ (a b c : ℤ) : ℤ × ℤ × ℤ := (-a + 2*b + 2*c, -2*a + b + 2*c, -2*a + 2*b + 3*c)

/-- The Frobenius norm squared of a 3×3 integer matrix.
    Bridge: matrix analysis ↔ Lipschitz bounds for certified_robustness. -/
def frobeniusSq (M : Matrix (Fin 3) (Fin 3) ℤ) : ℤ :=
  ∑ i : Fin 3, ∑ j : Fin 3, (M i j) ^ 2

/-! ## Section 2: Lorentz Form Preservation — The Foundation Stone -/

/-- **Theorem (Berggren-Lorentz A₁):** A₁ᵀ η A₁ = η.
    Bridge: Pythagorean triple descent ↔ discrete relativistic boost. -/
theorem A₁_lorentz : A₁.transpose * eta * A₁ = eta := by native_decide

/-- **Theorem (Berggren-Lorentz A₂):** A₂ᵀ η A₂ = η. -/
theorem A₂_lorentz : A₂.transpose * eta * A₂ = eta := by native_decide

/-- **Theorem (Berggren-Lorentz A₃):** A₃ᵀ η A₃ = η. -/
theorem A₃_lorentz : A₃.transpose * eta * A₃ = eta := by native_decide

/-- All three generators are in O(2,1;ℤ). -/
theorem berggren_in_lorentz :
    A₁ ∈ IntLorentzGroup ∧ A₂ ∈ IntLorentzGroup ∧ A₃ ∈ IntLorentzGroup :=
  ⟨A₁_lorentz, A₂_lorentz, A₃_lorentz⟩

/-- A₁ is in the proper Lorentz group (det = 1). -/
theorem A₁_proper_lorentz : A₁ ∈ IntLorentzGroupProper :=
  ⟨A₁_lorentz, by native_decide⟩

/-- A₃ is in the proper Lorentz group (det = 1). -/
theorem A₃_proper_lorentz : A₃ ∈ IntLorentzGroupProper :=
  ⟨A₃_lorentz, by native_decide⟩

/-! ## Section 3: Quadratic Form Preservation

The Berggren matrices preserve Q(a,b,c) = a² + b² − c² for every (a,b,c) ∈ ℤ³. -/

/-- A₁ preserves the Minkowski quadratic form for all vectors. -/
theorem A₁_preserves_Q (a b c : ℤ) :
    minkowskiQ (a - 2*b + 2*c) (2*a - b + 2*c) (2*a - 2*b + 3*c) = minkowskiQ a b c := by
  unfold minkowskiQ; ring

/-- A₂ preserves the Minkowski quadratic form for all vectors. -/
theorem A₂_preserves_Q (a b c : ℤ) :
    minkowskiQ (a + 2*b + 2*c) (2*a + b + 2*c) (2*a + 2*b + 3*c) = minkowskiQ a b c := by
  unfold minkowskiQ; ring

/-- A₃ preserves the Minkowski quadratic form for all vectors. -/
theorem A₃_preserves_Q (a b c : ℤ) :
    minkowskiQ (-a + 2*b + 2*c) (-2*a + b + 2*c) (-2*a + 2*b + 3*c) = minkowskiQ a b c := by
  unfold minkowskiQ; ring

/-! ## Section 4: Polarization Identity -/

/-- The polarization identity for the Minkowski form:
    2B(u,v) = Q(u₀+v₀, u₁+v₁, u₂+v₂) − Q(u₀,u₁,u₂) − Q(v₀,v₁,v₂).
    Bridge: quadratic Diophantine analysis ↔ bilinear Lorentzian geometry. -/
theorem minkowski_polarization (u v : Fin 3 → ℤ) :
    2 * minkowskiB u v = minkowskiQ (u 0 + v 0) (u 1 + v 1) (u 2 + v 2)
                       - minkowskiQ (u 0) (u 1) (u 2)
                       - minkowskiQ (v 0) (v 1) (v 2) := by
  simp only [minkowskiQ, minkowskiB]; ring

/-- Self-pairing recovers the quadratic form: B(v,v) = Q(v). -/
theorem minkowski_self_pairing (v : Fin 3 → ℤ) :
    minkowskiB v v = minkowskiQ (v 0) (v 1) (v 2) := by
  simp only [minkowskiB, minkowskiQ]; ring

/-- Symmetry of the Minkowski bilinear form. -/
theorem minkowski_bilinear_symm (u v : Fin 3 → ℤ) :
    minkowskiB u v = minkowskiB v u := by
  simp only [minkowskiB]; ring

/-- Additivity in the first argument. -/
theorem minkowski_bilinear_add_left (u₁ u₂ v : Fin 3 → ℤ) :
    minkowskiB (u₁ + u₂) v = minkowskiB u₁ v + minkowskiB u₂ v := by
  simp only [minkowskiB, Pi.add_apply]; ring

/-- Scaling in the first argument. -/
theorem minkowski_bilinear_smul (t : ℤ) (u v : Fin 3 → ℤ) :
    minkowskiB (t • u) v = t * minkowskiB u v := by
  simp only [minkowskiB, Pi.smul_apply, smul_eq_mul]; ring

/-- Q = 0 iff Pythagorean. Bridge: null cone = Pythagorean constraint. -/
theorem null_cone_iff_pythagorean (a b c : ℤ) :
    minkowskiQ a b c = 0 ↔ IsPythagoreanTriple a b c := by
  simp only [minkowskiQ, IsPythagoreanTriple]; omega

/-! ## Section 5: Determinant Classification -/

/-- det(A₁) = 1. -/
theorem det_A₁ : A₁.det = 1 := by native_decide
/-- det(A₂) = −1. The unique improper generator. -/
theorem det_A₂ : A₂.det = -1 := by native_decide
/-- det(A₃) = 1. -/
theorem det_A₃ : A₃.det = 1 := by native_decide

/-- Every generator has det = ±1. -/
theorem det_classification (i : Fin 3) :
    (genMatrix i).det = 1 ∨ (genMatrix i).det = -1 := by
  fin_cases i
  · left; exact det_A₁
  · right; exact det_A₂
  · left; exact det_A₃

/-- |det| = 1 for all generators. -/
theorem det_abs_one (i : Fin 3) : |(genMatrix i).det| = 1 := by
  fin_cases i <;> simp [genMatrix, det_A₁, det_A₂, det_A₃]

/-- Product determinants follow the homomorphism det: GL₃ → ℤ*. -/
theorem det_A₁A₂ : (A₁ * A₂).det = -1 := by native_decide
theorem det_A₁A₃ : (A₁ * A₃).det = 1 := by native_decide
theorem det_A₂A₃ : (A₂ * A₃).det = -1 := by native_decide

/-- Squared matrices always have det = 1. -/
theorem det_A₁_sq : (A₁ * A₁).det = 1 := by native_decide
theorem det_A₂_sq : (A₂ * A₂).det = 1 := by native_decide
theorem det_A₃_sq : (A₃ * A₃).det = 1 := by native_decide

/-! ## Section 6: Trace Structure and Spectral Invariants -/

/-- tr(A₁) = 3. -/
theorem trace_A₁ : A₁.trace = 3 := by native_decide
/-- tr(A₂) = 5. The largest trace. -/
theorem trace_A₂ : A₂.trace = 5 := by native_decide
/-- tr(A₃) = 3. Same trace as A₁ — conjugate generators. -/
theorem trace_A₃ : A₃.trace = 3 := by native_decide

/-- Trace bound: every generator has trace ≤ 5. -/
theorem trace_bound (i : Fin 3) : (genMatrix i).trace ≤ 5 := by
  fin_cases i <;> simp [genMatrix, trace_A₁, trace_A₂, trace_A₃]

/-- Sum of traces = 11 (an odd prime). -/
theorem trace_sum : A₁.trace + A₂.trace + A₃.trace = 11 := by native_decide

/-- 2-step walk traces. -/
theorem trace_A₁A₂ : (A₁ * A₂).trace = 17 := by native_decide
theorem trace_A₁A₃ : (A₁ * A₃).trace = 15 := by native_decide
theorem trace_A₂A₃ : (A₂ * A₃).trace = 17 := by native_decide

/-- Cayley-Hamilton for A₁: (A₁ − I)³ = 0. A₁ is unipotent.
    Bridge: spectral theory ↔ quantum walk resonance. -/
theorem cayley_hamilton_A₁ :
    A₁ * A₁ * A₁ - 3 • (A₁ * A₁) + 3 • A₁ - 1 = 0 := by native_decide

/-- Cayley-Hamilton for A₂: A₂³ − 5A₂² − 5A₂ + I = 0.
    Bridge: irrational eigenvalues ↔ aperiodic quantum walk dynamics. -/
theorem cayley_hamilton_A₂ :
    A₂ * A₂ * A₂ - 5 • (A₂ * A₂) - 5 • A₂ + 1 = 0 := by native_decide

/-! ## Section 7: Pythagorean Triple Preservation -/

/-- A₁ preserves Pythagorean triples. -/
theorem childA₁_preserves_pythag (a b c : ℤ) (h : IsPythagoreanTriple a b c) :
    IsPythagoreanTriple (childA₁ a b c).1 (childA₁ a b c).2.1 (childA₁ a b c).2.2 := by
  rw [← null_cone_iff_pythagorean] at h ⊢; simp only [childA₁]; rw [A₁_preserves_Q, h]

/-- A₂ preserves Pythagorean triples. -/
theorem childA₂_preserves_pythag (a b c : ℤ) (h : IsPythagoreanTriple a b c) :
    IsPythagoreanTriple (childA₂ a b c).1 (childA₂ a b c).2.1 (childA₂ a b c).2.2 := by
  rw [← null_cone_iff_pythagorean] at h ⊢; simp only [childA₂]; rw [A₂_preserves_Q, h]

/-- A₃ preserves Pythagorean triples. -/
theorem childA₃_preserves_pythag (a b c : ℤ) (h : IsPythagoreanTriple a b c) :
    IsPythagoreanTriple (childA₃ a b c).1 (childA₃ a b c).2.1 (childA₃ a b c).2.2 := by
  rw [← null_cone_iff_pythagorean] at h ⊢; simp only [childA₃]; rw [A₃_preserves_Q, h]

/-- The seed (3,4,5) is Pythagorean. -/
theorem seed_pythagorean : IsPythagoreanTriple 3 4 5 := by unfold IsPythagoreanTriple; norm_num

/-- First-generation children. -/
theorem child_A₁_seed : childA₁ 3 4 5 = (5, 12, 13) := by unfold childA₁; norm_num
theorem child_A₂_seed : childA₂ 3 4 5 = (21, 20, 29) := by unfold childA₂; norm_num
theorem child_A₃_seed : childA₃ 3 4 5 = (15, 8, 17) := by unfold childA₃; norm_num

/-- All first-generation children are Pythagorean. -/
theorem gen1_pythagorean :
    IsPythagoreanTriple 5 12 13 ∧ IsPythagoreanTriple 21 20 29 ∧ IsPythagoreanTriple 15 8 17 := by
  refine ⟨?_, ?_, ?_⟩ <;> (unfold IsPythagoreanTriple; norm_num)

/-- Second-generation child. -/
theorem gen2_A₁A₁ : childA₁ 5 12 13 = (7, 24, 25) := by unfold childA₁; norm_num
theorem gen2_pythag : IsPythagoreanTriple 7 24 25 := by unfold IsPythagoreanTriple; norm_num

/-! ## Section 8: Word Matrix Lorentz Preservation -/

/-- Every generator is in O(2,1;ℤ). -/
theorem gen_in_lorentz (i : Fin 3) : genMatrix i ∈ IntLorentzGroup := by
  fin_cases i <;> [exact A₁_lorentz; exact A₂_lorentz; exact A₃_lorentz]

/-- O(2,1;ℤ) is closed under multiplication.
    Bridge: subgroup structure ↔ gauge group closure. -/
theorem lorentz_mul_closed (M N : Matrix (Fin 3) (Fin 3) ℤ)
    (hM : M ∈ IntLorentzGroup) (hN : N ∈ IntLorentzGroup) :
    M * N ∈ IntLorentzGroup := by
  simp only [IntLorentzGroup, Set.mem_setOf_eq] at *
  calc (M * N).transpose * eta * (M * N)
      = N.transpose * (M.transpose * eta * M) * N := by
        rw [Matrix.transpose_mul]; simp [Matrix.mul_assoc]
    _ = N.transpose * eta * N := by rw [hM]
    _ = eta := hN

/-- The identity is in O(2,1;ℤ). -/
theorem one_in_lorentz : (1 : Matrix (Fin 3) (Fin 3) ℤ) ∈ IntLorentzGroup := by
  simp only [IntLorentzGroup, Set.mem_setOf_eq, Matrix.transpose_one, Matrix.one_mul, Matrix.mul_one]

/-- **Inductive Lorentz Preservation**: every word matrix is in O(2,1;ℤ).
    Bridge: free monoid action ↔ discrete Lorentz group orbit.
    Impact: post_quantum_security — orbit never leaves O(2,1;ℤ). -/
theorem wordToMatrix_in_lorentz (w : BerggrenWord) : wordToMatrix w ∈ IntLorentzGroup := by
  induction w with
  | nil => exact one_in_lorentz
  | cons g gs ih => exact lorentz_mul_closed _ _ (gen_in_lorentz g) ih

/-! ## Section 9: Hypotenuse Growth -/

/-- A₂-child hypotenuse > 3c for positive legs.
    Impact: certified_enumeration — O(log c / log 3) depth. -/
theorem A₂_hypotenuse_growth (a b c : ℤ) (ha : 0 < a) (hb : 0 < b) (_hc : 0 < c) :
    3 * c < (childA₂ a b c).2.2 := by
  simp only [childA₂]; linarith

/-- A₂-child hypotenuse ≤ 7c when legs ≤ hypotenuse.
    Impact: lipschitz_certified_robustness — Lipschitz constant ≤ 7ᵈ. -/
theorem A₂_hypotenuse_upper (a b c : ℤ) (_ha : 0 < a) (_hb : 0 < b)
    (hac : a ≤ c) (hbc : b ≤ c) :
    (childA₂ a b c).2.2 ≤ 7 * c := by
  simp only [childA₂]; linarith

/-- Pythagorean triples: hypotenuse exceeds each leg. -/
theorem pythag_hyp_exceeds_leg (a b c : ℤ) (h : IsPythagoreanTriple a b c)
    (ha : 0 < a) (hb : 0 < b) (_hc : 0 < c) :
    a < c ∧ b < c := by
  unfold IsPythagoreanTriple at h
  constructor <;> nlinarith [sq_nonneg a, sq_nonneg b, sq_nonneg (c - a), sq_nonneg (c - b)]

/-- Triangle inequality for Pythagorean triples. -/
theorem pythag_triangle_inequality (a b c : ℤ) (h : IsPythagoreanTriple a b c)
    (ha : 0 < a) (hb : 0 < b) (_hc : 0 < c) :
    c < a + b := by
  unfold IsPythagoreanTriple at h; nlinarith [sq_nonneg (a + b - c)]

/-- A₂-child hypotenuse > 5c for Pythagorean triples.
    Impact: post_quantum_security — Ω(5^depth) growth rate. -/
theorem A₂_pythag_growth (a b c : ℤ) (h : IsPythagoreanTriple a b c)
    (ha : 0 < a) (hb : 0 < b) (hc : 0 < c) :
    5 * c < (childA₂ a b c).2.2 := by
  have htri := pythag_triangle_inequality a b c h ha hb hc
  simp only [childA₂]; linarith

/-- A₁-child hypotenuse growth when first leg exceeds second. -/
theorem A₁_hypotenuse_growth (a b c : ℤ) (hab : b < a) (_hc : 0 < c) :
    c < (childA₁ a b c).2.2 := by
  simp only [childA₁]; linarith

/-- A₃-child hypotenuse growth when second leg exceeds first. -/
theorem A₃_hypotenuse_growth (a b c : ℤ) (hab : a < b) (_hc : 0 < c) :
    c < (childA₃ a b c).2.2 := by
  simp only [childA₃]; linarith

/-! ## Section 10: Frobenius Norm — Lipschitz Bounds -/

/-- Frobenius norm² of A₁ = 35. -/
theorem frobenius_A₁ : frobeniusSq A₁ = 35 := by native_decide
/-- Frobenius norm² of A₂ = 35. -/
theorem frobenius_A₂ : frobeniusSq A₂ = 35 := by native_decide
/-- Frobenius norm² of A₃ = 35. -/
theorem frobenius_A₃ : frobeniusSq A₃ = 35 := by native_decide

/-- All generators have equal Frobenius norm √35 ≈ 5.92.
    Bridge: uniform expansion ↔ balanced quantum walk.
    Impact: lipschitz_certified_robustness — Lipschitz constant √35 per step. -/
theorem frobenius_uniform (i : Fin 3) : frobeniusSq (genMatrix i) = 35 := by
  fin_cases i <;> [exact frobenius_A₁; exact frobenius_A₂; exact frobenius_A₃]

