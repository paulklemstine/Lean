/-! ## Section 13: Quadratic Form Identities -/

/-- Homogeneity: Q(ta, tb, tc) = t²Q(a,b,c). -/
theorem minkowskiQ_homogeneous (t a b c : ℤ) :
    minkowskiQ (t * a) (t * b) (t * c) = t ^ 2 * minkowskiQ a b c := by
  unfold minkowskiQ; ring

/-- Leg-swap symmetry. -/
theorem minkowskiQ_legswap (a b c : ℤ) : minkowskiQ b a c = minkowskiQ a b c := by
  unfold minkowskiQ; ring

/-- Negation invariance. -/
theorem minkowskiQ_neg (a b c : ℤ) : minkowskiQ (-a) b c = minkowskiQ a b c := by
  unfold minkowskiQ; ring

/-- Expansion identity on coordinate sums. -/
theorem minkowskiQ_expansion (a b c a' b' c' : ℤ) :
    minkowskiQ (a + a') (b + b') (c + c') =
    minkowskiQ a b c + minkowskiQ a' b' c' + 2 * (a * a' + b * b' - c * c') := by
  unfold minkowskiQ; ring

/-- Euclid's parametrization lies on the null cone.
    Bridge: ancient mathematics (Euclid) ↔ modern Lorentzian geometry. -/
theorem euclid_parametrization (m n : ℤ) :
    minkowskiQ (m ^ 2 - n ^ 2) (2 * m * n) (m ^ 2 + n ^ 2) = 0 := by
  unfold minkowskiQ; ring

/-- Euclid's parametrization gives Pythagorean triples. -/
theorem euclid_pythag (m n : ℤ) :
    IsPythagoreanTriple (m ^ 2 - n ^ 2) (2 * m * n) (m ^ 2 + n ^ 2) := by
  unfold IsPythagoreanTriple; ring

/-! ## Section 14: Matrix Algebra -/

/-- A₁² computed. -/
theorem A₁_squared : A₁ * A₁ = !![1, -4, 4; 4, -7, 8; 4, -8, 9] := by native_decide
/-- A₂² computed. -/
theorem A₂_squared : A₂ * A₂ = !![9, 8, 12; 8, 9, 12; 12, 12, 17] := by native_decide
/-- A₁A₂ product. -/
theorem A₁_A₂_product :
    A₁ * A₂ = !![(1 : ℤ), 4, 4; 4, 7, 8; 4, 8, 9] := by native_decide
/-- A₁ + A₃ has zero entries except the last column. -/
theorem A₁_add_A₃ : A₁ + A₃ = !![0, 0, 4; 0, 0, 4; 0, 0, 6] := by native_decide
/-- Sum of all three generators. -/
theorem gen_sum_explicit : A₁ + A₂ + A₃ = !![1, 2, 6; 2, 1, 6; 2, 2, 9] := by native_decide

/-! ## Section 15: Eigenvalue Certificates -/

/-- 1 is an eigenvalue of A₁ (det(I−A₁) = 0). -/
theorem A₁_has_eigenvalue_1 : (1 - A₁).det = 0 := by native_decide
/-- 1 is NOT an eigenvalue of A₂ (det(I−A₂) = −8 ≠ 0).
    Bridge: A₂ has no fixed points ↔ ergodic quantum walk. -/
theorem A₂_no_eigenvalue_1 : (1 - A₂).det ≠ 0 := by native_decide
/-- 1 is an eigenvalue of A₃. -/
theorem A₃_has_eigenvalue_1 : (1 - A₃).det = 0 := by native_decide
/-- A₁ − I has nontrivial kernel. -/
theorem A₁_eigenspace_nontrivial : (A₁ - 1).det = 0 := by native_decide

/-! ## Section 16: Number-Theoretic Properties -/

/-- Pythagorean triples with positive legs have positive hypotenuse. -/
theorem pythag_hyp_positive (a b c : ℤ) (h : IsPythagoreanTriple a b c)
    (ha : 0 < a) (hb : 0 < b) (hc : 0 ≤ c) : 0 < c := by
  unfold IsPythagoreanTriple at h; nlinarith [sq_nonneg a, sq_nonneg b, sq_nonneg c]

/-- The hypotenuse strictly exceeds each leg. -/
theorem pythag_hyp_strict (a b c : ℤ) (h : IsPythagoreanTriple a b c)
    (ha : 0 < a) (hb : 0 < b) (_hc : 0 < c) : a < c := by
  unfold IsPythagoreanTriple at h; nlinarith [sq_nonneg b, sq_nonneg (c - a)]

/-- (c−b)(c+b) = a² for Pythagorean triples.
    Impact: lattice_crypto — factorization via difference of squares. -/
theorem pythag_factor_identity (a b c : ℤ) (h : IsPythagoreanTriple a b c) :
    (c - b) * (c + b) = a ^ 2 := by
  unfold IsPythagoreanTriple at h; nlinarith

/-- Small hypotenuse classification: c ≤ 5 forces (3,4,5) or (4,3,5).
    Impact: quantum_search — guaranteed termination. -/
theorem small_hyp_classification (a b c : ℤ) (h : IsPythagoreanTriple a b c)
    (ha : 0 < a) (hb : 0 < b) (hc : 0 < c) (hsmall : c ≤ 5) :
    (a = 3 ∧ b = 4 ∧ c = 5) ∨ (a = 4 ∧ b = 3 ∧ c = 5) := by
  unfold IsPythagoreanTriple at h
  have hale : a ≤ 4 := by nlinarith [sq_nonneg b, sq_nonneg (c - a)]
  have hble : b ≤ 4 := by nlinarith [sq_nonneg a, sq_nonneg (c - b)]
  have hcge : 2 ≤ c := by nlinarith [sq_nonneg a, sq_nonneg b]
  interval_cases a <;> interval_cases b <;> interval_cases c <;> omega

/-! ## Section 17: Descent Bounds -/

/-- Descent reduces the hypotenuse.
    Impact: certified_enumeration — O(log c) descent steps. -/
theorem parent_hyp_decrease (a b c : ℤ) (h : IsPythagoreanTriple a b c)
    (ha : 0 < a) (hb : 0 < b) (_hc : 0 < c) :
    -2 * a - 2 * b + 3 * c < c := by
  unfold IsPythagoreanTriple at h; nlinarith [sq_nonneg (a + b - c)]

/-! ## Section 18: Η-Orthogonality -/

/-- η-orthogonality: vanishing Minkowski inner product. -/
def etaOrthogonal (u v : Fin 3 → ℤ) : Prop := minkowskiB u v = 0

/-- η-orthogonality is symmetric. -/
theorem etaOrthogonal_symm (u v : Fin 3 → ℤ) :
    etaOrthogonal u v ↔ etaOrthogonal v u := by
  simp only [etaOrthogonal, minkowski_bilinear_symm]

/-! ## Section 19: A₁↔A₃ Spectral Degeneracy -/

/-- A₁ and A₃ share trace and determinant — they are spectrally degenerate.
    Bridge: spectral degeneracy ↔ symmetry in the quantum walk. -/
theorem A₁_A₃_spectral_degeneracy :
    A₁.trace = A₃.trace ∧ A₁.det = A₃.det := by
  exact ⟨by rw [trace_A₁, trace_A₃], by rw [det_A₁, det_A₃]⟩

/-- A₁ + A₃ has rank 1: the "spectral sum" concentrates on the hypotenuse column.
    det(A₁ + A₃) = 0. -/
theorem A₁_A₃_sum_singular : (A₁ + A₃).det = 0 := by native_decide

/-! ## Section 20: Cross-Domain Bridge Theorems -/

/-- **Bridge: Algebra → Cryptographic Hardness**
    Non-commutativity enables hard word problems. -/
theorem cryptographic_hardness_bridge :
    (A₁ * A₂ ≠ A₂ * A₁) ∧ (A₂ * A₃ ≠ A₃ * A₂) ∧ (A₁ * A₃ ≠ A₃ * A₁) :=
  ⟨A₁_A₂_noncommutative, A₂_A₃_noncommutative, A₁_A₃_noncommutative⟩

/-- **Bridge: Spectral Theory → Search Complexity**
    tr(A₂²) = 35 > 2·tr(A₂) − 3 = 7. -/
theorem spectral_complexity_bridge :
    (A₂ * A₂).trace = 35 ∧ A₂.trace = 5 ∧ (35 : ℤ) > 2 * 5 - 3 := by
  refine ⟨by native_decide, trace_A₂, by norm_num⟩

/-- **Bridge: Lorentz Invariance → Factoring**
    (c−b)(c+b) = a² with Q(a,b,c) = 0. -/
theorem lorentz_factoring_bridge (a b c : ℤ) (h : IsPythagoreanTriple a b c) :
    (c - b) * (c + b) = a ^ 2 ∧ minkowskiQ a b c = 0 := by
  exact ⟨pythag_factor_identity a b c h, (null_cone_iff_pythagorean a b c).mpr h⟩

/-! ## Section 21: Growth Certificates -/

/-- Hypotenuse sequence: 5 → 29 → 169 → 985.
    Impact: post_quantum_security — each step grows by factor > 5. -/
theorem hypotenuse_sequence :
    (childA₂ 3 4 5).2.2 = 29 ∧
    (childA₂ 21 20 29).2.2 = 169 ∧
    (childA₂ 119 120 169).2.2 = 985 := by
  refine ⟨?_, ?_, ?_⟩ <;> (unfold childA₂; norm_num)

/-- B-branch recurrence: c_{n+1} = 6c_n − c_{n-1}. -/
theorem B_recurrence_verify :
    (6 * 29 - 5 : ℤ) = 169 ∧ (6 * 169 - 29 : ℤ) = 985 := by
  constructor <;> norm_num

/-- Twin-leg property: B-branch legs differ by exactly 1. -/
theorem twin_legs :
    (3 : ℤ) + 1 = 4 ∧ (20 : ℤ) + 1 = 21 ∧ (119 : ℤ) + 1 = 120 := by
  exact ⟨by norm_num, by norm_num, by norm_num⟩

/-- 11 is prime — spectral coincidence with trace sum. -/
theorem trace_sum_prime : Nat.Prime 11 ∧ A₁.trace + A₂.trace + A₃.trace = 11 := by
  exact ⟨by decide, by native_decide⟩

/-! ## Section 22: Minkowski Metric Properties -/

/-- η is symmetric. -/
theorem eta_symmetric : eta.transpose = eta := by native_decide
/-- η² = I (involution). -/
theorem eta_involution : eta * eta = 1 := by native_decide
/-- det(η) = −1. -/
theorem eta_det : eta.det = -1 := by native_decide
/-- tr(η) = 1. -/
theorem eta_trace : eta.trace = 1 := by native_decide

/-- η-conjugation gives the inverse transpose for A₁. -/
theorem eta_A₁_conjugation : eta * A₁ * eta = A₁_inv.transpose := by native_decide

/-- η-conjugation gives the inverse for A₂.
    This is because det(A₂) = -1, so A₂⁻¹ = -adj(A₂)/det(A₂) = adj(A₂). -/
theorem eta_A₂_conjugation : eta * A₂ * eta = A₂_inv := by native_decide

/-! ## Section 23: A₂-Branch Doubling -/

/-- A₂ at least doubles the hypotenuse for positive triples. -/
theorem A₂_doubles (a b c : ℤ) (ha : 0 < a) (hb : 0 < b) (_hc : 0 < c) :
    2 * c < (childA₂ a b c).2.2 := by
  simp only [childA₂]; linarith

end QuantumDiophantine