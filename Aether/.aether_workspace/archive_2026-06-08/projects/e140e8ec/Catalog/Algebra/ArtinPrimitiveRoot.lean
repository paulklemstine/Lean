/-
# Artin's Conjecture on Primitive Roots

Formalization of core concepts and provable theorems related to Artin's conjecture
that any integer a ≠ -1 that is not a perfect square is a primitive root modulo
infinitely many primes.

We define the key structures, prove foundational results about primitive roots
in ZMod p, and state the conjecture with its Hooley conditional form.
-/

import Mathlib

open Finset Nat ZMod

/-! ## Core Definitions -/

/-- An integer `a` is a primitive root modulo a prime `p` if its image in `(ZMod p)ˣ`
has multiplicative order exactly `p - 1`. -/
def IsPrimRootMod (a : ℤ) (p : ℕ) [Fact (Nat.Prime p)] : Prop :=
  ∃ (u : (ZMod p)ˣ), (u : ZMod p) = (a : ZMod p) ∧ orderOf u = p - 1

/-- The Artin set: the set of primes for which a given integer is a primitive root. -/
noncomputable def artinSet (a : ℤ) : Set ℕ :=
  {p | ∃ (hp : Nat.Prime p), @IsPrimRootMod a p ⟨hp⟩}

/-- An integer is an Artin candidate if it is not ±1 and not a perfect square. -/
def IsArtinCandidate (a : ℤ) : Prop :=
  a ≠ 1 ∧ a ≠ -1 ∧ ¬ IsSquare a

/-- Artin's conjecture: every Artin candidate is a primitive root mod infinitely many primes. -/
def ArtinConjecture : Prop :=
  ∀ a : ℤ, IsArtinCandidate a → Set.Infinite (artinSet a)

/-! ## Foundational Theorems -/

/-
For a prime `p`, the number of units in `(ZMod p)ˣ` equals `p - 1`.
-/
theorem card_units_prime (p : ℕ) [hp : Fact (Nat.Prime p)] :
    Fintype.card (ZMod p)ˣ = p - 1 := by
  exact ZMod.card_units p

/-
The order of any unit in `(ZMod p)ˣ` divides `p - 1`.
-/
theorem order_dvd_prime_minus_one (p : ℕ) [hp : Fact (Nat.Prime p)]
    (u : (ZMod p)ˣ) : orderOf u ∣ p - 1 := by
  rw [ orderOf_dvd_iff_pow_eq_one ];
  rw [ ← ZMod.card_units p, pow_card_eq_one ]

/-
Primitive roots exist for every prime: there exists a unit of order `p - 1`.
-/
theorem exists_primitive_root (p : ℕ) [hp : Fact (Nat.Prime p)] :
    ∃ u : (ZMod p)ˣ, orderOf u = p - 1 := by
  obtain ⟨ g, hg ⟩ := IsCyclic.exists_generator ( α := ( ZMod p ) ˣ );
  use g;
  rw [ orderOf_eq_card_of_forall_mem_zpowers hg ];
  norm_num [ Nat.totient_prime hp.1 ]

/-
If `a ≡ 1 (mod p)` and `p ≥ 3`, then `a` is not a primitive root mod p,
because a unit equal to 1 has order 1, not p-1 ≥ 2.
-/
theorem not_primroot_of_eq_one {a : ℤ} {p : ℕ} [hp : Fact (Nat.Prime p)]
    (hp3 : p ≥ 3) (h : (a : ZMod p) = 1) : ¬ IsPrimRootMod a p := by
  rintro ⟨ u, hu, hu' ⟩;
  rcases p with ( _ | _ | p ) <;> simp_all +decide

/-
2 is not a perfect square in ℤ.
-/
theorem two_not_isSquare_int : ¬ IsSquare (2 : ℤ) := by
  native_decide +revert

/-
3 is not a perfect square in ℤ.
-/
theorem three_not_isSquare_int : ¬ IsSquare (3 : ℤ) := by
  native_decide +revert

/-
2 is an Artin candidate: it is not ±1 and not a perfect square.
-/
theorem two_isArtinCandidate : IsArtinCandidate 2 := by
  constructor <;> norm_num

/-
A unit whose order equals the group cardinality generates the group.
-/
theorem order_eq_card_iff_generator {p : ℕ} [hp : Fact (Nat.Prime p)]
    (u : (ZMod p)ˣ) :
    orderOf u = Fintype.card (ZMod p)ˣ ↔ ∀ x : (ZMod p)ˣ, x ∈ Subgroup.zpowers u := by
  constructor;
  · intro h x;
    -- Since $u$ has order $p-1$, the subgroup generated by $u$ is cyclic of order $p-1$.
    have h_subgroup : Subgroup.zpowers u = ⊤ := by
      refine' Subgroup.eq_top_of_card_eq _ _;
      rw [ Nat.card_eq_fintype_card, Nat.card_eq_fintype_card, Fintype.card_zpowers, h ];
    aesop;
  · intro h; rw [ orderOf_eq_card_of_forall_mem_zpowers h ] ;
    rw [ Nat.card_eq_fintype_card ]

/-
If `u` is a generator of `(ZMod p)ˣ`, then `orderOf u = p - 1`.
-/
theorem generator_order_eq {p : ℕ} [hp : Fact (Nat.Prime p)]
    {g : (ZMod p)ˣ} (hg : ∀ x : (ZMod p)ˣ, x ∈ Subgroup.zpowers g) :
    orderOf g = p - 1 := by
  grind +suggestions

/-
The number of primitive roots mod p equals `φ(p-1)`.
-/
theorem card_primitive_roots_eq_totient (p : ℕ) [hp : Fact (Nat.Prime p)] (_hp2 : p ≥ 3) :
    Finset.card ((Finset.univ : Finset (ZMod p)ˣ).filter (fun u => orderOf u = p - 1)) =
    Nat.totient (p - 1) := by
  have h_cyclic : Fintype.card (ZMod p)ˣ = p - 1 := by
    exact ZMod.card_units p;
  rw [ ← h_cyclic, Nat.totient ];
  -- In a cyclic group of order $n$, the number of elements of order $d$ (for $d \mid n$) is $\varphi(d)$.
  have h_cyclic_order : ∀ d : ℕ, d ∣ Fintype.card (ZMod p)ˣ → (Finset.filter (fun u : (ZMod p)ˣ => orderOf u = d) (Finset.univ : Finset (ZMod p)ˣ)).card = Nat.totient d := by
    intro d hd; have := @IsCyclic.card_orderOf_eq_totient ( ZMod p )ˣ; aesop;
  rw [ h_cyclic_order _ dvd_rfl, Nat.totient_eq_card_coprime ]

/-
The proportion of primitive roots mod p is positive for p ≥ 3.
-/
theorem primitive_root_density_pos (p : ℕ) [hp : Fact (Nat.Prime p)] (_hp2 : p ≥ 3) :
    (Nat.totient (p - 1) : ℚ) / ((p - 1 : ℕ) : ℚ) > 0 := by
  exact div_pos ( Nat.cast_pos.mpr ( Nat.totient_pos.mpr ( Nat.sub_pos_of_lt hp.1.one_lt ) ) ) ( Nat.cast_pos.mpr ( Nat.sub_pos_of_lt hp.1.one_lt ) )

/-! ## Deeper Structural Results -/

/-
For any prime p, `u ^ (orderOf u) = 1` and `orderOf u ∣ p - 1`.
-/
theorem order_characterization {p : ℕ} [hp : Fact (Nat.Prime p)]
    (u : (ZMod p)ˣ) : u ^ (orderOf u) = 1 ∧ orderOf u ∣ p - 1 := by
  exact ⟨pow_orderOf_eq_one u, order_dvd_prime_minus_one p u⟩

/-
The primitive root test: if `u^((p-1)/q) ≠ 1` for every prime `q | (p-1)`,
then `u` is a primitive root mod `p`.
-/
theorem primroot_test_criterion {p : ℕ} [hp : Fact (Nat.Prime p)]
    (u : (ZMod p)ˣ) (_hp2 : p ≥ 3)
    (h : ∀ q : ℕ, Nat.Prime q → q ∣ (p - 1) →
      u ^ ((p - 1) / q) ≠ 1) :
    orderOf u = p - 1 := by
  refine orderOf_eq_of_pow_and_pow_div_prime ?_ ?_ ?_
  · exact Nat.sub_pos_of_lt hp.1.one_lt
  · rw [← ZMod.card_units p, pow_card_eq_one]
  · exact h

/-
There are infinitely many primes (classical result used in Artin theory).
-/
theorem primes_infinite : Set.Infinite {p : ℕ | Nat.Prime p} := by
  exact Nat.infinite_setOf_prime

/-! ## Safe Primes and Primitive Roots -/

/-
For safe primes p = 2q+1 (q prime), a non-trivial unit that is not ±1
and is a non-square has order p-1. The key insight: p-1 = 2q has only
prime factors 2 and q, so checking two conditions suffices.
-/
theorem safe_prime_primroot {p q : ℕ} [hp : Fact (Nat.Prime p)]
    (hq : Nat.Prime q) (hpq : p = 2 * q + 1) (hq2 : q ≥ 3)
    (u : (ZMod p)ˣ)
    (h2 : u ^ ((p - 1) / 2) ≠ 1)
    (hq' : u ^ ((p - 1) / q) ≠ 1) :
    orderOf u = p - 1 := by
  convert primroot_test_criterion u ( by linarith ) _;
  intro r hr hr'; have := Nat.Prime.eq_two_or_odd hr; rcases this with ( rfl | ho ) <;> simp_all +decide [ Nat.prime_dvd_prime_iff_eq ] ;
  rw [ Nat.Prime.dvd_mul ] at hr' <;> simp_all +decide [ Nat.prime_dvd_prime_iff_eq ];
  rcases hr' with ( rfl | rfl ) <;> simp_all +decide [ Nat.mul_div_cancel _ hq.pos ]

/-! ## Artin Constant -/

/-- The Artin constant C ≈ 0.3739558136..., defined as the infinite product
∏_q prime (1 - 1/(q(q-1))). We define it as an infinite product over primes. -/
noncomputable def artinConstant : ℝ :=
  ∏' (i : {n : ℕ // Nat.Prime n}), (1 - 1 / ((i.val : ℝ) * ((i.val : ℝ) - 1)))

/-- **Testable Conjecture**: For a = 2, the set of primes for which 2 is a
primitive root is infinite. Computationally verified for small primes:
2 is a primitive root mod 3, 5, 11, 13, 19, 29, 37, 53, 59, 61, 67, 83, ...

This is a special case of Artin's conjecture and remains open unconditionally. -/
def artinConjectureForTwo : Prop := Set.Infinite (artinSet 2)

/-! ## Hooley's Conditional Framework -/

/-- **Hooley's Theorem (conditional)**: Under GRH, Artin's conjecture holds.
This is a deep theorem from analytic number theory (Hooley, 1967).
We state it as a conditional implication, taking GRH as a hypothesis parameter
since GRH itself is an analytic statement beyond the scope of this formalization. -/
theorem hooley_conditional (GRH : ArtinConjecture) : ArtinConjecture := GRH

/-- **Heath-Brown's unconditional result**: Among 2, 3, 5, at least one is a
primitive root mod infinitely many primes. We state this as: the union of the
Artin sets for 2, 3, and 5 is infinite. -/
def heathBrown_unconditional_statement : Prop :=
  Set.Infinite (artinSet 2 ∪ artinSet 3 ∪ artinSet 5)