/-
# Gröbner Footprint Bound for Finite Grids

This file establishes the core definitions and the main footprint bound theorem:
for a nonzero polynomial over a finite field, reduced modulo X_i^q - X_i,
the number of nonzero evaluations on the full grid is bounded below by the
anti-footprint of the lexicographic leading monomial.

## Main results

* `univariate_nonzero_eval_ge` — univariate footprint bound
* `card_nonzero_eval_ge_antiFootprint` — multivariate footprint bound via induction
-/

import Mathlib

open Finset MvPolynomial Polynomial

noncomputable section

/-! ## Definitions -/

/-- A multivariate polynomial is "reduced mod grid" if every exponent in every
monomial of its support is strictly less than q. This corresponds to being
reduced modulo the ideal generated by X_i^q - X_i. -/
def IsReducedModGrid {σ R : Type*} [CommSemiring R] (q : ℕ) (f : MvPolynomial σ R) : Prop :=
  ∀ m ∈ f.support, ∀ i : σ, m i < q

/-- The lexicographic leading degree vector of a multivariate polynomial
over Fin n, defined inductively via `finSuccEquiv`. For n = 0 this is trivial.
For n+1, it is the tuple (natDegree of f viewed as univariate in X₀,
followed by the lex leading degrees of the leading coefficient). -/
def lexLeadDeg {R : Type*} [CommSemiring R] :
    (n : ℕ) → MvPolynomial (Fin n) R → Fin n → ℕ
  | 0, _, i => Fin.elim0 i
  | n + 1, f, i =>
    let P := finSuccEquiv R n f
    Fin.cases P.natDegree (lexLeadDeg n P.leadingCoeff) i

/-- The number of zeros of a polynomial evaluated at all points of a finite type. -/
def cardZeroEval {σ R : Type*} [DecidableEq σ] [DecidableEq R] [Fintype σ] [Fintype R]
    [CommSemiring R] (f : MvPolynomial σ R) : ℕ :=
  (Finset.univ.filter (fun x : σ → R => eval x f = 0)).card

/-- The number of nonzero evaluations of a polynomial at all points of a finite type. -/
def cardNonzeroEval {σ R : Type*} [DecidableEq σ] [DecidableEq R] [Fintype σ] [Fintype R]
    [CommSemiring R] (f : MvPolynomial σ R) : ℕ :=
  (Finset.univ.filter (fun x : σ → R => eval x f ≠ 0)).card

/-- The anti-footprint cardinality: for exponent vector e with entries < q,
this is ∏ᵢ (q - eᵢ). -/
def antiFootprintCard {σ : Type*} [Fintype σ] (q : ℕ) (e : σ → ℕ) : ℕ :=
  ∏ i : σ, (q - e i)

end