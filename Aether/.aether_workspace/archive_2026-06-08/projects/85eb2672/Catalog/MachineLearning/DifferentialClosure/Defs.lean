import Mathlib

/-!
# Elementary Expression Algebra: Core Definitions

This file defines the syntactic universe of elementary expressions in one real variable,
together with their evaluation semantics, domain predicates, symbolic differentiation,
and the algebraic properties needed for differential closure theorems.

## Main definitions

* `EExpr` — Inductive type of elementary expressions (var, const, +, -, *, /, exp, log)
* `evalE` — Total evaluation function `EExpr → ℝ → ℝ`
* `ValidAt` — Domain predicate ensuring well-definedness (denominators nonzero, log arguments positive)
* `derivE` — Symbolic differentiation algorithm `EExpr → EExpr`
* `size` — Expression size measure
* `containsExp`, `containsLog` — Syntactic predicates for generator separation
* `DiffClosed`, `GeneratedByExpLog` — Set-theoretic closure properties
-/

noncomputable section

open Real

/-- The syntactic universe of elementary expressions in one real variable.
This captures the initial differential algebra generated by constants, the identity,
arithmetic operations, `exp`, and `log`. -/
inductive EExpr where
  | var : EExpr
  | const : ℝ → EExpr
  | add : EExpr → EExpr → EExpr
  | sub : EExpr → EExpr → EExpr
  | mul : EExpr → EExpr → EExpr
  | div : EExpr → EExpr → EExpr
  | exp : EExpr → EExpr
  | log : EExpr → EExpr
  deriving Inhabited

namespace EExpr

/-- Total evaluation of an elementary expression at a real point.
Uses Lean/Mathlib's conventions: `Real.log x = 0` for `x ≤ 0`, `x / 0 = 0`. -/
def evalE : EExpr → ℝ → ℝ
  | .var, x => x
  | .const c, _ => c
  | .add a b, x => evalE a x + evalE b x
  | .sub a b, x => evalE a x - evalE b x
  | .mul a b, x => evalE a x * evalE b x
  | .div a b, x => evalE a x / evalE b x
  | .exp a, x => Real.exp (evalE a x)
  | .log a, x => Real.log (evalE a x)

/-- Domain predicate: `ValidAt e x` holds when evaluation of `e` at `x` is
mathematically well-defined — all division denominators are nonzero and all
`log` arguments are strictly positive. -/
def ValidAt : EExpr → ℝ → Prop
  | .var, _ => True
  | .const _, _ => True
  | .add a b, x => ValidAt a x ∧ ValidAt b x
  | .sub a b, x => ValidAt a x ∧ ValidAt b x
  | .mul a b, x => ValidAt a x ∧ ValidAt b x
  | .div a b, x => ValidAt a x ∧ ValidAt b x ∧ evalE b x ≠ 0
  | .exp a, x => ValidAt a x
  | .log a, x => ValidAt a x ∧ 0 < evalE a x

/-- Symbolic differentiation algorithm. Maps each elementary expression to its
formal derivative, which is again an elementary expression. This is the core
computational artifact: a verified symbolic differentiator. -/
def derivE : EExpr → EExpr
  | .var => .const 1
  | .const _ => .const 0
  | .add a b => .add (derivE a) (derivE b)
  | .sub a b => .sub (derivE a) (derivE b)
  | .mul a b => .add (.mul (derivE a) b) (.mul a (derivE b))
  | .div a b => .div (.sub (.mul (derivE a) b) (.mul a (derivE b))) (.mul b b)
  | .exp a => .mul (derivE a) (.exp a)
  | .log a => .div (derivE a) a

/-- Syntactic size of an expression (number of nodes in the AST). -/
def size : EExpr → ℕ
  | .var => 1
  | .const _ => 1
  | .add a b => 1 + size a + size b
  | .sub a b => 1 + size a + size b
  | .mul a b => 1 + size a + size b
  | .div a b => 1 + size a + size b
  | .exp a => 1 + size a
  | .log a => 1 + size a

/-- Does the expression contain the `exp` constructor? -/
def containsExp : EExpr → Bool
  | .var => false
  | .const _ => false
  | .add a b => containsExp a || containsExp b
  | .sub a b => containsExp a || containsExp b
  | .mul a b => containsExp a || containsExp b
  | .div a b => containsExp a || containsExp b
  | .exp _ => true
  | .log a => containsExp a

/-- Does the expression contain the `log` constructor? -/
def containsLog : EExpr → Bool
  | .var => false
  | .const _ => false
  | .add a b => containsLog a || containsLog b
  | .sub a b => containsLog a || containsLog b
  | .mul a b => containsLog a || containsLog b
  | .div a b => containsLog a || containsLog b
  | .exp a => containsLog a
  | .log _ => true

/-- A set of expressions is **differentiation-closed** if symbolic differentiation
maps every member back into the set. -/
def DiffClosed (S : Set EExpr) : Prop :=
  ∀ e ∈ S, derivE e ∈ S

/-- A set of expressions is **generated by exp and log** if it contains the
primitive generators and is closed under all elementary constructors. -/
def GeneratedByExpLog (S : Set EExpr) : Prop :=
  EExpr.var ∈ S ∧
  (∀ c : ℝ, EExpr.const c ∈ S) ∧
  (∀ a b, a ∈ S → b ∈ S → EExpr.add a b ∈ S) ∧
  (∀ a b, a ∈ S → b ∈ S → EExpr.sub a b ∈ S) ∧
  (∀ a b, a ∈ S → b ∈ S → EExpr.mul a b ∈ S) ∧
  (∀ a b, a ∈ S → b ∈ S → EExpr.div a b ∈ S) ∧
  (∀ a, a ∈ S → EExpr.exp a ∈ S) ∧
  (∀ a, a ∈ S → EExpr.log a ∈ S)

/-- Semantic correctness predicate: `e'` represents the derivative of `e` when both
are in their validity domains. -/
def DerivRepresents (e e' : EExpr) : Prop :=
  ∀ x : ℝ, ValidAt e x → ValidAt e' x →
    HasDerivAt (fun y => evalE e y) (evalE e' x) x

end EExpr