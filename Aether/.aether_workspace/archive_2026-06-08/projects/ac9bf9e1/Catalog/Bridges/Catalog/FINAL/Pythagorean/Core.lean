/-- Minimum depth-2 hypotenuse is 25 (A·A path). -/
theorem depth2_min_hyp (i j : Fin 3) : 25 ≤ hyp [i, j] := by
  fin_cases i <;> fin_cases j <;> native_decide

/-- Maximum depth-2 hypotenuse is 169 (B·B path). -/
theorem depth2_max_hyp (i j : Fin 3) : hyp [i, j] ≤ 169 := by
  fin_cases i <;> fin_cases j <;> native_decide

/-- All depth-2 hypotenuses exceed their parents. -/
theorem depth2_hyp_gt_parent (i j : Fin 3) : hyp [j] < hyp [i, j] :=
  hyp_strictly_increasing [j] i

/-! ## §18. Thermodynamic Potential -/

/-- The thermodynamic potential φ(σ) = ln(h(σ)).
    Bridge: energy of microstate σ in statistical mechanics. -/
noncomputable def thermalPotential (σ : BPath) : ℝ := Real.log (hyp σ : ℝ)

/-- The thermal potential is always positive (h ≥ 5 > 1).
    Impact: Boltzmann weight e^{-s·φ} ∈ (0,1) for s > 0. -/
theorem thermalPotential_pos (σ : BPath) : 0 < thermalPotential σ := by
  unfold thermalPotential
  apply Real.log_pos
  exact_mod_cast (show (1 : ℤ) < hyp σ by have := hyp_ge_five σ; omega)

/-- The thermal potential is strictly increasing.
    Bridge: energy increases → convergence to equilibrium. -/
theorem thermalPotential_strictMono (σ : BPath) (i : Fin 3) :
    thermalPotential σ < thermalPotential (i :: σ) := by
  unfold thermalPotential
  apply Real.log_lt_log
  · exact_mod_cast hyp_pos σ
  · exact_mod_cast hyp_strictly_increasing σ i

/-! ## §19. Tree Counting -/

theorem three_pow_pos (n : ℕ) : (0 : ℝ) < (3 : ℝ) ^ n := by positivity

theorem berggren_branching : Fintype.card (Fin 3) = 3 := by decide

/-! ## §20. Partition Function Positivity -/

/-- Depth-1 partition function: Z₁(s) = 13^{-s} + 29^{-s} + 17^{-s} > 0.
    Impact: Gibbs measure normalization is valid for all temperatures. -/
theorem partition_depth1_pos (s : ℝ) :
    (0 : ℝ) < (13 : ℝ) ^ (-s) + (29 : ℝ) ^ (-s) + (17 : ℝ) ^ (-s) := by
  positivity

end PythagoreanThermo