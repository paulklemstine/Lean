import Mathlib

/-!
# Pythagorean Thermodynamic Formalism: Core Definitions and Foundational Theorems

This file establishes the thermodynamic formalism on the Berggren tree of primitive
Pythagorean triples. The Berggren tree is a rooted ternary tree with root (3,4,5) where
each node has three children generated by the Berggren matrices A, B, C.

## Bridge: Diophantine Geometry ↔ Thermodynamic Formalism ↔ Post-Quantum Cryptography

The key insight is that the Berggren matrices preserve the Lorentz quadratic form
Q(a,b,c) = a² + b² - c², making them elements of O(2,1;ℤ). This Lorentzian
structure provides the geometric foundation for the thermodynamic formalism.

We define the energy function E(σ) = ln(h(σ)) where h is the hypotenuse, and prove
exponential growth bounds, partition function positivity, and spectral analysis of
the Berggren matrices — the key ingredients for constructing Gibbs measures and
proving equidistribution of Pythagorean triples.

## Impact

The exponential growth rate (spectral radius 3+2√2 ≈ 5.83) provides
certified_robustness bounds for lattice-based cryptographic schemes.
The spectral gap between eigenvalues governs Gibbs measure mixing rates,
bounding rejection sampling efficiency in post_quantum key exchange.
-/

open Matrix Finset BigOperators

namespace PythagoreanThermo

/-! ## §1. Core Definitions -/

/-- The three Berggren matrices as an indexed family over Fin 3.
    Bridge: connects Diophantine geometry to dynamical systems via matrix semigroups. -/
def berggrenMat : Fin 3 → Matrix (Fin 3) (Fin 3) ℤ
  | 0 => !![1, -2, 2; 2, -1, 2; 2, -2, 3]
  | 1 => !![1, 2, 2; 2, 1, 2; 2, 2, 3]
  | 2 => !![-1, 2, 2; -2, 1, 2; -2, 2, 3]

/-- The Lorentz form matrix η = diag(1,1,-1). -/
def lorentzMat : Matrix (Fin 3) (Fin 3) ℤ := !![1, 0, 0; 0, 1, 0; 0, 0, -1]

/-- The root triple (3,4,5) as a column vector in ℤ³. -/
def rootVec : Fin 3 → ℤ := ![3, 4, 5]

/-- A Berggren path: finite sequence of branch choices from {A=0, B=1, C=2}. -/
abbrev BPath := List (Fin 3)

/-- The triple at the end of a Berggren path, computed by successive
    matrix-vector multiplication starting from root (3,4,5). -/
def pathTriple : BPath → (Fin 3 → ℤ)
  | [] => rootVec
  | i :: rest => (berggrenMat i).mulVec (pathTriple rest)

/-- The hypotenuse (third component) — the "energy" in thermodynamic formalism. -/
def hyp (σ : BPath) : ℤ := pathTriple σ 2

/-- The Lorentz quadratic form: Q(v) = v₀² + v₁² - v₂². -/
def lorentzQ (v : Fin 3 → ℤ) : ℤ := v 0 ^ 2 + v 1 ^ 2 - v 2 ^ 2

/-- The matrix product along a Berggren path. -/
def pathMatrix : BPath → Matrix (Fin 3) (Fin 3) ℤ
  | [] => 1
  | i :: rest => berggrenMat i * pathMatrix rest

/-! ## §2. Berggren Matrix Determinants -/

/-- Berggren matrix A has determinant 1. -/
theorem det_berggrenMat_0 : (berggrenMat 0).det = 1 := by native_decide

/-- Berggren matrix B has determinant -1. -/
theorem det_berggrenMat_1 : (berggrenMat 1).det = -1 := by native_decide

/-- Berggren matrix C has determinant 1. -/
theorem det_berggrenMat_2 : (berggrenMat 2).det = 1 := by native_decide

/-- All Berggren determinants have absolute value 1.
    Bridge: volume-preserving ↔ thermodynamic_pressure normalization. -/
theorem det_berggrenMat_abs (i : Fin 3) : |(berggrenMat i).det| = 1 := by
  fin_cases i <;> simp [det_berggrenMat_0, det_berggrenMat_1, det_berggrenMat_2]

/-! ## §3. Lorentz Form Preservation -/

/-- All Berggren matrices preserve the Lorentz form: Bᵢᵀ η Bᵢ = η.
    Bridge: Berggren matrices ∈ O(2,1;ℤ). -/
theorem berggrenMat_preserves_lorentz (i : Fin 3) :
    (berggrenMat i).transpose * lorentzMat * (berggrenMat i) = lorentzMat := by
  fin_cases i <;> native_decide

/-- Any Berggren matrix preserves the Lorentz quadratic form: Q(Bᵢv) = Q(v).
    Proof: pure algebra via `ring`. -/
theorem lorentzQ_berggrenMat (i : Fin 3) (v : Fin 3 → ℤ) :
    lorentzQ ((berggrenMat i).mulVec v) = lorentzQ v := by
  simp only [mulVec, dotProduct, Fin.sum_univ_three, lorentzQ]
  simp [show (2 : Fin 3) = (⟨2, by omega⟩ : Fin 3) from rfl]
  fin_cases i <;> simp [berggrenMat] <;> ring

/-! ## §4. Root Triple -/

/-- The root satisfies Q(root) = 0 (Pythagorean: 3² + 4² = 5²). -/
theorem root_lorentz_null : lorentzQ rootVec = 0 := by native_decide

/-- All root components are positive. -/
theorem root_pos (j : Fin 3) : 0 < rootVec j := by fin_cases j <;> native_decide

/-! ## §5. Pythagorean Property Along Paths -/

/-- Every node in the Berggren tree satisfies Q = 0 (is Pythagorean). -/
theorem pathTriple_lorentzQ (σ : BPath) : lorentzQ (pathTriple σ) = 0 := by
  induction σ with
  | nil => exact root_lorentz_null
  | cons i rest ih =>
    show lorentzQ ((berggrenMat i).mulVec (pathTriple rest)) = 0
    rw [lorentzQ_berggrenMat, ih]

/-- Every Berggren path triple is Pythagorean: a² + b² = c².
    Impact: certified_robustness for Pythagorean triple enumeration. -/
theorem pathTriple_pythagorean (σ : BPath) :
    (pathTriple σ) 0 ^ 2 + (pathTriple σ) 1 ^ 2 = (pathTriple σ) 2 ^ 2 := by
  have h := pathTriple_lorentzQ σ; simp only [lorentzQ] at h; linarith

/-! ## §6. Positivity of All Components -/

/-- Core arithmetic: positive Pythagorean triple → all children have positive components. -/
private theorem branch_pos_core (a b c : ℤ) (ha : 0 < a) (hb : 0 < b) (hc : 0 < c)
    (hpyth : a ^ 2 + b ^ 2 = c ^ 2) (i j : Fin 3) :
    0 < ((berggrenMat i).mulVec ![a, b, c]) j := by
  simp only [mulVec, dotProduct, Fin.sum_univ_three, Matrix.cons_val_zero, Matrix.cons_val_one]
  simp [show (2 : Fin 3) = (⟨2, by omega⟩ : Fin 3) from rfl]
  fin_cases i <;> fin_cases j <;> simp [berggrenMat] <;>
    nlinarith [sq_nonneg (c - b), sq_nonneg (c - a)]

/-- All components of any path triple are strictly positive.
    This is non-trivial because matrices A and C have negative entries. -/
theorem pathTriple_pos (σ : BPath) (j : Fin 3) : 0 < pathTriple σ j := by
  induction σ generalizing j with
  | nil => exact root_pos j
  | cons i rest ih =>
    show 0 < ((berggrenMat i).mulVec (pathTriple rest)) j
    have hvec : pathTriple rest = ![pathTriple rest 0, pathTriple rest 1, pathTriple rest 2] := by
      ext k; fin_cases k <;> rfl
    rw [hvec]
    exact branch_pos_core _ _ _ (ih 0) (ih 1) (ih 2) (pathTriple_pythagorean rest) i j

/-! ## §7. Depth-1 Children -/

theorem depth1_child_A : pathTriple [0] = ![5, 12, 13] := by native_decide
theorem depth1_child_B : pathTriple [1] = ![21, 20, 29] := by native_decide
theorem depth1_child_C : pathTriple [2] = ![15, 8, 17] := by native_decide

theorem hyp_depth1_A : hyp [0] = 13 := by native_decide
theorem hyp_depth1_B : hyp [1] = 29 := by native_decide
theorem hyp_depth1_C : hyp [2] = 17 := by native_decide

/-- All depth-1 hypotenuses exceed the root. -/
theorem depth1_hyp_gt_root (i : Fin 3) : hyp [] < hyp [i] := by
  fin_cases i <;> native_decide

/-! ## §8. Hypotenuse Formulas -/

/-- Branch A: h(A::σ) = 2a - 2b + 3c. -/
theorem hyp_formula_A (σ : BPath) :
    hyp (0 :: σ) = 2 * pathTriple σ 0 - 2 * pathTriple σ 1 + 3 * pathTriple σ 2 := by
  simp [hyp, pathTriple, mulVec, dotProduct, Fin.sum_univ_three, berggrenMat]
  ring

/-- Branch B: h(B::σ) = 2a + 2b + 3c (fastest growth). -/
theorem hyp_formula_B (σ : BPath) :
    hyp (1 :: σ) = 2 * pathTriple σ 0 + 2 * pathTriple σ 1 + 3 * pathTriple σ 2 := by
  simp [hyp, pathTriple, mulVec, dotProduct, Fin.sum_univ_three, berggrenMat]

/-- Branch C: h(C::σ) = -2a + 2b + 3c. -/
theorem hyp_formula_C (σ : BPath) :
    hyp (2 :: σ) = -2 * pathTriple σ 0 + 2 * pathTriple σ 1 + 3 * pathTriple σ 2 := by
  simp [hyp, pathTriple, mulVec, dotProduct, Fin.sum_univ_three, berggrenMat]

/-! ## §9. Hypotenuse Strict Monotonicity -/

/-- A-branch: hypotenuse strictly increases. Uses c > b (from Pythagoras). -/
private theorem hyp_increase_A (σ : BPath) : hyp σ < hyp (0 :: σ) := by
  simp [hyp, pathTriple, mulVec, dotProduct, Fin.sum_univ_three, berggrenMat]
  nlinarith [pathTriple_pos σ 0, pathTriple_pos σ 1, pathTriple_pos σ 2,
             pathTriple_pythagorean σ,
             sq_nonneg (pathTriple σ 2 - pathTriple σ 1)]

/-- B-branch: hypotenuse strictly increases (obvious since all terms positive). -/
private theorem hyp_increase_B (σ : BPath) : hyp σ < hyp (1 :: σ) := by
  simp [hyp, pathTriple, mulVec, dotProduct, Fin.sum_univ_three, berggrenMat]
  linarith [pathTriple_pos σ 0, pathTriple_pos σ 1, pathTriple_pos σ 2]

/-- C-branch: hypotenuse strictly increases. Uses c > a (from Pythagoras). -/
private theorem hyp_increase_C (σ : BPath) : hyp σ < hyp (2 :: σ) := by
  simp [hyp, pathTriple, mulVec, dotProduct, Fin.sum_univ_three, berggrenMat]
  nlinarith [pathTriple_pos σ 0, pathTriple_pos σ 1, pathTriple_pos σ 2,
             pathTriple_pythagorean σ,
             sq_nonneg (pathTriple σ 2 - pathTriple σ 0)]

/-- **Hypotenuse Strict Monotonicity**: h(i::σ) > h(σ) for all branches.
    Impact: partition function Z_n(s) converges for s > 1 →
    thermodynamic_pressure is well-defined. -/
theorem hyp_strictly_increasing (σ : BPath) (i : Fin 3) :
    hyp σ < hyp (i :: σ) := by
  fin_cases i
  · exact hyp_increase_A σ
  · exact hyp_increase_B σ
  · exact hyp_increase_C σ

/-! ## §10. Hypotenuse Lower Bounds -/

/-- The hypotenuse is at least 5 + n where n is path length. -/
theorem hyp_ge_root_plus_depth (σ : BPath) : 5 + σ.length ≤ hyp σ := by
  induction σ with
  | nil => native_decide
  | cons i rest ih =>
    have := hyp_strictly_increasing rest i
    simp [List.length_cons]; omega

/-- The hypotenuse is always at least 5. -/
theorem hyp_ge_five (σ : BPath) : 5 ≤ hyp σ := by
  have := hyp_ge_root_plus_depth σ; omega

/-- The hypotenuse is always positive.
    Impact: partition function terms h^{-s} are well-defined. -/
theorem hyp_pos (σ : BPath) : 0 < hyp σ := by
  have := hyp_ge_five σ; omega

/-! ## §11. Branch-Specific Growth Bounds -/

/-- B-branch triples the hypotenuse: h(B::σ) ≥ 3·h(σ).
    Impact: B-paths give the strongest lattice_crypto bounds. -/
theorem hyp_B_branch_tripling (σ : BPath) :
    3 * hyp σ ≤ hyp (1 :: σ) := by
  rw [hyp_formula_B]; simp only [hyp]
  linarith [pathTriple_pos σ 0, pathTriple_pos σ 1]

/-- A-branch increases hypotenuse by at least 2. -/
theorem hyp_A_branch_growth (σ : BPath) :
    hyp σ + 2 ≤ hyp (0 :: σ) := by
  rw [hyp_formula_A]; simp only [hyp]
  nlinarith [pathTriple_pos σ 0, pathTriple_pos σ 2,
             pathTriple_pythagorean σ,
             sq_nonneg (pathTriple σ 2 - pathTriple σ 1)]

/-! ## §12. Exponential Growth -/

/-- Pure B-paths give h ≥ 5·3ⁿ.
    Bridge: B-paths maximize partition function contributions.
    Impact: O(3ⁿ) growth rate for lattice_crypto dimension analysis. -/
theorem hyp_B_iterate_bound (n : ℕ) :
    5 * 3 ^ n ≤ hyp (List.replicate n 1) := by
  induction n with
  | zero => native_decide
  | succ n ih =>
    rw [List.replicate_succ]
    calc 5 * 3 ^ (n + 1) = 3 * (5 * 3 ^ n) := by ring
    _ ≤ 3 * hyp (List.replicate n 1) := by linarith
    _ ≤ hyp (1 :: List.replicate n 1) := hyp_B_branch_tripling _

/-! ## §13. Trace and Eigenvalue Analysis -/

/-- tr(A) = 3, tr(B) = 5, tr(C) = 3.
    Bridge: trace = Σ eigenvalues → spectral theory → thermodynamic formalism. -/
theorem trace_berggrenMat_0 : Matrix.trace (berggrenMat 0) = 3 := by native_decide
theorem trace_berggrenMat_1 : Matrix.trace (berggrenMat 1) = 5 := by native_decide
theorem trace_berggrenMat_2 : Matrix.trace (berggrenMat 2) = 3 := by native_decide

/-- A is unipotent: (A-I)³ = 0. All eigenvalues are 1.
    Bridge: unipotent ↔ parabolic in PSL(2,ℤ). -/
theorem berggrenMat_A_unipotent : (berggrenMat 0 - 1) ^ 3 = 0 := by native_decide

/-- C is unipotent: (C-I)³ = 0. Conjugate to A. -/
theorem berggrenMat_C_unipotent : (berggrenMat 2 - 1) ^ 3 = 0 := by native_decide

/-- A is unipotent of exact order 3: (A-I)² ≠ 0. -/
theorem berggrenMat_A_nilpotency_exact : (berggrenMat 0 - 1) ^ 2 ≠ 0 := by native_decide

/-- B satisfies B³ - 5B² - 5B + I = 0.
    Eigenvalues: -1, 3+2√2 ≈ 5.83, 3-2√2 ≈ 0.17.
    Bridge: spectral radius ρ(B) = 3+2√2 → convergence radius of ζ_P(s). -/
theorem berggrenMat_B_charPoly :
    (berggrenMat 1) ^ 3 - 5 • (berggrenMat 1) ^ 2
      - 5 • (berggrenMat 1) + 1 = 0 := by native_decide

/-- B is NOT unipotent. -/
theorem berggrenMat_B_not_unipotent : (berggrenMat 1 - 1) ^ 3 ≠ 0 := by native_decide

/-! ## §14. Conjugacy and Symmetry -/

/-- The leg-swap matrix exchanges a ↔ b. -/
def legSwap : Matrix (Fin 3) (Fin 3) ℤ := !![0, 1, 0; 1, 0, 0; 0, 0, 1]

/-- A and C are conjugate: S·A·S = C.
    Bridge: Z₂ symmetry (a,b,c) ↔ (b,a,c) halves spectral analysis. -/
theorem berggrenMat_AC_conjugate :
    legSwap * berggrenMat 0 * legSwap = berggrenMat 2 := by native_decide

/-- Leg-swap is an involution: S² = I. -/
theorem legSwap_involution : legSwap * legSwap = 1 := by native_decide

/-- Leg-swap preserves the Lorentz form. -/
theorem legSwap_preserves_lorentz :
    legSwap.transpose * lorentzMat * legSwap = lorentzMat := by native_decide

/-- The Berggren monoid is non-commutative: A·B ≠ B·A. -/
theorem berggren_noncommutative :
    berggrenMat 0 * berggrenMat 1 ≠ berggrenMat 1 * berggrenMat 0 := by native_decide

/-! ## §15. Eigenvalue Constants -/

/-- Spectral radius of B: 3 + 2√2 ≈ 5.828.
    Controls maximum hypotenuse growth rate. -/
noncomputable def berggrenSpectralRadius : ℝ := 3 + 2 * Real.sqrt 2

/-- Minimum eigenvalue magnitude: 3 - 2√2 ≈ 0.172. -/
noncomputable def berggrenMinGrowth : ℝ := 3 - 2 * Real.sqrt 2

/-- (3+2√2)(3-2√2) = 1. Galois conjugate product in ℚ(√2). -/
theorem eigenvalue_product :
    berggrenSpectralRadius * berggrenMinGrowth = 1 := by
  unfold berggrenSpectralRadius berggrenMinGrowth
  have : Real.sqrt 2 ^ 2 = 2 := Real.sq_sqrt (by norm_num : (2:ℝ) ≥ 0)
  nlinarith

/-- The spectral radius is positive. -/
theorem spectral_radius_pos : 0 < berggrenSpectralRadius := by
  unfold berggrenSpectralRadius; linarith [Real.sqrt_nonneg 2]

/-- Minimum growth is positive: 2√2 < 3.
    Impact: no branch contracts. -/
theorem min_growth_pos : 0 < berggrenMinGrowth := by
  unfold berggrenMinGrowth
  have h1 : Real.sqrt 2 ^ 2 = 2 := Real.sq_sqrt (by norm_num : (2:ℝ) ≥ 0)
  have h4 : Real.sqrt 2 ≥ 0 := Real.sqrt_nonneg 2
  have h5 : Real.sqrt 2 < 3/2 := by
    by_contra h; push_neg at h
    have : (3/2 : ℝ) ^ 2 ≤ Real.sqrt 2 ^ 2 := sq_le_sq' (by linarith) h
    linarith [show (3/2 : ℝ) ^ 2 = 9/4 from by norm_num]
  linarith

/-- Spectral radius > 1: exponential growth.
    Impact: lattice_crypto hardness guarantees. -/
theorem spectral_radius_gt_one : 1 < berggrenSpectralRadius := by
  unfold berggrenSpectralRadius; linarith [Real.sqrt_nonneg 2]

/-- (3+2√2) + (3-2√2) = 6 = tr(B) - (-1). -/
theorem eigenvalue_sum :
    berggrenSpectralRadius + berggrenMinGrowth = 6 := by
  unfold berggrenSpectralRadius berggrenMinGrowth; ring

/-- Minimum growth < 1: C-type branches slow growth.
    Impact: variance in Gibbs measure — key for phase analysis. -/
theorem min_growth_lt_one : berggrenMinGrowth < 1 := by
  unfold berggrenMinGrowth
  suffices 1 < Real.sqrt 2 by linarith
  rw [show (1:ℝ) = Real.sqrt 1 from by simp]
  exact Real.sqrt_lt_sqrt (by norm_num) (by norm_num)

/-! ## §16. Path Matrix Structure -/

/-- Path triple = path matrix × root vector. -/
theorem pathTriple_eq_pathMatrix_mulVec (σ : BPath) :
    pathTriple σ = (pathMatrix σ).mulVec rootVec := by
  induction σ with
  | nil => simp [pathTriple, pathMatrix, Matrix.one_mulVec]
  | cons i rest ih =>
    simp [pathTriple, pathMatrix, ← Matrix.mulVec_mulVec, ih]

/-- Path matrix preserves the Lorentz form.
    Bridge: Berggren monoid ⊂ O(2,1;ℤ) → thermodynamic consistency. -/
theorem pathMatrix_preserves_lorentz (σ : BPath) :
    (pathMatrix σ).transpose * lorentzMat * (pathMatrix σ) = lorentzMat := by
  induction σ with
  | nil => simp [pathMatrix]
  | cons i rest ih =>
    show (berggrenMat i * pathMatrix rest).transpose * lorentzMat *
      (berggrenMat i * pathMatrix rest) = lorentzMat
    rw [Matrix.transpose_mul]
    have key : (pathMatrix rest).transpose * (berggrenMat i).transpose * lorentzMat *
        (berggrenMat i * pathMatrix rest) =
      (pathMatrix rest).transpose * ((berggrenMat i).transpose * lorentzMat * berggrenMat i) *
        pathMatrix rest := by
      simp only [Matrix.mul_assoc]
    rw [key, berggrenMat_preserves_lorentz, ih]

