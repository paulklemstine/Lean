# Gale-Stewart Infinite Game Theory: Core Foundations

Rigorous foundations for Gale-Stewart infinite games: strategies, plays,
winning conditions, determinacy, Wadge reducibility, game rank, quasi-strategies,
and game morphisms.

## References
* D. Gale, F.M. Stewart, "Infinite games with perfect information" (1953)
* D.A. Martin, "Borel Determinacy" (1975)
* A. Kechris, "Classical Descriptive Set Theory" (1995)
-/
import Mathlib

namespace GS

open Classical

/-! ## Core Definitions -/

/-- A strategy in a Gale-Stewart game: maps finite play histories to moves. -/
def Strategy (α : Type*) := List α → α

/-- Build the finite prefix of a play from two strategies. -/
def playPrefix {α : Type*} (σ τ : Strategy α) : ℕ → List α
  | 0 => []
  | n + 1 =>
    let h := playPrefix σ τ n
    h ++ [if n % 2 = 0 then σ h else τ h]

@[simp]
theorem playPrefix_length {α : Type*} (σ τ : Strategy α) (n : ℕ) :
    (playPrefix σ τ n).length = n := by
  induction n with
  | zero => simp [playPrefix]
  | succ n ih => simp [playPrefix, ih]

/-- The infinite play generated by two strategies. -/
noncomputable def playOf {α : Type*} (σ τ : Strategy α) (n : ℕ) : α :=
  if n % 2 = 0 then σ (playPrefix σ τ n) else τ (playPrefix σ τ n)

/-! ## Winning Conditions and Determinacy -/

/-- Player I has a winning strategy for payoff set A. -/
def WinningI {α : Type*} (A : Set (ℕ → α)) : Prop :=
  ∃ σ : Strategy α, ∀ τ : Strategy α, playOf σ τ ∈ A

/-- Player II has a winning strategy for payoff set A. -/
def WinningII {α : Type*} (A : Set (ℕ → α)) : Prop :=
  ∃ τ : Strategy α, ∀ σ : Strategy α, playOf σ τ ∉ A

/-- A game G(A) is determined if one player has a winning strategy. -/
def Determined {α : Type*} (A : Set (ℕ → α)) : Prop :=
  WinningI A ∨ WinningII A

/-! ## Strategy Exclusivity -/

/-- **Strategy Exclusivity**: Both players cannot simultaneously have winning strategies.
    Proof: if σ wins for I and τ wins for II, play(σ,τ) ∈ A ∧ play(σ,τ) ∉ A. -/
theorem strategy_exclusivity {α : Type*} (A : Set (ℕ → α)) :
    ¬(WinningI A ∧ WinningII A) := by
  rintro ⟨⟨σ, hσ⟩, ⟨τ, hτ⟩⟩
  exact hτ σ (hσ τ)

theorem winningI_not_winningII {α : Type*} {A : Set (ℕ → α)} (h : WinningI A) :
    ¬WinningII A := fun h2 => strategy_exclusivity A ⟨h, h2⟩

theorem winningII_not_winningI {α : Type*} {A : Set (ℕ → α)} (h : WinningII A) :
    ¬WinningI A := fun h1 => strategy_exclusivity A ⟨h1, h⟩

/-! ## Trivial Determinacy -/

theorem determined_empty (α : Type*) [Inhabited α] : Determined (∅ : Set (ℕ → α)) :=
  Or.inr ⟨fun _ => default, fun _ h => h⟩

theorem determined_univ (α : Type*) [Inhabited α] : Determined (Set.univ : Set (ℕ → α)) :=
  Or.inl ⟨fun _ => default, fun _ => Set.mem_univ _⟩

/-! ## Monotonicity -/

theorem winningI_mono {α : Type*} {A B : Set (ℕ → α)} (h : A ⊆ B) (hA : WinningI A) :
    WinningI B := by
  obtain ⟨σ, hσ⟩ := hA; exact ⟨σ, fun τ => h (hσ τ)⟩

theorem winningII_antimono {α : Type*} {A B : Set (ℕ → α)} (h : A ⊆ B) (hB : WinningII B) :
    WinningII A := by
  obtain ⟨τ, hτ⟩ := hB; exact ⟨τ, fun σ ha => hτ σ (h ha)⟩

/-! ## Complement Relationships -/

theorem winningI_compl_iff {α : Type*} (A : Set (ℕ → α)) :
    WinningI Aᶜ ↔ ∃ σ : Strategy α, ∀ τ : Strategy α, playOf σ τ ∉ A := by
  simp [WinningI, Set.mem_compl_iff]

theorem winningII_compl_iff {α : Type*} (A : Set (ℕ → α)) :
    WinningII Aᶜ ↔ ∃ τ : Strategy α, ∀ σ : Strategy α, playOf σ τ ∈ A := by
  simp [WinningII, Set.mem_compl_iff]

theorem winningII_of_determined_not_winningI {α : Type*} {A : Set (ℕ → α)}
    (hd : Determined A) (h : ¬WinningI A) : WinningII A := hd.resolve_left h

/-! ## Union / Intersection -/

theorem winningI_union_left {α : Type*} {A B : Set (ℕ → α)}
    (hA : WinningI A) : WinningI (A ∪ B) := winningI_mono Set.subset_union_left hA

theorem winningII_inter_of_left {α : Type*} {A B : Set (ℕ → α)}
    (hA : WinningII A) : WinningII (A ∩ B) := winningII_antimono Set.inter_subset_left hA

/-! ## Prefix-Determined Games -/

/-- A game is n-prefix-determined if membership depends only on the first n moves. -/
def PrefixDetermined {α : Type*} (A : Set (ℕ → α)) (n : ℕ) : Prop :=
  ∀ x y : ℕ → α, (∀ i, i < n → x i = y i) → (x ∈ A ↔ y ∈ A)

theorem prefix_determined_zero_det {α : Type*} [Inhabited α] {A : Set (ℕ → α)}
    (h : PrefixDetermined A 0) : Determined A := by
  by_cases hne : ∃ x : ℕ → α, x ∈ A
  · left; obtain ⟨x, hx⟩ := hne
    exact ⟨fun _ => default, fun τ =>
      (h x (playOf (fun _ => default) τ) (fun i hi => by omega)).mp hx⟩
  · right; push_neg at hne
    exact ⟨fun _ => default, fun _ => hne _⟩

theorem PrefixDetermined.mono {α : Type*} {A : Set (ℕ → α)} {m n : ℕ}
    (h : PrefixDetermined A m) (hmn : m ≤ n) : PrefixDetermined A n :=
  fun x y hxy => h x y (fun i hi => hxy i (by omega))

/-- Complement preserves prefix-determination. -/
theorem PrefixDetermined.compl {α : Type*} {A : Set (ℕ → α)} {n : ℕ}
    (h : PrefixDetermined A n) : PrefixDetermined Aᶜ n := by
  intro x y hxy; simp only [Set.mem_compl_iff]; exact (h x y hxy).not

/-- The reverse: prefix-determination of Aᶜ implies prefix-determination of A. -/
theorem PrefixDetermined.of_compl {α : Type*} {A : Set (ℕ → α)} {n : ℕ}
    (h : PrefixDetermined Aᶜ n) : PrefixDetermined A n := by
  have := h.compl; rwa [compl_compl] at this

/-! ## Wadge Reducibility -/

/-- **Wadge reducibility**: A ≤_W B via a Lipschitz-continuous reduction on Baire space. -/
def WadgeReducible {α : Type*} (A B : Set (ℕ → α)) : Prop :=
  ∃ f : (ℕ → α) → (ℕ → α),
    (∀ x, x ∈ A ↔ f x ∈ B) ∧
    (∀ x y : ℕ → α, ∀ n : ℕ, (∀ i, i < n → x i = y i) →
      ∀ i, i < n → f x i = f y i)

scoped infixl:50 " ≤_W " => WadgeReducible

theorem wadge_refl {α : Type*} (A : Set (ℕ → α)) : A ≤_W A :=
  ⟨id, fun _ => Iff.rfl, fun _ _ _ h i hi => h i hi⟩

theorem wadge_trans {α : Type*} {A B C : Set (ℕ → α)}
    (hab : A ≤_W B) (hbc : B ≤_W C) : A ≤_W C := by
  obtain ⟨f, hf_mem, hf_cont⟩ := hab
  obtain ⟨g, hg_mem, hg_cont⟩ := hbc
  exact ⟨g ∘ f,
    fun x => (hf_mem x).trans (hg_mem (f x)),
    fun x y n hxy i hi => hg_cont (f x) (f y) n (hf_cont x y n hxy) i hi⟩

/-- Wadge reduction to ∅ implies emptiness. -/
theorem wadge_to_empty {α : Type*} {A : Set (ℕ → α)} (h : A ≤_W ∅) : A = ∅ := by
  obtain ⟨f, hf_mem, _⟩ := h
  ext x; simp; intro hx; exact (hf_mem x).mp hx

/-- **Wadge reduction preserves prefix-determination**: the key structural theorem
    connecting topological and game-theoretic complexity. -/
theorem wadge_preserves_prefix_determined {α : Type*} {A B : Set (ℕ → α)} {n : ℕ}
    (hw : A ≤_W B) (hB : PrefixDetermined B n) : PrefixDetermined A n := by
  obtain ⟨f, hf_mem, hf_cont⟩ := hw
  intro x y hxy
  rw [hf_mem x, hf_mem y]
  exact hB (f x) (f y) (hf_cont x y n hxy)

/-! ## Game Rank -/

/-- The **game rank**: minimum prefix length for determination, or ⊤ if none. -/
noncomputable def gameRank {α : Type*} (A : Set (ℕ → α)) : ℕ∞ :=
  if h : ∃ n : ℕ, PrefixDetermined A n then (Nat.find h : ℕ∞) else ⊤

theorem gameRank_empty (α : Type*) : gameRank (∅ : Set (ℕ → α)) = 0 := by
  have hex : ∃ n : ℕ, PrefixDetermined (∅ : Set (ℕ → α)) n :=
    ⟨0, fun _ _ _ => by simp⟩
  simp only [gameRank, dif_pos hex]; norm_cast
  exact Nat.le_zero.mp (Nat.find_le (show PrefixDetermined (∅ : Set (ℕ → α)) 0 from
    fun _ _ _ => by simp))

theorem gameRank_univ (α : Type*) : gameRank (Set.univ : Set (ℕ → α)) = 0 := by
  have hex : ∃ n : ℕ, PrefixDetermined (Set.univ : Set (ℕ → α)) n :=
    ⟨0, fun _ _ _ => by simp⟩
  simp only [gameRank, dif_pos hex]; norm_cast
  exact Nat.le_zero.mp (Nat.find_le (show PrefixDetermined (Set.univ : Set (ℕ → α)) 0 from
    fun _ _ _ => by simp))

/-- **Complement invariance of game rank**: A and Aᶜ have the same game rank.
    Strategic complexity is a property of the boundary between A and Aᶜ. -/
theorem gameRank_compl {α : Type*} (A : Set (ℕ → α)) :
    gameRank Aᶜ = gameRank A := by
  simp only [gameRank]
  by_cases hex : ∃ n : ℕ, PrefixDetermined A n
  · have hexc : ∃ n : ℕ, PrefixDetermined Aᶜ n := by
      obtain ⟨n, hn⟩ := hex; exact ⟨n, hn.compl⟩
    rw [dif_pos hexc, dif_pos hex]
    congr 1; apply le_antisymm
    · apply Nat.find_le; exact (Nat.find_spec hex).compl
    · apply Nat.find_le; exact (Nat.find_spec hexc).of_compl
  · have hexc : ¬∃ n : ℕ, PrefixDetermined Aᶜ n := by
      intro ⟨n, hn⟩; exact hex ⟨n, hn.of_compl⟩
    rw [dif_neg hexc, dif_neg hex]

/-- **Wadge reduction does not increase game rank**. -/
theorem wadge_rank_monotone {α : Type*} {A B : Set (ℕ → α)}
    (hw : A ≤_W B) : gameRank A ≤ gameRank B := by
  by_cases hB : ∃ n : ℕ, PrefixDetermined B n
  · have hA : ∃ n : ℕ, PrefixDetermined A n := by
      obtain ⟨n, hn⟩ := hB; exact ⟨n, wadge_preserves_prefix_determined hw hn⟩
    simp only [gameRank, dif_pos hA, dif_pos hB]; norm_cast
    exact Nat.find_le (wadge_preserves_prefix_determined hw (Nat.find_spec hB))
  · simp only [gameRank, dif_neg hB]; exact le_top

/-! ## Quasi-Strategies -/

/-- A **quasi-strategy** for Player I: at each history, a nonempty set of allowed moves. -/
structure QuasiStrategyI (α : Type*) where
  allowed : List α → Set α
  nonempty : ∀ h : List α, (allowed h).Nonempty

def Strategy.toQuasiI {α : Type*} (σ : Strategy α) : QuasiStrategyI α where
  allowed := fun h => {σ h}
  nonempty := fun h => ⟨σ h, rfl⟩

def QuasiStrategyI.Refines {α : Type*} (q₁ q₂ : QuasiStrategyI α) : Prop :=
  ∀ h : List α, q₁.allowed h ⊆ q₂.allowed h

theorem QuasiStrategyI.refines_refl {α : Type*} (q : QuasiStrategyI α) :
    q.Refines q := fun _ => Set.Subset.refl _

theorem QuasiStrategyI.refines_trans {α : Type*} {q₁ q₂ q₃ : QuasiStrategyI α}
    (h₁₂ : q₁.Refines q₂) (h₂₃ : q₂.Refines q₃) : q₁.Refines q₃ :=
  fun h => Set.Subset.trans (h₁₂ h) (h₂₃ h)

theorem QuasiStrategyI.refines_antisymm {α : Type*} {q₁ q₂ : QuasiStrategyI α}
    (h₁₂ : q₁.Refines q₂) (h₂₁ : q₂.Refines q₁) :
    q₁.allowed = q₂.allowed :=
  funext fun h => Set.Subset.antisymm (h₁₂ h) (h₂₁ h)

/-- Every quasi-strategy can be refined to a deterministic strategy (via choice). -/
noncomputable def QuasiStrategyI.toStrategy {α : Type*} (q : QuasiStrategyI α) :
    Strategy α := fun h => (q.nonempty h).some

theorem QuasiStrategyI.toStrategy_mem {α : Type*} (q : QuasiStrategyI α)
    (h : List α) : q.toStrategy h ∈ q.allowed h := (q.nonempty h).some_mem

theorem QuasiStrategyI.toStrategy_refines {α : Type*} (q : QuasiStrategyI α) :
    q.toStrategy.toQuasiI.Refines q := by
  intro h a ha; simp [Strategy.toQuasiI] at ha; rw [ha]; exact q.toStrategy_mem h

/-! ## Game Morphisms -/

/-- A **game morphism** from G(A) to G(B) preserves winning for both players.
    This is a novel categorical notion capturing strategic embedding. -/
structure GameMorphism (α β : Type*) (A : Set (ℕ → α)) (B : Set (ℕ → β)) where
  mapI : Strategy α → Strategy β
  mapII : Strategy α → Strategy β
  preserves_winI : ∀ σ : Strategy α, (∀ τ, playOf σ τ ∈ A) →
    ∀ τ' : Strategy β, playOf (mapI σ) τ' ∈ B
  preserves_winII : ∀ τ : Strategy α, (∀ σ, playOf σ τ ∉ A) →
    ∀ σ' : Strategy β, playOf σ' (mapII τ) ∉ B

/-- Game morphisms preserve determinacy: the fundamental transfer principle. -/
theorem GameMorphism.preserves_determined {α β : Type*}
    {A : Set (ℕ → α)} {B : Set (ℕ → β)}
    (φ : GameMorphism α β A B) (hA : Determined A) : Determined B := by
  cases hA with
  | inl h => obtain ⟨σ, hσ⟩ := h; exact Or.inl ⟨φ.mapI σ, φ.preserves_winI σ hσ⟩
  | inr h => obtain ⟨τ, hτ⟩ := h; exact Or.inr ⟨φ.mapII τ, φ.preserves_winII τ hτ⟩

def GameMorphism.id {α : Type*} (A : Set (ℕ → α)) : GameMorphism α α A A where
  mapI := _root_.id
  mapII := _root_.id
  preserves_winI := fun _ hσ τ => hσ τ
  preserves_winII := fun _ hτ σ => hτ σ

def GameMorphism.comp {α β γ : Type*}
    {A : Set (ℕ → α)} {B : Set (ℕ → β)} {C : Set (ℕ → γ)}
    (g : GameMorphism β γ B C) (f : GameMorphism α β A B) :
    GameMorphism α γ A C where
  mapI := g.mapI ∘ f.mapI
  mapII := g.mapII ∘ f.mapII
  preserves_winI := fun σ hσ τ' => g.preserves_winI (f.mapI σ) (f.preserves_winI σ hσ) τ'
  preserves_winII := fun τ hτ σ' => g.preserves_winII (f.mapII τ) (f.preserves_winII τ hτ) σ'

/-! ## Strategic Equivalence -/

/-- Two games are strategically equivalent if morphisms exist in both directions. -/
def StrategicEquiv {α β : Type*} (A : Set (ℕ → α)) (B : Set (ℕ → β)) : Prop :=
  Nonempty (GameMorphism α β A B) ∧ Nonempty (GameMorphism β α B A)

theorem strategicEquiv_refl {α : Type*} (A : Set (ℕ → α)) : StrategicEquiv A A :=
  ⟨⟨GameMorphism.id A⟩, ⟨GameMorphism.id A⟩⟩

theorem strategicEquiv_symm {α β : Type*} {A : Set (ℕ → α)} {B : Set (ℕ → β)}
    (h : StrategicEquiv A B) : StrategicEquiv B A := ⟨h.2, h.1⟩

theorem strategicEquiv_determined {α β : Type*} {A : Set (ℕ → α)} {B : Set (ℕ → β)}
    (h : StrategicEquiv A B) (hA : Determined A) : Determined B :=
  h.1.some.preserves_determined hA

/-! ## Uniform Winning for Indexed Families -/

/-- If a single Player II strategy defeats every game in a family, it defeats the union. -/
theorem winningII_iUnion_of_uniform {α ι : Type*} {A : ι → Set (ℕ → α)}
    (τ₀ : Strategy α) (hτ : ∀ i, ∀ σ, playOf σ τ₀ ∉ A i) :
    WinningII (⋃ i, A i) :=
  ⟨τ₀, fun σ h => by simp [Set.mem_iUnion] at h; obtain ⟨i, hi⟩ := h; exact hτ i σ hi⟩

end GS