# Tropical AC Normalization: A Certified Decision Procedure

This file implements a certified canonical-form normalizer for the
commutative-associative (AC) fragment of tropical (min-plus) expressions.

## Main results

- `normalize_ca_sound`: normalization preserves evaluation semantics
- `normalize_ca_complete`: AC-equivalent expressions normalize to the same form
- `normalize_ca_idempotent`: normalization is idempotent

Together these constitute a **certified decision procedure** for AC equivalence
of tropical expressions: two expressions are AC-equivalent if and only if they
have the same normal form.

## Why completeness is only for the AC fragment

The full tropical semiring satisfies additional identities (e.g., distributivity
of addition over min: `a + min b c = min (a+b) (a+c)`). These identities create
semantic equalities not generated by AC alone. Our normalizer is complete for
the AC congruence, which is the right mathematical target: it captures exactly
the equalities arising from commutativity and associativity of `min` and `+`.
-/

import Mathlib

open Classical

noncomputable section

namespace TropicalAC

/-! ## Expression Language -/

/-- A tropical expression over ℝ with constants, variables, min, and addition. -/
inductive TropExpr where
  | const : ℝ → TropExpr
  | var   : ℕ → TropExpr
  | tmin  : TropExpr → TropExpr → TropExpr
  | add   : TropExpr → TropExpr → TropExpr


instance : DecidableEq TropExpr := fun a b => Classical.dec (a = b)

/-! ## Semantic Evaluation -/

/-- Evaluate a tropical expression in environment `σ`. -/
def eval (σ : ℕ → ℝ) : TropExpr → ℝ
  | .const r   => r
  | .var n     => σ n
  | .tmin a b  => min (eval σ a) (eval σ b)
  | .add a b   => eval σ a + eval σ b

/-! ## AC Equivalence Relation -/

/-- The AC congruence on tropical expressions: the smallest congruence
    containing commutativity and associativity of both `tmin` and `add`. -/
inductive ACEquiv : TropExpr → TropExpr → Prop
  | refl  : ∀ e, ACEquiv e e
  | symm  : ∀ {e₁ e₂}, ACEquiv e₁ e₂ → ACEquiv e₂ e₁
  | trans : ∀ {e₁ e₂ e₃}, ACEquiv e₁ e₂ → ACEquiv e₂ e₃ → ACEquiv e₁ e₃
  | tmin_comm  : ∀ e₁ e₂, ACEquiv (.tmin e₁ e₂) (.tmin e₂ e₁)
  | tmin_assoc : ∀ e₁ e₂ e₃,
      ACEquiv (.tmin (.tmin e₁ e₂) e₃) (.tmin e₁ (.tmin e₂ e₃))
  | add_comm  : ∀ e₁ e₂, ACEquiv (.add e₁ e₂) (.add e₂ e₁)
  | add_assoc : ∀ e₁ e₂ e₃,
      ACEquiv (.add (.add e₁ e₂) e₃) (.add e₁ (.add e₂ e₃))
  | cong_tmin : ∀ {a a' b b'},
      ACEquiv a a' → ACEquiv b b' → ACEquiv (.tmin a b) (.tmin a' b')
  | cong_add  : ∀ {a a' b b'},
      ACEquiv a a' → ACEquiv b b' → ACEquiv (.add a b) (.add a' b')

/-! ## Comparison / Ordering on Expressions -/

/-- Constructor tag for ordering. -/
def TropExpr.tag : TropExpr → ℕ
  | .const _ => 0
  | .var _   => 1
  | .tmin _ _ => 2
  | .add _ _ => 3

/-- Boolean comparison: a decidable total order on `TropExpr`.
    Orders by constructor tag first, then lexicographically within
    same-constructor pairs. -/
def TropExpr.ble : TropExpr → TropExpr → Bool
  | .const r₁, .const r₂ => decide (r₁ ≤ r₂)
  | .var n₁, .var n₂ => decide (n₁ ≤ n₂)
  | .tmin a₁ b₁, .tmin a₂ b₂ =>
      if a₁ = a₂ then TropExpr.ble b₁ b₂ else TropExpr.ble a₁ a₂
  | .add a₁ b₁, .add a₂ b₂ =>
      if a₁ = a₂ then TropExpr.ble b₁ b₂ else TropExpr.ble a₁ a₂
  | e₁, e₂ => decide (TropExpr.tag e₁ ≤ TropExpr.tag e₂)

theorem ble_total (a b : TropExpr) : a.ble b = true ∨ b.ble a = true := by
  by_contra h;
  -- By definition of `ble`, we know that for any two expressions `a` and `b`, either `a.ble b` or `b.ble a` holds.
  have h_blet : ∀ a b : TropExpr, a.ble b = true ∨ b.ble a = true := by
    intros a b
    induction' a with a₁ a₂ ha₁ ha₂ generalizing b;
    · cases b <;> simp +decide [ TropExpr.ble ];
      · exact le_total _ _;
      · exact le_total _ _;
      · exact le_total _ _;
      · exact le_total _ _;
    · induction' b with b₁ b₂ hb₁ hb₂ generalizing a₂;
      · grind +locals;
      · simp +decide [ TropExpr.ble ];
        exact le_total _ _;
      · cases ‹∀ a₂ : ℕ, ( TropExpr.var a₂ ).ble hb₁ = true ∨ hb₁.ble ( TropExpr.var a₂ ) = true› a₂ <;> cases ‹∀ a₂ : ℕ, ( TropExpr.var a₂ ).ble hb₂ = true ∨ hb₂.ble ( TropExpr.var a₂ ) = true› a₂ <;> simp_all +decide [ TropExpr.ble ];
        · exact le_total _ _;
        · exact le_total _ _;
        · exact le_total _ _;
        · exact le_total _ _;
      · grind +locals;
    · rcases b with ( _ | _ | _ | _ ) <;> simp_all +decide [ TropExpr.ble ];
      · exact le_total _ _;
      · exact le_total _ _;
      · grind;
      · exact le_total _ _;
    · induction' b with b₁ b₂ hb₁ hb₂;
      · grind +locals;
      · grind +locals;
      · grind +locals;
      · unfold TropExpr.ble; simp +decide [ * ] ;
        grind;
  exact h <| h_blet a b

theorem ble_antisymm (a b : TropExpr) :
    a.ble b = true → b.ble a = true → a = b := by
  revert a b;
  intro a b ha hb;
  -- We'll use induction on the structure of `a` and `b`.
  induction' a with a₁ a₂ ih₁ ih₂ generalizing b;
  · cases b <;> simp_all +decide [ TropExpr.ble ];
    · grind +splitIndPred;
    · exact absurd hb ( by erw [ show TropExpr.tag ( TropExpr.var _ ) = 1 from rfl, show TropExpr.tag ( TropExpr.const _ ) = 0 from rfl ] ; norm_num );
    · exact absurd hb ( by erw [ show ( TropExpr.const a₁ ).tag = 0 by rfl, show ( _ : TropExpr ).tag = 2 by rfl ] ; decide );
    · exact absurd hb ( by erw [ show ( _ : TropExpr ).tag = 3 by rfl ] ; exact not_le_of_gt ( by exact Nat.lt_succ_of_le ( Nat.le_add_left _ _ ) ) );
  · cases b;
    · cases ha;
    · simp_all +decide [ TropExpr.ble ];
      grind;
    · grind +locals;
    · cases hb;
  · induction' b with b₁ b₂ ih₁ ih₂ generalizing ih₁ ih₂;
    · cases ih₁ <;> cases ih₂ <;> tauto;
    · cases ih₁ <;> cases ih₂ <;> tauto;
    · unfold TropExpr.ble at ha hb;
      grind +revert;
    · unfold TropExpr.ble at ha hb; simp +decide at ha hb;
      exact absurd hb ( by erw [ show ( _ : TropExpr ).tag = 3 by rfl ] ; exact Nat.not_le_of_gt ( by exact Nat.lt_succ_of_le ( Nat.le_add_left _ _ ) ) );
  · induction' b with b₁ b₂ ih₁ ih₂;
    · cases ha;
    · cases ha;
    · cases ha;
    · unfold TropExpr.ble at ha hb;
      grind

set_option maxHeartbeats 800000 in
theorem ble_trans (a b c : TropExpr) :
    a.ble b = true → b.ble c = true → a.ble c = true := by
  have h_trans : ∀ (r₁ r₂ r₃ : ℝ), r₁ ≤ r₂ → r₂ ≤ r₃ → r₁ ≤ r₃ := by
    exact fun r₁ r₂ r₃ h₁ h₂ => le_trans h₁ h₂;
  have h_trans : ∀ (n₁ n₂ n₃ : ℕ), n₁ ≤ n₂ → n₂ ≤ n₃ → n₁ ≤ n₃ := by
    exact fun n₁ n₂ n₃ h₁ h₂ => le_trans h₁ h₂;
  have h_trans : ∀ (a b c : TropExpr), a.ble b = true → b.ble c = true → a.ble c = true := by
    intros a b c hab hbc
    induction' a with r₁ n₁ a₁ b₁ a₂ b₂ generalizing b c
    ·
      rcases b with ( _ | _ | _ | _ ) <;> rcases c with ( _ | _ | _ | _ ) <;> norm_cast at *;
      unfold TropExpr.ble at * ; aesop
    ·
      induction' b with r₂ n₂ a₂ b₂ a₃ b₃ generalizing c;
      · cases hab;
      · cases c <;> simp_all +decide [ TropExpr.ble ];
        · exact le_trans ( by simp +decide [ TropExpr.tag ] ) hbc;
        · exact h_trans _ _ _ hab hbc;
        · exact le_trans ( by exact Nat.le_add_left _ _ ) hbc;
        · exact le_trans ( by exact Nat.le_of_lt_succ ( by simp +decide [ TropExpr.tag ] ) ) hbc;
      · cases c <;> simp_all +decide [ TropExpr.ble ];
        · exact le_trans hab hbc;
        · cases a₂ <;> cases b₂ <;> tauto;
        · exact Nat.le_add_left _ _;
        · exact le_trans hab hbc;
      · cases c <;> tauto
    ·
      induction' b with r₂ n₂ a₃ b₃ a₄ b₄ generalizing c;
      · cases c <;> tauto;
      · grind +locals;
      · induction' c with r₄ n₄ a₅ b₅ a₆ b₆ generalizing a₁ b₁ a₃ b₃;
        · cases hbc;
        · cases hbc;
        · unfold TropExpr.ble at hab hbc ⊢;
          grind +suggestions;
        · unfold TropExpr.ble at hab hbc ⊢; aesop;
      · cases c <;> tauto
    ·
      induction' b with r₁ n₁ a₁ b₁ a₂ b₂ generalizing c;
      · cases c <;> tauto;
      · cases c <;> tauto;
      · grind +locals;
      · induction' c with r₁ n₁ a₁ b₁ a₂ b₂izing a b;
        · cases hbc;
        · finiteness;
        · unfold TropExpr.ble at hab hbc ⊢; aesop;
        · unfold TropExpr.ble at hab hbc ⊢;
          grind +suggestions;
  exact h_trans a b c

theorem ble_refl (a : TropExpr) : a.ble a = true := by
  -- By definition of `ble`, we know that `a.ble a` is true for any `a`.
  have h_ble_refl : ∀ a : TropExpr, a.ble a = true := by
    intro a;
    -- By definition of `ble`, we know that `a.ble a` is true for any `a` because the tag of `a` is equal to itself.
    apply (ble_total a a).elim; intro h; exact h; intro h; exact h;
  exact h_ble_refl a

/-! ## Flattening and Rebuilding -/

/-- Flatten nested `tmin` nodes into a list.
    Non-`tmin` nodes become singleton lists. -/
def flattenMin : TropExpr → List TropExpr
  | .tmin a b => flattenMin a ++ flattenMin b
  | e => [e]

/-- Flatten nested `add` nodes into a list. -/
def flattenAdd : TropExpr → List TropExpr
  | .add a b => flattenAdd a ++ flattenAdd b
  | e => [e]

/-- Rebuild a right-associated `tmin` tree from a nonempty list. -/
def rebuildMin : List TropExpr → TropExpr
  | []  => .const 0
  | [x] => x
  | x :: xs => .tmin x (rebuildMin xs)

/-- Rebuild a right-associated `add` tree from a nonempty list. -/
def rebuildAdd : List TropExpr → TropExpr
  | []  => .const 0
  | [x] => x
  | x :: xs => .add x (rebuildAdd xs)

/-- Predicate: an expression is not a `tmin` node. -/
def notTmin : TropExpr → Bool
  | .tmin _ _ => false
  | _ => true

/-- Predicate: an expression is not an `add` node. -/
def notAdd : TropExpr → Bool
  | .add _ _ => false
  | _ => true

/-! ## The Normalizer -/

/-- AC-canonical normalizer for tropical expressions.
    Recursively normalizes children, flattens same-operator chains,
    sorts by the total order, and rebuilds right-associated trees. -/
def normalize_ca : TropExpr → TropExpr
  | .const r => .const r
  | .var n => .var n
  | .tmin a b =>
      let a' := normalize_ca a
      let b' := normalize_ca b
      rebuildMin ((flattenMin a' ++ flattenMin b').mergeSort TropExpr.ble)
  | .add a b =>
      let a' := normalize_ca a
      let b' := normalize_ca b
      rebuildAdd ((flattenAdd a' ++ flattenAdd b').mergeSort TropExpr.ble)

/-! ## List Evaluation Helpers -/

/-- Evaluate a list of expressions under `min`, folding from the right. -/
def evalMinList (σ : ℕ → ℝ) : List TropExpr → ℝ
  | [] => 0
  | [x] => eval σ x
  | x :: xs => min (eval σ x) (evalMinList σ xs)

/-- Evaluate a list of expressions under `+`, folding from the right. -/
def evalAddList (σ : ℕ → ℝ) : List TropExpr → ℝ
  | [] => 0
  | [x] => eval σ x
  | x :: xs => eval σ x + evalAddList σ xs

/-! ## Helper Lemmas: Flatten/Rebuild Properties -/

theorem flattenMin_nonempty (e : TropExpr) : (flattenMin e).length > 0 := by
  -- We'll use induction on the structure of `e`.
  induction' e with e ih ih;
  · exact Nat.succ_pos _;
  · exact Nat.succ_pos _;
  · -- The length of the flattenMin of a tmin is the sum of the lengths of the flattenMin of the two sub-expressions.
    have h_length : (flattenMin (ih.tmin ‹_›)).length = (flattenMin ih).length + (flattenMin ‹_›).length := by
      -- The length of the concatenation of two lists is the sum of their lengths.
      apply List.length_append;
    -- Since both lengths are positive, their sum is positive.
    apply h_length.symm ▸ add_pos ‹_› ‹_›;
  · exact?

theorem flattenAdd_nonempty (e : TropExpr) : (flattenAdd e).length > 0 := by
  -- We can prove this by induction on the structure of `e`.
  induction' e with e ih;
  · -- The length of the list [TropExpr.const e] is 1, which is greater than 0.
    simp [flattenAdd];
  · exact Nat.succ_pos _;
  · -- By definition of `flattenAdd`, we have `flattenAdd (a.tmin b) = flattenAdd a ++ flattenAdd b`.
    simp [flattenAdd];
  · grind +locals

theorem flattenMin_notTmin (e : TropExpr) :
    ∀ x ∈ flattenMin e, notTmin x = true := by
  -- We'll use induction on the structure of `e` to prove that every element in `flattenMin e` is not a `tmin` node.
  induction' e with e ih;
  · -- In the constant case, the list is just [TropExpr.const e], and notTmin (TropExpr.const e) is true.
    simp [flattenMin, notTmin];
  · grind +locals;
  · -- By definition of `flattenMin`, we have `flattenMin (a.tmin b) = flattenMin a ++ flattenMin b`.
    have h_flattenMin_tmin : ∀ a b : TropExpr, flattenMin (a.tmin b) = flattenMin a ++ flattenMin b := by
      -- By definition of `flattenMin`, we have `flattenMin (a.tmin b) = flattenMin a ++ flattenMin b` for any `a` and `b`.
      intros a b
      rw [flattenMin];
    grind;
  · -- By definition of `flattenMin`, the elements of `flattenMin (a.add b)` are either in `flattenMin a` or `flattenMin b`.
    simp [flattenMin];
    rfl

theorem flattenAdd_notAdd (e : TropExpr) :
    ∀ x ∈ flattenAdd e, notAdd x = true := by
  -- By definition of `flattenAdd`, each element in the list is either a constant, a variable, or a node that's not an addition.
  have h_flattenAdd_elements : ∀ e : TropExpr, ∀ x ∈ flattenAdd e, x = .const (eval (fun _ => 0) x) ∨ x = .var (match x with | .var n => n | _ => 0) ∨ ¬(match x with | .add _ _ => true | _ => false) := by
    intro e x hx; rcases x with ( _ | _ | _ | _ ) <;> simp +decide ;
    induction e <;> simp_all +decide [ flattenAdd ];
  intro x hx; specialize h_flattenAdd_elements e x hx; rcases h_flattenAdd_elements with ( h | h | h ) <;> rcases x with ( _ | _ | _ | _ ) <;> tauto;

theorem flattenMin_of_notTmin {e : TropExpr} (h : notTmin e = true) :
    flattenMin e = [e] := by
  -- By definition of `flattenMin`, if `e` is not a `tmin` node, then `flattenMin e` is `[e]` because the function returns `[e]` for non-`tmin` nodes.
  cases e <;> simp [flattenMin] at h ⊢;
  -- Since `h` is false, we can use it to derive the desired result.
  exfalso; exact absurd h (by
  -- By definition of `notTmin`, if `e` is a `tmin` node, then `notTmin e` is false.
  simp [notTmin])

theorem flattenAdd_of_notAdd {e : TropExpr} (h : notAdd e = true) :
    flattenAdd e = [e] := by
  -- Since e is not an add node, the flattenAdd of e is just [e] by definition.
  cases e <;> simp [flattenAdd, notAdd] at h ⊢ h ⊢

theorem flattenMin_rebuildMin {l : List TropExpr} (hne : l ≠ [])
    (h : ∀ x ∈ l, notTmin x = true) : flattenMin (rebuildMin l) = l := by
  rcases l with ( _ | ⟨ x, _ | ⟨ y, l ⟩ ⟩ ) <;> simp_all +decide;
  · exact?;
  · induction' l with z l ih generalizing x y <;> simp_all +decide [ flattenMin, rebuildMin ];
    · rw [ flattenMin_of_notTmin, flattenMin_of_notTmin ] <;> tauto;
    · rw [ show flattenMin x = [ x ] from _ ] ; aesop;
      -- Since notTmin x is true, x is not a tmin node, so flattenMin x is [x].
      apply flattenMin_of_notTmin; exact h.left

theorem flattenAdd_rebuildAdd {l : List TropExpr} (hne : l ≠ [])
    (h : ∀ x ∈ l, notAdd x = true) : flattenAdd (rebuildAdd l) = l := by
  -- By definition of `rebuildAdd`, we can split the list into the first element and the rest.
  have h_rebuildAdd_split : ∀ (x : TropExpr) (xs : List TropExpr), rebuildAdd (x :: xs) = if xs.isEmpty then x else .add x (rebuildAdd xs) := by
    -- By definition of `rebuildAdd`, we can split into cases based on whether `xs` is empty or not.
    intros x xs
    cases xs <;> simp [rebuildAdd];
  induction' l with x xs ih;
  · contradiction;
  · by_cases hx : xs = [] <;> simp_all +decide;
    · exact?;
    · -- By definition of `flattenAdd`, we can split the list into the first element and the rest.
      have h_flattenAdd_split : ∀ (x : TropExpr) (xs : List TropExpr), flattenAdd (x.add (rebuildAdd xs)) = flattenAdd x ++ flattenAdd (rebuildAdd xs) := by
        exact?;
      rw [ h_flattenAdd_split, ih ];
      rw [ flattenAdd_of_notAdd ] ; aesop;
      exact h.1

/-! ## Helper Lemmas: Eval of Rebuilt Expressions -/

theorem evalMinList_cons2 (σ : ℕ → ℝ) (x : TropExpr) (y : TropExpr) (ys : List TropExpr) :
    evalMinList σ (x :: y :: ys) = min (eval σ x) (evalMinList σ (y :: ys)) := by
  simp [evalMinList]

theorem evalAddList_cons2 (σ : ℕ → ℝ) (x : TropExpr) (y : TropExpr) (ys : List TropExpr) :
    evalAddList σ (x :: y :: ys) = eval σ x + evalAddList σ (y :: ys) := by
  simp [evalAddList]

theorem eval_rebuildMin (σ : ℕ → ℝ) {l : List TropExpr} (hne : l ≠ []) :
    eval σ (rebuildMin l) = evalMinList σ l := by
  induction' l with x l ih;
  · contradiction;
  · cases l <;> simp +decide [ *, evalMinList ];
    · rfl;
    · exact ih ( by aesop ) ▸ rfl

theorem eval_rebuildAdd (σ : ℕ → ℝ) {l : List TropExpr} (hne : l ≠ []) :
    eval σ (rebuildAdd l) = evalAddList σ l := by
  induction' l with x l ih;
  · grind;
  · cases l <;> simp_all +decide [ List.cons_append ];
    · rfl;
    · convert congr_arg₂ ( · + · ) rfl ih using 1

/-! ## Helper Lemmas: Eval and Append -/

theorem evalMinList_append (σ : ℕ → ℝ) {l₁ l₂ : List TropExpr}
    (h₁ : l₁ ≠ []) (h₂ : l₂ ≠ []) :
    evalMinList σ (l₁ ++ l₂) = min (evalMinList σ l₁) (evalMinList σ l₂) := by
  induction' l₁ with l₁_head l₁_tail l₁_ih generalizing l₂ <;> simp_all +decide [ List.append_assoc ];
  cases l₁_tail <;> simp_all +decide [ evalMinList_cons2 ];
  · cases l₂ <;> simp +decide [ evalMinList_cons2 ] at *;
    rfl;
  · rw [ min_assoc ]

theorem evalAddList_append (σ : ℕ → ℝ) {l₁ l₂ : List TropExpr}
    (h₁ : l₁ ≠ []) (h₂ : l₂ ≠ []) :
    evalAddList σ (l₁ ++ l₂) = evalAddList σ l₁ + evalAddList σ l₂ := by
  induction' l₁ with x l₁ ih generalizing l₂ <;> simp_all +decide [ List.append_assoc ];
  cases l₁ <;> cases l₂ <;> simp_all +decide [ evalAddList_cons2 ];
  · rfl;
  · ring

/-! ## Helper Lemmas: Eval of Flatten -/

theorem eval_flattenMin (σ : ℕ → ℝ) (e : TropExpr) :
    evalMinList σ (flattenMin e) = eval σ e := by
  induction' e using TropExpr.recOn with e ih;
  · rfl;
  · rfl;
  · nontriviality;
    rename_i a b ha hb;
    rename_i c;
    convert evalMinList_append σ _ _ using 1;
    · exact b.symm ▸ ha.symm ▸ rfl;
    · exact ne_of_apply_ne List.length ( by exact ne_of_gt ( flattenMin_nonempty c ) );
    · exact ne_of_apply_ne List.length ( by exact ne_of_gt ( flattenMin_nonempty a ) );
  · exact?

theorem eval_flattenAdd (σ : ℕ → ℝ) (e : TropExpr) :
    evalAddList σ (flattenAdd e) = eval σ e := by
  induction' e with e ih;
  · rfl;
  · rfl;
  · rfl;
  · rename_i a b ha hb;
    -- By definition of `flattenAdd`, we have `flattenAdd (a.add b) = flattenAdd a ++ flattenAdd b`.
    have h_flatten : flattenAdd (a.add b) = flattenAdd a ++ flattenAdd b := by
      rfl;
    convert evalAddList_append σ _ _ using 1;
    · aesop;
    · exact ne_of_apply_ne List.length ( by exact ne_of_gt ( flattenAdd_nonempty a ) );
    · exact ne_of_apply_ne List.length ( by exact ne_of_gt ( flattenAdd_nonempty _ ) )

/-! ## Helper Lemmas: Permutation Invariance of Eval -/

theorem evalMinList_perm (σ : ℕ → ℝ) {l₁ l₂ : List TropExpr}
    (h₁ : l₁ ≠ []) (hp : l₁.Perm l₂) :
    evalMinList σ l₁ = evalMinList σ l₂ := by
  induction' hp with l₁ l₂ hp ih h₂ ih;
  · rfl;
  · rcases l₂ with ( _ | ⟨ x, _ | ⟨ y, l₂ ⟩ ⟩ ) <;> rcases hp with ( _ | ⟨ u, _ | ⟨ v, hp ⟩ ⟩ ) <;> simp_all +decide [ evalMinList ];
  · cases ‹List TropExpr› <;> simp +decide [ evalMinList ];
    · exact min_comm _ _;
    · grind;
  · rw [ ‹ ( _ : List TropExpr ) ≠ [] → evalMinList σ _ = evalMinList σ _ › h₁, ‹ ( _ : List TropExpr ) ≠ [] → evalMinList σ _ = evalMinList σ _ › ( by aesop ) ]

theorem evalAddList_perm (σ : ℕ → ℝ) {l₁ l₂ : List TropExpr}
    (h₁ : l₁ ≠ []) (hp : l₁.Perm l₂) :
    evalAddList σ l₁ = evalAddList σ l₂ := by
  induction' hp with l₁ l₂ hp ih h₂ ih;
  · rfl;
  · cases l₂ <;> cases hp <;> simp_all +decide [ evalAddList_cons2 ];
  · induction' ‹List TropExpr› with x l ih generalizing ih <;> simp_all +decide [ evalAddList_cons2 ] ; ring;
    · exact add_comm _ _;
    · grind;
  · grind +suggestions

/-! ## Helper Lemmas: Sort Properties -/

/-- Sorting by ble produces a permutation. -/
theorem sort_perm (l : List TropExpr) :
    (l.mergeSort TropExpr.ble).Perm l :=
  List.mergeSort_perm l TropExpr.ble

/-
Sorting preserves nonemptiness.
-/
theorem sort_nonempty {l : List TropExpr} (h : l ≠ []) :
    l.mergeSort TropExpr.ble ≠ [] := by
  exact fun h' => h ( by simpa [ List.length_eq_zero_iff ] using congr_arg List.length h' )

/-
Sorting a permutation gives the same result.
-/
theorem sort_perm_eq {l₁ l₂ : List TropExpr} (hp : l₁.Perm l₂) :
    l₁.mergeSort TropExpr.ble = l₂.mergeSort TropExpr.ble := by
  have h_perm : (l₁.mergeSort TropExpr.ble).Perm (l₂.mergeSort TropExpr.ble) := by
    exact List.Perm.trans ( List.mergeSort_perm _ _ ) ( hp.trans ( List.mergeSort_perm _ _ |> List.Perm.symm ) );
  have h_sorted : List.Pairwise (fun a b => TropExpr.ble a b = true ∧ ¬TropExpr.ble b a = true ∨ a = b) (l₁.mergeSort TropExpr.ble) ∧ List.Pairwise (fun a b => TropExpr.ble a b = true ∧ ¬TropExpr.ble b a = true ∨ a = b) (l₂.mergeSort TropExpr.ble) := by
    have h_sorted : ∀ l : List TropExpr, List.Pairwise (fun a b => TropExpr.ble a b = true ∧ ¬TropExpr.ble b a = true ∨ a = b) (l.mergeSort TropExpr.ble) := by
      intro l
      apply List.Pairwise.imp_of_mem;
      rotate_right;
      exact fun a b => TropExpr.ble a b = true;
      · exact fun { a b } ha hb hab => if h : a = b then Or.inr h else Or.inl ⟨ hab, by have := ble_antisymm a b; aesop ⟩;
      · convert List.sorted_mergeSort _ _ _;
        · exact?;
        · exact fun a b => by cases ble_total a b <;> simp +decide [ * ] ;
    exact ⟨ h_sorted l₁, h_sorted l₂ ⟩;
  apply_rules [ List.eq_of_perm_of_sorted ];
  rotate_right;
  use fun a b => a.ble b = true ∧ ¬b.ble a = true ∨ a = b;
  · grind;
  · exact h_sorted.1;
  · exact h_sorted.2

/-
Sorting is idempotent.
-/
theorem sort_idempotent (l : List TropExpr) :
    (l.mergeSort TropExpr.ble).mergeSort TropExpr.ble = l.mergeSort TropExpr.ble :=
  sort_perm_eq (List.mergeSort_perm l TropExpr.ble)

/-- Sorting preserves membership. -/
theorem sort_mem {l : List TropExpr} {x : TropExpr} :
    x ∈ l.mergeSort TropExpr.ble ↔ x ∈ l := by
  exact (sort_perm l).mem_iff

/-! ## Main Theorem 1: Soundness -/

/-
**Soundness**: normalization preserves evaluation semantics.
-/
theorem normalize_ca_sound (σ : ℕ → ℝ) (e : TropExpr) :
    eval σ (normalize_ca e) = eval σ e := by
  induction' e using TropExpr.recOn with e ih₂ ih₁ ih₂;
  · rfl;
  · rfl;
  · -- By definition of `normalize_ca`, we have:
    have h_normalize_tmin : normalize_ca (ih₁.tmin ih₂) = rebuildMin ((flattenMin (normalize_ca ih₁) ++ flattenMin (normalize_ca ih₂)).mergeSort TropExpr.ble) := by
      rfl;
    rw [ h_normalize_tmin, eval_rebuildMin ];
    · rw [ evalMinList_perm ];
      rotate_left;
      exact flattenMin ( normalize_ca ih₁ ) ++ flattenMin ( normalize_ca ih₂ );
      · exact sort_nonempty ( by have := flattenMin_nonempty ( normalize_ca ih₁ ) ; have := flattenMin_nonempty ( normalize_ca ih₂ ) ; aesop );
      · exact?;
      · rw [ evalMinList_append ];
        · rw [ eval_flattenMin, eval_flattenMin, ‹eval σ ( normalize_ca ih₁ ) = eval σ ih₁›, ‹eval σ ( normalize_ca ih₂ ) = eval σ ih₂› ];
          rfl;
        · exact ne_of_apply_ne List.length ( by exact ne_of_gt ( flattenMin_nonempty _ ) );
        · exact ne_of_apply_ne List.length ( by exact ne_of_gt ( flattenMin_nonempty _ ) );
    · exact sort_nonempty ( by have := flattenMin_nonempty ( normalize_ca ih₁ ) ; have := flattenMin_nonempty ( normalize_ca ih₂ ) ; aesop );
  · unfold normalize_ca;
    rename_i a b ha hb;
    convert evalAddList_perm σ _ ( sort_perm ( flattenAdd ( normalize_ca a ) ++ flattenAdd ( normalize_ca b ) ) ) using 1;
    · apply eval_rebuildAdd;
      exact sort_nonempty ( by have := flattenAdd_nonempty ( normalize_ca a ) ; have := flattenAdd_nonempty ( normalize_ca b ) ; aesop );
    · rw [ evalAddList_append ] <;> norm_num [ eval_flattenAdd ];
      · exact ha.symm ▸ hb.symm ▸ rfl;
      · exact ne_of_apply_ne List.length ( by exact ne_of_gt ( flattenAdd_nonempty _ ) );
      · exact ne_of_apply_ne List.length ( by exact ne_of_gt ( flattenAdd_nonempty _ ) );
    · exact sort_nonempty ( by have := flattenAdd_nonempty ( normalize_ca a ) ; have := flattenAdd_nonempty ( normalize_ca b ) ; aesop )

/-! ## Helper Lemmas for Completeness and ACEquiv -/

/-- Elements of sorted flattenMin are notTmin. -/
theorem sort_flattenMin_notTmin (e : TropExpr) :
    ∀ x ∈ (flattenMin e).mergeSort TropExpr.ble, notTmin x = true := by
  intro x hx; exact flattenMin_notTmin e x (sort_mem.mp hx)

theorem sort_flattenAdd_notAdd (e : TropExpr) :
    ∀ x ∈ (flattenAdd e).mergeSort TropExpr.ble, notAdd x = true := by
  intro x hx; exact flattenAdd_notAdd e x (sort_mem.mp hx)

theorem append_flattenMin_notTmin (a b : TropExpr) :
    ∀ x ∈ flattenMin a ++ flattenMin b, notTmin x = true := by
  intro x hx; simp [List.mem_append] at hx
  cases hx with
  | inl h => exact flattenMin_notTmin a x h
  | inr h => exact flattenMin_notTmin b x h

theorem append_flattenAdd_notAdd (a b : TropExpr) :
    ∀ x ∈ flattenAdd a ++ flattenAdd b, notAdd x = true := by
  intro x hx; simp [List.mem_append] at hx
  cases hx with
  | inl h => exact flattenAdd_notAdd a x h
  | inr h => exact flattenAdd_notAdd b x h

theorem sort_append_flattenMin_notTmin (a b : TropExpr) :
    ∀ x ∈ (flattenMin a ++ flattenMin b).mergeSort TropExpr.ble, notTmin x = true := by
  intro x hx; exact append_flattenMin_notTmin a b x (sort_mem.mp hx)

theorem sort_append_flattenAdd_notAdd (a b : TropExpr) :
    ∀ x ∈ (flattenAdd a ++ flattenAdd b).mergeSort TropExpr.ble, notAdd x = true := by
  intro x hx; exact append_flattenAdd_notAdd a b x (sort_mem.mp hx)

theorem append_flattenMin_nonempty (a b : TropExpr) :
    (flattenMin a ++ flattenMin b) ≠ [] := by
  have h1 := flattenMin_nonempty a
  have h2 := flattenMin_nonempty b
  simp [List.ne_nil_iff_length_pos, List.length_append]; omega

theorem append_flattenAdd_nonempty (a b : TropExpr) :
    (flattenAdd a ++ flattenAdd b) ≠ [] := by
  have h1 := flattenAdd_nonempty a
  have h2 := flattenAdd_nonempty b
  simp [List.ne_nil_iff_length_pos, List.length_append]; omega

/-
flattenMin of normalize_ca (tmin a b) equals the sorted concatenation.
-/
theorem flattenMin_normalize_ca_tmin (a b : TropExpr) :
    flattenMin (normalize_ca (.tmin a b)) =
    (flattenMin (normalize_ca a) ++ flattenMin (normalize_ca b)).mergeSort TropExpr.ble := by
  convert flattenMin_rebuildMin _ _ using 1;
  · exact sort_nonempty ( append_flattenMin_nonempty _ _ );
  · convert sort_append_flattenMin_notTmin ( normalize_ca a ) ( normalize_ca b ) using 1

/-
flattenAdd of normalize_ca (add a b) equals the sorted concatenation.
-/
theorem flattenAdd_normalize_ca_add (a b : TropExpr) :
    flattenAdd (normalize_ca (.add a b)) =
    (flattenAdd (normalize_ca a) ++ flattenAdd (normalize_ca b)).mergeSort TropExpr.ble := by
  convert flattenAdd_rebuildAdd _ _ using 1;
  · exact sort_nonempty ( append_flattenAdd_nonempty _ _ );
  · convert sort_append_flattenAdd_notAdd ( normalize_ca a ) ( normalize_ca b ) using 1

/-
rebuildMin of a permutation yields ACEquiv expressions.
-/
theorem rebuildMin_perm_ACEquiv {l₁ l₂ : List TropExpr}
    (hne : l₁ ≠ []) (hp : l₁.Perm l₂) :
    ACEquiv (rebuildMin l₁) (rebuildMin l₂) := by
  induction' hp with l₁ l₂ hp ih;
  · contradiction;
  · rcases l₂ with ( _ | ⟨ x, _ | ⟨ y, l₂ ⟩ ⟩ ) <;> simp_all +decide [ ACEquiv.refl ];
    convert ACEquiv.cong_tmin ( ACEquiv.refl _ ) ‹_› using 1;
    cases hp <;> aesop;
  · -- Use the fact that `rebuildMin` is symmetric under swapping the first two elements.
    have h_symm : ∀ (x y : TropExpr) (l : List TropExpr), ACEquiv (rebuildMin (x :: y :: l)) (rebuildMin (y :: x :: l)) := by
      intros x y l
      simp [rebuildMin];
      induction' l with z l ih generalizing x y <;> simp_all +decide [ rebuildMin ];
      · exact ACEquiv.tmin_comm x y;
      · have h_assoc : ∀ (a b c : TropExpr), ACEquiv (a.tmin (b.tmin c)) ((a.tmin b).tmin c) := by
          intros a b c; exact (by
          exact ACEquiv.symm ( ACEquiv.tmin_assoc a b c ));
        exact ACEquiv.trans ( h_assoc _ _ _ ) ( ACEquiv.trans ( ACEquiv.cong_tmin ( ACEquiv.tmin_comm _ _ ) ( ACEquiv.refl _ ) ) ( ACEquiv.symm ( h_assoc _ _ _ ) ) );
    exact ACEquiv.symm ( h_symm _ _ _ );
  · rename_i h₁ h₂ h₃ h₄ h₅₂;
    exact ACEquiv.trans ( h₄ hne ) ( h₅₂ ( by aesop ) )

/-
rebuildAdd of a permutation yields ACEquiv expressions.
-/
theorem rebuildAdd_perm_ACEquiv {l₁ l₂ : List TropExpr}
    (hne : l₁ ≠ []) (hp : l₁.Perm l₂) :
    ACEquiv (rebuildAdd l₁) (rebuildAdd l₂) := by
  induction' hp with l₁ l₂ hp ih;
  · contradiction;
  · cases l₂ <;> cases hp <;> simp_all +decide [ List.Perm ];
    · constructor;
    · exact ACEquiv.cong_add ( ACEquiv.refl _ ) ‹_›;
  · rename_i x y l;
    -- By definition of rebuildAdd, we have:
    have h_rebuildAdd_swap : ACEquiv (rebuildAdd (y :: x :: l)) (rebuildAdd (x :: y :: l)) := by
      have h_assoc : ACEquiv (rebuildAdd (y :: x :: l)) (rebuildAdd (x :: y :: l)) := by
        have h_assoc_step : ∀ (a b c : TropExpr), ACEquiv (.add a (.add b c)) (.add (.add a b) c) := by
          exact fun a b c => ACEquiv.symm ( ACEquiv.add_assoc a b c )
        have h_comm_step : ∀ (a b : TropExpr), ACEquiv (.add a b) (.add b a) := by
          exact fun a b => ACEquiv.add_comm a b;
        induction' l with l ih generalizing x y <;> simp_all +decide [ rebuildAdd ];
        exact ACEquiv.trans ( h_assoc_step _ _ _ ) ( ACEquiv.trans ( ACEquiv.cong_add ( h_comm_step _ _ ) ( ACEquiv.refl _ ) ) ( h_assoc_step _ _ _ |> ACEquiv.symm ) )
      exact h_assoc;
    exact h_rebuildAdd_swap;
  · rename_i l₁ l₂ l₃ h₁ h₂ h₃;
    exact ACEquiv.trans ( h₂ hne ) ( h₃ ( by aesop ) )

/-
Appending and rebuilding with tmin is ACEquiv to a tmin node.
-/
theorem rebuildMin_append_ACEquiv {l₁ l₂ : List TropExpr}
    (h₁ : l₁ ≠ []) (h₂ : l₂ ≠ []) :
    ACEquiv (rebuildMin (l₁ ++ l₂)) (.tmin (rebuildMin l₁) (rebuildMin l₂)) := by
  induction l₁ <;> simp_all +decide [ rebuildMin ];
  rename_i k hk;
  rcases k with ( _ | ⟨ x, k ⟩ ) <;> simp_all +decide [ rebuildMin ];
  · -- The equality of an expression to itself is trivially true.
    apply ACEquiv.refl;
  · exact ACEquiv.trans ( ACEquiv.cong_tmin ( ACEquiv.refl _ ) hk ) ( ACEquiv.symm <| ACEquiv.tmin_assoc _ _ _ )

/-
Appending and rebuilding with add is ACEquiv to an add node.
-/
theorem rebuildAdd_append_ACEquiv {l₁ l₂ : List TropExpr}
    (h₁ : l₁ ≠ []) (h₂ : l₂ ≠ []) :
    ACEquiv (rebuildAdd (l₁ ++ l₂)) (.add (rebuildAdd l₁) (rebuildAdd l₂)) := by
  induction' l₁ with x l₁ ih generalizing l₂ <;> simp_all +decide [ List.append_assoc ];
  rcases l₁ with ( _ | ⟨ y, l₁ ⟩ ) <;> simp_all +decide [ List.append_assoc ];
  · cases l₂ <;> simp_all +decide [ List.append_assoc ];
    -- By the associativity of addition, we can rewrite the right-hand side to match the left-hand side.
    have h_assoc : ACEquiv (rebuildAdd (x :: ‹TropExpr› :: ‹List TropExpr›)) (rebuildAdd [x] |>.add (rebuildAdd (‹TropExpr› :: ‹List TropExpr›))) := by
      have h_assoc : ∀ (a b c : TropExpr), ACEquiv (a.add (b.add c)) ((a.add b).add c) := by
        exact fun a b c => ACEquiv.symm ( ACEquiv.add_assoc a b c )
      exact?;
    exact h_assoc;
  · exact ACEquiv.cong_add ( ACEquiv.refl _ ) ( ih h₂ ) |> ACEquiv.trans <| ACEquiv.symm <| ACEquiv.add_assoc _ _ _

/-
Flattening and rebuilding under tmin is AC-equivalent.
-/
theorem ACEquiv_rebuildMin_flattenMin (e : TropExpr) :
    ACEquiv e (rebuildMin (flattenMin e)) := by
  refine' TropExpr.recOn e _ _ _ _;
  · exact fun a => ACEquiv.refl _;
  · exact?;
  · intro a b ha hb
    have h_append : ACEquiv (rebuildMin (flattenMin a ++ flattenMin b)) (.tmin (rebuildMin (flattenMin a)) (rebuildMin (flattenMin b))) := by
      apply_rules [ rebuildMin_append_ACEquiv ];
      · exact ne_of_apply_ne List.length ( by exact ne_of_gt ( flattenMin_nonempty a ) );
      · exact ne_of_apply_ne List.length ( by exact ne_of_gt ( flattenMin_nonempty _ ) );
    exact ACEquiv.trans ( ACEquiv.trans ( ACEquiv.cong_tmin ha hb ) ( ACEquiv.symm ( ACEquiv.refl _ ) ) ) ( ACEquiv.symm h_append );
  · intro a b ha hb;
    have h_append : ACEquiv (rebuildMin (flattenMin a ++ flattenMin b)) (.tmin (rebuildMin (flattenMin a)) (rebuildMin (flattenMin b))) := by
      apply_rules [ rebuildMin_append_ACEquiv ];
      · exact ne_of_apply_ne List.length ( by exact ne_of_gt ( flattenMin_nonempty a ) );
      · exact ne_of_apply_ne List.length ( by exact ne_of_gt ( flattenMin_nonempty _ ) );
    exact?

/-
Flattening and rebuilding under add is AC-equivalent.
-/
theorem ACEquiv_rebuildAdd_flattenAdd (e : TropExpr) :
    ACEquiv e (rebuildAdd (flattenAdd e)) := by
  induction' e with e ih;
  · exact ACEquiv.refl _;
  · exact ACEquiv.refl _;
  · exact?;
  · rename_i a b ih₁ ih₂;
    convert ACEquiv.cong_add ih₁ ih₂ |> ACEquiv.trans <| ?_ using 1;
    convert ACEquiv.symm ( rebuildAdd_append_ACEquiv ?_ ?_ ) using 1;
    · exact ne_of_apply_ne List.length ( by exact ne_of_gt ( flattenAdd_nonempty a ) );
    · exact ne_of_apply_ne List.length ( by exact ne_of_gt ( flattenAdd_nonempty b ) )

/-! ## Main Theorem 2: Completeness for ACEquiv -/

/-
**Completeness**: AC-equivalent expressions have the same normal form.
    This is the key theorem that makes `normalize_ca` a decision procedure
    for AC equivalence.
-/
theorem normalize_ca_complete {e₁ e₂ : TropExpr} (h : ACEquiv e₁ e₂) :
    normalize_ca e₁ = normalize_ca e₂ := by
  revert h e₂;
  -- By definition of ACEquiv, we know that if ACEquiv e₁ e₂, then their normalized forms are equal.
  have h_acequiv : ∀ (e₁ e₂ : TropExpr), ACEquiv e₁ e₂ → normalize_ca e₁ = normalize_ca e₂ := by
    intros e₁ e₂ h_acequiv
    induction' h_acequiv with e₁ e₂ h_acequiv ih;
    all_goals try tauto;
    grind +qlia;
    all_goals unfold normalize_ca; simp +decide [ *, List.mergeSort ] ;
    · apply congr_arg rebuildMin;
      apply sort_perm_eq;
      exact?;
    · rw [ flattenMin_normalize_ca_tmin, flattenMin_normalize_ca_tmin ];
      apply congr_arg rebuildMin;
      apply sort_perm_eq;
      rw [ List.perm_iff_count ];
      intro a; rw [ List.count_append, List.count_append ] ;
      rw [ List.Perm.count_eq ( List.mergeSort_perm _ _ ), List.Perm.count_eq ( List.mergeSort_perm _ _ ) ] ; ring;
      rw [ List.count_append, List.count_append ] ; ring;
    · rw [ sort_perm_eq ];
      exact?;
    · rw [ flattenAdd_normalize_ca_add, flattenAdd_normalize_ca_add ];
      congr! 1;
      apply sort_perm_eq;
      rw [ List.perm_iff_count ];
      intro a; rw [ List.count_append, List.count_append ] ;
      rw [ List.Perm.count_eq ( List.mergeSort_perm _ _ ), List.Perm.count_eq ( List.mergeSort_perm _ _ ) ] ; ring;
      rw [ List.count_append, List.count_append ] ; ring;
  grind +suggestions

/-! ## Main Theorem 3: Idempotence -/

/-
Normalization is AC-equivalent to the identity.
-/
theorem normalize_ca_ACEquiv (e : TropExpr) : ACEquiv e (normalize_ca e) := by
  -- We prove this by induction on the structure of the expression `e`.
  induction' e with e1 e2 ih1 ih2;
  · exact ACEquiv.refl _;
  · -- In the base case, when e is a variable, normalize_ca e is just e itself. Therefore, ACEquiv e e holds by the reflexive property of ACEquiv.
    apply ACEquiv.refl;
  · -- By definition of ACEquiv, we can apply the congruence rule for tmin.
    have h_tmin : ACEquiv (.tmin ih1 ih2) (.tmin (normalize_ca ih1) (normalize_ca ih2)) := by
      exact?;
    convert ACEquiv.trans h_tmin _ using 1;
    -- By definition of ACEquiv, we can apply the congruence rule for tmin to the normalized expressions.
    have h_tmin_rebuild : ACEquiv (.tmin (normalize_ca ih1) (normalize_ca ih2)) (rebuildMin (flattenMin (normalize_ca ih1) ++ flattenMin (normalize_ca ih2))) := by
      have h_tmin_rebuild : ACEquiv (.tmin (rebuildMin (flattenMin (normalize_ca ih1))) (rebuildMin (flattenMin (normalize_ca ih2)))) (rebuildMin (flattenMin (normalize_ca ih1) ++ flattenMin (normalize_ca ih2))) := by
        convert ACEquiv.symm ( rebuildMin_append_ACEquiv _ _ ) using 1;
        · exact ne_of_apply_ne List.length ( by exact ne_of_gt ( flattenMin_nonempty _ ) );
        · exact ne_of_apply_ne List.length ( by exact ne_of_gt ( flattenMin_nonempty _ ) );
      convert ACEquiv.trans _ h_tmin_rebuild using 1;
      apply ACEquiv.cong_tmin;
      · exact?;
      · exact?;
    convert h_tmin_rebuild.trans _ using 1;
    convert ACEquiv.symm ( rebuildMin_perm_ACEquiv _ _ ) using 1;
    · exact sort_nonempty ( append_flattenMin_nonempty _ _ );
    · exact?;
  · rename_i a b ha hb;
    -- By definition of normalize_ca, we have normalize_ca (a.add b) = rebuildAdd ((flattenAdd (normalize_ca a) ++ flattenAdd (normalize_ca b)).mergeSort TropExpr.ble).
    have h_normalize_ca_add : normalize_ca (a.add b) = rebuildAdd ((flattenAdd (normalize_ca a) ++ flattenAdd (normalize_ca b)).mergeSort TropExpr.ble) := by
      rfl;
    have h_rebuildAdd_perm : ACEquiv (rebuildAdd ((flattenAdd (normalize_ca a) ++ flattenAdd (normalize_ca b)).mergeSort TropExpr.ble)) (rebuildAdd (flattenAdd (normalize_ca a) ++ flattenAdd (normalize_ca b))) := by
      exact rebuildAdd_perm_ACEquiv (sort_nonempty (append_flattenAdd_nonempty _ _))
        (List.mergeSort_perm _ _);
    have h_rebuildAdd_add : ACEquiv (rebuildAdd (flattenAdd (normalize_ca a) ++ flattenAdd (normalize_ca b))) (.add (rebuildAdd (flattenAdd (normalize_ca a))) (rebuildAdd (flattenAdd (normalize_ca b)))) := by
      apply_rules [ rebuildAdd_append_ACEquiv ];
      · exact ne_of_apply_ne List.length ( by exact ne_of_gt ( flattenAdd_nonempty _ ) );
      · exact ne_of_apply_ne List.length ( by exact ne_of_gt ( flattenAdd_nonempty _ ) );
    have h_rebuildAdd_a : ACEquiv (rebuildAdd (flattenAdd (normalize_ca a))) (normalize_ca a) := by
      exact ACEquiv.symm ( ACEquiv_rebuildAdd_flattenAdd _ )
    have h_rebuildAdd_b : ACEquiv (rebuildAdd (flattenAdd (normalize_ca b))) (normalize_ca b) := by
      exact ACEquiv.symm ( ACEquiv_rebuildAdd_flattenAdd _ );
    have h_add : ACEquiv (a.add b) ((normalize_ca a).add (normalize_ca b)) := by
      exact ACEquiv.cong_add ha hb;
    exact h_normalize_ca_add.symm ▸ ACEquiv.trans h_add ( ACEquiv.trans ( ACEquiv.cong_add h_rebuildAdd_a.symm h_rebuildAdd_b.symm ) ( ACEquiv.trans h_rebuildAdd_add.symm h_rebuildAdd_perm.symm ) )

/-- **Idempotence**: normalizing twice is the same as normalizing once. -/
theorem normalize_ca_idempotent (e : TropExpr) :
    normalize_ca (normalize_ca e) = normalize_ca e :=
  normalize_ca_complete (ACEquiv.symm (normalize_ca_ACEquiv e))

/-! ## Corollary: Reflection Theorem -/

/-
**Soundness of ACEquiv**: AC-equivalent expressions have equal evaluations.
-/
theorem ACEquiv_sound {e₁ e₂ : TropExpr} (h : ACEquiv e₁ e₂) (σ : ℕ → ℝ) :
    eval σ e₁ = eval σ e₂ := by
  -- By the completeness of the normalization, if e₁ and e₂ are AC-equivalent, then their normal forms are equal.
  have h_norm_eq : normalize_ca e₁ = normalize_ca e₂ := by
    exact?;
  rw [ ← normalize_ca_sound σ e₁, ← normalize_ca_sound σ e₂, h_norm_eq ]

/-- **Decision procedure**: check AC equivalence by comparing normal forms. -/
theorem normalize_ca_decides_ACEquiv (e₁ e₂ : TropExpr) :
    ACEquiv e₁ e₂ ↔ normalize_ca e₁ = normalize_ca e₂ := by
  constructor
  · exact normalize_ca_complete
  · intro h
    exact ACEquiv.trans (normalize_ca_ACEquiv e₁)
      (ACEquiv.trans (by rw [h]; exact ACEquiv.refl _) (ACEquiv.symm (normalize_ca_ACEquiv e₂)))

end TropicalAC

end