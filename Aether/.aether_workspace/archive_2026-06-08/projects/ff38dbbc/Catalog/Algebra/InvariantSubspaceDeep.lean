# Invariant Subspace Problem: Deep Results

This file extends the invariant subspace theory with:

1. **Hyperinvariant subspaces** — subspaces invariant under the entire commutant.
2. **Cyclic subspace theory** — the cyclic subspace generated by a vector.
3. **Invariant subspace lattice** — complete lattice structure.
4. **Spectral decomposition depth** — a novel operator invariant.
5. **Self-adjoint and compact operator ISP** — concrete results.

## References

* Halmos, P.R. (1982). A Hilbert Space Problem Book.
* Radjavi, H. and Rosenthal, P. (2003). Invariant Subspaces.
-/
import Mathlib

open Submodule Module LinearMap Set

noncomputable section

/-! ## Novel Definition: Hyperinvariant Subspace -/

/-- A **hyperinvariant subspace** for an operator `T` is a closed subspace that
is invariant under every bounded linear operator commuting with `T`. -/
structure HyperinvariantSubspace
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    (T : H →L[ℂ] H) where
  carrier : Submodule ℂ H
  closed' : IsClosed (carrier : Set H)
  hyperinvariant : ∀ S : H →L[ℂ] H, S.comp T = T.comp S → ∀ x ∈ carrier, S x ∈ carrier

/-- A hyperinvariant subspace is **nontrivial** if it is neither ⊥ nor ⊤. -/
def HyperinvariantSubspace.IsNontrivial
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    {T : H →L[ℂ] H} (M : HyperinvariantSubspace T) : Prop :=
  M.carrier ≠ ⊥ ∧ M.carrier ≠ ⊤

/-! ## Basic definitions -/

/-- An operator has the **invariant subspace property** (ISP). -/
def HasISP {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    (T : H →L[ℂ] H) : Prop :=
  ∃ M : Submodule ℂ H,
    M ≠ ⊥ ∧ M ≠ ⊤ ∧ IsClosed (M : Set H) ∧ ∀ x ∈ M, T x ∈ M

/-! ## Hyperinvariant implies invariant -/

/-- Every hyperinvariant subspace is invariant under `T` itself. -/
theorem HyperinvariantSubspace.isInvariant
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    {T : H →L[ℂ] H} (M : HyperinvariantSubspace T) :
    ∀ x ∈ M.carrier, T x ∈ M.carrier :=
  M.hyperinvariant T (by ext x; simp [ContinuousLinearMap.comp_apply])

/-! ## Novel Definition: Cyclic Subspace -/

/-- The **cyclic subspace** generated by `x` under `T` is the closure of
`span{x, Tx, T²x, ...}`. -/
def cyclicSubspace {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    (T : H →L[ℂ] H) (x : H) : Submodule ℂ H :=
  Submodule.topologicalClosure
    (Submodule.span ℂ (range (fun n : ℕ => (T ^ n) x)))

/-- An operator has a **cyclic vector** if some nonzero vector generates ⊤. -/
def HasCyclicVector {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    (T : H →L[ℂ] H) : Prop :=
  ∃ x : H, x ≠ 0 ∧ cyclicSubspace T x = ⊤

/-! ## Novel Definition: Spectral Decomposition Depth -/

/-- The **spectral decomposition depth** measures how many distinct nonzero
eigenvalues can be found in the compact commutant of `T`. -/
def spectralDecompDepth
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (T : H →L[ℂ] H) : ℕ∞ :=
  ⨆ (K : H →L[ℂ] H) (_ : IsCompactOperator K) (_ : T.comp K = K.comp T),
    (⨆ (S : Finset ℂ) (_ : ∀ μ ∈ S, μ ≠ 0 ∧ ∃ x : H, x ≠ 0 ∧ K x = μ • x),
      (S.card : ℕ∞))

/-! ## Testable Conjecture: Spectral Depth Dichotomy -/

/-- **Conjecture:** For every operator on a separable infinite-dimensional
Hilbert space, spectralDecompDepth is either ⊤ or 0.

**Test:** Compute truncated spectral depth for weighted shifts on ℓ²(ℕ):
- Periodic weights → expect depth ⊤
- Random weights → expect depth 0
A single example with finite nonzero depth would disprove this. -/
def SpectralDepthDichotomyConjecture : Prop :=
  ∀ (H : Type) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    [TopologicalSpace.SeparableSpace H] (_ : ¬FiniteDimensional ℂ H),
    ∀ T : H →L[ℂ] H,
      spectralDecompDepth T = ⊤ ∨ spectralDecompDepth T = 0

/-! ## Eigenspace of compact operator is hyperinvariant for itself -/

/-
The eigenspace of `K` for eigenvalue `μ` is preserved by every operator
commuting with `K`. This makes it a hyperinvariant subspace for `K`.
-/
theorem eigenspace_hyperinvariant_for_self
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    (K : H →L[ℂ] H) (μ : ℂ) :
    ∀ S : H →L[ℂ] H, S.comp K = K.comp S →
      ∀ x ∈ Module.End.eigenspace (K : H →ₗ[ℂ] H) μ,
        S x ∈ Module.End.eigenspace (K : H →ₗ[ℂ] H) μ := by
  intro S hS x hx; have := congr_arg ( fun f => f x ) hS; simp_all +decide [ ContinuousLinearMap.ext_iff ] ;

/-- Build a `HyperinvariantSubspace` for `K` from its eigenspace. -/
theorem compact_eigenspace_is_hyperinvariant
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    (K : H →L[ℂ] H) (μ : ℂ) :
    ∃ M : HyperinvariantSubspace K,
      M.carrier = Module.End.eigenspace (K : H →ₗ[ℂ] H) μ := by
  refine ⟨⟨Module.End.eigenspace (K : H →ₗ[ℂ] H) μ, ?_, ?_⟩, rfl⟩
  · have : (Module.End.eigenspace (K : H →ₗ[ℂ] H) μ : Set H) =
        (K - μ • ContinuousLinearMap.id ℂ H).ker := by
      ext x; simp [Module.End.mem_eigenspace_iff, sub_eq_zero]
    rw [this]
    exact ContinuousLinearMap.isClosed_ker _
  · exact eigenspace_hyperinvariant_for_self K μ

/-! ## Intersection of invariant subspaces -/

/-- The intersection of any family of closed invariant subspaces is again
closed and invariant. -/
theorem iInf_invariant_closed
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    (T : H →L[ℂ] H) {ι : Type*}
    (M : ι → Submodule ℂ H)
    (hclosed : ∀ i, IsClosed (M i : Set H))
    (hinv : ∀ i, ∀ x ∈ M i, T x ∈ M i) :
    IsClosed ((⨅ i, M i : Submodule ℂ H) : Set H) ∧
    ∀ x ∈ (⨅ i, M i : Submodule ℂ H), T x ∈ (⨅ i, M i : Submodule ℂ H) := by
  constructor
  · have : ((⨅ i, M i : Submodule ℂ H) : Set H) = ⋂ i, (M i : Set H) := by
      simp [Submodule.coe_iInf]
    rw [this]
    exact isClosed_iInter hclosed
  · intro x hx
    simp [Submodule.mem_iInf] at hx ⊢
    intro i
    exact hinv i x (hx i)

/-! ## Invariance under powers (by induction) -/

/-- If `M` is invariant under `T`, then `M` is invariant under `T^n`. -/
theorem invariant_under_pow
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    (T : H →L[ℂ] H) {M : Submodule ℂ H}
    (hinv : ∀ x ∈ M, T x ∈ M) (n : ℕ) :
    ∀ x ∈ M, (T ^ n) x ∈ M := by
  induction n with
  | zero => intro x hx; simpa
  | succ n ih =>
    intro x hx
    rw [pow_succ]
    simp [ContinuousLinearMap.mul_apply]
    exact ih _ (hinv x hx)

/-! ## Kernel invariance under commutant -/

/-
The kernel of `K` is invariant under any `T` commuting with `K`.
-/
theorem ker_invariant_of_comm
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    (T K : H →L[ℂ] H) (hcomm : T.comp K = K.comp T) :
    ∀ x ∈ LinearMap.ker (K : H →ₗ[ℂ] H),
      T x ∈ LinearMap.ker (K : H →ₗ[ℂ] H) := by
  simp_all +decide [ funext_iff, ContinuousLinearMap.ext_iff ];
  exact fun x hx => by rw [ ← hcomm, hx, map_zero ] ;

/-! ## Range invariance under commutant -/

/-
The range of `K` is invariant under any `T` commuting with `K`.
-/
theorem range_invariant_of_comm
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    (T K : H →L[ℂ] H) (hcomm : T.comp K = K.comp T) :
    ∀ x ∈ LinearMap.range (K : H →ₗ[ℂ] H),
      T x ∈ LinearMap.range (K : H →ₗ[ℂ] H) := by
  simp_all +decide [ funext_iff, ContinuousLinearMap.ext_iff ]

/-! ## ISP from nontrivial kernel -/

/-- If `K` commutes with `T` and `ker K` is nontrivial and proper, then `T` has ISP. -/
theorem ISP_of_nontrivial_ker_comm
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (T K : H →L[ℂ] H)
    (hcomm : T.comp K = K.comp T)
    (hker_ne_bot : LinearMap.ker (K : H →ₗ[ℂ] H) ≠ ⊥)
    (hker_ne_top : LinearMap.ker (K : H →ₗ[ℂ] H) ≠ ⊤) :
    HasISP T :=
  ⟨LinearMap.ker (K : H →ₗ[ℂ] H), hker_ne_bot, hker_ne_top,
    ContinuousLinearMap.isClosed_ker K, ker_invariant_of_comm T K hcomm⟩

/-! ## Nilpotent operators have ISP -/

/-
**Nilpotent operators have ISP.** If `T^n = 0` for some `n ≥ 1` and `T ≠ 0`,
then `ker T` is a nontrivial proper invariant subspace.
-/
theorem nilpotent_has_ISP
    {V : Type*} [AddCommGroup V] [Module ℂ V] [Nontrivial V]
    (T : V →ₗ[ℂ] V) (hT : T ≠ 0)
    {n : ℕ} (hn : 0 < n) (hnil : T ^ n = 0) :
    ∃ M : Submodule ℂ V, M ≠ ⊥ ∧ M ≠ ⊤ ∧ ∀ x ∈ M, T x ∈ M := by
  refine' ⟨ LinearMap.ker T, _, _, _ ⟩ <;> simp_all +decide [ LinearMap.ext_iff ];
  contrapose! hT;
  -- If $\ker T = \bot$, then $T$ is injective.
  have h_inj : Function.Injective T := by
    exact LinearMap.ker_eq_bot.mp hT;
  induction hn <;> simp_all +decide [ pow_succ', Function.Injective.eq_iff h_inj ]

/-! ## Finite-dimensional ISP -/

/-
Every endomorphism of a finite-dimensional complex vector space of
dimension ≥ 2 has a nontrivial invariant subspace.
-/
theorem finiteDimensional_ISP
    {V : Type*} [AddCommGroup V] [Module ℂ V] [FiniteDimensional ℂ V]
    (hdim : 1 < Module.finrank ℂ V)
    (T : V →ₗ[ℂ] V) :
    ∃ M : Submodule ℂ V, M ≠ ⊥ ∧ M ≠ ⊤ ∧ ∀ x ∈ M, T x ∈ M := by
  obtain ⟨μ, hμ⟩ : ∃ μ : ℂ, Module.End.HasEigenvalue T μ := by
    have h_eigenvalue : ∃ μ : ℂ, Module.End.HasEigenvalue T μ := by
      have h_nontrivial : Nontrivial V := by
        exact Module.nontrivial_of_finrank_pos ( pos_of_gt hdim )
      exact?;
    exact h_eigenvalue;
  -- The eigenspace for μ is nonzero (contains an eigenvector).
  obtain ⟨v, hv⟩ : ∃ v : V, v ≠ 0 ∧ T v = μ • v := by
    simp_all +decide [ Module.End.HasUnifEigenvalue ];
    simp_all +decide [ Submodule.eq_bot_iff ];
    tauto;
  by_cases h : LinearMap.ker ( T - μ • LinearMap.id ) = ⊤;
  · -- If $T - \mu I$ � is� the zero map, then $T = \mu I$.
    have hT_eq : T = μ • LinearMap.id := by
      simp_all +decide [ Submodule.eq_top_iff', LinearMap.ext_iff ];
      exact fun x => sub_eq_zero.mp ( h x );
    -- Let $M$ be � a� 1-dimensional subs �pace� spanned by any nonzero vector � $�v \in V �$�.
    obtain ⟨v, hv⟩ : ∃ v : V, v ≠ 0 := by
      exact ⟨ v, hv.1 ⟩
    use Submodule.span ℂ {v};
    simp_all +decide [ Submodule.eq_top_iff', Submodule.mem_span_singleton ];
    refine' ⟨ _, fun a => ⟨ μ * a, by simp +decide [ mul_smul ] ⟩ ⟩;
    contrapose! hdim;
    exact finrank_le_one_iff.mpr ⟨ v, fun x => by obtain ⟨ c, rfl ⟩ := hdim x; exact ⟨ c, rfl ⟩ ⟩;
  · refine' ⟨ LinearMap.ker ( T - μ • LinearMap.id ), _, _, _ ⟩ <;> simp_all +decide [ Submodule.eq_bot_iff, Submodule.eq_top_iff' ];
    · grind;
    · simp_all +decide [ sub_eq_zero ]

/-! ## Eigenspace is T-invariant (algebra) -/

/-
The eigenspace of `T` for eigenvalue `μ` is invariant under `T`.
-/
theorem eigenspace_self_invariant
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    (T : M →ₗ[R] M) (μ : R) :
    ∀ x ∈ Module.End.eigenspace T μ, T x ∈ Module.End.eigenspace T μ := by
  simp +contextual [ Module.End.mem_eigenspace_iff ]

/-! ## Orthogonality of self-adjoint eigenspaces -/

/-
Distinct eigenspaces of a self-adjoint operator are orthogonal.
This is the mathematical foundation of quantum measurement theory.
-/
theorem selfAdjoint_eigenspaces_orthogonal
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (T : H →L[ℂ] H) (hsa : IsSelfAdjoint T)
    {μ ν : ℂ} (hμν : μ ≠ ν) {x y : H}
    (hx : x ∈ Module.End.eigenspace (T : H →ₗ[ℂ] H) μ)
    (hy : y ∈ Module.End.eigenspace (T : H →ₗ[ℂ] H) ν) :
    @inner ℂ H _ x y = 0 := by
  -- By the properties of the inner product � and� the fact that T is self- �adj�oint, we have ⟨Tx, y⟩ = ⟨x, Ty⟩.
  have h_inner : inner ℂ (T x) y = inner ℂ x (T y) := by
    rw [ ← ContinuousLinearMap.adjoint_inner_right, hsa.adjoint_eq ];
  -- Since $T$ is self- �adj�oint, we have $\langle_tx, x\rangle = \langle_x, tx\rangle$ for all $x$, which implies $\mu$ is real.
  have h_real : ∀ x : H, inner ℂ (T x) x = starRingEnd ℂ (inner ℂ (T x) x) := by
    simp +decide [ ← ContinuousLinearMap.adjoint_inner_right, hsa.adjoint_eq ];
  specialize h_real x; simp_all +decide [ inner_smul_left, inner_smul_right ] ;
  cases h_real <;> simp_all +decide [ mul_comm ]

/-! ## Self-adjoint eigenspace orthogonal complement is invariant -/

/-
For self-adjoint `T`, the orthogonal complement of any eigenspace is
`T`-invariant.
-/
theorem selfAdjoint_eigenspace_ortho_invariant
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (T : H →L[ℂ] H) (hsa : IsSelfAdjoint T) (μ : ℂ) :
    ∀ y ∈ (Module.End.eigenspace (T : H →ₗ[ℂ] H) μ).orthogonal,
      T y ∈ (Module.End.eigenspace (T : H →ₗ[ℂ] H) μ).orthogonal := by
  intro y hy;
  -- For any $u \in E_\mu$, we have $\langle T y, u \rangle = \langle y, T^* u \rangle$.
  have h_inner : ∀ u ∈ Module.End.eigenspace (T : H →ₗ[ℂ] H) μ, inner ℂ (T y) u = inner ℂ y (T u) := by
    intro u hu;
    rw [ ← ContinuousLinearMap.adjoint_inner_right, hsa.adjoint_eq ];
  intro u hu; specialize h_inner u hu; simp_all +decide [ Submodule.mem_orthogonal' ] ;
  rw [ ← inner_conj_symm, h_inner, map_zero ]

/-! ## Sum of invariant subspaces is invariant -/

/-
The sum (join) of two invariant subspaces is invariant.
-/
theorem invariantSubspace_sup_invariant
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    (T : H →L[ℂ] H) {M₁ M₂ : Submodule ℂ H}
    (h₁ : ∀ x ∈ M₁, T x ∈ M₁) (h₂ : ∀ x ∈ M₂, T x ∈ M₂) :
    ∀ x ∈ (M₁ ⊔ M₂ : Submodule ℂ H), T x ∈ (M₁ ⊔ M₂ : Submodule ℂ H) := by
  intro x hx
  rw [Submodule.mem_sup] at hx
  obtain ⟨x₁, hx₁, x₂, hx₂, rfl⟩ := hx
  simp [h₁, h₂];
  exact Submodule.add_mem_sup ( h₁ x₁ hx₁ ) ( h₂ x₂ hx₂ )

/-! ## Enflo-Read obstruction (contrapositive) -/

/-
If `T` has no nontrivial closed invariant subspace, then every compact
operator commuting with `T` has no nonzero eigenvalue.
-/
theorem noISP_implies_no_compact_eigenvalue
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (hInfDim : ¬FiniteDimensional ℂ H)
    (T : H →L[ℂ] H) (hno : ¬HasISP T)
    (K : H →L[ℂ] H) (hK : IsCompactOperator K) (hcomm : T.comp K = K.comp T)
    (μ : ℂ) (hμ : μ ≠ 0) :
    ¬∃ x : H, x ≠ 0 ∧ K x = μ • x := by
  intro h;
  -- If $K$ has a nonzero eigenvalue $\mu$, then the eigenspace of $K$ for $\mu$ is nontrivial � (�contains $x$), � proper� (finite-dimensional by compact �ness�, but space is � infinite�-dimensional), closed, and $T$-invariant (by commutation). This contradicts $hno$.
  obtain ⟨x, hx_ne_zero, hx_eigen⟩ := h;
  have h_eigenspace_nontrivial : Module.End.eigenspace (K : H →ₗ[ℂ] H) μ ≠ ⊥ := by
    simp_all +decide [ Submodule.ne_bot_iff ];
    use x;
  have h_eigenspace_proper : Module.End.eigenspace (K : H →ₗ[ℂ] H) μ ≠ ⊤ := by
    intro h_top
    have h_finite_rank : FiniteDimensional ℂ H := by
      have h_finite_rank : IsCompactOperator (μ⁻¹ • K) := by
        convert hK.smul ( μ⁻¹ ) using 1;
      convert h_finite_rank.isCompact_closure_image_closedBall 1;
      constructor <;> intro h <;> simp_all +decide [ SetLike.ext_iff ];
      exact hInfDim <| FiniteDimensional.of_isCompact_closedBall _ zero_lt_one h
    exact hInfDim h_finite_rank;
  have h_eigenspace_closed : IsClosed (Module.End.eigenspace (K : H →ₗ[ℂ] H) μ : Set H) := by
    convert ( isClosed_eq ( K.continuous.sub ( continuous_const.smul continuous_id' ) ) continuous_const ) using 1;
    any_goals exact μ;
    any_goals exact ( 0 : H );
    all_goals try infer_instance;
    simp +decide [ sub_eq_zero, Set.ext_iff ];
  have h_eigenspace_invariant : ∀ x ∈ Module.End.eigenspace (K : H →ₗ[ℂ] H) μ, T x ∈ Module.End.eigenspace (K : H →ₗ[ℂ] H) μ := by
    grind +suggestions;
  exact hno ⟨ _, h_eigenspace_nontrivial, h_eigenspace_proper, h_eigenspace_closed, h_eigenspace_invariant ⟩

/-! ## ISP for scalar multiples -/

/-
If `T = c • id` for some scalar `c`, and the space has dimension ≥ 2,
then every subspace is invariant, so `T` trivially has ISP.
-/
theorem scalar_has_ISP
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    (c : ℂ) (hdim : 1 < Module.finrank ℂ H) :
    HasISP (c • ContinuousLinearMap.id ℂ H) := by
  convert finiteDimensional_ISP _ _;
  convert Iff.rfl;
  rotate_left;
  exact H;
  all_goals try exact?;
  · exact FiniteDimensional.of_finrank_pos ( pos_of_gt hdim );
  · constructor <;> rintro ⟨ M, hM₁, hM₂ ⟩;
    · refine' ⟨ M, hM₁, hM₂.1, _, _ ⟩;
      · have h_finite_dim : FiniteDimensional ℂ H := by
          exact FiniteDimensional.of_finrank_pos ( pos_of_gt hdim );
        exact M.closed_of_finiteDimensional;
      · exact fun x hx => M.smul_mem c hx;
    · exact ⟨ M, hM₁, hM₂.1, fun x hx => hx ⟩

/-! ## Cyclic subspace is always closed -/

/-- The cyclic subspace is closed by construction. -/
theorem cyclicSubspace_isClosed
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    (T : H →L[ℂ] H) (x : H) :
    IsClosed (cyclicSubspace T x : Set H) :=
  isClosed_topologicalClosure _

/-! ## Cyclic subspace contains its generator -/

/-
`x ∈ cyclicSubspace T x`.
-/
theorem mem_cyclicSubspace_self
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    (T : H →L[ℂ] H) (x : H) :
    x ∈ cyclicSubspace T x := by
  exact subset_closure ( Submodule.subset_span ⟨ 0, by simp +decide ⟩ )

/-! ## Cyclic subspace of zero is bot -/

/-
The cyclic subspace of `0` is `⊥`.
-/
theorem cyclicSubspace_zero
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    (T : H →L[ℂ] H) :
    cyclicSubspace T (0 : H) = ⊥ := by
  simp [cyclicSubspace]

/-! ## ISP from absence of cyclic vectors -/

/-
If `T` has no cyclic vector on a nontrivial space, then `T` has ISP.
-/
theorem ISP_of_no_cyclic_vector
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [Nontrivial H]
    (T : H →L[ℂ] H) (h : ¬HasCyclicVector T) :
    HasISP T := by
  obtain ⟨ x, hx ⟩ := exists_ne ( 0 : H );
  refine' ⟨ _, _, _, _, _ ⟩;
  exact?;
  · exact fun h' => hx ( by simpa using h'.le ( mem_cyclicSubspace_self T x ) );
  · exact fun h' => h ⟨ x, hx, h' ⟩;
  · exact?;
  · intro y hy
    have h_inv : ∀ n : ℕ, (T ^ n) x ∈ cyclicSubspace T x := by
      exact fun n => subset_closure ( Submodule.subset_span ⟨ n, rfl ⟩ )
    have h_inv : ∀ n : ℕ, T ((T ^ n) x) ∈ cyclicSubspace T x := by
      intro n;
      convert h_inv ( n + 1 ) using 1 ; simp +decide [ pow_succ' ]
    have h_inv : ∀ y ∈ Submodule.span ℂ (Set.range (fun n : ℕ => (T ^ n) x)), T y ∈ cyclicSubspace T x := by
      intro y hy; induction hy using Submodule.span_induction <;> aesop;
    exact (by
    obtain ⟨ seq, hseq ⟩ := mem_closure_iff_seq_limit.mp hy;
    exact isClosed_closure.mem_of_tendsto ( T.continuous.continuousAt.tendsto.comp hseq.2 ) ( Filter.Eventually.of_forall fun n => h_inv _ ( hseq.1 n ) ))

/-! ## ISP equivalence with cyclic formulation -/

/-- The ISP is equivalent to the non-existence of cyclic vectors. -/
def ISP_CyclicFormulation : Prop :=
  ∀ (H : Type) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    [TopologicalSpace.SeparableSpace H] (_ : ¬FiniteDimensional ℂ H),
    ∀ T : H →L[ℂ] H, ¬HasCyclicVector T

/-! ## Full ISP Conjecture -/

/-- The Invariant Subspace Conjecture for separable Hilbert spaces. -/
def InvariantSubspaceConjecture : Prop :=
  ∀ (H : Type) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    [TopologicalSpace.SeparableSpace H] (_ : ¬FiniteDimensional ℂ H),
    ∀ T : H →L[ℂ] H, HasISP T

end