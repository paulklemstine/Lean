import Mathlib

/-! # Tropical Operadic Kernel Duality

This file formalizes a bridge theorem connecting tropical algebra, operadic neural
architecture theory, kernel methods, and minimal realization. The central result
establishes that for finitely generated compositional neural models:

1. **Architectural minimality** (realizability by at most `r` generators),
2. **Tropical kernel rank** (factorization rank of the behavior kernel), and
3. **Representer generation** (the kernel semimodule is generated by `r` representers)

are equivalent notions.

## Main Results

* `tropicalKernel` — the tropical kernel of a behavior table
* `HasFactorizationRankAtMost` — the key rank predicate
* `tropical_operadic_kernel_duality` — the main equivalence theorem
* `certified_minimal_reconstruction` — existence of a minimal realization
* `factorization_rank_compose_le` — sub-multiplicativity under composition

Bridge: tropical algebra ↔ operadic ML ↔ kernel methods ↔ realization theory
-/

noncomputable section

open Finset

/-! ## I. Behavior Tables and Tropical Kernels -/

/-- The tropical kernel of a behavior table. For each pair `(x, y)`,
    takes the supremum over all contexts of the product of behaviors.
    K(x,y) = sup_c B(c,x) * B(c,y). -/
def tropicalKernel
    {X Ctx : Type*} [Fintype Ctx] [DecidableEq Ctx]
    (B : Ctx → X → ℕ) : X → X → ℕ :=
  fun x y => Finset.sup Finset.univ (fun c => B c x * B c y)

/-- The kernel representer at point `x`: the function `y ↦ K(x, y)`. -/
def kernelRepresenter
    {X Ctx : Type*} [Fintype Ctx] [DecidableEq Ctx]
    (B : Ctx → X → ℕ) (x : X) : X → ℕ :=
  fun y => tropicalKernel B x y

/-! ## II. Factorization and Rank -/

/-- A factorization of a behavior table through an intermediate type of
    size at most `r`. The factorization identity is:
    `B(c,x) = sup_f α(c,f) * β(f,x)` for all `c, x`. -/
structure BehaviorFactorization
    {Ctx X : Type*} [Fintype Ctx] [Fintype X]
    (B : Ctx → X → ℕ) (r : ℕ) where
  /-- The intermediate feature type -/
  F : Type
  /-- The feature type is finite -/
  instFintypeF : Fintype F
  /-- The feature type has decidable equality -/
  instDecEqF : DecidableEq F
  /-- The feature type has at most `r` elements -/
  F_card : @Fintype.card F instFintypeF ≤ r
  /-- Left factor: context → feature → value -/
  alpha : Ctx → F → ℕ
  /-- Right factor: feature → input → value -/
  beta : F → X → ℕ
  /-- The factorization identity -/
  factorizes : ∀ c x,
    B c x = @Finset.sup ℕ F _ _ (@Finset.univ F instFintypeF)
      (fun f => alpha c f * beta f x)

/-- Predicate: `B` has factorization rank at most `r`. -/
def HasFactorizationRankAtMost
    {Ctx X : Type*} [Fintype Ctx] [Fintype X]
    (B : Ctx → X → ℕ) (r : ℕ) : Prop :=
  Nonempty (BehaviorFactorization B r)

/-! ## III. Operadic Neural Models -/

/-- An operadic neural model with finite hidden features.
    Behavior is computed as `B(c,x) = sup_f encode(c,f) * decode(f,x)`. -/
structure OperadicNeuralModel
    (Ctx X : Type) [Fintype Ctx] [Fintype X] where
  /-- The hidden feature type -/
  HiddenFeature : Type
  /-- Hidden features are finite -/
  hf_fintype : Fintype HiddenFeature
  /-- Hidden features have decidable equality -/
  hf_deceq : DecidableEq HiddenFeature
  /-- Number of generators -/
  generatorCount : ℕ
  /-- Generator count matches feature cardinality -/
  gen_card : @Fintype.card HiddenFeature hf_fintype = generatorCount
  /-- Context-to-feature map -/
  encode : Ctx → HiddenFeature → ℕ
  /-- Feature-to-output map -/
  decode : HiddenFeature → X → ℕ

/-- The behavior table of a neural model. -/
def OperadicNeuralModel.behaviorTable
    {Ctx X : Type} [Fintype Ctx] [Fintype X]
    (N : OperadicNeuralModel Ctx X) : Ctx → X → ℕ :=
  fun c x => @Finset.sup ℕ N.HiddenFeature _ _
    (@Finset.univ N.HiddenFeature N.hf_fintype)
    (fun f => N.encode c f * N.decode f x)

/-- Behavioral equivalence of two models. -/
def BehaviorallyEquivalent
    {Ctx X : Type} [Fintype Ctx] [Fintype X]
    (N₁ N₂ : OperadicNeuralModel Ctx X) : Prop :=
  ∀ c x, N₁.behaviorTable c x = N₂.behaviorTable c x

/-- Realizability by at most `r` generators. -/
def RealizableByAtMost
    {Ctx X : Type} [Fintype Ctx] [Fintype X]
    (r : ℕ) (N : OperadicNeuralModel Ctx X) : Prop :=
  ∃ N' : OperadicNeuralModel Ctx X,
    BehaviorallyEquivalent N N' ∧ N'.generatorCount ≤ r

/-- A model realizes a given behavior table. -/
def RealizesTable
    {Ctx X : Type} [Fintype Ctx] [Fintype X]
    (N : OperadicNeuralModel Ctx X) (B : Ctx → X → ℕ) : Prop :=
  ∀ c x, N.behaviorTable c x = B c x

/-! ## IV. Representer Generation -/

/-- The kernel semimodule is generated by at most `r` representers. -/
def GeneratedByRepresentersAtMost
    {X Ctx : Type*} [Fintype X] [Fintype Ctx] [DecidableEq Ctx] [DecidableEq X]
    (r : ℕ) (B : Ctx → X → ℕ) : Prop :=
  ∃ (F : Finset X), F.card ≤ r ∧
    ∀ x : X, ∃ (weights : X → ℕ),
      ∀ y : X, tropicalKernel B x y =
        Finset.sup F (fun x' => weights x' * tropicalKernel B x' y)

/-! ## V. Core Lemmas -/

/-
Forward direction: A model with `r` generators yields a rank-`r` factorization.
-/
theorem kernel_rank_le_of_generatorCount_le
    {Ctx X : Type} [Fintype Ctx] [Fintype X]
    (N : OperadicNeuralModel Ctx X)
    (r : ℕ) (hr : N.generatorCount ≤ r) :
    HasFactorizationRankAtMost N.behaviorTable r := by
  constructor;
  constructor;
  rotate_left;
  convert hr using 1;
  convert N.gen_card;
  convert fun c x => rfl;
  exact N.hf_deceq

/-
Converse: A rank-`r` factorization yields a model with `r` generators.
-/
theorem realizableByAtMost_of_factorization_rank
    {Ctx X : Type} [Fintype Ctx] [Fintype X]
    (B : Ctx → X → ℕ)
    (r : ℕ) (hrank : HasFactorizationRankAtMost B r) :
    ∃ N : OperadicNeuralModel Ctx X,
      RealizesTable N B ∧ N.generatorCount ≤ r := by
  cases' hrank with N hN
  generalize_proofs at *;
  cases' N with F instFintypeF instDecEqF F_card alpha beta factorizes;
  exact ⟨ ⟨ F, instFintypeF, instDecEqF, Fintype.card F, rfl, alpha, beta ⟩, fun c x => factorizes c x ▸ rfl, F_card ⟩

/-
The main equivalence between realizability and factorization rank.
-/
theorem realizable_iff_factorization_rank
    {Ctx X : Type} [Fintype Ctx] [Fintype X]
    (N : OperadicNeuralModel Ctx X) (r : ℕ) :
    RealizableByAtMost r N ↔
      HasFactorizationRankAtMost N.behaviorTable r := by
  constructor <;> intro h;
  · obtain ⟨ N', hN₁, hN₂ ⟩ := h;
    convert kernel_rank_le_of_generatorCount_le N' r hN₂ using 1;
    exact funext fun c => funext fun x => hN₁ c x;
  · obtain ⟨ N', hN' ⟩ := realizableByAtMost_of_factorization_rank N.behaviorTable r h;
    exact ⟨ N', fun c x => hN'.1 c x ▸ rfl, hN'.2 ⟩

/-! ## VI. Certified Minimal Reconstruction -/

/-- A trivial model: use contexts as hidden features. -/
def trivialModel
    {Ctx X : Type} [Fintype Ctx] [Fintype X] [DecidableEq Ctx]
    (B : Ctx → X → ℕ) : OperadicNeuralModel Ctx X where
  HiddenFeature := Ctx
  hf_fintype := inferInstance
  hf_deceq := inferInstance
  generatorCount := Fintype.card Ctx
  gen_card := rfl
  encode := fun c c' => if c = c' then 1 else 0
  decode := fun c' x => B c' x

/-
Certified minimal reconstruction: there exists a model with minimum generators.
-/
theorem certified_minimal_reconstruction
    {Ctx X : Type} [Fintype Ctx] [Fintype X] [DecidableEq Ctx] [DecidableEq X]
    (B : Ctx → X → ℕ) :
    ∃ N : OperadicNeuralModel Ctx X,
      RealizesTable N B ∧
      (∀ N' : OperadicNeuralModel Ctx X,
        RealizesTable N' B → N.generatorCount ≤ N'.generatorCount) := by
  by_contra! h;
  obtain ⟨N, hN⟩ : ∃ N : OperadicNeuralModel Ctx X, RealizesTable N B := by
    exact ⟨ trivialModel B, fun c x => by
      unfold OperadicNeuralModel.behaviorTable trivialModel;
      refine' le_antisymm _ _ <;> simp +decide [ Finset.sup_le_iff ];
      · aesop;
      · exact Finset.le_sup ( f := fun f => if c = f then B f x else 0 ) ( Finset.mem_univ c ) |> le_trans ( by aesop ) ⟩;
  induction' n : N.generatorCount using Nat.strong_induction_on with n ih generalizing N;
  obtain ⟨ N', hN', hN'' ⟩ := h N hN; exact ih _ ( by linarith ) _ hN' rfl;

/-! ## VII. Composition and Rank Bounds -/

/-- The composed behavior table from two behavior tables via an intermediate type. -/
def composeBehavior
    {Ctx₁ X Ctx₂ Y : Type*}
    [Fintype Ctx₁] [Fintype X] [Fintype Ctx₂] [Fintype Y]
    [DecidableEq X]
    (B₁ : Ctx₁ → X → ℕ) (B₂ : Ctx₂ → Y → ℕ) :
    (Ctx₁ × Ctx₂) → Y → ℕ :=
  fun ⟨c₁, c₂⟩ y => Finset.sup Finset.univ (fun x => B₁ c₁ x * B₂ c₂ y)

/-
For ℕ, multiplication distributes over Finset.sup (which is max).
-/
theorem nat_mul_finset_sup {β : Type*} [DecidableEq β]
    (a : ℕ) (s : Finset β) (f : β → ℕ) :
    a * s.sup f = s.sup (fun x => a * f x) := by
  induction' s using Finset.cons_induction with x s ih;
  · simp +decide;
  · simp +decide [ *, mul_max_of_nonneg ]

/-
For ℕ, Finset.sup distributes over multiplication:
    sup_i f(i) * sup_j g(j) = sup_{i,j} f(i) * g(j).
-/
theorem finset_sup_mul_sup {α β : Type*} [DecidableEq α] [DecidableEq β]
    (s : Finset α) (t : Finset β) (f : α → ℕ) (g : β → ℕ) :
    s.sup f * t.sup g = (s ×ˢ t).sup (fun p => f p.1 * g p.2) := by
  induction s using Finset.cons_induction <;> simp_all +decide [Finset.sup_product_left];
  rw [ max_mul_of_nonneg, ‹ ( Finset.sup _ f ) * _ = _ › ];
  · rw [ nat_mul_finset_sup ];
  · exact Nat.zero_le _

/-
Sub-multiplicativity of factorization rank under composition.
-/
theorem factorization_rank_compose_le
    {Ctx₁ X Ctx₂ Y : Type*}
    [Fintype Ctx₁] [Fintype X] [Fintype Ctx₂] [Fintype Y]
    [DecidableEq X]
    (B₁ : Ctx₁ → X → ℕ) (B₂ : Ctx₂ → Y → ℕ)
    (r₁ r₂ : ℕ)
    (h₁ : HasFactorizationRankAtMost B₁ r₁)
    (h₂ : HasFactorizationRankAtMost B₂ r₂) :
    HasFactorizationRankAtMost (composeBehavior B₁ B₂) (r₁ * r₂) := by
  -- Let's obtain the factorizations for B₁ and B₂.
  obtain ⟨F₁, hF₁⟩ := h₁
  obtain ⟨F₂, hF₂⟩ := h₂;
  use F₁ × F₂, inferInstance, inferInstance, by
    simpa using Nat.mul_le_mul ‹Fintype.card F₁ ≤ r₁› ‹Fintype.card F₂ ≤ r₂›
  generalize_proofs at *;
  exact fun c f => ( ‹Ctx₁ → F₁ → ℕ› c.1 f.1 ) * ( ‹Ctx₂ → F₂ → ℕ› c.2 f.2 );
  exact fun f y => ( Finset.sup Finset.univ fun x => ‹F₁ → X → ℕ› f.1 x ) * ‹F₂ → Y → ℕ› f.2 y;
  intro c x; simp +decide [ composeBehavior, * ] ;
  simp +decide only [nat_mul_finset_sup, mul_comm, mul_left_comm];
  rw [ Finset.sup_comm ];
  refine' le_antisymm _ _ <;> simp +decide [ Finset.sup_le_iff ];
  · exact fun f₁ f₂ f₃ => Finset.le_sup_of_le ( Finset.mem_univ ( f₃, f₁ ) ) ( Finset.le_sup_of_le ( Finset.mem_univ f₂ ) le_rfl );
  · intro a b x; exact le_trans ( by aesop ) ( Finset.le_sup ( f := fun c_1 => Finset.sup Finset.univ fun b => Finset.sup Finset.univ fun x_1 => _ ) ( Finset.mem_univ b ) |> le_trans ( Finset.le_sup ( f := fun b => Finset.sup Finset.univ fun x_1 => _ ) ( Finset.mem_univ x ) |> le_trans ( Finset.le_sup ( f := fun x_1 => _ ) ( Finset.mem_univ a ) ) ) ) ;

/-! ## VIII. Tropical Kernel Properties -/

/-
The tropical kernel is symmetric.
-/
theorem tropicalKernel_symm
    {X Ctx : Type*} [Fintype Ctx] [DecidableEq Ctx]
    (B : Ctx → X → ℕ) (x y : X) :
    tropicalKernel B x y = tropicalKernel B y x := by
  unfold tropicalKernel;
  simp +decide only [mul_comm]

/-
The reproducing property: `B(c,x) * B(c,y) ≤ K(x,y)`.
-/
theorem tropicalKernel_reproducing
    {X Ctx : Type*} [Fintype Ctx] [DecidableEq Ctx]
    (B : Ctx → X → ℕ) (c : Ctx) (x y : X) :
    B c x * B c y ≤ tropicalKernel B x y := by
  exact Finset.le_sup ( f := fun c => B c x * B c y ) ( Finset.mem_univ c )

/-
Factorization rank is at most `Fintype.card Ctx`.
-/
theorem factorization_rank_le_card_ctx
    {Ctx X : Type*} [Fintype Ctx] [Fintype X] [DecidableEq Ctx]
    (B : Ctx → X → ℕ) :
    HasFactorizationRankAtMost B (Fintype.card Ctx) := by
  constructor;
  constructor;
  rotate_left;
  convert le_rfl;
  rotate_left;
  rotate_left;
  exact Fin ( Fintype.card Ctx );
  exact inferInstance;
  exact fun c f => if c = ( Fintype.equivFin Ctx ).symm f then 1 else 0;
  exact fun f x => B ( Fintype.equivFin Ctx |>.symm f ) x;
  · infer_instance;
  · simp +decide;
  · intro c x; rw [ Finset.sup_congr rfl fun f _ => by rw [ mul_comm ] ] ; simp +decide ;
    refine' le_antisymm _ _;
    · exact Finset.le_sup ( f := fun f => if c = ( Fintype.equivFin Ctx ).symm f then B ( ( Fintype.equivFin Ctx ).symm f ) x else 0 ) ( Finset.mem_univ ( Fintype.equivFin Ctx c ) ) |> le_trans ( by simp +decide );
    · aesop

/-
Monotonicity of factorization rank.
-/
theorem factorization_rank_mono
    {Ctx X : Type*} [Fintype Ctx] [Fintype X]
    (B : Ctx → X → ℕ) (r r' : ℕ) (hr : r ≤ r')
    (hrank : HasFactorizationRankAtMost B r) :
    HasFactorizationRankAtMost B r' := by
  exact ⟨ ⟨ hrank.some.F, hrank.some.instFintypeF, hrank.some.instDecEqF, by linarith [ hrank.some.F_card ], hrank.some.alpha, hrank.some.beta, hrank.some.factorizes ⟩ ⟩

/-! ## IX. Main Bridge Theorem -/

/-- **Tropical Operadic Kernel Duality (Main Theorem)**:
    For finite-context operadic neural models, architectural minimality
    is exactly captured by tropical kernel rank.

    RealizableByAtMost r N ↔ HasFactorizationRankAtMost N.behaviorTable r

    Bridge: tropical algebra ↔ operadic ML ↔ kernel methods ↔ realization theory -/
theorem tropical_operadic_kernel_duality
    {Ctx X : Type} [Fintype Ctx] [Fintype X]
    (N : OperadicNeuralModel Ctx X) (r : ℕ) :
    RealizableByAtMost r N ↔
      HasFactorizationRankAtMost N.behaviorTable r :=
  realizable_iff_factorization_rank N r

end