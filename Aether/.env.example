# Aether environment variables. Copy to .env and fill in your keys.

# Required: Aristotle (Harmonic) API key — used to dispatch/research jobs.
ARISTOTLE_API_KEY=your_aristotle_api_key

# LLM tiers for Pi-Agent (concept generation + evaluation).
# The fallback chain is Ollama Cloud -> OpenRouter; enable at least one.

# Optional: Anthropic fallback (not used by the default tier chain).
# ANTHROPIC_API_KEY=your_anthropic_api_key
# ANTHROPIC_AUTH_TOKEN=your_anthropic_auth_token
