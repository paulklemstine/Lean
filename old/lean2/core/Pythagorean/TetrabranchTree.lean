import Mathlib

/-!
# The Tetrabranch Pythagorean Spacetime Tree

## Core Hypothesis

The classical Berggren tree has 3 branches at each node, generated by three matrices
M₁, M₂, M₃ ∈ SL(3,ℤ) that preserve the quadratic form a² + b² - c² = 0 (the light cone
in (2+1)D Minkowski space). The user's key insight:

> "The Pythagorean triplet tree is actually branched 3 in space, -1 in time."

This suggests the tree should be extended to **4 branches** — three spatial branches
(the classical Berggren matrices) plus one **temporal/photonic branch** M₄ that
acts as an "inverse" or "time-reversal" operation.

## The 4th Branch: Parent Descent

The classical Berggren tree has three children but also a unique **parent** for each
non-root triple. The parent map P is the inverse of one of {M₁, M₂, M₃}. This parent
map is the natural candidate for the 4th branch: it moves "backward in time" through
the tree, while the three children move "forward."

Reinterpreted in spacetime:
- **3 spatial branches** (M₁, M₂, M₃): children, future-directed, increasing hypotenuse
- **1 temporal branch** (P = parent): past-directed, decreasing hypotenuse

A photon's worldline — traveling at speed c along the light cone — is precisely a path
that stays on the null surface a² + b² = c². The 4th branch encodes the photon's
"origin": tracing back from any triple to the root (3,4,5) is the photon's history.

## Main Results

- `TetraPath`: 4-branch tree paths (3 forward + 1 backward)
- `berggrenParent`: The parent/time-reversal operation (M₂⁻¹)
- `parent_preserves_null`: Parent map preserves a² + b² = c²
- `parent_inverse_M₂`: Parent ∘ M₂ = identity
- `tetrabranch_on_light_cone`: Every node in the 4-branch tree is on the light cone
- `all_branches_preserve_minkowski`: All 4 branches are discrete Lorentz transformations
-/

open Finset BigOperators

/-! ## Part I: The Minkowski Form and Berggren Matrices -/

/-- The Minkowski form Q(v) = v₀² + v₁² - v₂². Light cone: Q = 0. -/
def minkowskiQ (v : Fin 3 → ℤ) : ℤ := v 0 ^ 2 + v 1 ^ 2 - v 2 ^ 2

/-- A vector is on the light cone (null/photonic). -/
def isNull (v : Fin 3 → ℤ) : Prop := minkowskiQ v = 0

/-- Berggren M₁ as a function on ℤ³. -/
def berggrenM₁ (v : Fin 3 → ℤ) : Fin 3 → ℤ := fun i =>
  match i with
  | 0 => v 0 - 2 * v 1 + 2 * v 2
  | 1 => 2 * v 0 - v 1 + 2 * v 2
  | 2 => 2 * v 0 - 2 * v 1 + 3 * v 2

/-- Berggren M₂ as a function on ℤ³. -/
def berggrenM₂ (v : Fin 3 → ℤ) : Fin 3 → ℤ := fun i =>
  match i with
  | 0 => v 0 + 2 * v 1 + 2 * v 2
  | 1 => 2 * v 0 + v 1 + 2 * v 2
  | 2 => 2 * v 0 + 2 * v 1 + 3 * v 2

/-- Berggren M₃ as a function on ℤ³. -/
def berggrenM₃ (v : Fin 3 → ℤ) : Fin 3 → ℤ := fun i =>
  match i with
  | 0 => -v 0 + 2 * v 1 + 2 * v 2
  | 1 => -2 * v 0 + v 1 + 2 * v 2
  | 2 => -2 * v 0 + 2 * v 1 + 3 * v 2

/-! ## Part II: The 4th Branch — The Parent (Time-Reversal) Map -/

/-- The parent/time-reversal map M₂⁻¹. This undoes the M₂ transformation,
    moving "backward in time" through the Pythagorean tree.
    M₂⁻¹(a,b,c) = (a + 2b - 2c, 2a + b - 2c, -2a - 2b + 3c) -/
def berggrenParent (v : Fin 3 → ℤ) : Fin 3 → ℤ := fun i =>
  match i with
  | 0 => v 0 + 2 * v 1 - 2 * v 2
  | 1 => 2 * v 0 + v 1 - 2 * v 2
  | 2 => -2 * v 0 - 2 * v 1 + 3 * v 2

/-! ## Part III: All Four Branches Preserve the Minkowski Form -/

/-- M₁ preserves the light cone. -/
theorem M₁_preserves_null (v : Fin 3 → ℤ) (h : isNull v) :
    isNull (berggrenM₁ v) := by
  simp only [isNull, minkowskiQ, berggrenM₁] at h ⊢; nlinarith

/-- M₂ preserves the light cone. -/
theorem M₂_preserves_null (v : Fin 3 → ℤ) (h : isNull v) :
    isNull (berggrenM₂ v) := by
  simp only [isNull, minkowskiQ, berggrenM₂] at h ⊢; nlinarith

/-- M₃ preserves the light cone. -/
theorem M₃_preserves_null (v : Fin 3 → ℤ) (h : isNull v) :
    isNull (berggrenM₃ v) := by
  simp only [isNull, minkowskiQ, berggrenM₃] at h ⊢; nlinarith

/-- **The 4th branch preserves the light cone.** The parent/time-reversal map
    keeps vectors on the null surface. A photon traced backward is still a photon. -/
theorem parent_preserves_null (v : Fin 3 → ℤ) (h : isNull v) :
    isNull (berggrenParent v) := by
  simp only [isNull, minkowskiQ, berggrenParent] at h ⊢; nlinarith

/-- All four branch operations preserve the full Minkowski form (not just the null set).
    They are all discrete Lorentz transformations in O(2,1;ℤ). -/
theorem all_branches_preserve_minkowski (v : Fin 3 → ℤ) :
    minkowskiQ (berggrenM₁ v) = minkowskiQ v ∧
    minkowskiQ (berggrenM₂ v) = minkowskiQ v ∧
    minkowskiQ (berggrenM₃ v) = minkowskiQ v ∧
    minkowskiQ (berggrenParent v) = minkowskiQ v := by
  refine ⟨?_, ?_, ?_, ?_⟩ <;>
    simp [minkowskiQ, berggrenM₁, berggrenM₂, berggrenM₃, berggrenParent] <;> ring

/-! ## Part IV: Parent-Child Inverse Relationship -/

/-- The parent map is the inverse of M₂: M₂⁻¹ ∘ M₂ = id.
    "The 4th branch reverses the 2nd branch." -/
theorem parent_inverse_M₂ (v : Fin 3 → ℤ) :
    berggrenParent (berggrenM₂ v) = v := by
  ext i; fin_cases i <;> simp [berggrenParent, berggrenM₂] <;> ring

/-- Conversely, M₂ ∘ M₂⁻¹ = id. -/
theorem M₂_inverse_parent (v : Fin 3 → ℤ) :
    berggrenM₂ (berggrenParent v) = v := by
  ext i; fin_cases i <;> simp [berggrenParent, berggrenM₂] <;> ring

/-! ## Part V: The Tetrabranch Tree -/

/-- A path in the 4-branch (tetrabranch) Pythagorean spacetime tree.
    Three branches go forward in "time" (increasing hypotenuse),
    one branch goes backward (decreasing hypotenuse). -/
inductive TetraPath where
  | root : TetraPath
  | spatial₁ : TetraPath → TetraPath   -- M₁: forward spatial branch 1
  | spatial₂ : TetraPath → TetraPath   -- M₂: forward spatial branch 2
  | spatial₃ : TetraPath → TetraPath   -- M₃: forward spatial branch 3
  | temporal : TetraPath → TetraPath   -- M₂⁻¹: backward temporal branch
  deriving Repr

/-- Evaluate a tetrabranch path to get the ℤ³ vector. -/
def tetraEval : TetraPath → (Fin 3 → ℤ)
  | .root      => ![3, 4, 5]
  | .spatial₁ p => berggrenM₁ (tetraEval p)
  | .spatial₂ p => berggrenM₂ (tetraEval p)
  | .spatial₃ p => berggrenM₃ (tetraEval p)
  | .temporal p => berggrenParent (tetraEval p)

/-- The root triple (3,4,5) is on the light cone. -/
theorem root_is_null : isNull ![3, 4, 5] := by
  simp [isNull, minkowskiQ]

/-- **Main theorem**: Every node in the tetrabranch tree lies on the light cone.
    The spacetime tree lives entirely on the null surface — every node is a photon state. -/
theorem tetrabranch_on_light_cone (p : TetraPath) : isNull (tetraEval p) := by
  induction p with
  | root => exact root_is_null
  | spatial₁ p ih => exact M₁_preserves_null _ ih
  | spatial₂ p ih => exact M₂_preserves_null _ ih
  | spatial₃ p ih => exact M₃_preserves_null _ ih
  | temporal p ih => exact parent_preserves_null _ ih

/-! ## Part VI: Spacetime Signature (3,1) -/

/-- The M₂ spatial branch increases the hypotenuse (energy grows forward in time). -/
theorem spatial_branch_increases_hypotenuse (v : Fin 3 → ℤ)
    (ha : 0 < v 0) (hb : 0 < v 1) (hc : 0 < v 2) :
    v 2 < (berggrenM₂ v) 2 := by
  simp [berggrenM₂]; linarith

/-- The spacetime interval along any path is zero (photon condition).
    Discrete version of ds² = 0 for light. -/
theorem photon_interval_zero (p : TetraPath) :
    (tetraEval p) 0 ^ 2 + (tetraEval p) 1 ^ 2 - (tetraEval p) 2 ^ 2 = 0 := by
  have h := tetrabranch_on_light_cone p
  simp [isNull, minkowskiQ] at h; linarith

/-! ## Part VII: Photon Worldline Interpretation

A **photon worldline** in this framework is a path through the tetrabranch tree.

- Starting at the root (3,4,5) — the "photon is emitted"
- Moving through spatial branches — the photon propagates through space
- The temporal branch — the photon's creation or annihilation event

The key identity: `spatial₂ ∘ temporal = id` and `temporal ∘ spatial₂ = id`
means that a photon emitted (temporal) and then propagated (spatial₂) returns
to its origin — conservation of the null condition.

Every path in the tree represents a sequence of discrete Lorentz boosts applied
to the fundamental photon state (3,4,5). The tree *is* the discrete symmetry
group of photon states.
-/

/-! ## Part VIII: Computational Experiments -/

-- The root triple
#eval tetraEval .root  -- [3, 4, 5]

-- Three spatial children
#eval tetraEval (.spatial₁ .root)  -- [5, 12, 13]
#eval tetraEval (.spatial₂ .root)  -- [21, 20, 29]
#eval tetraEval (.spatial₃ .root)  -- [15, 8, 17]

-- The temporal (parent) branch from root
#eval tetraEval (.temporal .root)  -- M₂⁻¹ applied to (3,4,5) = (1, 0, 1)

-- Round-trip: spatial₂ then temporal = identity
#eval tetraEval (.temporal (.spatial₂ .root))  -- [3, 4, 5] ✓

-- Going temporal then spatial₂ = identity
#eval tetraEval (.spatial₂ (.temporal .root))  -- [3, 4, 5] ✓

-- Deep exploration: spatial₁ → spatial₂ → temporal → spatial₃
#eval tetraEval (.spatial₃ (.temporal (.spatial₂ (.spatial₁ .root))))
