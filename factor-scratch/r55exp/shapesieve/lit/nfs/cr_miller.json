02:06Z","timestamp":1748232126064,"version":"3.41.0"},"posted":{"date-parts":[[2025,5,25]]},"group-title":"Mathematics","reference-count":0,"publisher":"Cambridge University Press (CUP)","license":[{"start":{"date-parts":[[2025,5,25]],"date-time":"2025-05-25T00:00:00Z","timestamp":1748131200000},"content-version":"unspecified","delay-in-days":0,"URL":"https:\/\/www.cambridge.org\/engage\/coe\/legal-information?show=terms-of-use"}],"content-domain":{"domain":[],"crossmark-restriction":false},"accepted":{"date-parts":[[2025,5,17]]},"abstract":"<jats:p>We introduce the AION framework (Abdeslam Irreducible Order of Naturals), a symbolic and deterministic system that generates the set of natural numbers from unity using only addition and multiplication. Multiplication is strictly prioritized; addition is applied only when symbolic multiplication fails. This principle reformulates primality as symbolic irreducibility, defined precisely by the ASIT theorem. The AION framework uncovers the structural origin of prime gaps, provides a deterministic ancestry for each number, and offers a symbolic resolution of the Riemann Hypothesis.<\/jats:p>","DOI":"10.33774\/coe-2025-nnqd0","type":"posted-content","created":{"date-parts":[[2025,5,25]],"date-time":"2025-05-25T12:15:09Z","timestamp":1748175309000},"source":"Crossref","is-referenced-by-count":0,"title":["AION: The Abdeslam Irreducible Order of Naturals Symbolic Primality, Structural Prime Gaps, and a Resolution to the Riemann Hypothesis"],"prefix":"10.33774","author":[{"ORCID":"https:\/\/orcid.org\/0009-0006-1461-1912","authenticated-orcid":false,"given":"Abdeslam","family":"Aabidi El Moussati","sequence":"first","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]}],"member":"56","link":[{"URL":"https:\/\/www.cambridge.org\/engage\/api-gateway\/coe\/assets\/orp\/resource\/item\/6827e957e561f77ed4486af3\/original\/aion-the-abdeslam-irreducible-order-of-naturals-symbolic-primality-structural-prime-gaps-and-a-reso