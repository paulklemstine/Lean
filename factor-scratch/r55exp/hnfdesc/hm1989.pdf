    <script>
        var accordionElement = document.getElementById("productDetailAbstractAccordionContent");

        if (accordionElement != null)
        {
            var issueId = 729;
            var articleId = 17770;
            var absNum = "";
            // Listen for any accordion item opening inside this container
            accordionElement.addEventListener("show.bs.collapse", function (event)
            {
                console.log('in here 2');
                // The specific panel being expanded
                const expandedPanel = event.target;

                var currSubjectCode = expandedPanel.getAttribute("data-ams-subjectcode");
                var contentTarget = expandedPanel.querySelector(".productDetailAbstractSubjectContent");

                console.log('data-ams-subjectcode', currSubjectCode);

                if (contentTarget.innerHTML.trim() == "")
                {
                    var postData = { productCode: productDetailObj.ProductCode, issueId: issueId, retrieveAbstracts: productDetailObj.IsRetrieveAbstracts, articleId: articleId, abstractSubjectCode: currSubjectCode }

                    var onSuccess = function (response)
                    {
                        if (response != null && response.length > 0)
                        {
                            var abstractIssue = response.find(obj => { return obj.IssueId == issueId });
                            if (abstractIssue != null && abstractIssue.Articles != null && abstractIssue.Articles.length > 0)
                            {
                                var abstractArticle = abstractIssue.Articles.find(obj => { return obj.ArticleId == articleId });

                                var subjectCodeHtml = "";
                                $.each(abstractArticle.Abstracts, function (abstractIndex, abstractItem)
                                {
                                    subjectCodeHtml += "<div class='productDetailAbstractContent' data-abs-num='" + abstractItem.AbstractNumber + "'>";
                                    subjectCodeHtml += "<div class='productDetailAbstractNumber'>" + abstractItem.AbstractNumber + "</div>";
                                    subjectCodeHtml += "<div class='productDetailAbstractAuthor'>" + abstractItem.AuthorText + "</div>";
                                    subjectCodeHtml += "<div class='productDetailAbstractTitle'>" + abstractItem.Title;
                                    if (abstractItem.PreliminaryFlag != null && abstractItem.PreliminaryFlag == "Y")
                                    {
                                        subjectCodeHtml += "<span class='productDetailAbstractTitlePreliminaryFlag'>(Preliminary report)</span>";
                                    }
                                    subjectCodeHtml += "</div>";
                                    subjectCodeHtml += "<div class='productDetailAbstractText'>" + abstractItem.TextHtml + "</div>";
                                    if (abstractItem.ReceivedDateFormatted != "")
                                    {
                                        subjectCodeHtml += "<div class='productDetailAbstractDate'>(Received " + abstractItem.ReceivedDateFormatted + ")" + "</div>";
                                    }
                                    subjectCodeHtml += "</div>";
                                });

                                //$(currDiv.find(".productDetailAbstractSubjectContent")[0]).html(subjectCodeHtml);
                                contentTarget.innerHTML = subjectCodeHtml;

                                processMathJax();

                                if (absNum != null && absNum != "" && $("#abstractSubjectContent" + currSubjectCode).find(".productDetailAbstractContent[data-abs-num='" + absNum + "'").length > 0)
                                {
                                     $("html, body").animate({ scrollTop: $(".productDetailAbstractContent[data-abs-num='" + absNum + "'").offset().top - $("#header-wrapper").height() - $("#abstractAccordionHeader" + currSubjectCode).height() }, 50);
                                }
                            }
                        }
                        $("#loadingPanelAbstract" + currSubjectCode).addClass("hidden");
                    };

                    var onError = function (jqXHR, textStatus, errorThrown)
                    {
                        console.log('error getting abstract for subject code' + currSubjectCode);
                        console.log(jqXHR);
                        console.log(textStatus);
                        console.log(errorThrown);
                        $("#loadingPanelAbstract" + currSubjectCode).addClass("hidden");
                    };

                    getIssueDetail(postData, onSuccess, onError);
                }
                else
                    $("#loadingPanelAbstract" + currSubjectCode).addClass("hidden");

                $(window).scroll(function ()
                {
                    if($("#abstractAccordionHeader" + currSubjectCode).length > 0)
                    {
                        var currPosition = $("#abstractAccordionHeader" + currSubjectCode).offset().top - $("#header-wrapper").height();
                        if (window.scrollY > currPosition)
                        {
                            $("#scroll" + currSubjectCode).addClass("active");
                        } else
                        {
                            $("#scroll" + currSubjectCode).removeClass("active");
                        }
                    }
                });

                $("#scroll" + currSubjectCode).click(function ()
                {
                    $("html, body").animate({ scrollTop: $("#abstractAccordionHeader" + currSubjectCode).offset().top - $("#header-wrapper").height() - $("#abstractAccordionHeader" + currSubjectCode).height() }, 50);
                    return false;
                });
            });

            // handle passed absNum param, open section and scroll to top
            if (absNum != null && absNum != "")
            {
                //console.log(absNum);
                var serializedArticle = {"ArticleId":17770,"JournalProductCode":"JAMS","IssueId":729,"ManuscriptId":1002631,"DocumentType":"ARTICLE","Title":"A rigorous subexponential algorithm for computation of class groups","DOI":"10.1090/S0894-0347-1989-1002631-0","PII":"S0894-0347-1989-1002631-0","Issue":null,"IssueDirectory":"1989-02-04","StartPage":837,"EndPage":850,"PostDate":null,"PrimaryMsc":"11Y40","SecondaryMsc":"11R29","MscSchema":null,"Abstract":"Let $C( - d)$ denote the Gauss Class Group of quadratic forms of a negative discriminant $- d$ (or equivalently, the class group of the imaginary quadratic field $Q(\\sqrt { - d} )$). We give a rigorous proof that there exists a Las Vegas algorithm that will compute the structure of $C( - d)$ with an expected running time of $L{(d)^{\\sqrt 2 \u002B o(1)}}$ bit operations, where $L(d) = {\\text {exp}}(\\sqrt {\\log d\\;\\log \\log d} )$. Thus, of course, also includes the computation of the class number $h( - d)$, the cardinality of $C( - d)$.","EnhancedReferences":"\u003Cul\u003E\u003Cli\u003E\u003Ca href=\u0022https://mathscinet.ams.org/mathscinet/search/authors.html?authorName=Coppersmith%2C%20Don\u0022\u003EDon Coppersmith\u003C/a\u003E and \u003Ca href=\u0022https://mathscinet.ams.org/mathscinet/search/authors.html?authorName=Winograd%2C%20Shmuel\u0022\u003EShmuel Winograd\u003C/a\u003E, \u003Cem\u003EMatrix multiplication via arithmetic progressions\u003C/em\u003E, J. Symbolic Comput. \u003Cstrong\u003E9\u003C/strong\u003E (1990), no.\u00A03, 251\u2013280.  \u003Ca href=\u0022https://mathscinet.ams.org/mathscinet-getitem?mr=1056627\u0022\u003EMR \u003Cstrong\u003E1056627\u003C/strong\u003E\u003C/a\u003E, DOI \u003Ca href=\u0022https://doi.org/10.1016/S0747-7171%2808%2980013-2\u0022\u003E10.1016/S0747-7171(08)80013-2\u003C/a\u003E\u003C/li\u003E\n\n\n\u003Cli\u003E\u003Ca href=\u0022https://mathscinet.ams.org/mathscinet/search/authors.html?authorName=Domich%2C%20P.%20D.\u0022\u003EP. D. Domich\u003C/a\u003