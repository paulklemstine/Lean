":"https://pubs.ams.org/jams","DirectFileUrl":"","Articles":[]},{"IssueId":730,"ProductCode":null,"Year":1990,"Volume":3,"IssueNumber":1,"IssueDirectory":"1990-03-01","FreeFlag":"Y","EndMatterUrl":"/1990-03-01/jams-3-1-print-matter.pdf","FileUrlHost":"https://www.ams.org/journals/jams","HomeUrlHost":"https://pubs.ams.org/jams","DirectFileUrl":"","Articles":[]},{"IssueId":731,"ProductCode":null,"Year":1990,"Volume":3,"IssueNumber":2,"IssueDirectory":"1990-03-02","FreeFlag":"Y","EndMatterUrl":"/1990-03-02/jams-3-2-print-matter.pdf","FileUrlHost":"https://www.ams.org/journals/jams","HomeUrlHost":"https://pubs.ams.org/jams","DirectFileUrl":"","Articles":[]},{"IssueId":732,"ProductCode":null,"Year":1990,"Volume":3,"IssueNumber":3,"IssueDirectory":"1990-03-03","FreeFlag":"Y","EndMatterUrl":"/1990-03-03/jams-3-3-print-matter.pdf","FileUrlHost":"https://www.ams.org/journals/jams","HomeUrlHost":"https://pubs.ams.org/jams","DirectFileUrl":"","Articles":[]},{"IssueId":733,"ProductCode":null,"Year":1990,"Volume":3,"IssueNumber":4,"IssueDirectory":"1990-03-04","FreeFlag":"Y","EndMatterUrl":"/1990-03-04/jams-3-4-print-matter.pdf","FileUrlHost":"https://www.ams.org/journals/jams","HomeUrlHost":"https://pubs.ams.org/jams","DirectFileUrl":"","Articles":[]},{"IssueId":726,"ProductCode":null,"Year":1989,"Volume":2,"IssueNumber":1,"IssueDirectory":"1989-02-01","FreeFlag":"Y","EndMatterUrl":"/1989-02-01/jams-2-1-print-matter.pdf","FileUrlHost":"https://www.ams.org/journals/jams","HomeUrlHost":"https://pubs.ams.org/jams","DirectFileUrl":"","Articles":[]},{"IssueId":727,"ProductCode":null,"Year":1989,"Volume":2,"IssueNumber":2,"IssueDirectory":"1989-02-02","FreeFlag":"Y","EndMatterUrl":"/1989-02-02/jams-2-2-print-matter.pdf","FileUrlHost":"https://www.ams.org/journals/jams","HomeUrlHost":"https://pubs.ams.org/jams","DirectFileUrl":"","Articles":[]},{"IssueId":728,"ProductCode":null,"Year":1989,"Volume":2,"IssueNumber":3,"IssueDirectory":"1989-02-03","FreeFlag":"Y","EndMatterUrl":"/1989-02-03/jams-2-3-print-matter.pdf","FileUrlHost":"https://www.ams.org/journals/jams","HomeUrlHost":"https://pubs.ams.org/jams","DirectFileUrl":"","Articles":[]},{"IssueId":729,"ProductCode":null,"Year":1989,"Volume":2,"IssueNumber":4,"IssueDirectory":"1989-02-04","FreeFlag":"Y","EndMatterUrl":"/1989-02-04/jams-2-4-print-matter.pdf","FileUrlHost":"https://www.ams.org/journals/jams","HomeUrlHost":"https://pubs.ams.org/jams","DirectFileUrl":"","Articles":[]},{"IssueId":722,"ProductCode":null,"Year":1988,"Volume":1,"IssueNumber":1,"IssueDirectory":"1988-01-01","FreeFlag":"Y","EndMatterUrl":"/1988-01-01/jams-1-1-print-matter.pdf","FileUrlHost":"https://www.ams.org/journals/jams","HomeUrlHost":"https://pubs.ams.org/jams","DirectFileUrl":"","Articles":[]},{"IssueId":723,"ProductCode":null,"Year":1988,"Volume":1,"IssueNumber":2,"IssueDirectory":"1988-01-02","FreeFlag":"Y","EndMatterUrl":"/1988-01-02/jams-1-2-print-matter.pdf","FileUrlHost":"https://www.ams.org/journals/jams","HomeUrlHost":"https://pubs.ams.org/jams","DirectFileUrl":"","Articles":[]},{"IssueId":724,"ProductCode":null,"Year":1988,"Volume":1,"IssueNumber":3,"IssueDirectory":"1988-01-03","FreeFlag":"Y","EndMatterUrl":"/1988-01-03/jams-1-3-print-matter.pdf","FileUrlHost":"https://www.ams.org/journals/jams","HomeUrlHost":"https://pubs.ams.org/jams","DirectFileUrl":"","Articles":[]},{"IssueId":725,"ProductCode":null,"Year":1988,"Volume":1,"IssueNumber":4,"IssueDirectory":"1988-01-04","FreeFlag":"Y","EndMatterUrl":"/1988-01-04/jams-1-4-print-matter.pdf","FileUrlHost":"https://www.ams.org/journals/jams","HomeUrlHost":"https://pubs.ams.org/jams","DirectFileUrl":"","Articles":[]}],"NonIssueArticles":[{"ArticleId":93444,"JournalProductCode":"JAMS","IssueId":null,"ManuscriptId":1082,"DocumentType":"ARTICLE","Title":"Special unipotent representations of real classical groups: construction and unitarity","DOI":"10.1090/jams/1082","PII":"S0894-0347-2026-01082-X","Issue":null,"IssueDirectory":"0000-000-00","StartPage":null,"EndPage":null,"PostDate":"2026-09-21T00:00:00","PrimaryMsc":"22E45, 22E46","SecondaryMsc":null,"MscSchema":"2020","Abstract":"Let $G$ be a real classical group (including the real metaplectic group). We consider a nilpotent adjoint orbit $\\check {\\mathcal O}$ of $\\check G$, the Langlands dual of $G$ (or the metaplectic Langlands dual of $G$ when $G$ is a real metaplectic group). We classify all special unipotent representations of $G$ attached to $\\check {\\mathcal O}$, in the sense of Arthur and Adams-Barbasch-Vogan. When $\\check {\\mathcal O}$ has good parity in the sense of M\u0026oelig;glin, we construct all such representations of $G$ via the method of theta lifting. As a consequence of the construction and the classification, we conclude that all special unipotent representations of $G$ are unitarizable, as predicted by the Arthur-ABV conjecture. We also determine the precise structure of the associated cycles of special unipotent representations of $G$. The paper is the second in a series of two papers on the classification of special unipotent representations of real classical groups.","EnhancedReferences":"\u003Cul\u003E\u003Cli\u003E\u003Ca href=\u0022https://mathscinet.ams.org/mathscinet/search/authors.html?authorName=Adams%2C%20Jeffrey\u0022\u003EJeffrey Adams\u003C/a\u003E, \u003Cem\u003EThe theta correspondence over $\\mathbb {R}$\u003C/em\u003E, Harmonic analysis, group representations, automorphic forms and invariant theory, Lect. Notes Ser. Inst. Math. Sci. Natl. Univ. Singap., vol.\u0026nbsp;12, World Sci. Publ., Hackensack, NJ, 2007, pp.\u0026nbsp;1\u0026ndash;39.  \u003Ca href=\u0022https://mathscinet.ams.org/mathscinet-getitem?mr=2401808\u0022\u003EMR \u003Cstrong\u003E2401808\u003C/strong\u003E\u003C/a\u003E, DOI \u003Ca href=\u0022https://doi.org/10.1142/9789812770790_0001\u0022\u003E10.1142/9789812770790_{0}001\u003C/a\u003E\u003C/li\u003E\n\n\n\u003Cli\u003E\u003Ca href=\u0022https://mathscinet.ams.org/mathscinet/search/authors.html?authorName=Adams%2C%20J.\u0022\u003EJ. Adams\u003C/a\u003E, \u003Ca href=\u0022https://mathscinet.ams.org/mathscinet/search/authors.html?authorName=Miller%2C%20S.%20D.\u0022\u003ES. D. Miller\u003C/a\u003E, \u003Ca href=\u0022https://mathscinet.ams.org/mathscinet/search/authors.html?authorName=van%20Leeuwen%2C%20M.\u0022\u003EM. van Leeuwen\u003C/a\u003E, and \u003Ca href=\u0022https://mathscinet.ams.org/mathscinet/search/authors.html?authorName=Vogan%2C%20D.%20A.\u0022\u003ED. A. Vogan\u003C/a\u003E, \u003Cem\u003EUnipotent representations of real exceptional groups\u003C/em\u003E, In preparation.\u003C/li\u003E\n\n\n\u003Cli\u003E\u003Ca href=\u0022https://mathscinet.ams.org/mathscinet/search/authors.html?authorName=Adams%2C%20J.\u0022\u003EJ. Adams\u003C/a\u003E, \u003Ca href=\u0022https://mathscinet.ams.org/mathscinet/search/authors.html?authorName=Arancibia%20Robert%2C%20N.\u0022\u003EN. Arancibia Robert\u003C/a\u003E, and \u003Ca href=\u0022https://mathscinet.ams.org/mathscinet/search/authors.html?authorName=Mezo%2C%20P.\u0022\u003EP. Mezo\u003C/a\u003E, \u003Cem\u003EEquivalent definitions of Arthur packets for real classical groups\u003C/em\u003E, Mem. Amer. Math. Soc. \u003Cstrong\u003E300\u003C/strong\u003E (2024), no.\u0026nbsp;1503, v\u002B110.  \u003Ca href=\u0022https://mathscinet.ams.org/mathscinet-getitem?mr=4790263\u0022\u003EMR \u003Cstrong\u003E4790263\u003C/strong\u003E\u003C/a\u003E, DOI \u003Ca href=\u0022https://doi.org/10.1090/memo/1503\u0022\u003E10.1090/memo/1503\u003C/a\u003E\u003C/li\u003E\n\n\n\u003Cli\u003E\u003Ca href=\u0022https://mathscinet.ams.org/mathscinet/search/authors.html?authorName=Adams%2C%20Jeffrey\u0022\u003EJeffrey Adams\u003C/a\u003E, \u003Ca href=\u0022https://mathscinet.ams.org/mathscinet/search/authors.html?authorName=Barbasch%2C%20Dan\u0022\u003EDan Barbasch\u003C/a\u003E, and \u003Ca href=\u0022https://mathscinet.ams.org/mathscinet/search/authors.html?authorName=Vogan%2C%20David%20A.%2C%20Jr.\u0022\u003EDavid A. Vogan Jr.\u003C/a\u003E, \u003Cem\u003EThe Langlands classification and irreducible characters for real reductive groups\u003C/em\u003E, Progress in Mathematics, vol.\u0026nbsp;104, Birkh\u0026auml;user Boston, Inc., Boston, MA, 1992.  \u003Ca href=\u0022https://mathscinet.ams.org/mathscinet-getitem?mr=1162533\u0022\u003EMR \u003Cstrong\u003E1162533\u003C/strong\u003E\u003C/a\u003E, DOI \u003Ca href=\u0022https://doi.org/10.1007/978-1-4612-0383-4\u0022\u003E10.1007/978-1-4612-0383-4\u003C/a\u003E\u003C/li\u003E\n\n\n\u003Cli\u003E\u003Ca href=\u0022https://mathscinet.ams.org/mathscinet/search/authors.html?authorName=Arancibia%20Robert%2C%20Nicolas\u0022\u003ENicolas Arancibia Robert\u003C/a\u003E and \u003Ca href=\u0022https://mathscinet.ams.org/mathscinet/search/authors.html?authorName=Mezo%2C%20Paul\u0022\u003EPaul Mezo\u003C/a\u003E, \u003Cem\u003EEquivalent definitions of Arthur packets for real unitary groups\u003C/em\u003E, Represent. Theory \u003Cstrong\u003E29\u003C/strong\u003E (2025), 968\u0026ndash;1027.  \u003Ca href=\u0022https://mathscinet.ams.org/mathscinet-getitem?mr=4982318\u0022\u003EMR \u003Cstrong\u003E4982318\u003C/strong\u003E\u003C/a\u003E, DOI \u003Ca href=\u0022https://doi.org/10.1090/ert/707\u0022\u003E10.1090/ert/707\u003C/a\u003E\u003C/li\u003E\n\n\n\u003Cli\u003E\u003Ca href=\u0022https://mathscinet.ams.org/mathscinet/search/authors.html?authorName=Arthur%2C%20James\u0022\u003EJames Arthur\u003C/a\u003E, \u003Cem\u003EOn some problems suggested by the trace formula\u003C/em\u003E, Lie group representations, II (College Park, Md., 1982/1983) Lecture Notes in Math., vol.\u0026nbsp;1041, Springer, Berlin, 1984, pp.\u0026nbsp;1\u0026ndash;49.  \u003Ca href=\u0022https://mathscinet.ams.org/mathscinet-getitem?mr=748504\u0022\u003EMR \u003Cstrong\u003E748504\u003C/strong\u003E\u003C/a\u003E, DOI \u003Ca href=\u0022https://doi.org/10.1007/BFb0073144\u0022\u003E10.1007/BFb0073144\u003C/a\u003E\u003C/li\u003E\n\n\n\u003Cli\u003E\u003Ca href=\u0022https://m