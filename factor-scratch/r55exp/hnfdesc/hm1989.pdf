<script src="/js/view.js?v=vfetZBEVGXgrmPh-XFhPUrTwaqmq1GmjLdcbmGJTifE"></script>
<script type="text/javascript">

    productDetailObj = {"SeriesVolumes":[],"DOI":null,"Abstract":null,"EnhancedReferences":null,"UnenhancedReferences":null,"IssueNumber":0,"Subsystem":"SUB","Issues":[{"IssueId":5822,"ProductCode":null,"Year":2027,"Volume":40,"IssueNumber":1,"IssueDirectory":"2027-40-01","FreeFlag":"N","EndMatterUrl":"/2027-40-01/jams-40-1-print-matter.pdf","FileUrlHost":"https://www.ams.org/journals/jams","HomeUrlHost":"https://pubs.ams.org/jams","DirectFileUrl":"","Articles":[{"ArticleId":93420,"JournalProductCode":"JAMS","IssueId":5822,"ManuscriptId":1079,"DocumentType":"ARTICLE","Title":"The derived Auslander\u0026ndash;Iyama correspondence","DOI":"10.1090/jams/1079","PII":"S0894-0347-2026-01079-X","Issue":null,"IssueDirectory":"2027-40-01","StartPage":1,"EndPage":127,"PostDate":"2026-08-21T00:00:00","PrimaryMsc":"18G80","SecondaryMsc":"18N40","MscSchema":"2020","Abstract":"We work over a perfect field. In this article, given an integer $d\\geq 1$, we establish a bijection between twisted $(d\u002B2)$-periodic algebras and suitable algebraic triangulated categories with a $d\\mathbb {Z}$-cluster tilting object. Furthermore, we show that these triangulated categories admit a unique differential graded enhancement. Our result yields recognition theorems for interesting algebraic triangulated categories, such as the Amiot cluster category of a self-injective quiver with potential in the sense of Herschend and Iyama and, more generally, the Amiot\u0026ndash;Guo\u0026ndash;Keller cluster category associated with a $d$-representation finite algebra in the sense of Iyama and Oppermann. As an application of our result, we obtain infinitely many triangulated categories with a unique differential graded enhancement that is not strongly unique. In the appendix, B. Keller explains how\u0026mdash;combined with crucial results of August and Hua\u0026ndash;Keller\u0026mdash;our main result yields the last key ingredient to prove the Donovan\u0026ndash;Wemyss Conjecture in the context of the Homological Minimal Model Program for threefolds.","EnhancedReferences":"\u003Cul\u003E\u003Cli\u003E\u003Ca href=\u0022https://mathscinet.ams.org/mathscinet/search/authors.html?authorName=Aihara%2C%20Takuma\u0022\u003ETakuma Aihara\u003C/a\u003E and \u003Ca href=\u0022https://mathscinet.ams.org/mathscinet/search/authors.html?authorName=Iyama%2C%20Osamu\u0022\u003EOsamu Iyama\u003C/a\u003E, \u003Cem\u003ESilting mutation in triangulated categories\u003C/em\u003E, J. Lond. Math. Soc. (2) \u003Cstrong\u003E85\u003C/strong\u003E (2012), no.\u0026nbsp;3, 633\u0026ndash;668.  \u003Ca href=\u0022https://mathscinet.ams.org/mathscinet-getitem?mr=2927802\u0022\u003EMR \u003Cstrong\u003E2927802\u003C/strong\u003E\u003C/a\u003E, DOI \u003Ca href=\u0022https://doi.org/10.1112/jlms/jdr055\u0022\u003E10.1112/jlms/jdr055\u003C/a\u003E\u003C/li\u003E\n\n\n\u003Cli\u003E\u003Ca href=\u0022https://mathscinet.ams.org/mathscinet/search/authors.html?authorName=Amiot%2C%20Claire\u0022\u003EClaire Amiot\u003C/a\u003E, \u003Cem\u003EOn the structure of triangulated categories with finitely many indecomposables\u003C/em\u003E, Bull. Soc. Math. France \u003Cstrong\u003E135\u003C/strong\u003E (2007), no.\u0026nbsp;3, 435\u0026ndash;474 (English, with English and French summaries).  \u003Ca href=\u0022https://mathscinet.ams.org/mathscinet-getitem?mr=2430189\u0022\u003EMR \u003Cstrong\u003E2430189\u003C/strong\u003E\u003C/a\u003E, DOI \u003Ca href=\u0022https://doi.org/10.24033/bsmf.2542\u0022\u003E10.24033/bsmf.2542\u003C/a\u003E\u003C/li\u003E\n\n\n\u003Cli\u003E\u003Ca href=\u0022https://mathscinet.ams.org/mathscinet/search/authors.html?authorName=Amiot%2C%20Claire\u0022\u003EClaire Amiot\u003C/a\u003E, \u003Cem\u003ESur les petites cat\u0026eacute;gories triangul\u0026eacute;es\u003C/em\u003E, Ph.D. Thesis, Universit\u0026eacute; Paris 7, 2008.\u003C/li\u003E\n\n\n\u003Cli\u003E\u003Ca href=\u0022https://mathscinet.ams.org/mathscinet/search/authors.html?authorName=Amiot%2C%20Claire\u0022\u003EClaire Amiot\u003C/a\u003E, \u003Cem\u003ECluster categories for algebras of global dimension 2 and quivers with potential\u003C/em\u003E, Ann. Inst. Fourier (Grenoble) \u003Cstrong\u003E59\u003C/strong\u003E (2009), no.\u0026nbsp;6, 2525\u0026ndash;2590 (English, with English and French summaries).  \u003Ca href=\u0022https://mathscinet.ams.org/mathscinet-getitem?mr=2640929\u0022\u003EMR \u003Cstrong\u003E2640929\u003C/strong\u003E\u003C/a\u003E, DOI \u003Ca href=\u0022https://doi.org/10.5802/aif.2499\u0022\u003E10.5802/aif.2499\u003C/a\u003E\u003C/li\u003E\n\n\n\u003Cli\u003E\u003Ca href=\u0022https://mathscinet.ams.org/mathscinet/search/authors.html?authorName=Angeltveit%2C%20Vigleik\u0022\u003EVigleik Angeltveit\u003C/a\u003E, \u003Cem\u003EUniqueness of Morava $K$-theory\u003C/em\u003E, Compos. Math. \u003Cstrong\u003E147\u003C/strong\u003E (2011), no.\u0026nbsp;2, 633\u0026ndash;648.  \u003Ca href=\u0022https://mathscinet.ams.org/mathscinet-getitem?mr=2776615\u0022\u003EMR \u003Cstrong\u003E2776615\u003C/strong\u003E\u003C/a\u003E, DOI \u003Ca href=\u0022https://doi.org/10.1112/S0010437X10005026\u0022\u003E10.1112/S0010437X10005026\u003C/a\u003E\u003C/li\u003E\n\n\n\u003Cli\u003E\u003Ca href=\u0022https://mathscinet.ams.org/mathscinet/search/authors.html?authorName=Antieau%2C%20Benjamin\u0022\u003EBenjamin Antieau\u003C/a\u003E, \u003Cem\u003EOn the uniqueness of infinity-categorical enhancements of triangulated categories\u003C/em\u003E,  arXiv:\u003Ca href=\u0022https://arxiv.org/abs/1812.01526\u0022\u003E1812.01526\u003C/a\u003E.\u003C/li\u003E\n\n\n\u003Cli\u003E\u003Ca href=\u0022https://mathscinet.ams.org/mathscinet/search/authors.html?authorName=August%2C%20Jenny\u0022\u003EJenny August\u003C/a\u003E, \u003Cem\u003EThe tilting theory of contraction algebras\u003C/em\u003E, Adv. Math. \u003Cstrong\u003E374\u003C/strong\u003E (2020), 107372, 56.  \u003Ca href=\u0022https://mathscinet.ams.org/mathscinet-getitem?mr=4157576\u0022\u003EMR \u003Cstrong\u003E