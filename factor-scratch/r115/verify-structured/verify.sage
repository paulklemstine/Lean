# Independent verification of the two consequential claims from the structured-nonce worker.
#  (1) I6: the GLV sublattice constraint is EMPTY -- the set {k1 + lam*k2 : k1,k2 < 2^(nb/2)}
#      has cardinal exactly n, i.e. it is the whole group, so a "sublattice embedding"
#      constrains nothing.
#  (2) I2(a known): an LCG nonce sequence with KNOWN multiplier a yields the private key from
#      4 signatures with ZERO nonce leakage; t=3 must fail (control) and the plain baseline
#      must fail too.
import time

# ---------- (1) GLV box density on a real curve ----------
print("=== (1) I6: GLV box density ===", flush=True)
def glibc_curve_cube_root(p, lam_candidate):
    return lam_candidate
for p, lam in [(101, None), (1013, None), (10007, None), (100003, None)]:
    F = GF(p)
    # a curve with a cube root of unity in F_p: p = 1 mod 3, use y^2 = x^3 + 1 (j=0)
    if p % 3 != 1: continue
    E = EllipticCurve(F, [0, 1])
    n = E.order()
    # a primitive cube root of unity
    w = F.multiplicative_generator()**((p-1)//3)
    # GLV: phi(x,y) = (w*x, y) satisfies phi^2+phi+1 = 0, so lam^2+lam+1 = 0 mod n
    # find lam by solving the quadratic mod n
    R = Integers(n)
    x = R.gen()
    sols = solve_mod(x**2 + x + 1, n) if False else None
    # brute force: lam is a cube root of unity mod n
    lam_vals = [c for c in range(n) if (c**3 - 1) % n == 0 and c != 1]
    if not lam_vals: 
        print(f"  p={p} n={n}: no cube root of unity mod n (skip)", flush=True); continue
    lam = lam_vals[0]
    half = int(sqrt(n)) + 2
    # count distinct k1 + lam*k2 mod n for k1,k2 < 2^(ceil(nb/2)) -- use a smaller box to
    # test the density claim, then scale reasoning
    nb = n.nbits()
    import math
    boxbits = int(math.ceil(nb/2))
    if boxbits > 12: boxbits = 12          # keep the enumeration small; report the ratio
    S = 1 << boxbits
    img = set()
    for k1 in range(S):
        for k2 in range(S):
            img.add((k1 + lam*k2) % n)
    print(f"  p={p:6d} n={n:6d} ({nb}b) lam^2+lam+1=0 mod n: {((lam**2+lam+1) % n)==0} | "
          f"box 2^{boxbits} x 2^{boxbits} -> |image| = {len(img)} of {S*S} pairs "
          f"-> density {float(len(img))/(S*S):.4f}", flush=True)

# ---------- (2) I2(a known) LCG nonces ----------
print("=== (2) I2(a known): LCG nonces, known multiplier ===", flush=True)
def lcg_attack(n, t, m, a, sec=0):
    """nonces k_{i+1} = a*k_i + b mod 2^m, a KNOWN, b and d unknown.
    k_i = a^i*k_0 + b*Sig_i  (mod 2^m),  Sig_i = (a^i-1)/(a-1)
    signature: s_i k_i = z_i + r_i d (mod n).
    Unknowns: (k_0, b, d) plus the carries q_i with k_i = K_i - 2^m q_i.
    Build the lattice over (k_0, b, d, q_1..q_t) as in the worker's kernel construction:
    each equation is linear:  s_i*a^i k_0 + s_i*Sig_i b - s_i*2^m q_i - r_i d = z_i (mod n).
    """
    set_random_seed(sec)
    b = ZZ(randint(0, (1 << m) - 1)); d = ZZ(randint(1, n - 1)); k0 = ZZ(randint(1, (1 << m) - 1))
    ks = [k0]
    for _ in range(t - 1):
        ks.append((a * ks[-1] + b) % (1 << m))
    Sig = []; ai = 1
    for i in range(t):
        ai = (ai * a) % (1 << m)
        Sig.append(((ai - 1) * inverse_mod(a - 1, 1 << m)) % (1 << m))
    rs, ss, zs = [], [], []
    for i in range(t):
        r = ZZ(randint(1, n - 1)); z = ZZ(randint(0, n - 1))
        s = (z + r * d) * inverse_mod(ks[i], n) % n
        rs.append(r); ss.append(s); zs.append(z)
    # unknowns: k0, b, d, q_1..q_t   (t+3), equations t -> free variables t+3-t = 3
    # Construct the lattice: rows for the kernel of the equation matrix mod n, plus the
    # target row; SVP as in the HNP embedding.
    dim = t + 4
    M = matrix(ZZ, dim, dim)
    # equation i:  s_i a^i k0 + s_i Sig_i b - r_i d - s_i 2^m q_i = z_i  (mod n)
    Amat = matrix(ZZ, t, t + 3)
    for i in range(t):
        Amat[i, 0] = ss[i] * ((a**i) % n) % n
        Amat[i, 1] = ss[i] * Sig[i] % n
        Amat[i, 2] = (-rs[i]) % n
        Amat[i, 3 + i] = (-ss[i] * (1 << m)) % n
    rhs = vector(ZZ, zs)
    # find a particular solution and a basis for the kernel (right null space) mod n
    # solve Amat x = rhs over ZZ/nZ
    sol = Amat.solve_right(rhs) if False else None
    # use Smith/Hermite-free approach: use Sage's integer solve over ZMod? do it by hand
    Zm = Zmod(n)
    Az = matrix(Zm, Amat)
    try:
        x0 = Az.solve_right(vector(Zm, rhs))
    except Exception:
        return None, "no solution"
    # kernel basis over ZMod -> lift to ZZ basis of the kernel lattice of Amat mod n
    K = Az.right_kernel_matrix()
    # kernel lattice: vectors x with Amat x = 0 mod n, i.e. (K rows scaled) plus n*e_j
    # Build the lattice generated by: kernel basis rows (lifted), n*e_j for each column,
    # and the particular solution row (as the target).
    kdim = t + 3
    basis = []
    for j in range(K.nrows()):
        row = [ZZ(0)] * kdim
        for c in range(kdim):
            row[c] = ZZ(K[j, c])
        basis.append(row)
    for j in range(kdim):
        row = [ZZ(0)] * kdim; row[j] = n; basis.append(row)
    L = matrix(ZZ, basis)
    # reduce and search for the small solution
    R = L.LLL()
    best = None
    # search small combinations of the reduced basis for a valid (k0,b,d)
    from itertools import product
    coeff_range = 2
    # too large to enumerate; instead use the LLL-reduced basis to express x0 by solving
    X0 = vector(ZZ, [ZZ(x0[c]) for c in range(kdim)])
    # solve X0 = y * R  over QQ, round, and check
    try:
        y = R.solve_left(X0)
        yr = vector(ZZ, [ZZ(round(QQ(y[c]))) for c in range(kdim)])
        cand = yr * R
        # cand should equal X0 +/- small kernel vector
        diff = vector(ZZ, [ZZ(cand[c]) - X0[c] for c in range(kdim)])
        if all((Amat[j].dot_product(vector(ZZ,[diff[c] for c in range(kdim)]))) % n == 0 for j in range(t)):
            k0r, br, dr = cand[0] % (1<<m), cand[1] % (1<<m), cand[2] % n
            if dr == d:
                return True, "recovered d"
        return False, "cand not d"
    except Exception as ex:
        return False, f"fail {type(ex).__name__}"

# small prime-order group via a real curve for n
F = GF(10007); E = EllipticCurve(F, [0, 1]); n = E.order()
print(f"  curve y^2=x^3+1 over F_10007, group order n = {n} ({n.nbits()} bits)", flush=True)
a = 1103515245 % (1 << 20)     # glibc-style multiplier, reduced to fit m
m = 20
print(f"  LCG: m = {m}, a = {a} (KNOWN), b secret; signature modulus n = {n}", flush=True)
for t in [3, 4, 5, 6]:
    ok = fail = 0
    for sec in range(12):
        r, msg = lcg_attack(n, t, m, a, sec=sec)
        if r: ok += 1
        else: fail += 1
    print(f"  t={t}: recovered d in {ok}/12   ({msg})", flush=True)
