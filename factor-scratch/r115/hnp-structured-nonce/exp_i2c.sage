# ---------------------------------------------------------------------------
# exp_i2c.sage -- I2, information-theoretic counting experiment (small scale).
#
# Question: with the nonces generated by k_{i+1} = a k_i + b (mod 2^m) and
# a SECRET, is recovering d easier or harder than with the plain HNP?
#
# We count the number of solutions consistent with the observed leakage, by
# brute force at a size where brute force is possible:
#   * plain HNP : #d in [0,n) with  (y_i + g_i d) mod n  in the known interval
#   * LCG       : #(a,b,k_1) in [0,2^m)^3 whose nonce sequence reproduces the
#                 observed known bits of all t nonces
# The plain count is ~2^(nb - t*ell); the LCG count is ~2^(3m - t*ell), i.e.
# the LCG state costs 2m extra bits that must be paid for by leakage.
#
# Usage: sage exp_i2c.sage
# ---------------------------------------------------------------------------
from sage.all import *
load('common.sage')

def P(*a): print(*a, flush=True)

# ---- small prime-order curve, n just above 2^m ----------------------------
found = None
p = 2**12
while found is None and p < 2**18:
    p = next_prime(p)
    E = EllipticCurve(GF(p), [0, 7])
    nE = int(E.order())
    if Integer(nE).is_prime() and nE > 2**12:
        found = (p, nE, E)
(p0, n0, E0) = found
C = dict(p=p0, a=0, b=7, n=n0, G=(int(E0.gens()[0][0]), int(E0.gens()[0][1])))
nb = Integer(n0).nbits()
M = 7                      # LCG state size (bits)
two_m = 2**M
P("small curve: p=%d n=%d (%d bits), LCG modulus 2^%d" % (p0, n0, nb, M))
P("plain HNP floor:  t*ell >= %d      LCG-state floor: t*ell >= 3*%d = %d"
  % (nb, M, 3*M))
P("")
P("%5s %5s %8s %14s %14s %16s" %
  ("ell", "t", "t*ell", "#d (plain)", "#(a,b,k1)", "ratio"))

res = {}
for ell in (1, 2, 3):
    for t in (4, 6, 8, 10, 12, 14):
        # ---- one random instance
        d_true = int(randrange(1, n0))
        k = int(randrange(1, two_m))
        a_true = int(randrange(1, two_m))
        b_true = int(randrange(0, two_m))
        ks = []
        for i in range(t):
            ks.append(k)
            k = (a_true*k + b_true) % two_m
        K = 2**(M - ell)
        kbars = [(x // K) * K for x in ks]
        r, s, z = [], [], []
        for i in range(t):
            zi = int(randrange(0, n0))
            ri, si = ecdsa_sign(ks[i], d_true, zi, C)
            r.append(ri); s.append(si); z.append(zi)
        g = [(r[i] * inverse_mod(s[i], n0)) % n0 for i in range(t)]
        y = [(z[i] * inverse_mod(s[i], n0)) % n0 for i in range(t)]
        # ---- count d consistent with the known bits (brute force over d)
        cnt_d = 0
        for dd in range(n0):
            ok = True
            for i in range(t):
                v = (y[i] + g[i]*dd) % n0
                if v // K != kbars[i] // K:
                    ok = False
                    break
            cnt_d += int(ok)
        # ---- count (a,b,k1) consistent with the known bits (brute force)
        cnt_state = 0
        for a in range(1, two_m):
            for b in range(two_m):
                kk = -1
                for k1 in range(1, two_m):
                    ok = True
                    cur = k1
                    for i in range(t):
                        if cur // K != kbars[i] // K:
                            ok = False
                            break
                        cur = (a*cur + b) % two_m
                    if ok:
                        if kk >= 0:      # more than one k1 for this (a,b)
                            kk = -2
                        else:
                            kk = k1
                if kk >= 0:
                    cnt_state += 1
        res[(ell, t)] = (cnt_d, cnt_state)
        P("%5d %5d %8d %14d %14d %16.2f"
          % (ell, t, ell*t, cnt_d, cnt_state, cnt_state/float(max(cnt_d, 1))))
P("")
P("predicted:  #d ~ 2^(nb - t*ell) = 2^(%d - t*ell) ;  #(a,b,k1) ~ 2^(3m - t*ell)"
  " = 2^(%d - t*ell)" % (nb, 3*M))
P("=> the LCG structure needs 3m = %d bits of leakage to pin the nonce sequence,"
  % (3*M,))
P("   against nb = %d bits to pin d itself: unknown a makes the problem harder,"
  % nb)
P("   not easier.  (After the state is recovered d follows from one signature.)")
