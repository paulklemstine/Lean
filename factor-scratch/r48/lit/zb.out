_codes":["vaughan.robert-c"],"document_id":4087770,"msc":["11P05","11P55","11L40","11N35"],"prefix":"Zbl","series_id":282,"year":"1989"}},{"doi":null,"position":"154","text":"Vershik, A.M., (1987) The asymptotic distribution of factorizations of natural numbers into prime divisors, Soviet Math. Dokl.34, 57-61.","zbmath":{"author_codes":["vershik.anatoli-m"],"document_id":4014826,"msc":["11N05","11K99"],"prefix":"Zbl","series_id":717,"year":"1987"}},{"doi":null,"position":"155","text":"Vinogradov, I.M., (1926) On a bound for the least nth power non-residue (Russian), Izv. Akad. Nauk SSSR20, 47-58; English transl.: Trans. Amer. Math. Soc.29 (1927), 218-226.","zbmath":{"author_codes":["vinogradov.ivan-matveevich"],"document_id":2581186,"msc":["11N69","11A15"],"prefix":"JFM","series_id":744,"year":"1927"}},{"doi":null,"position":"156","text":"Wang, Y., (1964) Estimation and application of a character sum (Chinese), Shuzue Jinzhan7, 78-83.","zbmath":{"author_codes":["wang.yuan"],"document_id":3788740,"msc":["11L40","11D04","11A15"],"prefix":"Zbl","series_id":4432,"year":"1983"}},{"doi":null,"position":"157","text":"Warlimont, R., (1990) Sieving by large prime factors, Monatshefte Math.109, 247-256.","zbmath":{"author_codes":["warlimont.richard"],"document_id":4173121,"msc":["11N25","11N36"],"prefix":"Zbl","series_id":595,"year":"1990"}},{"doi":null,"position":"158","text":"(1991) Arithmetical semigroups, II: Sieving by large and small prime elements. Sets of multiples, Manuscripta Math.71, 197-221.","zbmath":{"author_codes":["warlimont.richard"],"document_id":10297,"msc":["11N80","11N25","11N36"],"prefix":"Zbl","series_id":547,"year":"1991"}},{"doi":null,"position":"159","text":"Wheeler, F., (1990) Two differential-difference equations arising in number theory, Trans. Amer. Math. Soc.318, 491-523.","zbmath":{"author_codes":["wheeler.ferrell-s"],"document_id":4142133,"msc":["11N05","11N35","34K05","65L05"],"prefix":"Zbl","series_id":744,"year":"1990"}},{"doi":null,"position":"160","text":"Wolke, D., (1971) Polynomial values with small prime divisors, Acta Arith.19, 327-333.","zbmath":{"author_codes":["wolke.dieter"],"document_id":3368724,"msc":["11N32"],"prefix":"Zbl","series_id":278,"year":"1971"}},{"doi":null,"position":"161","text":"(1973) Über die mittlere Verteilung der Werte zahlentheoretischer Funktionen auf Restklassen. I, Math. Ann.202, 1-205.","zbmath":{"author_codes":["wolke.dieter"],"document_id":3377328,"msc":["11N69","11L03","11N37"],"prefix":"Zbl","series_id":554,"year":"1973"}},{"doi":null,"position":"162","text":"Wooley, T., (1992) Large improvements in Waring's problem, Annals Math.(2) 135, no 1, 135-164.","zbmath":{"author_codes":["wooley.trevor-d"],"document_id":55727,"msc":["11P05","11P55","11L15"],"prefix":"Zbl","series_id":2531,"year":"1992"}},{"doi":null,"position":"163","text":"Xuan, T.Z., (1988) On a problem of Erdös and Ivić, Publ. Inst. Math. (Beograd) (N. S.) 43 (57), 9-15.","zbmath":{"author_codes":["xuan.tizuo"],"document_id":4057615,"msc":["11N37"],"prefix":"Zbl","series_id":639,"year":"1988"}},{"doi":null,"position":"164","text":"(1989a) On sums involving reciprocals of certain large additive functions. I, Publ. Inst. Math. (Beograd) (N. S.) 45 (59), 41-55.","zbmath":{"author_codes":["xuan.tizuo"],"document_id":4116632,"msc":["11N37","11N05"],"prefix":"Zbl","series_id":639,"year":"1989"}},{"doi":null,"position":"165","text":"(1989b) On sums involving reciprocals of certain large additive functions. II, Publ. Inst. Math. (Beograd) (N. S.) 46 (60), 25-32.","zbmath":{"author_codes":["xuan.tizuo"],"document_id":4144071,"msc":["11N37","11N05"],"prefix":"Zbl","series_id":639,"year":"1989"}},{"doi":null,"position":"166","text":"(1990) The average of dk(n) over integers free of large prime factors, Acta Arith.55, 249-260.","zbmath":{"author_codes":["xuan.tizuo"],"document_id":4073103,"msc":["11N37","11N05"],"prefix":"Zbl","series_id":278,"year":"1990"}},{"doi":null,"position":"167","text":"(1991) The average of the divisor function over integers without large prime factors, Chinese Ann. of Math. Ser. A 12, 28-33.","zbmath":{"author_codes":["xuan.tizuo"],"document_id":62556,"msc":["11N25","11N37"],"prefix":"Zbl","series_id":952,"year":"1991"}},{"doi":null,"position":"168","text":"(1993) On the asymptotic behavior of the DicZanan-de Bruijn function, Math. Ann.297, 519-533.","zbmath":{"author_codes":["xuan.tizuo"],"document_id":537327,"msc":["11N25","34K99","11N37"],"prefix":"Zbl","series_id":554,"year":"1993"}}],"source":{"book":[],"pages":"411-484","series":[{"acronym":"JTNB","issn":[{"number":"1246-7405","type":"print"},{"number":"2118-8572","type":"electronic"}],"issue":"2","issue_id":18911,"parallel_title":null,"part":null,"publisher":"Université Bordeaux 1, Institut de Mathématiques de Bordeaux, Talence","series_id":1917,"short_title":"J. Théor. Nombres Bordx.","title":"Journal de Théorie des Nombres de Bordeaux","volume":"5","year":"1993"}],"source":"J. Théor. Nombres Bordx. 5, No. 2, 411-484 (1993)."},"states":[["o","has open version"],["o","has open version"],["r","item has references"],["c","is cited"]],"title":{"addition":null,"original":null,"subtitle":null,"title":"Integers without large prime factors"},"year":"1993","zbmath_url":"https://zbmath.org/556386"},{"biographic_references":[],"contributors":{"authors":[{"aliases":[],"checked":"1","codes":["friedlander.john-b"],"name":"Friedlander, John B."},{"aliases":[],"checked":"1","codes":["granville.andrew-j"],"name":"Granville, Andrew"}],"author_references":[],"editors":[]},"database":"Zbl","datestamp":"0001-01-01T00:00:00Z","document_type":{"code":"j","description":"journal article"},"editorial_contributions":[{"language":"English","reviewer":{"author_code":"hildebrand.adolf-j","reviewer_id":"1166","name":"Adolf Hildebrand","sign":"A.Hildebrand (Urbana)"},"text":"A positive integer is called \\(y\\)-smooth if all of its prime factors are \\(\\leq y\\). The authors are interested in the distribution of such numbers in short intervals, and specifically in proving asymptotic estimates of the form \n\\[\n\\Psi(x+z,y)- \\Psi(x,y)\\sim {\\textstyle {z\\over x}} \\Psi(x,y) \\tag{1}\n\\]\n in as large a range as possible. Here \\(\\Psi(x,y)\\) denotes as usual the number of \\(y\\)-smooth integers up to \\(x\\). The authors' main result is that (1) holds uniformly in the range \n\\[\n x\\geq y\\geq\\exp ((\\log x)^{5/6+\\varepsilon}),\\tag{2}\n\\]\n \n\\[\nx\\geq z\\geq x^{1/2} y^ 2\\exp ((\\log x)^{1/6}),\\tag{3}\n\\]\n when \\(x\\to\\infty\\), for any fixed \\(\\varepsilon>0\\). For the proof the authors first relate \\(\\Psi (x+z,y)- \\Psi(x,y)\\) to an average of terms of the form \\(\\Psi((x+z)/ m,y)- \\Psi(x/m,y)\\); this is the `smoothing' referred to in the title. They then estimate these terms using a result of \\textit{G. Tenenbaum} and the reviewer [J. Théor. Nombres Bordeaux 5, 411-484 (1993)] which roughly states that (1) holds in an `almost all' sense when \\(y\\) lies in the range (2) and \\(z\\) satisfies \\(x\\geq z\\geq y\\exp ((\\log x)^{1/6})\\).","contribution_type":"review"}],"id":549314,"identifier":"0795.11041","keywords":[],"language":{"languages":["English"],"addition":[null]},"license":[],"links":[{"identifier":"10.1098/rsta.1993.0133","type":"doi","url":"https://doi.org/10.1098/rsta.1993.0133"}],"msc":[{"code":"11N25","scheme":"msc2020","text":"Distribution of integers with specified multiplicative constraints"}],"references":[],"source":{"book":[],"pages":"339-347","series":[{"acronym":null,"issn":[{"number":"0962-8428","type":"print"},{"number":"1471-2962","type":"electronic"}],"issue":"1676","issue_id":18191,"parallel_title":null,"part":null,"publisher":"The Royal Society of London, London","series_id":1770,"short_title":"Philos. Trans. R. Soc. Lond., Ser. A","title":"Philosophical Transactions of the Royal Society of London. Series A","volume":"345","year":"1993"}],"source":"Philos. Trans. R. Soc. Lond., Ser. A 345, No. 1676, 339-347 (1993)."},"states":[["c","is cited"]],"title":{"addition":null,"original":null,"subtitle":null,"title":"Smoothing `smooth' numbers"},"year":"1993","zbmath_url":"https://zbmath.org/549314"}],"status":{"execution":"successful request","execution_bool":true,"internal_code":"ok","last_id":null,"nr_total_results":2,"nr_request_results":2,"query_execution_time_in_seconds":0.21515130996704102,"status_code":200,"time_stamp":"2026-10-03T18:14:07Z"}}