               class="layout__region layout__region--first"
          >

              

  <div class="uw-text-align--left block block-layout-builder block-inline-blockuw-cbl-copy-text">
        
        
          <div class="uw-copy-text">
  <div class="uw-copy-text__wrapper ">
    <p class="enlarged">WatIAM usernames are used by the University's central systems, including Quest, WaterlooWorks, LEARN, myHRinfo, and Microsoft 365.</p>

<p class="enlarged">Access the WatIAM system to <a href="https://idm.uwaterloo.ca/watiam/login.jsf?prompt=true">manage your username and password</a>, including <a href="/watiam/node/8/#forgotten">addressing a forgotten username or password</a>. </p>
  </div>
</div>

      </div>

          </div>

    
  
</section>




  



