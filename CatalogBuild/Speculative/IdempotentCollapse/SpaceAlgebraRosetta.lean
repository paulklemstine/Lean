/-- A point of the prime spectrum is a prime ideal. -/
theorem rosetta_row1_point_is_prime_ideal :
    ∀ (x : PrimeSpectrum R), (x.asIdeal).IsPrime :=
  fun x => x.isPrime


/-- Basic open sets are generated by ring elements. -/
theorem rosetta_row2_element_gives_open (f : R) :
    IsOpen (basicOpen f : Set (PrimeSpectrum R)) :=
  (basicOpen f).isOpen


/-- The basic opens form a topological basis. -/
theorem rosetta_row2_basic_opens_are_basis :
    IsTopologicalBasis
      (Set.range (fun f : R => (basicOpen f : Set (PrimeSpectrum R)))) :=
  PrimeSpectrum.isTopologicalBasis_basic_opens


/-- A ring homomorphism induces a continuous map on spectra (contravariantly). -/
theorem rosetta_row3_ring_hom_gives_continuous_map
    {S : Type*} [CommRing S] (φ : R →+* S) :
    Continuous (PrimeSpectrum.comap φ) :=
  PrimeSpectrum.continuous_comap φ


/-- The zero locus of a set of ring elements is closed. -/
theorem rosetta_row4_ideal_gives_closed (s : Set R) :
