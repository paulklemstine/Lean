    ∃ e : R, IsIdempotentElem e ∧ s = (basicOpen e : Set (PrimeSpectrum R)) :=
  PrimeSpectrum.exists_idempotent_basicOpen_eq_of_isClopen hs


/-- Idempotents split the spectrum: V(e) = D(1-e). -/
theorem rosetta_row7_idempotent_splits_spectrum (e : R) (he : IsIdempotentElem e) :
    PrimeSpectrum.zeroLocus {e} = (basicOpen (1 - e) : Set (PrimeSpectrum R)) :=
  PrimeSpectrum.zeroLocus_eq_basicOpen_of_isIdempotentElem e he


/-- Each clopen determines a UNIQUE idempotent. -/
theorem rosetta_row7_unique_idempotent (s : Set (PrimeSpectrum R))
