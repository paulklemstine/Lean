  PrimeSpectrum.existsUnique_idempotent_basicOpen_eq_of_isClopen hs


/-- Projective modules lift along surjections. -/
theorem rosetta_row8_projective_lifts {M N P : Type*}
    [AddCommMonoid M] [Module R M] [AddCommMonoid N] [Module R N]
    [AddCommMonoid P] [Module R P] [Module.Projective R P]
    (f : M →ₗ[R] N) (g : P →ₗ[R] N) (hf : Surjective f) :
    ∃ h : P →ₗ[R] M, f ∘ₗ h = g :=
