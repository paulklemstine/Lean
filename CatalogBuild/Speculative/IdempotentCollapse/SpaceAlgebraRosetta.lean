  ⟨PrimeSpectrum.isIdempotentElemEquivClopens⟩


/-- An idempotent element determines a clopen subset. -/
theorem rosetta_row7_idempotent_gives_clopen (e : R) (he : IsIdempotentElem e) :
    IsClopen (basicOpen e : Set (PrimeSpectrum R)) :=
  PrimeSpectrum.isClopen_iff.mpr ⟨e, he, rfl⟩


/-- A clopen subset determines an idempotent element. -/
theorem rosetta_row7_clopen_gives_idempotent (s : Set (PrimeSpectrum R))
