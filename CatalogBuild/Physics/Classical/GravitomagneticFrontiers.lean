/-- A sensor array is a list of orientations (angles). -/
def SensorArray := List ℝ


/-- Sensor response at angle θ from a single element at angle θ₀. -/
def singleSensorResponse (theta theta_0 sigma : ℝ) : ℝ :=
  Real.exp (-(theta - theta_0) ^ 2 / (2 * sigma ^ 2))


/-- Single sensor response is positive. -/
theorem single_sensor_positive (theta theta_0 sigma : ℝ) :
    singleSensorResponse theta theta_0 sigma > 0 := by
  unfold singleSensorResponse
  exact Real.exp_pos _


