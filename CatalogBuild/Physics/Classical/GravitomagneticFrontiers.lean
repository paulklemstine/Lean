  -- Since the list is non-empty, there's at least one term, and each term is positive. Therefore, their sum must be positive.
  have h_pos : ∀ {l : List ℝ}, l ≠ [] → 0 < List.sum (List.map (fun c => Real.exp (-beta * c)) l) := by
