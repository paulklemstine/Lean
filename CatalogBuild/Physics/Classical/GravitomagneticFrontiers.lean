/-- Two GEM fields combine by vector addition. -/
def GEMField.add (F₁ F₂ : GEMField) : GEMField where
  E_g := F₁.E_g + F₂.E_g
  B_g := F₁.B_g + F₂.B_g


/-- Triangle inequality for GEM fields (squared form). -/
theorem gem_triangle_ineq (F₁ F₂ : GEMField) :
    (F₁.add F₂).normSq ≤ 2 * (F₁.normSq + F₂.normSq) := by
  unfold GEMField.add GEMField.normSq
  nlinarith [sq_nonneg (F₁.E_g - F₂.E_g), sq_nonneg (F₁.B_g - F₂.B_g)]


/-- GEM duality: (E,B) ↦ (B,-E). -/
def GEMField.dual (F : GEMField) : GEMField where
  E_g := F.B_g
  B_g := -F.E_g


/-- Duality preserves norm. -/
theorem gem_duality_norm (F : GEMField) : F.dual.normSq = F.normSq := by
  unfold GEMField.dual GEMField.normSq; ring


/-- Double duality is negation. -/
theorem gem_double_dual (F : GEMField) :
    F.dual.dual = ⟨-F.E_g, -F.B_g⟩ := by
  simp [GEMField.dual]


/-- Lense-Thirring precession rate. -/
def lenseThirring (G_const J c_light r : ℝ) : ℝ :=
  2 * G_const * J / (c_light ^ 2 * r ^ 3)


/-- Lense-Thirring is positive for prograde orbits. -/
