/-- A gravitoelectromagnetic field configuration. -/
structure GEMField where
  E_g : ℝ  -- gravitoelectric (tidal)
  B_g : ℝ  -- gravitomagnetic (frame-dragging)


/-- GEM field norm squared. -/
def GEMField.normSq (F : GEMField) : ℝ := F.E_g ^ 2 + F.B_g ^ 2


/-- GEM field angle (direction on the unit circle). -/
def GEMField.angle (F : GEMField) : ℝ := Real.arctan (F.B_g / F.E_g)


/-- A Pythagorean triple with natural number components. -/
structure PythTriple where
  a : ℕ
  b : ℕ
  c : ℕ
  hyp : a ^ 2 + b ^ 2 = c ^ 2


/-- The GEM field generated by a Pythagorean triple. -/
def PythTriple.toGEM (t : PythTriple) : GEMField where
  E_g := 2 * (t.a : ℝ) * (t.b : ℝ) / (t.c : ℝ) ^ 2
  B_g := ((t.b : ℝ) ^ 2 - (t.a : ℝ) ^ 2) / (t.c : ℝ) ^ 2


/-- Integer gravitons have unit norm. -/
theorem pythagorean_gem_unit (t : PythTriple) (hc : (t.c : ℝ) ≠ 0) :
    t.toGEM.normSq = 1 := by
  unfold PythTriple.toGEM GEMField.normSq
  field_simp
  ring
  norm_cast
  nlinarith [t.hyp]


/-- The Q-factor of a Pythagorean resonance: Q = c² / gcd(2ab, |b²-a²|). -/
def PythTriple.qFactorNum (t : PythTriple) : ℕ := t.c ^ 2


/-- The Q-factor numerator (c²) is always positive for nondegenerate triples. -/
theorem pythagorean_q_factor_pos (t : PythTriple) (hc : t.c > 0) :
    t.qFactorNum > 0 := by
  unfold PythTriple.qFactorNum
  positivity


/-- Resonant amplification: effective field = Q × bare field. -/
def resonantField (B_bare Q : ℝ) : ℝ := Q * B_bare


/-- Resonant amplification with Q > 1 increases the field magnitude. -/
theorem resonance_amplification (B_bare Q : ℝ) (hB : B_bare > 0) (hQ : Q > 1) :
    resonantField B_bare Q > B_bare := by
  unfold resonantField
  exact lt_mul_of_one_lt_left hB hQ


/-- Resonant amplification preserves field sign. -/
theorem resonance_preserves_sign (B_bare Q : ℝ) (hB : B_bare > 0) (hQ : Q > 0) :
    resonantField B_bare Q > 0 := by
  unfold resonantField
  exact mul_pos hQ hB


/-- Lorentzian response function: R(ω) = 1 / ((ω - ω₀)² + γ²). -/
def lorentzianResponse (omega omega_0 gamma : ℝ) : ℝ :=
  1 / ((omega - omega_0) ^ 2 + gamma ^ 2)


/-- Lorentzian response is positive for γ > 0. -/
theorem lorentzian_positive (omega omega_0 gamma : ℝ) (hg : gamma > 0) :
    lorentzianResponse omega omega_0 gamma > 0 := by
  unfold lorentzianResponse
  positivity


/-- At resonance (ω = ω₀), the response is maximized: R = 1/γ². -/
theorem lorentzian_at_resonance (omega_0 gamma : ℝ) (hg : gamma ≠ 0) :
    lorentzianResponse omega_0 omega_0 gamma = 1 / gamma ^ 2 := by
  unfold lorentzianResponse
  simp [sub_self]


