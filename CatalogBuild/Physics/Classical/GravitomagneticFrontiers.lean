theorem lense_thirring_decay (G_const J c_light r₁ r₂ : ℝ)
    (hG : G_const > 0) (hJ : J > 0) (hc : c_light > 0)
    (hr₁ : r₁ > 0) (hr₂ : r₂ > 0) (hlt : r₁ < r₂) :
