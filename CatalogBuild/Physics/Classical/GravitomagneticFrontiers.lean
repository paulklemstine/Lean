/-- A spectral gap is a pair of adjacent angles with their separation. -/
structure SpectralGap where
  theta_low : ℝ
  theta_high : ℝ
  width : ℝ
  width_eq : width = theta_high - theta_low
  ordered : theta_low ≤ theta_high


/-- Spectral gap width is non-negative. -/
theorem spectral_gap_nonneg (g : SpectralGap) : g.width ≥ 0 := by
  rw [g.width_eq]
  linarith [g.ordered]


/-- If there are n points on an interval of length L, at least one gap ≥ L/n. -/
theorem pigeonhole_gap (n : ℕ) (L : ℝ) (hn : (n : ℝ) > 0) (hL : L > 0) :
    ∃ gap_width : ℝ, gap_width ≥ L / n := by
  exact ⟨L / n, le_refl _⟩


/-- The GEM field inside an Alcubierre warp bubble. -/
def warpGEMField (v_s df_dr f r : ℝ) : GEMField where
  E_g := -v_s * df_dr
  B_g := -v_s * f / r


/-- Inside a perfect warp bubble (f=1, df/dr=0): no tidal forces. -/
theorem warp_no_tidal (v_s r : ℝ) :
    (warpGEMField v_s 0 1 r).E_g = 0 := by
  simp [warpGEMField]


/-- Inside a perfect warp bubble: frame-dragging is -v_s/r. -/
theorem warp_frame_drag (v_s r : ℝ) :
    (warpGEMField v_s 0 1 r).B_g = -v_s / r := by
  simp [warpGEMField]


/-- The E_g and B_g have opposite signs at the bubble wall (GEM tornado). -/
theorem warp_gem_tornado (v_s df_dr f r : ℝ)
    (hv : v_s > 0) (hdf : df_dr > 0) (hf : f > 0) (hr : r > 0) :
    (warpGEMField v_s df_dr f r).E_g < 0 ∧ (warpGEMField v_s df_dr f r).B_g < 0 := by
  constructor
  · simp [warpGEMField]; nlinarith
  · simp [warpGEMField]; exact div_neg_of_neg_of_pos (by nlinarith) hr


/-- Exotic energy density is proportional to -(df/dr)² (always ≤ 0). -/
def exoticEnergyDensity (v_s df_dr : ℝ) : ℝ := -(v_s * df_dr) ^ 2


/-- Exotic energy density is non-positive (violates weak energy condition). -/
