/-- Exotic energy density scales quadratically with warp speed. -/
theorem exotic_energy_scaling (v_s₁ v_s₂ df_dr : ℝ) (hdf : df_dr ≠ 0)
    (hv : v_s₂ = 2 * v_s₁) :
    exoticEnergyDensity v_s₂ df_dr = 4 * exoticEnergyDensity v_s₁ df_dr := by
  unfold exoticEnergyDensity; rw [hv]; ring


/-- Partition function: Z(β) = Σ exp(-β · cᵢ) for a list of hypotenuses. -/
def partitionFunction (beta : ℝ) (hypotenuses : List ℝ) : ℝ :=
  (hypotenuses.map (fun c => Real.exp (-beta * c))).sum


/-- [Section: # CatalogBuild.Physics.Classical.GravitomagneticFrontiers
