import Mathlib

theorem photon_parity_constraint (a b c d : ℤ)
    (h : a ^ 2 + b ^ 2 + c ^ 2 = d ^ 2) :
    Even (a + b + c + d) := by
  apply_fun Even at *; simp_all +decide [ parity_simps ] ;

/-- The unit vector (1,0,0) is a valid photon direction: 1² + 0² + 0² = 1² -/

theorem unit_x_is_photonic : (1 : ℤ) ^ 2 + (0 : ℤ) ^ 2 + (0 : ℤ) ^ 2 = (1 : ℤ) ^ 2 := by
  norm_num

/-- The unit vector (0,1,0) is a valid photon direction -/

theorem unit_y_is_photonic : (0 : ℤ) ^ 2 + (1 : ℤ) ^ 2 + (0 : ℤ) ^ 2 = (1 : ℤ) ^ 2 := by
  norm_num

/-- The unit vector (0,0,1) is a valid photon direction -/

theorem unit_z_is_photonic : (0 : ℤ) ^ 2 + (0 : ℤ) ^ 2 + (1 : ℤ) ^ 2 = (1 : ℤ) ^ 2 := by
  norm_num

/-- The sublattice generated by Pythagorean quadruples in Z⁴ has index 2:
    all quadruples satisfy a+b+c+d ≡ 0 (mod 2), so the lattice they generate
    is contained in the even-sum sublattice. -/

theorem photon_sublattice_even (a b c d : ℤ)
    (h : a ^ 2 + b ^ 2 + c ^ 2 = d ^ 2) :
    ∃ k : ℤ, a + b + c + d = 2 * k := by
  obtain ⟨k, hk⟩ := photon_parity_constraint a b c d h
  exact ⟨k, by linarith⟩

/-- Specific quadruples generate: verify the four generators are valid -/

theorem quadruple_generators_check :
    (1 : ℤ)^2 + 0^2 + 0^2 = 1^2 ∧
    (0 : ℤ)^2 + 1^2 + 0^2 = 1^2 ∧
    (0 : ℤ)^2 + 0^2 + 1^2 = 1^2 ∧
    (1 : ℤ)^2 + 2^2 + 2^2 = 3^2 := by
  constructor <;> norm_num

/-! ## Section 2: Rational Points and Equidistribution Setup (Q2) -/

/-- A Pythagorean quadruple gives a rational point on S² -/

theorem rational_sphere_point (a b c d : ℤ) (hd : d ≠ 0)
    (h : a ^ 2 + b ^ 2 + c ^ 2 = d ^ 2) :
    ((a : ℚ) / d) ^ 2 + ((b : ℚ) / d) ^ 2 + ((c : ℚ) / d) ^ 2 = 1 := by
  have hd' : (d : ℚ) ≠ 0 := Int.cast_ne_zero.mpr hd
  field_simp
  exact_mod_cast h

/-- Inverse stereographic projection from Q² to S²(Q) lands on S² -/

theorem inv_stereo_rational (s t : ℚ) :
    let denom := 1 + s^2 + t^2
    let x := 2 * s / denom
    let y := 2 * t / denom
    let z := (s^2 + t^2 - 1) / denom
    x ^ 2 + y ^ 2 + z ^ 2 = 1 := by
  have h : (1 : ℚ) + s ^ 2 + t ^ 2 > 0 := by positivity
  have h' : (1 : ℚ) + s ^ 2 + t ^ 2 ≠ 0 := ne_of_gt h
  field_simp
  ring

/-- The denominator of inverse stereographic projection is always positive -/

def photonBasis (d : ℕ) : Finset (ℤ × ℤ × ℤ) :=
  (Finset.Icc (-d : ℤ) d ×ˢ Finset.Icc (-d : ℤ) d ×ˢ Finset.Icc (-d : ℤ) d).filter
    (fun t => t.1 ^ 2 + t.2.1 ^ 2 + t.2.2 ^ 2 = (d : ℤ) ^ 2)

/-- Every element of photonBasis satisfies the null cone equation -/

theorem photonBasis_valid (d : ℕ) (t : ℤ × ℤ × ℤ) (ht : t ∈ photonBasis d) :
    t.1 ^ 2 + t.2.1 ^ 2 + t.2.2 ^ 2 = (d : ℤ) ^ 2 := by
  simp [photonBasis, Finset.mem_filter] at ht
  exact ht.2

/-- The octahedral group acts on photon states: permuting (a,b,c) ↦ (b,a,c)
    preserves the null cone equation -/

theorem octahedral_perm_ab (a b c d : ℤ)
    (h : a ^ 2 + b ^ 2 + c ^ 2 = d ^ 2) :
    b ^ 2 + a ^ 2 + c ^ 2 = d ^ 2 := by linarith

/-- Sign change (a,b,c) ↦ (-a,b,c) preserves the null cone equation -/

theorem octahedral_neg_a (a b c d : ℤ)
    (h : a ^ 2 + b ^ 2 + c ^ 2 = d ^ 2) :
    (-a) ^ 2 + b ^ 2 + c ^ 2 = d ^ 2 := by ring_nf; linarith

/-- The expansion of (a+a')² + (b+b')² + (c+c')² for null vector sums -/

theorem null_sum_expansion (a b c d a' b' c' d' : ℤ)
    (h1 : a ^ 2 + b ^ 2 + c ^ 2 = d ^ 2)
    (h2 : a' ^ 2 + b' ^ 2 + c' ^ 2 = d' ^ 2) :
    (a + a') ^ 2 + (b + b') ^ 2 + (c + c') ^ 2 =
    d ^ 2 + d' ^ 2 + 2 * (a * a' + b * b' + c * c') := by
  nlinarith [sq_nonneg a, sq_nonneg b, sq_nonneg c,
             sq_nonneg a', sq_nonneg b', sq_nonneg c']

/-! ## Section 4: Spectral Invariants (Q4) -/

/-- The Lorentz form in various dimensions -/

def lorentzForm1 (a d : ℤ) : ℤ := a ^ 2 - d ^ 2

def lorentzForm2 (a b d : ℤ) : ℤ := a ^ 2 + b ^ 2 - d ^ 2

def lorentzForm3 (a b c d : ℤ) : ℤ := a ^ 2 + b ^ 2 + c ^ 2 - d ^ 2

/-- (1+1)D: the null cone is trivial (a = ±d) -/

theorem null_1d (a d : ℤ) : lorentzForm1 a d = 0 ↔ a = d ∨ a = -d := by
  simp only [lorentzForm1]
  constructor
  · intro h
    have : (a - d) * (a + d) = 0 := by ring_nf; linarith
    rcases mul_eq_zero.mp this with h1 | h1
    · left; linarith
    · right; linarith
  · rintro (rfl | rfl) <;> ring

/-- (2+1)D: the null cone equation is Pythagorean triples -/

theorem null_2d_is_triple (a b d : ℤ) :
    lorentzForm2 a b d = 0 ↔ a ^ 2 + b ^ 2 = d ^ 2 := by
  simp [lorentzForm2]; omega

/-- (3+1)D: the null cone equation is Pythagorean quadruples -/

theorem null_3d_is_quad (a b c d : ℤ) :
    lorentzForm3 a b c d = 0 ↔ a ^ 2 + b ^ 2 + c ^ 2 = d ^ 2 := by
  simp [lorentzForm3]; omega

/-
7 is NOT a sum of three squares (base case of Legendre's theorem)
-/

theorem seven_not_sum_three_squares :
    ¬ ∃ a b c : ℤ, a ^ 2 + b ^ 2 + c ^ 2 = 7 := by
  exact fun ⟨ a, b, c, h ⟩ => by have := ( show a ≤ 2 by nlinarith ) ; have := ( show a ≥ -2 by nlinarith ) ; have := ( show b ≤ 2 by nlinarith ) ; have := ( show b ≥ -2 by nlinarith ) ; have := ( show c ≤ 2 by nlinarith ) ; have := ( show c ≥ -2 by nlinarith ) ; interval_cases a <;> interval_cases b <;> interval_cases c <;> trivial;

/-
15 = 4·(8·0+7) is not a sum of three squares
-/

theorem fifteen_not_sum_three_squares :
    ¬ ∃ a b c : ℤ, a ^ 2 + b ^ 2 + c ^ 2 = 15 := by
  exact fun ⟨ a, b, c, h ⟩ => by have := ( show a ≤ 3 by nlinarith ) ; have := ( show a ≥ -3 by nlinarith ) ; have := ( show b ≤ 3 by nlinarith ) ; have := ( show b ≥ -3 by nlinarith ) ; have := ( show c ≤ 3 by nlinarith ) ; have := ( show c ≥ -3 by nlinarith ) ; interval_cases a <;> interval_cases b <;> interval_cases c <;> trivial;

/-! ## Section 5: The Dark Matter Ratio -/

/-- The Lorentz form is homogeneous of degree 2 -/

theorem lorentz_scale (a b c d k : ℤ) :
    lorentzForm3 (k*a) (k*b) (k*c) (k*d) = k^2 * lorentzForm3 a b c d := by
  simp [lorentzForm3]; ring

/-- Null vectors are closed under scaling -/

theorem null_spatial_zero (d : ℤ)
    (h : lorentzForm3 0 0 0 d = 0) : d = 0 := by
  simp [lorentzForm3] at h
  nlinarith [sq_nonneg d]

/-! ## Section 6: Dimensional Specialness of (3+1) -/

/-- In (1+1)D, null vectors are parametrized by 1 integer (a = d) -/

theorem dim_1_param (d : ℤ) : lorentzForm1 d d = 0 := by
  simp [lorentzForm1]

/-- In (2+1)D, null vectors are parametrized by 2 integers (Euclid's formula) -/

theorem dim_2_param (m n : ℤ) :
    lorentzForm2 (m^2 - n^2) (2*m*n) (m^2 + n^2) = 0 := by
  simp [lorentzForm2]; ring

/-- In (3+1)D, null vectors are parametrized by 4 integers (quaternion formula) -/

theorem dim_3_param (m n p q : ℤ) :
    lorentzForm3 (m^2+n^2-p^2-q^2) (2*(m*q+n*p)) (2*(n*q-m*p)) (m^2+n^2+p^2+q^2) = 0 := by
  simp [lorentzForm3]; ring

/-- The quaternion norm is multiplicative (Euler's identity restated) -/

theorem quat_norm_mult (a₁ b₁ c₁ d₁ a₂ b₂ c₂ d₂ : ℤ) :
    (a₁^2 + b₁^2 + c₁^2 + d₁^2) * (a₂^2 + b₂^2 + c₂^2 + d₂^2) =
    (a₁*a₂ - b₁*b₂ - c₁*c₂ - d₁*d₂)^2 +
    (a₁*b₂ + b₁*a₂ + c₁*d₂ - d₁*c₂)^2 +
    (a₁*c₂ - b₁*d₂ + c₁*a₂ + d₁*b₂)^2 +
    (a₁*d₂ + b₁*c₂ - c₁*b₂ + d₁*a₂)^2 := by ring

/-! ## Section 7: Composition Structure -/

/-- Two Minkowski-orthogonal null vectors sum to a null vector -/

theorem orthogonal_null_sum (a₁ b₁ c₁ d₁ a₂ b₂ c₂ d₂ : ℤ)
    (h₁ : a₁^2 + b₁^2 + c₁^2 = d₁^2)
    (h₂ : a₂^2 + b₂^2 + c₂^2 = d₂^2)
    (horth : a₁*a₂ + b₁*b₂ + c₁*c₂ = d₁*d₂) :
    (a₁+a₂)^2 + (b₁+b₂)^2 + (c₁+c₂)^2 = (d₁+d₂)^2 := by nlinarith

/-- Conversely, if two null vectors sum to null, they are Minkowski-orthogonal -/

theorem null_sum_implies_orthogonal (a₁ b₁ c₁ d₁ a₂ b₂ c₂ d₂ : ℤ)
    (h₁ : a₁^2 + b₁^2 + c₁^2 = d₁^2)
    (h₂ : a₂^2 + b₂^2 + c₂^2 = d₂^2)
    (hsum : (a₁+a₂)^2 + (b₁+b₂)^2 + (c₁+c₂)^2 = (d₁+d₂)^2) :
    a₁*a₂ + b₁*b₂ + c₁*c₂ = d₁*d₂ := by nlinarith

/-! ## Section 8: Photon Speed and Causality -/

/-- An arithmetic photon travels at speed 1 (in rational units) -/

theorem photon_speed (a b c d : ℤ) (hd : d ≠ 0)
    (h : a^2 + b^2 + c^2 = d^2) :
    ((a : ℚ) / d) ^ 2 + ((b : ℚ) / d) ^ 2 + ((c : ℚ) / d) ^ 2 = 1 := by
  have hd' : (d : ℚ) ≠ 0 := Int.cast_ne_zero.mpr hd
  field_simp
  exact_mod_cast h

/-- Timelike vectors have spatial speed < 1 -/

theorem timelike_subluminal (a b c d : ℤ) (hd : (0 : ℤ) < d)
    (h : a^2 + b^2 + c^2 < d^2) :
    ((a : ℚ) / d) ^ 2 + ((b : ℚ) / d) ^ 2 + ((c : ℚ) / d) ^ 2 < 1 := by
  have hd' : (0 : ℚ) < (d : ℚ) := Int.cast_pos.mpr hd
  have hd'' : (d : ℚ) ≠ 0 := ne_of_gt hd'
  rw [div_pow, div_pow, div_pow, ← add_div, ← add_div, div_lt_one (by positivity)]
  exact_mod_cast h

