import Mathlib

/-! # Noise-Stable Prime Spectrum in Definable Quantum Walks on Arithmetic Cayley Graphs

This file develops a small but self-contained bridge between three catalog themes:

* the *Fibonacci primitive-divisor / Carmichael* arc (`Shared.CarmichaelProof`,
  `Speculative.AutoResearch.CarmichaelHelper`), which is governed by the Fibonacci
  entry-point structure and the strong divisibility law `Nat.fib_gcd`;
* discrete-time **quantum walks** on the arithmetic Cayley graphs
  `G_n = Cay(ℤ/nℤ, Sₙ)`, modelled here by the single-step shift operator
  `T_s : (ℤ/nℤ → ℂ) → (ℤ/nℤ → ℂ)`, `T_s f = f(· + s)`; and
* the **additive-order spectrum** `{ addOrderOf s : s ∈ ℤ/nℤ }`, which we show
  *collapses* (every nonzero step has full order `n`) **iff `n` is prime**.

The unifying conceptual statement is: *the Cayley walk generated by a single step
`s` is "fully mixing" — its orbit is the whole vertex set — for every nonzero `s`
exactly when the modulus is prime.*  This is the discrete-walk analogue of the
"noise-stable prime spectrum" conjecture: the order spectrum is stable (no
intermediate orders) precisely in the prime regime.  We then bridge to Fibonacci:
any Fibonacci step `F(k)` not killed mod `p` (i.e. `p ∤ F(k)`) generates the whole
prime cycle, linking the Carmichael entry-point picture to walk mixing.

-- !-- Lab Notebook -- !--
Hypothesis : The additive-order spectrum of `ℤ/nℤ` collapses to the two-point set
  `{1, n}` (equivalently every nonzero step generates the full cycle) iff `n` is
  prime; and the single-step Cayley walk is always an isometry (unitary) of the
  finite ℓ² space, independent of arithmetic.
Result     : Confirmed and proved `sorry`-free.  `prime_step_generates` and its
  converse `step_generates_imp_prime` combine into the bridge biconditional
  `prime_iff_all_steps_generate`.  `walk_isometry` gives unitarity of `T_s`, and
  `walk_period` gives `T_s^{addOrderOf s} = id`.  `fib_step_generates` bridges to
  the Fibonacci/Carmichael arc.
Insight    : The order-collapse phenomenon is exactly Lagrange/`addOrderOf_dvd_card`
  on `ℤ/pℤ`: primality is the statement that the cyclic additive group has *no*
  proper nontrivial subgroups, so every nonzero generator is full.  The walk's
  unitarity is the orthogonality of the translation `Equiv.addRight s`, a fact with
  no number-theoretic content — the arithmetic lives entirely in the *spectrum*.
Failure analysis : `addOrderOf_eq_one_iff` is not available under that name in this
  Mathlib; the robust route to "order 1 ⇒ element is 0" is
  `addOrderOf_nsmul_eq_zero` specialised at the order, i.e. `1 • s = 0`.
-- !--
-/

namespace NoiseStablePrimeSpectrum

open Finset

/-! ## The additive-order spectrum and primality -/

-- !-- Order divides `p`; primality forces it to be `1` or `p`, and `s ≠ 0` rules out `1`. -- !--
/-- **Prime ⇒ full mixing.**  In `ℤ/pℤ` with `p` prime, every nonzero step `s`
generates the entire cycle: its additive order is `p`. -/
theorem prime_step_generates (p : ℕ) [Fact p.Prime] (s : ZMod p) (hs : s ≠ 0) :
    addOrderOf s = p := by
  have hdvd : addOrderOf s ∣ p := by
    have := addOrderOf_dvd_card (x := s); rwa [ZMod.card] at this
  rcases (Fact.out : p.Prime).eq_one_or_self_of_dvd _ hdvd with h | h
  · exfalso; apply hs
    have h2 : (1 : ℕ) • s = 0 := addOrderOf_nsmul_eq_zero s ▸ by rw [h]
    simpa using h2
  · exact h

-- !-- A proper divisor `m ∣ n` gives a step of order `n/m < n`, contradicting full mixing. -- !--
/-- **Full mixing ⇒ prime.**  If `n ≥ 2` and *every* nonzero step of `ℤ/nℤ` has
full additive order `n`, then `n` is prime. -/
theorem step_generates_imp_prime (n : ℕ) (hn : 2 ≤ n)
    (H : ∀ s : ZMod n, s ≠ 0 → addOrderOf s = n) : n.Prime := by
  have hne : n ≠ 0 := by omega
  have : NeZero n := ⟨hne⟩
  rw [Nat.prime_def_lt]
  refine ⟨hn, ?_⟩
  intro m hmn hmdvd
  by_contra hm1
  have hm0 : m ≠ 0 := by rintro rfl; simp at hmdvd; omega
  have hm_ge2 : 2 ≤ m := by
    rcases Nat.lt_or_ge m 2 with h | h
    · interval_cases m <;> simp_all
    · exact h
  have hord : addOrderOf (m : ZMod n) = n / n.gcd m := ZMod.addOrderOf_coe m hne
  have hgcd : n.gcd m = m := Nat.gcd_eq_right hmdvd
  rw [hgcd] at hord
  have hsne : (m : ZMod n) ≠ 0 := by
    rw [Ne, ZMod.natCast_eq_zero_iff]
    intro hdvd2
    exact absurd (Nat.le_of_dvd (by omega) hdvd2) (by omega)
  have hH := H _ hsne
  rw [hord] at hH
  exact absurd hH (by have := Nat.div_lt_self (show 0 < n by omega) hm_ge2; omega)

-- !-- Two-direction bridge: order-spectrum collapse `⟺` primality. -- !--
/-- **The bridge biconditional.**  For `n ≥ 2`, the modulus is prime iff the Cayley
walk generated by *any* nonzero step is fully mixing (full additive order). -/
theorem prime_iff_all_steps_generate (n : ℕ) (hn : 2 ≤ n) :
    n.Prime ↔ ∀ s : ZMod n, s ≠ 0 → addOrderOf s = n := by
  constructor
  · intro hp s hs
    have : Fact n.Prime := ⟨hp⟩
    exact prime_step_generates n s hs
  · exact step_generates_imp_prime n hn

/-! ## The single-step quantum walk operator -/

/-- The one-step Cayley walk (shift) operator on amplitudes `ℤ/nℤ → ℂ`:
`T_s f = f(· + s)`.  This is the deterministic discrete-time walk by step `s`. -/
def walk (n : ℕ) (s : ZMod n) (f : ZMod n → ℂ) : ZMod n → ℂ := fun x => f (x + s)

-- !-- Translation by `s` is a bijection of `ℤ/nℤ`, so it permutes the ℓ²-sum. -- !--
/-- **Unitarity / isometry of the walk.**  The single-step walk preserves the
finite ℓ² norm of the amplitude vector: `∑ ‖(T_s f)(x)‖² = ∑ ‖f(x)‖²`.  In quantum
terms, the walk conserves total probability. -/
theorem walk_isometry (n : ℕ) [NeZero n] (s : ZMod n) (f : ZMod n → ℂ) :
    ∑ x : ZMod n, ‖walk n s f x‖ ^ 2 = ∑ x : ZMod n, ‖f x‖ ^ 2 :=
  Fintype.sum_equiv (Equiv.addRight s) _ _ (fun _ => rfl)

-- !-- `T_s^k x = x + k • s`; at `k = addOrderOf s` the increment vanishes. -- !--
/-- **Walk period.**  Iterating the single-step walk `addOrderOf s` times returns
every vertex to itself: the orbit closes at exactly the additive order of the step.
Combined with `prime_step_generates`, on `ℤ/pℤ` the period is the full `p`. -/
theorem walk_period (n : ℕ) [NeZero n] (s : ZMod n) (x : ZMod n) :
    (fun y => y + s)^[addOrderOf s] x = x := by
  have key : (fun y => y + s)^[addOrderOf s] x = x + (addOrderOf s) • s := by
    induction (addOrderOf s) generalizing x with
    | zero => simp
    | succ k ih =>
      rw [Function.iterate_succ', Function.comp_apply, ih, succ_nsmul]; ring
  rw [key, addOrderOf_nsmul_eq_zero]; simp

/-! ## Bridge to the Fibonacci / Carmichael arc -/

-- !-- `F(k) ≠ 0 mod p ⟺ p ∤ F(k)`; then apply `prime_step_generates`. -- !--
/-- **Fibonacci step mixing.**  For a prime `p` and an index `k` with `p ∤ F(k)`
(i.e. `k` lies below the Fibonacci entry point of `p`, the Carmichael
"primitivity" regime), the Cayley walk on `ℤ/pℤ` with the Fibonacci step `F(k)` is
fully mixing.  This links the Fibonacci entry-point structure of
`Speculative.AutoResearch.CarmichaelHelper` to walk ergodicity. -/
theorem fib_step_generates (p : ℕ) [Fact p.Prime] (k : ℕ) (hk : ¬ p ∣ Nat.fib k) :
    addOrderOf ((Nat.fib k : ZMod p)) = p := by
  refine prime_step_generates p _ ?_
  rw [Ne, ZMod.natCast_eq_zero_iff]; exact hk

end NoiseStablePrimeSpectrum
