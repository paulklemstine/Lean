\title{The Markov Basis of the Two-Way Independence Model:\\
A Self-Contained Distance-Reduction Proof of Fiber Connectivity}
\author{Aristotle (Harmonic)}
\date{2026-06-15}

\begin{document}
\maketitle

\begin{abstract}
We give a complete, elementary, and constructive proof that the family of basic
$2\times 2$ swap moves forms a Markov basis for the two-way independence model on
integer contingency tables. Concretely, we show that any two non-negative integer
$m\times n$ tables with identical row and column margins are connected by a finite
walk of $2\times 2$ swaps that remains non-negative at every step. This is the
independence-model instance of the Fundamental Theorem of Markov Bases of
Diaconis and Sturmfels. Our argument is organized around an integer-valued
potential function---the $\ell^1$ distance between tables---and a three-stage
pigeonhole lemma that, for any non-target table, locates a $2\times 2$
configuration whose swap strictly decreases the potential while preserving
non-negativity. We also establish reversibility of the step relation, so that
fibers are precisely the equivalence classes of the connectivity relation. All
results have been formalized and machine-checked. The development is deliberately
minimal in its dependencies, making it a clean foundation for the
algebraic-statistics theory of log-linear models and for the design of provably
irreducible Markov chain Monte Carlo samplers on contingency tables.
\end{abstract}

\noindent\textbf{Keywords.} Markov basis, algebraic statistics, contingency
table, independence model, Diaconis--Sturmfels theorem, MCMC, toric ideal, fiber
connectivity, potential function, distance reduction.

\section{Introduction}

\subsection{Motivation}
A \emph{two-way contingency table} is a rectangular array of non-negative integer
counts cross-classifying a sample of individuals by two categorical variables.
Testing whether the two variables are independent leads, via exact conditional
inference, to the problem of sampling from the set of all tables sharing the
observed row and column totals. This set, the \emph{fiber} of the table under the
margin map, is generally too large to enumerate, so one resorts to Markov chain
Monte Carlo: a random walk proposing small, margin-preserving perturbations.

For such a walk to yield valid inference it must be \emph{irreducible} on the
fiber: every table must be reachable from every other using only the allowed
moves and without leaving the non-negative orthant. The set of moves guaranteeing
this is a \emph{Markov basis}. The theorem of Diaconis and Sturmfels (1998)
identifies Markov bases with generating sets of an associated toric ideal,
founding the field of algebraic statistics.

\subsection{Contribution}
We isolate the simplest and most important instance---the independence model---and
give a fully elementary, constructive, and formally verified proof that the basic
$2\times 2$ swap moves form a Markov basis. The contribution is the packaging: a
self-contained distance-reduction argument that (i) depends on no
algebraic-geometry machinery, only finite sums and a potential function; (ii) is
constructive, yielding an explicit greedy algorithm; and (iii) is verified
end-to-end.

\section{Definitions and Notation}
Throughout, fix natural numbers $m,n$. Rows are indexed by $\{0,\dots,m-1\}$ and
columns by $\{0,\dots,n-1\}$. We write $\sum_i$ and $\sum_j$ for sums over all
rows and columns.

\begin{definition}[Table]
An $m\times n$ \emph{integer contingency table} is a function
$u:\{0,\dots,m-1\}\times\{0,\dots,n-1\}\to\mathbb{Z}$; we write $u_{ij}$ for its
entry in row $i$, column $j$.
\end{definition}

\begin{definition}[Margins]
The \emph{row margin} at row $i$ and \emph{column margin} at column $j$ are
\[
\rowsum(u)_i=\sum_j u_{ij},\qquad \colsum(u)_j=\sum_i u_{ij}.
\]
\end{definition}

\begin{definition}[Same margins]
Tables $u,v$ \emph{have the same margins}, written $\SameMargins(u,v)$, iff
$\rowsum(u)_i=\rowsum(v)_i$ for all $i$ and $\colsum(u)_j=\colsum(v)_j$ for all
$j$.
\end{definition}

\begin{definition}[Non-negativity and fibers]
$u$ is \emph{non-negative}, $\Nonneg(u)$, iff $u_{ij}\ge 0$ for all $i,j$. A
\emph{fiber} is a maximal set of non-negative tables with a common collection of
margins.
\end{definition}

\begin{definition}[Basic $2\times 2$ move]
For rows $i,i'$ and columns $j,j'$ the \emph{basic move} is
\[
\Bmove(i,i',j,j')_{ab}=\1{a{=}i\wedge b{=}j'}+\1{a{=}i'\wedge b{=}j}
-\1{a{=}i\wedge b{=}j}-\1{a{=}i'\wedge b{=}j'},
\]
where $\1{\cdot}$ is the indicator. Equivalently, with $e_{ab}$ the unit table,
$\Bmove(i,i',j,j')=e_{ij'}+e_{i'j}-e_{ij}-e_{i'j'}$. When $i\ne i'$ and $j\ne j'$
these four cells are distinct.
\end{definition}

\begin{definition}[Legal step]
$\Step(u,v)$ holds iff $u,v$ are both non-negative and there exist $i\ne i'$,
$j\ne j'$ with $v=u+\Bmove(i,i',j,j')$.
\end{definition}

\begin{definition}[Connectivity]
$\Connected(u,v)$ is the reflexive--transitive closure of $\Step$: a finite walk
of legal steps from $u$ to $v$.
\end{definition}

\begin{definition}[$\ell^1$ potential]
$D(u,v)=\sum_{(a,b)} |u_{ab}-v_{ab}|\in\mathbb{N}$, the total number of unit
cell-discrepancies.
\end{definition}

\section{Margin Invariance}
\begin{theorem}[Margin invariance]\label{thm:margins}
For any table $u$, rows $i\ne i'$, and columns $j\ne j'$,
$\SameMargins\big(u,\;u+\Bmove(i,i',j,j')\big)$.
\end{theorem}
\begin{proof}
By additivity of sums, $\rowsum(u+\Bmove)_a=\rowsum(u)_a+\rowsum(\Bmove)_a$ and
similarly for columns; it suffices to show every margin of $\Bmove$ vanishes. Fix
row $a$. The only nonzero columns of $\Bmove(a,\cdot)$ are $j,j'$. If $a=i$ the
contributions are $+1$ (at $j'$) and $-1$ (at $j$); if $a=i'$ they are $+1$ (at
$j$) and $-1$ (at $j'$); otherwise they are $0$. In all cases $\rowsum(\Bmove)_a=0$.
Symmetrically (using $i\ne i'$), $\colsum(\Bmove)_b=0$ for all $b$.
\end{proof}

\section{Faithfulness of the Potential}
\begin{theorem}[Faithfulness]\label{thm:faithful}
$D(u,v)=0$ if and only if $u=v$.
\end{theorem}
\begin{proof}
$D(u,v)$ is a finite sum of natural numbers $|u_{ab}-v_{ab}|$; it is zero iff
every summand is zero, i.e.\ iff $u_{ab}=v_{ab}$ for all cells, i.e.\ $u=v$.
\end{proof}
\begin{remark}
Since $D$ is $\mathbb{N}$-valued, it is a well-founded potential: any strictly
decreasing sequence of $D$-values terminates.
\end{remark}

\section{The Sign-Pattern Pigeonhole}
\begin{theorem}[Sign-pattern pigeonhole]\label{thm:pigeon}
If $\SameMargins(u,v)$ and $u\ne v$, then there exist $i\ne i'$ and $j\ne j'$ with
\[
v_{ij}<u_{ij},\qquad u_{ij'}<v_{ij'},\qquad v_{i'j'}<u_{i'j'}.
\]
\end{theorem}
\begin{proof}
Let $d_{ab}=u_{ab}-v_{ab}$. Equal margins give $\sum_b d_{ab}=0$ for each row and
$\sum_a d_{ab}=0$ for each column, hence grand total $0$.

\emph{Stage 1.} Since $u\ne v$, some $d_{ab}\ne 0$. If all entries were $\le 0$,
the grand total being $0$ would force all entries to be $0$, a contradiction.
Hence some $(i,j)$ has $d_{ij}>0$, i.e.\ $v_{ij}<u_{ij}$.

\emph{Stage 2.} Row $i$ sums to $0$ and contains the positive term $d_{ij}>0$, so
some $j'$ has $d_{ij'}<0$, i.e.\ $u_{ij'}<v_{ij'}$; and $j'\ne j$ since one cell
cannot be both positive and negative.

\emph{Stage 3.} Column $j'$ sums to $0$ and contains the negative term
$d_{ij'}<0$, so some $i'$ has $d_{i'j'}>0$, i.e.\ $v_{i'j'}<u_{i'j'}$; and
$i'\ne i$.
\end{proof}

\section{Distance Decrease and Single-Step Existence}
\begin{theorem}[Distance decrease]\label{thm:decrease}
If $i\ne i'$, $j\ne j'$, and $v_{ij}<u_{ij}$, $u_{ij'}<v_{ij'}$,
$v_{i'j'}<u_{i'j'}$, then
$D\big(u+\Bmove(i,i',j,j'),\,v\big)<D(u,v)$.
\end{theorem}
\begin{proof}
The move is supported on the four distinct cells $(i,j),(i,j'),(i',j),(i',j')$;
off this frame $u+\Bmove=u$ and those terms cancel between the two distances. On
the frame: at $(i,j)$ the move is $-1$ and $v_{ij}<u_{ij}$, dropping the
discrepancy by $1$; at $(i,j')$ the move is $+1$ and $u_{ij'}<v_{ij'}$, dropping
by $1$; at $(i',j')$ the move is $-1$ and $v_{i'j'}<u_{i'j'}$, dropping by $1$; at
$(i',j)$ the move is $+1$, changing the discrepancy by at most $+1$. The net
change is at most $-2<0$.
\end{proof}

\begin{theorem}[Single legal step exists]\label{thm:step}
If $\Nonneg(u)$, $\Nonneg(v)$, $\SameMargins(u,v)$, and $u\ne v$, then there is
$u'$ with $\Step(u,u')$ and $D(u',v)<D(u,v)$.
\end{theorem}
\begin{proof}
Apply Theorem~\ref{thm:pigeon} to get $i\ne i'$, $j\ne j'$ with the stated sign
pattern, and set $u'=u+\Bmove(i,i',j,j')$. Theorem~\ref{thm:decrease} gives
$D(u',v)<D(u,v)$. For $\Nonneg(u')$: the move alters only four cells; the
overshoot cells $(i,j),(i',j')$ satisfy $u>v\ge 0$, so subtracting $1$ leaves a
value $\ge v\ge 0$; the cells $(i,j'),(i',j)$ only increase. Thus $u'$ is
non-negative and $\Step(u,u')$ holds.
\end{proof}

\section{The Connectivity Theorem}
\begin{theorem}[Bounded connectivity]\label{thm:bounded}
For every $N\in\mathbb{N}$ and tables $u,v$: if $D(u,v)\le N$, $\Nonneg(u)$,
$\Nonneg(v)$, and $\SameMargins(u,v)$, then $\Connected(u,v)$.
\end{theorem}
\begin{proof}
Strong induction on $N$. If $u=v$, use reflexivity. Otherwise
Theorem~\ref{thm:step} yields $u'=u+\Bmove(i,i',j,j')$ with $\Step(u,u')$ and
$D(u',v)<D(u,v)$. By Theorem~\ref{thm:margins}, $\SameMargins(u',v)$, and $u'$ is
non-negative. Since $D(u',v)<D(u,v)\le N$, the induction hypothesis gives
$\Connected(u',v)$; prepending the step $\Step(u,u')$ gives $\Connected(u,v)$.
\end{proof}

\begin{theorem}[Fundamental Theorem of Markov Bases, independence model]
\label{thm:main}
For all tables $u,v$ with $\Nonneg(u)$, $\Nonneg(v)$, and $\SameMargins(u,v)$, we
have $\Connected(u,v)$. Equivalently, the basic $2\times 2$ swaps connect every
fiber; they form a Markov basis for the two-way independence model.
\end{theorem}
\begin{proof}
Instantiate Theorem~\ref{thm:bounded} with $N=D(u,v)$.
\end{proof}

\section{Reversibility and the Fiber Equivalence}
\begin{theorem}[Step symmetry]\label{thm:symm}
If $\Step(u,v)$ then $\Step(v,u)$.
\end{theorem}
\begin{proof}
If $v=u+\Bmove(i,i',j,j')$ with both endpoints non-negative, then swapping the two
rows negates the move, $\Bmove(i',i,j,j')=-\Bmove(i,i',j,j')$, so
$u=v+\Bmove(i',i,j,j')$ with $i'\ne i$, $j\ne j'$. The non-negativity
certificates carry over, giving $\Step(v,u)$.
\end{proof}

\begin{theorem}[Fibers are equivalence classes]\label{thm:equiv}
$\Connected$ is an equivalence relation; its classes are exactly the fibers of the
independence model.
\end{theorem}
\begin{proof}
$\Connected$ is reflexive and transitive by construction. Symmetry follows by
reversing each step of a walk via Theorem~\ref{thm:symm} and folding in opposite
order. By Theorems~\ref{thm:margins} and~\ref{thm:main}, two non-negative tables
are connected iff they share all margins, so the classes are the fibers.
\end{proof}

\section{Algorithm and Complexity}
The proofs are constructive and give a greedy connection algorithm.

\begin{verbatim}
GreedyConnect(u, v):
    path <- [u]
    while u != v:
        d <- u - v
        (i, j)   <- any cell with d[i][j] > 0      # Stage 1
        (i, j')  <- any column with d[i][j'] < 0    # Stage 2
        (i', j') <- any row with d[i'][j'] > 0      # Stage 3
        u <- u + B(i, i', j, j')
        append u to path
    return path
\end{verbatim}

Each iteration decreases $D(u,v)$ by at least $2$ (Theorem~\ref{thm:decrease}), so
the walk has at most $D(u,v)/1$ moves, bounded by the total count; each step costs
$O(mn)$ to scan the difference, for total time $O(mn\cdot D(u,v))$ and $O(mn)$
working memory. For MCMC one instead proposes uniformly random legal $2\times 2$
moves; Theorem~\ref{thm:main} guarantees irreducibility and
Theorem~\ref{thm:symm} reversibility, the two hypotheses needed for convergence.

\section{Applications}
\begin{itemize}[nosep]
\item Exact conditional tests of independence (Fisher's exact test and
generalizations): Theorem~\ref{thm:main} is the irreducibility certificate.
\item Statistical disclosure limitation: the fiber is the set of tables consistent
with released margins.
\item Goodness-of-fit for log-linear models: the independence model is the base
case of a hierarchy.
\item Combinatorics of transportation polytopes: fibers are lattice points and the
swap is the lattice edge move.
\end{itemize}

\section{Discussion and Future Directions}
The proof avoids toric-ideal and Gr\"obner-basis machinery, relying on a single
integer potential and a pigeonhole, making it a dependable reusable nucleus.
Future directions: (1) quantitative mixing-time bounds for the $2\times 2$-swap
chain; (2) extension of the distance-reduction template to multi-way and
hierarchical log-linear models; (3) sharper per-step decrease and fiber-diameter
bounds; (4) a direct bridge proving the $2\times 2$ moves generate the toric ideal
of the independence model; (5) constrained and bounded fibers with capacities or
structural zeros.

