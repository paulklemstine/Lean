import Mathlib

/-!
# Linear-algebraic skeleton of Spectral Gap Rigidity for Hodge Laplacians

This file isolates the *exact*, finite, sorry-free core of the conjecture
*Spectral Gap Rigidity for Hypergraph Hodge Laplacians Under Simplicial
Coarse-Graining*.

We work with a length-three real cochain complex of finite-dimensional inner
product spaces

  `E₀ --e--> E₁ --d--> E₂`

and study the **Hodge Laplacian** on the middle degree

  `Δ = dᵀ ∘ d + e ∘ eᵀ : E₁ →ₗ E₁`,

where `eᵀ = LinearMap.adjoint e` and `dᵀ = LinearMap.adjoint d`.  Over `ℝ`
the Hodge theorem holds unconditionally — there is no torsion term — so the
multiplicity of the bottom eigenvalue `0` (the harmonic dimension) is a
topological invariant (the real Betti number) and is rigid under any isometric
coarse-graining.

## Main results

* `hodge_inner_self` : the energy identity `⟪Δ x, x⟫ = ‖d x‖² + ‖eᵀ x‖²`.
* `hodge_nonneg` : `Δ` is positive semidefinite.
* `ker_adjoint_eq_orthogonal` : `ker eᵀ = (range e)ᗮ`.
* `ker_hodge` : `ker Δ = ker d ⊓ ker eᵀ` (harmonic = closed ∩ co-closed).
* `harmonic_inf_range` / `harmonic_sup_range` : the orthogonal Hodge
  decomposition `ker d = (range e) ⊕ (ker Δ)`.
* `betti_eq_harmonic_finrank` : the discrete Hodge theorem
  `dim ker Δ + dim range e = dim ker d`.
* `hodge_coarse_grain` : Laplacian covariance `Δ' = U Δ U⁻¹`.
* `finrank_ker_conj` : kernel dimension is conjugation-invariant.
* `harmonic_finrank_rigidity` : `dim ker Δ' = dim ker Δ`.

-- !-- Lab Notebook -- !--
Hypothesis: The "spectral gap rigidity" conjecture's hard analytic content
  (renormalization, asymptotics) sits on top of a finite, exact linear-algebra
  core; that core should be sorry-free over `ℝ` because the real Hodge theorem
  carries no torsion.
Result: All ten theorems below are proved sorry-free; harmonic dimension equals
  the real Betti number and is preserved by an isometric coarse-graining.
Insight: The single decisive equation is the energy identity
  `⟪Δ x, x⟫ = ‖d x‖² + ‖eᵀ x‖²`.  It gives positive semidefiniteness for free,
  identifies the kernel with `ker d ⊓ ker eᵀ` *without* invoking self-adjoint
  spectral theory, and reduces rigidity to the conjugation invariance of a
  kernel dimension.  Covariance `Δ' = U Δ U⁻¹` then follows from
  `adjoint U⁻¹ = U` for an isometry, with no neighbouring isometries needed:
  coarse-graining only the middle degree (`d' = d ∘ U⁻¹`, `e' = U ∘ e`) already
  conjugates `Δ`.
Failure analysis: Early attempts chained `adjoint_inner_left` and
  `adjoint_inner_right` in a single `rw`, which mis-targeted the first summand;
  splitting the energy identity into two oriented `have`s fixed it.  The kernel
  conjugation lemma is cleanest via `Submodule.map U` + `LinearEquiv.finrank_map_eq`
  rather than rank–nullity bookkeeping.
-/

open scoped InnerProductSpace
open Module (finrank)

namespace HodgeSpectralRigidity

variable {E₀ E₁ E₂ E₁' : Type*}
  [NormedAddCommGroup E₀] [InnerProductSpace ℝ E₀] [FiniteDimensional ℝ E₀]
  [NormedAddCommGroup E₁] [InnerProductSpace ℝ E₁] [FiniteDimensional ℝ E₁]
  [NormedAddCommGroup E₂] [InnerProductSpace ℝ E₂] [FiniteDimensional ℝ E₂]
  [NormedAddCommGroup E₁'] [InnerProductSpace ℝ E₁'] [FiniteDimensional ℝ E₁']

/-- The Hodge Laplacian on the middle degree of the cochain complex
`E₀ --e--> E₁ --d--> E₂`, namely `Δ = dᵀ d + e eᵀ`. -/
noncomputable def hodgeLap (d : E₁ →ₗ[ℝ] E₂) (e : E₀ →ₗ[ℝ] E₁) : E₁ →ₗ[ℝ] E₁ :=
  LinearMap.adjoint d ∘ₗ d + e ∘ₗ LinearMap.adjoint e

-- !-- Hodge energy identity: pairing `Δ x` with `x` splits into the squared
-- norms of the up-coboundary `d x` and the down-co-coboundary `eᵀ x`. -- !--
/-- **Hodge energy identity**: `⟪Δ x, x⟫ = ‖d x‖² + ‖eᵀ x‖²`. -/
theorem hodge_inner_self (d : E₁ →ₗ[ℝ] E₂) (e : E₀ →ₗ[ℝ] E₁) (x : E₁) :
    ⟪hodgeLap d e x, x⟫_ℝ = ‖d x‖ ^ 2 + ‖LinearMap.adjoint e x‖ ^ 2 := by
  have h1 : ⟪LinearMap.adjoint d (d x), x⟫_ℝ = ‖d x‖ ^ 2 := by
    rw [LinearMap.adjoint_inner_left, real_inner_self_eq_norm_sq]
  have h2 : ⟪e (LinearMap.adjoint e x), x⟫_ℝ = ‖LinearMap.adjoint e x‖ ^ 2 := by
    rw [← LinearMap.adjoint_inner_right, real_inner_self_eq_norm_sq]
  simp only [hodgeLap, LinearMap.add_apply, LinearMap.comp_apply, inner_add_left, h1, h2]

-- !-- Positive semidefiniteness is immediate from the energy identity, since a
-- sum of squared norms is nonnegative. -- !--
/-- The Hodge Laplacian is positive semidefinite. -/
theorem hodge_nonneg (d : E₁ →ₗ[ℝ] E₂) (e : E₀ →ₗ[ℝ] E₁) (x : E₁) :
    0 ≤ ⟪hodgeLap d e x, x⟫_ℝ := by
  rw [hodge_inner_self]; positivity

-- !-- `ker eᵀ = (range e)ᗮ`: `y ⟂ range e` iff `⟪e z, y⟫ = ⟪z, eᵀ y⟫ = 0` for all
-- `z`, which pins down `eᵀ y = 0`. -- !--
/-- The kernel of the adjoint is the orthogonal complement of the range. -/
theorem ker_adjoint_eq_orthogonal (e : E₀ →ₗ[ℝ] E₁) :
    LinearMap.ker (LinearMap.adjoint e) = (LinearMap.range e)ᗮ := by
  ext y
  simp only [LinearMap.mem_ker, Submodule.mem_orthogonal, LinearMap.mem_range]
  constructor
  · rintro h x ⟨z, rfl⟩
    rw [← LinearMap.adjoint_inner_right, h, inner_zero_right]
  · intro h
    rw [← @inner_self_eq_zero ℝ]
    have := h (e (LinearMap.adjoint e y)) ⟨_, rfl⟩
    rw [← LinearMap.adjoint_inner_right] at this
    rw [real_inner_comm]; exact this

-- !-- Harmonic = closed ∩ co-closed: `Δ x = 0 ⇒ ⟪Δ x, x⟫ = 0`, and the energy
-- identity forces both `‖d x‖` and `‖eᵀ x‖` to vanish; conversely both vanishing
-- makes `Δ x = 0`. -- !--
/-- **Harmonic = closed ∩ co-closed**: `ker Δ = ker d ⊓ ker eᵀ`. -/
theorem ker_hodge (d : E₁ →ₗ[ℝ] E₂) (e : E₀ →ₗ[ℝ] E₁) :
    LinearMap.ker (hodgeLap d e) = LinearMap.ker d ⊓ LinearMap.ker (LinearMap.adjoint e) := by
  ext x
  simp only [Submodule.mem_inf, LinearMap.mem_ker]
  constructor
  · intro hx
    have h0 : ⟪hodgeLap d e x, x⟫_ℝ = 0 := by rw [hx, inner_zero_left]
    rw [hodge_inner_self] at h0
    have hdx : ‖d x‖ = 0 := by
      nlinarith [norm_nonneg (d x), norm_nonneg (LinearMap.adjoint e x),
        sq_nonneg ‖d x‖, sq_nonneg ‖LinearMap.adjoint e x‖]
    have hex : ‖LinearMap.adjoint e x‖ = 0 := by
      nlinarith [norm_nonneg (d x), norm_nonneg (LinearMap.adjoint e x),
        sq_nonneg ‖d x‖, sq_nonneg ‖LinearMap.adjoint e x‖]
    exact ⟨norm_eq_zero.mp hdx, norm_eq_zero.mp hex⟩
  · rintro ⟨hd, he⟩
    simp only [hodgeLap, LinearMap.add_apply, LinearMap.comp_apply, hd, he, map_zero, add_zero]

-- !-- Orthogonality half of the Hodge decomposition: `ker Δ ⊆ (range e)ᗮ`, so its
-- intersection with `range e` lies in `K ⊓ Kᗮ = ⊥`. -- !--
/-- The harmonic space meets `range e` only in `0`. -/
theorem harmonic_inf_range (d : E₁ →ₗ[ℝ] E₂) (e : E₀ →ₗ[ℝ] E₁) :
    LinearMap.ker (hodgeLap d e) ⊓ LinearMap.range e = ⊥ := by
  rw [ker_hodge, ker_adjoint_eq_orthogonal, inf_assoc, inf_comm (LinearMap.range e)ᗮ,
      Submodule.inf_orthogonal_eq_bot, inf_bot_eq]

-- !-- Spanning half: with the cochain condition `d ∘ e = 0` we have
-- `range e ≤ ker d`, and the modular law gives
-- `range e ⊔ (ker d ⊓ (range e)ᗮ) = (range e ⊔ (range e)ᗮ) ⊓ ker d = ker d`. -- !--
/-- The harmonic space together with `range e` spans `ker d`. -/
theorem harmonic_sup_range (d : E₁ →ₗ[ℝ] E₂) (e : E₀ →ₗ[ℝ] E₁) (hde : d ∘ₗ e = 0) :
    LinearMap.ker (hodgeLap d e) ⊔ LinearMap.range e = LinearMap.ker d := by
  rw [ker_hodge, ker_adjoint_eq_orthogonal]
  have hle : LinearMap.range e ≤ LinearMap.ker d := LinearMap.range_le_ker_iff.mpr hde
  rw [sup_comm, inf_comm (LinearMap.ker d) (LinearMap.range e)ᗮ,
      ← sup_inf_assoc_of_le _ hle, Submodule.sup_orthogonal_of_hasOrthogonalProjection,
      top_inf_eq]

-- !-- Discrete Hodge theorem: feed the two decomposition halves into the
-- dimension formula `dim(A ⊔ B) + dim(A ⊓ B) = dim A + dim B`. -- !--
/-- **Discrete Hodge theorem** / Betti identity:
`dim ker Δ + dim range e = dim ker d`. -/
theorem betti_eq_harmonic_finrank (d : E₁ →ₗ[ℝ] E₂) (e : E₀ →ₗ[ℝ] E₁) (hde : d ∘ₗ e = 0) :
    finrank ℝ (LinearMap.ker (hodgeLap d e)) + finrank ℝ (LinearMap.range e)
      = finrank ℝ (LinearMap.ker d) := by
  have key := Submodule.finrank_sup_add_finrank_inf_eq
    (LinearMap.ker (hodgeLap d e)) (LinearMap.range e)
  rw [harmonic_sup_range d e hde, harmonic_inf_range d e, finrank_bot] at key
  omega

-- !-- Laplacian covariance: coarse-graining the middle degree by an isometry `U`
-- (`d' = d U⁻¹`, `e' = U e`) conjugates the Laplacian, because the adjoint of an
-- isometry is its inverse, so `Δ' = U Δ U⁻¹`. -- !--
/-- **Laplacian covariance** under an isometric coarse-graining of the middle
degree: `Δ' = U Δ U⁻¹`. -/
theorem hodge_coarse_grain (d : E₁ →ₗ[ℝ] E₂) (e : E₀ →ₗ[ℝ] E₁) (U : E₁ ≃ₗᵢ[ℝ] E₁') :
    hodgeLap (d ∘ₗ U.symm.toLinearMap) (U.toLinearMap ∘ₗ e)
      = U.toLinearMap ∘ₗ hodgeLap d e ∘ₗ U.symm.toLinearMap := by
  have hU : LinearMap.adjoint U.symm.toLinearMap = U.toLinearMap := by
    rw [LinearIsometryEquiv.adjoint_toLinearMap_eq_symm]; rfl
  have hU2 : LinearMap.adjoint U.toLinearMap = U.symm.toLinearMap := by
    rw [LinearIsometryEquiv.adjoint_toLinearMap_eq_symm]
  simp only [hodgeLap, LinearMap.adjoint_comp, hU, hU2, LinearMap.comp_assoc,
    LinearMap.add_comp, LinearMap.comp_add]

-- !-- Kernel dimension is conjugation invariant: `ker (U T U⁻¹) = U (ker T)`, and a
-- linear equivalence preserves `finrank` of a submodule. -- !--
omit [FiniteDimensional ℝ E₁] in
/-- The dimension of the kernel is invariant under conjugation by a linear
equivalence. -/
theorem finrank_ker_conj {F : Type*} [AddCommGroup F] [Module ℝ F]
    (T : E₁ →ₗ[ℝ] E₁) (U : E₁ ≃ₗ[ℝ] F) :
    finrank ℝ (LinearMap.ker (U.toLinearMap ∘ₗ T ∘ₗ U.symm.toLinearMap))
      = finrank ℝ (LinearMap.ker T) := by
  have hset : LinearMap.ker (U.toLinearMap ∘ₗ T ∘ₗ U.symm.toLinearMap)
      = (LinearMap.ker T).map U.toLinearMap := by
    ext y
    simp only [LinearMap.mem_ker, LinearMap.comp_apply, Submodule.mem_map,
      LinearEquiv.coe_coe, EmbeddingLike.map_eq_zero_iff]
    exact ⟨fun h => ⟨U.symm y, h, by simp⟩, by rintro ⟨z, hz, rfl⟩; simpa using hz⟩
  rw [hset, LinearEquiv.finrank_map_eq]

-- !-- Harmonic-dimension rigidity: combine covariance (`Δ' = U Δ U⁻¹`) with
-- conjugation invariance of kernel dimension. -- !--
/-- **Harmonic-dimension rigidity**: an isometric coarse-graining preserves the
dimension of the harmonic space, `dim ker Δ' = dim ker Δ`. -/
theorem harmonic_finrank_rigidity (d : E₁ →ₗ[ℝ] E₂) (e : E₀ →ₗ[ℝ] E₁) (U : E₁ ≃ₗᵢ[ℝ] E₁') :
    finrank ℝ (LinearMap.ker (hodgeLap (d ∘ₗ U.symm.toLinearMap) (U.toLinearMap ∘ₗ e)))
      = finrank ℝ (LinearMap.ker (hodgeLap d e)) := by
  rw [hodge_coarse_grain]
  exact finrank_ker_conj (hodgeLap d e) U.toLinearEquiv

end HodgeSpectralRigidity
