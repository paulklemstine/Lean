import Mathlib

/-!
# A p-adic valuation depth stability core

This file collects a small, fully proved package of arithmetic stability facts
for `padicValNat p` on the natural numbers, for a fixed prime `p`.

## Main results

* `PadicDepthCore.le_iff_pow_dvd` — for `n ≠ 0`, `k ≤ padicValNat p n ↔ p ^ k ∣ n`.
* `PadicDepthCore.mul` — for `m ≠ 0`, `n ≠ 0`,
  `padicValNat p (m * n) = padicValNat p m + padicValNat p n`.
* `PadicDepthCore.ultrametric_add` — for `m ≠ 0`, `n ≠ 0`,
  `min (padicValNat p m) (padicValNat p n) ≤ padicValNat p (m + n)`.
* `PadicDepthCore.isosceles` — for `m ≠ 0`, `n ≠ 0`,
  `padicValNat p m < padicValNat p n → padicValNat p (m + n) = padicValNat p m`.
-/

namespace PadicDepthCore

variable {p : ℕ} [hp : Fact (Nat.Prime p)]

/-
Divisibility criterion for valuation depth: for `n ≠ 0`, having valuation at
least `k` is equivalent to divisibility by `p ^ k`.
-/
theorem le_iff_pow_dvd {n k : ℕ} (hn : n ≠ 0) :
    k ≤ padicValNat p n ↔ p ^ k ∣ n := by
  rw [ ← padicValNat_dvd_iff_le ] ; aesop;

/-
Multiplicativity of `padicValNat` on products of nonzero naturals.
-/
theorem mul {m n : ℕ} (hm : m ≠ 0) (hn : n ≠ 0) :
    padicValNat p (m * n) = padicValNat p m + padicValNat p n := by
  rw [ padicValNat.mul hm hn, padicValNat_def' ];
  · exact hp.1.ne_one;
  · assumption

/-
Ultrametric lower bound for sums: the valuation of a sum is at least the
minimum of the valuations of the summands.
-/
theorem ultrametric_add {m n : ℕ} (hm : m ≠ 0) (hn : n ≠ 0) :
    min (padicValNat p m) (padicValNat p n) ≤ padicValNat p (m + n) := by
  -- Let `a = min (padicValNat p m) (padicValNat p n)`.
  set a := min (padicValNat p m) (padicValNat p n) with ha;
  -- By `le_iff_pow_dvd` applied with `a ≤ padicValNat p m` (which holds since `a` is a min, `min_le_left`), we get `p ^ a ∣ m`.
  have hpm : p ^ a ∣ m := by
    exact le_iff_pow_dvd hm |>.1 ( min_le_left _ _ )
  have hpn : p ^ a ∣ n := by
    exact le_iff_pow_dvd hn |>.1 ( min_le_right _ _ )
  have hpmn : p ^ a ∣ m + n := by
    exact Nat.dvd_add hpm hpn
  have hpmn' : a ≤ padicValNat p (m + n) := by
    convert le_iff_pow_dvd ( show m + n ≠ 0 from by positivity ) |>.2 hpmn using 1
  exact hpmn'

/-
Sharp isosceles law: if the valuations of `m` and `n` are distinct, the
valuation of their sum equals the smaller one.
-/
theorem isosceles {m n : ℕ} (hm : m ≠ 0) (hn : n ≠ 0)
    (h : padicValNat p m < padicValNat p n) :
    padicValNat p (m + n) = padicValNat p m := by
  refine' le_antisymm _ _;
  · have h_div : p ^ (padicValNat p m + 1) ∣ m + n → False := by
      rw [ Nat.dvd_add_left ];
      · rw [ padicValNat_dvd_iff ] ; aesop;
      · convert Nat.dvd_trans ( pow_dvd_pow _ h ) ( le_iff_pow_dvd hn |>.1 le_rfl ) using 1;
    exact Nat.le_of_not_lt fun h' => h_div <| le_iff_pow_dvd ( Nat.ne_of_gt <| Nat.pos_of_ne_zero <| by aesop ) |>.1 h';
  · exact ultrametric_add hm hn |> le_trans ( by simp +decide [ h.le ] )

end PadicDepthCore
