import Mathlib
import Algebra.BerggrenLorentz.Core

/-!
# Berggren–Lorentz Certificates for Lattice Reduction in Pythagorean Cryptography

This file extends `Algebra/BerggrenLorentz/Core.lean` from *single-generator* facts to
*whole-word* (whole-monoid) statements, and develops a **lattice-reduction descent
certificate** for the Berggren tree.

The unifying object is the **Berggren–Lorentz certificate**: a word `w` in the three
generators produces an integer matrix `wordMatrix w` that is

* a member of the integer Lorentz group `O(2,1;ℤ)` (`wordMatrix_preserves_lorentz`),
* unimodular, with determinant `(-1)^(#B-letters)` (`wordMatrix_det`), hence a
  `ℤ`-lattice automorphism of `ℤ³` (`wordMatrix_det_isUnit`),
* an isometry of the Lorentz form acting on vectors, so it preserves the light cone
  and therefore Pythagorean triples (`wordMatrix_preserves_lightCone`).

Dually, the **inverse** generators give a *reduction* (Barning–Hall parent) step:
`redB` strictly decreases the hypotenuse of a positive Pythagorean triple while keeping
it on the light cone (`redB_descent`), yielding a well-founded `ℕ`-measure
(`redB_strict_anti`). This is the "lattice reduction" half of the bridge:
generation grows the lattice vector, reduction certifies a terminating descent.

## Bridge: O(2,1;ℤ) word dynamics ↔ unimodular lattice automorphisms ↔ certified
descent (lattice reduction) ↔ Pythagorean Diophantine geometry.
-/

set_option maxHeartbeats 1600000

open Matrix

namespace BerggrenLorentz

/-! ## Section 1: Whole-Word Lorentz preservation (the monoid lies in O(2,1;ℤ))

-- !-- Lab Notes -- !--
Hypothesis: the single-generator facts `matX_preserves_lorentz` lift to *every* word.
Strategy: closure of the orthogonality predicate `Mᵀ Q M = Q` under matrix product,
then a `foldl` induction with the accumulator carrying the invariant.
Outcome: clean general theorem; the key algebraic step is
`(MN)ᵀ Q (MN) = Nᵀ (Mᵀ Q M) N = Nᵀ Q N = Q`.
-/

/--
Orthogonality w.r.t. the Lorentz metric is closed under matrix product.
    Bridge: submonoid closure in `O(2,1;ℤ)`.
-/
theorem lorentz_preserving_mul {M N : Matrix (Fin 3) (Fin 3) ℤ}
    (hM : M.transpose * metricQ * M = metricQ)
    (hN : N.transpose * metricQ * N = metricQ) :
    (M * N).transpose * metricQ * (M * N) = metricQ := by
  simp +decide only [transpose_mul];
  grind +splitImp

/--
Each generator preserves the Lorentz metric.
-/
theorem berggrenGen_preserves_lorentz (k : Fin 3) :
    (berggrenGen k).transpose * metricQ * (berggrenGen k) = metricQ := by
  native_decide +revert

/--
`foldl` form: starting from any orthogonal accumulator, the running product stays
    orthogonal. The engine behind the whole-word theorem.
-/
theorem foldl_preserves_lorentz (l : List (Fin 3)) (acc : Matrix (Fin 3) (Fin 3) ℤ)
    (hacc : acc.transpose * metricQ * acc = metricQ) :
    (l.foldl (fun a k => a * berggrenGen k) acc).transpose * metricQ *
      (l.foldl (fun a k => a * berggrenGen k) acc) = metricQ := by
  induction' l using List.reverseRecOn with l ih;
  · exact hacc;
  · convert lorentz_preserving_mul ‹_› ( berggrenGen_preserves_lorentz ih ) using 1 ; simp +decide [ Matrix.mul_assoc ]

/--
**Every** Berggren word lies in `O(2,1;ℤ)`: the entire monoid is a subgroup of the
    integer Lorentz group. Generalizes `matA/B/C_preserves_lorentz`.
-/
theorem wordMatrix_preserves_lorentz (w : BerggrenWord) :
    (wordMatrix w).transpose * metricQ * (wordMatrix w) = metricQ := by
  unfold wordMatrix; exact foldl_preserves_lorentz w.letters 1 ( by simp +decide ) ;

/-! ## Section 2: Determinant / unimodularity certificate

-- !-- Lab Notes -- !--
Hypothesis: `det (wordMatrix w) = (-1)^(#B in w)`, refining `berggren_det_signature`.
det is a monoid homomorphism, and `det matB = -1` is the only generator flipping sign,
so the determinant tracks the parity grading `wordParity`. The `foldl` induction carries
`det acc` as the accumulator coefficient.
-/

/--
Determinant of each generator: only `B` (index `1`) is improper.
-/
theorem det_berggrenGen (k : Fin 3) :
    (berggrenGen k).det = if k = 1 then -1 else 1 := by
  native_decide +revert

/--
`foldl` form of the determinant homomorphism.
-/
theorem foldl_det (l : List (Fin 3)) (acc : Matrix (Fin 3) (Fin 3) ℤ) :
    (l.foldl (fun a k => a * berggrenGen k) acc).det =
      acc.det * (-1) ^ (l.filter (· == 1)).length := by
  induction' l using List.reverseRecOn with l ih <;> simp_all +decide;
  fin_cases ih <;> simp +decide [ pow_add, det_berggrenGen ]

/--
**Determinant certificate**: `det (wordMatrix w) = (-1)^(B-parity of w)`.
-/
theorem wordMatrix_det (w : BerggrenWord) :
    (wordMatrix w).det = (-1) ^ (wordParity w) := by
  convert foldl_det w.letters 1 using 1;
  norm_num [ wordParity ]

/--
Consequently the determinant is `±1`.
-/
theorem wordMatrix_det_eq_pm_one (w : BerggrenWord) :
    (wordMatrix w).det = 1 ∨ (wordMatrix w).det = -1 := by
  have := wordMatrix_det w; by_cases h : Even ( wordParity w ) <;> simp_all +decide ;

/--
**Unimodularity certificate**: every word matrix is a `ℤ`-lattice automorphism
    (its determinant is a unit of `ℤ`).
-/
theorem wordMatrix_det_isUnit (w : BerggrenWord) : IsUnit (wordMatrix w).det := by
  have := wordMatrix_det w; ( have := wordMatrix_det_eq_pm_one w; aesop; )

/-! ## Section 3: Action on vectors — isometry of the Lorentz form

-- !-- Lab Notes -- !--
Hypothesis: membership in `O(2,1;ℤ)` is equivalent to preserving the quadratic form
`lorentzForm v = vᵀ Q v` under `mulVec`. Writing `lorentzForm v = v ⬝ᵥ (Q *ᵥ v)` turns
preservation into the associativity rewrite `(Mv)ᵀ Q (Mv) = vᵀ (Mᵀ Q M) v`, closed by `hM`.
Payoff: the light cone, hence the set of Pythagorean triples, is invariant under the
*whole* monoid — the global form of `childX_preserves_pythag`.
-/

/--
The Lorentz form as a matrix quadratic form `vᵀ Q v`.
-/
theorem lorentzForm_eq_dotProduct (v : Fin 3 → ℤ) :
    lorentzForm v = v ⬝ᵥ (metricQ *ᵥ v) := by
  unfold lorentzForm;
  unfold metricQ; simp +decide [ Matrix.mulVec, dotProduct, Fin.sum_univ_three ] ; ring;

/--
Any `O(2,1;ℤ)` matrix acts as an isometry of the Lorentz form.
-/
theorem mulVec_preserves_lorentzForm {M : Matrix (Fin 3) (Fin 3) ℤ}
    (hM : M.transpose * metricQ * M = metricQ) (v : Fin 3 → ℤ) :
    lorentzForm (M *ᵥ v) = lorentzForm v := by
  rw [ lorentzForm_eq_dotProduct, lorentzForm_eq_dotProduct ];
  convert congr_arg ( fun x => v ⬝ᵥ x *ᵥ v ) hM using 1;
  simp +decide [ Matrix.mul_assoc, Matrix.dotProduct_mulVec, Matrix.vecMul_mulVec ]

/--
Every Berggren word acts as an isometry of the Lorentz form.
-/
theorem wordMatrix_preserves_lorentzForm (w : BerggrenWord) (v : Fin 3 → ℤ) :
    lorentzForm ((wordMatrix w) *ᵥ v) = lorentzForm v := by
  apply mulVec_preserves_lorentzForm (wordMatrix_preserves_lorentz w) v

/--
**Light-cone certificate**: the whole monoid preserves the light cone `Q = 0`,
    i.e. maps Pythagorean vectors to Pythagorean vectors.
-/
theorem wordMatrix_preserves_lightCone (w : BerggrenWord) (v : Fin 3 → ℤ)
    (hv : lorentzForm v = 0) : lorentzForm ((wordMatrix w) *ᵥ v) = 0 := by
  rw [ wordMatrix_preserves_lorentzForm, hv ]

/-! ## Section 4: Lattice reduction — the inverse / parent (descent) step

-- !-- Lab Notes -- !--
Hypothesis (the crux of "lattice reduction"): applying the inverse of generator `B`
(equivalently the Barning–Hall parent matrix `invB`) to a *positive* Pythagorean triple
strictly shrinks the hypotenuse while staying on the light cone, so iterated reduction
terminates. `redB (a,b,c) = invB *ᵥ (a,b,c)`, with new hypotenuse `3c - 2(a+b)`.
Key inequalities:
* triangle inequality `a+b > c` (from `pythag_triangle_ineq`) gives `3c-2(a+b) < c`;
* `8ab < 5c²` (from `5a²-8ab+5b² ≥ 0`, discriminant `< 0`) gives `3c-2(a+b) > 0`.
All three inverses share this third coordinate, so `B` is representative.
Outcome: a well-founded `ℕ`-measure `(redB …).hyp.toNat < c.toNat`, certifying descent.
-/

/-- The `B`-reduction (parent) map: `redB = invB *ᵥ ·` in coordinates. -/
def redB (a b c : ℤ) : ℤ × ℤ × ℤ := (a + 2*b - 2*c, 2*a + b - 2*c, -2*a - 2*b + 3*c)

/-- The `A`-reduction (parent) map, included for the explicit example. -/
def redA (a b c : ℤ) : ℤ × ℤ × ℤ := (a + 2*b - 2*c, -2*a - b + 2*c, -2*a - 2*b + 3*c)

/--
`redB` preserves the Lorentz quadratic form exactly (it is in `O(2,1;ℤ)`).
-/
theorem redB_preserves_Q (a b c : ℤ) :
    lorentzQ (redB a b c).1 (redB a b c).2.1 (redB a b c).2.2 = lorentzQ a b c := by
  unfold redB; unfold lorentzQ; ring;

/--
`redB` preserves Pythagorean triples (descent stays on the light cone).
-/
theorem redB_preserves_pythag (a b c : ℤ) (h : IsPythag a b c) :
    IsPythag (redB a b c).1 (redB a b c).2.1 (redB a b c).2.2 := by
  unfold redB; unfold IsPythag at *; nlinarith;

/--
The reduced hypotenuse is strictly smaller than the parent's.
-/
theorem redB_hyp_lt (a b c : ℤ) (h : IsPythag a b c) (ha : 0 < a) (hb : 0 < b)
    (hc : 0 < c) : (redB a b c).2.2 < c := by
  unfold redB; nlinarith [ h.symm ] ;

/--
The reduced hypotenuse stays positive.
-/
theorem redB_hyp_pos (a b c : ℤ) (h : IsPythag a b c) (ha : 0 < a) (hb : 0 < b)
    (hc : 0 < c) : 0 < (redB a b c).2.2 := by
  unfold redB; nlinarith [ h.le, pow_two_nonneg ( a - b ) ] ;

/--
**Descent certificate**: one reduction step keeps the triple Pythagorean with a
    strictly smaller, still-positive hypotenuse.
-/
theorem redB_descent (a b c : ℤ) (h : IsPythag a b c) (ha : 0 < a) (hb : 0 < b)
    (hc : 0 < c) :
    IsPythag (redB a b c).1 (redB a b c).2.1 (redB a b c).2.2 ∧
      0 < (redB a b c).2.2 ∧ (redB a b c).2.2 < c := by
  exact ⟨ redB_preserves_pythag a b c h, redB_hyp_pos a b c h ha hb hc, redB_hyp_lt a b c h ha hb hc ⟩

/--
**Termination measure**: the reduced hypotenuse gives a strictly decreasing
    `ℕ`-valued measure, so the descent is well-founded (cannot cycle).
-/
theorem redB_strict_anti (a b c : ℤ) (h : IsPythag a b c) (ha : 0 < a) (hb : 0 < b)
    (hc : 0 < c) : ((redB a b c).2.2).toNat < c.toNat := by
  exact (Int.toNat_lt_toNat hc).2 (redB_hyp_lt a b c h ha hb hc)

/-! ## Section 5: Explicit reduction examples (reaching the seed (3,4,5))

-- !-- Lab Notes -- !--
Sanity checks: the first-generation children reduce back to the seed under the matching
inverse generator. `redB` inverts the `B`-child `(21,20,29)`; `redA` inverts the
`A`-child `(5,12,13)`. Both land on `(3,4,5)`, confirming the parent maps.
-/

/--
The `B`-child `(21,20,29)` reduces to the seed `(3,4,5)`.
-/
theorem redB_seed_example : redB 21 20 29 = (3, 4, 5) := by
  rfl

/--
The `A`-child `(5,12,13)` reduces to the seed `(3,4,5)`.
-/
theorem redA_seed_example : redA 5 12 13 = (3, 4, 5) := by
  native_decide +revert

end BerggrenLorentz