import Mathlib

/-! # Korselt's Criterion bridge

This file develops the arithmetic pipeline behind Korselt's criterion for Carmichael
numbers.  We work with the following (Korselt/Fermat) notion of a Carmichael number:
`n` is Carmichael when `n ∣ a ^ n - a` for every integer `a`.  (We do *not* require `n`
to be composite; primes also satisfy this condition by Fermat's little theorem, and the
right-hand side of Korselt's criterion is likewise satisfied by primes.)

The main result is `korselt_criterion`:
`IsCarmichael n ↔ Squarefree n ∧ ∀ p prime, p ∣ n → (p - 1) ∣ (n - 1)`.
-/

namespace Korselt

/-- A natural number `n` satisfies the Korselt/Fermat (Carmichael) condition if
`n ∣ a ^ n - a` for every integer `a`. -/
def IsCarmichael (n : ℕ) : Prop := ∀ a : ℤ, (n : ℤ) ∣ a ^ n - a

/-- **Lemma 1.**  If every unit of `ZMod n` is killed by the exponent `n - 1`, then the
order of every unit divides `n - 1`.  (The positivity hypothesis `hn` is kept as part of
the requested signature, though it turns out to be unnecessary for the proof.) -/
lemma forall_orderOf_dvd_of_forall_pow_eq_one {n : ℕ} (hn : 0 < n)
    (h : ∀ a : (ZMod n)ˣ, a ^ (n - 1) = 1) :
    ∀ a : (ZMod n)ˣ, orderOf a ∣ (n - 1) := by
  intro a
  exact orderOf_dvd_of_pow_eq_one (h a)

/-- **Lemma 2.**  A monoid homomorphism sends an element to one whose order divides the
order of the original element.  (Surjectivity is not actually needed for this transfer,
but it is kept in the statement as requested.) -/
lemma orderOf_map_dvd_of_surjective {G H : Type*} [Monoid G] [Monoid H]
    (f : G →* H) (hf : Function.Surjective f) (g : G) :
    orderOf (f g) ∣ orderOf g := by
  apply orderOf_dvd_of_pow_eq_one
  rw [← map_pow, pow_orderOf_eq_one, map_one]

/-- **Lemma 3.**  If every unit of `ZMod n` is killed by `n - 1`, then for every prime
`p ∣ n` we have `(p - 1) ∣ (n - 1)`. -/
theorem prime_sub_one_dvd_of_forall_pow_eq_one {n p : ℕ} (hp : Nat.Prime p) (hpn : p ∣ n)
    (h : ∀ a : (ZMod n)ˣ, a ^ (n - 1) = 1) :
    (p - 1) ∣ (n - 1) := by
  rcases Nat.eq_zero_or_pos n with hn0 | hn
  · subst hn0; simp
  · haveI : NeZero n := ⟨hn.ne'⟩
    haveI : Fact p.Prime := ⟨hp⟩
    obtain ⟨g, hg⟩ := IsCyclic.exists_ofOrder_eq_natCard (α := (ZMod p)ˣ)
    have hcard : Nat.card (ZMod p)ˣ = p - 1 := by
      rw [Nat.card_eq_fintype_card, ZMod.card_units]
    rw [hcard] at hg
    obtain ⟨a, ha⟩ := ZMod.unitsMap_surjective (n := p) (m := n) hpn g
    have h1 : orderOf a ∣ (n - 1) := forall_orderOf_dvd_of_forall_pow_eq_one hn h a
    have h2 : orderOf (ZMod.unitsMap hpn a) ∣ orderOf a :=
      orderOf_map_dvd_of_surjective _ (ZMod.unitsMap_surjective hpn) a
    rw [ha, hg] at h2
    exact dvd_trans h2 h1

/-- From the integer Carmichael condition we get that every element of `ZMod n` is fixed
by the `n`-th power map. -/
lemma pow_eq_self_of_isCarmichael {n : ℕ} (h : IsCarmichael n) (x : ZMod n) :
    x ^ n = x := by
  obtain ⟨a, rfl⟩ := ZMod.intCast_surjective x
  have := h a
  rw [← ZMod.intCast_zmod_eq_zero_iff_dvd] at this
  push_cast at this
  linear_combination this

/-- From the integer Carmichael condition we get the universal Fermat condition on units. -/
lemma forall_pow_eq_one_of_isCarmichael {n : ℕ} (hn : 0 < n) (h : IsCarmichael n) :
    ∀ a : (ZMod n)ˣ, a ^ (n - 1) = 1 := by
  intro a
  have hx : ((a : (ZMod n)ˣ) : ZMod n) ^ n = (a : ZMod n) := pow_eq_self_of_isCarmichael h _
  -- lift to a unit equation
  have hax : a ^ n = a := by
    apply Units.ext
    push_cast
    simpa using hx
  -- a ^ n = a ^ (n - 1) * a
  have hsplit : a ^ n = a ^ (n - 1) * a := by
    rw [← pow_succ]; congr 1; omega
  rw [hsplit] at hax
  -- hax : a ^ (n-1) * a = a  ⇒  a ^ (n-1) = 1
  have hcancel : a ^ (n - 1) * a = 1 * a := by rw [one_mul]; exact hax
  exact mul_right_cancel hcancel

/-- If `n > 1` is Carmichael then it is squarefree.  (If `p ^ 2 ∣ n`, then taking `a = p`
in the Carmichael condition gives `p ^ 2 ∣ p ^ n - p = p (p ^ (n-1) - 1)`, forcing
`p ∣ p ^ (n-1) - 1`, which is impossible since `n - 1 ≥ 1`.) -/
lemma squarefree_of_isCarmichael {n : ℕ} (hn : 1 < n) (h : IsCarmichael n) :
    Squarefree n := by
  rw [Nat.squarefree_iff_prime_squarefree]
  intro p hp hpp
  -- p * p ∣ n, in particular (p:ℤ)^2 ∣ p^n - p
  have hdvd : ((p : ℤ) * p) ∣ ((p : ℤ) ^ n - p) := by
    have : ((p : ℤ) * p) ∣ (n : ℤ) := by exact_mod_cast hpp
    exact this.trans (h p)
  -- p^n - p = p * (p^(n-1) - 1)
  have hn1 : 1 ≤ n - 1 := by omega
  have hfac : ((p : ℤ) ^ n - p) = (p : ℤ) * ((p : ℤ) ^ (n - 1) - 1) := by
    have hpow : (p : ℤ) ^ n = (p : ℤ) ^ (n - 1) * p := by
      rw [← pow_succ]; congr 1; omega
    rw [hpow]; ring
  rw [hfac] at hdvd
  have hp0 : (0 : ℤ) < p := by exact_mod_cast hp.pos
  have hpdvd : (p : ℤ) ∣ ((p : ℤ) ^ (n - 1) - 1) := by
    have := (mul_dvd_mul_iff_left (a := (p : ℤ)) (by positivity)).mp hdvd
    exact this
  -- but p ∣ p^(n-1), so p ∣ 1, contradiction
  have hpdvd2 : (p : ℤ) ∣ (p : ℤ) ^ (n - 1) := dvd_pow_self _ (by omega)
  have : (p : ℤ) ∣ 1 := by
    have := dvd_sub hpdvd2 hpdvd
    simpa using this
  have : (p : ℤ) ≤ 1 := Int.le_of_dvd one_pos this
  have : (2 : ℤ) ≤ p := by exact_mod_cast hp.two_le
  omega

/-- Helper: a squarefree `n` divides an integer `x` as soon as every prime factor of `n`
divides `x`. -/
lemma int_dvd_of_squarefree {n : ℕ} (hsq : Squarefree n) (x : ℤ)
    (h : ∀ p : ℕ, p.Prime → p ∣ n → (p : ℤ) ∣ x) : (n : ℤ) ∣ x := by
  have hprod : (n : ℤ) = ∏ p ∈ n.primeFactors, (p : ℤ) := by
    have h2 := Nat.prod_primeFactors_of_squarefree hsq
    calc (n : ℤ) = ((∏ p ∈ n.primeFactors, p : ℕ) : ℤ) := by rw [h2]
      _ = ∏ p ∈ n.primeFactors, (p : ℤ) := by push_cast; rfl
  rw [hprod]
  apply Finset.prod_dvd_of_coprime
  · -- pairwise coprime distinct primes
    intro a ha b hb hab
    have hap : a.Prime := Nat.prime_of_mem_primeFactors ha
    have hbp : b.Prime := Nat.prime_of_mem_primeFactors hb
    have : Nat.Coprime a b := (Nat.coprime_primes hap hbp).mpr hab
    exact (Nat.isCoprime_iff_coprime.mpr this)
  · intro p hp
    exact h p (Nat.prime_of_mem_primeFactors hp) (Nat.dvd_of_mem_primeFactors hp)

/-- If `n` is squarefree and `(p - 1) ∣ (n - 1)` for every prime `p ∣ n`, then `n` is
Carmichael. -/
lemma isCarmichael_of_squarefree_of_dvd {n : ℕ} (hn : 1 < n) (hsq : Squarefree n)
    (hdvd : ∀ p : ℕ, p.Prime → p ∣ n → (p - 1) ∣ (n - 1)) :
    IsCarmichael n := by
  intro a
  apply int_dvd_of_squarefree hsq
  intro p hp hpn
  haveI : Fact p.Prime := ⟨hp⟩
  -- show (p:ℤ) ∣ a^n - a, i.e. (a : ZMod p)^n = (a : ZMod p)
  rw [← ZMod.intCast_zmod_eq_zero_iff_dvd]
  push_cast
  by_cases hap : (a : ZMod p) = 0
  · -- p ∣ a, so a^n ≡ 0 ≡ a
    have hn0 : n ≠ 0 := by omega
    rw [hap]
    simp [zero_pow hn0]
  · -- a is a unit mod p; use Fermat and (p-1) ∣ (n-1)
    have hfermat : (a : ZMod p) ^ (p - 1) = 1 := ZMod.pow_card_sub_one_eq_one hap
    obtain ⟨k, hk⟩ := hdvd p hp hpn
    have hpow : (a : ZMod p) ^ (n - 1) = 1 := by
      rw [hk, pow_mul, hfermat, one_pow]
    have hn' : n = (n - 1) + 1 := (Nat.succ_pred_eq_of_pos (by omega)).symm
    have : (a : ZMod p) ^ n = (a : ZMod p) := by
      rw [hn', pow_succ, hpow, one_mul]
    rw [this]
    ring

/-- **Korselt's criterion.**  A number `n > 1` is Carmichael (`n ∣ a^n - a` for all `a`)
iff it is squarefree and `(p - 1) ∣ (n - 1)` for every prime `p ∣ n`. -/
theorem korselt_criterion {n : ℕ} (hn : 1 < n) :
    IsCarmichael n ↔ Squarefree n ∧ ∀ p : ℕ, Nat.Prime p → p ∣ n → (p - 1) ∣ (n - 1) := by
  constructor
  · intro h
    refine ⟨squarefree_of_isCarmichael hn h, ?_⟩
    intro p hp hpn
    exact prime_sub_one_dvd_of_forall_pow_eq_one hp hpn
      (forall_pow_eq_one_of_isCarmichael (by omega) h)
  · rintro ⟨hsq, hdvd⟩
    exact isCarmichael_of_squarefree_of_dvd hn hsq hdvd

end Korselt
