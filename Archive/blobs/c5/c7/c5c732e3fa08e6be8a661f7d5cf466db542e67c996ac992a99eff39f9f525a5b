  "visualizations": [
    {
      "name": "The (1+i) Spiral: Why Doubly-Even Self-Dual Codes Have Length Divisible by 8",
      "description": "Plots the powers (1+i)^r in the complex plane for r = 0..16, highlighting that the trajectory returns to the positive real axis only every 8 steps ((1+i)^8 = 16, (1+i)^16 = 256), while (1+i)^4 = -4 lies on the negative axis. Since the master identity forces |C| (a positive integer) to equal (1+i)^n, the length n must be a multiple of 8. The two code lengths of the paper, n=8 (Hamming) and n=16 (Hamming (+) Hamming), are marked.",
      "code": "import matplotlib.pyplot as plt\n\n\ndef plot_one_plus_i_spiral(max_r: int = 16) -> None:\n    xs, ys, labels = [], [], []\n    for r in range(max_r + 1):\n        z = (1 + 1j) ** r\n        xs.append(z.real)\n        ys.append(z.imag)\n        labels.append(r)\n    fig, ax = plt.subplots(figsize=(8, 8))\n    ax.plot(xs, ys, '-o', color='steelblue', lw=1)\n    for x, y, r in zip(xs, ys, labels):\n        pos_real = abs(y) < 1e-9 and x > 0\n        ax.annotate(f'r={r}', (x, y),\n                    color='crimson' if pos_real else 'black',\n                    fontsize=9)\n    ax.axhline(0, color='gray', lw=0.5)\n    ax.axvline(0, color='gray', lw=0.5)\n    ax.set_title('Powers of (1 + i): positive-real only when 8 | r')\n    ax.set_xlabel('Re'); ax.set_ylabel('Im')\n    ax.set_aspect('equal', 'box')\n    plt.tight_layout()\n    plt.savefig('one_plus_i_spiral.png', dpi=150)\n    print('wrote one_plus_i_spiral.png')\n\n\nif __name__ == '__main__':\n    plot_one_plus_i_spiral()\n"
