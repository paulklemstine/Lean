  "algorithms": [
    {
      "name": "Construction of the Binary Code Direct Sum and Block Decomposition",
      "description": "Given codes C subset F_2^m and D subset F_2^n, this algorithm constructs the direct sum C (+) D = { a||b : a in C, b in D } by coordinate concatenation, and provides the inverse block projections left/right that recover (a,b) from any codeword. The concatenation map is a bijection from C x D onto C (+) D, so the construction runs in O(|C|*|D|*(m+n)) time and yields exactly |C|*|D| codewords. The block projections are the computational core of every closure proof: they reduce any property of C (+) D to the conjunction of the corresponding properties of the two independent blocks, exploiting that the binary inner product is block-diagonal under concatenation.",
      "pseudocode": "function DIRECT_SUM(C, D):\n    result <- empty set\n    for a in C:\n        for b in D:\n            result.add(concat(a, b))     # a||b in F_2^{m+n}\n    return result\n\nfunction LEFT_PART(z, m):  return z[0 .. m-1]\nfunction RIGHT_PART(z, m): return z[m .. end]\n\n# Membership criterion (Theorem 3.1):\nfunction MEM_DIRECT_SUM(z, C, D, m):\n    return LEFT_PART(z, m) in C and RIGHT_PART(z, m) in D",
      "code": "from itertools import product\nfrom typing import FrozenSet, Tuple\n\nVector = Tuple[int, ...]\nCode = FrozenSet[Vector]\n\n\ndef concat(a: Vector, b: Vector) -> Vector:\n    return a + b\n\n\ndef left_part(z: Vector, m: int) -> Vector:\n    return z[:m]\n\n\ndef right_part(z: Vector, m: int) -> Vector:\n    return z[m:]\n\n\ndef direct_sum(C: Code, D: Code) -> Code:\n    '''C (+) D = { a || b : a in C, b in D }, size |C|*|D|.'''\n    return frozenset(concat(a, b) for a in C for b in D)\n\n\ndef mem_direct_sum(z: Vector, C: Code, D: Code, m: int) -> bool:\n    '''Theorem 3.1: z in C (+) D iff its two blocks lie in C and D.'''\n    return left_part(z, m) in C and right_part(z, m) in D\n"
    },
    {
      "name": "Gleason Master-Identity Evaluator and Length-Divisibility Certifier",
      "description": "Computes the Gauss-sum master identity |C| = (1+i)^n for a binary doubly-even self-dual code and certifies the resulting divisibility 8 | n. The procedure evaluates the complex number (1+i)^n, checks it equals the real integer |C|, and then performs the period-8 sign analysis: writing n = 8q + r with (1+i)^8 = 16, only r = 0 yields a positive real value ((1+i)^4 = -4 < 0 and the odd powers are non-real). Running the inner double-character sum directly costs O(2^n * |C|), but the closed form |C| = (1+i)^n reduces the certificate to O(log n) complex multiplications, the same speedup that lets the headline avoid a 2^16 enumeration.",
      "pseudocode": "function GLEASON_CERTIFY(C, n):\n    lhs <- complex(|C|, 0)\n    rhs <- (1 + i)^n            # fast exponentiation\n    assert |lhs - rhs| < eps     # master identity\n    r <- n mod 8\n    # (1+i)^r is positive real only for r = 0\n    return r == 0                # certifies 8 | n",
      "code": "from typing import FrozenSet, Tuple\n\nVector = Tuple[int, ...]\nCode = FrozenSet[Vector]\n\n\ndef gleason_master_value(card: int, n: int) -> complex:\n    '''Return (1 + i)^n; equals |C| for a doubly-even self-dual code.'''\n    return (1 + 1j) ** n\n\n\ndef gleason_certify(C: Code, n: int, eps: float = 1e-9) -> bool:\n    '''Verify |C| = (1+i)^n and certify 8 | n via period-8 sign analysis.'''\n    lhs = complex(len(C), 0)\n    rhs = gleason_master_value(len(C), n)\n    if abs(lhs - rhs) >= eps:\n        return False\n    # (1+i)^r is a positive real only when r = 0 (since (1+i)^4 = -4)\n    return n % 8 == 0\n"
    }
