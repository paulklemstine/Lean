namespace FibEntryTransport

open FibEntryDuality

/-
**Functoriality of the rank of apparition.** If `d ∣ m` then `z(d) ∣ z(m)`: the entry
point is a monotone map of the divisibility preorder `(ℕ, ∣)`.

!-- `m ∣ F (z m)` holds by the duality at `n = z m`; transitivity gives `d ∣ F (z m)`,
and the duality (other direction) turns this into `z d ∣ z m`. -- !--
-/
theorem fibEntry_dvd_of_dvd {d m : ℕ} (h : d ∣ m) : fibEntry d ∣ fibEntry m := by
  rw [ ← FibEntryDuality.fib_dvd_iff_fibEntry_dvd ];
  exact dvd_trans h ( FibEntryDuality.fib_dvd_iff_fibEntry_dvd m ( fibEntry m ) |>.2 ( dvd_refl _ ) )

/-
**Periodicity of apparition.** The Fibonacci-divisibility indicator of `p` is periodic
with period `z(p)`: `p ∣ F (n + z(p)) ↔ p ∣ F n`.

!-- Both sides become `z p ∣ (n + z p)` resp. `z p ∣ n` under the duality, equivalent by
`Nat.dvd_add_right` (adding a multiple of `z p`). -- !--
-/
theorem fib_dvd_period (p n : ℕ) :
    p ∣ Nat.fib (n + fibEntry p) ↔ p ∣ Nat.fib n := by
  rw [ fib_dvd_iff_fibEntry_dvd, fib_dvd_iff_fibEntry_dvd ];
  simp +decide

/-
**Reduction modulo the entry point.** Fibonacci-divisibility by `p` depends only on the
index modulo `z(p)`: `p ∣ F n ↔ p ∣ F (n % z(p))`.

!-- Under the duality both sides become `z p ∣ n` and `z p ∣ (n % z p)`, equivalent by
`Nat.dvd_mod_iff (dvd_refl (z p))`. -- !--
-/
theorem fib_dvd_mod_fibEntry (p n : ℕ) :
    p ∣ Nat.fib n ↔ p ∣ Nat.fib (n % fibEntry p) := by
  rw [ ← Nat.mod_add_div n ( fibEntry p ) ];
  induction n / fibEntry p <;> simp_all +decide [ Nat.mul_succ, ← add_assoc, fib_dvd_period ]

/-
**Faithfulness / universal transport.** Divisibility of entry points is *exactly*
implication between Fibonacci-divisibility predicates:
`z(p) ∣ z(q) ↔ ∀ n, q ∣ F n → p ∣ F n`.  Hence `z` is a faithful order-embedding of the
Fibonacci-divisibility preorder into `(ℕ, ∣)`.

!-- (←) instantiate the hypothesis at `n = z q` (using `q ∣ F (z q)`, the duality at
`z q`) to get `p ∣ F (z q)`, i.e. `z p ∣ z q`.  (→) chain the duality: `q ∣ F n`
gives `z q ∣ n`, then `z p ∣ z q ∣ n` gives `p ∣ F n`. -- !--
-/
theorem fibEntry_dvd_iff_fib_dvd_imp (p q : ℕ) :
    fibEntry p ∣ fibEntry q ↔ ∀ n, q ∣ Nat.fib n → p ∣ Nat.fib n := by
  constructor <;> intro h;
  · exact fun n hn => fib_dvd_iff_fibEntry_dvd p n |>.2 ( dvd_trans h ( fib_dvd_iff_fibEntry_dvd q n |>.1 hn ) );
  · exact FibEntryDuality.fib_dvd_iff_fibEntry_dvd p ( fibEntry q ) |>.1 ( h _ ( FibEntryDuality.fib_dvd_iff_fibEntry_dvd q ( fibEntry q ) |>.2 ( dvd_refl _ ) ) )

end FibEntryTransport