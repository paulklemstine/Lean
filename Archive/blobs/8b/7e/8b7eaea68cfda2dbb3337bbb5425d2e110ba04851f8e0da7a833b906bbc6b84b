/-
  # Local-to-Global Certificates for Vietoris–Rips Filtrations

  This file extends `Applications.PoincareData.MetricFiltration` with **local-to-global
  certificates**: small, locally-checkable pieces of data (single Rips edges, ε-chains,
  ε-packings) that force *global* metric/topological conclusions (reachability, π₀
  connectivity, covering-number lower bounds).

  The unifying research theme is **metric monotonicity**: as the scale ε grows, every
  local certificate is preserved and global structure can only coarsen. We make this
  precise at the level of the connected-component (π₀) functor of the Rips filtration,
  and we expose a sharp *ultrametric* phenomenon in which local edges already determine
  the entire global reachability relation.

  ## Main results

  * `rips_reachable_mono` — π₀-monotonicity: reachability at scale ε₁ persists at ε₂ ≥ ε₁.
  * `reachable_of_graphChain` / `ripsGraph_reachable_of_chain` — an ε-chain (a list whose
    consecutive entries are Rips-adjacent) certifies global reachability of its endpoints.
  * `ripsGraph_connected_of_chain` — a single spanning ε-chain certifies that the whole
    Rips graph is connected (a global π₀ statement from purely local data).
  * `rips_walk_dist`, `rips_ultrametric_reachable_iff` — **ultrametric collapse**: over an
    ultrametric space, reachability in the Rips graph is *equivalent* to a single edge,
    i.e. local adjacency = global reachability.
  * `rips_metric_reachable_gt` — failure analysis: the ultrametric hypothesis is essential;
    over ℝ reachability strictly exceeds the scale.
  * `packing_card_le_cover_card` — quantitative packing–covering duality: a (2ε)-packing
    injects into any ε-cover.
  * `packingNumber`, `packingNumber_le_coveringNumber` — the packing number at scale 2ε is
    a lower bound for the covering number at scale ε.

  These connect the `MetricFiltration` of `MetricFiltration.lean` to the ultrametric world
  of `Bridges/CategoricalTropicalUltrametric.lean`.
-/
import Mathlib
import Applications.PoincareData.MetricFiltration

open Finset Set

noncomputable section

/-! ## Part 1 — π₀ monotonicity of the Rips filtration

  -- !-- Lab Notes -- !--
  Hypothesis: the connected-component (π₀) information of the Rips filtration should be
  *monotone* in the scale, mirroring the edge-level `ripsGraph_mono`. This is the most
  basic "local-to-global" sanity check: adding edges can only merge components.

  Experiment: lift `ripsGraph_mono` through `SimpleGraph.Reachable.mono`. Outcome: clean
  one-liner; reachability is preserved upward in ε. Insight: this is exactly the statement
  that the π₀ functor applied to the filtration is itself a (monotone) filtration of
  equivalence relations — the algebraic backbone of persistent H₀.
  -- !-- -/
theorem rips_reachable_mono {α : Type*} [PseudoMetricSpace α] {ε₁ ε₂ : ℝ} (h : ε₁ ≤ ε₂)
    {x y : α} (r : (ripsGraph α ε₁).Reachable x y) : (ripsGraph α ε₂).Reachable x y :=
  r.mono (ripsGraph_mono h)

/-! ## Part 2 — ε-chain certificates (local edges ⟹ global reachability)

  -- !-- Lab Notes -- !--
  Hypothesis: a *chain* of locally-adjacent vertices (each consecutive pair within ε)
  should certify global reachability of the endpoints. This is the discrete analogue of a
  path and the core "local-to-global" primitive in topological data analysis: persistent
  H₀ is generated by such ε-chains.

  Experiment: prove a general graph lemma `reachable_of_graphChain` for `List.IsChain` of
  the adjacency relation, then specialize to `ripsGraph`. Failure analysis: the first
  attempt routed through the deprecated `List.Chain` (head-indexed) API and broke on the
  new `List.IsChain` constructors (`cons_cons`/`singleton`); switching to
  `List.isChain_cons_cons` and `List.getLastD_cons` made the induction go through
  uniformly. Insight: phrasing the conclusion with `getLastD` (a total "last" with default)
  avoids all non-emptiness side goals.
  -- !-- -/

/-- General graph fact: in any `SimpleGraph`, a chain of adjacencies certifies that the
    head is reachable from the last element of the chain. -/
theorem reachable_of_graphChain {α : Type*} (G : SimpleGraph α) :
    ∀ (l : List α) (x : α), List.IsChain G.Adj (x :: l) → G.Reachable x (l.getLastD x) := by
  intro l
  induction l with
  | nil => intro x _; exact SimpleGraph.Reachable.refl x
  | cons a t ih =>
      intro x hx
      rw [List.isChain_cons_cons] at hx
      have hr := ih a hx.2
      rw [List.getLastD_cons]
      exact (SimpleGraph.Adj.reachable hx.1).trans hr

/-- Strengthening: every member of an adjacency chain is reachable from its last element. -/
theorem mem_reachable_graphChain {α : Type*} (G : SimpleGraph α) :
    ∀ (l : List α) (x : α), List.IsChain G.Adj (x :: l) →
      ∀ v ∈ (x :: l), G.Reachable v (l.getLastD x) := by
  intro l
  induction l with
  | nil =>
      intro x _ v hv
      simp only [List.mem_singleton] at hv
      subst hv; exact SimpleGraph.Reachable.refl v
  | cons a t ih =>
      intro x hx v hv
      rw [List.isChain_cons_cons] at hx
      rw [List.getLastD_cons]
      have key := ih a hx.2
      rcases List.mem_cons.1 hv with h | h
      · subst h
        exact (SimpleGraph.Adj.reachable hx.1).trans (key a (by simp))
      · exact key v h

/-- **ε-chain certificate**: if the points `x :: l` form a Rips-adjacency chain at scale ε,
    then `x` and the final point are reachable in `ripsGraph α ε`. -/
theorem ripsGraph_reachable_of_chain {α : Type*} [PseudoMetricSpace α]
    (ε : ℝ) (x : α) (l : List α)
    (hchain : List.IsChain (ripsGraph α ε).Adj (x :: l)) :
    (ripsGraph α ε).Reachable x (l.getLastD x) :=
  reachable_of_graphChain (ripsGraph α ε) l x hchain

/-- **Global connectivity from one spanning ε-chain**: if some Rips-adjacency chain visits
    every vertex, the entire Rips graph is connected. A purely local certificate (consecutive
    distances ≤ ε) yielding the global π₀ statement `Connected`. -/
theorem ripsGraph_connected_of_chain {α : Type*} [PseudoMetricSpace α]
    (ε : ℝ) (x : α) (l : List α)
    (hcover : ∀ v : α, v ∈ (x :: l))
    (hchain : List.IsChain (ripsGraph α ε).Adj (x :: l)) :
    (ripsGraph α ε).Connected := by
  rw [SimpleGraph.connected_iff]
  refine ⟨?_, ⟨x⟩⟩
  intro u v
  have hu := mem_reachable_graphChain (ripsGraph α ε) l x hchain u (hcover u)
  have hv := mem_reachable_graphChain (ripsGraph α ε) l x hchain v (hcover v)
  exact hu.trans hv.symm

/-! ## Part 3 — Ultrametric collapse (local adjacency = global reachability)

  -- !-- Lab Notes -- !--
  Hypothesis (the headline experiment): over an **ultrametric** space the strong triangle
  inequality `dist x z ≤ max (dist x y) (dist y z)` should make Rips reachability collapse
  to a single edge — i.e. if `x` and `y` are connected at scale ε, then already
  `dist x y ≤ ε`. Intuitively, ultrametric balls are equivalence classes, so ε-chains
  cannot "walk further" than one step.

  Experiment: induct on a `Walk` in `ripsGraph α ε`. The `nil` case needs `0 ≤ ε`
  (`dist x x = 0`); the `cons` case is precisely `max_le` against the ultrametric bound.
  Outcome: `rips_walk_dist`, then the biconditional `rips_ultrametric_reachable_iff`.

  Failure analysis / necessity: in a *general* metric space this is false — over ℝ the
  chain 0–1–2 connects 0 and 2 at scale 1 yet `dist 0 2 = 2 > 1`. We record this as
  `rips_metric_reachable_gt`, certifying that the ultrametric hypothesis is load-bearing.

  Insight / bridge: this is the Rips-filtration shadow of the ultrametric reconstruction in
  `Bridges/CategoricalTropicalUltrametric.lean`: the π₀ relation of the Rips graph is the
  ε-ball equivalence exactly when the metric is ultrametric.
  -- !-- -/

/-- Over an ultrametric space, any Rips walk at scale ε keeps its endpoints within ε. -/
theorem rips_walk_dist {α : Type*} [PseudoMetricSpace α] [IsUltrametricDist α]
    {ε : ℝ} (hε : 0 ≤ ε) {x y : α} (w : (ripsGraph α ε).Walk x y) : dist x y ≤ ε := by
  induction w with
  | nil => simpa using hε
  | @cons a b c hab w ih =>
      calc dist a c ≤ max (dist a b) (dist b c) := IsUltrametricDist.dist_triangle_max a b c
        _ ≤ ε := max_le hab.2 ih

/-- **Ultrametric collapse**: over an ultrametric space, reachability in `ripsGraph α ε`
    is equivalent to a single ε-edge. Local adjacency completely determines global π₀. -/
theorem rips_ultrametric_reachable_iff {α : Type*} [PseudoMetricSpace α] [IsUltrametricDist α]
    {ε : ℝ} (hε : 0 ≤ ε) {x y : α} :
    (ripsGraph α ε).Reachable x y ↔ dist x y ≤ ε := by
  constructor
  · rintro ⟨w⟩; exact rips_walk_dist hε w
  · intro hd
    by_cases hxy : x = y
    · subst hxy; exact SimpleGraph.Reachable.refl x
    · exact SimpleGraph.Adj.reachable (⟨hxy, hd⟩ : (ripsGraph α ε).Adj x y)

/-- Necessity of the ultrametric hypothesis: over ℝ, `0` and `2` are Rips-reachable at
    scale `1`, yet their distance exceeds `1`. So the collapse of Part 3 genuinely uses
    the strong triangle inequality. -/
theorem rips_metric_reachable_gt :
    (ripsGraph ℝ 1).Reachable 0 2 ∧ ¬ (dist (0 : ℝ) 2 ≤ 1) := by
  refine ⟨?_, ?_⟩
  · have h01 : (ripsGraph ℝ 1).Adj 0 1 := ⟨by norm_num, by rw [Real.dist_eq]; norm_num⟩
    have h12 : (ripsGraph ℝ 1).Adj 1 2 := ⟨by norm_num, by rw [Real.dist_eq]; norm_num⟩
    exact h01.reachable.trans h12.reachable
  · rw [Real.dist_eq]; norm_num

/-! ## Part 4 — Quantitative packing–covering duality

  -- !-- Lab Notes -- !--
  Hypothesis: the qualitative `maximal_packing_is_cover` of `MetricFiltration.lean` should
  upgrade to a *quantitative* comparison of cardinalities, the workhorse inequality behind
  covering-number estimates: a (2ε)-packing injects into any ε-cover, hence
  `#packing ≤ #cover`.

  Experiment: send each packing point to a nearby cover point (`choose!`), and use the
  triangle inequality to show this map is injective — two packing points sharing a cover
  point would be within 2ε, contradicting the packing separation > 2ε. Then
  `Finset.card_le_card_of_injOn`. Outcome: `packing_card_le_cover_card`.

  Consequence: defining `packingNumber` as a supremum, monotonicity of `sSup`/`sInf` over
  the (finite, bounded) cardinality sets gives `packingNumber S (2ε) ≤ coveringNumber S ε`,
  the standard sandwich bound. Insight: this is the metric-entropy lower bound that pairs
  with `coveringNumber_le_card` to control the Poincaré threshold scaling.
  -- !-- -/

/-- **Quantitative packing–covering duality**: any (2ε)-packing of `S` has cardinality at
    most that of any ε-cover of `S`. -/
theorem packing_card_le_cover_card {α : Type*} [PseudoMetricSpace α]
    {S P C : Finset α} {ε : ℝ}
    (hP : IsEpsilonPacking S P (2 * ε)) (hC : IsEpsilonCover S C ε) :
    P.card ≤ C.card := by
  classical
  obtain ⟨hPS, hpack⟩ := hP
  have hmem : ∀ x ∈ P, ∃ c ∈ C, dist x c ≤ ε := fun x hx => hC x (hPS hx)
  choose! f hfC hfd using hmem
  apply Finset.card_le_card_of_injOn f
  · intro x hx; exact hfC x hx
  · intro x hx y hy hxy
    by_contra hne
    have h1 := hfd x hx
    have h2 := hfd y hy
    have hxy2 : dist x y ≤ 2 * ε := by
      calc dist x y ≤ dist x (f x) + dist (f x) y := dist_triangle _ _ _
        _ = dist x (f x) + dist y (f x) := by rw [dist_comm y (f x)]
        _ ≤ ε + ε := by rw [hxy] at h1 ⊢; linarith [h2]
        _ = 2 * ε := by ring
    exact absurd hxy2 (not_le.mpr (hpack x hx y hy hne))

/-- The **packing number** `M(S, ε)`: the maximum cardinality of an ε-packing of `S`. -/
def packingNumber {α : Type*} [PseudoMetricSpace α] (S : Finset α) (ε : ℝ) : ℕ :=
  sSup {k : ℕ | ∃ P : Finset α, P.card = k ∧ IsEpsilonPacking S P ε}

/-- The packing-cover sandwich: `M(S, 2ε) ≤ N(S, ε)`. -/
theorem packingNumber_le_coveringNumber {α : Type*} [PseudoMetricSpace α]
    (S : Finset α) {ε : ℝ} (hε : 0 ≤ ε) :
    packingNumber S (2 * ε) ≤ coveringNumber S ε := by
  apply csSup_le
  · exact ⟨0, ∅, by simp, Finset.empty_subset _, by simp⟩
  · rintro k ⟨P, rfl, hPk⟩
    apply le_csInf
    · exact ⟨S.card, S, rfl, self_isEpsilonCover S hε⟩
    · rintro c ⟨C, rfl, hC⟩
      exact packing_card_le_cover_card hPk hC

/-! ## Part 5 — Examples / boundary checks -/

example {α : Type*} [PseudoMetricSpace α] {x y : α} (r : (ripsGraph α 1).Reachable x y) :
    (ripsGraph α 2).Reachable x y := rips_reachable_mono (by norm_num) r

-- Over ℝ (which is *not* ultrametric) the collapse fails, as certified above.
example : (ripsGraph ℝ 1).Reachable 0 2 := rips_metric_reachable_gt.1

end
