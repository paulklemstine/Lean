import Mathlib

/-!
# Strict density between consecutive polynomial-growth systems

This file gives a small, self-contained formalization of the following fact: between
the asymptotic growth rates `n ↦ n^k` and `n ↦ n^(k+1)` there is, for every `k ≥ 1`,
an *explicit* intermediate growth rate that is strictly faster than `n^k` and strictly
slower than `n^(k+1)`, with respect to *eventual domination*.

## The model

A `PSystem` is just a size function `ℕ → ℕ` (think of it as the cost / dimension of a
system at scale `n`). We compare two systems by *eventual domination*:
`S ≼ T` holds when `S.size n ≤ T.size n` for all sufficiently large `n`. Strict
comparison `S ≺ T` means `S ≼ T` but not `T ≼ S`.

## The parity-gluing idea

The witnessing intermediate system `interPowSys k` is built by *gluing* the two
neighbouring growth rates along the parity of `n`:

* on even inputs it behaves like the faster rate `n^(k+1)`;
* on odd inputs it behaves like the slower rate `n^k`.

Because both parities occur arbitrarily far out, neither neighbour can eventually
dominate it the "wrong" way:

* `powSystem k ≼ interPowSys k` and `interPowSys k ≼ powSystem (k+1)` hold (with
  threshold `N = 0`), since pointwise `n^k ≤ interPowSys k ≤ n^(k+1)`;
* `interPowSys k` is *not* eventually dominated by `n^k` (look at large even `n`,
  where it equals `n^(k+1) > n^k`);
* `n^(k+1)` does *not* eventually dominate... i.e. `powSystem (k+1)` is not eventually
  ≤ `interPowSys k` (look at large odd `n`, where the latter equals `n^k < n^(k+1)`).

Combining these yields `powSystem k ≺ interPowSys k ≺ powSystem (k+1)`.
-/

namespace PolyGrowthDensity

/-- A polynomial-growth system: simply a size function `ℕ → ℕ`. -/
structure PSystem where
  /-- The size of the system at scale `n`. -/
  size : ℕ → ℕ

/-- Eventual domination: `S ≼ T` iff `S.size n ≤ T.size n` for all large enough `n`. -/
def SimLe (S T : PSystem) : Prop := ∃ N, ∀ n ≥ N, S.size n ≤ T.size n

@[inherit_doc] scoped infix:50 " ≼ " => SimLe

/-- Strict eventual domination: `S ≺ T` iff `S ≼ T` but not `T ≼ S`. -/
def SimLt (S T : PSystem) : Prop := S ≼ T ∧ ¬ T ≼ S

@[inherit_doc] scoped infix:50 " ≺ " => SimLt

/-- Eventual domination is reflexive. -/
theorem SimLe.refl (S : PSystem) : S ≼ S := ⟨0, fun _ _ => le_rfl⟩

/-- Eventual domination is transitive. -/
theorem SimLe.trans {S T U : PSystem} (h₁ : S ≼ T) (h₂ : T ≼ U) : S ≼ U := by
  obtain ⟨N₁, h₁⟩ := h₁
  obtain ⟨N₂, h₂⟩ := h₂
  refine ⟨max N₁ N₂, fun n hn => ?_⟩
  exact le_trans (h₁ n (le_trans (le_max_left _ _) hn)) (h₂ n (le_trans (le_max_right _ _) hn))

/-- The pure polynomial system `n ↦ n^k`. -/
def powSystem (k : ℕ) : PSystem := ⟨fun n => n ^ k⟩

/-- The parity-glued intermediate system: `n^(k+1)` on even `n`, `n^k` on odd `n`. -/
def interPowSys (k : ℕ) : PSystem := ⟨fun n => if Even n then n ^ (k + 1) else n ^ k⟩

/-! ### Elementary power inequalities -/

/-- For `k ≥ 1`, `n^k ≤ n^(k+1)` for every `n` (including `n = 0`). -/
lemma le_pow_succ (n k : ℕ) (hk : 1 ≤ k) : n ^ k ≤ n ^ (k + 1) := by
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · rw [Nat.zero_pow (by omega), Nat.zero_pow (by omega)]
  · exact Nat.pow_le_pow_right hn (by omega)

/-- For `n ≥ 2`, the growth is strict: `n^k < n^(k+1)`. -/
lemma pow_lt_pow_succ (n k : ℕ) (hn : 2 ≤ n) : n ^ k < n ^ (k + 1) := by
  have hpos : 0 < n ^ k := pow_pos (by omega) k
  calc n ^ k = n ^ k * 1 := by ring
    _ < n ^ k * n := by exact mul_lt_mul_of_pos_left (by omega) hpos
    _ = n ^ (k + 1) := by rw [pow_succ]

/-! ### The two domination directions -/

/-- The pure system `n^k` is eventually dominated by the intermediate system. -/
theorem powSystem_simLe_interPowSys (k : ℕ) (hk : 1 ≤ k) :
    powSystem k ≼ interPowSys k := by
  refine ⟨0, fun n _ => ?_⟩
  show n ^ k ≤ if Even n then n ^ (k + 1) else n ^ k
  by_cases he : Even n
  · rw [if_pos he]; exact le_pow_succ n k hk
  · rw [if_neg he]

/-- The intermediate system is eventually dominated by `n^(k+1)`. -/
theorem interPowSys_simLe_powSystem (k : ℕ) (hk : 1 ≤ k) :
    interPowSys k ≼ powSystem (k + 1) := by
  refine ⟨0, fun n _ => ?_⟩
  show (if Even n then n ^ (k + 1) else n ^ k) ≤ n ^ (k + 1)
  by_cases he : Even n
  · rw [if_pos he]
  · rw [if_neg he]; exact le_pow_succ n k hk

/-! ### The two non-domination statements -/

/-- The intermediate system is *not* eventually dominated by `n^k`:
on large even `n` it equals `n^(k+1) > n^k`.

The hypothesis `1 ≤ k` is kept because it is part of the requested statement, but it
turns out to be unnecessary for this direction. -/
theorem not_interPowSys_simLe_powSystem (k : ℕ) (hk : 1 ≤ k) :
    ¬ interPowSys k ≼ powSystem k := by
  rintro ⟨N, h⟩
  set n := 2 * max N 1 with hn_def
  have hN : n ≥ N := by omega
  have h2 : 2 ≤ n := by omega
  have he : Even n := ⟨max N 1, by omega⟩
  have hle := h n hN
  have e1 : (interPowSys k).size n = n ^ (k + 1) := by
    show (if Even n then n ^ (k + 1) else n ^ k) = n ^ (k + 1)
    rw [if_pos he]
  have e2 : (powSystem k).size n = n ^ k := rfl
  rw [e1, e2] at hle
  have hlt := pow_lt_pow_succ n k h2
  omega

/-- The faster system `n^(k+1)` does *not* eventually dominate the intermediate one:
on large odd `n` the latter equals `n^k < n^(k+1)`.

The hypothesis `1 ≤ k` is kept because it is part of the requested statement, but it
turns out to be unnecessary for this direction. -/
theorem not_powSystem_simLe_interPowSys (k : ℕ) (hk : 1 ≤ k) :
    ¬ powSystem (k + 1) ≼ interPowSys k := by
  rintro ⟨N, h⟩
  set n := 2 * max N 1 + 1 with hn_def
  have hN : n ≥ N := by omega
  have h2 : 2 ≤ n := by omega
  have ho : ¬ Even n := by rintro ⟨r, hr⟩; omega
  have hle := h n hN
  have e1 : (powSystem (k + 1)).size n = n ^ (k + 1) := rfl
  have e2 : (interPowSys k).size n = n ^ k := by
    show (if Even n then n ^ (k + 1) else n ^ k) = n ^ k
    rw [if_neg ho]
  rw [e1, e2] at hle
  have hlt := pow_lt_pow_succ n k h2
  omega

/-! ### Main results -/

/-- **Strict density.** For every `k ≥ 1`, the parity-glued system sits strictly
between `n^k` and `n^(k+1)` under eventual domination. -/
theorem powSystem_simLt_interPowSys_simLt_powSystem (k : ℕ) (hk : 1 ≤ k) :
    powSystem k ≺ interPowSys k ∧ interPowSys k ≺ powSystem (k + 1) :=
  ⟨⟨powSystem_simLe_interPowSys k hk, not_interPowSys_simLe_powSystem k hk⟩,
   ⟨interPowSys_simLe_powSystem k hk, not_powSystem_simLe_interPowSys k hk⟩⟩

/-- **Existence of an intermediate degree.** For every `k ≥ 1` there is a system `U`
with `n^k ≺ U ≺ n^(k+1)`. -/
theorem exists_intermediate (k : ℕ) (hk : 1 ≤ k) :
    ∃ U, powSystem k ≺ U ∧ U ≺ powSystem (k + 1) :=
  ⟨interPowSys k, powSystem_simLt_interPowSys_simLt_powSystem k hk⟩

end PolyGrowthDensity
