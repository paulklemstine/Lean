\section{Introduction}

Topological data analysis studies the multi-scale shape of data. Given a finite
point cloud and a dissimilarity, the Vietoris--Rips filtration produces a
one-parameter family of simplicial complexes that grows with scale; features that
\emph{persist} are signal and ephemeral ones are noise. One organizes the family
into a \emph{persistence module} and measures similarity by the \emph{interleaving
distance}.

Two streams of structure surround this distance. Persistence modules are
\emph{functors} out of the ordered real line, and interleavings are lax natural
transformations. Separately, the additive combination of shifts and the infimum
over admissible shifts are the two operations of the \emph{tropical (min-plus)
semiring}. This paper makes both precise and adds two functoriality theorems --
for the rank invariant and for the shift action -- exhibiting the interleaving
distance as a genuinely algebraic object living in the tropics.

\paragraph{Contributions.}
(1) A preorder-valued model of persistence modules and interleavings with
elementary yet faithful categorical laws (\S3). (2) The $\Rext$-valued interleaving
distance and a proof it is a pseudometric (\S4). (3) The tropical reformulation:
the triangle inequality is submultiplicativity in $\mathrm{Tropical}\,\Rext$
(\S5). (4) Vietoris--Rips modules and stability (\S6). (5) The rank functor, its
preservation of interleavings, and $1$-Lipschitz property (\S7). (6) The shift
functor as a tropical scalar action and the finite-distance equivalence relation
(\S8).

\section{Preliminaries: the tropical semiring}

The \emph{tropical semiring} on the extended nonnegative reals $\Rext$ is
$(\Rext,\oplus,\odot)$ with
\[ a\oplus b=\min(a,b),\qquad a\odot b=a+b. \]
The additive identity is $\top=\infty$ and the multiplicative identity is $0$. We
write $\mathrm{Tropical}\,\Rext$ for the carrier and $\trop$, $\mathrm{untrop}$ for
the tagging maps. The key fact is
\[ \trop(x)\le\trop(y)\odot\trop(z)\iff x\le y+z, \]
and the tropical multiplicative unit is $\trop(0)=1$.

\section{Persistence modules and interleavings}

Let $\alpha$ be a preorder.

\begin{definition}[Persistence module]
A \emph{persistence module} valued in $\alpha$ is a pair $M=(M.\obj,M.\mathrm{mono})$
with $M.\obj:\mathbb{R}\to\alpha$ and $M.\mathrm{mono}$ a proof that $M.\obj$ is
monotone. Categorically, $M$ is a functor $(\mathbb{R},\le)\to\alpha$.
\end{definition}

We work in a preorder-valued model: naturality squares commute automatically, so
an interleaving reduces to a pair of pointwise shifted inequalities with no loss
of faithfulness for the metric theory.

\begin{definition}[$\varepsilon$-interleaving]
For $\varepsilon:\mathbb{R}$ and modules $M,N$,
\[ \Interleaved\,\varepsilon\,M\,N := \big(\forall t,\ M.\obj\,t\le N.\obj(t+\varepsilon)\big)\wedge\big(\forall t,\ N.\obj\,t\le M.\obj(t+\varepsilon)\big). \]
\end{definition}

\begin{proposition}[Reflexivity]
$\Interleaved\,0\,M\,M$.
\end{proposition}
\begin{proof} $M.\obj\,t\le M.\obj(t+0)$ since $t+0=t$. \end{proof}

\begin{proposition}[Symmetry]
$\Interleaved\,\varepsilon\,M\,N\Rightarrow\Interleaved\,\varepsilon\,N\,M$.
\end{proposition}
\begin{proof} Swap the conjuncts. \end{proof}

\begin{proposition}[Monotone weakening]
If $\Interleaved\,\varepsilon\,M\,N$ and $\varepsilon\le\delta$, then
$\Interleaved\,\delta\,M\,N$.
\end{proposition}
\begin{proof} Chain the interleaving bound with monotonicity
$N.\obj(t+\varepsilon)\le N.\obj(t+\delta)$, symmetrically. \end{proof}

\begin{theorem}[Composition law]\label{thm:comp}
If $\Interleaved\,\varepsilon\,M\,N$ and $\Interleaved\,\delta\,N\,L$, then
$\Interleaved\,(\varepsilon+\delta)\,M\,L$.
\end{theorem}
\begin{proof}
$M.\obj\,t\le N.\obj(t+\varepsilon)\le L.\obj(t+\varepsilon+\delta)=L.\obj(t+(\varepsilon+\delta))$,
and symmetrically
$L.\obj\,t\le N.\obj(t+\delta)\le M.\obj(t+\delta+\varepsilon)=M.\obj(t+(\varepsilon+\delta))$.
\end{proof}

Theorem~\ref{thm:comp} is the conceptual heart: it makes the interleaving distance
a pseudometric and becomes tropical multiplication in \S5.

\section{The interleaving distance}

\begin{definition}
The \emph{interleaving set} is
\[ \iset(M,N):=\{\,x\in\Rext\mid\exists\,\varepsilon\ge0,\ \Interleaved\,\varepsilon\,M\,N\wedge x=\ofReal\,\varepsilon\,\}, \]
and the \emph{interleaving distance} is $\idist\,M\,N:=\inf\,\iset(M,N)$, with
$\inf\emptyset=\top$.
\end{definition}

Working in $\Rext$ is essential: an empty interleaving set must yield $\top$,
whereas the real-valued infimum of the empty set collapses to $0$.

\begin{theorem}[Self-distance]\label{thm:self}
$\idist\,M\,M=0$.
\end{theorem}
\begin{proof} $0\in\iset(M,M)$ by reflexivity with $\ofReal\,0=0$. \end{proof}

\begin{theorem}[Symmetry]
$\idist\,M\,N=\idist\,N\,M$.
\end{theorem}
\begin{proof} The interleaving sets coincide by symmetry of $\Interleaved$. \end{proof}

\begin{lemma}[Upper bound from a witness]\label{lem:wit}
If $0\le\varepsilon$ and $\Interleaved\,\varepsilon\,M\,N$, then
$\idist\,M\,N\le\ofReal\,\varepsilon$.
\end{lemma}
\begin{proof} $\ofReal\,\varepsilon\in\iset(M,N)$. \end{proof}

\begin{theorem}[Triangle inequality]\label{thm:tri}
$\idist\,M\,L\le\idist\,M\,N+\idist\,N\,L$.
\end{theorem}
\begin{proof}
For $x=\ofReal\,\varepsilon\in\iset(M,N)$ and $y=\ofReal\,\delta\in\iset(N,L)$ the
composition law gives $\Interleaved\,(\varepsilon+\delta)\,M\,L$, so by
Lemma~\ref{lem:wit},
$\idist\,M\,L\le\ofReal(\varepsilon+\delta)=x+y$. Push the infimum through the sum
using the $\Rext$ identities $\inf A+b=\inf_{a\in A}(a+b)$ and
$b+\inf B=\inf_{b'\in B}(b+b')$, then bound the double infimum termwise.
\end{proof}

Theorems~\ref{thm:self}--\ref{thm:tri} establish that $\idist$ is a $\Rext$-valued
pseudometric.

\section{Tropical reformulation}

\begin{theorem}[Tropical submultiplicativity]
In $\mathrm{Tropical}\,\Rext$,
\[ \trop\big(\idist\,M\,L\big)\le\trop\big(\idist\,M\,N\big)\odot\trop\big(\idist\,N\,L\big). \]
\end{theorem}
\begin{proof} Unfolding $\odot$ as addition and the tropical order, this is
identical to Theorem~\ref{thm:tri}. \end{proof}

Composition of interleavings is tropical multiplication, the optimal interleaving
is a tropical infimum, and the triangle inequality is tropical
submultiplicativity.

\section{Vietoris--Rips modules and stability}

Let $X$ be a type and $d:X\to X\to\mathbb{R}$ a dissimilarity.

\begin{definition}[Vietoris--Rips module]
$\RipsMod\,d:\PersMod(\mathrm{Set}(X\times X))$ has
$\obj\,t=\{(x,y):d\,x\,y\le t\}$, the edge set at scale $t$, ordered by inclusion.
\end{definition}

\begin{theorem}[Stability]\label{thm:stab}
If $|d\,x\,y-d'\,x\,y|\le\varepsilon$ for all $x,y$, then
$\Interleaved\,\varepsilon\,(\RipsMod\,d)\,(\RipsMod\,d')$.
\end{theorem}
\begin{proof}
If $d\,x\,y\le t$ then $d'\,x\,y\le d\,x\,y+\varepsilon\le t+\varepsilon$; the
reverse inclusion is symmetric.
\end{proof}

\begin{corollary}
If $0\le\varepsilon$ then $\idist\,(\RipsMod\,d)\,(\RipsMod\,d')\le\ofReal\,\varepsilon$.
\end{corollary}

\section{The rank functor and algebraic stability of the rank invariant}

Let $\beta$ be a finite type and $\ncard\,S$ the cardinality of $S\subseteq\beta$.

\begin{definition}[Rank functor]
For $M:\PersMod(\mathrm{Set}\,\beta)$ with $\beta$ finite,
$\rankMod\,M:\PersMod\,\mathbb{N}$ has
$(\rankMod\,M).\obj\,t:=\ncard\big(M.\obj\,t\big)$. Monotonicity holds since over a
finite type $S\subseteq T\Rightarrow\ncard\,S\le\ncard\,T$.
\end{definition}

The finiteness hypothesis is genuine: for an infinite set $\ncard$ returns $0$ and
monotonicity fails.

\begin{theorem}[Preservation of interleavings]\label{thm:rankpres}
If $\beta$ is finite and $\Interleaved\,\varepsilon\,M\,N$, then
$\Interleaved\,\varepsilon\,(\rankMod\,M)\,(\rankMod\,N)$.
\end{theorem}
\begin{proof} Apply $\ncard$ to each inclusion bound. \end{proof}

\begin{theorem}[$1$-Lipschitz]\label{thm:lip}
For finite $\beta$, $\idist\,(\rankMod\,M)\,(\rankMod\,N)\le\idist\,M\,N$.
\end{theorem}
\begin{proof}
By Theorem~\ref{thm:rankpres} every $\varepsilon$ witnessing $(M,N)$ also witnesses
$(\rankMod\,M,\rankMod\,N)$, so $\inf$ over the larger set is no greater.
\end{proof}

This is an inequality, not an equality: the rank invariant forgets geometry, so
distances can strictly contract.

\begin{definition}[Rips rank curve]
For finite $X$, $\mathrm{ripsRankCurve}\,d:=\rankMod(\RipsMod\,d)$, the
edge-count / Betti-$0$ curve: at scale $t$ it counts pairs with $d\,x\,y\le t$.
\end{definition}

\begin{theorem}[Rank-curve stability]
If $|d\,x\,y-d'\,x\,y|\le\varepsilon$ for all $x,y$ (finite $X$) then
$\Interleaved\,\varepsilon\,(\mathrm{ripsRankCurve}\,d)\,(\mathrm{ripsRankCurve}\,d')$;
and if $0\le\varepsilon$ then
$\idist\,(\mathrm{ripsRankCurve}\,d)\,(\mathrm{ripsRankCurve}\,d')\le\ofReal\,\varepsilon$.
\end{theorem}
\begin{proof} Combine Theorems~\ref{thm:stab} and~\ref{thm:rankpres}, with
Theorem~\ref{thm:lip} for the second claim. \end{proof}

\section{The shift functor as a tropical scalar action}

For $c:\mathbb{R}$:

\begin{definition}[Shift functor]
$\shift\,c\,M:\PersMod\,\alpha$ has $(\shift\,c\,M).\obj\,t:=M.\obj(t+c)$.
\end{definition}

\begin{theorem}[Shift isometry]
For all $\varepsilon$, $\Interleaved\,\varepsilon\,(\shift\,c\,M)\,(\shift\,c\,N)
\iff\Interleaved\,\varepsilon\,M\,N$; hence
$\idist\,(\shift\,c\,M)\,(\shift\,c\,N)=\idist\,M\,N$.
\end{theorem}
\begin{proof}[Proof sketch] The shifted inequalities are obtained from the
unshifted ones by the parameter bijection $t\mapsto t+c$; the interleaving sets
coincide. \end{proof}

\begin{theorem}[$\le c$ displacement]
$\idist\,M\,(\shift\,c\,M)\le\ofReal\,c$.
\end{theorem}
\begin{proof}[Proof sketch] Exhibit a $c$-interleaving via monotonicity and apply
Lemma~\ref{lem:wit}. \end{proof}

\begin{theorem}[Tropical unit at the diagonal]
$\trop\big(\idist\,M\,M\big)=1$ in $\mathrm{Tropical}\,\Rext$.
\end{theorem}
\begin{proof} By Theorem~\ref{thm:self} the self-distance is $0$ and $\trop\,0=1$.
\end{proof}

\begin{definition}[Finite interleaving]
$\FinInterleaved\,M\,N:=\exists\,\varepsilon\ge0,\ \Interleaved\,\varepsilon\,M\,N$.
\end{definition}

\begin{theorem}[Equivalence relation]
$\FinInterleaved$ is reflexive, symmetric, and transitive (via the composition
law); moreover $\FinInterleaved\,M\,N\iff\idist\,M\,N\ne\top$.
\end{theorem}

\section{Algorithms}
\textbf{(A) Interleaving witness check.} Given step descriptions of two
$\mathbb{N}$-valued modules and candidate $\varepsilon$, verify the two shifted
pointwise inequalities at all breakpoints; $O(k\log k)$.
\textbf{(B) Rips rank curve.} Sort the $O(n^2)$ pairwise dissimilarities; the rank
curve counts pairs with $d\le t$; $O(n^2\log n)$.
\textbf{(C) Interleaving distance of step curves.} Equals the maximal horizontal
gap between generalized inverses; $O(k)$ after sorting.

\section{Applications}
Robust shape comparison (stability), cheap certified summaries (the $1$-Lipschitz
rank functor), scale calibration (shift isometry and displacement), and clustering
of datasets (finite-distance equivalence).

\section{Future work}
\begin{conjecture}[Rank contraction is generically strict]
$\idist(\rankMod\,M)(\rankMod\,N)<\idist\,M\,N$ for some explicit pair of Rips
modules on a $3$-point set: $\ncard$ collapses non-nested edge sets of equal
cardinality, so permutation-type perturbations invisible to the rank curve still
cost positive lattice distance.
\end{conjecture}
\begin{conjecture}[Shift tightness]
$\idist\,M\,(\shift\,c\,M)=\ofReal\,c$ whenever $M$ is strictly monotone on an
interval of length $>c$.
\end{conjecture}
\begin{conjecture}[Tropical metric on the quotient]
$\PersMod\,\alpha/\FinInterleaved$ carries a well-defined $\mathrm{Tropical}\,\Rext$-valued
metric refining bisimilarity.
\end{conjecture}
Further: a converse-stability isometry $\idist(\RipsMod\,d)(\RipsMod\,d')=
\ofReal(\sup_{x,y}|d\,x\,y-d'\,x\,y|)$ when finite, and stability of
multiset-of-bars (full barcode) refinements.

\section{Conclusion}
We gave a compact, fully verified account of the interleaving distance as a
tropical object: a $\Rext$-valued pseudometric whose triangle inequality is
submultiplicativity in $\mathrm{Tropical}\,\Rext$, instantiated by Vietoris--Rips
stability and equipped with a $1$-Lipschitz rank functor and an isometric shift
action with the tropical unit at the diagonal, together with the finite-distance
equivalence relation.

