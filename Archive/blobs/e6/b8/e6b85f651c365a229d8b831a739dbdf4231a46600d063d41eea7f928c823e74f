import Mathlib

/-!
# Two-Way Contingency Tables: The Basic `2 × 2` Move

This file formalises the **basic `2 × 2` move** on integer-valued `m × n` contingency tables
and proves its core algebraic soundness: the move preserves all row and column margins and
has total sum zero.  A *table* is a matrix `T : Matrix (Fin m) (Fin n) ℤ`.

The basic move is
`B(i,i',j,j') = e_{i,j'} + e_{i',j} - e_{i,j} - e_{i',j'}`
for distinct rows `i ≠ i'` and distinct columns `j ≠ j'`.  Adding it to a table is the
elementary "swap" that keeps every one-dimensional margin fixed; it is the generator of the
two-way independence model's Markov basis.

## Main results

* `rowSum_basicMove`, `colSum_basicMove` — every basic move has all row sums and all column
  sums equal to zero.
* `basicMove_preserves_margins` — adding a basic move preserves all row and column margins.
* `basicMove_totalSum_zero` — the total sum of a basic move is zero.
* `legalBasicStep_preserves_margins` — a legal basic step between nonnegative tables
  preserves all margins.

The scope is deliberately limited to the algebraic soundness of the single `2 × 2` move; it
does not address connectivity, generation, or broader Markov-basis theory.
-/

namespace MarkovBases.TwoWay

open scoped BigOperators

variable {m n : ℕ}

/-- An `m × n` integer contingency table. -/
abbrev Table (m n : ℕ) := Matrix (Fin m) (Fin n) ℤ

/-- The `i`-th row margin (sum over columns). -/
def rowSum (T : Table m n) (i : Fin m) : ℤ := ∑ j, T i j

/-- The `j`-th column margin (sum over rows). -/
def colSum (T : Table m n) (j : Fin n) : ℤ := ∑ i, T i j

/-- The total sum of all entries of a table. -/
def totalSum (T : Table m n) : ℤ := ∑ i, ∑ j, T i j

/-- Two tables have the same margins iff all row sums and all column sums agree. -/
def sameMargins (T T' : Table m n) : Prop :=
  (∀ i, rowSum T i = rowSum T' i) ∧ (∀ j, colSum T j = colSum T' j)

/-- The basic `2 × 2` swap move `B(i,i',j,j') = e_{i,j'} + e_{i',j} - e_{i,j} - e_{i',j'}`,
for distinct rows `i ≠ i'` and distinct columns `j ≠ j'`. -/
def basicMove (i i' : Fin m) (j j' : Fin n) (_hii' : i ≠ i') (_hjj' : j ≠ j') : Table m n :=
  fun a b =>
    (if a = i ∧ b = j' then 1 else 0)
  + (if a = i' ∧ b = j then 1 else 0)
  - (if a = i ∧ b = j then 1 else 0)
  - (if a = i' ∧ b = j' then 1 else 0)

/-- Non-negativity of a table (membership in a fiber requires non-negative counts). -/
def Nonneg (T : Table m n) : Prop := ∀ i j, 0 ≤ T i j

/-- A single legal basic step: add a basic `2 × 2` move (with distinct rows and columns),
staying non-negative at both ends. -/
def LegalBasicStep (T T' : Table m n) : Prop :=
  Nonneg T ∧ Nonneg T' ∧
    ∃ (i i' : Fin m) (j j' : Fin n) (hii' : i ≠ i') (hjj' : j ≠ j'),
      T' = T + basicMove i i' j j' hii' hjj'

/-- Row sums are additive. -/
theorem rowSum_add (T T' : Table m n) (i : Fin m) :
    rowSum (T + T') i = rowSum T i + rowSum T' i := by
  simp only [rowSum, Matrix.add_apply, Finset.sum_add_distrib]

/-- Column sums are additive. -/
theorem colSum_add (T T' : Table m n) (j : Fin n) :
    colSum (T + T') j = colSum T j + colSum T' j := by
  simp only [colSum, Matrix.add_apply, Finset.sum_add_distrib]

/-- Total sums are additive. -/
theorem totalSum_add (T T' : Table m n) :
    totalSum (T + T') = totalSum T + totalSum T' := by
  simp only [totalSum, Matrix.add_apply, Finset.sum_add_distrib]

/-- Every basic move has all row sums equal to zero (uses `j ≠ j'`). -/
theorem rowSum_basicMove (i i' : Fin m) (j j' : Fin n) (hii' : i ≠ i') (hjj' : j ≠ j')
    (k : Fin m) : rowSum (basicMove i i' j j' hii' hjj') k = 0 := by
  unfold rowSum basicMove
  simp only [Finset.sum_sub_distrib, Finset.sum_add_distrib]
  by_cases hk : k = i <;> by_cases hk' : k = i' <;> simp_all

/-- Every basic move has all column sums equal to zero (uses `i ≠ i'`). -/
theorem colSum_basicMove (i i' : Fin m) (j j' : Fin n) (hii' : i ≠ i') (hjj' : j ≠ j')
    (k : Fin n) : colSum (basicMove i i' j j' hii' hjj') k = 0 := by
  unfold colSum basicMove
  simp only [Finset.sum_sub_distrib, Finset.sum_add_distrib]
  by_cases hk : k = j <;> by_cases hk' : k = j' <;> simp_all

/-- Adding a basic move preserves all row and column margins. -/
theorem basicMove_preserves_margins (T : Table m n) (i i' : Fin m) (j j' : Fin n)
    (hii' : i ≠ i') (hjj' : j ≠ j') :
    sameMargins T (T + basicMove i i' j j' hii' hjj') := by
  refine ⟨fun k => ?_, fun k => ?_⟩
  · rw [rowSum_add, rowSum_basicMove, add_zero]
  · rw [colSum_add, colSum_basicMove, add_zero]

/-- The total sum of a basic move is zero. -/
theorem basicMove_totalSum_zero (i i' : Fin m) (j j' : Fin n) (hii' : i ≠ i') (hjj' : j ≠ j') :
    totalSum (basicMove i i' j j' hii' hjj') = 0 := by
  have h : totalSum (basicMove i i' j j' hii' hjj')
      = ∑ k, rowSum (basicMove i i' j j' hii' hjj') k := rfl
  rw [h]
  simp [rowSum_basicMove]

/-- A legal basic step between nonnegative tables preserves all margins. -/
theorem legalBasicStep_preserves_margins {T T' : Table m n} (h : LegalBasicStep T T') :
    sameMargins T T' := by
  obtain ⟨_, _, i, i', j, j', hii', hjj', rfl⟩ := h
  exact basicMove_preserves_margins T i i' j j' hii' hjj'

end MarkovBases.TwoWay
