import Mathlib

/-!
# The Eckmann–Hilton Bridge I: Bi-unital interchange data are commutative monoids

The catalog's `Geometry.HomotopyTypeTheory.StratifiedInterchange` packages the
Eckmann–Hilton argument inside a structure whose two operations *share a common
identity by fiat*. This file shows that hypothesis is unnecessary: we give each
operation its **own** two-sided unit and derive everything (including that the two
units coincide) from the interchange law alone.

The payoff is a clean *dictionary direction*: a `BiunitalInterchange` datum on a type
`α` is precisely a `CommMonoid` structure on `α` (`toCommMonoid`), with associativity
obtained for free from the medial law — a result that goes strictly beyond the catalog
file, which axiomatizes associativity of vertical composition.

## Main definitions
* `BiunitalInterchange` — two binary ops, each with its own two-sided unit, plus the
  interchange law (and nothing else).
* `BiunitalInterchange.toCommMonoid` — the carrier as a genuine commutative monoid.

## Main results
* `BiunitalInterchange.unit_eq` — the two a-priori distinct units coincide.
* `BiunitalInterchange.ops_eq` — the two operations coincide.
* `BiunitalInterchange.comm` — the (shared) operation is commutative.
* `BiunitalInterchange.assoc` — the (shared) operation is associative.

-- !-- Lab Notebook -- !--
Hypothesis: The "shared unit" field in the catalog SIA is derivable, not primitive,
  and bi-unital interchange data are exactly commutative monoids.
Result: Confirmed. `unit_eq` collapses the two units via a single four-term
  interchange instance; `ops_eq`/`comm`/`assoc` then follow by unit-specialised
  rewrites, and `toCommMonoid` bundles them.
Insight: Associativity is the *medial law* (interchange after `ops_eq`) specialised at
  a unit slot — no group structure or inverses are needed, unlike the catalog proof.
Failure analysis: An early formulation stated the interchange law with mismatched slot
  order; the four-term collapse then failed to telescope. Fixing the slot convention to
  `op₁ (op₂ a b) (op₂ c d) = op₂ (op₁ a c) (op₁ b d)` made every step a unit rewrite.
-/

universe u

/-- A **bi-unital interchange datum** on a type `α`: two binary operations `op₁`, `op₂`,
each with its *own* two-sided unit (`e₁` for `op₁`, `e₂` for `op₂`), linked by the
interchange law. Unlike the catalog `StratifiedInterchangeAlgebra`, the two units are
*not* assumed equal — that is derived (`unit_eq`). -/
structure BiunitalInterchange (α : Type u) where
  /-- First binary operation (think: vertical composition `·`). -/
  op₁ : α → α → α
  /-- Second binary operation (think: horizontal composition `∘`). -/
  op₂ : α → α → α
  /-- Two-sided unit for `op₁`. -/
  e₁ : α
  /-- Two-sided unit for `op₂`. -/
  e₂ : α
  /-- `e₁` is a left unit for `op₁`. -/
  e₁_op₁ : ∀ a, op₁ e₁ a = a
  /-- `e₁` is a right unit for `op₁`. -/
  op₁_e₁ : ∀ a, op₁ a e₁ = a
  /-- `e₂` is a left unit for `op₂`. -/
  e₂_op₂ : ∀ a, op₂ e₂ a = a
  /-- `e₂` is a right unit for `op₂`. -/
  op₂_e₂ : ∀ a, op₂ a e₂ = a
  /-- The interchange law linking the two operations. -/
  interchange : ∀ a b c d, op₁ (op₂ a b) (op₂ c d) = op₂ (op₁ a c) (op₁ b d)

namespace BiunitalInterchange

variable {α : Type u} (A : BiunitalInterchange α)

/-
!-- Read `interchange e₂ e₁ e₁ e₂` two ways: the left side collapses to `op₁ e₁ e₁ = e₁`
and the right side to `op₂ e₂ e₂ = e₂`, forcing `e₁ = e₂`. -- !--

The two a-priori distinct units coincide.
-/
theorem unit_eq : A.e₂ = A.e₁ := by
  convert A.interchange A.e₂ A.e₁ A.e₁ A.e₂ |> Eq.symm using 1;
  · rw [ A.op₁_e₁, A.e₁_op₁, A.e₂_op₂ ];
  · simp +decide [ A.e₂_op₂, A.op₂_e₂, A.e₁_op₁ ]

/-
!-- Write `op₁ a b = op₁ (op₂ a e₂) (op₂ e₂ b)`, apply interchange, and collapse using
that `e₂ = e₁` is a unit for `op₁` as well. -- !--

The two operations coincide pointwise.
-/
theorem ops_eq (a b : α) : A.op₁ a b = A.op₂ a b := by
  convert A.interchange a A.e₂ A.e₂ b using 1;
  · simp +decide [ A.op₂_e₂, A.e₂_op₂ ];
  · rw [ A.unit_eq, A.e₁_op₁, A.op₁_e₁ ]

/-
!-- From `interchange (op₁ e₁ a) (op₁ b e₁) …` read as `op₂ a b = op₁ b a`; combine with
`ops_eq` to commute `op₁`. -- !--

The (shared) operation is commutative.
-/
theorem comm (a b : α) : A.op₁ a b = A.op₁ b a := by
  -- By the properties of the units and the interchange law, we can simplify the expression.
  have h_simp : A.op₂ (A.op₁ A.e₁ b) (A.op₁ a A.e₁) = A.op₂ b a := by
    rw [ A.e₁_op₁, A.op₁_e₁ ];
  grind +suggestions

/-
!-- After `ops_eq` the interchange law is the medial law `(a·b)·(c·d)=(a·c)·(b·d)`;
specialise `c := e₁` to get `(a·b)·d = a·(b·d)`. -- !--

The (shared) operation is associative.
-/
theorem assoc (a b c : α) : A.op₁ (A.op₁ a b) c = A.op₁ a (A.op₁ b c) := by
  have := A.interchange a b A.e₁ c;
  grind +suggestions

/-- A bi-unital interchange datum *is* a commutative monoid: the shared-unit hypothesis
of the catalog was never needed. -/
def toCommMonoid : CommMonoid α where
  mul := A.op₁
  one := A.e₁
  mul_assoc := A.assoc
  one_mul := A.e₁_op₁
  mul_one := A.op₁_e₁
  mul_comm := A.comm

end BiunitalInterchange