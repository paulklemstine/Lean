namespace FibEntryLocalGlobal

open FibEntryDuality FibCarmichaelStructure

/-
**Stalk = principal ideal.** The global divisibility section `{n | p ∣ F n}` is exactly the
principal ideal generated by the local datum `z(p) = fibEntry p`.  The entry point is therefore a
complete invariant of Fibonacci divisibility by `p`.

!-- `Set.ext` reduces to the pointwise duality `fib_dvd_iff_fibEntry_dvd p n`. -- !--
-/
theorem fib_divisibility_principal (p : ℕ) :
    {n : ℕ | p ∣ Nat.fib n} = {n : ℕ | fibEntry p ∣ n} := by
  exact Set.ext fun n => fib_dvd_iff_fibEntry_dvd p n

/-
**Global gluing from prime-power stalks.** For every positive `n`, the rank of apparition is
the lcm of the ranks of its prime-power parts:
`z(n) = lcm_{p ∣ n} z(p^{v_p(n)})`.  This sharpens `fibEntry_squarefree` (which is the special
case where every `v_p(n) = 1`) to arbitrary `n`.

!-- Write `n = ∏_{p ∣ n} p^{v_p(n)}` via `Nat.factorization_prod_pow_eq_self`, note the
prime powers are pairwise coprime, and apply `fibEntry_prod_coprime`. -- !--
-/
theorem fibEntry_eq_lcm_primePow {n : ℕ} (hn : n ≠ 0) :
    fibEntry n = n.primeFactors.lcm (fun p => fibEntry (p ^ (n.factorization p))) := by
  convert fibEntry_prod_coprime _ _ _;
  · exact Eq.symm ( Nat.factorization_prod_pow_eq_self hn );
  · exact fun i hi j hj hij => Nat.coprime_pow_primes _ _ ( Nat.prime_of_mem_primeFactors hi ) ( Nat.prime_of_mem_primeFactors hj ) hij

/-
**Local sections glue.** For a pairwise-coprime family of moduli `f` on a finset `s`, the
global product modulus `∏ f i` divides `F n` if and only if each local modulus `f i` does.  This
is the local-to-global compatibility of the Fibonacci divisibility presheaf.

!-- Forward: `f i ∣ ∏ f i ∣ F n`.  Reverse: pairwise coprimality lets the local divisibilities
`f i ∣ F n` be combined into `∏ f i ∣ F n` (`Finset.prod_dvd_of_coprime`). -- !--
-/
theorem fib_prod_dvd_iff_forall {ι : Type*} (s : Finset ι) (f : ι → ℕ) (n : ℕ)
    (h : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → Nat.Coprime (f i) (f j)) :
    (∏ i ∈ s, f i) ∣ Nat.fib n ↔ ∀ i ∈ s, f i ∣ Nat.fib n := by
  convert fib_dvd_iff_fibEntry_dvd ( ∏ i ∈ s, f i ) n using 1;
  rw [ fibEntry_prod_coprime s f h ];
  simp +decide [ ← fib_dvd_iff_fibEntry_dvd ]

/-
**Overlap cocycle.** For coprime `m, n`, the entry points satisfy
`z(m) · z(n) = z(m·n) · gcd(z(m), z(n))`.  Equivalently, the failure of `z` to be multiplicative
on the coprime product is measured precisely by the gcd overlap term; `z` is strictly
multiplicative exactly when this overlap is trivial.

!-- `fibEntry_coprime_mul` gives `z(mn) = lcm(z m)(z n)`; combine with
`Nat.gcd_mul_lcm : gcd a b * lcm a b = a * b`. -- !--
-/
theorem fibEntry_coprime_obstruction {m n : ℕ} (h : Nat.Coprime m n) :
    fibEntry m * fibEntry n = fibEntry (m * n) * Nat.gcd (fibEntry m) (fibEntry n) := by
  rw [ ← Nat.gcd_mul_lcm, mul_comm ];
  rw [ FibCarmichaelStructure.fibEntry_coprime_mul h ]

end FibEntryLocalGlobal