import Mathlib

/-! # Cayley step reachability and zero-energy rigidity

This file develops, for a finite group `G` with a finite generating set `S`,
the basic theory of right-multiplication "steps" on the Cayley graph, the
reachability relation they generate, and a rigidity statement: a function with
zero Cayley–Dirichlet energy is constant.

The scope is deliberately narrow:
* `Step S x y` means `y = x * s` for some generator `s ∈ S`;
* `Reachable S` is its reflexive–transitive closure;
* `cayleyDirichletEnergy S f` is the sum over all `x` and `s ∈ S` of
  `(f (x*s) - f x)^2`.

We prove path lemmas, connectivity from `Subgroup.closure ↑S = ⊤`, and finally
that zero energy forces `f` to be constant.
-/

namespace CayleyStepEnergy

variable {G : Type*} [Group G] [Fintype G] [DecidableEq G]

/-- A single right-multiplication step in the Cayley graph: `y = x * s` for some
generator `s ∈ S`. -/
def Step (S : Finset G) (x y : G) : Prop := ∃ s ∈ S, y = x * s

/-- Reachability is the reflexive–transitive closure of `Step`. -/
def Reachable (S : Finset G) : G → G → Prop := Relation.ReflTransGen (Step S)

/-- The Cayley–Dirichlet energy of a real-valued function on the group. -/
noncomputable def cayleyDirichletEnergy (S : Finset G) (f : G → ℝ) : ℝ :=
  ∑ x : G, ∑ s ∈ S, (f (x * s) - f x) ^ 2

/-! ## A. Basic path lemmas -/

omit [Fintype G] [DecidableEq G] in
theorem reachable_refl (S : Finset G) (x : G) : Reachable S x x :=
  Relation.ReflTransGen.refl

omit [Fintype G] [DecidableEq G] in
theorem step_to_reachable {S : Finset G} {x y : G} (h : Step S x y) : Reachable S x y :=
  Relation.ReflTransGen.single h

omit [Fintype G] [DecidableEq G] in
/-- One-step reachability: `x` reaches `x * s` for every generator `s ∈ S`. -/
theorem reachable_mul_right {S : Finset G} {x s : G} (hs : s ∈ S) :
    Reachable S x (x * s) :=
  step_to_reachable ⟨s, hs, rfl⟩

omit [Fintype G] [DecidableEq G] in
/-- Concatenation of paths. -/
theorem reachable_trans {S : Finset G} {a b c : G}
    (h₁ : Reachable S a b) (h₂ : Reachable S b c) : Reachable S a c :=
  Relation.ReflTransGen.trans h₁ h₂

omit [Fintype G] [DecidableEq G] in
/-- Left-translation compatibility: paths can be translated on the left. -/
theorem reachable_left_translate {S : Finset G} {a b : G} (g : G)
    (h : Reachable S a b) : Reachable S (g * a) (g * b) := by
  induction h with
  | refl => exact Relation.ReflTransGen.refl
  | tail _ hstep ih =>
      obtain ⟨s, hs, rfl⟩ := hstep
      exact ih.tail ⟨s, hs, by rw [mul_assoc]⟩

omit [Fintype G] [DecidableEq G] in
/-- Under symmetry of `S`, a single step can be reversed. -/
theorem step_symm {S : Finset G} (hsym : ∀ s ∈ S, s⁻¹ ∈ S) {x y : G}
    (h : Step S x y) : Step S y x := by
  obtain ⟨s, hs, rfl⟩ := h
  exact ⟨s⁻¹, hsym s hs, by group⟩

omit [Fintype G] [DecidableEq G] in
/-- Under symmetry of `S`, reachability is symmetric. -/
theorem reachable_symm {S : Finset G} (hsym : ∀ s ∈ S, s⁻¹ ∈ S) {x y : G}
    (h : Reachable S x y) : Reachable S y x := by
  induction h with
  | refl => exact Relation.ReflTransGen.refl
  | tail _ hstep ih => exact reachable_trans (step_to_reachable (step_symm hsym hstep)) ih

/-! ## B. Word-to-path lemma -/

omit [Fintype G] [DecidableEq G] in
/-- If `g` belongs to the subgroup generated by `S`, then `g` is reachable from `1`.
Symmetry of `S` is used to handle inverses. -/
theorem reachable_one_of_mem_closure {S : Finset G} (hsym : ∀ s ∈ S, s⁻¹ ∈ S)
    {g : G} (hg : g ∈ Subgroup.closure (↑S : Set G)) : Reachable S 1 g := by
  let H : Subgroup G :=
    { carrier := {g | Reachable S 1 g}
      one_mem' := Relation.ReflTransGen.refl
      mul_mem' := by
        intro a b ha hb
        have : Reachable S a (a * b) := by
          simpa using reachable_left_translate a hb
        exact reachable_trans ha this
      inv_mem' := by
        intro a ha
        have h1 : Reachable S a 1 := reachable_symm hsym ha
        simpa using reachable_left_translate a⁻¹ h1 }
  have hSle : (↑S : Set G) ⊆ (H : Set G) := by
    intro s hs
    have hs' : s ∈ S := by simpa using hs
    show Reachable S 1 s
    simpa using reachable_mul_right (x := (1 : G)) hs'
  exact (Subgroup.closure_le H).mpr hSle hg

/-! ## C. Connectivity from generation -/

omit [Fintype G] [DecidableEq G] in
/-- From generation, every element is reachable from the identity. -/
theorem reachable_one_all {S : Finset G}
    (hgen : Subgroup.closure (↑S : Set G) = ⊤) (hsym : ∀ s ∈ S, s⁻¹ ∈ S)
    (g : G) : Reachable S 1 g := by
  apply reachable_one_of_mem_closure hsym
  rw [hgen]
  exact Subgroup.mem_top g

omit [Fintype G] [DecidableEq G] in
/-- From generation, the Cayley graph is connected: every element is reachable
from every other element. -/
theorem reachable_all {S : Finset G}
    (hgen : Subgroup.closure (↑S : Set G) = ⊤) (hsym : ∀ s ∈ S, s⁻¹ ∈ S)
    (a b : G) : Reachable S a b := by
  have h := reachable_one_all hgen hsym (a⁻¹ * b)
  have h2 := reachable_left_translate a h
  simpa [mul_assoc] using h2

/-! ## D. Zero-energy rigidity -/

omit [DecidableEq G] in
/-- Zero total energy forces each step to preserve the value of `f`. -/
theorem energy_step_eq {S : Finset G} {f : G → ℝ}
    (hE : cayleyDirichletEnergy S f = 0) {x s : G} (hs : s ∈ S) :
    f (x * s) = f x := by
  rw [cayleyDirichletEnergy] at hE
  have houter : ∀ x ∈ (Finset.univ : Finset G),
      (0 : ℝ) ≤ ∑ s ∈ S, (f (x * s) - f x) ^ 2 := by
    intro x _
    exact Finset.sum_nonneg (fun s _ => sq_nonneg _)
  have hx := (Finset.sum_eq_zero_iff_of_nonneg houter).mp hE x (Finset.mem_univ x)
  have hinner := (Finset.sum_eq_zero_iff_of_nonneg
    (fun s _ => sq_nonneg (f (x * s) - f x))).mp hx s hs
  have := sub_eq_zero.mp (sq_eq_zero_iff.mp hinner)
  exact this

omit [Fintype G] [DecidableEq G] in
/-- Reachability propagates equality of `f` when `f` is invariant along steps. -/
theorem eq_of_reachable {S : Finset G} {f : G → ℝ}
    (hstep : ∀ x s, s ∈ S → f (x * s) = f x) {x y : G}
    (h : Reachable S x y) : f x = f y := by
  induction h with
  | refl => rfl
  | tail _ hs ih =>
      obtain ⟨s, hsS, rfl⟩ := hs
      rw [ih, hstep _ s hsS]

omit [DecidableEq G] in
/-- **Zero-energy rigidity.** If the Cayley–Dirichlet energy of `f` is zero and
`S` generates `G` (symmetrically), then `f` is constant. -/
theorem energy_zero_implies_constant {S : Finset G}
    (hgen : Subgroup.closure (↑S : Set G) = ⊤) (hsym : ∀ s ∈ S, s⁻¹ ∈ S)
    {f : G → ℝ} (hE : cayleyDirichletEnergy S f = 0) :
    ∃ c : ℝ, ∀ x, f x = c := by
  refine ⟨f 1, fun x => ?_⟩
  have hstep : ∀ x s, s ∈ S → f (x * s) = f x := fun x s hs => energy_step_eq hE hs
  exact (eq_of_reachable hstep (reachable_all hgen hsym x 1))

end CayleyStepEnergy
