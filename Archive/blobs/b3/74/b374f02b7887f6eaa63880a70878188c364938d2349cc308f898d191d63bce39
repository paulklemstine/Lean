import Mathlib
import Geometry.HomotopyTypeTheory.EckmannHilton

/-!
# Fibrewise Eckmann–Hilton: local-to-global gluing

The catalog file `Geometry.HomotopyTypeTheory.EckmannHilton` (namespace `HoTT`) runs
the Eckmann–Hilton argument on a single carrier. Here we show the argument is
**stable under arbitrary products**: an indexed family of binary systems glues
pointwise into one binary system on the dependent sections `∀ i, X i`, the interchange
law glues fibrewise, and the global commutativity is obtained by feeding the glued data
to the catalog's `HoTT.eckmann_hilton_comm`.

The section system is moreover *faithfully represented by its fibres*: evaluation at
each index is a structure-preserving projection, and the combined evaluation map is
injective (`pi_faithful`) — the algebraic shadow of a "points separate elements"
representation.

## Main results

* `piSystem` — pointwise product of a family of `HoTT.BinarySystem`s.
* `pi_interchange` — the interchange law glues fibrewise.
* `pi_comm` — the section operation is commutative whenever each fibre interchanges
  with a shared unit.
* `eval_preserves` — evaluation at an index preserves the operation (it is `rfl`).
* `pi_faithful` — sections agreeing at every index are equal.

-- !-- Lab Notebook -- !--
Hypothesis: Eckmann–Hilton commutativity is a *local* phenomenon: if it holds in
  every fibre then it holds on the sections, with no global hypotheses beyond the
  fibrewise ones.
Result: Confirmed. `pi_interchange` glues the per-fibre interchange laws by `funext`,
  and `pi_comm` is then a one-line application of the catalog `eckmann_hilton_comm` to
  the glued `piSystem`. Faithfulness (`pi_faithful`) is `funext` — separation of
  points is definitional because evaluation is literally projection.
Insight: The catalog engine is a *property of the equations*, hence automatically
  closed under products; no new equational work is needed, only transport through
  `funext`. The fibres reconstruct the whole: the section system is a submodel of the
  product of fibres.
Failure analysis: Stating `pi_unit` as `(piSystem S).e = (piSystem T).e` initially
  looked like it needed `funext` on units; it does, but the per-index hypothesis
  `(S i).e = (T i).e` makes this immediate. No deeper obstruction arose — the
  product really is the trivial case once the single-carrier theorem is in hand.
-/

namespace Logic.AutoResearch.Fibrewise

universe u v

variable {ι : Type u} {X : ι → Type v}

/-- The pointwise product of a family of binary systems is a binary system on the
dependent sections `∀ i, X i`. -/
def piSystem (S : ∀ i, HoTT.BinarySystem (X i)) : HoTT.BinarySystem (∀ i, X i) where
  op := fun f g i => (S i).op (f i) (g i)
  e := fun i => (S i).e
  op_left_id := fun f => funext fun i => (S i).op_left_id (f i)
  op_right_id := fun f => funext fun i => (S i).op_right_id (f i)

-- !-- The product interchange law is the per-fibre law applied at each index, glued by
-- `funext`. -- !--
/-- The interchange law glues fibrewise: if every fibre interchanges, so does the
product. -/
theorem pi_interchange (S T : ∀ i, HoTT.BinarySystem (X i))
    (h : ∀ i, HoTT.InterchangeLaw (S i) (T i)) :
    HoTT.InterchangeLaw (piSystem S) (piSystem T) := by
  intro a b c d; funext i; exact h i (a i) (b i) (c i) (d i)

/-- The product systems share a unit whenever every fibre pair does. -/
theorem pi_unit (S T : ∀ i, HoTT.BinarySystem (X i)) (hu : ∀ i, (S i).e = (T i).e) :
    (piSystem S).e = (piSystem T).e := funext hu

-- !-- Glue the fibrewise hypotheses with `pi_unit`/`pi_interchange`, then quote the
-- catalog `HoTT.eckmann_hilton_comm` on `piSystem S`. -- !--
/-- The section operation is commutative whenever each fibre interchanges with a shared
unit. -/
theorem pi_comm (S T : ∀ i, HoTT.BinarySystem (X i))
    (hu : ∀ i, (S i).e = (T i).e) (h : ∀ i, HoTT.InterchangeLaw (S i) (T i)) :
    ∀ a b, (piSystem S).op a b = (piSystem S).op b a :=
  HoTT.eckmann_hilton_comm (piSystem S) (piSystem T) (pi_unit S T hu) (pi_interchange S T h)

/-- Evaluation at an index preserves the operation. -/
theorem eval_preserves (S : ∀ i, HoTT.BinarySystem (X i)) (i : ι) (f g : ∀ j, X j) :
    (piSystem S).op f g i = (S i).op (f i) (g i) := rfl

-- !-- Sections agreeing at every index are equal — `funext`; evaluation separates
-- points by definition. -- !--
/-- The section system is faithfully represented by its fibres: two sections that agree
under every evaluation are equal. -/
theorem pi_faithful (f g : ∀ i, X i) (h : ∀ i, f i = g i) : f = g := funext h

end Logic.AutoResearch.Fibrewise
