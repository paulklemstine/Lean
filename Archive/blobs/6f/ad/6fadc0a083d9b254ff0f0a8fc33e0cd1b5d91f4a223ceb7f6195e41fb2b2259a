import Mathlib

/-!
# A strict intermediate growth profile between consecutive polynomial classes

We work with *growth profiles* `ℕ → ℕ` and a `O(·)`-style domination preorder
`Dominates f g` meaning `f n ≤ C * g n` for some explicit constant `C ≥ 1`.

The main result (`exists_strict_intermediate_profile`) shows that for every
`k ≥ 1` there is a profile `g` lying strictly between `n ↦ n^k` and
`n ↦ n^(k+1)` for the domination preorder. The witness is the parity-dependent
profile `interProfile k`.
-/

namespace GrowthProfiles

/-- The pure polynomial profile `n ↦ n^k`. -/
def powProfile (k : ℕ) (n : ℕ) : ℕ := n ^ k

/-- An intermediate profile: `n^(k+1)` on even inputs, `n^k` on odd inputs. -/
def interProfile (k : ℕ) (n : ℕ) : ℕ := if Even n then n ^ (k + 1) else n ^ k

/-- `Dominates f g` means `f = O(g)` with an explicit multiplicative constant. -/
def Dominates (f g : ℕ → ℕ) : Prop := ∃ C : ℕ, 1 ≤ C ∧ ∀ n, f n ≤ C * g n

/-- Auxiliary monotonicity fact: for `k ≥ 1` we have `n^k ≤ n^(k+1)` for *all*
`n` (the only subtlety is `n = 0`, where both sides vanish since `k ≥ 1`). -/
theorem pow_le_succ_pow {k : ℕ} (hk : 1 ≤ k) (n : ℕ) : n ^ k ≤ n ^ (k + 1) := by
  rcases Nat.eq_zero_or_pos n with hn | hn
  · subst hn
    simp [Nat.zero_pow (show 0 < k by omega)]
  · exact Nat.pow_le_pow_right hn (Nat.le_succ k)

/-- The domination preorder is reflexive. -/
theorem Dominates.refl (f : ℕ → ℕ) : Dominates f f :=
  ⟨1, le_refl 1, fun n => by simp⟩

/-- The domination preorder is transitive. -/
theorem Dominates.trans {f g h : ℕ → ℕ}
    (hfg : Dominates f g) (hgh : Dominates g h) : Dominates f h := by
  obtain ⟨C₁, hC₁, h₁⟩ := hfg
  obtain ⟨C₂, hC₂, h₂⟩ := hgh
  refine ⟨C₁ * C₂, Nat.one_le_iff_ne_zero.mpr (by positivity), fun n => ?_⟩
  calc f n ≤ C₁ * g n := h₁ n
    _ ≤ C₁ * (C₂ * h n) := Nat.mul_le_mul_left _ (h₂ n)
    _ = C₁ * C₂ * h n := by ring

/-- `n^k` is dominated by the intermediate profile, with constant `1`.

The hypothesis `k ≥ 1` is genuinely needed: at `k = 0, n = 0` we would need
`0^0 = 1 ≤ 0^1 = 0`, which is false. -/
theorem dominates_pow_inter {k : ℕ} (hk : 1 ≤ k) :
    Dominates (powProfile k) (interProfile k) := by
  refine ⟨1, le_refl 1, fun n => ?_⟩
  simp only [powProfile, interProfile, one_mul]
  by_cases h : Even n
  · rw [if_pos h]; exact pow_le_succ_pow hk n
  · rw [if_neg h]

/-- The intermediate profile is dominated by `n^(k+1)`, with constant `1`. -/
theorem dominates_inter_pow (k : ℕ) :
    Dominates (interProfile k) (powProfile (k + 1)) := by
  refine ⟨1, le_refl 1, fun n => ?_⟩
  simp only [powProfile, interProfile, one_mul]
  by_cases h : Even n
  · rw [if_pos h]
  · rw [if_neg h]
    -- `n` is odd, hence positive
    have hn : 0 < n := by
      rcases Nat.eq_zero_or_pos n with h0 | h0
      · exact absurd (h0 ▸ (by decide : Even 0)) h
      · exact h0
    exact Nat.pow_le_pow_right hn (Nat.le_succ k)

/-- The intermediate profile is *not* dominated by `n^k` (for `k ≥ 1`):
its even-input behaviour `n^(k+1)` outgrows `C * n^k`. (The statement in fact
holds for every `k`, so no `k ≥ 1` hypothesis is needed.) -/
theorem not_dominates_inter_pow (k : ℕ) :
    ¬ Dominates (interProfile k) (powProfile k) := by
  rintro ⟨C, _, h⟩
  -- choose an even witness larger than `C`
  set n := 2 * (C + 1) with hn
  have hne : Even n := ⟨C + 1, by ring⟩
  have hnpos : 0 < n := by omega
  have hnC : C < n := by omega
  have hkey := h n
  unfold interProfile powProfile at hkey
  rw [if_pos hne] at hkey
  -- `n^(k+1) ≤ C * n^k`, but `C * n^k < n * n^k = n^(k+1)`
  have hpow : 0 < n ^ k := by positivity
  have hlt : C * n ^ k < n * n ^ k := (Nat.mul_lt_mul_right hpow).mpr hnC
  rw [pow_succ] at hkey
  -- hkey : n^k * n ≤ C * n^k
  have heq : n ^ k * n = n * n ^ k := by ring
  omega

/-- `n^(k+1)` is *not* dominated by the intermediate profile (for `k ≥ 1`):
on odd inputs the intermediate profile is only `n^k`, which `n^(k+1)` outgrows.
(The statement in fact holds for every `k`, so no `k ≥ 1` hypothesis is needed.) -/
theorem not_dominates_pow_inter (k : ℕ) :
    ¬ Dominates (powProfile (k + 1)) (interProfile k) := by
  rintro ⟨C, _, h⟩
  -- choose an odd witness larger than `C`
  set n := 2 * C + 1 with hn
  have hodd : ¬ Even n := by rw [Nat.even_iff]; omega
  have hnpos : 0 < n := by omega
  have hnC : C < n := by omega
  have hkey := h n
  unfold powProfile interProfile at hkey
  rw [if_neg hodd] at hkey
  have hpow : 0 < n ^ k := by positivity
  have hlt : C * n ^ k < n * n ^ k := (Nat.mul_lt_mul_right hpow).mpr hnC
  rw [pow_succ] at hkey
  have heq : n ^ k * n = n * n ^ k := by ring
  omega

/-- **Main theorem.** For every `k ≥ 1` there exists a growth profile `g`
lying strictly between `n ↦ n^k` and `n ↦ n^(k+1)` in the domination preorder. -/
theorem exists_strict_intermediate_profile {k : ℕ} (hk : 1 ≤ k) :
    ∃ g : ℕ → ℕ,
      Dominates (powProfile k) g ∧ ¬ Dominates g (powProfile k) ∧
      Dominates g (powProfile (k + 1)) ∧ ¬ Dominates (powProfile (k + 1)) g :=
  ⟨interProfile k, dominates_pow_inter hk, not_dominates_inter_pow k,
    dominates_inter_pow k, not_dominates_pow_inter k⟩

end GrowthProfiles
