  "interactive_demos": [
    {
      "title": "The Secret Clock: Interactive Apparition-Order Explorer",
      "description": "An interactive widget where you choose a base b and a prime p and watch two independent computations agree: a forward scan of b^n - 1 marking where p first appears (the rank of apparition), and a step-by-step cycle of powers of b inside Z/pZ returning to 1 (the multiplicative order). The widget displays the apparition lattice row for p, confirms the Apparition-Order Bridge entryPoint(p) = order(b mod p), and verifies Fermat descent entryPoint(p) | p - 1, all live in the browser.",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>The Secret Clock - Apparition-Order Explorer</title>\n<style>\n  body{font-family:-apple-system,Segoe UI,Roboto,sans-serif;margin:0;background:#0e1116;color:#e6edf3;padding:24px;}\n  h1{font-weight:700;font-size:1.6rem;}\n  .card{background:#161b22;border:1px solid #30363d;border-radius:12px;padding:18px;margin:14px 0;}\n  label{margin-right:8px;}\n  input{width:80px;background:#0d1117;color:#e6edf3;border:1px solid #30363d;border-radius:6px;padding:6px;}\n  button{background:#238636;color:#fff;border:none;border-radius:6px;padding:8px 16px;cursor:pointer;font-size:1rem;margin-left:8px;}\n  button:hover{background:#2ea043;}\n  .result{font-size:1.1rem;margin-top:8px;}\n  .ok{color:#3fb950;font-weight:700;}\n  .bad{color:#f85149;font-weight:700;}\n  .cell{display:inline-block;width:26px;height:26px;line-height:26px;text-align:center;margin:1px;border-radius:4px;background:#21262d;font-size:.75rem;}\n  .hit{background:#1f6feb;color:#fff;font-weight:700;}\n  .mono{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;}\n</style>\n</head>\n<body>\n<h1>The Secret Clock &mdash; Apparition&ndash;Order Explorer</h1>\n<p>For a prime <span class=\"mono\">p</span> not dividing the base <span class=\"mono\">b</span>, the rank of apparition of <span class=\"mono\">p</span> in <span class=\"mono\">b<sup>n</sup>&minus;1</span> equals the multiplicative order of <span class=\"mono\">b</span> modulo <span class=\"mono\">p</span>, and it always divides <span class=\"mono\">p&minus;1</span>.</p>\n<div class=\"card\">\n  <label>base b:</label><input id=\"b\" type=\"number\" value=\"2\">\n  <label>prime p:</label><input id=\"p\" type=\"number\" value=\"7\">\n  <button onclick=\"run()\">Compute</button>\n  <div id=\"out\" class=\"result\"></div>\n</div>\n<div class=\"card\">\n  <div>Order cycle inside Z/pZ (powers of b until they return to 1):</div>\n  <div id=\"cycle\" class=\"mono result\"></div>\n</div>\n<div class=\"card\">\n  <div>Apparition lattice row for p (blue = p divides b<sup>n</sup>&minus;1):</div>\n  <div id=\"lattice\"></div>\n</div>\n<script>\nfunction isPrime(p){if(p<2)return false;for(let d=2;d*d<=p;d++)if(p%d===0)return false;return true;}\nfunction order(b,p){let v=((b%p)+p)%p,k=1;if(v===0)return 0;while(v!==1){v=(v*b)%p;k++;if(k>p)return -1;}return k;}\nfunction entryScan(b,p,lim){let v=1;for(let k=1;k<=lim;k++){v=(v*b)%p;if(((v-1)%p+p)%p===0)return k;}return -1;}\nfunction run(){\n  const b=parseInt(document.getElementById('b').value);\n  const p=parseInt(document.getElementById('p').value);\n  const out=document.getElementById('out');\n  if(!isPrime(p)){out.innerHTML='<span class=\"bad\">p must be prime.</span>';return;}\n  if(b%p===0){out.innerHTML='<span class=\"bad\">p must not divide b.</span>';return;}\n  const ord=order(b,p), ep=entryScan(b,p,4*p);\n  const bridge=(ord===ep), descent=((p-1)%ord===0);\n  out.innerHTML='order(b mod p) = <b>'+ord+'</b> &nbsp; entryPoint(p) = <b>'+ep+'</b><br>'+\n    'Bridge entryPoint = order: <span class=\"'+(bridge?'ok':'bad')+'\">'+bridge+'</span><br>'+\n    'Fermat descent entryPoint | (p-1='+(p-1)+'): <span class=\"'+(descent?'ok':'bad')+'\">'+descent+'</span>';\n  let c='', v=b%p;\n  for(let k=1;k<=ord;k++){c+='b^'+k+'='+v+(v===1?' &#10004;':'')+'&nbsp;&nbsp;';v=(v*b)%p;}\n  document.getElementById('cycle').innerHTML=c;\n  let lat='';\n  for(let n=1;n<=Math.min(36,4*ep>0?4*ep:36);n++){\n    const hit=((Math.round(Math.pow(b,n))%p)!==undefined)?((modpow(b,n,p)-1)%p===0):false;\n    lat+='<span class=\"cell '+(hit?'hit':'')+'\">'+n+'</span>';\n  }\n  document.getElementById('lattice').innerHTML=lat;\n}\nfunction modpow(b,e,m){let r=1;b%=m;while(e>0){if(e&1)r=(r*b)%m;b=(b*b)%m;e>>=1;}return r;}\nrun();\n</script>\n</body>\n</html>\n"
