  "algorithms": [
    {
      "name": "Rank of Apparition via Multiplicative Order (Apparition-Order Bridge)",
      "description": "Computes the entry point (rank of apparition) of a prime p in the Mersenne sequence b^n - 1 without ever scanning the sequence. By the Apparition-Order Bridge, entryPoint(p) = order of b in Z/pZ, and by Fermat descent this order divides p - 1. The algorithm therefore computes order(b mod p) directly. The optimal version factors p - 1 and, for each prime power dividing it, removes factors until the power of b first hits 1, giving O(log p) modular exponentiations of cost O(log p) each, i.e. O(log^2 p) bit operations (plus the cost of factoring p - 1). The naive incremental scan shown here runs in O(order) modular multiplications and is presented for transparency.",
      "pseudocode": "function entryPoint(b, p):            # p prime, p does not divide b\n    assert b mod p != 0\n    val <- b mod p\n    k   <- 1\n    while val != 1:\n        val <- (val * b) mod p\n        k   <- k + 1\n    return k                           # = order(b mod p) = entryPoint(p)\n\n# Optimal variant using Fermat descent (entryPoint | p-1):\nfunction entryPointFast(b, p):\n    e <- p - 1\n    for (q, a) in factorize(p - 1):    # q^a || p-1\n        e <- e / q^a\n        g <- pow(b, e, p)\n        while g != 1:\n            g <- pow(g, q, p)\n            e <- e * q\n    return e",
      "code": "from __future__ import annotations\nfrom typing import Dict\n\ndef factorize(m: int) -> Dict[int, int]:\n    \"\"\"Prime factorization of m as {prime: exponent}.\"\"\"\n    f: Dict[int, int] = {}\n    d = 2\n    while d * d <= m:\n        while m % d == 0:\n            f[d] = f.get(d, 0) + 1\n            m //= d\n        d += 1\n    if m > 1:\n        f[m] = f.get(m, 0) + 1\n    return f\n\ndef entry_point_fast(b: int, p: int) -> int:\n    \"\"\"entryPoint of p in b^n - 1, via order(b mod p) using Fermat descent.\n    Assumes p is prime and p does not divide b.\"\"\"\n    b %= p\n    assert b != 0\n    e = p - 1\n    for q, a in factorize(p - 1).items():\n        e //= q ** a\n        g = pow(b, e, p)\n        while g != 1:\n            g = pow(g, q, p)\n            e *= q\n    return e\n"
    },
    {
      "name": "Support Reconstruction from a Single Entry Point",
      "description": "Given the entry point e = entryPoint(p) of a prime p in a strong divisibility sequence, reconstructs the entire (global) apparition support up to a bound N. The support theorem guarantees that { n <= N : p | a(n) } = { e, 2e, 3e, ... } intersect [1, N], so the support is generated in O(N / e) steps without any divisibility tests against the sequence terms. This is the 'global sections' computation: one local number determines the entire infinite footprint of p.",
      "pseudocode": "function support(e, N):               # e = entryPoint(p), bound N\n    if e = 0: return {}                # p never appears\n    S <- empty list\n    n <- e\n    while n <= N:\n        append n to S\n        n <- n + e\n    return S",
      "code": "from __future__ import annotations\nfrom typing import List\n\ndef support(e: int, N: int) -> List[int]:\n    \"\"\"All indices n in [1, N] where the prime with entry point e appears.\n    By the support theorem this is exactly the multiples of e.\"\"\"\n    if e == 0:\n        return []\n    return list(range(e, N + 1, e))\n"
    }
