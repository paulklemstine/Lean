      "name": "Support-Sheaf Global Sections (Mersenne and Fibonacci)",
      "description": "Demonstrates the support theorem by independently computing the set of indices n at which a prime p divides the sequence term (b^n - 1 for Mersenne, F_n for Fibonacci) and comparing it against the principal arithmetic progression of multiples of the entry point. The two sets agree exactly, confirming that one local number reconstructs the whole global apparition pattern.",
      "code": "from __future__ import annotations\nfrom typing import List, Optional\n\ndef entry_point_mersenne(b: int, p: int, limit: int = 100000) -> Optional[int]:\n    val = 1\n    for k in range(1, limit + 1):\n        val = (val * b) % p\n        if (val - 1) % p == 0:\n            return k\n    return None\n\ndef fib_mod(n: int, p: int) -> int:\n    a, b = 0, 1\n    for _ in range(n):\n        a, b = b, (a + b) % p\n    return a\n\ndef entry_point_fibonacci(p: int, limit: int = 100000) -> Optional[int]:\n    a, b = 0, 1\n    for k in range(1, limit + 1):\n        a, b = b, (a + b) % p\n        if a % p == 0:\n            return k\n    return None\n\ndef check_support(observed: List[int], e: int, N: int) -> bool:\n    predicted = list(range(e, N + 1, e))\n    return observed == predicted\n\ndef main() -> None:\n    b, p, N = 2, 7, 24\n    e = entry_point_mersenne(b, p)\n    obs = [n for n in range(1, N + 1) if (pow(b, n, p) - 1) % p == 0]\n    print(f'Mersenne {b}^n-1, p={p}: entryPoint={e}, support={obs}')\n    assert e is not None and check_support(obs, e, N)\n\n    p, N = 11, 40\n    e = entry_point_fibonacci(p)\n    obs = [n for n in range(1, N + 1) if fib_mod(n, p) == 0]\n    print(f'Fibonacci, p={p}: entryPoint={e}, support={obs}')\n    assert e is not None and check_support(obs, e, N)\n    print('Support theorem confirmed for both families.')\n\nif __name__ == '__main__':\n    main()\n"
    }
