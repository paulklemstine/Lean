import Mathlib

/-! # Carmichael tail: the cyclotomic primitive part and its size

Development supporting the composite case of Carmichael's primitive-divisor theorem
for Fibonacci numbers (`Shared.CarmichaelProof.fib_carmichael_composite`), for the
infinite tail `n > 10000`.

Mathematical structure (validated numerically):
* `cycloFibR n = ∏_{d ∣ n} F_d ^ μ(n/d)` is, for `n ≥ 1`, the value of the
  homogeneous cyclotomic polynomial of the Fibonacci/Lucas pair.  It is a positive
  integer dividing `F n`.
* By Binet's formula `cycloFibR n = goldenRatio ^ (totient n) · R n` where the
  correction `R n = ∏_{d ∣ n} (1 - (ψ/φ)^d) ^ μ(n/d)` satisfies `1/5 ≤ R n`.
* Hence `goldenRatio ^ (totient n) ≤ 5 · cycloFibR n`.

-- !-- Lab Notebook -- !--
-- Hypothesis : The cyclotomic value `Φ_n = ∏_{d∣n} F_d^{μ(n/d)}` has size `≈ φ^{φ(n)}`,
--   so it eventually dwarfs `n`; this is the engine of Carmichael's primitive-divisor theorem.
-- Result    : Proved `sorry`-free that `φ^{totient n} ≤ 5·Φ_n` (`goldenRatio_totient_le_cycloFibR`),
--   via the exact Binet factorisation `Φ_n = φ^{totient n}·R n` and the analytic bound `R n ≥ 1/5`.
-- Insight   : `R n = ∏_{d∣n}(1-(ψ/φ)^d)^{μ(n/d)}` is bounded below WITHOUT infinite products:
--   a per-factor `±1` sign split plus the finite Weierstrass inequality `∏(1-a)≥1-∑a` and a
--   geometric tail suffice, since divisors form a finite set.  The two arithmetic-function
--   identities `∑_{d∣n}μ(n/d)=0` and `∑_{d∣n}d·μ(n/d)=φ(n)` collapse the `√5` and exponent terms.
-- Failure analysis : Forgetting `open Real` silently auto-bound `goldenRatio` as an implicit
--   variable, turning the size lemma into a false universally-quantified statement (a spurious
--   "disproof" with `m=100`).  Lesson: always confirm `goldenRatio` resolves to `Real.goldenRatio`.
-- !--
-/

open scoped BigOperators
open Nat ArithmeticFunction Real

set_option maxHeartbeats 2000000

noncomputable def cycloFibR (n : ℕ) : ℝ :=
  ∏ d ∈ n.divisors, (Nat.fib d : ℝ) ^ (moebius (n / d))

-- !-- The Binet correction factor `R n = ∏ (1 - (ψ/φ)^d)^{μ(n/d)}`. -- !--
noncomputable def binetCorr (n : ℕ) : ℝ :=
  ∏ d ∈ n.divisors, (1 - (goldenConj / goldenRatio) ^ d) ^ (moebius (n / d))

/-
Binet identity: `Φ_n = φ^{totient n} · R n`.
-/
lemma cycloFibR_eq (n : ℕ) (hn : 2 ≤ n) :
    cycloFibR n = goldenRatio ^ (Nat.totient n) * binetCorr n := by
  -- By definition of $cycloFibR$ and $binetCorr$, we can write
  have h_def : cycloFibR n = (∏ d ∈ n.divisors, (goldenRatio ^ d / Real.sqrt 5) ^ (moebius (n / d))) * binetCorr n := by
    unfold cycloFibR binetCorr;
    rw [ ← Finset.prod_mul_distrib, Finset.prod_congr rfl ];
    intro d hd; rw [ ← mul_zpow ] ; congr; norm_num [ Real.coe_fib_eq ] ; ring;
    rw [ show ( 1 / 2 + Real.sqrt 5 * ( -1 / 2 ) ) = ( 1 / 2 + Real.sqrt 5 * ( 1 / 2 ) ) * ( Real.sqrt 5 * ( 1 / 2 + Real.sqrt 5 * ( 1 / 2 ) ) ⁻¹ * ( -1 / 2 ) + ( 1 / 2 + Real.sqrt 5 * ( 1 / 2 ) ) ⁻¹ * ( 1 / 2 ) ) by nlinarith [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ), mul_inv_cancel₀ ( show ( 1 / 2 + Real.sqrt 5 * ( 1 / 2 ) ) ≠ 0 by positivity ) ] ] ; rw [ mul_pow ] ; ring;
  -- We'll use that $\sum_{d \mid n} \mu(n/d) \cdot d = \varphi(n)$ for $n \geq 2$.
  have h_sum : ∑ d ∈ n.divisors, (moebius (n / d)) * (d : ℤ) = (Nat.totient n : ℤ) := by
    have h_sum : ∑ d ∈ n.divisors, (moebius d) * (n / d : ℤ) = (Nat.totient n : ℤ) := by
      have h_sum : ∑ d ∈ n.divisors, (moebius d) * (n / d : ℤ) = ∑ d ∈ n.divisors, (moebius d) * (∑ e ∈ Nat.divisors (n / d), Nat.totient e) := by
        exact Finset.sum_congr rfl fun x hx => by rw [ Nat.sum_totient ] ; norm_cast;
      -- By interchanging the order of summation, we can rewrite the right-hand side.
      have h_interchange : ∑ d ∈ n.divisors, (moebius d) * (∑ e ∈ Nat.divisors (n / d), Nat.totient e) = ∑ e ∈ n.divisors, (∑ d ∈ Nat.divisors (n / e), (moebius d)) * Nat.totient e := by
        simp +decide only [cast_sum, Finset.mul_sum _ _ _, Finset.sum_mul];
        rw [ Finset.sum_sigma', Finset.sum_sigma' ];
        apply Finset.sum_bij (fun x _ => ⟨x.snd, x.fst⟩) _ _ _ _ <;> simp +contextual [ Nat.divisors_mul ];
        · exact fun a ha₁ ha₂ ha₃ ha₄ ha₅ => ⟨ dvd_of_mul_left_dvd ha₃, Nat.dvd_div_of_mul_dvd <| by simpa only [ mul_comm ] using ha₃, Nat.ne_of_gt <| Nat.pos_of_dvd_of_pos ( dvd_of_mul_left_dvd ha₃ ) <| pos_of_gt hn, Nat.le_of_dvd ( pos_of_gt hn ) <| dvd_of_mul_left_dvd ha₃ ⟩;
        · bound;
        · exact fun b hb₁ hb₂ hb₃ hb₄ hb₅ => ⟨ b.2, b.1, ⟨ dvd_of_mul_left_dvd hb₃, Nat.dvd_div_of_mul_dvd <| by simpa only [ mul_comm ] using hb₃, Nat.ne_of_gt <| Nat.pos_of_dvd_of_pos ( dvd_of_mul_left_dvd hb₃ ) <| pos_of_gt hn, Nat.le_of_dvd ( pos_of_gt hn ) <| dvd_of_mul_left_dvd hb₃ ⟩, rfl ⟩;
      -- By the properties of the Möbius function, we know that $\sum_{d \mid m} \mu(d) = 0$ for $m > 1$.
      have h_moebius_sum : ∀ m > 1, ∑ d ∈ Nat.divisors m, (moebius d) = 0 := by
        intros m hm
        have h_moebius_sum : ∑ d ∈ Nat.divisors m, (moebius d) = (ArithmeticFunction.moebius * ArithmeticFunction.zeta) m := by
          simp +decide [ ArithmeticFunction.moebius, ArithmeticFunction.zeta ];
          rw [ Nat.sum_divisorsAntidiagonal fun x y => if y = 0 then 0 else if Squarefree x then ( -1 : ℤ ) ^ cardFactors x else 0 ];
          exact Finset.sum_congr rfl fun x hx => by rw [ if_neg ( Nat.ne_of_gt ( Nat.div_pos ( Nat.le_of_dvd hm.le ( Nat.dvd_of_mem_divisors hx ) ) ( Nat.pos_of_mem_divisors hx ) ) ) ] ;
        simp_all +decide [ ArithmeticFunction.moebius_mul_coe_zeta ];
        exact if_neg hm.ne';
      rw [ h_sum, h_interchange, Finset.sum_eq_single n ] <;> norm_num;
      · norm_num [ Nat.div_self ( by linarith : 0 < n ) ];
      · exact fun b hb₁ hb₂ hb₃ => Or.inl <| h_moebius_sum _ <| Nat.one_lt_iff_ne_zero_and_ne_one.mpr ⟨ Nat.ne_of_gt <| Nat.div_pos ( Nat.le_of_dvd ( by positivity ) hb₁ ) <| Nat.pos_of_dvd_of_pos hb₁ <| by positivity, fun hb₄ => hb₃ <| by nlinarith [ Nat.div_mul_cancel hb₁ ] ⟩;
      · grind +revert;
    rw [ ← h_sum, ← Nat.sum_div_divisors ];
    exact Finset.sum_congr rfl fun x hx => by rw [ Nat.div_div_self ] <;> aesop;
  -- Apply the properties of exponents to combine the terms.
  have h_exp : (∏ d ∈ n.divisors, (goldenRatio ^ d / Real.sqrt 5) ^ (moebius (n / d))) = (goldenRatio ^ (∑ d ∈ n.divisors, (moebius (n / d)) * (d : ℤ))) / (Real.sqrt 5) ^ (∑ d ∈ n.divisors, (moebius (n / d))) := by
    have h_sum : ∀ {S : Finset ℕ} {f : ℕ → ℤ}, (∏ d ∈ S, (goldenRatio ^ d) ^ (f d)) = (goldenRatio ^ (∑ d ∈ S, (f d) * (d : ℤ))) ∧ (∏ d ∈ S, (Real.sqrt 5) ^ (f d)) = (Real.sqrt 5) ^ (∑ d ∈ S, (f d)) := by
      intros S f; induction S using Finset.induction <;> simp_all +decide [ zpow_add₀, zpow_mul' ] ;
      rw [ ← zpow_natCast, ← zpow_mul, zpow_add₀ ( by positivity ) ] ; ring;
    rw [ ← h_sum.1, ← h_sum.2, ← Finset.prod_div_distrib ];
    exact Finset.prod_congr rfl fun x hx => by rw [ div_zpow ] ;
  -- We'll use that $\sum_{d \mid n} \mu(n/d) = 0$ for $n \geq 2$.
  have h_sum_zero : ∑ d ∈ n.divisors, (moebius (n / d)) = 0 := by
    have h_sum_zero : ∑ d ∈ n.divisors, (moebius d) = (ArithmeticFunction.moebius * ArithmeticFunction.zeta) n := by
      simp +decide [ ArithmeticFunction.moebius, ArithmeticFunction.zeta ];
      rw [ Nat.sum_divisorsAntidiagonal fun x y => if y = 0 then 0 else if Squarefree x then ( -1 : ℤ ) ^ cardFactors x else 0 ];
      exact Finset.sum_congr rfl fun x hx => by rw [ if_neg ( Nat.ne_of_gt ( Nat.div_pos ( Nat.le_of_dvd ( by positivity ) ( Nat.dvd_of_mem_divisors hx ) ) ( Nat.pos_of_mem_divisors hx ) ) ) ] ;
    simp_all +decide [ ArithmeticFunction.moebius_mul_coe_zeta ];
    exact if_neg ( by linarith );
  aesop

/-
Analytic correction bound: `1/5 ≤ R n`.
-/
lemma binetCorr_ge (n : ℕ) (hn : 2 ≤ n) :
    (1 : ℝ) / 5 ≤ binetCorr n := by
  have h_prod_ge : binetCorr n ≥ ((1 - (-goldenConj / goldenRatio)) / (1 + (-goldenConj / goldenRatio))) * (1 - 2 * ∑ d ∈ n.divisors.erase 1, (-(goldenConj / goldenRatio)) ^ d) := by
    have h_prod_ge : binetCorr n ≥ ((1 - (-goldenConj / goldenRatio)) / (1 + (-goldenConj / goldenRatio))) * ∏ d ∈ n.divisors.erase 1, (1 - (-(goldenConj / goldenRatio)) ^ d) / (1 + (-(goldenConj / goldenRatio)) ^ d) := by
      have h_prod_ge : ∀ d ∈ n.divisors, (1 - (goldenConj / goldenRatio) ^ d) ^ (moebius (n / d)) ≥ (1 - (-(goldenConj / goldenRatio)) ^ d) / (1 + (-(goldenConj / goldenRatio)) ^ d) := by
        intro d hd
        have h_abs : |(goldenConj / goldenRatio) ^ d| ≤ (-(goldenConj / goldenRatio)) ^ d := by
          rw [ abs_pow, abs_of_nonpos ];
          exact div_nonpos_of_nonpos_of_nonneg ( by ring_nf; nlinarith [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ] ) ( by ring_nf; positivity )
        have h_pos : 0 < 1 - (goldenConj / goldenRatio) ^ d := by
          have h_pos : |goldenConj / goldenRatio| < 1 := by
            norm_num [ abs_div, abs_of_pos, goldenRatio, goldenConj ];
            rw [ div_lt_iff₀ ] <;> cases abs_cases ( 1 - Real.sqrt 5 ) <;> cases abs_cases ( 1 + Real.sqrt 5 ) <;> nlinarith [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ];
          exact sub_pos_of_lt ( lt_of_abs_lt ( by simpa using pow_lt_one₀ ( abs_nonneg _ ) h_pos ( by aesop ) ) )
        have h_bounds : 1 - (-(goldenConj / goldenRatio)) ^ d ≤ 1 - (goldenConj / goldenRatio) ^ d ∧ 1 - (goldenConj / goldenRatio) ^ d ≤ 1 + (-(goldenConj / goldenRatio)) ^ d := by
          grind
        have h_moebius : moebius (n / d) ∈ ({-1, 0, 1} : Set ℤ) := by
          grind +suggestions
        have h_factor : (1 - (goldenConj / goldenRatio) ^ d) ^ (moebius (n / d)) ≥ (1 - (-(goldenConj / goldenRatio)) ^ d) / (1 + (-(goldenConj / goldenRatio)) ^ d) := by
          rcases h_moebius with ( h | h | h ) <;> norm_num [ h ];
          · rw [ inv_eq_one_div, div_le_div_iff₀ ] <;> nlinarith [ abs_le.mp h_abs ];
          · exact div_le_one_of_le₀ ( by linarith ) ( by linarith [ show 0 ≤ ( - ( goldenConj / goldenRatio ) ) ^ d by exact pow_nonneg ( neg_nonneg.mpr ( div_nonpos_of_nonpos_of_nonneg ( show goldenConj ≤ 0 by unfold goldenConj; nlinarith [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ] ) ( show 0 ≤ goldenRatio by unfold goldenRatio; positivity ) ) ) _ ] );
          · rw [ Set.mem_singleton_iff.mp h ] ; norm_num ; rw [ div_le_iff₀ ] <;> nlinarith [ abs_le.mp h_abs ] ;
        exact h_factor;
      refine' le_trans _ ( Finset.prod_le_prod _ h_prod_ge );
      · rw [ ← Finset.mul_prod_erase _ _ ( Nat.one_mem_divisors.mpr ( by linarith ) ) ] ; norm_num [ neg_div ] ;
      · intro d hd; rw [ div_nonneg_iff ] ; norm_num [ goldenRatio, goldenConj ] ; ring_nf; norm_num;
        field_simp;
        exact Or.inl ⟨ pow_le_one₀ ( div_nonneg ( by nlinarith [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ] ) ( by nlinarith [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ] ) ) ( div_le_one_of_le₀ ( by nlinarith [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ] ) ( by nlinarith [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ] ) ), add_nonneg zero_le_one ( pow_nonneg ( div_nonneg ( by nlinarith [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ] ) ( by nlinarith [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ] ) ) _ ) ⟩;
    have h_prod_ge : ∏ d ∈ n.divisors.erase 1, (1 - (-(goldenConj / goldenRatio)) ^ d) / (1 + (-(goldenConj / goldenRatio)) ^ d) ≥ 1 - ∑ d ∈ n.divisors.erase 1, 2 * (-(goldenConj / goldenRatio)) ^ d := by
      have h_prod_ge : ∀ d ∈ n.divisors.erase 1, (1 - (-(goldenConj / goldenRatio)) ^ d) / (1 + (-(goldenConj / goldenRatio)) ^ d) ≥ 1 - 2 * (-(goldenConj / goldenRatio)) ^ d := by
        intro d hd
        have h_pos : 0 ≤ (-(goldenConj / goldenRatio)) ^ d ∧ (-(goldenConj / goldenRatio)) ^ d ≤ 1 / 2 := by
          have h_pos : 0 ≤ (-(goldenConj / goldenRatio)) ∧ (-(goldenConj / goldenRatio)) ≤ 1 / 2 := by
            norm_num [ goldenRatio, goldenConj ];
            exact ⟨ div_nonpos_of_nonpos_of_nonneg ( by nlinarith [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ] ) ( by positivity ), by rw [ neg_div', div_le_iff₀ ] <;> nlinarith [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ] ⟩;
          exact ⟨ pow_nonneg h_pos.1 _, le_trans ( pow_le_of_le_one h_pos.1 ( by linarith ) ( by aesop ) ) h_pos.2 ⟩;
        rw [ ge_iff_le, le_div_iff₀ ] <;> nlinarith;
      refine' le_trans _ ( Finset.prod_le_prod _ h_prod_ge );
      · have h_prod_ge : ∀ {S : Finset ℕ} {a : ℕ → ℝ}, (∀ d ∈ S, 0 ≤ a d ∧ a d ≤ 1) → (∏ d ∈ S, (1 - a d)) ≥ 1 - ∑ d ∈ S, a d := by
          intros S a ha; induction S using Finset.induction <;> simp_all +decide [ Finset.sum_insert, Finset.prod_insert ] ;
          nlinarith [ show ∏ d ∈ ‹Finset ℕ›, ( 1 - a d ) ≤ 1 from Finset.prod_le_one ( fun _ _ => sub_nonneg.2 <| ha.2 _ ‹_› |>.2 ) fun _ _ => sub_le_self _ <| ha.2 _ ‹_› |>.1 ];
        apply h_prod_ge;
        intro d hd; constructor <;> norm_num [ goldenConj, goldenRatio ] at *;
        · exact pow_nonneg ( neg_nonneg_of_nonpos ( div_nonpos_of_nonpos_of_nonneg ( by nlinarith [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ] ) ( by positivity ) ) ) _;
        · field_simp;
          refine' le_trans ( mul_le_mul_of_nonneg_left ( pow_le_pow_of_le_one _ _ _ ) zero_le_two ) _ <;> norm_num;
          any_goals exact Nat.succ_le_of_lt ( Nat.lt_of_le_of_ne ( Nat.pos_of_dvd_of_pos hd.2.1 ( pos_of_gt hn ) ) ( Ne.symm hd.1 ) );
          · exact div_nonpos_of_nonpos_of_nonneg ( by nlinarith [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ] ) ( by positivity );
          · rw [ neg_div', div_le_iff₀ ] <;> nlinarith [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ];
          · norm_num [ div_pow ];
            rw [ mul_div, div_le_iff₀ ] <;> nlinarith only [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ];
      · intro d hd; ring_nf; norm_num [ goldenRatio, goldenConj ] ;
        field_simp;
        exact le_trans ( mul_le_mul_of_nonneg_left ( pow_le_pow_of_le_one ( by exact div_nonneg ( by nlinarith [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ] ) ( by nlinarith [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ] ) ) ( by rw [ div_le_iff₀ ] <;> nlinarith [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ] ) ( show d ≥ 1 from Nat.pos_of_mem_divisors ( Finset.mem_of_mem_erase hd ) ) ) zero_le_two ) ( by norm_num ; nlinarith [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ), mul_div_cancel₀ ( Real.sqrt 5 + -1 ) ( show ( 1 + Real.sqrt 5 ) ≠ 0 by positivity ) ] );
    simp_all +decide [ Finset.mul_sum _ _ _ ];
    refine le_trans ?_ ‹_›;
    gcongr;
    · field_simp;
      exact div_nonneg ( by linarith [ Real.sqrt_nonneg 5 ] ) ( by linarith [ Real.sqrt_nonneg 5 ] );
    · linarith;
  -- Since $s = -t$, we have $1 - 2 * \sum_{d \in \text{divisors}(n) \setminus \{1\}} s^d \geq 1 - 2s^2/(1-s)$.
  have h_sum_bound : 1 - 2 * ∑ d ∈ n.divisors.erase 1, (-(goldenConj / goldenRatio)) ^ d ≥ 1 - 2 * (-(goldenConj / goldenRatio)) ^ 2 / (1 - (-(goldenConj / goldenRatio))) := by
    have h_sum_bound : ∑ d ∈ n.divisors.erase 1, (-(goldenConj / goldenRatio)) ^ d ≤ (-(goldenConj / goldenRatio)) ^ 2 / (1 - (-(goldenConj / goldenRatio))) := by
      have h_sum_bound : ∑ d ∈ n.divisors.erase 1, (-(goldenConj / goldenRatio)) ^ d ≤ ∑' k : ℕ, (-(goldenConj / goldenRatio)) ^ (k + 2) := by
        have h_sum_bound : ∑ d ∈ n.divisors.erase 1, (-(goldenConj / goldenRatio)) ^ d ≤ ∑ d ∈ Finset.Icc 2 n, (-(goldenConj / goldenRatio)) ^ d := by
          refine Finset.sum_le_sum_of_subset_of_nonneg ?_ ?_;
          · exact fun x hx => Finset.mem_Icc.mpr ⟨ Nat.lt_of_le_of_ne ( Nat.pos_of_mem_divisors ( Finset.mem_of_mem_erase hx ) ) ( Ne.symm <| by aesop ), Nat.le_of_dvd ( by linarith ) <| Nat.dvd_of_mem_divisors <| Finset.mem_of_mem_erase hx ⟩;
          · intro i hi₁ hi₂; rcases Nat.even_or_odd' i with ⟨ k, rfl | rfl ⟩ <;> norm_num [ pow_add, pow_mul ] ;
            · positivity;
            · exact mul_nonpos_of_nonneg_of_nonpos ( pow_nonneg ( sq_nonneg _ ) _ ) ( div_nonpos_of_nonpos_of_nonneg ( by ring_nf; nlinarith [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ] ) ( by ring_nf; positivity ) );
        refine le_trans h_sum_bound ?_;
        erw [ Finset.sum_Ico_eq_sum_range ];
        norm_num [ add_comm, add_left_comm, add_assoc ];
        refine' Summable.sum_le_tsum _ _ _;
        · norm_num [ goldenRatio, goldenConj ];
          intro i hi; rw [ neg_div', div_pow ] ;
          exact div_nonneg ( pow_nonneg ( by nlinarith [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ] ) _ ) ( pow_nonneg ( by positivity ) _ );
        · refine' Summable.comp_injective ( summable_geometric_of_abs_lt_one _ ) ( add_left_injective 2 );
          norm_num [ abs_div, abs_neg, abs_of_pos, goldenRatio_pos, goldenConj ];
          rw [ div_lt_iff₀ ] <;> cases abs_cases ( 1 - Real.sqrt 5 ) <;> cases abs_cases ( 1 + Real.sqrt 5 ) <;> nlinarith [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ];
      convert h_sum_bound using 1;
      norm_num [ pow_add, tsum_mul_left ];
      rw [ tsum_mul_right, tsum_geometric_of_abs_lt_one ] <;> norm_num [ abs_div, abs_of_pos ];
      · ring;
      · rw [ div_lt_iff₀ ] <;> cases abs_cases ( 1 - Real.sqrt 5 ) <;> cases abs_cases ( 1 + Real.sqrt 5 ) <;> nlinarith [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ];
    simpa only [ mul_div_assoc ] using sub_le_sub_left ( mul_le_mul_of_nonneg_left h_sum_bound zero_le_two ) _;
  refine le_trans ?_ h_prod_ge;
  refine le_trans ?_ ( mul_le_mul_of_nonneg_left h_sum_bound ?_ ) <;> norm_num [ goldenRatio, goldenConj ];
  · field_simp;
    rw [ le_div_iff₀ ] <;> nlinarith only [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ];
  · exact div_nonneg ( sub_nonneg.2 <| by rw [ div_le_iff₀ ] <;> nlinarith only [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ] ) ( add_nonneg zero_le_one <| div_nonneg ( by nlinarith only [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ] ) <| by positivity )

/-- The pivotal size bound: `φ^{totient n} ≤ 5 · Φ_n`. -/
lemma goldenRatio_totient_le_cycloFibR (n : ℕ) (hn : 2 ≤ n) :
    goldenRatio ^ (Nat.totient n) ≤ 5 * cycloFibR n := by
  rw [cycloFibR_eq n hn]
  have h1 : (1 : ℝ) / 5 ≤ binetCorr n := binetCorr_ge n hn
  have hgr0 : (0 : ℝ) < goldenRatio := by
    rw [goldenRatio]; positivity
  have hgr : (0 : ℝ) < goldenRatio ^ (Nat.totient n) := by positivity
  nlinarith [hgr, h1]