import Catalog.Bridges.StrongDivisibilitySequences

/-! # Primitive divisors at prime indices of strong divisibility sequences

For a strong divisibility sequence `s`, if `p` divides `s.a n` at a *prime* index `n`
but does not divide `s.a 1`, then `p` is a primitive divisor at index `n`.  The proof is
a direct application of the entry-point API in `Catalog/Bridges/StrongDivisibilitySequences.lean`:
the entry point divides `n`, primality forces it to be `1` or `n`, the `1` case is excluded
because `p ∤ s.a 1`, and the entry-point/primitivity equivalence finishes the argument.
-/

namespace StrongDivSeq

variable (s : StrongDivSeq)

/-- The entry point of `p` is never `1` when `p` does not divide `s.a 1`. -/
theorem entryPoint_ne_one {p : ℕ} (h1 : ¬ p ∣ s.a 1) : s.entryPoint p ≠ 1 := by
  intro h
  have hex : ∃ k, 0 < k ∧ p ∣ s.a k := by
    by_contra hex
    simp [entryPoint, hex] at h
  have hp := s.entryPoint_isPrimitive hex
  rw [h] at hp
  exact h1 hp.1

/-- If `p` divides `s.a n` at a prime index `n` but not `s.a 1`, then `p` is a primitive
divisor at index `n`. -/
theorem isPrimitive_of_prime_index {p n : ℕ} (hn : Nat.Prime n) (hpn : p ∣ s.a n)
    (h1 : ¬ p ∣ s.a 1) : s.IsPrimitive p n := by
  have hex : ∃ k, 0 < k ∧ p ∣ s.a k := ⟨n, hn.pos, hpn⟩
  have hdvd : s.entryPoint p ∣ n := (s.dvd_iff_entryPoint_dvd hex n).1 hpn
  have hdich : s.entryPoint p = 1 ∨ s.entryPoint p = n :=
    hn.eq_one_or_self_of_dvd _ hdvd
  have heq : s.entryPoint p = n := by
    cases hdich with
    | inl h => exact absurd h (s.entryPoint_ne_one h1)
    | inr h => exact h
  exact (s.primitive_iff_entryPoint_eq hn.pos hex).2 heq

end StrongDivSeq
