import Mathlib
import Algebra.BerggrenLorentz.Core

/-!
# Tropical Height on the Berggren Tree

This file develops the **tropical-height core** for the Berggren tree of
Pythagorean triples, building on the Berggren/Lorentz infrastructure in
`Algebra.BerggrenLorentz.Core`.

We work with integer triples `t : ℤ × ℤ × ℤ`, where `t.1`, `t.2.1`, `t.2.2`
are the two legs and the hypotenuse.  The **tropical height** is the
coordinatewise maximum
`tropHeight t = max t.1 (max t.2.1 t.2.2)`.

The main results are:

1. `tropHeight_eq_hypotenuse`: on a positive Pythagorean triple the tropical
   height collapses to the hypotenuse `t.2.2`, since the hypotenuse dominates
   both legs (`BerggrenLorentz.pythag_hyp_ge_leg_a/b`).
2. Exact one-step child formulas (`tropHeight_childA/B/C`): the tropical height
   of each Berggren child is the explicit linear hypotenuse expression.
3. Strict one-step monotonicity (`tropHeight_lt_childA/B/C`): each child has
   strictly larger tropical height.
4. A minimal path section: `childStep`, `applyPath`, and strict growth along any
   nonempty path (`tropHeight_lt_applyPath`).
-/

namespace Tropical.BerggrenTree

/-- An integer triple `(a, b, c)`. -/
abbrev Triple := ℤ × ℤ × ℤ

/-- A triple is a *positive Pythagorean* triple when all three coordinates are
positive and it lies on the light cone `a² + b² = c²`. -/
def IsPosPythag (t : Triple) : Prop :=
  0 < t.1 ∧ 0 < t.2.1 ∧ 0 < t.2.2 ∧ BerggrenLorentz.IsPythag t.1 t.2.1 t.2.2

/-- The tropical height of a triple: the coordinatewise maximum. -/
def tropHeight (t : Triple) : ℤ := max t.1 (max t.2.1 t.2.2)

/-- Triple-level Berggren child `A`. -/
def childA (t : Triple) : Triple := BerggrenLorentz.childA t.1 t.2.1 t.2.2

/-- Triple-level Berggren child `B`. -/
def childB (t : Triple) : Triple := BerggrenLorentz.childB t.1 t.2.1 t.2.2

/-- Triple-level Berggren child `C`. -/
def childC (t : Triple) : Triple := BerggrenLorentz.childC t.1 t.2.1 t.2.2

/-! ## Section 1: Tropical height collapses to the hypotenuse -/

/-- On a positive Pythagorean triple the tropical height equals the hypotenuse
coordinate `t.2.2`, because the hypotenuse dominates both legs. -/
theorem tropHeight_eq_hypotenuse (t : Triple) (h : IsPosPythag t) :
    tropHeight t = t.2.2 := by
  obtain ⟨ha, hb, hc, hpy⟩ := h
  have h1 : t.1 ≤ t.2.2 :=
    BerggrenLorentz.pythag_hyp_ge_leg_a t.1 t.2.1 t.2.2 hpy hb hc
  have h2 : t.2.1 ≤ t.2.2 :=
    BerggrenLorentz.pythag_hyp_ge_leg_b t.1 t.2.1 t.2.2 hpy ha hc
  unfold tropHeight
  omega

/-! ## Section 2: Children of positive Pythagorean triples are positive Pythagorean -/

/-- The `A`-child of a positive Pythagorean triple is positive Pythagorean. -/
theorem childA_isPosPythag (t : Triple) (h : IsPosPythag t) :
    IsPosPythag (childA t) := by
  obtain ⟨ha, hb, hc, hpy⟩ := h
  have h1 : t.1 ≤ t.2.2 :=
    BerggrenLorentz.pythag_hyp_ge_leg_a t.1 t.2.1 t.2.2 hpy hb hc
  have h2 : t.2.1 ≤ t.2.2 :=
    BerggrenLorentz.pythag_hyp_ge_leg_b t.1 t.2.1 t.2.2 hpy ha hc
  have hpy' := BerggrenLorentz.childA_preserves_pythag t.1 t.2.1 t.2.2 hpy
  refine ⟨?_, ?_, ?_, hpy'⟩ <;>
    simp only [childA, BerggrenLorentz.childA] <;> omega

/-- The `B`-child of a positive Pythagorean triple is positive Pythagorean. -/
theorem childB_isPosPythag (t : Triple) (h : IsPosPythag t) :
    IsPosPythag (childB t) := by
  obtain ⟨ha, hb, hc, hpy⟩ := h
  have h1 : t.1 ≤ t.2.2 :=
    BerggrenLorentz.pythag_hyp_ge_leg_a t.1 t.2.1 t.2.2 hpy hb hc
  have h2 : t.2.1 ≤ t.2.2 :=
    BerggrenLorentz.pythag_hyp_ge_leg_b t.1 t.2.1 t.2.2 hpy ha hc
  have hpy' := BerggrenLorentz.childB_preserves_pythag t.1 t.2.1 t.2.2 hpy
  refine ⟨?_, ?_, ?_, hpy'⟩ <;>
    simp only [childB, BerggrenLorentz.childB] <;> omega

/-- The `C`-child of a positive Pythagorean triple is positive Pythagorean. -/
theorem childC_isPosPythag (t : Triple) (h : IsPosPythag t) :
    IsPosPythag (childC t) := by
  obtain ⟨ha, hb, hc, hpy⟩ := h
  have h1 : t.1 ≤ t.2.2 :=
    BerggrenLorentz.pythag_hyp_ge_leg_a t.1 t.2.1 t.2.2 hpy hb hc
  have h2 : t.2.1 ≤ t.2.2 :=
    BerggrenLorentz.pythag_hyp_ge_leg_b t.1 t.2.1 t.2.2 hpy ha hc
  have hpy' := BerggrenLorentz.childC_preserves_pythag t.1 t.2.1 t.2.2 hpy
  refine ⟨?_, ?_, ?_, hpy'⟩ <;>
    simp only [childC, BerggrenLorentz.childC] <;> omega

/-! ## Section 3: Exact one-step child formulas -/

/-- Tropical height of the `A`-child: the explicit hypotenuse formula. -/
theorem tropHeight_childA (t : Triple) (h : IsPosPythag t) :
    tropHeight (childA t) = 2 * t.1 - 2 * t.2.1 + 3 * t.2.2 := by
  rw [tropHeight_eq_hypotenuse (childA t) (childA_isPosPythag t h)]
  rfl

/-- Tropical height of the `B`-child: the explicit hypotenuse formula. -/
theorem tropHeight_childB (t : Triple) (h : IsPosPythag t) :
    tropHeight (childB t) = 2 * t.1 + 2 * t.2.1 + 3 * t.2.2 := by
  rw [tropHeight_eq_hypotenuse (childB t) (childB_isPosPythag t h)]
  rfl

/-- Tropical height of the `C`-child: the explicit hypotenuse formula. -/
theorem tropHeight_childC (t : Triple) (h : IsPosPythag t) :
    tropHeight (childC t) = -2 * t.1 + 2 * t.2.1 + 3 * t.2.2 := by
  rw [tropHeight_eq_hypotenuse (childC t) (childC_isPosPythag t h)]
  rfl

/-! ## Section 4: Strict one-step monotonicity -/

/-- The `A`-child strictly increases tropical height. -/
theorem tropHeight_lt_childA (t : Triple) (h : IsPosPythag t) :
    tropHeight t < tropHeight (childA t) := by
  have key := h
  obtain ⟨ha, hb, hc, hpy⟩ := key
  have h2 : t.2.1 ≤ t.2.2 :=
    BerggrenLorentz.pythag_hyp_ge_leg_b t.1 t.2.1 t.2.2 hpy ha hc
  rw [tropHeight_eq_hypotenuse t h, tropHeight_childA t h]
  linarith

/-- The `B`-child strictly increases tropical height. -/
theorem tropHeight_lt_childB (t : Triple) (h : IsPosPythag t) :
    tropHeight t < tropHeight (childB t) := by
  have key := h
  obtain ⟨ha, hb, hc, hpy⟩ := key
  rw [tropHeight_eq_hypotenuse t h, tropHeight_childB t h]
  linarith

/-- The `C`-child strictly increases tropical height. -/
theorem tropHeight_lt_childC (t : Triple) (h : IsPosPythag t) :
    tropHeight t < tropHeight (childC t) := by
  have key := h
  obtain ⟨ha, hb, hc, hpy⟩ := key
  have h1 : t.1 ≤ t.2.2 :=
    BerggrenLorentz.pythag_hyp_ge_leg_a t.1 t.2.1 t.2.2 hpy hb hc
  rw [tropHeight_eq_hypotenuse t h, tropHeight_childC t h]
  linarith

/-! ## Section 5: Paths in the Berggren tree -/

/-- One step in the Berggren tree, indexed by a generator `0/1/2 = A/B/C`. -/
def childStep : Fin 3 → Triple → Triple
  | 0, t => childA t
  | 1, t => childB t
  | 2, t => childC t

/-- Apply a path (a list of generator indices) starting from a triple. -/
def applyPath : List (Fin 3) → Triple → Triple
  | [], t => t
  | i :: rest, t => applyPath rest (childStep i t)

/-- A single Berggren step preserves positive Pythagorean triples. -/
theorem childStep_isPosPythag (i : Fin 3) (t : Triple) (h : IsPosPythag t) :
    IsPosPythag (childStep i t) := by
  fin_cases i
  · exact childA_isPosPythag t h
  · exact childB_isPosPythag t h
  · exact childC_isPosPythag t h

/-- A single Berggren step strictly increases tropical height. -/
theorem tropHeight_lt_childStep (i : Fin 3) (t : Triple) (h : IsPosPythag t) :
    tropHeight t < tropHeight (childStep i t) := by
  fin_cases i
  · exact tropHeight_lt_childA t h
  · exact tropHeight_lt_childB t h
  · exact tropHeight_lt_childC t h

/-- Strict growth of tropical height along any nonempty path of Berggren steps,
starting from a positive Pythagorean triple. -/
theorem tropHeight_lt_applyPath :
    ∀ (p : List (Fin 3)) (t : Triple), p ≠ [] → IsPosPythag t →
      tropHeight t < tropHeight (applyPath p t)
  | [], _, hp, _ => absurd rfl hp
  | [i], t, _, h => by
      simpa [applyPath] using tropHeight_lt_childStep i t h
  | i :: j :: r, t, _, h => by
      have hstep := tropHeight_lt_childStep i t h
      have hpos := childStep_isPosPythag i t h
      have ih := tropHeight_lt_applyPath (j :: r) (childStep i t) (by simp) hpos
      exact lt_trans hstep (by simpa [applyPath] using ih)

end Tropical.BerggrenTree
