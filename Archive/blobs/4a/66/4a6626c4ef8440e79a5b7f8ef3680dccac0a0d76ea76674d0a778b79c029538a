import Mathlib

/-!
# Sharpened Fibonacci entry points via quadratic reciprocity

## Research context

The catalog already establishes (in
`Algebra.Tropical_p_adic_Valuation_Bounds_and_Lifting_the_Exponent_for_Fibonacci_Primitive_Divisors`)
the classical *coarse* entry-point bound

  `z(p) ∣ p^2 - 1`   for primes `p ∉ {2, 5}`   (`entry_point_dvd_sq_sub_one`),

where `z(p)` is the rank of apparition (the smallest `k > 0` with `p ∣ F k`).

This file **sharpens** that result to the genuinely two-sided statement controlled by the
residue of `p` modulo `5`:

  * `p ≡ ±1 (mod 5)`  ⟹  `p ∣ F (p-1)`,  hence `z(p) ∣ p - 1`;
  * `p ≡ ±2 (mod 5)`  ⟹  `p ∣ F (p+1)`,  hence `z(p) ∣ p + 1`.

Since `p^2 - 1 = (p-1)(p+1)`, this strictly refines the catalog bound: it pins down *which*
factor of `p^2 - 1` the entry point divides, purely from `p mod 5`.

## Method

The engine is **Binet's formula in an arbitrary commutative ring** (`fib_binet_ring`):
if `a + b = 1` and `a * b = -1` then `(a - b) * F n = a^n - b^n`.

* **Residue case.** When `5` is a square mod `p`, the "golden ratios" `a, b` live in `ZMod p`
  itself, both nonzero, so Fermat gives `a^(p-1) = b^(p-1) = 1` and Binet collapses
  `F (p-1)` to `0`.
* **Non-residue case.** When `5` is not a square mod `p`, the golden ratios live in the
  quadratic field `GF(p^2)`. The Frobenius `x ↦ x^p` swaps the two conjugate roots, so
  `a^p = b`, whence `a^(p+1) = a b = -1 = b^(p+1)` and Binet collapses `F (p+1)` to `0`.

The bridge `IsSquare (5 : ZMod p) ↔ p % 5 ∈ {1,4}` is quadratic reciprocity (`5 ≡ 1 mod 4`).

-- !-- Lab Notes -- !--
-- Hypothesis (confirmed numerically up to p < 60 during development):
--   z(p) | p-1  ⟺  p % 5 ∈ {1,4};   z(p) | p+1  ⟺  p % 5 ∈ {2,3}.
-- This matches the classical Fibonacci "law of apparition".
-- Insight: phrasing Binet over an *arbitrary* CommRing (rather than ℝ) is what lets the
--   same one-line two-step induction serve both the `ZMod p` case and the `GF(p^2)` case.
-- Failure analysis: an earlier attempt tried to import the catalog's Tropical Fibonacci
--   file to reuse `fibEntryPoint`; we instead keep this file self-contained (import Mathlib
--   only) and reprove the small entry-point divisibility fact locally, which is cleaner and
--   removes a fragile cross-file dependency.
-- !-- End Lab Notes -- !--
-/

open Nat

set_option maxHeartbeats 4000000

namespace FibReciprocity

/-! ## Binet's formula in a commutative ring -/

/-
**Binet's formula, ring form.** If `a + b = 1` and `a * b = -1` (so `a` and `b` are the
two roots of `x^2 = x + 1`), then `(a - b) * F n = a^n - b^n` in any commutative ring.
-/
theorem fib_binet_ring {R : Type*} [CommRing R] (a b : R)
    (hsum : a + b = 1) (hmul : a * b = -1) (n : ℕ) :
    (a - b) * (Nat.fib n : R) = a ^ n - b ^ n := by
  induction' n using Nat.twoStepInduction with n ih1 ih2 <;> simp_all +decide [ pow_succ', Nat.fib_add_two ] ; ring;
  convert congr_arg₂ ( · + · ) ih1 ih2 using 1 <;> ring;
  grind +extAll

/-! ## The reciprocity bridge -/

/-
`5` is a square modulo an odd prime `p ≠ 5` iff `p ≡ ±1 (mod 5)`.
-/
theorem five_isSquare_iff {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) (hp5 : p ≠ 5) :
    IsSquare (5 : ZMod p) ↔ p % 5 = 1 ∨ p % 5 = 4 := by
  have h_legendre : jacobiSym 5 p = 1 ↔ p % 5 = 1 ∨ p % 5 = 4 := by
    rw [ jacobiSym.mod_right ];
    · have := Nat.mod_lt p ( by decide : 0 < 20 ) ; interval_cases _ : p % 20 <;> simp_all +decide [ ← Nat.mod_mod_of_dvd p ( by decide : 5 ∣ 20 ) ] ;
      all_goals have := Nat.Prime.eq_two_or_odd hp; simp_all +decide [ ← Nat.mod_mod_of_dvd p ( by decide : 2 ∣ 20 ) ];
      all_goals native_decide;
    · exact hp.odd_of_ne_two hp2;
  rw [ ← h_legendre, jacobiSym ];
  norm_num [ Nat.primeFactorsList_prime hp ];
  haveI := Fact.mk hp; rw [ legendreSym.eq_one_iff ] ;
  · norm_cast;
  · simp +zetaDelta at *;
    erw [ ZMod.natCast_eq_zero_iff ] ; exact fun h => hp5 <| by have := Nat.le_of_dvd ( by decide ) h; interval_cases p <;> trivial;

/-! ## Residue case: `5` is a square mod `p` -/

/-
If `5` is a square mod the odd prime `p ≠ 5`, then `p ∣ F (p - 1)`.
-/
theorem fib_dvd_pred_of_five_isSquare {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) (hp5 : p ≠ 5)
    (h5 : IsSquare (5 : ZMod p)) : p ∣ Nat.fib (p - 1) := by
  obtain ⟨ s, hs ⟩ := h5;
  haveI := Fact.mk hp;
  -- Let $a = \frac{1 + s}{2}$ and $b = \frac{1 - s}{2}$.
  obtain ⟨a, b, ha, hb⟩ : ∃ a b : ZMod p, a + b = 1 ∧ a * b = -1 ∧ a - b ≠ 0 := by
    refine' ⟨ ( 1 + s ) / 2, ( 1 - s ) / 2, _, _, _ ⟩ <;> ring_nf at * <;> norm_num at *;
    · rw [ inv_mul_cancel₀ ] ; norm_num;
      erw [ ZMod.natCast_eq_zero_iff ] ; exact Nat.not_dvd_of_pos_of_lt ( by decide ) ( lt_of_le_of_ne hp.two_le ( Ne.symm hp2 ) );
    · rw [ ← hs ] ; ring;
      rw [ inv_mul_cancel₀ ] ; norm_num;
      erw [ ZMod.natCast_eq_zero_iff ] ; intro H; have := Nat.le_of_dvd ( by decide ) H; interval_cases p <;> trivial;
    · constructor <;> intro h <;> simp_all +decide [ sq ];
      · erw [ ZMod.natCast_eq_zero_iff ] at hs ; have := Nat.le_of_dvd ( by decide ) hs ; interval_cases p <;> trivial;
      · rcases p with ( _ | _ | _ | _ | p ) <;> cases h <;> contradiction;
  -- By Fermat's little theorem, we have $a^{p-1} = 1$ and $b^{p-1} = 1$.
  have h_fermat : a ^ (p - 1) = 1 ∧ b ^ (p - 1) = 1 := by
    exact ⟨ ZMod.pow_card_sub_one_eq_one ( by aesop ), ZMod.pow_card_sub_one_eq_one ( by aesop ) ⟩;
  -- By Binet's formula, we have $(a - b) * F_{p-1} = a^{p-1} - b^{p-1}$.
  have h_binet : (a - b) * (Nat.fib (p - 1) : ZMod p) = a ^ (p - 1) - b ^ (p - 1) := by
    convert fib_binet_ring a b ha hb.1 ( p - 1 ) using 1;
  simp_all +decide [ ← ZMod.natCast_eq_zero_iff ]

/-! ## Non-residue case: `5` is not a square mod `p` -/

/-
If `5` is not a square mod the odd prime `p`, then `p ∣ F (p + 1)`.
-/
theorem fib_dvd_succ_of_not_five_isSquare {p : ℕ} (hp : p.Prime)
    (h5 : ¬ IsSquare (5 : ZMod p)) : p ∣ Nat.fib (p + 1) := by
  haveI := Fact.mk hp;
  -- Let $a$ and $b$ be the roots of $X^2 - X - 1$ in the algebraic closure of $\mathbb{Z}/p\mathbb{Z}$.
  obtain ⟨a, b, ha, hb⟩ : ∃ a b : AlgebraicClosure (ZMod p), a + b = 1 ∧ a * b = -1 ∧ a ^ p = b ∧ b ^ p = a := by
    -- Let $a$ and $b$ be the roots of $X^2 - X - 1$ in the algebraic closure of $\mathbb{Z}/p\mathbb{Z}$, so $a^2 = a + 1$ and $b^2 = b + 1$.
    obtain ⟨a, ha⟩ : ∃ a : AlgebraicClosure (ZMod p), a^2 = a + 1 := by
      -- By definition of algebraic closure, every non-constant polynomial over $\mathbb{F}_p$ has a root in $\overline{\mathbb{F}_p}$.
      have h_alg_closed : ∀ (f : Polynomial (AlgebraicClosure (ZMod p))), f.degree > 0 → ∃ a : AlgebraicClosure (ZMod p), f.eval a = 0 := by
        exact fun f hf => IsAlgClosed.exists_root f hf.ne';
      exact Exists.elim ( h_alg_closed ( Polynomial.X ^ 2 - Polynomial.X - 1 ) ( by erw [ Polynomial.degree_sub_eq_left_of_degree_lt ] <;> erw [ Polynomial.degree_sub_eq_left_of_degree_lt ] <;> norm_num ) ) fun x hx => ⟨ x, by norm_num at hx ; linear_combination' hx ⟩;
    refine' ⟨ a, 1 - a, _, _, _, _ ⟩ <;> ring;
    · linear_combination' -ha;
    · have h_frobenius : (a ^ p) ^ 2 = a ^ p + 1 := by
        rw [ ← pow_mul, mul_comm, pow_mul, ha ];
        simp +decide [ add_pow_char ];
      by_cases h : a ^ p = a;
      · have h_contra : a ∈ Set.range (algebraMap (ZMod p) (AlgebraicClosure (ZMod p))) := by
          have h_contra : a ∈ Set.range (algebraMap (ZMod p) (AlgebraicClosure (ZMod p))) := by
            have h_poly : Polynomial.X ^ p - Polynomial.X = ∏ x ∈ Finset.univ, (Polynomial.X - Polynomial.C (x : ZMod p)) := by
              refine' Polynomial.eq_of_degree_sub_lt_of_eval_finset_eq _ _ _;
              exact Finset.univ;
              · convert Polynomial.degree_sub_lt _ _ _ <;> norm_num [ Polynomial.degree_prod, Polynomial.degree_X_pow_sub_C ];
                · rw [ Polynomial.degree_sub_eq_left_of_degree_lt ] <;> norm_num [ hp.one_lt ];
                · rw [ Polynomial.degree_sub_eq_left_of_degree_lt ] <;> norm_num [ hp.one_lt ];
                · exact ne_of_apply_ne ( Polynomial.derivative ) ( by norm_num [ Polynomial.derivative_pow, hp.ne_zero ] );
                · rw [ Polynomial.leadingCoeff_prod ];
                  rw [ Polynomial.leadingCoeff_sub_of_degree_lt ] <;> norm_num [ hp.one_lt ];
              · simp +decide [ Polynomial.eval_prod ];
                exact fun x => Eq.symm ( Finset.prod_eq_zero ( Finset.mem_univ x ) ( sub_self x ) )
            replace h_poly := congr_arg ( Polynomial.map ( algebraMap ( ZMod p ) ( AlgebraicClosure ( ZMod p ) ) ) ) h_poly ; replace h_poly := congr_arg ( Polynomial.eval a ) h_poly ; simp_all +decide [ Polynomial.eval_prod, Finset.prod_eq_zero_iff, sub_eq_iff_eq_add ] ;
            exact Exists.elim ( Finset.prod_eq_zero_iff.mp h_poly.symm ) fun x hx => ⟨ x, by linear_combination -hx.2 ⟩;
          exact h_contra;
        obtain ⟨ x, hx ⟩ := h_contra; simp_all +decide [ ← eq_sub_iff_add_eq' ] ;
        have h_contra : x^2 = x + 1 := by
          exact ( algebraMap ( ZMod p ) ( AlgebraicClosure ( ZMod p ) ) ).injective <| by aesop;
        exact False.elim <| h5 ⟨ 2 * x - 1, by linear_combination' -h_contra * 4 ⟩;
      · grind;
    · have hFrobenius : a ^ p = 1 - a := by
        have h_conj : (a ^ p) ^ 2 = a ^ p + 1 := by
          rw [ ← pow_mul, mul_comm, pow_mul, ha ];
          simp +decide [ add_pow_char ];
        by_cases h : a ^ p = a;
        · have h_contra : a ∈ Set.range (algebraMap (ZMod p) (AlgebraicClosure (ZMod p))) := by
            have h_contra : a ∈ Set.range (algebraMap (ZMod p) (AlgebraicClosure (ZMod p))) := by
              have h_poly : Polynomial.X ^ p - Polynomial.X = ∏ x ∈ Finset.univ, (Polynomial.X - Polynomial.C (x : ZMod p)) := by
                refine' Polynomial.eq_of_degree_sub_lt_of_eval_finset_eq _ _ _;
                exact Finset.univ;
                · convert Polynomial.degree_sub_lt _ _ _ <;> norm_num [ Polynomial.degree_prod, Polynomial.degree_X_pow_sub_C ];
                  · rw [ Polynomial.degree_sub_eq_left_of_degree_lt ] <;> norm_num [ hp.one_lt ];
                  · rw [ Polynomial.degree_sub_eq_left_of_degree_lt ] <;> norm_num [ hp.one_lt ];
                  · exact ne_of_apply_ne ( Polynomial.derivative ) ( by norm_num [ Polynomial.derivative_pow, hp.ne_zero ] );
                  · rw [ Polynomial.leadingCoeff_prod ];
                    rw [ Polynomial.leadingCoeff_sub_of_degree_lt ] <;> norm_num [ hp.one_lt ];
                · simp +decide [ Polynomial.eval_prod ];
                  exact fun x => Eq.symm ( Finset.prod_eq_zero ( Finset.mem_univ x ) ( sub_self x ) )
              replace h_poly := congr_arg ( Polynomial.map ( algebraMap ( ZMod p ) ( AlgebraicClosure ( ZMod p ) ) ) ) h_poly ; replace h_poly := congr_arg ( Polynomial.eval a ) h_poly ; simp_all +decide [ Polynomial.eval_prod, Finset.prod_eq_zero_iff, sub_eq_iff_eq_add ] ;
              exact Exists.elim ( Finset.prod_eq_zero_iff.mp h_poly.symm ) fun x hx => ⟨ x, by linear_combination -hx.2 ⟩;
            exact h_contra;
          obtain ⟨ x, hx ⟩ := h_contra; simp_all +decide [ ← eq_sub_iff_add_eq ] ;
          -- If $a = x$, then $x^2 = x + 1$, which implies that $5$ is a square modulo $p$, contradicting our assumption.
          have h_contra : x^2 = x + 1 := by
            exact ( algebraMap ( ZMod p ) ( AlgebraicClosure ( ZMod p ) ) ).injective <| by aesop;
          exact False.elim <| h5 ⟨ 2 * x - 1, by linear_combination' h_contra.symm * 4 ⟩;
        · grind;
      rw [ sub_pow_char ] ; aesop;
  -- By Binet's formula, we have $(a - b) * F_{p+1} = a^{p+1} - b^{p+1}$.
  have h_binet : (a - b) * (Nat.fib (p + 1) : AlgebraicClosure (ZMod p)) = a ^ (p + 1) - b ^ (p + 1) := by
    convert fib_binet_ring a b ha hb.1 ( p + 1 ) using 1;
  -- Since $a - b \neq 0$, we can divide both sides of the equation by $a - b$.
  have h_div : (Nat.fib (p + 1) : AlgebraicClosure (ZMod p)) = 0 := by
    by_cases hab : a = b;
    · -- Since $2^{-1} * 2^{-1} = -1$, we have $5 = 0$ in the algebraic closure of $\mathbb{Z}/p\mathbb{Z}$.
      have h_five_zero : (5 : AlgebraicClosure (ZMod p)) = 0 := by
        grind;
      erw [ CharP.cast_eq_zero_iff ( AlgebraicClosure ( ZMod p ) ) p ] at h_five_zero ; simp_all +decide [ Nat.prime_dvd_prime_iff_eq ];
      subst h_five_zero; norm_cast;
    · grind;
  rw [ ← CharP.cast_eq_zero_iff ( AlgebraicClosure ( ZMod p ) ) p ] ; aesop

/-! ## Main sharpened statements (in terms of `p mod 5`) -/

/-- **Residue law of apparition.** For a prime `p ≡ ±1 (mod 5)`, `p ∣ F (p - 1)`. -/
theorem fib_dvd_pred_of_mod {p : ℕ} (hp : p.Prime) (hp5 : p ≠ 5)
    (h : p % 5 = 1 ∨ p % 5 = 4) : p ∣ Nat.fib (p - 1) := by
  have hp2 : p ≠ 2 := by rintro rfl; simp at h
  exact fib_dvd_pred_of_five_isSquare hp hp2 hp5 ((five_isSquare_iff hp hp2 hp5).2 h)

/-- **Non-residue law of apparition.** For a prime `p ≡ ±2 (mod 5)`, `p ∣ F (p + 1)`. -/
theorem fib_dvd_succ_of_mod {p : ℕ} (hp : p.Prime) (hp5 : p ≠ 5)
    (h : p % 5 = 2 ∨ p % 5 = 3) : p ∣ Nat.fib (p + 1) := by
  rcases eq_or_ne p 2 with rfl | hp2
  · decide
  · refine fib_dvd_succ_of_not_five_isSquare hp ?_
    intro hsq
    rcases (five_isSquare_iff hp hp2 hp5).1 hsq with h1 | h1 <;> omega

/-! ## The Fibonacci entry point (rank of apparition), self-contained -/

open Classical in
/-- The Fibonacci entry point `z(p)`: the smallest `k > 0` with `p ∣ F k` (or `0` if none). -/
noncomputable def zfib (p : ℕ) : ℕ :=
  if h : ∃ k, 0 < k ∧ p ∣ Nat.fib k then Nat.find h else 0

/-
If `p ∣ F k` for some `k > 0`, then the entry point `z(p)` divides `k`.
-/
theorem zfib_dvd_of_dvd (p k : ℕ) (hk : 0 < k) (hpk : p ∣ Nat.fib k) : zfib p ∣ k := by
  -- By definition of $z(p)$, there exists some $k > 0$ such that $p \mid \text{fib}(k)$.
  have h_exists : ∃ k, 0 < k ∧ p ∣ Nat.fib k := by
    use k;
  -- Let $z = zfib p$. By definition, $z$ is the smallest positive integer such that $p \mid \text{fib}(z)$.
  obtain ⟨z, hz_def⟩ : ∃ z, 0 < z ∧ p ∣ Nat.fib z ∧ ∀ m, 0 < m ∧ p ∣ Nat.fib m → z ≤ m := by
    exact ⟨ Nat.find h_exists, Nat.find_spec h_exists |>.1, Nat.find_spec h_exists |>.2, fun m hm => Nat.find_min' h_exists hm ⟩;
  -- By definition of $z(p)$, we know that $z = zfib p$.
  have hz_eq : z = zfib p := by
    unfold zfib;
    split_ifs ; simp_all +decide [ Nat.find_eq_iff ];
    exact le_antisymm ( hz_def.2.2 _ ( Nat.find_spec h_exists |>.1 ) ( Nat.find_spec h_exists |>.2 ) ) ( Nat.find_min' h_exists ⟨ hz_def.1, hz_def.2.1 ⟩ );
  -- By definition of $z(p)$, we know that $p \mid \text{fib}(z)$ and $p \mid \text{fib}(k)$.
  have h_div : p ∣ Nat.fib (Nat.gcd z k) := by
    simp_all +decide [ Nat.fib_gcd ];
    exact Nat.dvd_gcd hz_def.2.1 hpk;
  contrapose! hz_def;
  exact fun _ _ => ⟨ Nat.gcd z k, ⟨ Nat.gcd_pos_of_pos_left _ ‹_›, h_div ⟩, lt_of_le_of_ne ( Nat.le_of_dvd ‹_› ( Nat.gcd_dvd_left _ _ ) ) fun con => hz_def <| hz_eq ▸ con ▸ Nat.gcd_dvd_right _ _ ⟩

/-! ## Corollaries for the entry point `z(p)` -/

/-- For a prime `p ≡ ±1 (mod 5)`, the Fibonacci entry point divides `p - 1`. -/
theorem zfib_dvd_pred {p : ℕ} (hp : p.Prime) (hp5 : p ≠ 5)
    (h : p % 5 = 1 ∨ p % 5 = 4) : zfib p ∣ (p - 1) := by
  have hp2 : p ≠ 2 := by rintro rfl; simp at h
  have hp1 : 0 < p - 1 := by have := hp.two_le; omega
  exact zfib_dvd_of_dvd p (p - 1) hp1 (fib_dvd_pred_of_mod hp hp5 h)

/-- For a prime `p ≡ ±2 (mod 5)`, the Fibonacci entry point divides `p + 1`. -/
theorem zfib_dvd_succ {p : ℕ} (hp : p.Prime) (hp5 : p ≠ 5)
    (h : p % 5 = 2 ∨ p % 5 = 3) : zfib p ∣ (p + 1) := by
  exact zfib_dvd_of_dvd p (p + 1) (Nat.succ_pos p) (fib_dvd_succ_of_mod hp hp5 h)

/-! ## Unconditional dichotomy (sharpening of `z(p) ∣ p² - 1`)

For every prime `p ≠ 5`, the entry point divides `p - 1` *or* `p + 1` — never needing the
full `p² - 1`.  This is the precise refinement of the catalog's `entry_point_dvd_sq_sub_one`. -/

/-- For every prime `p ≠ 5`, either `p ∣ F (p - 1)` or `p ∣ F (p + 1)`. -/
theorem fib_dvd_pred_or_succ {p : ℕ} (hp : p.Prime) (hp5 : p ≠ 5) :
    p ∣ Nat.fib (p - 1) ∨ p ∣ Nat.fib (p + 1) := by
  have h0 : p % 5 ≠ 0 := by
    intro h
    exact hp5 (((Nat.prime_dvd_prime_iff_eq (by norm_num) hp).1 (Nat.dvd_of_mod_eq_zero h)).symm)
  have hlt : p % 5 < 5 := Nat.mod_lt _ (by norm_num)
  have hcase : (p % 5 = 1 ∨ p % 5 = 4) ∨ (p % 5 = 2 ∨ p % 5 = 3) := by omega
  rcases hcase with hr | hr
  · exact Or.inl (fib_dvd_pred_of_mod hp hp5 hr)
  · exact Or.inr (fib_dvd_succ_of_mod hp hp5 hr)

/-- **Entry-point dichotomy.** For every prime `p ≠ 5`, the rank of apparition divides
`p - 1` or `p + 1`.  Since `(p-1)(p+1) = p² - 1`, this strictly sharpens `z(p) ∣ p² - 1`. -/
theorem zfib_dvd_pred_or_succ {p : ℕ} (hp : p.Prime) (hp5 : p ≠ 5) :
    zfib p ∣ (p - 1) ∨ zfib p ∣ (p + 1) := by
  have h0 : p % 5 ≠ 0 := by
    intro h
    exact hp5 (((Nat.prime_dvd_prime_iff_eq (by norm_num) hp).1 (Nat.dvd_of_mod_eq_zero h)).symm)
  have hlt : p % 5 < 5 := Nat.mod_lt _ (by norm_num)
  have hcase : (p % 5 = 1 ∨ p % 5 = 4) ∨ (p % 5 = 2 ∨ p % 5 = 3) := by omega
  rcases hcase with hr | hr
  · exact Or.inl (zfib_dvd_pred hp hp5 hr)
  · exact Or.inr (zfib_dvd_succ hp hp5 hr)

/-! ## Mutual exclusivity and the exact equivalence

`F(p-1)` and `F(p+1)` are coprime for odd `p` (their gcd is `F(gcd(p-1,p+1)) = F 2 = 1`), so a
prime divides *exactly* one of them. Combined with the dichotomy this upgrades the residue laws
to genuine equivalences. -/

/-
For an odd prime `p`, `p` cannot divide both `F (p-1)` and `F (p+1)`.
-/
theorem not_dvd_pred_and_succ {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) :
    ¬ (p ∣ Nat.fib (p - 1) ∧ p ∣ Nat.fib (p + 1)) := by
  -- Since $p$ is odd, we have $\gcd(F_{p-1}, F_{p+1}) = F_{\gcd(p-1, p+1)} = F_2 = 1$.
  have h_gcd : Nat.gcd (Nat.fib (p - 1)) (Nat.fib (p + 1)) = 1 := by
    rcases p with ( _ | _ | p ) <;> simp_all +arith +decide [ Nat.fib_add_two ];
    exact Nat.recOn p ( by norm_num ) fun n ih => by simp_all +decide [ Nat.fib_add_two, Nat.gcd_comm ] ;
  exact fun h => hp.not_dvd_one <| h_gcd ▸ Nat.dvd_gcd h.1 h.2

/-- **Exact law of apparition (subtractive case).** For a prime `p ∉ {2,5}`,
`p ∣ F (p-1)` holds *iff* `p ≡ ±1 (mod 5)`. -/
theorem fib_dvd_pred_iff {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) (hp5 : p ≠ 5) :
    p ∣ Nat.fib (p - 1) ↔ p % 5 = 1 ∨ p % 5 = 4 := by
  refine ⟨fun hd => ?_, fib_dvd_pred_of_mod hp hp5⟩
  have h0 : p % 5 ≠ 0 := by
    intro h
    exact hp5 (((Nat.prime_dvd_prime_iff_eq (by norm_num) hp).1 (Nat.dvd_of_mod_eq_zero h)).symm)
  by_contra hcon
  push_neg at hcon
  have hr : p % 5 = 2 ∨ p % 5 = 3 := by omega
  exact not_dvd_pred_and_succ hp hp2 ⟨hd, fib_dvd_succ_of_mod hp hp5 hr⟩

/-- **Exact law of apparition (additive case).** For a prime `p ∉ {2,5}`,
`p ∣ F (p+1)` holds *iff* `p ≡ ±2 (mod 5)`. -/
theorem fib_dvd_succ_iff {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) (hp5 : p ≠ 5) :
    p ∣ Nat.fib (p + 1) ↔ p % 5 = 2 ∨ p % 5 = 3 := by
  refine ⟨fun hd => ?_, fib_dvd_succ_of_mod hp hp5⟩
  have h0 : p % 5 ≠ 0 := by
    intro h
    exact hp5 (((Nat.prime_dvd_prime_iff_eq (by norm_num) hp).1 (Nat.dvd_of_mod_eq_zero h)).symm)
  by_contra hcon
  push_neg at hcon
  have hr : p % 5 = 1 ∨ p % 5 = 4 := by omega
  exact not_dvd_pred_and_succ hp hp2 ⟨fib_dvd_pred_of_mod hp hp5 hr, hd⟩

end FibReciprocity