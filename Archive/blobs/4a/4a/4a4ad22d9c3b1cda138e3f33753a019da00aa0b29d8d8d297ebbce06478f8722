  "interactive_demos": [
    {
      "title": "Markov Basis Explorer: Watch 2x2 Swaps Connect a Fiber in Real Time",
      "description": "An interactive widget showing two contingency tables side by side -- a current table u and a target v sharing the same row and column margins. Cells of u are tinted green where it overshoots v and red where it undershoots, and the 2x2 rectangle selected by the three-stage pigeonhole is outlined. Press Step to apply one greedy distance-reducing swap, Auto-solve to animate the full descent of the L1 distance to zero, or Random fiber pair to generate a fresh pair of tables with identical margins (built by scrambling with random legal swaps). The live margin readout confirms that every swap leaves all row and column totals invariant, making the Fundamental Theorem of Markov Bases tangible.",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n<title>Markov Basis Explorer &mdash; 2&times;2 Swaps Connect Every Fiber</title>\n<style>\n  :root { --bg:#0f1226; --panel:#1a1f3c; --ink:#eef1ff; --accent:#5ad1ff; --pos:#3ddc84; --neg:#ff6b6b; --grid:#2c3360; }\n  * { box-sizing:border-box; }\n  body { margin:0; font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,sans-serif;\n         background:radial-gradient(1200px 600px at 50% -10%, #1c2350, var(--bg)); color:var(--ink); padding:24px; }\n  h1 { font-size:1.5rem; margin:0 0 4px; }\n  p.sub { color:#aeb6e6; margin:0 0 20px; max-width:720px; line-height:1.5; }\n  .wrap { display:flex; flex-wrap:wrap; gap:24px; align-items:flex-start; }\n  .panel { background:var(--panel); border:1px solid var(--grid); border-radius:14px; padding:18px; box-shadow:0 8px 30px rgba(0,0,0,.35); }\n  table { border-collapse:collapse; }\n  td.cell { width:54px; height:48px; text-align:center; border:1px solid var(--grid); font-size:1.1rem; }\n  td.cell input { width:48px; background:transparent; border:none; color:var(--ink); text-align:center; font-size:1.05rem; }\n  td.marg { color:var(--accent); font-weight:700; padding:0 10px; }\n  th { color:#9fb0ff; font-weight:600; padding:4px; font-size:.85rem; }\n  .hot-pos { background:rgba(61,220,132,.22); }\n  .hot-neg { background:rgba(255,107,107,.22); }\n  button { background:var(--accent); color:#04243a; border:none; border-radius:9px; padding:9px 14px;\n           font-weight:700; cursor:pointer; margin:4px 6px 4px 0; font-size:.95rem; }\n  button.secondary { background:#39406e; color:var(--ink); }\n  button:disabled { opacity:.4; cursor:not-allowed; }\n  .stat { font-size:1.1rem; margin:10px 0; }\n  .big { font-size:1.6rem; font-weight:800; color:var(--accent); }\n  code { background:#0c0f24; padding:1px 6px; border-radius:6px; color:#bfe9ff; }\n  .ok { color:var(--pos); font-weight:700; }\n  .legend span { display:inline-block; margin-right:16px; }\n  .swatch { display:inline-block; width:12px; height:12px; border-radius:3px; vertical-align:middle; margin-right:5px; }\n</style>\n</head>\n<body>\n  <h1>Markov Basis Explorer</h1>\n  <p class=\"sub\">\n    Two integer contingency tables with the <b>same row and column margins</b> can always be\n    joined by a walk of basic <b>2&times;2 swaps</b> &mdash; adding <code>+1</code> on one diagonal of a\n    rectangle and <code>&minus;1</code> on the other &mdash; that never leaves the world of non-negative counts.\n    Press <b>Step</b> to apply the greedy distance-reducing swap, or <b>Auto-solve</b> to watch the\n    <code>&#8467;&sup1;</code> distance fall to zero. The highlighted rectangle is the one found by the\n    three-stage pigeonhole argument.\n  </p>\n\n  <div class=\"wrap\">\n    <div class=\"panel\">\n      <h3>Current table&nbsp; u</h3>\n      <div id=\"uTable\"></div>\n    </div>\n    <div class=\"panel\">\n      <h3>Target table&nbsp; v</h3>\n      <div id=\"vTable\"></div>\n    </div>\n    <div class=\"panel\" style=\"min-width:240px\">\n      <h3>Walk</h3>\n      <div class=\"stat\">&#8467;&sup1; distance <span class=\"big\" id=\"dist\">&mdash;</span></div>\n      <div class=\"stat\">swaps applied: <b id=\"count\">0</b></div>\n      <div class=\"stat\" id=\"margMsg\"></div>\n      <div>\n        <button id=\"stepBtn\">Step &#9654;</button>\n        <button id=\"autoBtn\">Auto-solve &#9889;</button>\n      </div>\n      <div>\n        <button class=\"secondary\" id=\"randBtn\">Random fiber pair &#8635;</button>\n        <button class=\"secondary\" id=\"resetBtn\">Reset</button>\n      </div>\n      <div class=\"legend\" style=\"margin-top:14px; font-size:.85rem; color:#aeb6e6\">\n        <span><span class=\"swatch\" style=\"background:rgba(61,220,132,.6)\"></span>u &gt; v (overshoot)</span>\n        <span><span class=\"swatch\" style=\"background:rgba(255,107,107,.6)\"></span>u &lt; v (undershoot)</span>\n      </div>\n    </div>\n  </div>\n\n<script>\nconst M = 3, N = 3;\nlet u, v;\n\nfunction zeros() { return Array.from({length:M}, () => Array(N).fill(0)); }\nfunction clone(a) { return a.map(r => r.slice()); }\nfunction rowSum(a,i){ return a[i].reduce((s,x)=>s+x,0); }\nfunction colSum(a,j){ let s=0; for(let i=0;i<M;i++) s+=a[i][j]; return s; }\nfunction l1(a,b){ let s=0; for(let i=0;i<M;i++) for(let j=0;j<N;j++) s+=Math.abs(a[i][j]-b[i][j]); return s; }\nfunction sameMargins(a,b){\n  for(let i=0;i<M;i++) if(rowSum(a,i)!==rowSum(b,i)) return false;\n  for(let j=0;j<N;j++) if(colSum(a,j)!==colSum(b,j)) return false;\n  return true;\n}\n\n// Three-stage pigeonhole: returns {i,ip,j,jp} or null when u==v.\nfunction findIndices(a,b){\n  const d = a.map((r,i)=>r.map((x,j)=>x-b[i][j]));\n  let i=-1,j=-1;\n  outer: for(let r=0;r<M;r++) for(let c=0;c<N;c++) if(d[r][c]>0){ i=r; j=c; break outer; }\n  if(i<0) return null;\n  let jp=-1; for(let c=0;c<N;c++) if(d[i][c]<0){ jp=c; break; }\n  let ip=-1; for(let r=0;r<M;r++) if(d[r][jp]>0){ ip=r; break; }\n  return {i, ip, j, jp};\n}\n\nfunction applyMove(a,m){\n  const w = clone(a);\n  w[m.i][m.jp]+=1; w[m.ip][m.j]+=1; w[m.i][m.j]-=1; w[m.ip][m.jp]-=1;\n  return w;\n}\n\nlet count = 0;\n\nfunction render(){\n  const idx = (l1(u,v)>0) ? findIndices(u,v) : null;\n  drawTable('uTable', u, v, idx, true);\n  drawTable('vTable', v, v, null, false);\n  const d = l1(u,v);\n  document.getElementById('dist').textContent = d;\n  document.getElementById('count').textContent = count;\n  const same = sameMargins(u,v);\n  document.getElementById('margMsg').innerHTML = same\n    ? (d===0 ? '<span class=\"ok\">Connected! u = v &#10003;</span>' : 'margins match &#10003;')\n    : '<span style=\"color:#ff6b6b\">margins differ &mdash; not a fiber</span>';\n  document.getElementById('stepBtn').disabled = (d===0) || !same;\n  document.getElementById('autoBtn').disabled = (d===0) || !same;\n}\n\nfunction drawTable(elId, a, target, idx, editable){\n  let html = '<table><tr><th></th>';\n  for(let j=0;j<N;j++) html += '<th>c'+j+'</th>';\n  html += '<th></th></tr>';\n  for(let i=0;i<M;i++){\n    html += '<tr><th>r'+i+'</th>';\n    for(let j=0;j<N;j++){\n      let cls='cell';\n      if(editable){\n        const diff=a[i][j]-target[i][j];\n        if(diff>0) cls+=' hot-pos'; else if(diff<0) cls+=' hot-neg';\n      }\n      const ring = (idx && ((i===idx.i&&j===idx.j)||(i===idx.i&&j===idx.jp)||\n                            (i===idx.ip&&j===idx.j)||(i===idx.ip&&j===idx.jp)))\n                   ? ' style=\"outline:3px solid #5ad1ff; outline-offset:-3px\"' : '';\n      html += '<td class=\"'+cls+'\"'+ring+'>'+a[i][j]+'</td>';\n    }\n    html += '<td class=\"marg\">'+rowSum(a,i)+'</td></tr>';\n  }\n  html += '<tr><th></th>';\n  for(let j=0;j<N;j++) html += '<td class=\"marg\">'+colSum(a,j)+'</td>';\n  html += '<td></td></tr></table>';\n  document.getElementById(elId).innerHTML = html;\n}\n\nfunction step(){\n  const idx = findIndices(u,v);\n  if(!idx) return;\n  u = applyMove(u, idx);\n  count++;\n  render();\n}\n\nfunction auto(){\n  const timer = setInterval(()=>{\n    if(l1(u,v)===0){ clearInterval(timer); return; }\n    step();\n  }, 450);\n}\n\n// Build a random fiber pair: start from a random table, then scramble with random\n// legal 2x2 swaps so the two share identical margins by construction.\nfunction randomFiber(){\n  u = zeros();\n  for(let k=0;k<8;k++){\n    const i=Math.floor(Math.random()*M), j=Math.floor(Math.random()*N);\n    u[i][j]+=1+Math.floor(Math.random()*3);\n  }\n  v = clone(u);\n  for(let k=0;k<40;k++){\n    const i=Math.floor(Math.random()*M);\n    let ip=Math.floor(Math.random()*M); if(ip===i) ip=(ip+1)%M;\n    const j=Math.floor(Math.random()*N);\n    let jp=Math.floor(Math.random()*N); if(jp===j) jp=(jp+1)%N;\n    // apply +1/-1 swap only if it keeps v non-negative\n    if(v[i][j]>0 && v[ip][jp]>0){\n      v[i][j]-=1; v[ip][jp]-=1; v[i][jp]+=1; v[ip][j]+=1;\n    }\n  }\n  count=0; render();\n}\n\nlet u0, v0;\ndocument.getElementById('stepBtn').onclick = step;\ndocument.getElementById('autoBtn').onclick = auto;\ndocument.getElementById('randBtn').onclick = ()=>{ randomFiber(); u0=clone(u); v0=clone(v); };\ndocument.getElementById('resetBtn').onclick = ()=>{ u=clone(u0); v=clone(v0); count=0; render(); };\n\n// Initial demo pair (equal margins).\nu = [[3,0,1],[0,2,2],[1,2,1]];\nv = [[1,2,1],[1,1,2],[2,1,1]];\nu0=clone(u); v0=clone(v);\nrender();\n</script>\n</body>\n</html>\n"
