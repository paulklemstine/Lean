import Algebra.BerggrenLorentz.Core

/-!
# Berggren Word Certificates: Lorentz-form preservation along words

This file is a small certification layer on top of
`Catalog.Algebra.BerggrenLorentz.Core`. It packages the single-step facts about
the Berggren generators `matA`, `matB`, `matC` into whole-word statements.

We introduce a three-element generator enum `Gen`, its matrix interpretation
`genMatrix`, and the word interpretation `wordMatrix` (a left-to-right product
of generator matrices). We then prove, by induction on words, that:

* every word matrix preserves the Lorentz metric `metricQ` (`Mᵀ Q M = Q`);
* every word matrix preserves the Lorentz quadratic form on vectors;
* every word matrix sends Pythagorean triples to Pythagorean triples.

Everything stays concrete over `ℤ` and `Fin 3`, reusing the core API directly.
-/

open Matrix

namespace BerggrenLorentz

namespace Word

/-- The three Berggren generators as an enumeration. -/
inductive Gen
  | A
  | B
  | C
  deriving DecidableEq, Repr

/-- The matrix attached to each generator, reusing the core matrices. -/
def genMatrix : Gen → Matrix (Fin 3) (Fin 3) ℤ
  | Gen.A => matA
  | Gen.B => matB
  | Gen.C => matC

/-- The matrix attached to a word: the ordered product of its generator
matrices, with the empty word mapping to the identity. -/
def wordMatrix : List Gen → Matrix (Fin 3) (Fin 3) ℤ
  | [] => 1
  | g :: w => genMatrix g * wordMatrix w

@[simp] theorem wordMatrix_nil : wordMatrix [] = 1 := rfl

@[simp] theorem wordMatrix_cons (g : Gen) (w : List Gen) :
    wordMatrix (g :: w) = genMatrix g * wordMatrix w := rfl

/-! ### Generator-level preservation -/

/-- Each generator matrix preserves the Lorentz metric `metricQ`. -/
theorem genMatrix_preserves_metricQ (g : Gen) :
    (genMatrix g)ᵀ * metricQ * genMatrix g = metricQ := by
  cases g
  · exact matA_preserves_lorentz
  · exact matB_preserves_lorentz
  · exact matC_preserves_lorentz

/-! ### Word-level preservation -/

/-- Every Berggren word matrix preserves the Lorentz metric: `Mᵀ Q M = Q`. -/
theorem wordMatrix_preserves_metricQ (w : List Gen) :
    (wordMatrix w)ᵀ * metricQ * wordMatrix w = metricQ := by
  induction w with
  | nil => simp
  | cons g w ih =>
    have hg := genMatrix_preserves_metricQ g
    rw [wordMatrix_cons, Matrix.transpose_mul]
    calc
        (wordMatrix w)ᵀ * (genMatrix g)ᵀ * metricQ * (genMatrix g * wordMatrix w)
          = (wordMatrix w)ᵀ * ((genMatrix g)ᵀ * metricQ * genMatrix g) * wordMatrix w := by
            simp only [Matrix.mul_assoc]
      _ = (wordMatrix w)ᵀ * metricQ * wordMatrix w := by rw [hg]
      _ = metricQ := ih

/-! ### Quadratic-form invariance on vectors -/

/-- The Lorentz form expressed via the metric matrix `metricQ`. -/
theorem lorentzForm_eq_dotProduct (v : Fin 3 → ℤ) :
    lorentzForm v = v ⬝ᵥ (metricQ *ᵥ v) := by
  simp [lorentzForm, metricQ, mulVec, dotProduct, Fin.sum_univ_three]; ring

/-- A matrix satisfying `Mᵀ Q M = Q` preserves the Lorentz form on every vector. -/
theorem lorentzForm_mulVec_of_preserves (M : Matrix (Fin 3) (Fin 3) ℤ)
    (hM : Mᵀ * metricQ * M = metricQ) (v : Fin 3 → ℤ) :
    lorentzForm (M *ᵥ v) = lorentzForm v := by
  rw [lorentzForm_eq_dotProduct, lorentzForm_eq_dotProduct]
  have h : (M *ᵥ v) ⬝ᵥ (metricQ *ᵥ (M *ᵥ v)) = v ⬝ᵥ ((Mᵀ * metricQ * M) *ᵥ v) := by
    simp only [Matrix.dotProduct_mulVec, Matrix.vecMul_transpose, ← Matrix.mulVec_mulVec]
  rw [h, hM]

/-- Every Berggren word matrix preserves the Lorentz quadratic form on vectors. -/
theorem wordMatrix_preserves_lorentzForm (w : List Gen) (v : Fin 3 → ℤ) :
    lorentzForm (wordMatrix w *ᵥ v) = lorentzForm v :=
  lorentzForm_mulVec_of_preserves _ (wordMatrix_preserves_metricQ w) v

/-! ### Pythagorean preservation -/

/-- Every Berggren word sends Pythagorean triples to Pythagorean triples:
if the coordinates of `v` form a Pythagorean triple, so do the coordinates of
`wordMatrix w *ᵥ v`. -/
theorem wordMatrix_preserves_pythag (w : List Gen) (v : Fin 3 → ℤ)
    (h : IsPythag (v 0) (v 1) (v 2)) :
    IsPythag ((wordMatrix w *ᵥ v) 0) ((wordMatrix w *ᵥ v) 1) ((wordMatrix w *ᵥ v) 2) := by
  rw [← lorentzQ_zero_iff_pythag, ← lorentzForm_eq_lorentzQ] at h ⊢
  rw [wordMatrix_preserves_lorentzForm]
  exact h

end Word

end BerggrenLorentz
