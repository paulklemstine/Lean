import Mathlib

/-!
# Row complexity of the additive cellular automaton Rule 90

Rule 90 is the elementary, *additive* (XOR-based) one–dimensional cellular automaton whose
update rule is `cellₜ₊₁(i) = cellₜ(i-1) XOR cellₜ(i+1)`.  Starting from a single live cell, the
state of cell `k` at time `t` is exactly the parity of the binomial coefficient `C(t, k)`: the
configuration at time `t` is the `t`-th row of Pascal's triangle reduced modulo `2`.

A natural measure of the structural richness ("complexity") of the row produced at time `t` is the
number of live cells, i.e. the number of `k ≤ t` for which `C(t, k)` is odd.  We call this number
`complexity t`.  This file proves the exact closed form

  `complexity t = 2 ^ popcount t`

where `popcount t` is the number of `1`-bits in the binary expansion of `t`.  The proof is purely
combinatorial: a single-digit instance of Lucas' theorem (with prime `2`) gives the parity recursion
`Odd (C t k) ↔ (k % 2 ≤ t % 2) ∧ Odd (C (t/2) (k/2))`, from which `complexity` satisfies the same
binary recursion as `2 ^ popcount`.

## Main results

* `complexity_eq_two_pow_popcount`: `complexity t = 2 ^ popcount t`.
* `complexity_pow_two`: `complexity (2 ^ k) = 2` (every power of two yields a maximally sparse row).
* `complexity_mersenne`: `complexity (2 ^ k - 1) = 2 ^ k` (every Mersenne time yields a *full* row,
  i.e. `complexity (2^k-1) = (2^k - 1) + 1`).

The last two facts give two infinite families of times — powers of two (constant complexity `2`)
and Mersenne numbers (complexity `t + 1`, the maximum possible) — interleaved without bound.  Hence
no monotone "complexity threshold" can hold for Rule 90; this is recorded precisely as
`sparse_rows_infinite` and `full_rows_infinite`.

Every informal claim above is backed by a formal theorem in this file.
-/

open Finset

namespace AdditiveCA

/-- The Rule 90 row complexity at time `t`: the number of cells `k ≤ t` that are live, equivalently
the number of `k ∈ {0, …, t}` for which the binomial coefficient `C(t, k)` is odd. -/
def complexity (t : ℕ) : ℕ :=
  ((Finset.range (t + 1)).filter (fun k => Odd (Nat.choose t k))).card

/-- The population count of `t`: the number of `1`-bits in the binary expansion of `t`, computed as
the sum of its base-2 digits. -/
def popcount (t : ℕ) : ℕ := (Nat.digits 2 t).sum

/-- Single-digit Lucas parity recursion for binomial coefficients in base 2: `C(t, k)` is odd iff
the lowest bit of `k` does not exceed that of `t` and `C(t/2, k/2)` is odd. -/
lemma odd_choose_iff (t k : ℕ) :
    Odd (Nat.choose t k) ↔ k % 2 ≤ t % 2 ∧ Odd (Nat.choose (t / 2) (k / 2)) := by
  have h_lucas : Nat.choose t k ≡ Nat.choose (t % 2) (k % 2) * Nat.choose (t / 2) (k / 2) [MOD 2] := by
    convert @Choose.choose_modEq_choose_mod_mul_choose_div_nat t k 2 ⟨ by decide ⟩ using 1;
  cases Nat.mod_two_eq_zero_or_one t <;> cases Nat.mod_two_eq_zero_or_one k <;> simp_all +decide [ Nat.ModEq, Nat.even_iff ]; all_goals rw [ Nat.odd_iff, Nat.odd_iff, h_lucas ]

/-- Complexity recursion at odd times: `complexity (2t+1) = 2 * complexity t`. -/
lemma complexity_odd (t : ℕ) : complexity (2 * t + 1) = 2 * complexity t := by
  -- Split the filter into two parts: those elements where $k$ is even and those where $k$ is odd.
  have h_split : Finset.filter (fun k => Odd (Nat.choose (2 * t + 1) k)) (Finset.range (2 * t + 2)) =
    (Finset.image (fun j => 2 * j) (Finset.filter (fun j => Odd (Nat.choose t j)) (Finset.range (t + 1)))) ∪
    (Finset.image (fun j => 2 * j + 1) (Finset.filter (fun j => Odd (Nat.choose t j)) (Finset.range (t + 1)))) := by
      ext k
      simp [Finset.mem_union, Finset.mem_image];
      constructor;
      · rcases Nat.even_or_odd' k with ⟨ k, rfl | rfl ⟩ <;> simp_all +arith +decide;
        · intro hk h; have := odd_choose_iff ( 2 * t + 1 ) ( 2 * k ) ; simp_all +decide [ Nat.odd_iff ] ;
          grind;
        · intro hk h; have := odd_choose_iff ( 2 * t + 1 ) ( 2 * k + 1 ) ; simp_all +arith +decide ;
          norm_num [ Nat.add_div ] at h ; aesop;
      · rintro ( ⟨ a, ⟨ ha₁, ha₂ ⟩, rfl ⟩ | ⟨ a, ⟨ ha₁, ha₂ ⟩, rfl ⟩ );
        · -- By Lucas' theorem, we know that $\binom{2t+1}{2a} \equiv \binom{t}{a} \pmod{2}$.
          have h_lucas : Nat.choose (2 * t + 1) (2 * a) % 2 = Nat.choose t a % 2 := by
            have h_lucas : ∀ (n k : ℕ), Nat.choose (2 * n + 1) (2 * k) % 2 = Nat.choose n k % 2 := by
              intros n k; induction' n with n ih generalizing k <;> induction' k with k ih' <;> simp +arith +decide [ Nat.choose, *, Nat.add_mod, Nat.mul_succ ] ;
              have := ih ( k + 1 ) ; simp_all +arith +decide [ Nat.choose_succ_succ, Nat.mul_succ ];
              grind;
            apply h_lucas;
          exact ⟨ by linarith, Nat.odd_iff.mpr ( h_lucas.trans ( Nat.odd_iff.mp ha₂ ) ) ⟩;
        · exact ⟨ by linarith, by rw [ odd_choose_iff ] ; norm_num [ Nat.add_mod, Nat.mul_mod, Nat.add_div ] ; aesop ⟩;
  convert congr_arg Finset.card h_split using 1;
  rw [ Finset.card_union_of_disjoint ] <;> norm_num [ Finset.card_image_of_injective, Function.Injective, complexity ] ; ring;
  norm_num [ Finset.disjoint_right ];
  intros; omega;

/-- Complexity recursion at even times: `complexity (2t) = complexity t`. -/
lemma complexity_even (t : ℕ) : complexity (2 * t) = complexity t := by
  refine' Finset.card_bij ( fun k hk => k / 2 ) _ _ _;
  · simp +zetaDelta at *;
    intro a ha h; have := odd_choose_iff ( 2 * t ) a; simp_all +decide [ Nat.odd_iff ] ;
    omega;
  · grind +suggestions;
  · intro b hb;
    have := odd_choose_iff ( 2 * t ) ( 2 * b ) ; simp_all +decide ;
    exact ⟨ 2 * b, ⟨ by linarith, this ⟩, by norm_num ⟩

/-- Popcount recursion at odd times. -/
lemma popcount_odd (t : ℕ) : popcount (2 * t + 1) = popcount t + 1 := by
  unfold popcount; simp +arith +decide [ Nat.add_div ] ;

/-- Popcount recursion at even times. -/
lemma popcount_even (t : ℕ) : popcount (2 * t) = popcount t := by
  unfold popcount; cases t <;> simp_all +decide [ Nat.add_div ] ;

/-- **Exact closed form for the Rule 90 row complexity.** -/
theorem complexity_eq_two_pow_popcount (t : ℕ) : complexity t = 2 ^ popcount t := by
  induction' t using Nat.strongRecOn with t ih;
  rcases Nat.even_or_odd' t with ⟨ s, rfl | rfl ⟩;
  · by_cases hs : s = 0;
    · aesop;
    · rw [ complexity_even, ih s ( by linarith [ Nat.pos_of_ne_zero hs ] ), popcount_even ];
  · simp_all +decide [ complexity_odd, popcount_odd, pow_succ' ];
    exact ih s ( by linarith )

/-- The popcount of a power of two is `1`. -/
lemma popcount_two_pow (k : ℕ) : popcount (2 ^ k) = 1 := by
  induction k <;> simp_all +decide [ pow_succ', popcount ]

/-- The popcount of a Mersenne number `2^k - 1` is `k`. -/
lemma popcount_two_pow_sub_one (k : ℕ) : popcount (2 ^ k - 1) = k := by
  induction' k with k ih;
  · simp [popcount];
  · convert congr_arg ( · + 1 ) ih using 1;
    convert popcount_odd ( 2 ^ k - 1 ) using 2 ; zify ; norm_num ; ring

/-- **Powers of two give maximally sparse rows:** `complexity (2^k) = 2` for every `k`. -/
theorem complexity_pow_two (k : ℕ) : complexity (2 ^ k) = 2 := by
  rw [complexity_eq_two_pow_popcount, popcount_two_pow, pow_one]

/-- **Mersenne times give full rows:** `complexity (2^k - 1) = 2^k`. -/
theorem complexity_mersenne (k : ℕ) : complexity (2 ^ k - 1) = 2 ^ k := by
  rw [complexity_eq_two_pow_popcount, popcount_two_pow_sub_one]

/-- The Mersenne row is *full*: its complexity equals `t + 1`, the maximum possible number of live
cells in a row of length `t + 1`. -/
theorem complexity_mersenne_full (k : ℕ) :
    complexity (2 ^ k - 1) = (2 ^ k - 1) + 1 := by
  rw [complexity_mersenne, Nat.sub_add_cancel (Nat.one_le_two_pow)]

/-- There are infinitely many *sparse* rows: for every `N` there is a time `t > N` with
`complexity t = 2`. -/
theorem sparse_rows_infinite (N : ℕ) : ∃ t > N, complexity t = 2 := by
  refine ⟨2 ^ (N + 1), ?_, complexity_pow_two _⟩
  calc N < N + 1 := Nat.lt_succ_self N
    _ ≤ 2 ^ (N + 1) := Nat.le_of_lt (Nat.lt_two_pow_self)

/-- There are infinitely many *full* rows: for every `N` there is a time `t > N` with
`complexity t = t + 1` (the maximum). -/
theorem full_rows_infinite (N : ℕ) : ∃ t > N, complexity t = t + 1 := by
  refine ⟨2 ^ (N + 1) - 1, ?_, complexity_mersenne_full _⟩
  have h : N + 1 < 2 ^ (N + 1) := Nat.lt_two_pow_self
  omega

end AdditiveCA