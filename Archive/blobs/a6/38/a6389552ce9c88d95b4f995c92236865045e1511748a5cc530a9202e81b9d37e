      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\"/>\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/>\n<title>Tropical Convolution Bound Explorer</title>\n<style>\n  :root { --bg:#0f172a; --card:#1e293b; --accent:#38bdf8; --good:#34d399; --bad:#f87171; --text:#e2e8f0; }\n  * { box-sizing:border-box; }\n  body { margin:0; font-family:-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;\n         background:var(--bg); color:var(--text); padding:24px; }\n  h1 { font-size:1.5rem; color:var(--accent); margin:0 0 4px; }\n  p.sub { margin:0 0 20px; color:#94a3b8; }\n  .card { background:var(--card); border-radius:12px; padding:18px 20px; margin-bottom:18px;\n          box-shadow:0 4px 20px rgba(0,0,0,.3); }\n  label { display:block; font-size:.85rem; color:#cbd5e1; margin-bottom:6px; }\n  input { width:100%; padding:9px 11px; border-radius:8px; border:1px solid #334155;\n          background:#0b1220; color:var(--text); font-family:ui-monospace,Menlo,monospace; }\n  .row { display:flex; gap:16px; flex-wrap:wrap; }\n  .row > div { flex:1 1 200px; }\n  table { width:100%; border-collapse:collapse; margin-top:10px; font-variant-numeric:tabular-nums; }\n  th,td { padding:8px 10px; text-align:center; border-bottom:1px solid #334155; }\n  th { color:#94a3b8; font-weight:600; font-size:.8rem; }\n  .gap0 { color:var(--good); }\n  .gappos { color:var(--accent); }\n  .formula { font-family:ui-monospace,Menlo,monospace; background:#0b1220; padding:10px 12px;\n             border-radius:8px; color:#cbd5e1; overflow-x:auto; }\n  .ok { color:var(--good); font-weight:600; }\n  .err { color:var(--bad); font-weight:600; }\n</style>\n</head>\n<body>\n  <h1>Tropical Convolution Bound Explorer</h1>\n  <p class=\"sub\">tropConv(vprofile a, vprofile b)(n) &le; v<sub>p</sub>((a &lowast; b)(n))</p>\n\n  <div class=\"card\">\n    <div class=\"formula\">\n      v<sub>p</sub>(x) = exponent of prime p in x &nbsp;|&nbsp;\n      (a &lowast; b)(n) = &Sigma;<sub>k=0..n</sub> a[k]&middot;b[n&minus;k] &nbsp;|&nbsp;\n      tropConv(u,w)(n) = min<sub>k=0..n</sub> ( u[k] + w[n&minus;k] )\n    </div>\n  </div>\n\n  <div class=\"card\">\n    <div class=\"row\">\n      <div>\n        <label>Prime p</label>\n        <input id=\"p\" value=\"2\"/>\n      </div>\n      <div>\n        <label>Sequence a (comma-separated integers)</label>\n        <input id=\"a\" value=\"1, 1, 1, 1, 1, 1\"/>\n      </div>\n      <div>\n        <label>Sequence b (comma-separated integers)</label>\n        <input id=\"b\" value=\"1, 1, 1, 1, 1, 1\"/>\n      </div>\n    </div>\n    <p id=\"status\" style=\"margin-top:12px;\"></p>\n  </div>\n\n  <div class=\"card\">\n    <table id=\"out\">\n      <thead><tr><th>n</th><th>(a&lowast;b)(n)</th><th>tropical bound</th><th>true v<sub>p</sub></th><th>gap</th></tr></thead>\n      <tbody></tbody>\n    </table>\n  </div>\n\n<script>\nfunction vp(x, p) {\n  if (x === 0) return Infinity;\n  x = Math.abs(x); let c = 0;\n  while (x % p === 0) { x /= p; c++; }\n  return c;\n}\nfunction parseSeq(s) {\n  return s.split(',').map(t => t.trim()).filter(t => t.length).map(Number);\n}\nfunction recompute() {\n  const p = parseInt(document.getElementById('p').value, 10);\n  const a = parseSeq(document.getElementById('a').value);\n  const b = parseSeq(document.getElementById('b').value);\n  const status = document.getElementById('status');\n  const tbody = document.querySelector('#out tbody');\n  tbody.innerHTML = '';\n  if (!(p >= 2) || a.some(isNaN) || b.some(isNaN) || a.length===0 || b.length===0) {\n    status.innerHTML = '<span class=\"err\">Enter a prime p&ge;2 and integer sequences.</span>';\n    return;\n  }\n  const ua = a.map(x => vp(x, p));\n  const ub = b.map(x => vp(x, p));\n  const N = a.length + b.length - 2;\n  let allOk = true;\n  for (let n = 0; n <= N; n++) {\n    let conv = 0, bound = Infinity;\n    for (let k = 0; k <= n; k++) {\n      const ak = k < a.length ? a[k] : 0;\n      const bnk = (n-k) < b.length ? b[n-k] : 0;\n      conv += ak * bnk;\n      const uk = k < ua.length ? ua[k] : Infinity;\n      const wnk = (n-k) < ub.length ? ub[n-k] : Infinity;\n      bound = Math.min(bound, uk + wnk);\n    }\n    const tv = vp(conv, p);\n    const ok = bound <= tv;\n    allOk = allOk && ok;\n    const gap = (tv === Infinity) ? '&infin;' : (tv - bound);\n    const gapClass = (tv - bound === 0) ? 'gap0' : 'gappos';\n    const tr = document.createElement('tr');\n    tr.innerHTML =\n      `<td>${n}</td><td>${conv}</td>` +\n      `<td>${bound===Infinity?'&infin;':bound}</td>` +\n      `<td>${tv===Infinity?'&infin;':tv}</td>` +\n      `<td class=\"${gapClass}\">${gap}</td>`;\n    tbody.appendChild(tr);\n  }\n  status.innerHTML = allOk\n    ? '<span class=\"ok\">&#10003; Bound holds at every index (as proved).</span>'\n    : '<span class=\"err\">Unexpected violation &mdash; check inputs.</span>';\n}\n['p','a','b'].forEach(id => document.getElementById(id).addEventListener('input', recompute));\nrecompute();\n</script>\n</body>\n</html>\n"
