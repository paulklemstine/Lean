  "algorithms": [
    {
      "name": "Min-Plus (Tropical) Convolution via Antidiagonal Relaxation",
      "description": "Computes tropConv(u, w)(n) = min over k in {0,...,n} of (u[k] + w[n-k]), the tropical analogue of a Cauchy convolution coefficient. It is a single relaxation pass over the antidiagonal of index n, identical in shape to one step of a shortest-path / dynamic-programming recurrence in the min-plus semiring (WithTop N, min, +). Evaluating one coefficient costs O(n) additions and comparisons; building the entire profile up to degree N costs O(N^2). Infinity (the valuation of zero) is the additive identity of the tropical semiring and is handled by ordinary floating min/sum with math.inf.",
      "pseudocode": "function TROPCONV(u, w, n):\n    best <- +infinity            # additive identity of (WithTop N, min, +)\n    for k from 0 to n:\n        term <- u[k] + w[n - k]   # tropical product = ordinary sum\n        best <- min(best, term)   # tropical sum = ordinary min\n    return best",
      "code": "import math\nfrom typing import List, Sequence\n\ndef trop_conv(u: Sequence[float], w: Sequence[float], n: int) -> float:\n    \"\"\"Min-plus convolution coefficient tropConv(u, w)(n).\"\"\"\n    best: float = math.inf\n    for k in range(n + 1):\n        uk: float = u[k] if k < len(u) else math.inf\n        wnk: float = w[n - k] if (n - k) < len(w) else math.inf\n        best = min(best, uk + wnk)\n    return best\n\ndef trop_conv_profile(u: Sequence[float], w: Sequence[float], n_max: int) -> List[float]:\n    \"\"\"Full tropical convolution profile up to degree n_max (O(n_max^2)).\"\"\"\n    return [trop_conv(u, w, n) for n in range(n_max + 1)]\n"
