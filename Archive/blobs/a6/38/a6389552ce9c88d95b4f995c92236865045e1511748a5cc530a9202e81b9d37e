    "demo": "\"\"\"\ndemo.py — Numerical demonstrations of the Tropical Convolution Bound.\n\nThis script illustrates the main theorem of the package:\n\n    tropConv(vprofile(a), vprofile(b))(n)  <=  v( (a * b)(n) )\n\nwhere\n  * v is an additive valuation (here the p-adic valuation v_p),\n  * vprofile(a) is the coefficient-wise valuation of a sequence a,\n  * (a * b) is the finite Cauchy convolution\n        (a * b)(n) = sum_{k=0}^{n} a[k] * b[n-k],\n  * tropConv is the min-plus (tropical) convolution\n        tropConv(u, w)(n) = min_{k=0}^{n} ( u[k] + w[n-k] ).\n\nWe use math.inf to model the top element (infinity) of WithTop N, the value\nassigned to the valuation of 0.\n\nEvery function is inlined and fully type hinted; the file is self-contained and\nrequires only the Python standard library.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport math\nfrom fractions import Fraction\nfrom typing import Callable, List, Sequence, Tuple\n\n# A valuation maps a number to an element of WithTop N, modelled as float\n# (a nonnegative integer, or math.inf for the valuation of 0).\nValuation = Callable[[Fraction], float]\n\n\n# --------------------------------------------------------------------------- #\n# Valuations                                                                   #\n# --------------------------------------------------------------------------- #\ndef p_adic_valuation(p: int) -> Valuation:\n    \"\"\"Return the p-adic valuation v_p on the rationals.\n\n    v_p(0) = inf; otherwise v_p(x) = (exponent of p in numerator)\n                                   - (exponent of p in denominator).\n    For integer inputs this is the usual count of factors of p.\n    \"\"\"\n\n    def v(x: Fraction) -> float:\n        if x == 0:\n            return math.inf\n        x = Fraction(x)\n        num, den = abs(x.numerator), x.denominator\n\n        def order(m: int) -> int:\n            c = 0\n            while m % p == 0:\n                m //= p\n                c += 1\n            return c\n\n        return float(order(num) - order(den))\n\n    return v\n\n\n# --------------------------------------------------------------------------- #\n# Core operations                                                             #\n# --------------------------------------------------------------------------- #\ndef vprofile(v: Valuation, a: Sequence[Fraction]) -> List[float]:\n    \"\"\"Coefficient-wise valuation profile of a finite sequence.\"\"\"\n    return [v(Fraction(x)) for x in a]\n\n\ndef cauchy_conv(a: Sequence[Fraction], b: Sequence[Fraction], n: int) -> Fraction:\n    \"\"\"Finite Cauchy convolution (a * b)(n) = sum_{k=0}^{n} a[k] * b[n-k].\"\"\"\n    total = Fraction(0)\n    for k in range(n + 1):\n        ak = Fraction(a[k]) if k < len(a) else Fraction(0)\n        bnk = Fraction(b[n - k]) if (n - k) < len(b) else Fraction(0)\n        total += ak * bnk\n    return total\n\n\ndef trop_conv(u: Sequence[float], w: Sequence[float], n: int) -> float:\n    \"\"\"Min-plus convolution tropConv(u, w)(n) = min_k (u[k] + w[n-k]).\"\"\"\n    best = math.inf\n    for k in range(n + 1):\n        uk = u[k] if k < len(u) else math.inf\n        wnk = w[n - k] if (n - k) < len(w) else math.inf\n        best = min(best, uk + wnk)\n    return best\n\n\n# --------------------------------------------------------------------------- #\n# Certification of the main theorem                                          #\n# --------------------------------------------------------------------------- #\ndef certify_bound(\n    a: Sequence[Fraction],\n    b: Sequence[Fraction],\n    v: Valuation,\n    n_max: int,\n) -> List[Tuple[int, float, float, float]]:\n    \"\"\"For n = 0..n_max, compute the tropical lower bound and the true valuation\n    of the Cauchy convolution, assert the bound, and return a report table of\n    (n, tropical_bound, true_valuation, gap) where gap = true - bound >= 0.\n    \"\"\"\n    ua, ub = vprofile(v, a), vprofile(v, b)\n    table: List[Tuple[int, float, float, float]] = []\n    for n in range(n_max + 1):\n        lhs = trop_conv(ua, ub, n)\n        c_n = cauchy_conv(a, b, n)\n        rhs = v(c_n)\n        assert lhs <= rhs, f\"BOUND VIOLATED at n={n}: {lhs} > {rhs}\"\n        gap = math.inf if rhs == math.inf else rhs - lhs\n        table.append((n, lhs, rhs, gap))\n    return table\n\n\ndef fmt(x: float) -> str:\n    return \"inf\" if x == math.inf else str(int(x))\n\n\ndef print_table(title: str, table: List[Tuple[int, float, float, float]]) -> None:\n    print(title)\n    print(f\"  {'n':>3} | {'trop bound':>11} | {'v(a*b)(n)':>10} | {'gap':>5}\")\n    print(\"  \" + \"-\" * 40)\n    for n, lhs, rhs, gap in table:\n        print(f\"  {n:>3} | {fmt(lhs):>11} | {fmt(rhs):>10} | {fmt(gap):>5}\")\n    print()\n\n\n# --------------------------------------------------------------------------- #\n# Demonstrations                                                              #\n# --------------------------------------------------------------------------- #\ndef demo_geometric() -> None:\n    \"\"\"A geometric example a[k]=b[k]=3^k. The minimizing split ties across\n    the antidiagonal, so the bound is exact where the number of tied terms is\n    coprime to p and strict (gap>0) where that count is divisible by p.\"\"\"\n    # a[k] = p^k, b[k] = p^k with p = 3.  v_3(a[k]) = k, v_3(b[k]) = k.\n    p = 3\n    v = p_adic_valuation(p)\n    a = [Fraction(p) ** k for k in range(6)]\n    b = [Fraction(p) ** k for k in range(6)]\n    table = certify_bound(a, b, v, n_max=5)\n    print_table(\"[Geometric]  a[k]=b[k]=3^k, valuation v_3:\", table)\n\n\ndef demo_cancellation() -> None:\n    \"\"\"A non-transverse example exhibiting cancellation, so the tropical bound\n    is a STRICT lower bound (gap > 0) at some indices.\"\"\"\n    p = 2\n    v = p_adic_valuation(p)\n    # Two terms tie for the minimum and cancel mod higher powers of 2.\n    a = [Fraction(1), Fraction(2), Fraction(1)]   # 1 + 2x + x^2 = (1+x)^2\n    b = [Fraction(1), Fraction(-2), Fraction(1)]  # 1 - 2x + x^2 = (1-x)^2\n    # product = (1-x^2)^2 = 1 - 2x^2 + x^4 ; the x^1, x^3 coeffs vanish -> v=inf\n    table = certify_bound(a, b, v, n_max=4)\n    print_table(\"[Cancellation]  (1+x)^2 * (1-x)^2, valuation v_2  (expect gaps):\", table)\n\n\ndef demo_binomial_kummer() -> None:\n    \"\"\"Binomial coefficients and Kummer's theorem: convolving the all-ones\n    sequence with itself yields partial sums; here we showcase how the\n    tropical bound tracks v_p of convolution coefficients.\"\"\"\n    p = 2\n    v = p_adic_valuation(p)\n    # a = b = (1,1,1,...) ; (a*b)(n) = n+1.  v_2(n+1) is the bound's target.\n    a = [Fraction(1)] * 8\n    b = [Fraction(1)] * 8\n    table = certify_bound(a, b, v, n_max=7)\n    print_table(\"[Counting]  all-ones * all-ones = (n+1), valuation v_2:\", table)\n\n\ndef demo_newton_polygon() -> None:\n    \"\"\"Newton-polygon flavour: a sequence whose valuation profile is convex.\n    The tropical convolution of two such profiles is their inf-convolution,\n    a discrete Minkowski sum of Newton polygons.\"\"\"\n    p = 5\n    v = p_adic_valuation(p)\n    # a[k] = p^(k*k) gives a strictly convex profile (k^2).\n    a = [Fraction(p) ** (k * k) for k in range(5)]\n    b = [Fraction(p) ** (k * k) for k in range(5)]\n    table = certify_bound(a, b, v, n_max=4)\n    print_table(\"[Newton]  a[k]=b[k]=5^(k^2) (convex profile), valuation v_5:\", table)\n\n\ndef main() -> None:\n    print(\"=\" * 52)\n    print(\" Tropical Convolution Bound — numerical demonstrations\")\n    print(\"=\" * 52)\n    print()\n    demo_geometric()\n    demo_cancellation()\n    demo_binomial_kummer()\n    demo_newton_polygon()\n    print(\"All bounds verified:  tropConv(profiles)(n) <= v((a*b)(n)).\")\n\n\nif __name__ == \"__main__\":\n    main()\n"
