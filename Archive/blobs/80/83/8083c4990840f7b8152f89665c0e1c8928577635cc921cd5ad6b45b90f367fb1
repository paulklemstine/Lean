import Mathlib
import Geometry.HomotopyTypeTheory.EckmannHilton

/-!
# Bi-unital Eckmann–Hilton: deriving the shared unit

The catalog file `Geometry.HomotopyTypeTheory.EckmannHilton` (namespace `HoTT`)
runs the Eckmann–Hilton argument under the *hypothesis* that the two interchanging
operations share a common identity element (`hunit : S.e = T.e`).

This file removes that hypothesis. We package two binary operations, **each with its
own two-sided unit**, plus the interchange law, into `BiunitalInterchange`. The
classical four-term collapse then proves the two units must coincide (`unit_eq`), so
the shared-unit assumption is *derivable*, not axiomatic. Transporting back into the
catalog engine recovers operation-equality, commutativity, and (newly) associativity,
upgrading the carrier to a genuine `CommMonoid`.

## Main results

* `BiunitalInterchange.unit_eq` — the two a-priori distinct units coincide.
* `BiunitalInterchange.ops_eq` — the two operations are pointwise equal.
* `BiunitalInterchange.comm` — the operation is commutative.
* `BiunitalInterchange.assoc` — the operation is associative (medial + unital ⇒ assoc).
* `BiunitalInterchange.toCommMonoid` — the carrier is a commutative monoid.

-- !-- Lab Notebook -- !--
Hypothesis: The shared-unit hypothesis `S.e = T.e` in the catalog's
  `eckmann_hilton_ops_eq` / `eckmann_hilton_comm` is not a genuine axiom but a
  theorem once each operation is given its own unit.
Result: Confirmed. `unit_eq` derives `e₂ = e₁` from the interchange law alone via the
  four-term collapse `e₂ = e₂·e₂ = (e₂∘e₁)·(e₁∘e₂) = (e₂·e₁)∘(e₁·e₂) = e₁∘e₁ = e₁`.
  Moreover associativity, which the catalog never proved, follows from the *medial*
  law `(a∘b)·(c∘d)=(a·c)∘(b·d)` specialised at unit slots: `a·(b·c)=(a·e)·(b·c)=
  (a·b)·(e·c)=(a·b)·c`. So a bi-unital interchange datum is exactly a commutative monoid.
Insight: The unit count is the only "extra" hypothesis; once it is paid for, the full
  commutative-monoid structure (unit, commutativity, associativity) is forced. The
  two-dimensional unital interchange datum and the one-dimensional commutative monoid
  carry literally the same information.
Failure analysis: An earlier framing tried to derive associativity from
  commutativity alone — impossible (commutative magmas need not be associative). The
  medial law is the load-bearing ingredient; specialising *one* slot to the unit is
  exactly what converts medial into associative.
-/

namespace Logic.AutoResearch

universe u

/-- Two binary operations on `α`, **each with its own two-sided unit**, satisfying the
interchange law `op₂ (op₁ a b) (op₁ c d) = op₁ (op₂ a c) (op₂ b d)`. Unlike the catalog's
`HoTT.BinarySystem` pair, no shared unit is assumed. -/
structure BiunitalInterchange (α : Type u) where
  /-- The "vertical" operation. -/
  op₁ : α → α → α
  /-- The "horizontal" operation. -/
  op₂ : α → α → α
  /-- Unit of `op₁`. -/
  e₁ : α
  /-- Unit of `op₂`. -/
  e₂ : α
  op₁_left  : ∀ a, op₁ e₁ a = a
  op₁_right : ∀ a, op₁ a e₁ = a
  op₂_left  : ∀ a, op₂ e₂ a = a
  op₂_right : ∀ a, op₂ a e₂ = a
  /-- The interchange (middle-four) law. -/
  interchange : ∀ a b c d, op₂ (op₁ a b) (op₁ c d) = op₁ (op₂ a c) (op₂ b d)

namespace BiunitalInterchange

variable {α : Type u} (D : BiunitalInterchange α)

/-
!-- Four-term collapse: `e₂ = e₂·e₂ = (e₂∘e₁)·(e₁∘e₂) = (e₂·e₁)∘(e₁·e₂) = e₁∘e₁ = e₁`,
using each unit law once and interchange once. -- !--

The two a-priori distinct units of a bi-unital interchange datum coincide.
-/
theorem unit_eq : D.e₂ = D.e₁ := by
  have := D.interchange D.e₂ D.e₁ D.e₁ D.e₂;
  convert this using 1 <;> simp +decide [ D.op₁_left, D.op₁_right, D.op₂_left, D.op₂_right ]

/-- The vertical operation of `D` packaged as a `HoTT.BinarySystem`. -/
def sys₁ : HoTT.BinarySystem α where
  op := D.op₁
  e := D.e₁
  op_left_id := D.op₁_left
  op_right_id := D.op₁_right

/-- The horizontal operation of `D` packaged as a `HoTT.BinarySystem`. -/
def sys₂ : HoTT.BinarySystem α where
  op := D.op₂
  e := D.e₂
  op_left_id := D.op₂_left
  op_right_id := D.op₂_right

/-- The interchange field, restated for the two `HoTT.BinarySystem`s.  The catalog's
`InterchangeLaw S T` is `T.op (S.op a b) (S.op c d) = S.op (T.op a c) (T.op b d)`, which
matches our `interchange` with `S = sys₁`, `T = sys₂`. -/
theorem interchange_sys : HoTT.InterchangeLaw D.sys₁ D.sys₂ := D.interchange

/-- The two operations are pointwise equal. -/
theorem ops_eq : ∀ a b, D.op₁ a b = D.op₂ a b := by
  have h := HoTT.eckmann_hilton_ops_eq D.sys₁ D.sys₂
    (by simpa [sys₁, sys₂] using D.unit_eq.symm) D.interchange_sys
  intro a b; simpa [sys₁, sys₂] using h a b

/-- The (common) operation is commutative. -/
theorem comm : ∀ a b, D.op₁ a b = D.op₁ b a := by
  have h := HoTT.eckmann_hilton_comm D.sys₁ D.sys₂
    (by simpa [sys₁, sys₂] using D.unit_eq.symm) D.interchange_sys
  intro a b; simpa [sys₁, sys₂] using h a b

/-
!-- Medial + unital ⇒ associative: `a∘(b∘c) = (a∘e₁)∘(b∘c) = (a∘b)∘(e₁∘c) = (a∘b)∘c`,
where the middle step rewrites `op₁` as `op₂` (via `ops_eq`) to apply `interchange`. -- !--

The (common) operation is associative.
-/
theorem assoc : ∀ a b c, D.op₁ (D.op₁ a b) c = D.op₁ a (D.op₁ b c) := by
  intro a b c;
  have h_medial : ∀ a b c d, D.op₁ (D.op₁ a b) (D.op₁ c d) = D.op₁ (D.op₁ a c) (D.op₁ b d) := by
    intro a b c d;
    convert D.interchange a b c d using 1 <;> simp +decide [ ← D.ops_eq ];
  convert h_medial a b D.e₁ c using 1 <;> simp +decide [ D.op₁_left, D.op₁_right ]

/-- The carrier of a bi-unital interchange datum is a commutative monoid under `op₁`. -/
def toCommMonoid : CommMonoid α where
  mul := D.op₁
  one := D.e₁
  one_mul := D.op₁_left
  mul_one := D.op₁_right
  mul_assoc := D.assoc
  mul_comm := D.comm

end BiunitalInterchange

end Logic.AutoResearch