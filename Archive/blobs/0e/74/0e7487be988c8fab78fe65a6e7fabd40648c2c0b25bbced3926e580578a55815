  "interactive_demos": [
    {
      "title": "The Geodesic Ruler of Filtration Space — Live Bridge X Explorer",
      "description": "An interactive widget that turns the abstract space of persistence fingerprints into a draggable ruler. Adjust the endpoint weights of two filtrations F and G on a handful of simplices, then slide the geodesic parameters s, u, t, r. The widget draws the geodesic ruler with F at 0 and G at d(F,G), marks the interpolated points, and verifies all five Bridge X laws live with green check marks: the affine gluing law (lerp of a lerp is a reparametrized lerp), the far-endpoint distance, exact additive betweenness, the universal additive split, and multiplicativity of nested speed. Watching the check marks stay green as the sliders move makes the local-to-global coherence of the geodesic field tangible.",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\"/>\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/>\n<title>Bridge X — Interactive Geodesic Ruler of Filtration Space</title>\n<style>\n  :root { --bg:#0e1726; --card:#16223a; --ink:#e8eefc; --accent:#5ac8fa; --warn:#ffb454;\n          --good:#7ee787; --muted:#9fb0d0; }\n  * { box-sizing:border-box; }\n  body { margin:0; font-family:-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;\n         background:linear-gradient(160deg,#0a1020,#10203a); color:var(--ink); padding:24px; }\n  h1 { font-size:1.5rem; margin:0 0 4px; }\n  .sub { color:var(--muted); margin-bottom:18px; max-width:820px; line-height:1.5; }\n  .wrap { display:grid; grid-template-columns:1fr 1fr; gap:18px; max-width:1000px; }\n  .card { background:var(--card); border:1px solid #25406b; border-radius:14px; padding:18px; }\n  .card h2 { font-size:1rem; margin:0 0 12px; color:var(--accent); }\n  label { display:flex; justify-content:space-between; font-size:.86rem; color:var(--muted);\n          margin:10px 0 4px; }\n  input[type=range]{ width:100%; accent-color:var(--accent); }\n  canvas { width:100%; background:#0b1426; border-radius:10px; border:1px solid #25406b; }\n  .eq { font-family:ui-monospace,Menlo,Consolas,monospace; font-size:.84rem; line-height:1.7;\n        background:#0b1426; border-radius:10px; padding:12px; border:1px solid #25406b; }\n  .ok { color:var(--good); } .v { color:var(--accent); } .bad{ color:var(--warn); }\n  .full { grid-column:1 / -1; }\n</style>\n</head>\n<body>\n  <h1>The Geodesic Ruler of Filtration Space</h1>\n  <div class=\"sub\">\n    A <b>filtration</b> assigns a birth-scale to each cluster of data. The\n    <b>interleaving distance</b> between two filtrations <i>F</i> and <i>G</i> is the worst-case\n    gap, <i>d(F,G)=max<sub>σ</sub>|F(σ)−G(σ)|</i>. The geodesic\n    <i>lerp(F,G,t)=(1−t)F+tG</i> travels at constant speed:\n    <i>d(lerp s, lerp t)=|s−t|·d(F,G)</i>. Drag the sliders to watch Bridge X's laws hold\n    exactly: the affine <b>gluing law</b>, <b>betweenness</b>, and the <b>universal split</b>.\n  </div>\n\n  <div class=\"wrap\">\n    <div class=\"card\">\n      <h2>Endpoints (weights on three simplices)</h2>\n      <label>F weight on {0,1} <span class=\"v\" id=\"f01v\">1.0</span></label>\n      <input id=\"f01\" type=\"range\" min=\"0\" max=\"6\" step=\"0.1\" value=\"1\"/>\n      <label>G weight on {0,1} <span class=\"v\" id=\"g01v\">4.0</span></label>\n      <input id=\"g01\" type=\"range\" min=\"0\" max=\"6\" step=\"0.1\" value=\"4\"/>\n      <label>F weight on {0,1,2} <span class=\"v\" id=\"f012v\">2.0</span></label>\n      <input id=\"f012\" type=\"range\" min=\"0\" max=\"6\" step=\"0.1\" value=\"2\"/>\n      <label>G weight on {0,1,2} <span class=\"v\" id=\"g012v\">3.0</span></label>\n      <input id=\"g012\" type=\"range\" min=\"0\" max=\"6\" step=\"0.1\" value=\"3\"/>\n    </div>\n\n    <div class=\"card\">\n      <h2>Geodesic parameters</h2>\n      <label>s <span class=\"v\" id=\"sv\">0.20</span></label>\n      <input id=\"s\" type=\"range\" min=\"0\" max=\"1\" step=\"0.01\" value=\"0.2\"/>\n      <label>u (must satisfy s ≤ u ≤ t) <span class=\"v\" id=\"uv\">0.55</span></label>\n      <input id=\"u\" type=\"range\" min=\"0\" max=\"1\" step=\"0.01\" value=\"0.55\"/>\n      <label>t <span class=\"v\" id=\"tv\">0.90</span></label>\n      <input id=\"t\" type=\"range\" min=\"0\" max=\"1\" step=\"0.01\" value=\"0.9\"/>\n      <label>r (nesting / gluing rate) <span class=\"v\" id=\"rv\">0.50</span></label>\n      <input id=\"r\" type=\"range\" min=\"0\" max=\"1\" step=\"0.01\" value=\"0.5\"/>\n    </div>\n\n    <div class=\"card full\">\n      <h2>Geodesic ruler &amp; segment lengths</h2>\n      <canvas id=\"cv\" width=\"940\" height=\"180\"></canvas>\n    </div>\n\n    <div class=\"card full\">\n      <h2>Live verification of the Bridge X laws</h2>\n      <div class=\"eq\" id=\"out\"></div>\n    </div>\n  </div>\n\n<script>\nconst $ = id => document.getElementById(id);\nfunction dist(F,G){ let m=0; for(const k in F){ m=Math.max(m,Math.abs(F[k]-(G[k]||0))); }\n  for(const k in G){ m=Math.max(m,Math.abs((F[k]||0)-G[k])); } return m; }\nfunction lerp(F,G,t){ const o={}; for(const k in F) o[k]=(1-t)*F[k]+t*(G[k]||0);\n  for(const k in G) if(!(k in o)) o[k]=(1-t)*0+t*G[k]; return o; }\n\nfunction recompute(){\n  const f01=+$('f01').value,g01=+$('g01').value,f012=+$('f012').value,g012=+$('g012').value;\n  let s=+$('s').value,u=+$('u').value,t=+$('t').value,r=+$('r').value;\n  // keep s<=u<=t for the betweenness panel\n  if(u<s)u=s; if(u>t)u=t;\n  $('f01v').textContent=f01.toFixed(1); $('g01v').textContent=g01.toFixed(1);\n  $('f012v').textContent=f012.toFixed(1); $('g012v').textContent=g012.toFixed(1);\n  $('sv').textContent=s.toFixed(2); $('uv').textContent=u.toFixed(2);\n  $('tv').textContent=t.toFixed(2); $('rv').textContent=r.toFixed(2);\n\n  const F={'{0,1}':f01,'{0,1,2}':f012}, G={'{0,1}':g01,'{0,1,2}':g012};\n  const d=dist(F,G);\n  const Fs=lerp(F,G,s),Fu=lerp(F,G,u),Ft=lerp(F,G,t);\n\n  // gluing law: lerp(lerp s, lerp t, r) == lerp(F,G,(1-r)s+r t)\n  const glueL=lerp(Fs,Ft,r), uStar=(1-r)*s+r*t, glueR=lerp(F,G,uStar);\n  const glueErr=dist(glueL,glueR);\n\n  const dsu=dist(Fs,Fu), dut=dist(Fu,Ft), dst=dist(Fs,Ft);\n  const dFt=dist(F,Ft), dtG=dist(Ft,G);\n  const nestL=dist(lerp(Fs,Ft,0.2),lerp(Fs,Ft,0.8));\n  const nestR=Math.abs(0.2-0.8)*(Math.abs(s-t)*d);\n\n  const fmt=x=>x.toFixed(4);\n  const chk=(a,b)=>Math.abs(a-b)<1e-9?'<span class=\"ok\">✓</span>':'<span class=\"bad\">✗</span>';\n  $('out').innerHTML =\n    `d(F,G) = <span class=\"v\">${fmt(d)}</span><br><br>`+\n    `1. gluing law:  lerp(lerp s, lerp t, r) = lerp(F,G,(1−r)s+rt),  u*=${fmt(uStar)}`+\n    `   ‖Δ‖=${fmt(glueErr)} ${chk(glueErr,0)}<br>`+\n    `2. far endpoint:  d(lerp t, G)=${fmt(dtG)}  vs (1−t)·d=${fmt((1-t)*d)} ${chk(dtG,(1-t)*d)}<br>`+\n    `3. betweenness (s≤u≤t):  d(s,u)+d(u,t)=${fmt(dsu+dut)}  vs d(s,t)=${fmt(dst)} ${chk(dsu+dut,dst)}<br>`+\n    `4. universal split:  d(F,lerp t)+d(lerp t,G)=${fmt(dFt+dtG)}  vs d(F,G)=${fmt(d)} ${chk(dFt+dtG,d)}<br>`+\n    `5. nested speed:  d=${fmt(nestL)}  vs |a−b|·|s−t|·d=${fmt(nestR)} ${chk(nestL,nestR)}`;\n\n  draw(s,u,t,d,dsu,dut);\n}\n\nfunction draw(s,u,t,d,dsu,dut){\n  const cv=$('cv'),x=cv.getContext('2d'); x.clearRect(0,0,cv.width,cv.height);\n  const W=cv.width, L=40, R=W-40, y=70;\n  // main ruler F(0) ... G(1)\n  x.strokeStyle='#3a5a90'; x.lineWidth=2; x.beginPath(); x.moveTo(L,y); x.lineTo(R,y); x.stroke();\n  const px=p=>L+(R-L)*p;\n  const pts=[['F',0,'#5ac8fa'],['s',s,'#7ee787'],['u',u,'#ffb454'],['t',t,'#ff7b9c'],['G',1,'#5ac8fa']];\n  x.font='12px monospace';\n  for(const [lab,p,c] of pts){ x.fillStyle=c; x.beginPath(); x.arc(px(p),y,5,0,7); x.fill();\n    x.fillText(lab,px(p)-4,y-12); x.fillText(p.toFixed(2),px(p)-12,y+22); }\n  // segment bars below for betweenness\n  const by=130, h=18;\n  x.fillStyle='#4c72b0'; x.fillRect(px(s),by,px(u)-px(s),h);\n  x.fillStyle='#dd8452'; x.fillRect(px(u),by,px(t)-px(u),h);\n  x.fillStyle='#9fb0d0';\n  x.fillText('d(s,u)='+dsu.toFixed(2),px(s)+4,by+34);\n  x.fillText('d(u,t)='+dut.toFixed(2),px(u)+4,by-6);\n}\ndocument.querySelectorAll('input').forEach(el=>el.addEventListener('input',recompute));\nrecompute();\n</script>\n</body>\n</html>\n"
    }
