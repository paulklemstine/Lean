import Mathlib

/-! # Density along the whole height ladder of p-degrees

This file proves **density at every rung of an infinite ladder of proof-complexity
(simulation) degrees**: between any two consecutive ladder degrees there is a strictly
intermediate p-degree (`exists_strictly_between_powSystem`).

## The simulation-degree framework (self-contained)

A *size-based proof system* over an index type `F` is abstracted by its **size function**
`F → ℕ` (the minimal proof size of the `n`-th formula).  Following the Cook–Reckhow
notion of *p-simulation*, a system `S` is simulated by a system `T` (written `S ≤ T`) when
the sizes of `S` are **polynomially dominated** by the sizes of `T`: there is a polynomially
bounded, monotone `φ : ℕ → ℕ` with `S.size n ≤ φ (T.size n)` for all `n`.  This is a genuine
preorder (`Preorder (ProofSystem F)`), and the induced strict order `<` is the strict
p-degree relation.

* `polyMono φ` packages "`φ` is monotone and polynomially bounded".
* `sysOfSize f` is the system with size function `f`.
* `simulates_sysOfSize_iff` reduces simulation between two size-based systems to polynomial
  domination of their size functions — the engine of every comparison below.
* `powSystem k` is the height-`k` ladder rung, with size `2 ^ (n ^ k)`; the ladder is
  strictly increasing in `k` (for `k ≥ 1`) because the exponents `n^k` are
  super-polynomially apart.

## The parity-glued intermediate system

The witness `interPowSys k` is the *parity-glued* size function that runs the upper rate
`2 ^ (n ^ (k+1))` on the even indices and the lower rate `2 ^ (n ^ k)` on the odd indices:
super-polynomially above the lower rung (the even indices keep the faster rate), yet too
thin to recover the upper rung (the odd indices fall back to the slower rate).  This is a
*local-to-global* glueing: a degree is assembled from the two rates prescribed on the two
residue classes mod 2.

The engine is the domination characterisation `simulates_sysOfSize_iff` together with the
uniform gap `pow_pow_succ_gap_strong`, an "all-large-`n`" super-polynomial gap that lets us
select a witness of prescribed parity.

-- !-- Lab Notebook -- !--
Hypothesis : A single density witness between two consecutive ladder rungs
             `powSystem k < powSystem (k+1)` should exist for *every* `k ≥ 1`, via a
             parity-thinning trick applied to the ladder's exponents.
Result     : Confirmed, `sorry = 0`.  `interPowSys k` lies strictly between `powSystem k`
             and `powSystem (k+1)` for every `k ≥ 1` (`powSystem_lt_interPow`,
             `interPow_lt_powSystem_succ`, `exists_strictly_between_powSystem`).
Insight    : Density needs a super-polynomial gap witness of a *chosen parity*.  The
             all-large-`n` gap `pow_pow_succ_gap_strong` makes the parity free: pick an even
             or odd witness above the threshold as needed.  The clean bound is
             `(2^(n^k)+2)^c ≤ 2^(c·n^k + c) < 2^(n^(k+1))` whenever `n ≥ c + 2`, since then
             `c·n^k + c < n·n^k = n^(k+1)`.
Failure analysis : A fixed-parity witness `n = c + 2` can only refute *one* of the two
             simulations needed to sandwich `interPowSys`.  The all-large-`n` form removes
             that coupling.
-- !-- Lab Notebook -- !--
-/

set_option maxHeartbeats 1000000

namespace ProofComplexity

universe u

/-! ## Size-based proof systems and the p-simulation preorder -/

/-- A size-based proof system over an index type `F` is captured by its **size function**
`F → ℕ`: the minimal proof size of each formula. -/
structure ProofSystem (F : Type u) where
  /-- The minimal proof size of each indexed formula. -/
  size : F → ℕ

/-- `φ : ℕ → ℕ` is **polynomially monotone**: monotone and polynomially bounded.  This is
the class of admissible overheads in a p-simulation. -/
def polyMono (φ : ℕ → ℕ) : Prop :=
  Monotone φ ∧ ∃ c, ∀ m, φ m + 1 ≤ (m + 2) ^ c

/-- The identity is polynomially monotone (overhead `c = 1`). -/
theorem polyMono_id : polyMono id := by
  refine ⟨monotone_id, 1, fun m => ?_⟩
  simp

/-- A composite of polynomially monotone maps is polynomially monotone: composing
polynomials yields a polynomial. -/
theorem polyMono_comp {φ ψ : ℕ → ℕ} (hφ : polyMono φ) (hψ : polyMono ψ) :
    polyMono (φ ∘ ψ) := by
  obtain ⟨hφm, a, ha⟩ := hφ
  obtain ⟨hψm, b, hb⟩ := hψ
  refine ⟨hφm.comp hψm, a * (b + 1), fun m => ?_⟩
  have h1 : φ (ψ m) + 1 ≤ (ψ m + 2) ^ a := ha (ψ m)
  have h2 : ψ m + 2 ≤ (m + 2) ^ (b + 1) := by
    have := hb m
    calc ψ m + 2 ≤ (m + 2) ^ b + 1 := by omega
      _ ≤ (m + 2) ^ b + (m + 2) ^ b := by
            have : 1 ≤ (m + 2) ^ b := Nat.one_le_pow _ _ (by omega)
            omega
      _ = 2 * (m + 2) ^ b := by ring
      _ ≤ (m + 2) * (m + 2) ^ b := by
            apply Nat.mul_le_mul_right; omega
      _ = (m + 2) ^ (b + 1) := by ring
  calc φ (ψ m) + 1 ≤ (ψ m + 2) ^ a := h1
    _ ≤ ((m + 2) ^ (b + 1)) ^ a := Nat.pow_le_pow_left h2 a
    _ = (m + 2) ^ (a * (b + 1)) := by rw [← pow_mul, Nat.mul_comm]

/-- **The p-simulation preorder.**  `S ≤ T` means `T` p-simulates `S`: the sizes of `S` are
polynomially dominated by the sizes of `T` through a polynomially monotone overhead `φ`.
Reflexivity uses `φ = id`; transitivity composes the overheads. -/
instance (F : Type u) : Preorder (ProofSystem F) where
  le S T := ∃ φ, polyMono φ ∧ ∀ n, S.size n ≤ φ (T.size n)
  le_refl S := ⟨id, polyMono_id, fun n => le_rfl⟩
  le_trans := by
    rintro S T U ⟨φ, hφ, hST⟩ ⟨ψ, hψ, hTU⟩
    refine ⟨φ ∘ ψ, polyMono_comp hφ hψ, fun n => ?_⟩
    calc S.size n ≤ φ (T.size n) := hST n
      _ ≤ φ (ψ (U.size n)) := hφ.1 (hTU n)

/-- The size-based system with prescribed size function `f`. -/
def sysOfSize (f : ℕ → ℕ) : ProofSystem ℕ := ⟨f⟩

/-- **Domination characterisation.**  Simulation between two size-based systems is exactly
polynomial domination of their size functions. -/
theorem simulates_sysOfSize_iff (f g : ℕ → ℕ) :
    sysOfSize f ≤ sysOfSize g ↔ ∃ φ, polyMono φ ∧ ∀ n, f n ≤ φ (g n) :=
  Iff.rfl

/-- The height-`k` rung of the ladder: size `2 ^ (n ^ k)`. -/
def powSystem (k : ℕ) : ProofSystem ℕ := sysOfSize (fun n => 2 ^ (n ^ k))

/-! ## A uniform (all-large-`n`) super-polynomial gap -/

/-
!-- comment: For `k ≥ 1` the rungs `2^(n^k)` and `2^(n^(k+1))` are super-polynomially
apart for *every* `n ≥ c + 2`, not just one — so a witness of either parity
is available. -- !--

**Uniform ladder gap.**  For `k ≥ 1` and every exponent `c`, the inequality
`(2 ^ (n ^ k) + 2) ^ c < 2 ^ (n ^ (k + 1))` holds for *all* `n ≥ c + 2`.
-/
lemma pow_pow_succ_gap_strong (k : ℕ) (hk : 1 ≤ k) (c : ℕ) :
    ∀ n, c + 2 ≤ n → (2 ^ (n ^ k) + 2) ^ c < 2 ^ (n ^ (k + 1)) := by
  -- Apply the power inequality: $(2^{n^k} + 2)^c \leq 2^{c \cdot (n^k + 1)}$
  have h_pow : ∀ n, c + 2 ≤ n → (2 ^ (n ^ k) + 2) ^ c ≤ 2 ^ (c * (n ^ k + 1)) := by
    intros n hn; rw [ pow_mul' ] ; gcongr;
    rw [ pow_succ' ] ; linarith [ Nat.pow_le_pow_right ( by decide : 1 ≤ 2 ) ( show n ^ k ≥ 1 by exact Nat.one_le_pow _ _ ( by linarith ) ) ];
  refine fun n hn ↦ lt_of_le_of_lt ( h_pow n hn ) ?_;
  gcongr <;> norm_num;
  rw [ pow_succ' ] ; nlinarith [ Nat.pow_le_pow_right ( by linarith : 1 ≤ n ) hk ] ;

/-! ## The parity-glued intermediate system -/

-- !-- comment: Upper rate `2^(n^(k+1))` on even indices, lower rate `2^(n^k)` on odd
--             indices: a degree glued from the two rates on the two residue classes. -- !--
/-- The parity-glued intermediate system: size `2 ^ (n ^ (k+1))` on even `n`, size
`2 ^ (n ^ k)` on odd `n`. -/
def interPowSys (k : ℕ) : ProofSystem ℕ :=
  sysOfSize (fun n => if Even n then 2 ^ (n ^ (k + 1)) else 2 ^ (n ^ k))

/-! ## `powSystem k < interPowSys k` -/

/-
!-- comment: Lower rung simulates the glued system (its size is everywhere `≥ 2^(n^k)`),
but the glued system cannot be simulated by the lower rung because the even
indices keep the faster rate (uniform gap at an even witness). -- !--

The lower ladder rung is strictly below the glued system: `powSystem k < interPowSys k`
for `k ≥ 1`.
-/
theorem powSystem_lt_interPow (k : ℕ) (hk : 1 ≤ k) :
    powSystem k < interPowSys k := by
  constructor;
  -- `powSystem k ≤ interPowSys k`: identity overhead, since `2^(n^k) ≤ interPowSys.size n`.
  · convert simulates_sysOfSize_iff _ _ |>.2 ⟨ id, polyMono_id, ?_ ⟩;
    intro n; split_ifs <;> simp_all +decide [ Nat.pow_succ ] ;
    rcases n with ( _ | _ | n ) <;> simp_all +decide [ Nat.pow_succ', Nat.pow_mul ];
    · cases k <;> norm_num at *;
    · exact Nat.one_le_iff_ne_zero.mpr ( by positivity );
  -- `¬ interPowSys k ≤ powSystem k`: at an even witness the gap defeats any polynomial overhead.
  · intro h;
    obtain ⟨ f, hf_mono, hf_bound ⟩ := simulates_sysOfSize_iff _ _ |>.1 h;
    obtain ⟨ c, hc ⟩ := hf_mono.2;
    have := pow_pow_succ_gap_strong k hk c ( 2 * ( c + 2 ) ) ( by linarith );
    grind

/-! ## `interPowSys k < powSystem (k+1)` -/

/-
!-- comment: The glued system simulates the upper rung (its size is everywhere
`≤ 2^(n^(k+1))`), but the upper rung cannot be simulated by the glued system
because the odd indices fall back to the slower rate (uniform gap at an odd
witness). -- !--

The glued system is strictly below the upper ladder rung: `interPowSys k < powSystem
(k+1)` for `k ≥ 1`.
-/
theorem interPow_lt_powSystem_succ (k : ℕ) (hk : 1 ≤ k) :
    interPowSys k < powSystem (k + 1) := by
  refine' lt_of_le_not_ge _ _;
  -- `interPowSys k ≤ powSystem (k+1)`: identity overhead, since both branches `≤ 2^(n^(k+1))`.
  · refine' simulates_sysOfSize_iff _ _ |>.2 ⟨ _, polyMono_id, fun n => _ ⟩;
    split_ifs <;> [ exact le_rfl; exact pow_le_pow_right₀ ( by decide ) ( Nat.pow_le_pow_right ( Nat.pos_of_ne_zero ( by aesop ) ) ( by linarith ) ) ];
  · -- Suppose for contradiction that `powSystem (k+1) ≤ interPowSys k`.
    by_contra h_contra
    unfold powSystem interPowSys at h_contra;
    obtain ⟨ f, hf_mono, hf_bound ⟩ := simulates_sysOfSize_iff _ _ |>.1 h_contra;
    -- Choose an ODD witness `n := 2 * (c + 2) + 1`: `¬ Even n` (slower branch) and `c + 2 ≤ n`.
    obtain ⟨c, hc⟩ : ∃ c, ∀ m, f m + 1 ≤ (m + 2) ^ c := by
      exact hf_mono.2
    set n := 2 * (c + 2) + 1 with hn_def
    have hn_odd : ¬Even n := by
      grind
    have hn_ge : c + 2 ≤ n := by
      grind;
    have := pow_pow_succ_gap_strong k hk c n hn_ge;
    grind

/-! ## Density at every rung -/

-- !-- comment: Sandwiching the two strict steps: a strictly intermediate degree exists
--             between every pair of consecutive ladder rungs. -- !--
/-- **Density along the ladder.**  For every `k ≥ 1` there is a p-degree strictly between
the consecutive ladder rungs `powSystem k` and `powSystem (k+1)`. -/
theorem exists_strictly_between_powSystem (k : ℕ) (hk : 1 ≤ k) :
    ∃ S : ProofSystem ℕ, powSystem k < S ∧ S < powSystem (k + 1) :=
  ⟨interPowSys k, powSystem_lt_interPow k hk, interPow_lt_powSystem_succ k hk⟩

end ProofComplexity
