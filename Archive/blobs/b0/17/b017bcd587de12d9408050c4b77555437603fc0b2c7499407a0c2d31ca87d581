import Mathlib
import Algebra.Tropical_p_adic_Valuation_Bounds_and_Lifting_the_Exponent_for_Fibonacci_Primitive_Divisors
import Shared.CarmichaelTail

/-! # Carmichael tail: structural (valuation) half

Supporting the composite case of Carmichael's primitive-divisor theorem for the
infinite tail.  The size half is in `Shared.CarmichaelTail`; here we establish the
arithmetic structure of the cyclotomic value `Φ_n = ∏_{d ∣ n} F_d ^ μ(n/d)`:
it is a positive integer dividing `F n`, and its imprimitive part divides `n`.

Central tools:
* `moebius_padicVal_sum` : the integer Möbius/valuation identity
  `∑_{d ∣ m} μ(m/d) · v_p(d) = [m is a positive power of p]`.
* `fib_padicVal_mul_prime` / `fib_lte_full` : lifting the exponent for Fibonacci.

-- !-- Lab Notebook -- !--
-- Hypothesis : The primitive part of `F n` equals `Φ_n` divided by an "intrinsic" factor that
--   divides `n`; combined with `Φ_n > n` (size half) this forces a primitive prime divisor for
--   composite `n > 10000`, completing Carmichael's theorem.
-- Result    : Proved `sorry`-free `fib_tail_primitive` (the infinite composite tail), hence the
--   previously-open `Shared.CarmichaelProof.fib_carmichael_composite` is now complete.
-- Insight   : (1) LTE for Fibonacci needs no `ℤ[√5]`: the matrix-binomial identity
--   `F(p·N)=∑_k C(p,k)F_N^k F_{N-1}^{p-k}F_k` isolates `v_p(F(pN))=v_p(F N)+1` for odd `p`.
--   (2) The integer von Mangoldt identity `∑_{d∣m}μ(m/d)v_p(d)=[m=p^k]` makes the cyclotomic
--   valuation explicit: imprimitive primes contribute valuation ≤ `v_p(n)`, so the imprimitive
--   part divides `n`.  (3) `p=2` is genuinely special (entry point 3 but 2-adic "rank" 6); it is
--   handled separately through the exact 2-adic valuation `v_2(F d)`.
-- Failure analysis : `fib_two_adic_val` is false at `d=0` (`F 0=0`); it needs `0<d`.  The crude
--   bound `Φ_n ≤ n·∏_{d∣n,d<n}F_d` FAILS for abundant `n` (e.g. `n=24,30,…`): only the genuine
--   Mobius/inclusion-exclusion value `Φ_n` (size `φ^{φ(n)}`) is large enough — there is no
--   single-divisor shortcut.
-- !--
-/

open scoped BigOperators
open Nat ArithmeticFunction Real

set_option maxHeartbeats 2000000

/-
**Möbius/valuation identity** (the integer `p`-component of von Mangoldt):
`∑_{d ∣ m} μ(m/d) · v_p(d) = 1` if `m` is a positive power of `p`, else `0`.
-/
lemma moebius_padicVal_sum (p m : ℕ) (hp : p.Prime) (hm : 0 < m) :
    (∑ d ∈ m.divisors, moebius (m / d) * (padicValNat p d : ℤ))
      = if (p ^ (padicValNat p m) = m ∧ 1 ≤ padicValNat p m) then 1 else 0 := by
  -- Write `v_p(d) = ∑_{j=1}^{d} [p^j ∣ d]` (as a `ℤ`-valued sum of indicators over `j ∈ Finset.Icc 1 d`; for `j > v_p(d)` the indicator is 0).
  have h_vp_d : ∀ d ∈ m.divisors, (padicValNat p d : ℤ) = ∑ j ∈ Finset.Icc 1 m, (if p ^ j ∣ d then 1 else 0) := by
    intro d hd
    have h_vp_d : (padicValNat p d : ℤ) = ∑ j ∈ Finset.Icc 1 (Nat.factorization d p), 1 := by
      simp +decide [ Nat.factorization ];
      aesop;
    rw [ h_vp_d, ← Finset.sum_filter ];
    refine' Finset.sum_bij ( fun x hx => x ) _ _ _ _ <;> simp_all +decide [ Nat.factorization_eq_zero_iff ];
    · exact fun a ha₁ ha₂ => ⟨ le_trans ( Nat.le_of_lt_succ ( Nat.lt_succ_of_le ( Nat.le_trans ha₂ ( Nat.le_of_lt ( Nat.factorization_lt _ ( by aesop ) ) ) ) ) ) ( Nat.le_of_dvd hm hd.1 ), Nat.dvd_trans ( pow_dvd_pow _ ha₂ ) ( Nat.ordProj_dvd _ _ ) ⟩;
    · intro b hb₁ hb₂ hb₃; have := Nat.factorization_le_iff_dvd ( by aesop ) ( by aesop ) |>.2 hb₃; aesop;
  -- For each fixed `j ≥ 1`, evaluate the inner sum `S_j := ∑ d ∈ m.divisors, μ(m/d) * [p^j ∣ d]`.
  have h_inner_sum : ∀ j ∈ Finset.Icc 1 m, ∑ d ∈ m.divisors, (moebius (m / d) : ℤ) * (if p ^ j ∣ d then 1 else 0) = if p ^ j ∣ m then if m / p ^ j = 1 then 1 else 0 else 0 := by
    intro j hj;
    by_cases h : p ^ j ∣ m <;> simp_all +decide [ Nat.divisors_mul ];
    · -- Reindex the divisors `d ∣ m` with `p^j ∣ d` by `d = p^j * c` with `c ∣ (m / p^j)` (bijection `Nat.divisors`).
      have h_reindex : ∑ d ∈ m.divisors, (if p ^ j ∣ d then (moebius (m / d) : ℤ) else 0) = ∑ c ∈ (m / p ^ j).divisors, (moebius ((m / p ^ j) / c) : ℤ) := by
        have h_reindex : Finset.filter (fun d => p ^ j ∣ d) m.divisors = Finset.image (fun c => p ^ j * c) ((m / p ^ j).divisors) := by
          ext; simp [Finset.mem_image];
          constructor;
          · rintro ⟨ ⟨ hd₁, hd₂ ⟩, hd₃ ⟩;
            exact ⟨ _, ⟨ Nat.dvd_div_of_mul_dvd ( by exact Nat.dvd_trans ( by rw [ Nat.mul_div_cancel' hd₃ ] ) hd₁ ), by aesop, Nat.le_of_dvd hm h ⟩, Nat.mul_div_cancel' hd₃ ⟩;
          · rintro ⟨ a, ⟨ ha₁, ha₂, ha₃ ⟩, rfl ⟩ ; exact ⟨ ⟨ Nat.mul_dvd_of_dvd_div h ha₁, hm.ne' ⟩, dvd_mul_right _ _ ⟩;
        rw [ ← Finset.sum_filter, h_reindex, Finset.sum_image ];
        · exact Finset.sum_congr rfl fun x hx => by rw [ Nat.div_div_eq_div_mul ] ;
        · exact fun x hx y hy hxy => mul_left_cancel₀ ( pow_ne_zero j hp.ne_zero ) hxy;
      have h_moebius_sum : ∀ n : ℕ, n > 0 → ∑ d ∈ n.divisors, (moebius d : ℤ) = if n = 1 then 1 else 0 := by
        intro n hn_pos
        have h_moebius_sum : ∑ d ∈ n.divisors, (moebius d : ℤ) = (ArithmeticFunction.moebius * ArithmeticFunction.zeta) n := by
          simp +decide [ ArithmeticFunction.moebius, ArithmeticFunction.zeta ];
          rw [ Nat.sum_divisorsAntidiagonal fun x y => if y = 0 then 0 else if Squarefree x then ( -1 : ℤ ) ^ cardFactors x else 0 ];
          exact Finset.sum_congr rfl fun x hx => by rw [ if_neg ( Nat.ne_of_gt ( Nat.div_pos ( Nat.le_of_dvd hn_pos ( Nat.dvd_of_mem_divisors hx ) ) ( Nat.pos_of_mem_divisors hx ) ) ) ] ;
        aesop;
      rw [ h_reindex, ← h_moebius_sum _ ( Nat.div_pos ( Nat.le_of_dvd hm h ) ( pow_pos hp.pos _ ) ) ];
      conv_rhs => rw [ ← Nat.sum_div_divisors ] ;
    · exact Finset.sum_eq_zero fun x hx => if_neg fun hx' => h <| dvd_trans hx' <| Nat.dvd_of_mem_divisors hx;
  -- Therefore, the sum `∑ d ∈ m.divisors, μ(m/d) * v_p(d)` equals `∑_j S_j`.
  have h_sum_S_j : ∑ d ∈ m.divisors, (moebius (m / d) : ℤ) * (padicValNat p d : ℤ) = ∑ j ∈ Finset.Icc 1 m, (if p ^ j ∣ m then if m / p ^ j = 1 then 1 else 0 else 0) := by
    rw [ ← Finset.sum_congr rfl h_inner_sum, Finset.sum_comm ];
    exact Finset.sum_congr rfl fun x hx => by rw [ h_vp_d x hx, Finset.mul_sum _ _ _ ] ;
  split_ifs <;> simp_all +decide [ Nat.div_eq_of_lt ];
  · rw [ Finset.sum_eq_single ( padicValNat p m ) ] <;> simp_all +decide [ Nat.div_eq_of_lt ];
    · intro b hb₁ hb₂ hb₃ hb₄; intro hb₅; have := Nat.div_mul_cancel hb₄; simp_all +decide [ Nat.pow_succ' ] ;
      exact hb₃ ( Nat.pow_right_injective hp.one_lt <| by linarith );
    · exact Nat.le_of_lt ( Nat.lt_pow_self hp.one_lt |> LT.lt.trans_le <| by linarith );
  · simp_all +decide [ Finset.sum_ite ];
    intro x hx₁ hx₂ hx₃ hx₄; have := Nat.div_mul_cancel hx₃; simp_all +decide [ Nat.pow_succ', Nat.mul_assoc ] ;
    subst this; specialize h_inner_sum x hx₁ hx₂; simp_all +decide [ Nat.pow_succ', Nat.mul_assoc ] ;
    aesop

/-
**Matrix-binomial identity** for Fibonacci: expanding `Q^(M·N) = (Q^N)^M` with
`Q^N = F_N • Q + F_{N-1} • 1` and reading the `(0,1)` entry.
-/
lemma fib_mul_eq_sum (M N : ℕ) (hN : 0 < N) :
    Nat.fib (M * N) =
      ∑ k ∈ Finset.range (M + 1),
        M.choose k * Nat.fib N ^ k * Nat.fib (N - 1) ^ (M - k) * Nat.fib k := by
  -- Let's set up the problem using the provided matrix approach.
  set Q : Matrix (Fin 2) (Fin 2) ℤ := !![1, 1; 1, 0];
  -- By definition of $Q$, we know that $(Q^k)_{01} = F_k$ for all $k$.
  have hQk : ∀ k : ℕ, (Q ^ k) 0 1 = (Nat.fib k : ℤ) := by
    intro k; induction' k using Nat.strong_induction_on with k ih; rcases k with ( _ | _ | k ) <;> simp_all +decide [ pow_succ, Nat.fib_add_two ] ;
    · rfl;
    · simp_all +decide [ ← ih, Matrix.mul_apply, pow_succ ];
      ring!;
      norm_num;
  -- Using the decomposition $Q^N = F_N \cdot Q + F_{N-1} \cdot I$, we can expand $(Q^N)^M$.
  have hQNM : Q ^ (M * N) = ∑ k ∈ Finset.range (M + 1), Nat.choose M k • ((Nat.fib N : ℤ) • Q) ^ k * ((Nat.fib (N - 1) : ℤ) • 1) ^ (M - k) := by
    have hQNM : Q ^ (M * N) = ((Nat.fib N : ℤ) • Q + (Nat.fib (N - 1) : ℤ) • 1) ^ M := by
      have h_decomp : Q ^ N = (Nat.fib N : ℤ) • Q + (Nat.fib (N - 1) : ℤ) • 1 := by
        refine' Nat.le_induction _ _ N hN <;> intros <;> simp_all +decide [ pow_succ, Nat.fib_add_two ];
        ext i j ; fin_cases i <;> fin_cases j <;> norm_num [ Matrix.mul_apply, Nat.fib_add_two ] ; ring!;
        · rename_i k hk₁ hk₂; rcases k with ( _ | _ | k ) <;> simp_all +decide [ Nat.fib_add_two, add_comm 1 ] ; ring;
          exact?;
        · simp +zetaDelta at *;
          cases ‹1 ≤ _› <;> simp_all +decide [ Nat.fib_add_two ] ; ring;
        · cases ‹1 ≤ _› <;> simp_all +decide [ Nat.fib_add_two ] ; ring!;
          · decide +revert;
          · norm_num [ Q ] ; ring!;
        · cases ‹1 ≤ _› <;> simp_all +decide [ Nat.fib_add_two ] ; ring!;
          · rfl;
          · norm_num [ Q ] ; ring!;
      rw [ ← h_decomp, pow_mul' ];
    have h_comm : Commute ((Nat.fib N : ℤ) • Q) ((Nat.fib (N - 1) : ℤ) • 1) := by
      exact Commute.smul_left ( Commute.smul_right ( by aesop ) _ ) _;
    convert h_comm.add_pow M using 1;
    simp +decide [ mul_assoc, mul_comm, mul_left_comm, Nat.cast_comm ];
  -- Taking the $(0,1)$ entry of both sides of $Q^{M \cdot N}$, we get the desired result.
  have h_entry : (Q ^ (M * N)) 0 1 = ∑ k ∈ Finset.range (M + 1), Nat.choose M k * (Nat.fib N : ℤ) ^ k * (Nat.fib (N - 1) : ℤ) ^ (M - k) * (Q ^ k) 0 1 := by
    convert congr_arg ( fun m : Matrix ( Fin 2 ) ( Fin 2 ) ℤ => m 0 1 ) hQNM using 1;
    simp +decide [ Matrix.sum_apply, Matrix.mul_apply, smul_pow ];
    refine' Finset.sum_congr rfl fun x hx => _;
    erw [ show ( ( fib N : ℤ ) * Q ) ^ x = ( fib N : ℤ ) ^ x • Q ^ x from ?_ ];
    · erw [ show ( M.choose x : Matrix ( Fin 2 ) ( Fin 2 ) ℤ ) = Matrix.diagonal ( fun i => if i = 0 then ( M.choose x : ℤ ) else ( M.choose x : ℤ ) ) from ?_ ] ; simp +decide [ Matrix.smul_eq_diagonal_mul ] ; ring;
      · erw [ show ( fib ( N - 1 ) : Matrix ( Fin 2 ) ( Fin 2 ) ℤ ) = Matrix.diagonal ( fun i => if i = 0 then ( fib ( N - 1 ) : ℤ ) else ( fib ( N - 1 ) : ℤ ) ) from ?_ ] ; simp +decide [ Matrix.smul_eq_diagonal_mul ] ; ring;
        · simp +decide [ Matrix.diagonal_pow ] ; ring;
        · ext i j ; fin_cases i <;> fin_cases j <;> rfl;
      · ext i j ; fin_cases i <;> fin_cases j <;> rfl;
    · induction x <;> simp_all +decide [ pow_succ, mul_assoc, smul_smul ];
      rename_i k hk; rw [ hk ( Nat.le_of_lt hx ) ] ; simp +decide [ mul_assoc, mul_left_comm, pow_succ ] ;
      simp +decide [ ← mul_assoc, ← Nat.cast_comm ];
  rw [ ← @Nat.cast_inj ℤ ] ; aesop

/-
**Lifting the exponent for Fibonacci, prime step** (odd prime `p`).
If `p ∣ F N` then `v_p (F (p·N)) = v_p (F N) + 1`.
-/
lemma fib_padicVal_mul_prime (p N : ℕ) (hp : p.Prime) (hp2 : p ≠ 2)
    (hN : 0 < N) (hpN : p ∣ Nat.fib N) :
    padicValNat p (Nat.fib (p * N)) = padicValNat p (Nat.fib N) + 1 := by
  -- Let $v = \text{padicValNat } p (\text{fib } N)$; since $p \mid F N$ and $F N > 0$, $v \geq 1$.
  set v := padicValNat p (Nat.fib N)
  have hv_pos : 1 ≤ v := by
    contrapose! hpN; aesop;
  -- Show $p^{v+2} \mid R$: each term with $2 \leq k \leq p$ has $p^{v+2}$ dividing it:
  have hR_div : p ^ (v + 2) ∣ ∑ k ∈ Finset.Ico 2 (p + 1), p.choose k * Nat.fib N ^ k * Nat.fib (N - 1) ^ (p - k) * Nat.fib k := by
    refine' Finset.dvd_sum fun k hk => _;
    by_cases hk_lt_p : k < p;
    · -- For $2 \leq k \leq p-1$: $p \mid p.choose k$ and $p^{2v} \mid (F N)^k$ (since $p^v \mid F N$ and $k \geq 2$).
      have h_div : p ∣ p.choose k ∧ p ^ (2 * v) ∣ Nat.fib N ^ k := by
        refine' ⟨ hp.dvd_choose_self ( by linarith [ Finset.mem_Ico.mp hk ] ) ( by linarith [ Finset.mem_Ico.mp hk ] ), _ ⟩;
        have h_fib_pow : p ^ v ∣ Nat.fib N := by
          convert Nat.ordProj_dvd ( Nat.fib N ) p using 1;
          rw [ Nat.factorization_def ] ; aesop;
        exact dvd_trans ( by rw [ pow_mul' ] ; exact pow_dvd_pow_of_dvd h_fib_pow _ ) ( pow_dvd_pow _ ( show k ≥ 2 by linarith [ Finset.mem_Ico.mp hk ] ) );
      refine' dvd_mul_of_dvd_left _ _;
      exact dvd_mul_of_dvd_left ( dvd_trans ( by rw [ ← pow_succ' ] ; exact pow_dvd_pow _ ( by linarith ) ) ( mul_dvd_mul h_div.1 h_div.2 ) ) _;
    · have h_div_fib_k : p ^ (p * v) ∣ Nat.fib N ^ p := by
        convert pow_dvd_pow_of_dvd ( show p ^ v ∣ fib N from ?_ ) p using 1 ; ring;
        convert Nat.ordProj_dvd ( fib N ) p using 1;
        rw [ Nat.factorization_def ] ; aesop;
      simp_all +decide [ show k = p by linarith [ Finset.mem_Ico.mp hk ] ];
      exact dvd_mul_of_dvd_left ( dvd_trans ( pow_dvd_pow _ ( by nlinarith [ show p ≥ 3 by exact lt_of_le_of_ne hk ( Ne.symm hp2 ) ] ) ) h_div_fib_k ) _;
  -- Therefore, $p^{v+1} \mid F(pN)$ and $\neg p^{v+2} \mid F(pN)$.
  have h_div : p ^ (v + 1) ∣ Nat.fib (p * N) ∧ ¬p ^ (v + 2) ∣ Nat.fib (p * N) := by
    have h_div : p ^ (v + 1) ∣ p * Nat.fib N * Nat.fib (N - 1) ^ (p - 1) ∧ ¬p ^ (v + 2) ∣ p * Nat.fib N * Nat.fib (N - 1) ^ (p - 1) := by
      have h_term_div : p ^ (v + 1) ∣ p * Nat.fib N ∧ ¬p ^ (v + 2) ∣ p * Nat.fib N := by
        have h_term_div : p ^ v ∣ Nat.fib N ∧ ¬p ^ (v + 1) ∣ Nat.fib N := by
          haveI := Fact.mk hp; simp +decide [ padicValNat_dvd_iff ] ;
          aesop;
        simp_all +decide [ pow_succ', mul_dvd_mul_iff_left hp.ne_zero ];
      have h_coprime : Nat.gcd p (Nat.fib (N - 1)) = 1 := by
        refine' hp.coprime_iff_not_dvd.mpr _;
        intro h; have := Nat.dvd_gcd hpN h; rcases N with ( _ | _ | N ) <;> simp_all +decide [ Nat.fib_add_two, Nat.gcd_comm ] ;
        exact absurd this ( by rw [ show Nat.gcd ( fib N ) ( fib ( N + 1 ) ) = 1 from Nat.recOn N ( by norm_num ) fun n ih => by simp_all +decide [ Nat.fib_add_two, Nat.gcd_comm ] ] ; aesop );
      refine' ⟨ dvd_mul_of_dvd_left h_term_div.1 _, _ ⟩;
      exact fun h => h_term_div.2 <| Nat.Coprime.dvd_of_dvd_mul_right ( show Nat.Coprime ( p ^ ( v + 2 ) ) ( fib ( N - 1 ) ^ ( p - 1 ) ) from Nat.Coprime.pow _ _ <| by aesop ) h;
    have h_sum : Nat.fib (p * N) = p * Nat.fib N * Nat.fib (N - 1) ^ (p - 1) + ∑ k ∈ Finset.Ico 2 (p + 1), p.choose k * Nat.fib N ^ k * Nat.fib (N - 1) ^ (p - k) * Nat.fib k := by
      rw [ fib_mul_eq_sum p N hN ];
      rw [ Finset.sum_Ico_eq_sum_range ];
      rcases p with ( _ | _ | p ) <;> simp_all +decide [ Finset.sum_range_succ', add_comm, add_left_comm, add_assoc ];
    simp_all +decide [ Nat.dvd_add_left ];
    exact dvd_add h_div.1 ( dvd_trans ( pow_dvd_pow _ ( Nat.le_succ _ ) ) hR_div );
  obtain ⟨ k, hk ⟩ := h_div.1;
  haveI := Fact.mk hp; rw [ hk, padicValNat.mul ] <;> simp_all +decide [ Nat.Prime.ne_zero ] ;
  · exact Or.inr <| Or.inr <| fun h => h_div <| mul_dvd_mul_left _ h;
  · aesop_cat

/-
**Full Fibonacci LTE for odd primes**: if `p ∣ F e` (odd `p`), then for all `m ≥ 1`,
`v_p (F (e·m)) = v_p (F e) + v_p (m)`.
-/
lemma fib_lte_full (p e m : ℕ) (hp : p.Prime) (hp2 : p ≠ 2)
    (he : 0 < e) (hm : 0 < m) (hpe : p ∣ Nat.fib e) :
    padicValNat p (Nat.fib (e * m)) = padicValNat p (Nat.fib e) + padicValNat p m := by
  -- Write $m = p^a \cdot m'$ with $a = v_p(m)$ and $m'$ coprime to $p$.
  obtain ⟨a, m', hm_eq, hm'_coprime⟩ : ∃ a m', m = p^a * m' ∧ ¬p ∣ m' := by
    exact ⟨ Nat.factorization m p, m / p ^ Nat.factorization m p, by rw [ Nat.mul_div_cancel' ( Nat.ordProj_dvd _ _ ) ], Nat.not_dvd_ordCompl ( by aesop ) ( by aesop ) ⟩;
  -- By induction on $j$, we show that $v_p(F_{p^j \cdot K}) = v_p(F_K) + j$.
  have h_ind : ∀ j : ℕ, padicValNat p (Nat.fib (p^j * (e * m'))) = padicValNat p (Nat.fib (e * m')) + j := by
    intro j;
    induction j <;> simp_all +decide [ pow_succ', mul_assoc ];
    rw [ fib_padicVal_mul_prime ];
    · exact?;
    · assumption;
    · assumption;
    · exact mul_pos ( pow_pos hp.pos _ ) ( mul_pos he hm.2 );
    · refine' dvd_trans hpe _;
      convert fib_dvd_of_dvd _ _ _ using 1;
      exact dvd_mul_of_dvd_right ( dvd_mul_right _ _ ) _;
  -- By the properties of the Fibonacci sequence and the induction hypothesis, we have:
  have h_fib : padicValNat p (Nat.fib (e * m')) = padicValNat p (Nat.fib e) := by
    convert fib_lte p e m' hp hp2 he ( Nat.pos_of_ne_zero ( by aesop_cat ) ) hpe hm'_coprime using 1;
    · rw [ Nat.mul_comm ];
    · simp_all +decide [ padicValNat.eq_zero_of_not_dvd ];
  simp_all +decide [ mul_assoc, mul_comm, mul_left_comm ];
  haveI := Fact.mk hp; rw [ padicValNat.mul ] <;> aesop;

/-
**2-adic valuation of Fibonacci numbers**:
`v_2 (F d) = 0` if `3 ∤ d`; `= 1` if `3 ∣ d` and `d` is odd; `= v_2 d + 2` if `6 ∣ d`.
-/
lemma fib_two_adic_val (d : ℕ) (hd : 0 < d) :
    padicValNat 2 (Nat.fib d)
      = if 3 ∣ d then (if 2 ∣ d then padicValNat 2 d + 2 else 1) else 0 := by
  induction' d using Nat.strongRecOn with d ih;
  by_cases h3 : 3 ∣ d;
  · by_cases h2 : 2 ∣ d <;> simp_all +decide [ Nat.dvd_iff_mod_eq_zero ];
    · -- Let $d = 2e$ with $3 \mid e$.
      obtain ⟨e, rfl⟩ : ∃ e, d = 2 * e := by
        exact Nat.dvd_of_mod_eq_zero h2
      have he3 : 3 ∣ e := by
        omega
      have he_pos : 0 < e := by
        linarith;
      -- By the properties of the Fibonacci sequence, we have $F_{2e} = F_e \cdot L_e$, where $L_e = 2F_{e+1} - F_e$.
      have h_fib_2e : Nat.fib (2 * e) = Nat.fib e * (2 * Nat.fib (e + 1) - Nat.fib e) := by
        rw [ Nat.fib_two_mul ];
      -- We need to show that $v_2(L_e) = 2$ if $e$ is odd and $v_2(L_e) = 1$ if $e$ is even.
      have h_lucas_val : padicValNat 2 (2 * Nat.fib (e + 1) - Nat.fib e) = if e % 2 = 1 then 2 else 1 := by
        have h_lucas_val : 2 * Nat.fib (e + 1) - Nat.fib e ≡ if e % 2 = 1 then 4 else 2 [MOD 8] := by
          rw [ ← Nat.mod_add_div e 6 ] at *; have := Nat.mod_lt e ( by decide : 6 > 0 ) ; interval_cases e % 6 <;> norm_num [ Nat.ModEq, Nat.add_mod, Nat.mul_mod ] at *;
          · induction e / 6 <;> norm_num [ Nat.mul_succ, Nat.fib_add_two ] at *;
            omega;
          · induction e / 6 <;> simp_all +arith +decide [ Nat.fib_add_two, Nat.mul_succ ];
            omega;
        split_ifs at * <;> simp_all +decide [ Nat.ModEq ];
        · rw [ ← Nat.mod_add_div ( 2 * fib ( e + 1 ) - fib e ) 8, h_lucas_val ];
          rw [ show 4 + 8 * ( ( 2 * fib ( e + 1 ) - fib e ) / 8 ) = 2 ^ 2 * ( 1 + 2 * ( ( 2 * fib ( e + 1 ) - fib e ) / 8 ) ) by ring, padicValNat.mul, padicValNat.pow ] <;> norm_num;
        · rw [ ← Nat.mod_add_div ( 2 * fib ( e + 1 ) - fib e ) 8, h_lucas_val ];
          rw [ show 2 + 8 * ( ( 2 * fib ( e + 1 ) - fib e ) / 8 ) = 2 * ( 1 + 4 * ( ( 2 * fib ( e + 1 ) - fib e ) / 8 ) ) by ring, padicValNat.mul ] <;> norm_num;
          norm_num [ Nat.add_mod, Nat.mul_mod ];
      rw [ h_fib_2e, padicValNat.mul ] <;> simp_all +decide [ Nat.fib_pos ];
      · rw [ padicValNat.mul ] <;> norm_num;
        · cases Nat.mod_two_eq_zero_or_one e <;> simp_all +decide [ Nat.dvd_iff_mod_eq_zero ] ; ring;
        · grind;
      · grind;
      · exact Nat.sub_ne_zero_of_lt ( by linarith [ Nat.fib_pos.2 ( Nat.succ_pos e ), Nat.fib_mono ( Nat.le_succ e ) ] );
    · -- Since $d$ is odd and divisible by 3, we can write $d = 2k + 1$ for some $k$.
      obtain ⟨k, rfl⟩ : ∃ k, d = 2 * k + 1 := by
        exact Nat.odd_iff.2 h2;
      -- Since $k$ is not divisible by 3, we have $fib(k)$ and $fib(k+1)$ are both odd.
      have h_odd : ¬(2 ∣ Nat.fib k) ∧ ¬(2 ∣ Nat.fib (k + 1)) := by
        have h_odd : ∀ n, 2 ∣ Nat.fib n ↔ 3 ∣ n := by
          intro n; induction' n using Nat.strong_induction_on with n ih; rcases n with ( _ | _ | _ | n ) <;> simp_all +arith +decide [ Nat.fib_add_two, Nat.dvd_iff_mod_eq_zero, Nat.add_mod, Nat.mul_mod ] ;
        grind;
      -- Since $fib(k)$ and $fib(k+1)$ are both odd, we have $fib(2k+1) = fib(k+1)^2 + fib(k)^2 \equiv 2 \pmod{4}$.
      have h_mod4 : Nat.fib (2 * k + 1) % 4 = 2 := by
        have h_mod4 : Nat.fib (2 * k + 1) = Nat.fib (k + 1) ^ 2 + Nat.fib k ^ 2 := by
          rw [ Nat.fib_two_mul_add_one ];
        rcases Nat.even_or_odd' ( Nat.fib k ) with ⟨ c, d | d ⟩ <;> rcases Nat.even_or_odd' ( Nat.fib ( k + 1 ) ) with ⟨ e, f | f ⟩ <;> push_cast [ * ] at * <;> ring_nf at * <;> norm_num at *;
      rw [ ← Nat.mod_add_div ( fib ( 2 * k + 1 ) ) 4, h_mod4 ];
      rw [ show 2 + 4 * ( fib ( 2 * k + 1 ) / 4 ) = 2 * ( 1 + 2 * ( fib ( 2 * k + 1 ) / 4 ) ) by ring, padicValNat.mul ] <;> norm_num;
  · -- Since $3 \nmid d$, we have $fib d$ is odd.
    have h_odd : Odd (fib d) := by
      -- By definition of Fibonacci sequence, we know that $F_d$ is odd if and only if $d$ is not divisible by 3.
      have h_fib_odd : ∀ d, ¬(3 ∣ d) → Odd (Nat.fib d) := by
        intro d hd; induction' d using Nat.strong_induction_on with d ih; rcases d with ( _ | _ | _ | d ) <;> simp_all +arith +decide [ Nat.fib_add_two, parity_simps ] ;
      exact h_fib_odd d h3;
    simp_all +decide [ padicValNat.eq_zero_of_not_dvd, ← even_iff_two_dvd, parity_simps ]
/-! ## Cyclotomic value as a ratio of two naturals, and its prime structure -/

/-- Numerator of the cyclotomic value: product of `F_d` over divisors with `μ(n/d) = 1`. -/
def cycloA (n : ℕ) : ℕ := ∏ d ∈ n.divisors.filter (fun d => moebius (n / d) = 1), Nat.fib d

/-- Denominator of the cyclotomic value: product of `F_d` over divisors with `μ(n/d) = -1`. -/
def cycloB (n : ℕ) : ℕ := ∏ d ∈ n.divisors.filter (fun d => moebius (n / d) = -1), Nat.fib d

lemma cycloA_pos (n : ℕ) : 0 < cycloA n := by
  exact Finset.prod_pos fun x hx => Nat.fib_pos.mpr <| Nat.pos_of_mem_divisors <| Finset.mem_filter.mp hx |>.1

lemma cycloB_pos (n : ℕ) : 0 < cycloB n := by
  refine' Finset.prod_pos fun x hx => _;
  exact Nat.fib_pos.mpr ( Nat.pos_of_mem_divisors ( Finset.mem_filter.mp hx |>.1 ) )

/-
The signed `p`-valuation of the cyclotomic value:
`v_p(A) - v_p(B) = ∑_{d ∣ n} μ(n/d) · v_p(F_d)`.
-/
lemma cyclo_signed_sum (n p : ℕ) (hn : 0 < n) :
    ((cycloA n).factorization p : ℤ) - ((cycloB n).factorization p : ℤ)
      = ∑ d ∈ n.divisors, (moebius (n / d)) * ((Nat.fib d).factorization p : ℤ) := by
  rw [ show cycloA n = ∏ d ∈ n.divisors.filter ( fun d => moebius ( n / d ) = 1 ), Nat.fib d from rfl, show cycloB n = ∏ d ∈ n.divisors.filter ( fun d => moebius ( n / d ) = -1 ), Nat.fib d from rfl ];
  rw [ Nat.factorization_prod, Nat.factorization_prod ] <;> norm_cast <;> norm_num;
  · rw [ Int.subNatNat_eq_coe ];
    push_cast [ Finset.sum_filter ];
    rw [ ← Finset.sum_sub_distrib ] ; congr ; ext x ; rcases eq_or_ne ( moebius ( n / x ) ) 1 with h | h <;> rcases eq_or_ne ( moebius ( n / x ) ) ( -1 ) with j | j <;> simp_all +decide ;
    grind +suggestions;
  · aesop;
  · aesop

/-
Central valuation bound, odd prime case.
-/
lemma cyclo_signed_sum_bound_odd (n : ℕ) (hn : 13 ≤ n)
    (hno : ∀ q, q.Prime → q ∣ Nat.fib n → fibEntryPoint q ≠ n) (p : ℕ) (hp : p.Prime)
    (hp2 : p ≠ 2) :
    0 ≤ (∑ d ∈ n.divisors, (moebius (n / d)) * ((Nat.fib d).factorization p : ℤ))
      ∧ (∑ d ∈ n.divisors, (moebius (n / d)) * ((Nat.fib d).factorization p : ℤ))
          ≤ (n.factorization p : ℤ) := by
  by_cases hpn : p ∣ Nat.fib n;
  · -- Let `e = fibEntryPoint p`. With witness `⟨n, _, hpn⟩`, `fib_dvd_iff_entry_dvd` gives `e ∣ n`; `e > 0` (`fib_entry_point_pos`) and `p ∣ Nat.fib e` (`fib_entry_point_dvd`).
    set e := fibEntryPoint p with he
    have he_pos : 0 < e := by
      apply fib_entry_point_pos;
      grind +qlia
    have he_div_n : e ∣ n := by
      apply fib_dvd_iff_entry_dvd p n hp (by linarith) ⟨n, by linarith, hpn⟩ |>.1 hpn
    have he_div_fib : p ∣ Nat.fib e := by
      apply fib_entry_point_dvd;
      grind +splitImp;
    -- Reindex `d = e * c` with `c ∣ (n/e)` (bijection `c ↦ e*c`); then `n/d = (n/e)/c` and `d/e = c`.
    have h_reindex : ∑ d ∈ n.divisors, (moebius (n / d)) * ((Nat.fib d).factorization p : ℤ) = ∑ c ∈ (n / e).divisors, (moebius ((n / e) / c)) * ((Nat.fib e).factorization p + (c.factorization p : ℤ)) := by
      have h_reindex : ∑ d ∈ n.divisors, (moebius (n / d)) * ((Nat.fib d).factorization p : ℤ) = ∑ d ∈ (n.divisors.filter (fun d => e ∣ d)), (moebius (n / d)) * ((Nat.fib e).factorization p + (d / e).factorization p : ℤ) := by
        rw [ ← Finset.sum_subset ( show n.divisors.filter ( fun d => e ∣ d ) ⊆ n.divisors from Finset.filter_subset _ _ ) ];
        · refine' Finset.sum_congr rfl fun x hx => _;
          have := fib_lte_full p e ( x / e ) hp hp2 he_pos ( Nat.div_pos ( Nat.le_of_dvd ( Nat.pos_of_mem_divisors ( Finset.filter_subset _ _ hx ) ) ( Finset.mem_filter.mp hx |>.2 ) ) he_pos ) he_div_fib; simp_all +decide [ Nat.mul_div_cancel' ( Finset.mem_filter.mp hx |>.2 ) ] ;
          rw [ Nat.mul_div_cancel' hx.2 ] at this; simp_all +decide [ Nat.factorization ] ;
          haveI := Fact.mk hp; rw [ padicValNat.div_of_dvd hx.2 ] ; aesop;
        · intro x hx hx'; simp_all +decide [ Nat.factorization_eq_zero_of_not_dvd, Nat.dvd_prime ] ;
          exact Or.inr ( Nat.factorization_eq_zero_of_not_dvd fun h => hx' <| by have := fib_dvd_iff_entry_dvd p x hp ( Nat.pos_of_dvd_of_pos hx.1 ( by linarith ) ) ⟨ n, by linarith, hpn ⟩ ; aesop );
      rw [ h_reindex ];
      refine' Finset.sum_bij ( fun x hx => x / e ) _ _ _ _ <;> simp_all +decide [ Nat.div_div_eq_div_mul ];
      · exact fun a ha₁ ha₂ ha₃ => ⟨ by rwa [ Nat.mul_div_cancel' ha₃ ], he_pos.ne', Nat.le_of_dvd ( by positivity ) he_div_n ⟩;
      · exact fun b hb _ _ => ⟨ fibEntryPoint p * b, ⟨ ⟨ hb, by linarith ⟩, dvd_mul_right _ _ ⟩, Nat.mul_div_cancel_left _ he_pos ⟩;
      · exact fun a ha₁ ha₂ ha₃ => Or.inl ( by rw [ Nat.mul_div_cancel' ha₃ ] );
    -- The first sum `= if (n/e) = 1 then 1 else 0 = 0` (since `n/e > 1`).
    have h_first_sum : ∑ c ∈ (n / e).divisors, (moebius ((n / e) / c)) * ((Nat.fib e).factorization p : ℤ) = 0 := by
      have h_first_sum : ∑ c ∈ (n / e).divisors, (moebius ((n / e) / c)) = if (n / e) = 1 then 1 else 0 := by
        have h_first_sum : ∀ m : ℕ, 0 < m → ∑ c ∈ m.divisors, (moebius (m / c)) = if m = 1 then 1 else 0 := by
          intro m hm_pos
          have h_sum : ∑ c ∈ m.divisors, (moebius (m / c)) = ∑ c ∈ m.divisors, (moebius c) := by
            conv_rhs => rw [ ← Nat.sum_div_divisors ] ;
          have h_sum : ∑ c ∈ m.divisors, (moebius c) = (ArithmeticFunction.moebius * ArithmeticFunction.zeta) m := by
            exact?;
          aesop;
        exact h_first_sum _ ( Nat.div_pos ( Nat.le_of_dvd ( by linarith ) he_div_n ) he_pos );
      rw [ ← Finset.sum_mul _ _ _, h_first_sum ] ; split_ifs <;> simp_all +decide [ Nat.div_eq_iff_eq_mul_left he_pos ];
      have := Nat.div_mul_cancel he_div_n; aesop;
    -- The second sum, by `moebius_padicVal_sum p (n/e)`, equals `if (p^(padicValNat p (n/e)) = n/e ∧ 1 ≤ padicValNat p (n/e)) then 1 else 0 ∈ {0,1}`.
    have h_second_sum : ∑ c ∈ (n / e).divisors, (moebius ((n / e) / c)) * ((c.factorization p : ℤ)) = if (p ^ (padicValNat p (n / e)) = n / e ∧ 1 ≤ padicValNat p (n / e)) then 1 else 0 := by
      convert moebius_padicVal_sum p ( n / e ) hp ( Nat.div_pos ( Nat.le_of_dvd ( by linarith ) he_div_n ) he_pos ) using 1;
      simp +decide [ Nat.factorization_def, hp ];
    split_ifs at * <;> simp_all +decide [ Finset.sum_add_distrib, mul_add ];
    refine' Nat.pos_of_ne_zero _;
    simp_all +decide [ Nat.factorization_eq_zero_iff ];
    exact ⟨ dvd_trans ( dvd_pow_self _ ( by linarith ) ) ( ‹p ^ padicValNat p ( n / fibEntryPoint p ) = n / fibEntryPoint p ∧ 1 ≤ padicValNat p ( n / fibEntryPoint p ) ›.1.symm ▸ Nat.div_dvd_of_dvd he_div_n ), by linarith ⟩;
  · have h_zero : ∀ d ∈ n.divisors, ¬p ∣ Nat.fib d := by
      exact fun d hd => fun h => hpn <| dvd_trans h <| fib_dvd_of_dvd _ _ <| Nat.dvd_of_mem_divisors hd;
    rw [ Finset.sum_eq_zero ] <;> simp_all +decide [ Nat.factorization_eq_zero_of_not_dvd ]

/-
Central valuation bound, prime `2` case.
-/
lemma cyclo_signed_sum_bound_two (n : ℕ) (hn : 13 ≤ n)
    (hno : ∀ q, q.Prime → q ∣ Nat.fib n → fibEntryPoint q ≠ n) :
    0 ≤ (∑ d ∈ n.divisors, (moebius (n / d)) * ((Nat.fib d).factorization 2 : ℤ))
      ∧ (∑ d ∈ n.divisors, (moebius (n / d)) * ((Nat.fib d).factorization 2 : ℤ))
          ≤ (n.factorization 2 : ℤ) := by
  -- Split the sum into parts where the contribution is 1 or 0.
  have h_split_sum : ∑ d ∈ Nat.divisors n, (moebius (n / d)) * ((Nat.fib d).factorization 2 : ℤ) = ∑ d ∈ Nat.divisors n, (moebius (n / d)) * (if 3 ∣ d then 1 else 0) + ∑ d ∈ Nat.divisors n, (moebius (n / d)) * (if 6 ∣ d then (d.factorization 2 : ℤ) + 1 else 0) := by
    rw [ ← Finset.sum_add_distrib, Finset.sum_congr rfl ];
    intro d hd; split_ifs <;> simp_all +decide [ Nat.factorization_eq_zero_of_not_dvd ] ;
    · have h_fib_two_adic_val : padicValNat 2 (Nat.fib d) = padicValNat 2 d + 2 := by
        convert fib_two_adic_val d ( Nat.pos_of_dvd_of_pos hd.1 ( pos_of_gt hn ) ) using 1;
        grind;
      simp_all +decide [ Nat.factorization ];
      ring;
    · have h_fib_2_adic : padicValNat 2 (Nat.fib d) = 1 := by
        rw [ fib_two_adic_val ] <;> norm_num [ ‹3 ∣ d›, ‹¬6 ∣ d› ];
        · exact fun h => False.elim <| ‹¬6 ∣ d› <| dvd_trans ( by decide ) ( Nat.lcm_dvd ‹3 ∣ d› h );
        · exact Nat.pos_of_dvd_of_pos hd.1 ( pos_of_gt hn );
      simp_all +decide [ Nat.factorization ];
    · exact False.elim <| ‹¬3∣d› <| dvd_trans ( by decide ) ‹6∣d›;
    · rw [ Nat.factorization_eq_zero_of_not_dvd ] <;> norm_num [ *, Nat.Prime.dvd_iff_not_coprime ];
      -- By definition of Fibonacci sequence, we know that $F_d$ is odd if and only if $d$ is not divisible by 3.
      have h_fib_odd : ∀ d, ¬(3 ∣ d) → Odd (Nat.fib d) := by
        intro d hd; induction' d using Nat.strong_induction_on with d ih; rcases d with ( _ | _ | _ | d ) <;> simp_all +arith +decide [ Nat.fib_add_two, parity_simps ] ;
      exact h_fib_odd d ‹_›;
  by_cases h3 : 3 ∣ n <;> by_cases h6 : 6 ∣ n <;> simp_all +decide [ Finset.sum_ite ];
  · -- Reindex the sums over the divisors of $n$ that are divisible by $3$ and $6$.
    have h_reindex : ∑ d ∈ n.divisors.filter (fun d => 3 ∣ d), (moebius (n / d)) = ∑ c ∈ (n / 3).divisors, (moebius ((n / 3) / c)) ∧ ∑ d ∈ n.divisors.filter (fun d => 6 ∣ d), (moebius (n / d)) * ((d.factorization 2 : ℤ) + 1) = ∑ c ∈ (n / 6).divisors, (moebius ((n / 6) / c)) * ((c.factorization 2 : ℤ) + 2) := by
      constructor;
      · refine' Finset.sum_bij ( fun x hx => x / 3 ) _ _ _ _ <;> simp_all +decide [ Nat.div_div_eq_div_mul ];
        · exact fun a ha _ ha3 => ⟨ by rwa [ Nat.mul_div_cancel' ha3 ], by linarith ⟩;
        · exact fun b hb _ => ⟨ 3 * b, ⟨ ⟨ hb, by linarith ⟩, dvd_mul_right _ _ ⟩, by rw [ Nat.mul_div_cancel_left _ ( by decide ) ] ⟩;
        · exact fun a ha _ ha3 => by rw [ Nat.mul_div_cancel' ha3 ] ;
      · refine' Finset.sum_bij ( fun x hx => x / 6 ) _ _ _ _ <;> norm_num;
        · exact fun a ha₁ ha₂ ha₃ => ⟨ Nat.dvd_div_of_mul_dvd <| by simpa only [ Nat.mul_div_cancel' ha₃ ] using ha₁, by linarith ⟩;
        · intros; omega;
        · exact fun b hb _ => ⟨ 6 * b, ⟨ ⟨ by exact Nat.mul_dvd_of_dvd_div h6 hb, by linarith ⟩, by norm_num ⟩, by rw [ Nat.mul_div_cancel_left _ ( by decide ) ] ⟩;
        · intro a ha hn h6a; rw [ Nat.div_div_eq_div_mul ] ;
          rw [ show a = 6 * ( a / 6 ) by rw [ Nat.mul_div_cancel' h6a ] ] ; norm_num [ Nat.factorization_mul, Nat.factorization_pow ] ; ring;
          rw [ Nat.factorization_mul ] <;> norm_num ; ring;
          · exact Or.inl ( by rw [ show ( 6 : ℕ ) = 2 * 3 by norm_num, Nat.factorization_mul ] <;> norm_num ; ring );
          · exact Nat.le_of_dvd ( Nat.pos_of_dvd_of_pos ha ( pos_of_gt ‹_› ) ) h6a;
    -- Apply the Möbius cancellation lemma to the sums.
    have h_mobi_cancel : ∀ m : ℕ, 0 < m → ∑ c ∈ m.divisors, (moebius (m / c)) = if m = 1 then 1 else 0 := by
      intros m hm_pos
      have h_mobi_cancel : ∑ c ∈ m.divisors, (moebius (m / c)) = ∑ c ∈ m.divisors, (moebius c) := by
        conv_rhs => rw [ ← Nat.sum_div_divisors ] ;
      have h_mobi_cancel : ∑ c ∈ m.divisors, (moebius c) = (ArithmeticFunction.moebius * ArithmeticFunction.zeta) m := by
        exact?;
      aesop;
    have h_mobi_cancel_sum : ∑ c ∈ (n / 6).divisors, (moebius ((n / 6) / c)) * ((c.factorization 2 : ℤ) + 2) = (if (n / 6) = 1 then 2 else 0) + (if (Nat.factorization (n / 6) 2) ≥ 1 ∧ 2 ^ (Nat.factorization (n / 6) 2) = n / 6 then 1 else 0) := by
      have h_mobi_cancel_sum : ∑ c ∈ (n / 6).divisors, (moebius ((n / 6) / c)) * ((c.factorization 2 : ℤ)) = if (Nat.factorization (n / 6) 2) ≥ 1 ∧ 2 ^ (Nat.factorization (n / 6) 2) = n / 6 then 1 else 0 := by
        convert moebius_padicVal_sum 2 ( n / 6 ) ( by norm_num ) ( Nat.div_pos ( by linarith ) ( by norm_num ) ) using 1;
        simp +decide [ Nat.factorization, and_comm ];
      simp_all +decide [ mul_add, Finset.sum_add_distrib ];
      rw [ ← Finset.sum_mul _ _ _ ] ; specialize h_mobi_cancel ( n / 6 ) ( Nat.div_pos ( by linarith ) ( by decide ) ) ; aesop;
    split_ifs at * <;> simp_all +decide [ Nat.factorization_eq_zero_of_not_dvd, Nat.dvd_div_iff_mul_dvd ];
    · omega;
    · grind +qlia;
    · grind;
  · -- Since $3 \mid n$ and $6 \nmid n$, we have $\sum_{d \mid n, 3 \mid d} \mu(n/d) = 0$.
    have h_sum3 : ∑ x ∈ n.divisors with 3 ∣ x, moebius (n / x) = 0 := by
      -- Since $3 \mid n$, we can reindex the sum by letting $x = 3y$.
      have h_reindex : ∑ x ∈ n.divisors with 3 ∣ x, moebius (n / x) = ∑ y ∈ (n / 3).divisors, moebius ((n / 3) / y) := by
        refine' Finset.sum_bij ( fun x hx => x / 3 ) _ _ _ _ <;> simp_all +decide [ Nat.dvd_div_iff_mul_dvd ];
        · exact fun a ha _ ha3 => ⟨ by rwa [ Nat.mul_div_cancel' ha3 ], by linarith ⟩;
        · exact fun b hb _ => ⟨ 3 * b, ⟨ ⟨ hb, by linarith ⟩, dvd_mul_right _ _ ⟩, by rw [ Nat.mul_div_cancel_left _ ( by decide ) ] ⟩;
        · intro a ha hn ha3; rw [ Nat.div_div_eq_div_mul ] ;
          rw [ Nat.mul_div_cancel' ha3 ];
      have h_sum_zero : ∀ m : ℕ, 1 < m → ∑ x ∈ m.divisors, moebius x = 0 := by
        intros m hm
        have h_sum_zero : ∑ x ∈ m.divisors, moebius x = (ArithmeticFunction.moebius * ArithmeticFunction.zeta) m := by
          simp +decide [ ArithmeticFunction.moebius, ArithmeticFunction.zeta ];
          rw [ Nat.sum_divisorsAntidiagonal fun x y => if y = 0 then 0 else if Squarefree x then ( -1 : ℤ ) ^ cardFactors x else 0 ];
          exact Finset.sum_congr rfl fun x hx => by rw [ if_neg ( Nat.ne_of_gt ( Nat.div_pos ( Nat.le_of_dvd hm.le ( Nat.dvd_of_mem_divisors hx ) ) ( Nat.pos_of_mem_divisors hx ) ) ) ] ;
        simp_all +decide [ ArithmeticFunction.moebius_mul_coe_zeta ];
        exact if_neg hm.ne';
      rw [ h_reindex, ← h_sum_zero ( n / 3 ) ( by omega ) ];
      conv_rhs => rw [ ← Nat.sum_div_divisors ] ;
    simp_all +decide [ Finset.sum_add_distrib, mul_add ];
    rw [ show ( n.divisors.filter fun x => 6 ∣ x ) = ∅ from Finset.eq_empty_of_forall_notMem fun x hx => h6 <| dvd_trans ( Finset.mem_filter.mp hx |>.2 ) <| Nat.dvd_of_mem_divisors <| Finset.mem_filter.mp hx |>.1 ] ; norm_num;
  · exact False.elim <| h3 <| dvd_trans ( by decide ) h6;
  · rw [ Finset.sum_eq_zero, Finset.sum_eq_zero ] <;> simp_all +decide [ Nat.factorization_eq_zero_of_not_dvd ];
    · exact fun x hx₁ hx₂ hx₃ => False.elim <| h6 <| dvd_trans hx₃ hx₁;
    · exact fun x hx₁ hx₂ hx₃ => False.elim <| h3 <| dvd_trans hx₃ hx₁

/-- **Central valuation bound.** For composite `n ≥ 13` with no primitive prime divisor of `F n`,
the signed `p`-valuation of the cyclotomic value lies in `[0, v_p n]` for every prime `p`. -/
lemma cyclo_signed_sum_bound (n : ℕ) (hn : 13 ≤ n)
    (hno : ∀ q, q.Prime → q ∣ Nat.fib n → fibEntryPoint q ≠ n) (p : ℕ) (hp : p.Prime) :
    0 ≤ (∑ d ∈ n.divisors, (moebius (n / d)) * ((Nat.fib d).factorization p : ℤ))
      ∧ (∑ d ∈ n.divisors, (moebius (n / d)) * ((Nat.fib d).factorization p : ℤ))
          ≤ (n.factorization p : ℤ) := by
  by_cases hp2 : p = 2
  · subst hp2; exact cyclo_signed_sum_bound_two n hn hno
  · exact cyclo_signed_sum_bound_odd n hn hno p hp hp2
/-! ## Connecting to the real cyclotomic value and the size dichotomy -/

/-
The real cyclotomic value is the ratio `cycloA n / cycloB n`.
-/
lemma cycloFibR_eq_div (n : ℕ) :
    cycloFibR n = (cycloA n : ℝ) / (cycloB n : ℝ) := by
  unfold cycloFibR cycloA cycloB;
  rw [ Finset.prod_filter, Finset.prod_filter ];
  push_cast [ ← Finset.prod_div_distrib ];
  refine' Finset.prod_congr rfl fun x hx => _;
  rcases moebius_eq_or ( n / x ) with h | h | h <;> simp +decide [ h ]

/-
**Structural half of Carmichael's theorem.** If `F n` (composite `n ≥ 13`) has no
primitive prime divisor, then the cyclotomic value is at most `n`.
-/
lemma cycloFibR_le_of_no_primitive (n : ℕ) (hn : 13 ≤ n)
    (hno : ∀ q, q.Prime → q ∣ Nat.fib n → fibEntryPoint q ≠ n) :
    cycloFibR n ≤ (n : ℝ) := by
  -- Let `A = cycloA n`, `B = cycloB n` (both `> 0`), `0 < n` (from `13 ≤ n`).
  set A := cycloA n
  set B := cycloB n
  have hn_pos : 0 < n := by linarith
  have hA_pos : 0 < A := cycloA_pos n
  have hB_pos : 0 < B := cycloB_pos n;
  -- By `cyclo_signed_sum_bound`, for every prime `p`, `0 ≤ (A.factorization p : ℤ) - (B.factorization p : ℤ) ≤ (n.factorization p : ℤ)`.
  have h_factorization_bounds : ∀ p : ℕ, Nat.Prime p → 0 ≤ (A.factorization p : ℤ) - (B.factorization p : ℤ) ∧ (A.factorization p : ℤ) - (B.factorization p : ℤ) ≤ (n.factorization p : ℤ) := by
    intro p hp; have := cyclo_signed_sum_bound n hn hno p hp; simp_all +decide [ sub_eq_iff_eq_add ] ;
    have := cyclo_signed_sum n p hn_pos; norm_num at *; constructor <;> linarith;
  -- By `Nat.factorization_le_iff_dvd`, `B ∣ A` and `A / B ∣ n`.
  have hB_div_A : B ∣ A := by
    rw [ ← Nat.factorization_le_iff_dvd ];
    · exact fun p => if hp : Nat.Prime p then by linarith [ h_factorization_bounds p hp ] else by aesop;
    · positivity;
    · positivity
  have hA_div_n : A / B ∣ n := by
    rw [ ← Nat.factorization_le_iff_dvd ];
    · intro p; by_cases hp : Nat.Prime p <;> simp_all +decide [ Nat.factorization_div ( show B ∣ A from hB_div_A ) ] ;
      exact_mod_cast h_factorization_bounds p hp |>.2;
    · exact Nat.ne_of_gt ( Nat.div_pos ( Nat.le_of_dvd hA_pos hB_div_A ) hB_pos );
    · grind +splitImp;
  rw [ cycloFibR_eq_div ];
  rw [ div_le_iff₀ ] <;> norm_cast ; nlinarith [ Nat.div_mul_cancel hB_div_A, Nat.le_of_dvd hn_pos hA_div_n ]
/-! ## Size lower bound and the composite tail -/

/-
For odd `m`, `m ≤ φ(m)²`.
-/
lemma odd_le_totient_sq (m : ℕ) (hm : Odd m) : m ≤ (Nat.totient m) ^ 2 := by
  -- By induction on $m$, we can show that for any odd $m$, $m \leq \phi(m)^2$.
  induction' m using Nat.strong_induction_on with m ih;
  by_cases hm1 : m = 1;
  · aesop;
  · obtain ⟨p, hp, hp3, j, hj, m', hm'⟩ : ∃ p, Nat.Prime p ∧ p ≥ 3 ∧ ∃ j, 1 ≤ j ∧ ∃ m', m = p^j * m' ∧ ¬p ∣ m' ∧ Odd m' ∧ m' < m := by
      obtain ⟨p, hp_prime, hp_odd, hp_div⟩ : ∃ p, Nat.Prime p ∧ p ∣ m ∧ Odd p := by
        exact ⟨ Nat.minFac m, Nat.minFac_prime hm1, Nat.minFac_dvd m, hm.of_dvd_nat ( Nat.minFac_dvd m ) ⟩;
      refine' ⟨ p, hp_prime, _, Nat.factorization m p, Nat.pos_of_ne_zero ( Finsupp.mem_support_iff.mp <| by aesop ), m / p ^ Nat.factorization m p, _, _, _, _ ⟩;
      · exact lt_of_le_of_ne hp_prime.two_le ( Ne.symm <| by rintro rfl; contradiction );
      · rw [ Nat.mul_div_cancel' ( Nat.ordProj_dvd _ _ ) ];
      · rw [ Nat.dvd_div_iff_mul_dvd ( Nat.ordProj_dvd _ _ ) ];
        exact Nat.pow_succ_factorization_not_dvd ( by aesop ) ( by aesop );
      · exact hm.of_dvd_nat ( Nat.div_dvd_of_dvd ( Nat.ordProj_dvd _ _ ) );
      · exact Nat.div_lt_self hm.pos ( one_lt_pow₀ hp_prime.one_lt ( Nat.ne_of_gt ( Nat.pos_of_ne_zero ( Finsupp.mem_support_iff.mp ( by aesop ) ) ) ) );
    -- By the properties of the totient function, we have $\phi(m) = \phi(p^j) \cdot \phi(m')$.
    have h_phi : Nat.totient m = Nat.totient (p^j) * Nat.totient m' := by
      rw [ hm'.1, Nat.totient_mul ];
      exact Nat.Coprime.pow_left _ ( hp.coprime_iff_not_dvd.mpr hm'.2.1 );
    -- By the properties of the totient function, we have $\phi(p^j) = p^{j-1}(p-1)$.
    have h_phi_pj : Nat.totient (p^j) = p^(j-1) * (p-1) := by
      exact Nat.totient_prime_pow hp hj;
    -- By the properties of the totient function, we have $\phi(p^j)^2 \geq p^j$.
    have h_phi_pj_sq : Nat.totient (p^j)^2 ≥ p^j := by
      rcases j with ( _ | j ) <;> simp_all +decide [ pow_succ' ];
      nlinarith [ Nat.mul_le_mul_left ( p ^ j ) ( show p - 1 ≥ 2 by exact Nat.le_sub_one_of_lt hp3 ), Nat.mul_le_mul_left ( p ^ j ) ( show p ^ j ≥ 1 by exact Nat.one_le_pow _ _ hp.pos ), Nat.sub_add_cancel hp.pos ];
    nlinarith [ ih m' hm'.2.2.2 hm'.2.2.1 ]

/-
For odd `m ≥ 5`, `2m ≤ φ(m)²`.
-/
lemma two_mul_odd_le_totient_sq (m : ℕ) (hm : Odd m) (hm5 : 5 ≤ m) :
    2 * m ≤ (Nat.totient m) ^ 2 := by
  by_cases h_pow : ∃ k, m = 3^k ∧ k ≥ 2;
  · obtain ⟨ k, rfl, hk ⟩ := h_pow; rw [ Nat.totient_prime_pow ] <;> norm_num ; ring_nf ;
    · rcases k with ( _ | _ | k ) <;> simp_all +decide [ Nat.pow_succ', Nat.pow_mul ] ; nlinarith [ pow_pos ( show 0 < 3 by decide ) k ] ;
    · linarith;
  · -- Since $m$ is not a power of 3, it must have a prime factor $p \geq 5$.
    obtain ⟨p, hp_prime, hp_ge_5, hp_div⟩ : ∃ p, Nat.Prime p ∧ 5 ≤ p ∧ p ∣ m := by
      by_cases h_pow : ∀ p, Nat.Prime p → p ∣ m → p = 3;
      · -- If $m$ has no prime factors other than 3, then $m$ must be a power of 3.
        obtain ⟨k, hk⟩ : ∃ k, m = 3^k := by
          rw [ ← Nat.prod_primeFactorsList hm.pos.ne' ] ; rw [ List.prod_eq_pow_single 3 ] ; aesop;
          exact fun p hp₁ hp₂ => False.elim <| hp₁ <| h_pow p ( Nat.prime_of_mem_primeFactorsList hp₂ ) <| Nat.dvd_of_mem_primeFactorsList hp₂;
        exact False.elim <| ‹¬∃ k, m = 3 ^ k ∧ k ≥ 2› ⟨ k, hk, le_of_not_gt fun h => by interval_cases k <;> subst hk <;> contradiction ⟩;
      · simp_all +decide [ Nat.Prime.dvd_iff_not_coprime ];
        obtain ⟨ p, hp₁, hp₂, hp₃ ⟩ := h_pow; exact ⟨ p, hp₁, le_of_not_gt fun hp₄ => by interval_cases p <;> simp_all +decide [ Nat.coprime_primes ], hp₁.dvd_iff_not_coprime.mpr hp₂ ⟩ ;
    -- Write $m$ as $p^k \cdot m'$ where $m'$ is coprime to $p$.
    obtain ⟨k, m', hm', hm'_coprime⟩ : ∃ k m', m = p^k * m' ∧ Nat.gcd p m' = 1 := by
      exact ⟨ Nat.factorization m p, m / p ^ Nat.factorization m p, by rw [ Nat.mul_div_cancel' ( Nat.ordProj_dvd _ _ ) ], by exact hp_prime.coprime_iff_not_dvd.mpr ( Nat.not_dvd_ordCompl ( by aesop ) ( by aesop ) ) ⟩;
    -- By the properties of the totient function, we have $\phi(m) = \phi(p^k) \cdot \phi(m')$.
    have h_phi : Nat.totient m = Nat.totient (p^k) * Nat.totient m' := by
      rw [ hm', Nat.totient_mul ];
      exact Nat.Coprime.pow_left _ hm'_coprime;
    -- By the properties of the totient function, we have $\phi(p^k) \geq 2p^{k/2}$.
    have h_phi_pk : Nat.totient (p^k) ^ 2 ≥ 2 * p^k := by
      rcases k with ( _ | k ) <;> simp_all +decide [ Nat.totient_prime_pow ];
      · exact absurd ( Nat.dvd_gcd ( dvd_refl p ) hp_div ) ( by aesop );
      · rcases p with ( _ | _ | p ) <;> simp_all +decide [ pow_succ' ];
        nlinarith [ Nat.mul_le_mul_left ( ( p + 1 + 1 ) ^ k ) hp_ge_5, Nat.mul_le_mul_left ( ( p + 1 + 1 ) ^ k ) ( Nat.one_le_pow k ( p + 1 + 1 ) ( Nat.succ_pos _ ) ) ];
    -- By the properties of the totient function, we have $\phi(m')^2 \geq m'$.
    have h_phi_m' : Nat.totient m' ^ 2 ≥ m' := by
      apply odd_le_totient_sq;
      exact hm.of_dvd_nat ( hm'.symm ▸ dvd_mul_left _ _ );
    rw [ h_phi, mul_pow ] ; nlinarith [ pow_pos hp_prime.pos k ] ;

/-
Euler's totient dominates the integer square root.
-/
lemma sqrt_le_totient (n : ℕ) (hn : 1 ≤ n) : Nat.sqrt n ≤ Nat.totient n := by
  by_cases ha : n.factorization 2 = 0 ∨ n.factorization 2 ≥ 2;
  · -- If $a = 0$ or $a \geq 2$, then $n \leq \phi(n)^2$.
    have h_case1 : n ≤ (Nat.totient n) ^ 2 := by
      -- If $a = 0$ or $a \geq 2$, then $n = 2^a * m$ where $m$ is odd.
      obtain ⟨a, m, hm_odd, hm_eq⟩ : ∃ a m, n = 2^a * m ∧ Odd m ∧ (a = 0 ∨ a ≥ 2) := by
        use n.factorization 2, n / 2^ n.factorization 2;
        exact ⟨ Eq.symm ( Nat.mul_div_cancel' ( Nat.ordProj_dvd _ _ ) ), by rw [ Nat.odd_iff ] ; exact Nat.mod_two_ne_zero.mp fun h => absurd ( Nat.dvd_of_mod_eq_zero h ) ( Nat.not_dvd_ordCompl ( by norm_num ) <| by linarith ), ha ⟩;
      rcases hm_eq with ⟨ hm_odd, rfl | ha ⟩ <;> simp_all +decide [ Nat.totient_mul, Nat.totient_prime_pow ];
      · convert odd_le_totient_sq m ‹_› using 1;
      · rw [ Nat.totient_mul, Nat.totient_prime_pow ] <;> norm_num;
        · rcases a with ( _ | _ | a ) <;> simp_all +decide [ pow_succ', mul_assoc ];
          have := odd_le_totient_sq m ‹_›;
          nlinarith [ Nat.pow_le_pow_right ( show 1 ≤ 2 by decide ) ( show a ≥ 0 by positivity ), Nat.mul_le_mul_left ( 2 ^ a ) this ];
        · linarith;
        · exact Nat.Coprime.pow_left _ ( by obtain ⟨ k, rfl ⟩ := hm_odd; norm_num );
    exact Nat.le_of_lt_succ <| Nat.sqrt_lt.2 <| by nlinarith;
  · -- Since $n.factorization 2 = 1$, we have $n = 2 * m$ for some odd $m$.
    obtain ⟨m, hm⟩ : ∃ m, n = 2 * m ∧ Odd m := by
      have h_factor : 2 ∣ n ∧ ¬4 ∣ n := by
        simp_all +decide [ Nat.factorization_eq_zero_iff, Nat.dvd_iff_mod_eq_zero ];
        contrapose! ha;
        exact fun h => Nat.le_trans ( by native_decide ) ( Nat.factorization_le_iff_dvd ( by aesop ) ( by aesop ) |>.2 ( Nat.dvd_of_mod_eq_zero ha ) 2 );
      exact Exists.elim h_factor.1 fun m hm => ⟨ m, hm, Nat.odd_iff.mpr ( Nat.mod_two_ne_zero.mp fun contra => h_factor.2 <| hm.symm ▸ Nat.mul_dvd_mul_left 2 ( Nat.dvd_of_mod_eq_zero contra ) ) ⟩;
    by_cases hm5 : 5 ≤ m;
    · have := two_mul_odd_le_totient_sq m hm.2 hm5; simp_all +decide [ Nat.totient_mul ] ;
      exact Nat.le_of_lt_succ <| Nat.sqrt_lt.2 <| by linarith;
    · interval_cases m <;> simp_all +decide;
      native_decide

/-
Golden-ratio growth dominates the quadratic `5(m+1)²` for `m ≥ 100`.
-/
lemma five_mul_sq_lt_goldenRatio_pow (m : ℕ) (hm : 100 ≤ m) :
    (5 * (m + 1) ^ 2 : ℝ) < goldenRatio ^ m := by
  induction' hm with m hm ih <;> norm_num [ pow_succ' ] at *;
  · field_simp;
    exact lt_of_lt_of_le ( by norm_num ) ( pow_le_pow_left₀ ( by positivity ) ( show 1 + Real.sqrt 5 ≥ 3 by nlinarith only [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ] ) _ );
  · ring_nf at *;
    nlinarith [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ), ( by norm_cast : ( 100 : ℝ ) ≤ m ) ]

/-
For `n > 10000`, the cyclotomic value strictly exceeds `n`.
-/
lemma n_lt_cycloFibR (n : ℕ) (hn : 10000 < n) : (n : ℝ) < cycloFibR n := by
  -- By `goldenRatio_totient_le_cycloFibR`, `goldenRatio ^ (Nat.totient n) ≤ 5 * cycloFibR n`.
  have h1 : (goldenRatio ^ (Nat.totient n) : ℝ) ≤ 5 * cycloFibR n := by
    exact goldenRatio_totient_le_cycloFibR n ( by linarith );
  -- By `sqrt_le_totient`, `s = Nat.sqrt n ≤ Nat.totient n`.
  have h2 : (Nat.sqrt n : ℝ) ≤ Nat.totient n := by
    exact_mod_cast sqrt_le_totient n ( by linarith );
  -- By `five_mul_sq_lt_goldenRatio_pow`, `5 * (s+1)^2 < goldenRatio ^ s`.
  have h3 : (5 * (Nat.sqrt n + 1) ^ 2 : ℝ) < goldenRatio ^ (Nat.sqrt n) := by
    exact five_mul_sq_lt_goldenRatio_pow _ ( by nlinarith only [ hn, Nat.lt_succ_sqrt n ] );
  -- By `pow_le_pow_right₀`, `goldenRatio ^ (Nat.sqrt n) ≤ goldenRatio ^ (Nat.totient n)`.
  have h4 : (goldenRatio ^ (Nat.sqrt n) : ℝ) ≤ (goldenRatio ^ (Nat.totient n) : ℝ) := by
    exact pow_le_pow_right₀ ( by ring_nf; nlinarith [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ] ) ( mod_cast h2 );
  nlinarith [ show ( n : ℝ ) < ( Nat.sqrt n + 1 ) ^ 2 by exact_mod_cast Nat.lt_succ_sqrt' n ]

/-
**Composite tail of Carmichael's theorem.** For `n > 10000`, `F n` has a primitive
prime divisor.
-/
theorem fib_tail_primitive (n : ℕ) (hn : 10000 < n) :
    ∃ p, Nat.Prime p ∧ p ∣ Nat.fib n ∧ ∀ k, 0 < k → k < n → ¬(p ∣ Nat.fib k) := by
  by_contra! h_contra;
  -- By assumption, $F_n$ has no primitive prime divisor.
  have h_no_primitive : ∀ q, q.Prime → q ∣ Nat.fib n → fibEntryPoint q ≠ n := by
    intros q hq hq_div
    obtain ⟨k, hk_pos, hk_lt_n, hk_div⟩ := h_contra q hq hq_div
    have h_fib_entry_point_le : fibEntryPoint q ≤ k := by
      apply fib_entry_point_le q k hk_pos hk_div;
      use k;
    linarith;
  exact not_lt_of_ge ( cycloFibR_le_of_no_primitive n ( by linarith ) h_no_primitive ) ( n_lt_cycloFibR n hn )