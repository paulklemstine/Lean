# The Boltzmann Bridge for Combinatorial Species

This file connects the combinatorial-species / exponential-generating-function (EGF)
dictionary developed in `Catalog/Applications/CombinatorialSpecies.lean` with the
**Boltzmann probability model** used in analytic combinatorics (Duchon–Flajolet–Louchard–
Schaeffer).  For a species `F` with counting sequence `aₙ = |F[n]|` and a real parameter
`x`, the *Boltzmann weight* of size `n` is

  `w_F(x, n) = (aₙ / n!) · xⁿ`,

the partition function is `Z_F(x) = ∑ₙ w_F(x, n)` (the real EGF evaluated at `x`), and the
Boltzmann distribution on sizes is the normalized law `P(N = n) = w_F(x, n) / Z_F(x)`.

We establish:

* the **general mean identity** `boltzmannMean_eq`, expressing the expected size as
  `(∑ₙ n · w_F(x, n)) / Z_F(x)`;
* the **set species ↔ Poisson** specialization: `Z_E(x) = exp x`, the law is the Poisson
  law `e^{-x} xⁿ/n!`, and the mean is `x` (`setSpecies_boltzmann_mean`);
* the **linear-order species ↔ geometric** specialization: weights collapse to `xⁿ`, the
  law is the geometric-type law `(1 - x) xⁿ` for `0 ≤ x < 1`, and the mean is
  `x / (1 - x)` (`linOrderSpecies_boltzmann_mean`).

## Main results
* `boltzmannMean_eq`              — expected size `= (∑ n · weight) / partition`.
* `setSpecies_boltzmann_mean`     — the set-species Boltzmann law is Poisson with mean `x`.
* `linOrderSpecies_boltzmann_mean` — the linear-order law is geometric with mean `x/(1-x)`.
-/
import Mathlib
import Catalog.Applications.CombinatorialSpecies

open scoped BigOperators

namespace CombinatorialSpecies

noncomputable section

/-! ### The Boltzmann model of a species -/

/-- The **Boltzmann weight** of size `n` at parameter `x`: `(aₙ / n!) · xⁿ`, where
`aₙ = |F[n]|` is the counting sequence.  Summed over `n`, this is the real EGF of `F`
evaluated at `x`. -/
def boltzmannWeight (F : Species) (x : ℝ) (n : ℕ) : ℝ :=
  (F.coeffSeq n / n.factorial) * x ^ n

/-- The **partition function** `Z_F(x) = ∑ₙ w_F(x, n)`, i.e. the real EGF of `F` at `x`. -/
def boltzmannPartition (F : Species) (x : ℝ) : ℝ := ∑' n : ℕ, boltzmannWeight F x n

/-- The **Boltzmann probability** of size `n`: the normalized weight
`w_F(x, n) / Z_F(x)`. -/
def boltzmannPMF (F : Species) (x : ℝ) (n : ℕ) : ℝ :=
  boltzmannWeight F x n / boltzmannPartition F x

/-- The **mean (expected size)** of the Boltzmann law: `∑ₙ n · P(N = n)`. -/
def boltzmannMean (F : Species) (x : ℝ) : ℝ := ∑' n : ℕ, (n : ℝ) * boltzmannPMF F x n

/-- **General mean identity.** The expected size of the Boltzmann distribution is the
weighted first moment of the weights divided by the partition function. -/
theorem boltzmannMean_eq (F : Species) (x : ℝ) :
    boltzmannMean F x
      = (∑' n : ℕ, (n : ℝ) * boltzmannWeight F x n) / boltzmannPartition F x := by
  unfold boltzmannMean boltzmannPMF
  rw [← tsum_div_const]
  congr 1
  funext n
  rw [mul_div_assoc]

/-! ### Set species ↔ Poisson law -/

/-- The Boltzmann weight of the set species is `xⁿ / n!`. -/
@[simp] lemma boltzmannWeight_setSpecies (x : ℝ) (n : ℕ) :
    boltzmannWeight setSpecies x n = x ^ n / n.factorial := by
  rw [boltzmannWeight, coeffSeq_setSpecies]
  push_cast
  ring

/-- The partition function of the set species is `exp x` (Poisson normalization). -/
lemma boltzmannPartition_setSpecies (x : ℝ) :
    boltzmannPartition setSpecies x = Real.exp x := by
  rw [boltzmannPartition, Real.exp_eq_exp_ℝ, NormedSpace.exp_eq_tsum_div]
  refine tsum_congr fun n => ?_
  rw [boltzmannWeight_setSpecies]

/-- The first moment of the set-species weights is `x · exp x`. -/
lemma setSpecies_first_moment (x : ℝ) :
    (∑' n : ℕ, (n : ℝ) * boltzmannWeight setSpecies x n) = x * Real.exp x := by
  rw [Real.exp_eq_exp_ℝ]
  rw [NormedSpace.exp_eq_tsum_div, ← tsum_mul_left]
  rw [Summable.tsum_eq_zero_add]
  · simp +decide [boltzmannWeight_setSpecies, Nat.factorial_succ]
    exact tsum_congr fun n => by rw [mul_div, mul_div_mul_left _ _ (by positivity)]; ring
  · refine summable_nat_add_iff 1 |>.1 ?_
    convert Real.summable_pow_div_factorial x |> Summable.mul_left x using 2
    push_cast [boltzmannWeight_setSpecies]; ring
    field_simp
    simpa [add_comm, Nat.factorial_succ] using by ring

/-- **Set species ↔ Poisson.** The Boltzmann law of the species of sets is the Poisson law
`P(N = n) = e^{-x} · xⁿ / n!`, whose mean is `x`. -/
theorem setSpecies_boltzmann_mean (x : ℝ) :
    boltzmannMean setSpecies x = x := by
  rw [boltzmannMean_eq, boltzmannPartition_setSpecies, setSpecies_first_moment,
    mul_div_assoc, div_self (Real.exp_pos x).ne', mul_one]

/-! ### Linear-order species ↔ geometric law -/

/-- The Boltzmann weight of the linear-order species collapses to `xⁿ` (since `aₙ = n!`). -/
@[simp] lemma boltzmannWeight_linearOrderSpecies (x : ℝ) (n : ℕ) :
    boltzmannWeight linearOrderSpecies x n = x ^ n := by
  rw [boltzmannWeight, coeffSeq_linearOrderSpecies,
    div_self (by exact_mod_cast Nat.factorial_ne_zero n), one_mul]

/-- The partition function of the linear-order species is `(1 - x)⁻¹` for `0 ≤ x < 1`
(the geometric series). -/
lemma boltzmannPartition_linearOrderSpecies {x : ℝ} (hx0 : 0 ≤ x) (hx1 : x < 1) :
    boltzmannPartition linearOrderSpecies x = (1 - x)⁻¹ := by
  rw [boltzmannPartition, tsum_congr (fun n => boltzmannWeight_linearOrderSpecies x n)]
  exact tsum_geometric_of_lt_one hx0 hx1

/-- The Boltzmann probability of size `n` for linear orders is the geometric-type law
`(1 - x) · xⁿ` for `0 ≤ x < 1`. -/
lemma boltzmannPMF_linearOrderSpecies {x : ℝ} (hx0 : 0 ≤ x) (hx1 : x < 1) (n : ℕ) :
    boltzmannPMF linearOrderSpecies x n = (1 - x) * x ^ n := by
  have hx1' : (1 : ℝ) - x ≠ 0 := by linarith
  rw [boltzmannPMF, boltzmannWeight_linearOrderSpecies,
    boltzmannPartition_linearOrderSpecies hx0 hx1]
  field_simp

/-- **Linear-order species ↔ geometric.** For `0 ≤ x < 1`, the Boltzmann law of the species
of linear orders is the geometric-type law `P(N = n) = (1 - x) xⁿ`, whose mean is
`x / (1 - x)`. -/
theorem linOrderSpecies_boltzmann_mean {x : ℝ} (hx0 : 0 ≤ x) (hx1 : x < 1) :
    boltzmannMean linearOrderSpecies x = x / (1 - x) := by
  rw [boltzmannMean_eq, boltzmannPartition_linearOrderSpecies hx0 hx1,
    tsum_congr (fun n => by rw [boltzmannWeight_linearOrderSpecies])]
  have hnorm : ‖x‖ < 1 := by rw [Real.norm_eq_abs, abs_of_nonneg hx0]; exact hx1
  have hx1' : (1 : ℝ) - x ≠ 0 := by linarith
  rw [tsum_coe_mul_geometric_of_norm_lt_one hnorm]
  field_simp