  "interactive_demos": [
    {
      "title": "Interactive Geodesic & Busemann-Convexity Explorer",
      "description": "A live, self-contained widget over two filtrations on the vertex set {0,1,2}. A slider for the interpolation parameter t morphs F into G via lerp F G t while a table shows every subset weight updating in real time. The plot overlays the constant-speed geodesic distance t*d(F,G), the Busemann convexity upper bound for a movable observer H, and the actual distance d(H, lerp t), with a live readout of the convexity defect that demonstrates the space is flat (l-infinity) rather than CAT(0), and collapses to zero on the sharp diagonal.",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\"/>\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/>\n<title>The Path Space of Filtrations — Interactive Geodesic Explorer</title>\n<style>\n  body{font-family:-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;margin:0;\n       background:#0f1226;color:#e8ecff}\n  header{padding:22px 28px;background:linear-gradient(120deg,#1a1f44,#2a1d54)}\n  h1{margin:0;font-size:22px} p.sub{margin:6px 0 0;color:#aab4e8;font-size:14px}\n  .wrap{display:flex;flex-wrap:wrap;gap:20px;padding:22px}\n  .card{background:#171b38;border:1px solid #2a3163;border-radius:12px;padding:18px;flex:1;min-width:320px}\n  canvas{background:#0c0f24;border-radius:8px;width:100%}\n  label{display:block;margin:12px 0 4px;font-size:13px;color:#aab4e8}\n  input[type=range]{width:100%}\n  .val{color:#7fe7c4;font-weight:600}\n  table{width:100%;border-collapse:collapse;font-size:13px;margin-top:8px}\n  td,th{border-bottom:1px solid #2a3163;padding:4px 6px;text-align:right}\n  th:first-child,td:first-child{text-align:left}\n  code{color:#ffd479}\n</style>\n</head>\n<body>\n<header>\n  <h1>The Path Space of Filtrations — Interactive Geodesic Explorer</h1>\n  <p class=\"sub\">Drag the interpolation parameter t and watch the straight-line morph\n  <code>lerp F G t</code>, the constant-speed distance, and the Busemann convexity defect update live.</p>\n</header>\n<div class=\"wrap\">\n  <div class=\"card\">\n    <h3>Two filtrations on vertices {0,1,2}</h3>\n    <p style=\"font-size:13px;color:#aab4e8\">Weights live on the 8 subsets. The interleaving distance is\n    <code>d(F,G)=max&#8347; |F(&#963;)-G(&#963;)|</code>.</p>\n    <label>Interpolation t = <span class=\"val\" id=\"tval\">0.50</span></label>\n    <input type=\"range\" id=\"t\" min=\"0\" max=\"1\" step=\"0.01\" value=\"0.5\"/>\n    <label>Observer H weight scale = <span class=\"val\" id=\"hval\">1.00</span></label>\n    <input type=\"range\" id=\"h\" min=\"0\" max=\"2\" step=\"0.05\" value=\"1.0\"/>\n    <table id=\"tbl\"><thead><tr><th>subset &#963;</th><th>F</th><th>G</th><th>lerp t</th></tr></thead><tbody></tbody></table>\n  </div>\n  <div class=\"card\">\n    <h3>Distance along the geodesic</h3>\n    <canvas id=\"cv\" width=\"520\" height=\"320\"></canvas>\n    <p style=\"font-size:13px\" id=\"readout\"></p>\n  </div>\n</div>\n<script>\nconst subsets=[[],[0],[1],[2],[0,1],[0,2],[1,2],[0,1,2]];\nfunction key(s){return s.join(\",\");}\n// grounded, monotone weights\nconst F={\"\":0,\"0\":1.2,\"1\":1.5,\"2\":1.8,\"0,1\":2.4,\"0,2\":2.7,\"1,2\":3.1,\"0,1,2\":3.9};\nconst G={\"\":0,\"0\":1.9,\"1\":1.1,\"2\":2.5,\"0,1\":2.9,\"0,2\":3.4,\"1,2\":3.0,\"0,1,2\":4.2};\nfunction lerp(t){const o={};for(const s of subsets){const k=key(s);o[k]=(1-t)*F[k]+t*G[k];}return o;}\nfunction dist(A,B){let m=0;for(const s of subsets){m=Math.max(m,Math.abs(A[key(s)]-B[key(s)]));}return m;}\nfunction Hfilt(scale){const o={};for(const s of subsets){const k=key(s);o[k]=scale*0.5*(F[k]+G[k]);}return o;}\nconst dFG=dist(F,G);\nconst tEl=document.getElementById('t'),hEl=document.getElementById('h');\nconst tval=document.getElementById('tval'),hval=document.getElementById('hval');\nconst tbody=document.querySelector('#tbl tbody'),cv=document.getElementById('cv'),ctx=cv.getContext('2d');\nconst readout=document.getElementById('readout');\nfunction draw(){\n  const t=parseFloat(tEl.value),hs=parseFloat(hEl.value);\n  tval.textContent=t.toFixed(2);hval.textContent=hs.toFixed(2);\n  const L=lerp(t),H=Hfilt(hs);\n  tbody.innerHTML='';\n  for(const s of subsets){const k=key(s);const tr=document.createElement('tr');\n    tr.innerHTML=`<td>{${k||'&#8709;'}}</td><td>${F[k].toFixed(2)}</td><td>${G[k].toFixed(2)}</td><td>${L[k].toFixed(2)}</td>`;\n    tbody.appendChild(tr);}\n  ctx.clearRect(0,0,cv.width,cv.height);\n  const W=cv.width,Hh=cv.height,pad=40;\n  const xs=u=>pad+u*(W-2*pad), ys=v=>Hh-pad-(v/(dFG*1.05))*(Hh-2*pad);\n  // axes\n  ctx.strokeStyle='#33407a';ctx.beginPath();ctx.moveTo(pad,Hh-pad);ctx.lineTo(W-pad,Hh-pad);ctx.moveTo(pad,pad);ctx.lineTo(pad,Hh-pad);ctx.stroke();\n  // constant-speed line d(F,lerp u)=u*dFG\n  ctx.strokeStyle='#ff6b6b';ctx.lineWidth=2;ctx.beginPath();\n  for(let i=0;i<=100;i++){const u=i/100;const x=xs(u),y=ys(u*dFG);i?ctx.lineTo(x,y):ctx.moveTo(x,y);}ctx.stroke();\n  // convex bound and actual to H\n  const dHF=dist(H,F),dHG=dist(H,G);\n  ctx.strokeStyle='#7fe7c4';ctx.lineWidth=1.6;ctx.beginPath();\n  for(let i=0;i<=100;i++){const u=i/100;const x=xs(u),y=ys((1-u)*dHF+u*dHG);i?ctx.lineTo(x,y):ctx.moveTo(x,y);}ctx.stroke();\n  ctx.strokeStyle='#ffd479';ctx.lineWidth=1.6;ctx.beginPath();\n  for(let i=0;i<=100;i++){const u=i/100;const x=xs(u),y=ys(dist(H,lerp(u)));i?ctx.lineTo(x,y):ctx.moveTo(x,y);}ctx.stroke();\n  // marker at t\n  ctx.fillStyle='#ffffff';ctx.beginPath();ctx.arc(xs(t),ys(t*dFG),5,0,7);ctx.fill();\n  const defect=((1-t)*dHF+t*dHG)-dist(H,lerp(t));\n  readout.innerHTML=`<span style=\"color:#ff6b6b\">red</span>: d(F,lerp t)=t&#183;d(F,G) (constant speed) &nbsp;|&nbsp;`+\n    `<span style=\"color:#7fe7c4\">teal</span>: convex bound &nbsp;|&nbsp;<span style=\"color:#ffd479\">gold</span>: d(H,lerp t)<br/>`+\n    `d(F,G)=${dFG.toFixed(3)} &nbsp; Busemann defect at t=${defect.toFixed(3)} `+\n    (defect>1e-6?'(>0: flat / not CAT(0))':'(=0: sharp diagonal)');\n}\ntEl.oninput=draw;hEl.oninput=draw;draw();\n</script>\n</body>\n</html>\n"
    }
