  "algorithms": [
    {
      "name": "Exact Interleaving Distance via the Isometry Formula",
      "description": "Computes the extended interleaving distance between two finite filtrations as the supremum over all simplices of the absolute weight gap, d(F,G) = max_sigma |F(sigma) - G(sigma)|. This is exact (not an approximation) because of the isometry theorem identifying the abstract shift-infimum interleaving distance with the l-infinity weight sup-distance. For a vertex set of size n there are 2^n simplices, so the procedure is a single pass over the weight table with time complexity Theta(2^n) and O(1) extra space.",
      "pseudocode": "function interleaving_distance(F, G):\n    # F, G are weight tables indexed by subsets of the vertex set\n    best <- 0\n    for each simplex sigma in domain(F):\n        gap <- |F[sigma] - G[sigma]|\n        if gap > best:\n            best <- gap\n    return best   # = max_sigma |F(sigma) - G(sigma)| = d(F, G)",
      "code": "from typing import Dict, FrozenSet\n\nSimplex = FrozenSet[int]\nFiltration = Dict[Simplex, float]\n\n\ndef interleaving_distance(F: Filtration, G: Filtration) -> float:\n    \"\"\"Exact interleaving distance = max_sigma |F(sigma) - G(sigma)|.\"\"\"\n    return max(abs(F[sigma] - G[sigma]) for sigma in F)\n"
    },
    {
      "name": "Constant-Speed Geodesic Sampling between Filtrations",
      "description": "Produces n+1 equally spaced samples lerp F G (k/n) along the convex interpolation geodesic. By the constant-speed geodesic identity d(lerp s, lerp t) = |s-t| * d(F,G), consecutive samples are equidistant, with spacing exactly d(F,G)/n, and the full betweenness law guarantees the partial distances sum to the total. Each sample is an elementwise convex combination of the two weight tables, so building all samples costs Theta(n * 2^|V|) time.",
      "pseudocode": "function geodesic_samples(F, G, n):\n    samples <- empty list\n    for k in 0 .. n:\n        t <- k / n\n        L <- new table\n        for each simplex sigma in domain(F):\n            L[sigma] <- (1 - t) * F[sigma] + t * G[sigma]\n        append L to samples\n    return samples   # samples[0]=F, samples[n]=G, equidistant",
      "code": "from typing import Dict, FrozenSet, List\n\nSimplex = FrozenSet[int]\nFiltration = Dict[Simplex, float]\n\n\ndef lerp(F: Filtration, G: Filtration, t: float) -> Filtration:\n    return {s: (1.0 - t) * F[s] + t * G[s] for s in F}\n\n\ndef geodesic_samples(F: Filtration, G: Filtration, n: int) -> List[Filtration]:\n    \"\"\"n+1 equally spaced points on the F--G geodesic (constant speed).\"\"\"\n    return [lerp(F, G, k / n) for k in range(n + 1)]\n"
    },
    {
      "name": "Functorial Pullback Transport of a Geodesic",
      "description": "Given a vertex map f : alpha -> beta and a filtration on beta, computes the pullback (pullback f F)(sigma) = F(image of sigma under f), and verifies the commutation law pullback(lerp F G t) = lerp(pullback F, pullback G, t). Because pullback is a fixed reindexing and lerp is an average, both are affine in the weight and commute exactly. The pullback of an alpha-simplex requires forming its f-image (O(|sigma|)), so the transport over all 2^|alpha| simplices costs Theta(|alpha| * 2^|alpha|).",
      "pseudocode": "function pullback(f, F, vertices_alpha):\n    result <- new table\n    for each subset sigma of vertices_alpha:\n        image <- { f(v) : v in sigma }\n        result[sigma] <- F[image]\n    return result\n\n# Commutation (verified):\n#   pullback(f, lerp(F, G, t)) == lerp(pullback(f,F), pullback(f,G), t)",
      "code": "from itertools import chain, combinations\nfrom typing import Callable, Dict, FrozenSet, Iterable, List\n\nSimplex = FrozenSet[int]\nFiltration = Dict[Simplex, float]\n\n\ndef powerset(vertices: Iterable[int]) -> List[Simplex]:\n    items = list(vertices)\n    return [frozenset(c) for c in chain.from_iterable(\n        combinations(items, r) for r in range(len(items) + 1))]\n\n\ndef pullback(f: Callable[[int], int], F: Filtration,\n             vertices_alpha: Iterable[int]) -> Filtration:\n    \"\"\"(pullback f F)(sigma) = F(image of sigma under f).\"\"\"\n    out: Filtration = {}\n    for sigma in powerset(vertices_alpha):\n        out[sigma] = F[frozenset(f(v) for v in sigma)]\n    return out\n"
    }
