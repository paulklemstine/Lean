\end{enumerate}

\section{Preliminaries and Definitions}

\begin{definition}[Units modulo $n$]
The group of units $\units{n}$ is the multiplicative group of residue classes
$[a]$ with $\gcd(a,n)=1$. Its order is Euler's totient $\varphi(n)$. For prime
$p$, $\units{p}$ has order $p-1$.
\end{definition}

\begin{definition}[Order of an element]
In a monoid $M$ with identity $1$, the \emph{order} of $g\in M$, written
$\ord(g)$, is the least positive integer $k$ with $g^k=1$ if one exists, and $0$
otherwise.
\end{definition}

\begin{definition}[Squarefree]
$n$ is \emph{squarefree} if no prime square divides $n$; equivalently $n$ is a
product of distinct primes. Squarefreeness implies $n\neq 0$.
\end{definition}

\begin{definition}[Cyclic group]
A group $G$ is \emph{cyclic} if $G=\langle g\rangle$ for some $g$. In a finite
cyclic group a generator has order $|G|$.
\end{definition}

\begin{definition}[Carmichael number]
A composite $n>1$ is a Carmichael number if every $u\in\units{n}$ satisfies
$u^{n-1}=1$.
\end{definition}

\begin{definition}[Reduction map on units]
If $p\mid n$, the ring projection $\Z/n\Z\to\Z/p\Z$ restricts to a group
homomorphism $f:\units{n}\to\units{p}$, $[a]_n\mapsto[a]_p$.
\end{definition}

\begin{definition}[Carmichael function]
$\lambda(n)$ is the least positive $e$ with $a^e\equiv 1\pmod n$ for all coprime
$a$, i.e.\ the exponent of $\units{n}$. For squarefree $n=p_1\cdots p_k$,
$\lambda(n)=\lcm(p_1-1,\dots,p_k-1)$.
\end{definition}

\section{Foundational Facts}

\begin{fact}[Order and annihilators]\label{fact:annih}
In any monoid, if $g^m=1$ then $\ord(g)\mid m$. No finiteness assumption is
required.
\end{fact}

\begin{fact}[Homomorphisms and powers]\label{fact:hom}
A monoid homomorphism $f$ satisfies $f(g^k)=f(g)^k$ and $f(1)=1$.
\end{fact}

\begin{fact}[Surjectivity of the reduction map]\label{fact:surj}
For $p\mid n$ with $n\neq 0$, the reduction homomorphism $f:\units{n}\to\units{p}$
is surjective.
\end{fact}

\begin{fact}[Cyclicity of $\units{p}$]\label{fact:cyc}
For prime $p$, $\units{p}$ is cyclic of order $p-1$; hence there exists
$g\in\units{p}$ with $\ord(g)=p-1$ (a primitive root modulo $p$).
\end{fact}

\section{Main Results}

\begin{theorem}[Order divides any uniform annihilator]\label{thm:annih}
Let $G$ be a monoid and $m\in\N$. If $g^m=1$ for every $g\in G$, then $\ord(g)\mid
m$ for every $g\in G$.
\end{theorem}
\begin{proof}
Fix $g$. By hypothesis $g^m=1$, and by Fact~\ref{fact:annih} this implies
$\ord(g)\mid m$.
\end{proof}

\begin{remark}
The statement is finiteness-free, holding in arbitrary monoids. This generality
lets the hypothesis apply to $\units{n}$ without invoking its cardinality.
\end{remark}

\begin{theorem}[Homomorphisms do not increase order]\label{thm:mono}
Let $G,H$ be groups and $f:G\to H$ a group homomorphism. Then $\ord(f(g))\mid
\ord(g)$ for every $g\in G$.
\end{theorem}
\begin{proof}
Let $k=\ord(g)$, so $g^k=1$. Then $f(g)^k=f(g^k)=f(1)=1$ by Fact~\ref{fact:hom}.
By Fact~\ref{fact:annih}, $\ord(f(g))\mid k=\ord(g)$.
\end{proof}

\begin{remark}
Surjectivity is \emph{not} needed for this inequality; it becomes relevant only
when transporting an annihilation hypothesis from domain to codomain, as in the
bridge below.
\end{remark}

\begin{theorem}[Arithmetic bridge toward Korselt's criterion]\label{thm:bridge}
Let $n$ be squarefree, let $p$ be a prime with $p\mid n$, and suppose every unit
$u\in\units{n}$ satisfies $u^{n-1}=1$. Then $(p-1)\mid(n-1)$.
\end{theorem}
\begin{proof}
Squarefreeness gives $n\neq 0$, so the reduction homomorphism
$f:\units{n}\to\units{p}$ is defined and, by Fact~\ref{fact:surj}, surjective.

\emph{Step 1 (transport the annihilation).} Let $v\in\units{p}$ be arbitrary. By
surjectivity choose $u\in\units{n}$ with $f(u)=v$. Then, by Fact~\ref{fact:hom}
and the hypothesis,
\[
v^{n-1}=f(u)^{n-1}=f\!\left(u^{n-1}\right)=f(1)=1.
\]
Hence every $v\in\units{p}$ satisfies $v^{n-1}=1$.

\emph{Step 2 (maximal-order element).} By Fact~\ref{fact:cyc}, $\units{p}$ is
cyclic of order $p-1$; let $g$ be a generator, so $\ord(g)=p-1$.

\emph{Step 3 (conclude).} By Step 1, $g^{n-1}=1$. By Fact~\ref{fact:annih} this
gives $\ord(g)\mid(n-1)$. Since $\ord(g)=p-1$, we obtain $(p-1)\mid(n-1)$.
\end{proof}

\begin{remark}
The proof consumes squarefreeness solely to guarantee $n\neq 0$. The arithmetic
content flows entirely from the group structure. Step~1 alone gives that $n-1$
annihilates $\units{p}$, equivalent to $\lambda(p)=p-1$ dividing $n-1$; cyclicity
makes $\lambda(p)=p-1$, so the whole-group annihilation is detected by a single
full-order element.
\end{remark}

\section{Architecture of the Proof}

The bridge factors as a pipeline:
\[
\underbrace{\forall u\in\units{n}.\;u^{n-1}=1}_{\text{global annihilation}}
\xrightarrow[\text{Facts \ref{fact:surj},\,\ref{fact:hom}}]{\;f\text{ surjective}\;}
\underbrace{\forall v\in\units{p}.\;v^{n-1}=1}_{\text{local annihilation}}
\xrightarrow[\text{Fact \ref{fact:cyc}}]{\;\ord(g)=p-1\;}
g^{n-1}=1 \xrightarrow{\text{Fact \ref{fact:annih}}} (p-1)\mid(n-1).
\]
The finiteness-free annihilation lemma fires twice (for $\units{n}$ and for $g$),
and the order-monotonicity lemma names the directionality that lets the forgery
flow only from the global group down to the local one.

\section{Worked Examples}

\begin{example}[$n=561=3\cdot 11\cdot 17$]
Squarefree; $n-1=560$; $p-1\in\{2,10,16\}$, each dividing $560$. Consistent with
$561$ being the least Carmichael number.
\end{example}

\begin{example}[$n=1105=5\cdot 13\cdot 17$]
$n-1=1104$; $p-1\in\{4,12,16\}$; all divide $1104$. Carmichael.
\end{example}

\begin{example}[$n=1729=7\cdot 13\cdot 19$]
$n-1=1728$; $p-1\in\{6,12,18\}$; all divide $1728$. Carmichael (Hardy--Ramanujan
taxicab number).
\end{example}

\begin{example}[A non-example, $n=15=3\cdot5$]
$n-1=14$; $p-1\in\{2,4\}$. Here $2\mid14$ but $4\nmid14$, so the bridge's
hypothesis must fail: $2^{14}=16384\equiv 4\pmod{15}$, witnessing that $15$ is not
a Fermat pseudoprime.
\end{example}

\section{Algorithms}

\paragraph{Korselt verification.} Given $n$: factor $n$; reject if not squarefree;
for each prime factor $p$, reject if $(n-1)\bmod(p-1)\neq 0$; otherwise accept.
Complexity is dominated by factoring; given the factorization, the checks are
$O(k)$ modular reductions on integers of size $O(\log n)$.

\paragraph{Order-collapse witness search.} For a Korselt $n$ with $k$ prime
factors, sample units $a$ and probe square roots of $1$ along
$a^{(n-1)/2^j}$; the bridge guarantees every order divides $n-1$, and the
Miller--Rabin probe detects the proper-divisor collapse certifying compositeness.

\section{Group-Theoretic Context}

The brevity of the bridge is a consequence of choosing the correct setting rather
than an accident. Three structural choices conspire. First, phrasing
Theorem~\ref{thm:annih} over arbitrary monoids decouples it from cardinality: a
naive Lagrange argument gives only $\ord(g)\mid(p-1)$ (the wrong direction),
whereas we need a witness of order \emph{exactly} $p-1$; the annihilation lemma
converts $g^{n-1}=1$ into $\ord(g)\mid(n-1)$ with no appeal to group size. Second,
surjectivity of the reduction map (Fact~\ref{fact:surj}) is the only place the
relation between $n$ and $p$ enters; it lets a universal statement over $\units{n}$
descend to a universal statement over $\units{p}$. Third, cyclicity
(Fact~\ref{fact:cyc}) gives the descended statement teeth: in a cyclic group the
exponent equals the order, so a single generator feels the entire constraint. The
same analysis pinpoints where the squarefreeness half of the converse needs extra
input: for $\units{p^k}$ with $k\ge2$ a generator has order $p^{k-1}(p-1)$, and
$p^{k-1}(p-1)\nmid n-1$ obstructs non-squarefree pseudoprimes.

\section{Applications}

\paragraph{Primality testing and the Miller--Rabin rationale.}
Theorem~\ref{thm:bridge} explains the Fermat test's blind spot: a Carmichael $n$
annihilates the entire unit group by $n-1$. Miller--Rabin repairs this by
examining square roots of $1$; because the bridge forces each local group to be
annihilated by $n-1$ while $n$ is a product of $k\ge2$ cyclic factors, nontrivial
square roots of $1$ exist modulo $n$ (by CRT), and these are precisely the
Miller--Rabin witnesses.

\paragraph{Local-to-global structure.} The bridge is a microcosm of the
local-global principle: a global congruence modulo $n$ implies local order
conditions at each $p\mid n$, transported by a surjective reduction homomorphism;
CRT performs the reverse assembly.

\paragraph{The Carmichael function as the true invariant.} The invariant content
is that the universal exponents of $\units{n}$ are exactly the common multiples of
the local $p-1$; the least such is $\lambda(n)=\lcm_p(p-1)$.

\section{Discussion and Future Work}

\begin{conjecture}[Korselt is an iff]
If $n>1$ is composite and $a^{n-1}\equiv1\pmod n$ for every coprime $a$, then $n$
is squarefree and $(p-1)\mid(n-1)$ for every prime $p\mid n$. The divisibility
direction is Theorem~\ref{thm:bridge}; squarefreeness follows from cyclicity of
$\units{p^k}$ for odd $p$ (a generator of $\units{p^2}$ has order $p(p-1)\nmid
n-1$) plus a CRT splitting.
\end{conjecture}

\begin{conjecture}[Generalized exponent]
For squarefree $n$ and any $e\ge1$, $a^e\equiv1\pmod n$ for all coprime $a$ iff
$(p-1)\mid e$ for every prime $p\mid n$. The classical criterion is $e=n-1$; the
value $n-1$ plays no role in the forward proof, whose true invariant is
$\lambda(n)=\lcm\{p-1\}$.
\end{conjecture}

\begin{conjecture}[Order-collapse detectability]
For a Korselt $n$ with $k$ distinct prime factors, the fraction of bases
$a\in\units{n}$ whose order is a proper divisor of $n-1$ is at least
$1-2^{-(k-1)}$; hence a single uniformly random witness exposes the order collapse
with probability bounded away from $0$.
\end{conjecture}

\section{Conclusion}

We isolated and rigorously verified the arithmetic core of the converse of
Korselt's criterion: global annihilation by $n-1$ forces $(p-1)\mid(n-1)$. The
proof reveals the phenomenon as fundamentally group-theoretic---order divisibility
transported across a surjective reduction homomorphism into a cyclic local
group---and clarifies both the inessentiality of $n-1$ and the cryptographic
stakes of the Fermat test's blind spot.

