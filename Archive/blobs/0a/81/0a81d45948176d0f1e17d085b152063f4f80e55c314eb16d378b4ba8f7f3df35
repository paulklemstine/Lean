/-
  # Valuation ↔ Rips Bridge — Relation-Theoretic Core

  A strictly relation-theoretic bridge between *closed ultrametric Rips
  relations* and *valuation/depth threshold relations*.  Everything lives at
  the level of binary relations and setoids: there are no categories,
  simplicial complexes, persistence modules, or functor layers.

  The development has four parts.

  1. The closed Rips relation `ripsRel d ε x y := d x y ≤ ε` for a (pseudo)
     ultrametric `d`, with its reflexivity / symmetry / transitivity and the
     packaged `Equivalence` (and `Setoid`).

  2. The depth threshold relation `depthRel depth n x y := n ≤ depth x y` over
     the natural-number scale `ℕ`, with symmetry, min-transitivity, and a
     generic `Equivalence` under an explicit reflexivity hypothesis.

  3. The exact comparison theorem with the fixed schedule `(1/2)^n`:
     `ripsRel d ((1/2)^n) x y ↔ n ≤ depth x y`, and the resulting *extensional
     equality of relations* `ripsRel d ((1/2)^n) = depthRel depth n`.

  4. The concrete model: longest-common-valued-prefix length `lcvpLen`
     (from `Catalog.Bridges.LongestCommonValuedPrefix`) with distance
     `lcvpDist u v := (1/2)^(lcvpLen u v)`.  We prove the exact comparison
     lemma, the relation equality, and the concrete equivalence corollary on
     the subtype of lists of length `≥ n`.

  Keywords: ultrametric, valuation, Rips, threshold, prefix_agreement.
-/
import Mathlib
import Catalog.Bridges.LongestCommonValuedPrefix

namespace ValuationRipsBridge

/-! ## 1. The closed ultrametric Rips relation -/

section Rips

variable {α : Type*}

/-- The **closed Rips relation** at threshold `ε` for a distance `d`:
two points are related when their distance is at most `ε`. -/
def ripsRel (d : α → α → ℝ) (ε : ℝ) (x y : α) : Prop := d x y ≤ ε

variable {d : α → α → ℝ} {ε : ℝ}

/-- Reflexivity of the Rips relation, given a (pseudo)metric reflexive-zero law
`d x x = 0` and a nonnegative threshold. -/
theorem ripsRel_refl (hzero : ∀ x, d x x = 0) (hε : 0 ≤ ε) (x : α) :
    ripsRel d ε x x := by
  simp only [ripsRel, hzero]; exact hε

/-- Symmetry of the Rips relation, given a symmetric distance. -/
theorem ripsRel_symm (hsymm : ∀ x y, d x y = d y x) {x y : α}
    (h : ripsRel d ε x y) : ripsRel d ε y x := by
  rw [ripsRel, hsymm]; exact h

/-- Transitivity of the Rips relation under the strong (ultrametric) triangle
inequality `d x z ≤ max (d x y) (d y z)`. -/
theorem ripsRel_trans_of_ultrametric
    (hultra : ∀ x y z, d x z ≤ max (d x y) (d y z)) {x y z : α}
    (hxy : ripsRel d ε x y) (hyz : ripsRel d ε y z) : ripsRel d ε x z :=
  calc d x z ≤ max (d x y) (d y z) := hultra x y z
    _ ≤ ε := max_le hxy hyz

/-- The Rips relation of a (pseudo) ultrametric at a nonnegative threshold is an
equivalence relation. -/
theorem ripsRel_equivalence_of_ultrametric
    (hzero : ∀ x, d x x = 0)
    (hsymm : ∀ x y, d x y = d y x)
    (hultra : ∀ x y z, d x z ≤ max (d x y) (d y z))
    (hε : 0 ≤ ε) : Equivalence (ripsRel d ε) where
  refl := ripsRel_refl hzero hε
  symm := ripsRel_symm hsymm
  trans := ripsRel_trans_of_ultrametric hultra

/-- The Rips relation packaged as a `Setoid`. -/
def ripsSetoid
    (hzero : ∀ x, d x x = 0)
    (hsymm : ∀ x y, d x y = d y x)
    (hultra : ∀ x y z, d x z ≤ max (d x y) (d y z))
    (hε : 0 ≤ ε) : Setoid α where
  r := ripsRel d ε
  iseqv := ripsRel_equivalence_of_ultrametric hzero hsymm hultra hε

end Rips

/-! ## 2. The depth threshold relation on the `ℕ` scale -/

section Depth

variable {α : Type*}

/-- The **depth threshold relation** at level `n`: two points are related when
their valuation depth is at least `n`. -/
def depthRel (depth : α → α → ℕ) (n : ℕ) (x y : α) : Prop := n ≤ depth x y

variable {depth : α → α → ℕ} {n : ℕ}

/-- Reflexivity of the depth relation, given a per-point lower bound. -/
theorem depthRel_refl (hrefl : ∀ x, n ≤ depth x x) (x : α) :
    depthRel depth n x x := hrefl x

/-- Symmetry of the depth relation, given a symmetric depth. -/
theorem depthRel_symm (hsymm : ∀ x y, depth x y = depth y x) {x y : α}
    (h : depthRel depth n x y) : depthRel depth n y x := by
  rw [depthRel, hsymm]; exact h

/-- Transitivity of the depth relation under the min-transitivity (ultrametric
depth) law `min (depth x y) (depth y z) ≤ depth x z`. -/
theorem depthRel_trans
    (hmin : ∀ x y z, min (depth x y) (depth y z) ≤ depth x z) {x y z : α}
    (hxy : depthRel depth n x y) (hyz : depthRel depth n y z) :
    depthRel depth n x z :=
  le_trans (le_min hxy hyz) (hmin x y z)

/-- The depth relation is an equivalence relation, given an explicit
per-point reflexivity bound, symmetry, and min-transitivity. -/
theorem depthRel_equivalence
    (hrefl : ∀ x, n ≤ depth x x)
    (hsymm : ∀ x y, depth x y = depth y x)
    (hmin : ∀ x y z, min (depth x y) (depth y z) ≤ depth x z) :
    Equivalence (depthRel depth n) where
  refl := depthRel_refl hrefl
  symm := depthRel_symm hsymm
  trans := depthRel_trans hmin

end Depth

/-! ## 3. The exact comparison theorem with the `(1/2)^n` schedule -/

section Comparison

variable {α : Type*} {d : α → α → ℝ} {depth : α → α → ℕ}

/-- **Exact comparison** at the schedule `(1/2)^n`: under the calibration
hypothesis `compare`, being Rips-related at threshold `(1/2)^n` is equivalent
to having depth at least `n`. -/
theorem ripsRel_iff_depthRel
    (compare : ∀ x y n, d x y ≤ (1/2 : ℝ)^n ↔ n ≤ depth x y)
    (n : ℕ) (x y : α) :
    ripsRel d ((1/2 : ℝ)^n) x y ↔ depthRel depth n x y :=
  compare x y n

/-- **Extensional equality of relations**: the closed ultrametric Rips relation
at threshold `(1/2)^n` *is* the depth threshold relation at level `n`. -/
theorem ripsRel_eq_depthRel
    (compare : ∀ x y n, d x y ≤ (1/2 : ℝ)^n ↔ n ≤ depth x y)
    (n : ℕ) :
    ripsRel d ((1/2 : ℝ)^n) = depthRel depth n := by
  ext x y
  exact compare x y n

end Comparison

/-! ## 4. The concrete model: longest common valued prefix -/

section LCVP

open OracleTrace

variable {α : Type*} [DecidableEq α]

/-- The concrete ultrametric distance attached to `lcvpLen`: lists that agree on
a longer prefix are closer, with the geometric schedule `(1/2)^(lcvpLen u v)`. -/
noncomputable def lcvpDist (u v : List α) : ℝ := (1/2 : ℝ) ^ (lcvpLen u v)

@[simp] theorem lcvpDist_def (u v : List α) :
    lcvpDist u v = (1/2 : ℝ) ^ (lcvpLen u v) := rfl

/-- `lcvpDist` is symmetric, inherited from symmetry of `lcvpLen`. -/
theorem lcvpDist_symm (u v : List α) : lcvpDist u v = lcvpDist v u := by
  rw [lcvpDist, lcvpDist, lcvpLen_symmetric]

/-- `lcvpDist` is positive (so it is *not* the genuine zero-on-diagonal metric,
but a pseudo-ultrametric whose threshold relation is the object of interest). -/
theorem lcvpDist_pos (u v : List α) : 0 < lcvpDist u v := by
  rw [lcvpDist]; positivity

/-- The **strong (ultrametric) triangle inequality** for `lcvpDist`, obtained
from the min-prefix inequality of `lcvpLen` and antitonicity of `(1/2)^·`. -/
theorem lcvpDist_strong_triangle (u v w : List α) :
    lcvpDist u w ≤ max (lcvpDist u v) (lcvpDist v w) := by
  have hmin : min (lcvpLen u v) (lcvpLen v w) ≤ lcvpLen u w :=
    lcvpLen_ge_min_of_triangle u v w
  rcases le_total (lcvpLen u v) (lcvpLen v w) with h | h
  · rw [Nat.min_eq_left h] at hmin
    refine le_trans ?_ (le_max_left _ _)
    rw [lcvpDist, lcvpDist]
    exact (pow_le_pow_iff_right_of_lt_one₀ (by norm_num) (by norm_num)).2 hmin
  · rw [Nat.min_eq_right h] at hmin
    refine le_trans ?_ (le_max_right _ _)
    rw [lcvpDist, lcvpDist]
    exact (pow_le_pow_iff_right_of_lt_one₀ (by norm_num) (by norm_num)).2 hmin

/-- **The concrete calibration / comparison lemma.**  For the LCVP model the
closed-ball threshold `lcvpDist u v ≤ (1/2)^n` holds exactly when the common
prefix has length at least `n`. -/
theorem lcvp_compare (u v : List α) (n : ℕ) :
    lcvpDist u v ≤ (1/2 : ℝ)^n ↔ n ≤ lcvpLen u v := by
  rw [lcvpDist]
  exact pow_le_pow_iff_right_of_lt_one₀ (by norm_num) (by norm_num)

/-- **The concrete bridge theorem.**  In the LCVP model, the closed ultrametric
Rips relation at threshold `(1/2)^n` is exactly the depth threshold relation at
level `n`. -/
theorem lcvp_ripsRel_eq_depthRel (n : ℕ) :
    ripsRel (lcvpDist (α := α)) ((1/2 : ℝ)^n) = depthRel (lcvpLen (α := α)) n :=
  ripsRel_eq_depthRel (fun u v m => lcvp_compare u v m) n

/-- Pointwise form of the concrete bridge theorem. -/
theorem lcvp_ripsRel_iff_depthRel (n : ℕ) (u v : List α) :
    ripsRel (lcvpDist) ((1/2 : ℝ)^n) u v ↔ depthRel (lcvpLen) n u v :=
  lcvp_compare u v n

/-! ### Concrete equivalence corollary

On all of `List α` neither relation is reflexive (a list of length `< n` is not
related to itself, since `lcvpLen u u = u.length`).  Restricting to lists of
length at least `n` restores reflexivity and yields a genuine equivalence /
setoid. -/

/-- Lists whose length is at least `n`; on this subtype the depth relation is an
equivalence. -/
def LongList (α : Type*) (n : ℕ) := {u : List α // n ≤ u.length}

/-- The concrete depth (equivalently, Rips at threshold `(1/2)^n`) relation is an
equivalence relation on `LongList α n`. -/
theorem lcvp_depthRel_equivalence (n : ℕ) :
    Equivalence (fun u v : LongList α n => depthRel (lcvpLen) n u.1 v.1) where
  refl u := by
    show n ≤ lcvpLen u.1 u.1
    rw [lcvpLen_self]; exact u.2
  symm h := depthRel_symm lcvpLen_symmetric h
  trans hxy hyz := depthRel_trans lcvpLen_ge_min_of_triangle hxy hyz

/-- The concrete equivalence packaged as a `Setoid` on `LongList α n`. -/
def lcvpSetoid (n : ℕ) : Setoid (LongList α n) where
  r u v := depthRel (lcvpLen) n u.1 v.1
  iseqv := lcvp_depthRel_equivalence n

end LCVP

end ValuationRipsBridge
