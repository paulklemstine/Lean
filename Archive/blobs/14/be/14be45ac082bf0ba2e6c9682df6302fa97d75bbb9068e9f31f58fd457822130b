/-
# Intersection Form Classification Pipeline via Self-Dual Code Direct Sum

This module develops, side by side, the *direct-sum functoriality* of the two
parallel worlds of unimodular classification theory:

1. **Integer intersection forms.** A symmetric integer matrix `M : Matrix ι ι ℤ`
   is the intersection form of (the cup product on the middle cohomology of) a
   closed oriented 4-manifold.  Its classification invariants are: rank, the
   determinant / unimodularity (the *discriminant*), the trace, and the
   even/odd *type*.  The orthogonal direct sum of forms corresponds to the
   connected sum `M₁ # M₂` of 4-manifolds, and is realised on matrices by the
   block-diagonal `fromBlocks A 0 0 B`.

2. **Binary self-dual codes.** A `[n, n/2]` binary linear code `C ⊆ 𝔽₂ⁿ` with
   `C = C⊥`.  Self-dual codes are the coding-theoretic shadow of even unimodular
   lattices (Construction A).  The direct sum of codes is again block-diagonal
   on generator matrices.

The unifying slogan of this file: **both worlds carry the same additive /
multiplicative bookkeeping under direct sum.**  Rank and trace add, the
determinant multiplies (hence unimodularity is preserved), the even type is
preserved, self-orthogonality `G Gᵀ = 0` is preserved, linear independence of
the generating rows is preserved, and the self-dual property is preserved.

-- !-- Lab Notes -- !--
-- HYPOTHESIS (H1): the connected-sum / direct-sum operation acts as a monoid
--   homomorphism on every classical unimodular invariant simultaneously.
-- EXPERIMENT: encode the direct sum as `Matrix.fromBlocks A 0 0 B` over the
--   index `ι ⊕ κ` (avoiding all `Fin`-arithmetic), and check each invariant.
-- OUTCOME: `det_fromBlocks_zero₁₂`, `fromBlocks_transpose`, `fromBlocks_multiply`
--   and `fromBlocks_zero` make every invariant a one-liner-style block lemma.
-- INSIGHT: working over *arbitrary* finite index types `ι, κ` (not `Fin n`) is
--   the key simplification: `Fin (m+n)` reindexing was the main friction point
--   and is entirely sidestepped.
-- FAILURE ANALYSIS: a full real-valued *signature* turned out to need spectral
--   theory (Sylvester's law of inertia) that is not cleanly available; we record
--   it as a future direction and instead track trace + determinant + type, which
--   already pin down indefinite forms via Milnor–Husemoller.
-/
import Mathlib

namespace Logic.IntersectionFormSelfDual

open Matrix

/-! ## Part 1 · Integer intersection forms and their direct sum -/

section Forms

variable {ι κ : Type*} [Fintype ι] [Fintype κ] [DecidableEq ι] [DecidableEq κ]

/-- A form is **unimodular** when its Gram determinant is a unit of `ℤ`, i.e. `±1`. -/
def IsUnimodular (M : Matrix ι ι ℤ) : Prop := M.det = 1 ∨ M.det = -1

/-- A symmetric form is of **even type** when every diagonal entry is even
(equivalently the associated quadratic form takes only even values). -/
def IsEvenForm (M : Matrix ι ι ℤ) : Prop := ∀ i, Even (M i i)

/-- The **orthogonal direct sum** of two integer forms: the block-diagonal matrix.
This realises the intersection form of a connected sum of 4-manifolds. -/
def directSumForm (A : Matrix ι ι ℤ) (B : Matrix κ κ ℤ) :
    Matrix (ι ⊕ κ) (ι ⊕ κ) ℤ := fromBlocks A 0 0 B

/-
Symmetry is preserved by direct sum.
-/
omit [Fintype ι] [Fintype κ] [DecidableEq ι] [DecidableEq κ] in
theorem directSumForm_isSymm (A : Matrix ι ι ℤ) (B : Matrix κ κ ℤ)
    (hA : A.IsSymm) (hB : B.IsSymm) : (directSumForm A B).IsSymm := by
  simp_all +decide [ directSumForm, Matrix.IsSymm, Matrix.fromBlocks_transpose ]

/-
The determinant of a direct sum is the product of the determinants.
-/
theorem directSumForm_det (A : Matrix ι ι ℤ) (B : Matrix κ κ ℤ) :
    (directSumForm A B).det = A.det * B.det := by
  convert Matrix.det_fromBlocks_zero₁₂ A 0 B using 1

/-
Unimodularity is preserved by direct sum (the discriminant is multiplicative).
-/
theorem directSumForm_unimodular (A : Matrix ι ι ℤ) (B : Matrix κ κ ℤ)
    (hA : IsUnimodular A) (hB : IsUnimodular B) : IsUnimodular (directSumForm A B) := by
  rcases hA with ( hA | hA ) <;> rcases hB with ( hB | hB ) <;> simp_all +decide [ IsUnimodular, directSumForm_det ]

/-
The even type is preserved by direct sum.
-/
omit [Fintype ι] [Fintype κ] [DecidableEq ι] [DecidableEq κ] in
theorem directSumForm_even (A : Matrix ι ι ℤ) (B : Matrix κ κ ℤ)
    (hA : IsEvenForm A) (hB : IsEvenForm B) : IsEvenForm (directSumForm A B) := by
  intro x; cases x <;> simp_all +decide [ directSumForm, IsEvenForm ] ;

/-
The trace is additive under direct sum.
-/
omit [DecidableEq ι] [DecidableEq κ] in
theorem directSumForm_trace (A : Matrix ι ι ℤ) (B : Matrix κ κ ℤ) :
    (directSumForm A B).trace = A.trace + B.trace := by
  unfold directSumForm;
  simp +decide [ Matrix.trace ]

end Forms

/-! ## Part 2 · Binary self-dual codes and their direct sum

We represent a binary code by a **generator matrix** `G : Matrix κ ι (ZMod 2)`
whose rows (indexed by `κ`) span the code inside `𝔽₂^ι`.  Self-orthogonality is
`G Gᵀ = 0`; together with full row rank and the dimension constraint
`#ι = 2 · #κ` this is equivalent to `C = C⊥` (since `C ⊆ C⊥` and
`dim C = #ι / 2 = dim C⊥` force equality).  -/

section Codes

variable {κ κ' ι ι' : Type*}
  [Fintype κ] [Fintype κ'] [Fintype ι] [Fintype ι']

/-- A code is **self-orthogonal** when `G Gᵀ = 0`, i.e. the code is contained in
its dual. -/
def IsSelfOrthogonal (G : Matrix κ ι (ZMod 2)) : Prop := G * Gᵀ = 0

/-- The **direct sum** of two generator matrices: block-diagonal. -/
def directSumGen (G : Matrix κ ι (ZMod 2)) (H : Matrix κ' ι' (ZMod 2)) :
    Matrix (κ ⊕ κ') (ι ⊕ ι') (ZMod 2) := fromBlocks G 0 0 H

/-- A code is **self-dual** when it is self-orthogonal, has full row rank
(linearly independent generating rows), and saturates the dimension bound
`#ι = 2 · #κ`. -/
def IsSelfDual (G : Matrix κ ι (ZMod 2)) : Prop :=
  IsSelfOrthogonal G ∧
  LinearIndependent (ZMod 2) (fun a => G a) ∧
  Fintype.card ι = 2 * Fintype.card κ

/-
The Gram matrix of a direct sum is the block-diagonal of the Gram matrices.
-/
omit [Fintype κ] [Fintype κ'] in
theorem directSumGen_mul_transpose (G : Matrix κ ι (ZMod 2)) (H : Matrix κ' ι' (ZMod 2)) :
    directSumGen G H * (directSumGen G H)ᵀ = fromBlocks (G * Gᵀ) 0 0 (H * Hᵀ) := by
  ext i j; simp +decide [ Matrix.mul_apply, directSumGen ];
  cases i <;> cases j <;> simp +decide [ Matrix.mul_apply, fromBlocks ]

/-
Self-orthogonality is preserved by direct sum.
-/
omit [Fintype κ] [Fintype κ'] in
theorem directSumGen_selfOrthogonal {G : Matrix κ ι (ZMod 2)} {H : Matrix κ' ι' (ZMod 2)}
    (hG : IsSelfOrthogonal G) (hH : IsSelfOrthogonal H) :
    IsSelfOrthogonal (directSumGen G H) := by
  unfold IsSelfOrthogonal at *;
  rw [ directSumGen_mul_transpose, hG, hH, Matrix.fromBlocks_zero ]

/-
Linear independence of generating rows is preserved by direct sum.
-/
omit [Fintype ι] [Fintype ι'] in
theorem directSumGen_linearIndependent {G : Matrix κ ι (ZMod 2)} {H : Matrix κ' ι' (ZMod 2)}
    (hG : LinearIndependent (ZMod 2) (fun a => G a))
    (hH : LinearIndependent (ZMod 2) (fun b => H b)) :
    LinearIndependent (ZMod 2) (fun x => directSumGen G H x) := by
  refine' Fintype.linearIndependent_iff.2 _;
  intro g hg; simp_all +decide [ funext_iff ] ;
  simp_all +decide [ Fintype.linearIndependent_iff, directSumGen ];
  exact ⟨ hG _ ( by ext a; simpa [ Matrix.mulVec, dotProduct ] using hg.1 a ), hH _ ( by ext a; simpa [ Matrix.mulVec, dotProduct ] using hg.2 a ) ⟩

/-
**Main code theorem.** The direct sum of two binary self-dual codes is
self-dual.  This is the coding-theoretic analogue of the connected sum of
even unimodular 4-manifolds.
-/
theorem directSumGen_selfDual {G : Matrix κ ι (ZMod 2)} {H : Matrix κ' ι' (ZMod 2)}
    (hG : IsSelfDual G) (hH : IsSelfDual H) : IsSelfDual (directSumGen G H) := by
  refine' ⟨ _, _, _ ⟩;
  · exact directSumGen_selfOrthogonal hG.1 hH.1;
  · convert directSumGen_linearIndependent hG.2.1 hH.2.1;
  · rw [ Fintype.card_sum, Fintype.card_sum ];
    linarith [ hG.2.2, hH.2.2 ]

/-
A binary self-dual code has even length.
-/
theorem selfDual_card_even {G : Matrix κ ι (ZMod 2)} (hG : IsSelfDual G) :
    Even (Fintype.card ι) := by
  exact hG.2.2.symm ▸ even_two_mul _

end Codes

end Logic.IntersectionFormSelfDual