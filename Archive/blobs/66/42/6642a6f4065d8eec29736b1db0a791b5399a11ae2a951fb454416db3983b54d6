open Finset HolographicCoding

namespace InformationGravity

variable {α : Type*} [DecidableEq α]

/-! ### Mutual Information -/

/-- The **mutual information** `I(X:Y) = S(X) + S(Y) - S(X ∪ Y)` of two boundary regions,
with the union playing the role of the joint region. -/
def mutualInfo (H : HolographicCodeProfile α) (X Y : Finset α) : ℝ :=
  H.S X + H.S Y - H.S (X ∪ Y)

/-- Mutual information decomposes as the syndrome defect plus the entropy of the overlap:
`I(X:Y) = syndromeDefect(X,Y) + S(X ∩ Y)`. -/
theorem mutualInfo_eq_syndromeDefect_add (H : HolographicCodeProfile α) (X Y : Finset α) :
    mutualInfo H X Y = syndromeDefect H X Y + H.S (X ∩ Y) := by
  unfold mutualInfo syndromeDefect
  ring

/-- **Subadditivity**: mutual information is nonnegative. Follows from nonnegativity of both the
syndrome defect (submodularity) and the overlap entropy. -/
theorem mutualInfo_nonneg (H : HolographicCodeProfile α) (X Y : Finset α) :
    0 ≤ mutualInfo H X Y := by
  rw [mutualInfo_eq_syndromeDefect_add]
  have h1 := syndromeDefect_nonneg H X Y
  have h2 := H.S_nonneg (X ∩ Y)
  linarith

/-- Mutual information is symmetric. -/
theorem mutualInfo_symm (H : HolographicCodeProfile α) (X Y : Finset α) :
    mutualInfo H X Y = mutualInfo H Y X := by
  unfold mutualInfo
  rw [union_comm]
  ring

/-- Self-information equals entropy: `I(X:X) = S(X)`. -/
theorem mutualInfo_self (H : HolographicCodeProfile α) (X : Finset α) :
    mutualInfo H X X = H.S X := by
  unfold mutualInfo
  rw [union_self]
  ring

/-- Mutual information with the empty region vanishes. -/
theorem mutualInfo_empty_right (H : HolographicCodeProfile α) (X : Finset α) :
    mutualInfo H X ∅ = 0 := by
  unfold mutualInfo
  rw [union_empty, H.S_empty]
  ring

/-! ### A set-algebra lemma: the meet of thickenings collapses to the conditioning region -/

/-- For disjoint `A` and `B`, the meet of the `C`-thickenings is exactly `C`:
`(A ∪ C) ∩ (B ∪ C) = C`. This is the algebraic heart of "conditioning". -/
theorem aux_thickening_inter (A B C : Finset α) (hAB : Disjoint A B) :
    (A ∪ C) ∩ (B ∪ C) = C := by
  ext x
  simp only [mem_inter, mem_union]
  constructor
  · rintro ⟨hL, hR⟩
    rcases hL with hA | hC
    · rcases hR with hB | hC
      · exact absurd hB (Finset.disjoint_left.mp hAB hA)
      · exact hC
    · exact hC
  · intro hC; exact ⟨Or.inr hC, Or.inr hC⟩

/-- The join of the `C`-thickenings is the full region `A ∪ B ∪ C`. -/
theorem aux_thickening_union (A B C : Finset α) :
    (A ∪ C) ∪ (B ∪ C) = A ∪ B ∪ C := by
  ext x; simp only [mem_union]; tauto

/-! ### Conditional Mutual Information and Strong Subadditivity -/

/-- The **conditional mutual information** `I(A:B|C) = S(A∪C) + S(B∪C) - S(C) - S(A∪B∪C)`.
This is the canonical SSA quantity of quantum information theory. -/
def condMutualInfo (H : HolographicCodeProfile α) (A B C : Finset α) : ℝ :=
  H.S (A ∪ C) + H.S (B ∪ C) - H.S C - H.S (A ∪ B ∪ C)

/-- **Central bridge**: for disjoint `A, B`, the conditional mutual information equals the
`HolographicCoding` syndrome defect of the thickenings. Thus CMI *is* the discrete curvature
functional, and SSA is the lattice submodularity of `HolographicCoding`. -/
theorem condMutualInfo_eq_syndromeDefect (H : HolographicCodeProfile α)
    (A B C : Finset α) (hAB : Disjoint A B) :
    condMutualInfo H A B C = syndromeDefect H (A ∪ C) (B ∪ C) := by
  unfold condMutualInfo syndromeDefect
  rw [aux_thickening_inter A B C hAB, aux_thickening_union A B C]

/-- **Strong subadditivity (SSA)**: conditional mutual information is nonnegative for disjoint
regions. Proved entirely from `HolographicCoding.syndromeDefect_nonneg` via the bridge above. -/
theorem condMutualInfo_nonneg (H : HolographicCodeProfile α)
    (A B C : Finset α) (hAB : Disjoint A B) :
    0 ≤ condMutualInfo H A B C := by
  rw [condMutualInfo_eq_syndromeDefect H A B C hAB]
  exact syndromeDefect_nonneg H (A ∪ C) (B ∪ C)

/-- Conditional mutual information is symmetric in the two information-carrying regions. -/
theorem condMutualInfo_symm (H : HolographicCodeProfile α) (A B C : Finset α) :
    condMutualInfo H A B C = condMutualInfo H B A C := by
  unfold condMutualInfo
  have h : A ∪ B ∪ C = B ∪ A ∪ C := by rw [union_comm A B]
  rw [h]; ring

/-- With `C = ∅`, conditional mutual information reduces to ordinary mutual information. -/
theorem condMutualInfo_empty_cond (H : HolographicCodeProfile α) (A B : Finset α) :
    condMutualInfo H A B ∅ = mutualInfo H A B := by
  unfold condMutualInfo mutualInfo
  simp only [union_empty, H.S_empty]
  ring

/-! ### Quantum Markov Chains and Bulk Recoverability -/

/-- A triple `(A, B, C)` is a **quantum Markov chain** (conditioned on `C`) when its conditional
mutual information vanishes: `I(A:B|C) = 0`. Physically: `A → C → B`, and the bulk information of
`A∪C` is exactly recoverable from `C` alone — the holographic "no-curvature across `C`" condition. -/
def IsMarkov (H : HolographicCodeProfile α) (A B C : Finset α) : Prop :=
  condMutualInfo H A B C = 0

/-- **Markov = modular (flat)**: a triple is a quantum Markov chain iff its entropies are modular
across the conditioning region, i.e. `S(A∪C) + S(B∪C) = S(C) + S(A∪B∪C)`. -/
theorem markov_iff_modular (H : HolographicCodeProfile α) (A B C : Finset α) :
    IsMarkov H A B C ↔ H.S (A ∪ C) + H.S (B ∪ C) = H.S C + H.S (A ∪ B ∪ C) := by
  unfold IsMarkov condMutualInfo
  constructor <;> intro h <;> linarith

/-- For disjoint `A, B`, being Markov is equivalent to the syndrome defect of the thickenings
vanishing — i.e. flatness of the `HolographicCoding` bulk geometry across the interface. -/
theorem markov_iff_zero_syndrome (H : HolographicCodeProfile α)
    (A B C : Finset α) (hAB : Disjoint A B) :
    IsMarkov H A B C ↔ syndromeDefect H (A ∪ C) (B ∪ C) = 0 := by
  unfold IsMarkov
  rw [condMutualInfo_eq_syndromeDefect H A B C hAB]

/-- Strict positivity of conditional mutual information is exactly the failure of the Markov
property: positive CMI means genuine curvature across `C`. -/
theorem pos_condMutualInfo_iff_not_markov (H : HolographicCodeProfile α)
    (A B C : Finset α) (hAB : Disjoint A B) :
    0 < condMutualInfo H A B C ↔ ¬ IsMarkov H A B C := by
  unfold IsMarkov
  constructor
  · intro hpos heq; rw [heq] at hpos; exact lt_irrefl 0 hpos
  · intro hne
    rcases lt_or_eq_of_le (condMutualInfo_nonneg H A B C hAB) with h | h
    · exact h
    · exact absurd h.symm hne

/-! ### Holographic Monogamy of Mutual Information (the holographic entropy cone) -/

/-- A **holographic MMI profile** is a holographic code profile satisfying the additional
*monogamy of mutual information* inequality for pairwise-disjoint regions:
`S(A∪B) + S(B∪C) + S(A∪C) ≥ S(A) + S(B) + S(C) + S(A∪B∪C)`.

MMI is *not* implied by strong subadditivity; it is the single extra inequality (beyond SSA) that
characterises states with a classical holographic dual. We axiomatise it here and derive its
information-theoretic consequences. -/
structure HolographicMMIProfile (α : Type*) [DecidableEq α] where
  /-- The underlying holographic code profile -/
  H : HolographicCodeProfile α
  /-- Monogamy of mutual information for pairwise-disjoint regions -/
  mmi : ∀ A B C : Finset α, Disjoint A B → Disjoint A C → Disjoint B C →
    H.S (A ∪ B) + H.S (B ∪ C) + H.S (A ∪ C) ≥
      H.S A + H.S B + H.S C + H.S (A ∪ B ∪ C)

/-- The **tripartite information**
`I₃(A:B:C) = S(A)+S(B)+S(C) - S(A∪B)-S(B∪C)-S(A∪C) + S(A∪B∪C)`. -/
def tripartiteInfo (H : HolographicCodeProfile α) (A B C : Finset α) : ℝ :=
  H.S A + H.S B + H.S C - H.S (A ∪ B) - H.S (B ∪ C) - H.S (A ∪ C) + H.S (A ∪ B ∪ C)

/-- **MMI in tripartite-information form**: for a holographic MMI profile and pairwise-disjoint
regions, `I₃ ≤ 0`. This is the defining signature of holographic states (generic quantum states
can have `I₃ > 0`). -/
theorem tripartiteInfo_nonpos (M : HolographicMMIProfile α)
    (A B C : Finset α) (hAB : Disjoint A B) (hAC : Disjoint A C) (hBC : Disjoint B C) :
    tripartiteInfo M.H A B C ≤ 0 := by
  unfold tripartiteInfo
  have h := M.mmi A B C hAB hAC hBC
  linarith

/-- The tripartite information equals the monogamy gap of mutual information:
`I₃ = I(A:B) + I(A:C) - I(A:B∪C)`. -/
theorem tripartiteInfo_eq_monogamy_gap (H : HolographicCodeProfile α) (A B C : Finset α) :
    tripartiteInfo H A B C =
      mutualInfo H A B + mutualInfo H A C - mutualInfo H A (B ∪ C) := by
  unfold tripartiteInfo mutualInfo
  have h : A ∪ (B ∪ C) = A ∪ B ∪ C := by rw [union_assoc]
  rw [h]; ring

/-- **Monogamy of mutual information**: in a holographic MMI profile, mutual information is
monogamous — `I(A:B∪C) ≥ I(A:B) + I(A:C)`. The information `A` shares with the union of `B` and `C`
exceeds what it shares with them separately. This is the hallmark of geometric (holographic)
entanglement. -/
theorem monogamy_of_mutual_information (M : HolographicMMIProfile α)
    (A B C : Finset α) (hAB : Disjoint A B) (hAC : Disjoint A C) (hBC : Disjoint B C) :
    mutualInfo M.H A B + mutualInfo M.H A C ≤ mutualInfo M.H A (B ∪ C) := by
  have h1 := tripartiteInfo_nonpos M A B C hAB hAC hBC
  rw [tripartiteInfo_eq_monogamy_gap] at h1
  linarith

/-! ### The Einstein First Law: geometry as linear response to information -/

/-- The **Einstein first law** in pointwise form: the area difference between two regions is exactly
four times their entropy difference, `δArea = 4 δS`. This is the discrete avatar of the statement
that linearised Einstein equations are equivalent to the first law of entanglement entropy. -/
theorem first_law_area_entropy (H : HolographicCodeProfile α) (X Y : Finset α) :
    H.area X - H.area Y = 4 * (H.S X - H.S Y) := by
  rw [area_eq_four_S H X, area_eq_four_S H Y]
  ring

/-- The **area mutual information** `I_area(X:Y) = area(X) + area(Y) - area(X∪Y)`. -/
def areaMutualInfo (H : HolographicCodeProfile α) (X Y : Finset α) : ℝ :=
  H.area X + H.area Y - H.area (X ∪ Y)

/-- The first law lifted to mutual information: `I_area(X:Y) = 4 · I(X:Y)`. Geometric correlation
is exactly four times informational correlation. -/
theorem areaMutualInfo_eq_four_mutualInfo (H : HolographicCodeProfile α) (X Y : Finset α) :
    areaMutualInfo H X Y = 4 * mutualInfo H X Y := by
  unfold areaMutualInfo mutualInfo
  rw [area_eq_four_S H X, area_eq_four_S H Y, area_eq_four_S H (X ∪ Y)]
  ring

/-- Area mutual information is nonnegative (geometric subadditivity), inherited from informational
subadditivity through the first law. -/
theorem areaMutualInfo_nonneg (H : HolographicCodeProfile α) (X Y : Finset α) :
    0 ≤ areaMutualInfo H X Y := by
  rw [areaMutualInfo_eq_four_mutualInfo]
  have := mutualInfo_nonneg H X Y
  linarith

/-! ### Cumulative information functionals -/

/-- The sum of conditional mutual informations over a finite family of disjoint triples is
nonnegative: total curvature across an interface decomposition cannot be negative. -/
theorem condMutualInfo_finset_sum_nonneg (H : HolographicCodeProfile α)
    (triples : Finset (Finset α × Finset α × Finset α))
    (hdisj : ∀ t ∈ triples, Disjoint t.1 t.2.1) :
    0 ≤ ∑ t ∈ triples, condMutualInfo H t.1 t.2.1 t.2.2 := by
  apply Finset.sum_nonneg
  intro t ht
  exact condMutualInfo_nonneg H t.1 t.2.1 t.2.2 (hdisj t ht)

end InformationGravity
