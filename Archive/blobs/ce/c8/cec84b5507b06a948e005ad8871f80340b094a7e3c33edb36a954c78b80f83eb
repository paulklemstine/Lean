import Mathlib
import Tropical.DreamLogic.Core

/-! # Dream Logic, Paraconsistency: contradictions without explosion

Building on `Tropical.DreamLogic.Core`, we put a small propositional language on
top of the tropical evidence model and define a semantic consequence relation.
The point of the file is to prove **formally** that the resulting logic is
*paraconsistent*: a contradiction `A ∧ ¬A` does **not** entail an arbitrary
formula `B`.  Equivalently, *ex contradictione quodlibet* fails, while the
ordinary positive laws (idempotence, disjunction introduction, monotonicity of
the consequence relation, double negation, De Morgan) all survive.

A `DForm` is a formula over natural-number atoms with the usual connectives.
A `DAssign` assigns a `DreamVal` (a tropical evidence pair) to each atom, and
`eval` interprets a formula by the truth-lattice operations of the core file.
A formula is **designated** ("assertible / believed-true") when its
evidence-for coordinate is strictly positive — note that this says nothing about
the evidence-against coordinate, which is precisely what lets a contradiction be
designated together with its negation.

## Main results

* `evalDes_neg` etc. — interaction of designation with the connectives.
* `coexist` — there is an assignment under which `A` *and* `¬A` are both
  designated (contradictions coexist).
* `entails_self`, `entails_or_introl`, `entails_mono` — the consequence relation
  is reflexive, satisfies ∨-introduction, and is monotone (so the *base* logic
  is a respectable Tarskian consequence; non-monotonicity is added in
  `NonMonotone.lean` via defeasible closure).
* `explosion_fails` — **the headline**: `¬ ({A, ¬A} ⊨ B)` for suitable atoms,
  i.e. paraconsistency.
* `neg_undesignated_of_uncontradicted` — when a premise is *not* internally
  contradicted, its negation is undesignated, pinning down the precise boundary
  at which paraconsistency is needed.

-- !-- Lab Notes -- !--
Hypothesis (H2): designation `0 < eval.1` ignores the against-coordinate, so a
"glutty" atom `(1,1)` satisfies both `des A` and `des (¬A)` while a fresh atom
`(0,0)` stays undesignated.  This should break explosion.
Experiment: take atoms a, b, assignment v with v a = (1,1), v b = (0,0).
Then des(a)=1>0, des(¬a)=(v a).2=1>0, but des(b)=0, not >0.  Hence {a,¬a}⊭b.
Outcome: confirmed and formalized as `explosion_fails`.
Failure analysis: an earlier attempt set designation to `0 ≤ eval.1`; then the
fresh atom (0,0) was *also* designated and explosion "trivially failed" for the
wrong reason (b was designated too).  Switching to strict `0 <` makes the
counterexample genuine — the conclusion is really *underivable*, not vacuously
satisfied.  Lesson: paraconsistency counterexamples must exhibit an *undesignated*
conclusion.
Insight (H3): explosion returns precisely for premises whose against-coordinate
is ≤ 0 (uncontradicted), recorded in
`neg_undesignated_of_uncontradicted`; this localizes the failure of
classical logic to exactly the contradictory region.
-/

namespace Tropical.DreamLogic

open DreamVal

/-- Propositional formulas over `ℕ`-indexed atoms. -/
inductive DForm : Type
  | atom : ℕ → DForm
  | neg  : DForm → DForm
  | conj : DForm → DForm → DForm
  | disj : DForm → DForm → DForm
  deriving DecidableEq

/-- An assignment of a tropical evidence pair to each atom. -/
def DAssign := ℕ → DreamVal

/-- Interpret a formula as a `DreamVal` using the truth-lattice operations. -/
def eval (v : DAssign) : DForm → DreamVal
  | .atom n   => v n
  | .neg p    => tneg (eval v p)
  | .conj p q => tand (eval v p) (eval v q)
  | .disj p q => tor (eval v p) (eval v q)

/-- A formula is **designated** under `v` when its evidence-for is positive. -/
def designated (v : DAssign) (p : DForm) : Prop := 0 < (eval v p).1

/-- Semantic consequence: every assignment designating all of `Γ` designates `p`. -/
def entails (Γ : List DForm) (p : DForm) : Prop :=
  ∀ v : DAssign, (∀ q ∈ Γ, designated v q) → designated v p

@[inherit_doc] scoped infix:50 " ⊨d " => entails

/-! ### Basic structural properties of the base consequence relation -/

/-- Reflexivity / identity: `A ⊨ A`. -/
theorem entails_self (p : DForm) : [p] ⊨d p := by
  intro v h; exact h p (by simp)

/-- Disjunction introduction: `A ⊨ A ∨ B`. -/
theorem entails_or_introl (p q : DForm) : [p] ⊨d (DForm.disj p q) := by
  intro v h
  have := h p (by simp)
  simp only [designated, eval, tor] at *
  exact lt_of_lt_of_le this (le_max_left _ _)

/-- Disjunction introduction on the right: `B ⊨ A ∨ B`. -/
theorem entails_or_intror (p q : DForm) : [q] ⊨d (DForm.disj p q) := by
  intro v h
  have := h q (by simp)
  simp only [designated, eval, tor] at *
  exact lt_of_lt_of_le this (le_max_right _ _)

/-- Conjunction elimination: `A ∧ B ⊨ A`. -/
theorem entails_and_eliml (p q : DForm) : [DForm.conj p q] ⊨d p := by
  intro v h
  have := h (DForm.conj p q) (by simp)
  simp only [designated, eval, tand] at *
  exact lt_of_lt_of_le this (min_le_left _ _)

/-- The base consequence relation is **monotone**: enlarging the premise list
preserves entailment.  (Non-monotonicity is introduced separately, via the
defeasible closure of `NonMonotone.lean`.) -/
theorem entails_mono {Γ Δ : List DForm} {p : DForm}
    (hsub : ∀ q ∈ Γ, q ∈ Δ) (h : Γ ⊨d p) : Δ ⊨d p := by
  intro v hd
  exact h v (fun q hq => hd q (hsub q hq))

/-! ### Contradictions coexist -/

/-- Double negation is transparent for evaluation. -/
theorem eval_neg_neg (v : DAssign) (p : DForm) :
    eval v (DForm.neg (DForm.neg p)) = eval v p := by
  simp [eval, tneg_tneg]

/-- There is an assignment under which an atom `A` and its negation `¬A` are
**both designated** — a contradiction is genuinely held. -/
theorem coexist :
    ∃ (v : DAssign) (p : DForm), designated v p ∧ designated v (DForm.neg p) := by
  refine ⟨fun _ => (1, 1), DForm.atom 0, ?_, ?_⟩ <;>
    simp [designated, eval, tneg]

/-! ### Paraconsistency: explosion fails -/

/-- **No explosion.**  There exist formulas `A` and `B` such that the
contradictory premise set `{A, ¬A}` does *not* entail `B`.  This is the formal
statement that Dream Logic is paraconsistent. -/
theorem explosion_fails :
    ∃ (A B : DForm), ¬ ([A, DForm.neg A] ⊨d B) := by
  refine ⟨DForm.atom 0, DForm.atom 1, ?_⟩
  intro hco
  have h := hco (fun n => if n = 0 then (1, 1) else (0, 0)) (by
    intro q hq
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hq
    rcases hq with h | h <;> subst h <;> simp [designated, eval, tneg])
  simp [designated, eval] at h

/-! ### The exact boundary: explosion returns for uncontradicted premises -/

/-- If the evidence *against* `A` is non-positive under `v` (i.e. `A` is not
internally contradicted), then designating `A` forces `¬A` to be undesignated,
so the contradictory premise set is *unsatisfiable* at `v` and entailment to any
`B` holds vacuously there.  This isolates the failure of explosion to the
genuinely contradictory region. -/
theorem neg_undesignated_of_uncontradicted
    (v : DAssign) (A : DForm)
    (huncon : (eval v A).2 ≤ 0) :
    ¬ designated v (DForm.neg A) := by
  simp only [designated, eval, tneg, not_lt]
  exact huncon

end Tropical.DreamLogic
