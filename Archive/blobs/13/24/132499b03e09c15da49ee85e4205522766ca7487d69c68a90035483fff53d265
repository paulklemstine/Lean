import Mathlib
import MachineLearning.ReLUDiophantine.RationalClosure

/-!
# Diophantine approximation on ReLU networks, II: the Leibniz rate

The companion file `RationalClosure.lean` shows a *rational-parameter* ReLU
network can never equal `π` exactly.  Here we quantify how *close* it can get
using the Leibniz alternating series `π/4 = 1 - 1/3 + 1/5 - …`.

Let `leibniz n = ∑_{i<n} (-1)^i / (2i+1)`.  These partial sums are rational, so
the constant ("depth-0") network with output `4 · leibniz n` is a rational ReLU
network.  We prove:

* `leibniz_error` — the **upper rate** `|π/4 - leibniz n| ≤ 1/(2n+1)`;
* `leibniz_error_lower` — a matching **lower rate**
  `2/((2n+1)(2n+3)) ≤ |π/4 - leibniz n|`;
* `pi_leibniz_error` — `|π - 4·leibniz n| ≤ 4/(2n+1)`;
* `exists_rational_reluNet_near_pi` — the **synthesis**: for every `ε > 0` there is
  a rational ReLU network `f` (a depth-0 `reluNet`) with
  `0 < |f(1) - π| < ε`: arbitrarily close, yet provably never exact.

The lower rate is the *surprising* result.  The mission conjecture claimed
`O(log log(1/ε))` depth / exponentially fast convergence for the Leibniz route;
the lower bound `Ω(1/n²)` shows the Leibniz partial sums converge only
**polynomially**, so this particular route is exponentially too slow — a concrete
falsification of the "logarithmic depth via Leibniz" claim.

-- !-- Lab Notes -- !--
Hypothesis (Hypothesizer): Leibniz partial sums approximate `π/4` at rate
  `Θ(1/n)`; a rational depth-0 network of value `4·leibniz n` therefore
  approximates `π` to any accuracy, refuting "exact" but confirming "arbitrarily
  close" in the rational regime.
Experiment (Experimenter): Mathlib supplies `tendsto_sum_pi_div_four` and the
  alternating-series bracketing lemmas `Antitone.alternating_series_le_tendsto`
  / `Antitone.tendsto_le_alternating_series`.  With `f i = 1/(2i+1)` (antitone,
  `→ 0`) the even/odd partial sums sandwich `π/4`, giving both the upper and the
  two-term lower bound by a single one-step (resp. two-step) telescoping.
Analysis (Analyst): the *upper* bound is `1/(2n+1)` (one omitted term); the
  *lower* bound `2/((2n+1)(2n+3))` (gap between two consecutive omitted terms)
  is `Θ(1/n²)`.  The true rate `Θ(1/n)` lies between; what matters here is that
  even the *lower* bound is polynomial — convergence is provably sub-exponential.
Critique (Critic): the conjecture's "`O(log log(1/ε))` depth via Leibniz" is
  FALSE: `leibniz_error_lower` forces `n = Ω(1/√ε)` terms, hence at least
  polynomially many — never logarithmically many.  The honest statement is
  "rational nets approximate `π` arbitrarily well (Leibniz) but at a polynomial,
  not logarithmic, price, and never exactly (`reluNet_ne_pi`)."
Synthesis (PI): `exists_rational_reluNet_near_pi` packages closeness + the strict
  `0 < |f(1) - π|` impossibility into one Diophantine statement.
-- !-- -- !--
-/

noncomputable section

open Real Filter Finset TropicalReLUBridge

namespace ReLUDiophantine

/-- The `n`-th Leibniz partial sum `∑_{i<n} (-1)^i/(2i+1)`, converging to `π/4`. -/
def leibniz (n : ℕ) : ℝ := ∑ i ∈ Finset.range n, (-1) ^ i / (2 * (i : ℝ) + 1)

/-- Leibniz partial sums are rational points of `ℝ`. -/
theorem leibniz_ratPt (n : ℕ) : RatPt (leibniz n) := by
  refine RatPt.sum _ _ (fun i _ => ?_)
  exact ⟨(-1) ^ i / (2 * (i : ℚ) + 1), by push_cast; ring⟩

theorem leib_alt (n : ℕ) :
    leibniz n = ∑ i ∈ Finset.range n, (-1) ^ i * (1 / (2 * (i : ℝ) + 1)) := by
  simp [leibniz, div_eq_mul_inv]

theorem f_anti : Antitone (fun i : ℕ => 1 / (2 * (i : ℝ) + 1)) := by
  intro a b hab
  have : (a : ℝ) ≤ b := by exact_mod_cast hab
  apply div_le_div_of_nonneg_left (by norm_num) (by positivity) (by linarith)

/-- The Leibniz partial sums converge to `π/4`. -/
theorem leibniz_tendsto : Tendsto leibniz atTop (nhds (π / 4)) := by
  simpa [leibniz] using tendsto_sum_pi_div_four

theorem even_le (k : ℕ) : leibniz (2 * k) ≤ π / 4 := by
  have hfl : Tendsto (fun n ↦ ∑ i ∈ Finset.range n,
      (-1) ^ i * (fun i : ℕ => 1 / (2 * (i : ℝ) + 1)) i) atTop (nhds (π / 4)) := by
    simpa [leib_alt] using leibniz_tendsto
  simpa [leib_alt] using Antitone.alternating_series_le_tendsto hfl f_anti k

theorem le_odd (k : ℕ) : π / 4 ≤ leibniz (2 * k + 1) := by
  have hfl : Tendsto (fun n ↦ ∑ i ∈ Finset.range n,
      (-1) ^ i * (fun i : ℕ => 1 / (2 * (i : ℝ) + 1)) i) atTop (nhds (π / 4)) := by
    simpa [leib_alt] using leibniz_tendsto
  simpa [leib_alt] using Antitone.tendsto_le_alternating_series hfl f_anti k

/-- One Leibniz step: adding the next term `(-1)^n/(2n+1)`. -/
theorem leib_step (n : ℕ) : leibniz (n + 1) = leibniz n + (-1) ^ n / (2 * (n : ℝ) + 1) := by
  simp [leibniz, Finset.sum_range_succ]

/-- **Upper rate.**  The Leibniz partial sum is within one omitted term of `π/4`. -/
theorem leibniz_error (n : ℕ) : |π / 4 - leibniz n| ≤ 1 / (2 * (n : ℝ) + 1) := by
  rcases Nat.even_or_odd n with hev | hod
  · obtain ⟨k, hk⟩ := hev
    have hk2 : n = 2 * k := by omega
    subst hk2
    have h1 := even_le k
    have h2 := le_odd k
    have hstep := leib_step (2 * k)
    have hsign : (-1 : ℝ) ^ (2 * k) = 1 := by rw [pow_mul]; simp
    rw [hsign] at hstep
    rw [abs_le]
    have hpos : (0 : ℝ) < 1 / (2 * ((2 * k : ℕ) : ℝ) + 1) := by positivity
    constructor <;> nlinarith [hstep, h1, h2, hpos]
  · obtain ⟨k, hk⟩ := hod
    have hk2 : n = 2 * k + 1 := by omega
    subst hk2
    have h1 := le_odd k
    have h2 := even_le (k + 1)
    have hstep := leib_step (2 * k + 1)
    have hsign : (-1 : ℝ) ^ (2 * k + 1) = -1 := by rw [pow_succ, pow_mul]; simp
    rw [hsign, neg_div, one_div] at hstep
    have he : 2 * (k + 1) = (2 * k + 1) + 1 := by ring
    rw [he] at h2
    rw [abs_le, one_div]
    have hpos : (0 : ℝ) < (2 * ((2 * k + 1 : ℕ) : ℝ) + 1)⁻¹ := by positivity
    constructor <;> nlinarith [hstep, h1, h2, hpos]

/-- **Lower rate.**  The Leibniz error is at least the gap between two consecutive
omitted terms, `2/((2n+1)(2n+3)) = Θ(1/n²)`.  Hence convergence is polynomial,
never exponential: reaching accuracy `ε` needs `n = Ω(1/√ε)` terms. -/
theorem leibniz_error_lower (n : ℕ) :
    2 / ((2 * (n : ℝ) + 1) * (2 * (n : ℝ) + 3)) ≤ |π / 4 - leibniz n| := by
  rcases Nat.even_or_odd n with hev | hod
  · obtain ⟨k, hk⟩ := hev
    have hk2 : n = 2 * k := by omega
    subst hk2
    have h1 := even_le k
    have h2 := even_le (k + 1)
    have s1 := leib_step (2 * k)
    have s2 := leib_step (2 * k + 1)
    have e1 : (-1 : ℝ) ^ (2 * k) = 1 := by rw [pow_mul]; simp
    have e2 : (-1 : ℝ) ^ (2 * k + 1) = -1 := by rw [pow_succ, pow_mul]; simp
    rw [e1] at s1; rw [e2, neg_div] at s2
    have he : 2 * (k + 1) = (2 * k + 1) + 1 := by ring
    rw [he] at h2
    have c1 : ((2 * k : ℕ) : ℝ) = 2 * (k : ℝ) := by push_cast; ring
    have c2 : ((2 * k + 1 : ℕ) : ℝ) = 2 * (k : ℝ) + 1 := by push_cast; ring
    rw [c1] at s1 ⊢; rw [c2] at s2
    have habs : |π / 4 - leibniz (2 * k)| = π / 4 - leibniz (2 * k) :=
      abs_of_nonneg (by linarith)
    rw [habs]
    have hA : (0 : ℝ) < 2 * (2 * (k : ℝ)) + 1 := by positivity
    have hB : (0 : ℝ) < 2 * (2 * (k : ℝ) + 1) + 1 := by positivity
    have hgap : 1 / (2 * (2 * (k : ℝ)) + 1) - 1 / (2 * (2 * (k : ℝ) + 1) + 1)
        ≤ π / 4 - leibniz (2 * k) := by linarith [s1, s2, h1, h2]
    have heq : 1 / (2 * (2 * (k : ℝ)) + 1) - 1 / (2 * (2 * (k : ℝ) + 1) + 1)
        = 2 / ((2 * (2 * (k : ℝ)) + 1) * (2 * (2 * (k : ℝ)) + 3)) := by
      rw [div_sub_div _ _ (ne_of_gt hA) (ne_of_gt hB),
        div_eq_div_iff (by positivity) (by positivity)]; ring
    rw [heq] at hgap
    convert hgap using 2
  · obtain ⟨k, hk⟩ := hod
    have hk2 : n = 2 * k + 1 := by omega
    subst hk2
    have h1 := le_odd k
    have h2 := le_odd (k + 1)
    have s1 := leib_step (2 * k + 1)
    have s2 := leib_step (2 * k + 1 + 1)
    have e1 : (-1 : ℝ) ^ (2 * k + 1) = -1 := by rw [pow_succ, pow_mul]; simp
    have e2 : (-1 : ℝ) ^ (2 * k + 1 + 1) = 1 := by rw [pow_succ, pow_succ, pow_mul]; simp
    rw [e1, neg_div] at s1; rw [e2] at s2
    have he : 2 * (k + 1) + 1 = (2 * k + 1 + 1) + 1 := by ring
    rw [he] at h2
    have c1 : ((2 * k + 1 : ℕ) : ℝ) = 2 * (k : ℝ) + 1 := by push_cast; ring
    have c2 : ((2 * k + 1 + 1 : ℕ) : ℝ) = 2 * (k : ℝ) + 2 := by push_cast; ring
    rw [c1] at s1 ⊢; rw [c2] at s2
    have habs : |π / 4 - leibniz (2 * k + 1)| = leibniz (2 * k + 1) - π / 4 := by
      rw [abs_of_nonpos (by linarith)]; ring
    rw [habs]
    have hA : (0 : ℝ) < 2 * (2 * (k : ℝ) + 1) + 1 := by positivity
    have hB : (0 : ℝ) < 2 * (2 * (k : ℝ) + 2) + 1 := by positivity
    have hgap : 1 / (2 * (2 * (k : ℝ) + 1) + 1) - 1 / (2 * (2 * (k : ℝ) + 2) + 1)
        ≤ leibniz (2 * k + 1) - π / 4 := by linarith [s1, s2, h1, h2]
    have heq : 1 / (2 * (2 * (k : ℝ) + 1) + 1) - 1 / (2 * (2 * (k : ℝ) + 2) + 1)
        = 2 / ((2 * (2 * (k : ℝ) + 1) + 1) * (2 * (2 * (k : ℝ) + 1) + 3)) := by
      rw [div_sub_div _ _ (ne_of_gt hA) (ne_of_gt hB),
        div_eq_div_iff (by positivity) (by positivity)]; ring
    rw [heq] at hgap
    convert hgap using 2

/-- The four-times Leibniz sum approximates `π` with error `≤ 4/(2n+1)`. -/
theorem pi_leibniz_error (n : ℕ) : |π - 4 * leibniz n| ≤ 4 / (2 * (n : ℝ) + 1) := by
  have h := leibniz_error n
  have e : |π - 4 * leibniz n| = 4 * |π / 4 - leibniz n| := by
    rw [show π - 4 * leibniz n = 4 * (π / 4 - leibniz n) by ring, abs_mul,
      abs_of_pos (show (0:ℝ) < 4 by norm_num)]
  rw [e, show (4:ℝ) / (2 * (n:ℝ) + 1) = 4 * (1 / (2 * (n:ℝ) + 1)) by ring]
  nlinarith [h, abs_nonneg (π / 4 - leibniz n)]

/-- A depth-0 `reluNet` (no hidden units) evaluates to its output bias. -/
theorem reluNet_const (b0 : ℝ) (x : Fin 1 → ℝ) :
    reluNet (d := 1) (n := 0) Fin.elim0 Fin.elim0 Fin.elim0 b0 x = b0 := by
  simp [reluNet]

/-- **Synthesis: Diophantine approximation of `π` by rational ReLU networks.**
For every `ε > 0` there is a rational depth-0 ReLU network `f` whose value at the
input `1` is strictly within `ε` of `π` yet is **never** equal to `π`:
`0 < |f(1) - π| < ε`.  Arbitrarily good approximation, but provably no exact hit. -/
theorem exists_rational_reluNet_near_pi (ε : ℝ) (hε : 0 < ε) :
    ∃ b0 : ℝ, RatPt b0 ∧
      reluNet (d := 1) (n := 0) Fin.elim0 Fin.elim0 Fin.elim0 b0 (fun _ => 1) ≠ Real.pi ∧
      0 < |reluNet (d := 1) (n := 0) Fin.elim0 Fin.elim0 Fin.elim0 b0 (fun _ => 1) - Real.pi| ∧
      |reluNet (d := 1) (n := 0) Fin.elim0 Fin.elim0 Fin.elim0 b0 (fun _ => 1) - Real.pi| < ε := by
  obtain ⟨N, hN⟩ := exists_nat_gt (4 / ε)
  refine ⟨4 * leibniz N, (ratPt_ratCast 4).mul (leibniz_ratPt N), ?_, ?_, ?_⟩
  · rw [reluNet_const]
    exact ((ratPt_ratCast 4).mul (leibniz_ratPt N)).ne_pi
  · rw [reluNet_const]
    have hne : 4 * leibniz N ≠ Real.pi := ((ratPt_ratCast 4).mul (leibniz_ratPt N)).ne_pi
    have : 4 * leibniz N - Real.pi ≠ 0 := sub_ne_zero.mpr hne
    positivity
  · rw [reluNet_const]
    have herr := pi_leibniz_error N
    have hpos : (0 : ℝ) < 2 * (N : ℝ) + 1 := by positivity
    have habs : |4 * leibniz N - Real.pi| = |π - 4 * leibniz N| := by rw [abs_sub_comm]
    rw [habs]
    have hN' : 4 / ε < (N : ℝ) := hN
    have hlt : 4 / (2 * (N : ℝ) + 1) < ε := by
      rw [div_lt_iff₀ hpos]
      have : 4 / ε < (N : ℝ) := hN
      rw [div_lt_iff₀ hε] at this
      nlinarith [this, hε]
    linarith [herr, hlt]

end ReLUDiophantine
