import Mathlib

open Metric

namespace ValuationRipsBridge

variable {X : Type*} [PseudoMetricSpace X]

/-! ### The Vietoris–Rips proximity relation and its simplices -/

/-- The **Vietoris–Rips proximity relation** at scale `r`: two points are
`r`-close when their distance is at most `r`.  The cliques of this relation are
the simplices of the Vietoris–Rips complex `Rips_r(X)`. -/
def ripsRel (r : ℝ) (x y : X) : Prop := dist x y ≤ r

/-- A set `s` is a **Rips simplex** at scale `r` when all of its points are
pairwise `r`-close. -/
def IsRipsSimplex (r : ℝ) (s : Set X) : Prop := ∀ x ∈ s, ∀ y ∈ s, dist x y ≤ r

theorem ripsRel_symm (r : ℝ) {x y : X} (h : ripsRel r x y) : ripsRel r y x := by
  unfold ripsRel at *; rwa [dist_comm]

theorem ripsRel_refl (r : ℝ) (hr : 0 ≤ r) (x : X) : ripsRel r x x := by
  unfold ripsRel; simpa using hr

/-- **The nonarchimedean input.** The strong triangle inequality makes the Rips
proximity relation transitive. -/
theorem ripsRel_trans [IsUltrametricDist X] (r : ℝ) {x y z : X}
    (hxy : ripsRel r x y) (hyz : ripsRel r y z) : ripsRel r x z := by
  unfold ripsRel at *
  calc dist x z ≤ max (dist x y) (dist y z) := IsUltrametricDist.dist_triangle_max x y z
    _ ≤ r := max_le hxy hyz

/-- For `r ≥ 0`, the Rips proximity relation of an ultrametric space is an
**equivalence relation**.  Its classes are the connected components / clusters of
`Rips_r(X)`. -/
def ripsEquivalence [IsUltrametricDist X] (r : ℝ) (hr : 0 ≤ r) :
    Equivalence (ripsRel (X := X) r) where
  refl := ripsRel_refl r hr
  symm := ripsRel_symm r
  trans := ripsRel_trans r

/-- The setoid (partition of `X` into clusters) induced at scale `r`. -/
def ripsSetoid [IsUltrametricDist X] (r : ℝ) (hr : 0 ≤ r) : Setoid X where
  r := ripsRel r
  iseqv := ripsEquivalence r hr

/-! ### Chains collapse to edges: the Rips graph is a disjoint union of cliques -/

/-- **Cliques out of chains.** In an ultrametric space a Rips *path* (a finite
chain of `r`-close steps) between two points is already a single Rips *edge*.
Equivalently, the reflexive–transitive closure of the proximity relation equals
the relation itself: `Rips_r(X)` is a disjoint union of cliques. -/
theorem rips_chain_closed [IsUltrametricDist X] (r : ℝ) (hr : 0 ≤ r) {x z : X}
    (h : Relation.ReflTransGen (ripsRel r) x z) : ripsRel r x z := by
  induction h with
  | refl => exact ripsRel_refl r hr x
  | tail _ hbc ih => exact ripsRel_trans r ih hbc

/-- The reflexive–transitive closure of `ripsRel r` *coincides* with `ripsRel r`
(for `r ≥ 0`, ultrametric): being path-connected at scale `r` is the same as
being directly `r`-close. -/
theorem reflTransGen_ripsRel_eq [IsUltrametricDist X] (r : ℝ) (hr : 0 ≤ r) :
    Relation.ReflTransGen (ripsRel (X := X) r) = ripsRel r := by
  ext x z
  constructor
  · exact rips_chain_closed r hr
  · exact fun h => Relation.ReflTransGen.single h

/-! ### Connected components are full simplices -/

/-- Every closed `r`-ball is a Rips simplex: an ultrametric ball is a clique. -/
theorem ball_isRipsSimplex [IsUltrametricDist X] (r : ℝ) (c : X) :
    IsRipsSimplex r (Metric.closedBall c r) := by
  intro x hx y hy
  rw [Metric.mem_closedBall] at hx hy
  calc dist x y ≤ max (dist x c) (dist c y) := IsUltrametricDist.dist_triangle_max x c y
    _ ≤ r := by
        refine max_le hx ?_
        rwa [dist_comm]

/-- Every cluster (equivalence class of the proximity relation) is a full Rips
simplex.  Combined with `rips_chain_closed`, this says the maximal simplices of
`Rips_r(X)` partition `X`. -/
theorem class_isRipsSimplex [IsUltrametricDist X] (r : ℝ) (c : X) :
    IsRipsSimplex r {x | ripsRel r c x} := by
  intro x hx y hy
  exact ripsRel_trans r (ripsRel_symm r hx) hy

/-! ### Filtration monotonicity: the Rips filtration is a dendrogram -/

/-- The proximity relation only grows with the scale: clusters merge as `r`
increases. -/
theorem ripsRel_mono {r r' : ℝ} (hr : r ≤ r') {x y : X} (h : ripsRel r x y) :
    ripsRel r' x y := le_trans h hr

/-- Rips simplices persist under increasing the scale (filtration property). -/
theorem IsRipsSimplex.mono {r r' : ℝ} (hr : r ≤ r') {s : Set X}
    (h : IsRipsSimplex r s) : IsRipsSimplex r' s :=
  fun x hx y hy => le_trans (h x hx y hy) hr

/-! ### Isosceles geometry of ultrametric (valuation) triangles -/

/-- **Isosceles triangle inequality.** If one side of a triangle is strictly
shorter than another, the remaining side equals the longer one. Every ultrametric
triangle is isosceles, with its two longest sides equal. -/
theorem ultrametric_isosceles [IsUltrametricDist X] (x y z : X)
    (h : dist x y < dist y z) : dist x z = dist y z := by
  have h1 : dist x z ≤ max (dist x y) (dist y z) := IsUltrametricDist.dist_triangle_max x y z
  have h2 : dist y z ≤ max (dist y x) (dist x z) := IsUltrametricDist.dist_triangle_max y x z
  rw [dist_comm y x] at h2
  rw [max_eq_right (le_of_lt h)] at h1
  have hle : dist y z ≤ dist x z := by
    rcases le_max_iff.mp h2 with h3 | h3
    · linarith
    · exact h3
  linarith

/-- Among the three pairwise distances of any ultrametric triangle, the maximum
is attained by at least two of the sides. -/
theorem ultrametric_max_dist_twice [IsUltrametricDist X] (x y z : X) :
    dist x y = dist y z ∨ dist y z = dist x z ∨ dist x z = dist x y := by
  rcases lt_trichotomy (dist x y) (dist y z) with h | h | h
  · exact Or.inr (Or.inl (ultrametric_isosceles x y z h).symm)
  · exact Or.inl h
  · -- dist y z < dist x y  ⇒  the third side equals the longest
    have := ultrametric_isosceles z y x (by rwa [dist_comm z y, dist_comm y x])
    rw [dist_comm z x, dist_comm y x] at this
    exact Or.inr (Or.inr this)

/-! ### Main bridge theorem -/

/-- **Valuation–Rips structure theorem.** For an ultrametric (non-Archimedean
valuation) space and any scale `r ≥ 0`:

1. the Rips proximity relation is an equivalence relation;
2. being path-connected at scale `r` is the same as being a single Rips edge
   (chains collapse to edges);
3. every cluster is a full Rips simplex.

Hence `Rips_r(X)` is a disjoint union of simplices indexed by the clusters. -/
theorem valuation_rips_structure [IsUltrametricDist X] (r : ℝ) (hr : 0 ≤ r) :
    Equivalence (ripsRel (X := X) r) ∧
    (Relation.ReflTransGen (ripsRel (X := X) r) = ripsRel r) ∧
    (∀ c : X, IsRipsSimplex r {x | ripsRel r c x}) :=
  ⟨ripsEquivalence r hr, reflTransGen_ripsRel_eq r hr, fun c => class_isRipsSimplex r c⟩

/-! ### Worked example: the `p`-adic integers `ℤ_[p]`

The metric on `ℤ_[p]` comes from the `p`-adic valuation, so it is ultrametric;
the structure theory above applies verbatim. -/

section PadicExample

variable (p : ℕ) [Fact p.Prime]

example (r : ℝ) (x y z : ℤ_[p]) (hxy : ripsRel r x y) (hyz : ripsRel r y z) :
    ripsRel r x z := ripsRel_trans r hxy hyz

example (r : ℝ) (hr : 0 ≤ r) (x z : ℤ_[p])
    (h : Relation.ReflTransGen (ripsRel r) x z) : dist x z ≤ r :=
  rips_chain_closed r hr h

example (r : ℝ) (c : ℤ_[p]) : IsRipsSimplex r (Metric.closedBall c r) :=
  ball_isRipsSimplex r c

example (r : ℝ) (hr : 0 ≤ r) :
    Equivalence (ripsRel (X := ℤ_[p]) r) ∧
    (Relation.ReflTransGen (ripsRel (X := ℤ_[p]) r) = ripsRel r) ∧
    (∀ c : ℤ_[p], IsRipsSimplex r {x | ripsRel r c x}) :=
  valuation_rips_structure r hr

end PadicExample

end ValuationRipsBridge
