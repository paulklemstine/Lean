\section{Introduction}

The Fibonacci sequence is defined by $\F(0)=0$, $\F(1)=1$, and the recurrence
$\F(n+2)=\F(n+1)+\F(n)$. Despite its elementary definition, its multiplicative
structure is subtle. This paper concerns the distribution of \emph{new} primes
across the sequence.

\begin{definition}[Primitive prime divisor]
A prime $p$ is a \emph{primitive prime divisor} of $\F(n)$ if $p \mid \F(n)$ and
$p \nmid \F(k)$ for every $k$ with $0 < k < n$.
\end{definition}

\begin{theorem}[Carmichael, 1913]
For every $n \notin \{1,2,6,12\}$, the Fibonacci number $\F(n)$ has a primitive
prime divisor.
\end{theorem}

The exceptional set is genuine and sharp:
\begin{itemize}[nosep]
  \item $\F(1)=\F(2)=1$ have no prime factors;
  \item $\F(6)=8=2^3$, whose only prime $2$ already divides $\F(3)=2$;
  \item $\F(12)=144=2^4\cdot 3^2$, whose primes $2,3$ already divide $\F(3)$ and
    $\F(4)=3$.
\end{itemize}
Thus $13$ is the sharp threshold: for every $n \ge 13$, $\F(n)$ has a primitive
prime divisor.

\subsection{Contributions}
We give a self-contained, mechanically verified proof of the following.

\begin{theorem}[Main, verified]\label{thm:main}
For every $n$ with $13 \le n \le 10000$, $\F(n)$ has a primitive prime divisor.
\end{theorem}

The proof is built from: (1) an unconditional prime-index theorem
(Theorem~\ref{thm:prime}); (2) a verified primitive-part algorithm
(Section~\ref{sec:composite}); and (3) an exhaustive range certificate
(Theorem~\ref{thm:range}). We deliberately do not assert the unbounded composite
tail $n > 10000$, which is the deep analytic core of Carmichael's theorem;
Section~\ref{sec:future} isolates the exact missing ingredient.

\subsection{Why two regimes}
The prime case admits a short structural proof because the only proper divisor of
a prime is $1$, and $\F(1)=1$ has no prime factors, collapsing the primitivity
check to a single contradiction. Composite indices have many proper divisors
contributing irregular inherited primes; the imprimitive part has no clean closed
form, so a computational certificate is the most direct route over a finite range.
Keeping the prime case separate yields both a shorter proof and a stronger
conclusion (every prime factor is primitive, not merely one).

\section{The strong-divisibility foundation}

\begin{lemma}[Fibonacci GCD identity]\label{lem:fibgcd}
For all $m,n$, $\gcdop(\F(m),\F(n)) = \F(\gcdop(m,n))$.
\end{lemma}

\begin{remark}
In the formal development this is Mathlib's \texttt{Nat.fib\_gcd}. It expresses
that the Fibonacci map is a \emph{strong divisibility sequence}.
\end{remark}

\begin{lemma}[Strong divisibility]\label{lem:strongdvd}
If a number $p$ divides both $\F(n)$ and $\F(k)$, then $p \mid \F(\gcdop(n,k))$.
\end{lemma}
\begin{proof}
From $p \mid \F(n)$ and $p \mid \F(k)$ we get $p \mid \gcdop(\F(n),\F(k))$. By
Lemma~\ref{lem:fibgcd}, $\gcdop(\F(n),\F(k)) = \F(\gcdop(n,k))$, hence
$p \mid \F(\gcdop(n,k))$.
\end{proof}

\begin{lemma}[Positivity of value]\label{lem:pos}
For $n \ge 3$, $\F(n) > 1$.
\end{lemma}
\begin{proof}
Direct for $n=3$ ($\F(3)=2$). For $n\ge 4$, $\F(n)=\F(n-1)+\F(n-2)$ with both
summands positive and at least one exceeding $1$; induct.
\end{proof}

\begin{lemma}[Bridge lemma]\label{lem:bridge}
Let $0 < n$ and $p \mid \F(n)$. Suppose for every proper divisor $d \mid n$ with
$0 < d < n$ we have $p \nmid \F(d)$. Then for every $k$ with $0 < k < n$,
$p \nmid \F(k)$.
\end{lemma}
\begin{proof}
Suppose $p \mid \F(k)$ for some $0 < k < n$. By Lemma~\ref{lem:strongdvd},
$p \mid \F(\gcdop(n,k))$. Now $\gcdop(n,k)$ is positive, divides $n$, and
satisfies $\gcdop(n,k) \le k < n$. Thus it is a proper divisor of $n$ with
$p \mid \F(\gcdop(n,k))$, contradicting the hypothesis.
\end{proof}

Lemma~\ref{lem:bridge} reduces primitivity (a statement about all $0<k<n$) to a
finite condition over the proper divisors of $n$.

\section{The prime-index theorem (unconditional)}

\begin{lemma}\label{lem:primediv}
If $n$ is prime and $d \mid n$ with $0 < d < n$, then $d = 1$.
\end{lemma}

\begin{theorem}[Prime-index Carmichael]\label{thm:prime}
For every prime $n \ge 3$ there exists a prime $p$ with $p \mid \F(n)$ and
$p \nmid \F(k)$ for all $0 < k < n$. Moreover, \emph{every} prime factor of
$\F(n)$ has this property.
\end{theorem}
\begin{proof}
By Lemma~\ref{lem:pos}, $\F(n) > 1$, so $\F(n)$ has a least prime factor
$p = \minFac(\F(n))$. Let $0 < k < n$ and suppose $p \mid \F(k)$. By
Lemma~\ref{lem:strongdvd}, $p \mid \F(\gcdop(n,k))$. Since $n$ is prime and
$\gcdop(n,k) \le k < n$, Lemma~\ref{lem:primediv} gives $\gcdop(n,k)=1$. Then
$p \mid \F(1) = 1$, impossible. Hence $p \nmid \F(k)$. The argument used only
$p \mid \F(n)$ and the primality of $p$, so it applies to any prime factor of
$\F(n)$.
\end{proof}

\section{The composite-index certificate}\label{sec:composite}

\begin{definition}[Entry point]
The \emph{entry point} $z(p)$ of a prime $p$ is the least $m > 0$ with
$p \mid \F(m)$. Then $p$ is primitive for $\F(n)$ iff $z(p) = n$.
\end{definition}

\begin{definition}[Proper divisors]
$\propDivs(n)$ is the list of $d$ with $0 < d < n$ and $d \mid n$.
\end{definition}

\begin{definition}[Stripping routine]
For residue $r$, modulus $m$, and fuel $t \in \mathbb{N}$,
\[
\stripAux(r,m,0)=r,\qquad
\stripAux(r,m,t+1)=
\begin{cases}
r & \text{if } m \le 1,\\
r & \text{if } \gcdop(r,m) \le 1,\\
\stripAux\!\left(r/\gcdop(r,m),\,m,\,t\right) & \text{otherwise.}
\end{cases}
\]
Calling with $t = r$ always suffices, since each non-trivial step strictly
decreases $r$.
\end{definition}

\begin{definition}[Primitive part]
\[
\primPart(n) = \operatorname{foldl}\bigl(\lambda\,r\,d.\ \stripAux(r,\F(d),r)\bigr)\ \F(n)\ \propDivs(n).
\]
\end{definition}

\begin{lemma}[Divisibility]\label{lem:divis}
$\stripAux(r,m,t) \mid r$, and consequently $\primPart(n) \mid \F(n)$.
\end{lemma}
\begin{proof}
Induct on $t$. In the recursive branch, $\stripAux(r/g,m,t-1) \mid r/g$ by
induction and $r/g \mid r$ since $g=\gcdop(r,m) \mid r$; compose. The fold
statement follows by list induction.
\end{proof}

\begin{lemma}[Coprimality]\label{lem:coprime}
If $m>1$, $r>0$, and $t \ge r$, then $\gcdop(\stripAux(r,m,t),m)=1$. Consequently
$\primPart(n)$ is coprime to $\F(d)$ for every $d \in \propDivs(n)$.
\end{lemma}
\begin{proof}
Induct on $t$. If $\gcdop(r,m)=1$ we are done. If $\gcdop(r,m)>1$, then
$r/\gcdop(r,m) > 0$ and the fuel bound is preserved, so the inductive hypothesis
applies. The fold-level statement follows by reverse list induction, using
Lemma~\ref{lem:divis} so that coprimality survives subsequent strips. The
degenerate cases $\F(d) \le 1$ (at $d\in\{1,2\}$) are handled directly.
\end{proof}

\begin{theorem}[Primitive-part certificate]\label{thm:cert}
For $n \ge 3$, if $\primPart(n) > 1$ then $\F(n)$ has a primitive prime divisor;
explicitly, $p = \minFac(\primPart(n))$ is one.
\end{theorem}
\begin{proof}
Let $p = \minFac(\primPart(n))$, a prime since $\primPart(n)>1$. By
Lemma~\ref{lem:divis}, $p \mid \primPart(n) \mid \F(n)$. For primitivity, by
Lemma~\ref{lem:bridge} it suffices that $p \nmid \F(d)$ for every proper divisor
$d \mid n$. Such $d \in \propDivs(n)$, and by Lemma~\ref{lem:coprime},
$\gcdop(\primPart(n),\F(d))=1$. Since $p \mid \primPart(n)$, $p \mid \F(d)$ would
force $p \mid 1$, a contradiction. Hence $p \nmid \F(d)$, and
Lemma~\ref{lem:bridge} concludes.
\end{proof}

\begin{remark}[Exceptionality]
The certificate vanishes exactly on the exceptional indices: $\primPart(6)=1$
(since $\F(3)=2$ strips all of $\F(6)=8$) and $\primPart(12)=1$ (since
$\F(3),\F(4),\F(6)$ consume $\F(12)=144$). For $n\in\{1,2\}$, $\F(n)=1$. This is
the computational manifestation of sharpness.
\end{remark}

\section{The range certificate and main theorem}

\begin{theorem}[Range certificate]\label{thm:range}
For every $n$ with $13 \le n \le 10000$, either $n$ is prime or $\primPart(n) > 1$.
\end{theorem}
\begin{proof}
A decidable proposition over the finite set $\{13,\dots,10000\}$; each instance
reduces to integer arithmetic on $\gcd$, division, and $\F$. Discharged by
kernel-checked evaluation.
\end{proof}

\begin{theorem}[Composite case, verified range]\label{thm:comp}
For composite $n$ with $13 \le n \le 10000$, $\F(n)$ has a primitive prime divisor.
\end{theorem}
\begin{proof}
By Theorem~\ref{thm:range} and $\neg\,\mathrm{Prime}(n)$, $\primPart(n) > 1$;
apply Theorem~\ref{thm:cert}.
\end{proof}

\begin{proof}[Proof of Theorem~\ref{thm:main}]
If $n$ is prime, apply Theorem~\ref{thm:prime}. If $n$ is composite, apply
Theorem~\ref{thm:comp}.
\end{proof}

\section{Algorithms}

\paragraph{Primitive-part computation.}
\begin{verbatim}
PRIMPART(n):
  r <- F(n)
  for d in proper_divisors(n):        # 0 < d < n, d | n
      m <- F(d)
      if m > 1:
          loop:
              g <- gcd(r, m)
              if g == 1: break
              r <- r / g
  return r
\end{verbatim}
Correctness: Lemmas~\ref{lem:divis} and~\ref{lem:coprime}. With $D(n)$ proper
divisors and $O(n)$-bit values, each gcd costs $O(n^2/w)$ word operations, so
$\primPart$ is polynomial in $n$.

\paragraph{Witness extraction.}
\begin{verbatim}
WITNESS(n):                           # n >= 13
  if is_prime(n): return min_prime_factor(F(n))   # Theorem 3.2
  pp <- PRIMPART(n); assert pp > 1                # Theorem 4.6
  return min_prime_factor(pp)
\end{verbatim}

\section{Discussion and future work}\label{sec:future}

\begin{conjecture}[Fibonacci Lifting-the-Exponent, priority]
Let $p$ be an odd prime with entry point $z(p)=m$. Then for all $k \ge 1$,
$\vp_p(\F(mk)) = \vp_p(\F(m)) + \vp_p(k)$. Combined with $\F(n) \ge \varphi^{n-2}$,
this controls the imprimitive part of $\F(n)$ and removes the range cap.
\end{conjecture}

\begin{conjecture}[Primitive part dominates the index]
Let $\Phi(n) = \prod_{d \mid n} \F(d)^{\mu(n/d)}$. Then $\Phi(n) > n$ for every
$n \ge 13$, yielding the full theorem in one stroke; the bound fails exactly inside
$\{1,2,6,12\}$.
\end{conjecture}

\begin{conjecture}[Entry point divides $p-(5\mid p)$]
For a prime $p \ne 5$, $z(p) \mid p - \left(\tfrac{5}{p}\right)$, giving
$z(p) \le p+1$.
\end{conjecture}

\begin{conjecture}[Lucas analogue]
The Lucas numbers ($L(0)=2$, $L(1)=1$, $L(n+2)=L(n+1)+L(n)$) have a primitive
prime divisor for every $n \notin \{1,6\}$.
\end{conjecture}

These sit inside the broader Bilu--Hanrot--Voutier program (2001), which
classifies the exceptional indices for all Lucas and Lehmer sequences.
Carmichael's Fibonacci theorem is the gateway instance, and the verified
scaffolding here is the apparatus on which a formal proof of the tail would build.

\section{Conclusion}
We have given a self-contained, machine-verified proof of Carmichael's Fibonacci
primitive-divisor theorem on $13 \le n \le 10000$, with an unconditional
structural proof at all prime indices. The architecture separates a
computation-free prime case from a certificate-driven composite case, both founded
on the single strong-divisibility identity
$\gcdop(\F(m),\F(n))=\F(\gcdop(m,n))$. The sharp threshold $13$ and the exceptional
set $\{1,2,6,12\}$ emerge transparently from the vanishing of the primitive-part
certificate.

