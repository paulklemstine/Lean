/-
# The Boltzmann Bridge — Affine Functoriality of the Geodesic Pullback

This short, self-contained file isolates the *affine functoriality* facts that are
already latent in the filtration API:

* the contravariant pullback `pullback f : Filtration β → Filtration α`
  (`Applications.BoltzmannBridge.InterleavingFunctor`), whose weight is the affine
  reindexing `σ ↦ F.weight (σ.image f)`, and
* the convex-interpolation geodesic `lerp F G t` with weight
  `σ ↦ (1 − t)·F.weight σ + t·G.weight σ`
  (`Applications.BoltzmannBridge.InterleavingGeodesic`).

Because `pullback f` acts on weights by an affine reindexing, it commutes with the
affine `lerp`.  This is proved here by extensionality on weights and simplification
with the already verified weight-level lemmas `pullback_weight` and `lerp_weight`.
The corresponding path-transport (geodesic) identity follows immediately from the
constant-speed law `eInterleavingDist_lerp`, and, for surjective vertex maps, the
distance between pulled-back geodesic points agrees with the original distance via
`eInterleavingDist_pullback_eq_of_surjective`.

## Main results

* `pullback_lerp` — pullback commutes with the geodesic interpolation.
* `eInterleavingDist_pullback_lerp` — the transported geodesic obeys the same
  constant-speed law between the pulled-back endpoints.
* `eInterleavingDist_pullback_lerp_eq_of_surjective` — for surjective `f`, the
  distance between pulled-back geodesic points equals the original distance.
-/
import Mathlib
import Applications.BoltzmannBridge.InterleavingFunctor
import Applications.BoltzmannBridge.InterleavingGeodesic

open Finset BigOperators
open scoped ENNReal

namespace BoltzmannBridge

namespace Filtration

variable {α β : Type*}

/-- **Pullback commutes with the geodesic interpolation.**  Because `pullback f`
acts on weights by the affine reindexing `σ ↦ σ.image f`, it sends the convex
interpolation `lerp F G t` to the convex interpolation of the pullbacks.  Proved by
extensionality on weights, where both sides equal
`σ ↦ (1 − t)·F.weight (σ.image f) + t·G.weight (σ.image f)`. -/
theorem pullback_lerp [DecidableEq β] (f : α → β) (F G : Filtration β) {t : ℝ}
    (ht0 : 0 ≤ t) (ht1 : t ≤ 1) :
    pullback f (lerp F G t ht0 ht1)
      = lerp (pullback f F) (pullback f G) t ht0 ht1 := by
  apply ext_weight; funext σ; simp [lerp_weight]

/-- **Functorial transport is a path-level isometry.**  The pullback of the
`F`–`G` geodesic is *exactly* the constant-speed geodesic between `pullback f F`
and `pullback f G`, so the transported points obey the same constant-speed law.
A direct corollary of `pullback_lerp` and the geodesic identity
`eInterleavingDist_lerp`. -/
theorem eInterleavingDist_pullback_lerp [DecidableEq β] (f : α → β)
    (F G : Filtration β) {s t : ℝ}
    (hs0 : 0 ≤ s) (hs1 : s ≤ 1) (ht0 : 0 ≤ t) (ht1 : t ≤ 1) :
    eInterleavingDist (pullback f (lerp F G s hs0 hs1))
        (pullback f (lerp F G t ht0 ht1))
      = ENNReal.ofReal |s - t|
          * eInterleavingDist (pullback f F) (pullback f G) := by
  rw [pullback_lerp, pullback_lerp, eInterleavingDist_lerp]

/-- **Pullback along a surjection preserves geodesic-point distances.**  When `f`
is surjective the pullback is an isometry (`eInterleavingDist_pullback_eq_of_surjective`),
so the distance between any two pulled-back geodesic points equals the distance
between the geodesic points themselves.  A short wrapper instantiating the
surjective pullback isometry at the two `lerp` filtrations. -/
theorem eInterleavingDist_pullback_lerp_eq_of_surjective [DecidableEq α]
    [DecidableEq β] (f : α → β) (hf : Function.Surjective f) (F G : Filtration β)
    {s t : ℝ} (hs0 : 0 ≤ s) (hs1 : s ≤ 1) (ht0 : 0 ≤ t) (ht1 : t ≤ 1) :
    eInterleavingDist (pullback f (lerp F G s hs0 hs1))
        (pullback f (lerp F G t ht0 ht1))
      = eInterleavingDist (lerp F G s hs0 hs1) (lerp F G t ht0 ht1) :=
  eInterleavingDist_pullback_eq_of_surjective f hf _ _

end Filtration

end BoltzmannBridge
