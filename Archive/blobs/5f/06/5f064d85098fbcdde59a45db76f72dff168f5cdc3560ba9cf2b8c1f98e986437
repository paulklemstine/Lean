import Mathlib

/-!
# Ladder density between consecutive power systems

This file develops a small, self-contained instance of the
*simulation-degree* framework for proof complexity and proves a **density**
result: between two consecutive rungs of the polynomial ladder
`powSystem k` and `powSystem (k+1)` there sits a strictly intermediate
degree.

A *system* is identified with its **size profile** `profile : ℕ → ℕ`, the
resource cost of handling inputs of size `n`.  One profile `g`
**dominates** another `f` (written `Dominates g f`) when `f` is bounded by
`g` up to a single multiplicative-and-additive constant; this is the
quantitative ("p-simulation"-style) relation that organizes systems by
strength.  The relation is a preorder, and `SizeSys` is endowed with the
corresponding simulation-degree order `≤` (where `S ≤ T` means `T`
simulates `S`).

The power ladder is `powSystem k = sysOfSize (n ↦ n ^ k)`.  The intermediate
system is obtained by **parity gluing**:

```
interPowProfile k n = if n % 2 = 0 then n ^ (k+1) else n ^ k
```

so the profile grows like `n ^ (k+1)` on the even residue class and like
`n ^ k` on the odd one.  Each residue class separately witnesses a failure
of simulation in *opposite* directions, which is exactly what turns a single
growth-gap theorem into a full density statement.

## Key results

* `pow_succ_gap_pointwise` / `pow_succ_gap_even` / `pow_succ_gap_odd`:
  the strengthened growth-gap lemma with parity-controlled witnesses — for
  every constant `C` there are arbitrarily large numbers of a prescribed
  parity at which `n ^ (k+1)` exceeds `C * n ^ k + C`.
* `simulates_sysOfSize_iff`: simulation of `sysOfSize` systems is exactly
  domination of profiles.
* `powSystem_lt_interPow`: `powSystem k < interPowSys k` for `k ≥ 1`.
* `interPow_lt_powSystem_succ`: `interPowSys k < powSystem (k+1)` for `k ≥ 1`.
* `exists_strictly_between_powSystem`: for `k ≥ 1` there is a degree strictly
  between consecutive ladder rungs.
-/

namespace LadderDensity

/-! ## The domination preorder on size profiles -/

/-- `Dominates g f`: the profile `g` grows at least as fast as `f`, up to a
single multiplicative-and-additive constant.  This is the quantitative
simulation relation between size profiles. -/
def Dominates (g f : ℕ → ℕ) : Prop := ∃ C, ∀ n, f n ≤ C * g n + C

/-- Domination is reflexive. -/
theorem Dominates.refl (f : ℕ → ℕ) : Dominates f f :=
  ⟨1, fun n => by omega⟩

/-- Domination is transitive: the constants compose into a single constant. -/
theorem Dominates.trans {f g h : ℕ → ℕ}
    (h₁ : Dominates h g) (h₂ : Dominates g f) : Dominates h f := by
  obtain ⟨A, hA⟩ := h₁
  obtain ⟨B, hB⟩ := h₂
  refine ⟨A * B + B, fun n => ?_⟩
  have e1 := hA n
  have e2 := hB n
  have e3 : B * g n ≤ B * (A * h n + A) := by gcongr
  nlinarith [e2, e3, Nat.zero_le (B * h n)]

/-! ## A growth-gap lemma with parity-controlled witnesses -/

/-- For `k ≥ 1`, the profile `n ↦ n ^ k` is pointwise below `n ↦ n ^ (k+1)`. -/
theorem pow_le_pow_succ {k : ℕ} (hk : 1 ≤ k) (n : ℕ) : n ^ k ≤ n ^ (k + 1) := by
  rcases Nat.eq_zero_or_pos n with h | h
  · subst h
    obtain ⟨k', rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
    simp [pow_succ]
  · exact Nat.pow_le_pow_right (by omega) (by omega)

/-- **Growth gap.**  For `k ≥ 1` and any constant `C`, whenever `n ≥ C + 2`
the value `n ^ (k+1)` strictly exceeds `C * n ^ k + C`.  This is the
pointwise engine behind the parity-controlled witnesses below. -/
theorem pow_succ_gap_pointwise {k : ℕ} (hk : 1 ≤ k) (C n : ℕ) (hn : C + 2 ≤ n) :
    C * n ^ k + C < n ^ (k + 1) := by
  have h2 : n ≤ n ^ k := by
    calc n = n ^ 1 := (pow_one n).symm
      _ ≤ n ^ k := Nat.pow_le_pow_right (by omega) hk
  have hps : n ^ (k + 1) = n ^ k * n := pow_succ n k
  have key : n ^ k * (C + 2) ≤ n ^ k * n := by gcongr
  have expand : n ^ k * (C + 2) = C * n ^ k + 2 * n ^ k := by ring
  have hge : C + 2 ≤ n ^ k := le_trans hn h2
  rw [hps]
  omega

/-- **Parity-controlled growth gap (even).**  For every constant `C` there is
an even `n` at which `n ^ (k+1)` exceeds `C * n ^ k + C`.  Since `2 * (C + 2)`
can be taken arbitrarily large, this provides arbitrarily large even
witnesses. -/
theorem pow_succ_gap_even {k : ℕ} (hk : 1 ≤ k) (C : ℕ) :
    ∃ n, n % 2 = 0 ∧ C * n ^ k + C < n ^ (k + 1) :=
  ⟨2 * (C + 2), by omega, pow_succ_gap_pointwise hk C _ (by omega)⟩

/-- **Parity-controlled growth gap (odd).**  For every constant `C` there is
an odd `n` at which `n ^ (k+1)` exceeds `C * n ^ k + C`, with arbitrarily
large odd witnesses. -/
theorem pow_succ_gap_odd {k : ℕ} (hk : 1 ≤ k) (C : ℕ) :
    ∃ n, n % 2 = 1 ∧ C * n ^ k + C < n ^ (k + 1) :=
  ⟨2 * (C + 2) + 1, by omega, pow_succ_gap_pointwise hk C _ (by omega)⟩

/-! ## The parity-glued intermediate profile -/

/-- The intermediate profile obtained by **parity gluing**: it grows like
`n ^ (k+1)` on even inputs and like `n ^ k` on odd inputs. -/
def interPowProfile (k : ℕ) (n : ℕ) : ℕ :=
  if n % 2 = 0 then n ^ (k + 1) else n ^ k

/-- The glued profile is pointwise above `n ↦ n ^ k`. -/
theorem powk_le_interPow {k : ℕ} (hk : 1 ≤ k) (n : ℕ) :
    n ^ k ≤ interPowProfile k n := by
  unfold interPowProfile
  split
  · exact pow_le_pow_succ hk n
  · exact le_refl _

/-- The glued profile is pointwise below `n ↦ n ^ (k+1)`. -/
theorem interPow_le_powSucc {k : ℕ} (hk : 1 ≤ k) (n : ℕ) :
    interPowProfile k n ≤ n ^ (k + 1) := by
  unfold interPowProfile
  split
  · exact le_refl _
  · exact pow_le_pow_succ hk n

/-! ## Domination facts witnessing the strict inequalities -/

/-- The intermediate profile dominates `n ↦ n ^ k`. -/
theorem interPow_dom_powk {k : ℕ} (hk : 1 ≤ k) :
    Dominates (interPowProfile k) (fun n => n ^ k) :=
  ⟨1, fun n => by
    have hl := powk_le_interPow hk n
    show n ^ k ≤ 1 * interPowProfile k n + 1
    omega⟩

/-- The profile `n ↦ n ^ (k+1)` dominates the intermediate profile. -/
theorem powSucc_dom_interPow {k : ℕ} (hk : 1 ≤ k) :
    Dominates (fun n => n ^ (k + 1)) (interPowProfile k) :=
  ⟨1, fun n => by
    have hu := interPow_le_powSucc hk n
    show interPowProfile k n ≤ 1 * n ^ (k + 1) + 1
    omega⟩

/-- `n ↦ n ^ k` does **not** dominate the intermediate profile: the even
residue class, where the profile grows like `n ^ (k+1)`, defeats every
constant. -/
theorem not_powk_dom_interPow {k : ℕ} (hk : 1 ≤ k) :
    ¬ Dominates (fun n => n ^ k) (interPowProfile k) := by
  rintro ⟨C, hC⟩
  obtain ⟨n, hpar, hgap⟩ := pow_succ_gap_even hk C
  have hval : interPowProfile k n = n ^ (k + 1) := by
    simp [interPowProfile, hpar]
  have hle := hC n
  rw [hval] at hle
  dsimp only at hle
  omega

/-- The intermediate profile does **not** dominate `n ↦ n ^ (k+1)`: the odd
residue class, where the profile grows only like `n ^ k`, defeats every
constant. -/
theorem not_interPow_dom_powSucc {k : ℕ} (hk : 1 ≤ k) :
    ¬ Dominates (interPowProfile k) (fun n => n ^ (k + 1)) := by
  rintro ⟨C, hC⟩
  obtain ⟨n, hpar, hgap⟩ := pow_succ_gap_odd hk C
  have hval : interPowProfile k n = n ^ k := by
    have hc : ¬ (n % 2 = 0) := by omega
    simp [interPowProfile, hc]
  have hle := hC n
  rw [hval] at hle
  dsimp only at hle
  omega

/-! ## Systems and the simulation-degree order -/

/-- A proof system in the simulation-degree framework, identified with its
size profile. -/
structure SizeSys where
  /-- The resource cost (size profile) of the system. -/
  profile : ℕ → ℕ

/-- The system determined by a given size profile. -/
def sysOfSize (f : ℕ → ℕ) : SizeSys := ⟨f⟩

/-- `S` **simulates** `T` when `S`'s profile dominates `T`'s profile. -/
def Simulates (S T : SizeSys) : Prop := Dominates S.profile T.profile

/-- Simulation between `sysOfSize` systems is exactly domination of their
profiles. -/
theorem simulates_sysOfSize_iff (f g : ℕ → ℕ) :
    Simulates (sysOfSize f) (sysOfSize g) ↔ Dominates f g := Iff.rfl

/-- The simulation-degree order: `S ≤ T` means `T` simulates `S` (`T` is at
least as strong as `S`).  `Dominates` being a preorder makes this a genuine
preorder, and `<` is the induced strict order. -/
instance : Preorder SizeSys where
  le S T := Dominates T.profile S.profile
  le_refl S := Dominates.refl S.profile
  le_trans _ _ _ hST hTU := Dominates.trans hTU hST

/-! ## The power ladder and its density -/

/-- The `k`-th rung of the polynomial ladder: the system with profile
`n ↦ n ^ k`. -/
def powSystem (k : ℕ) : SizeSys := sysOfSize (fun n => n ^ k)

/-- The parity-glued intermediate system sitting between `powSystem k` and
`powSystem (k+1)`. -/
def interPowSys (k : ℕ) : SizeSys := sysOfSize (interPowProfile k)

/-- For `k ≥ 1`, `powSystem k` is strictly below the intermediate system. -/
theorem powSystem_lt_interPow {k : ℕ} (hk : 1 ≤ k) :
    powSystem k < interPowSys k :=
  ⟨interPow_dom_powk hk, not_powk_dom_interPow hk⟩

/-- For `k ≥ 1`, the intermediate system is strictly below `powSystem (k+1)`. -/
theorem interPow_lt_powSystem_succ {k : ℕ} (hk : 1 ≤ k) :
    interPowSys k < powSystem (k + 1) :=
  ⟨powSucc_dom_interPow hk, not_interPow_dom_powSucc hk⟩

/-- **Density of the ladder.**  For every `k ≥ 1` there is a degree strictly
between the consecutive ladder rungs `powSystem k` and `powSystem (k+1)`. -/
theorem exists_strictly_between_powSystem {k : ℕ} (hk : 1 ≤ k) :
    ∃ S : SizeSys, powSystem k < S ∧ S < powSystem (k + 1) :=
  ⟨interPowSys k, powSystem_lt_interPow hk, interPow_lt_powSystem_succ hk⟩

end LadderDensity
