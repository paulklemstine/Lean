import Mathlib

/-! # Valuation profiles as a lax monoidal map

This file formalizes the map sending a coefficient sequence to its *tropical
valuation profile* and proves the core lax-monoidal inequalities.

Coefficients live in a commutative semiring `K` equipped with an additive
valuation `v : K → WithTop ℤ` satisfying

* `v 0 = ⊤`;
* `v (a * b) = v a + v b`;
* `min (v a) (v b) ≤ v (a + b)`.

We equip sequences `Seq K := ℕ → K` with pointwise addition (the standard `Pi`
structure) and with the *binomial / Day convolution*

`(f ⋆ g) n = ∑ k ∈ range (n+1), (n.choose k : K) * f k * g (n - k)`.

The valuation profile `vprofile v f n = v (f n)` is then shown to be lax
monoidal in the preorder sense:

* it sends pointwise addition to a lower bound by tropical `min`
  (`vprofile_add_ge`);
* it sends binomial convolution to a lower bound by the tropical convolution of
  the profiles (`vprofile_binConv_ge`), with a simplified corollary when the
  binomial scalars have nonnegative valuation (`vprofile_binConv_ge_simple`).

The two facts are packaged together in `vprofile_lax_monoidal`.
-/

namespace ValuationProfilesLaxMonoidal

open Finset

/-- An additive valuation on a commutative semiring `K`, valued in `WithTop ℤ`. -/
structure AddVal (K : Type*) [CommSemiring K] where
  /-- The underlying valuation map. -/
  v : K → WithTop ℤ
  /-- The valuation of `0` is `⊤`. -/
  map_zero : v 0 = ⊤
  /-- Valuations are additive on products. -/
  map_mul : ∀ x y, v (x * y) = v x + v y
  /-- The valuation of a sum is at least the minimum of the valuations. -/
  min_le_map_add : ∀ x y, min (v x) (v y) ≤ v (x + y)

variable {K : Type*} [CommSemiring K]

/-- Coefficient sequences with values in `K`. Pointwise addition is the standard
`Pi` instance, so `f + g` denotes the termwise sum. -/
abbrev Seq (K : Type*) := ℕ → K

/-- The binomial (Day) convolution of two sequences. -/
def binConv (f g : Seq K) : Seq K := fun n =>
  ∑ k ∈ Finset.range (n + 1), (Nat.choose n k : K) * f k * g (n - k)

@[inherit_doc] scoped infixl:70 " ⋆ " => binConv

/-- The tropical valuation profile of a sequence. -/
def vprofile (val : AddVal K) (f : Seq K) : ℕ → WithTop ℤ := fun n => val.v (f n)

/-- The tropical (min-plus) binomial convolution of two profiles, weighted by the
valuations of the binomial scalars. It is a finite minimum over `range (n+1)`. -/
noncomputable def tropBinConv (val : AddVal K) (f g : Seq K) (n : ℕ) : WithTop ℤ :=
  (Finset.range (n + 1)).inf' (by simp)
    (fun k => val.v (Nat.choose n k : K) + vprofile val f k + vprofile val g (n - k))

/-- The unweighted tropical convolution of two profiles, a finite minimum over
`range (n+1)`. -/
noncomputable def tropConv (val : AddVal K) (f g : Seq K) (n : ℕ) : WithTop ℤ :=
  (Finset.range (n + 1)).inf' (by simp)
    (fun k => vprofile val f k + vprofile val g (n - k))

/-! ## A: addition -/

/-- **Theorem A.** The valuation profile sends pointwise addition to a lower
bound by tropical `min`. -/
theorem vprofile_add_ge (val : AddVal K) (f g : Seq K) (n : ℕ) :
    min (vprofile val f n) (vprofile val g n) ≤ vprofile val (f + g) n := by
  convert val.min_le_map_add ( f n ) ( g n ) using 1

/-! ## B: finite-sum lower bound -/

/-- **Lemma B.** A finite sum has valuation at least `α` whenever every summand
does. The empty sum is `0`, whose valuation is `⊤`, so no nonemptiness
hypothesis is required. -/
lemma le_val_sum (val : AddVal K) (α : WithTop ℤ) (s : Finset ℕ) (f : ℕ → K)
    (h : ∀ i ∈ s, α ≤ val.v (f i)) : α ≤ val.v (∑ i ∈ s, f i) := by
  induction' s using Finset.induction with i s hi ih;
  · simp +decide [ val.map_zero ];
  · simp_all +decide [ Finset.sum_insert hi ];
    exact le_trans ( le_min h.1 ih ) ( val.min_le_map_add _ _ )

/-! ## C: binomial convolution -/

/-- The valuation of a single convolution summand. -/
lemma val_binConv_term (val : AddVal K) (f g : Seq K) (n k : ℕ) :
    val.v ((Nat.choose n k : K) * f k * g (n - k))
      = val.v (Nat.choose n k : K) + vprofile val f k + vprofile val g (n - k) := by
  rw [ val.map_mul, val.map_mul ];
  rfl

/-- The weighted tropical convolution lies below each summand's value. -/
lemma tropBinConv_le_term (val : AddVal K) (f g : Seq K) (n k : ℕ)
    (hk : k ∈ Finset.range (n + 1)) :
    tropBinConv val f g n
      ≤ val.v (Nat.choose n k : K) + vprofile val f k + vprofile val g (n - k) := by
  exact Finset.inf'_le _ hk

/-- **Theorem C.** The valuation profile of the binomial convolution is bounded
below by the weighted tropical convolution of the profiles. -/
theorem vprofile_binConv_ge (val : AddVal K) (f g : Seq K) (n : ℕ) :
    tropBinConv val f g n ≤ vprofile val (f ⋆ g) n := by
  apply le_val_sum;
  exact fun i hi => le_trans ( tropBinConv_le_term val f g n i hi ) ( by rw [ val_binConv_term ] )

/-! ## D: simplified corollary -/

/-- **Corollary D.** If every binomial scalar appearing at index `n` has
nonnegative valuation, then the valuation profile of the binomial convolution is
bounded below by the *unweighted* tropical convolution of the profiles. -/
theorem vprofile_binConv_ge_simple (val : AddVal K) (f g : Seq K) (n : ℕ)
    (hchoose : ∀ k ∈ Finset.range (n + 1), 0 ≤ val.v (Nat.choose n k : K)) :
    tropConv val f g n ≤ vprofile val (f ⋆ g) n := by
  refine' le_trans _ ( vprofile_binConv_ge val f g n );
  simp +decide [ tropConv, tropBinConv ];
  intro k hk; use k; simp +decide [ *, add_assoc ] ;
  exact le_add_of_nonneg_left ( hchoose k ( Finset.mem_range.mpr ( Nat.lt_succ_of_le hk ) ) )

/-! ## E: lax monoidal package -/

/-- **Theorem E.** Coefficientwise, the valuation profile is lax monoidal in the
preorder sense: it sends pointwise addition to a lower bound by tropical `min`,
and binomial convolution to a lower bound by tropical convolution. -/
theorem vprofile_lax_monoidal (val : AddVal K) :
    (∀ f g n, min (vprofile val f n) (vprofile val g n) ≤ vprofile val (f + g) n) ∧
      (∀ f g n, tropBinConv val f g n ≤ vprofile val (f ⋆ g) n) :=
  ⟨vprofile_add_ge val, vprofile_binConv_ge val⟩

end ValuationProfilesLaxMonoidal