import Mathlib
import Speculative.AutoResearch.HodgeSpectralThreshold
import Speculative.AutoResearch.HodgeMessagePassingConvergence
import Speculative.AutoResearch.HodgeMessagePassingDuality

open scoped InnerProductSpace BigOperators Topology
open HodgeSpectralThreshold HodgeMessagePassingConvergence HodgeMessagePassingDuality

namespace HodgeSpectralDuality

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-! ## Eigenvalue additivity of the Hodge Laplacian -/

/-
!-- comment: `Δ x = up x + down x = a•x + b•x = (a+b)•x` by `add_smul`. -- !--

**Eigenvalue additivity.** On a simultaneous eigenvector of the up and down pieces,
the Hodge Laplacian `Δ = up + down` acts as the *sum* of the eigenvalues.
-/
theorem hodgeLaplacian_joint_eigen (up down : E →ₗ[ℝ] E) (a b : ℝ) {x : E}
    (hup : up x = a • x) (hdown : down x = b • x) :
    hodgeLaplacian up down x = (a + b) • x := by
  rw [ add_smul, ← hup, ← hdown, hodgeLaplacian_apply ]

/-! ## Spectral action of message passing on joint modes -/

/-
!-- comment: Instantiate `mpStep_eigen` at `L := Δ`, `lam := a + b`, using
`hodgeLaplacian_joint_eigen`. -- !--

**Scalar action of one layer.** On a joint eigenvector, one layer of full-Hodge
message passing `T = 1 - α·Δ` acts as the scalar `1 - α(a+b)`.
-/
theorem mpStep_hodge_joint_eigen (up down : E →ₗ[ℝ] E) (α a b : ℝ) {x : E}
    (hup : up x = a • x) (hdown : down x = b • x) :
    mpStep (hodgeLaplacian up down) α x = (1 - α * (a + b)) • x := by
  convert mpStep_eigen ( hodgeLaplacian up down ) α ( a + b ) ( hodgeLaplacian_joint_eigen up down a b hup hdown ) using 1

/-
!-- comment: Instantiate `mpStep_iterate_eigen` at `L := Δ`, `lam := a + b`. -- !--

**Scalar action of depth `k`.** All iterates act as the scalar `(1 - α(a+b))ᵏ` on a
joint eigenvector — the spectral representation of deep full-Hodge message passing.
-/
theorem mpStep_hodge_joint_eigen_iterate (up down : E →ₗ[ℝ] E) (α a b : ℝ) {x : E}
    (hup : up x = a • x) (hdown : down x = b • x) (k : ℕ) :
    ((mpStep (hodgeLaplacian up down) α) ^ k) x = (1 - α * (a + b)) ^ k • x := by
  convert HodgeMessagePassingDuality.mpStep_iterate_eigen ( HodgeSpectralThreshold.hodgeLaplacian up down ) α ( a + b ) _ k;
  convert hodgeLaplacian_joint_eigen up down a b hup hdown using 1

/-
!-- comment: Instantiate `mpStep_eigen_energy` at `L := Δ`, `lam := a + b`. -- !--

**Exact joint-mode energy.** After `k` layers the energy of a joint eigen-mode is
*exactly* `(1 - α(a+b))^{2k}` times its initial energy.
-/
theorem mpStep_hodge_joint_eigen_energy (up down : E →ₗ[ℝ] E) (α a b : ℝ) {x : E}
    (hup : up x = a • x) (hdown : down x = b • x) (k : ℕ) :
    ⟪((mpStep (hodgeLaplacian up down) α) ^ k) x,
        ((mpStep (hodgeLaplacian up down) α) ^ k) x⟫_ℝ
      = (1 - α * (a + b)) ^ (2 * k) * ⟪x, x⟫_ℝ := by
  convert mpStep_eigen_energy ( hodgeLaplacian up down ) α ( a + b ) ( hodgeLaplacian_joint_eigen up down a b hup hdown ) k using 1

/-! ## Fixed points of full-Hodge message passing are cohomology -/

/-
!-- comment: Compose `mpStep_fixed_iff` (`Tx = x ↔ Δx = 0`) with `harmonic_iff`
(`Δx = 0 ↔ up x = 0 ∧ down x = 0`). -- !--

**Fixed points = harmonic cochains.** For a nonzero step the dynamical fixed points of
full-Hodge message passing are exactly the closed-and-coclosed (harmonic) cochains.
-/
theorem mpStep_hodge_fixed_iff_harmonic (up down : E →ₗ[ℝ] E)
    (hsymm_up : ∀ x y, ⟪up x, y⟫_ℝ = ⟪x, up y⟫_ℝ)
    (hpos_up : ∀ x, 0 ≤ ⟪up x, x⟫_ℝ)
    (hsymm_down : ∀ x y, ⟪down x, y⟫_ℝ = ⟪x, down y⟫_ℝ)
    (hpos_down : ∀ x, 0 ≤ ⟪down x, x⟫_ℝ)
    {α : ℝ} (hα : α ≠ 0) (x : E) :
    mpStep (hodgeLaplacian up down) α x = x ↔ (up x = 0 ∧ down x = 0) := by
  rw [mpStep_fixed_iff (hodgeLaplacian up down) hα]
  exact harmonic_iff up down hsymm_up hpos_up hsymm_down hpos_down x

/-
!-- comment: Compose `mpStep_eigenspace_one` (`ker (T - 1) = ker Δ`) with
`ker_hodgeLaplacian` (`ker Δ = ker up ⊓ ker down`). -- !--

**Unit eigenspace = cohomology (submodule form).** As submodules, the unit eigenspace
of full-Hodge message passing equals the intersection of the closed and coclosed
cochains, `ker (T - 1) = ker up ⊓ ker down`.
-/
theorem mpStep_hodge_eigenspace_one_eq_ker_inf (up down : E →ₗ[ℝ] E)
    (hsymm_up : ∀ x y, ⟪up x, y⟫_ℝ = ⟪x, up y⟫_ℝ)
    (hpos_up : ∀ x, 0 ≤ ⟪up x, x⟫_ℝ)
    (hsymm_down : ∀ x y, ⟪down x, y⟫_ℝ = ⟪x, down y⟫_ℝ)
    (hpos_down : ∀ x, 0 ≤ ⟪down x, x⟫_ℝ)
    {α : ℝ} (hα : α ≠ 0) :
    LinearMap.ker (mpStep (hodgeLaplacian up down) α - 1)
      = LinearMap.ker up ⊓ LinearMap.ker down := by
  rw [mpStep_eigenspace_one (hodgeLaplacian up down) hα]
  exact ker_hodgeLaplacian up down hsymm_up hpos_up hsymm_down hpos_down

/-! ## Self-adjointness of the full-Hodge layer -/

/-
!-- comment: Instantiate `mpStep_symm` at `L := Δ`, using `hodgeLaplacian_symm`. -- !--

**Self-adjoint layer.** When both pieces are symmetric, every full-Hodge message-passing
layer is its own adjoint for the Riesz pairing.
-/
theorem mpStep_hodge_symm (up down : E →ₗ[ℝ] E)
    (hsymm_up : ∀ x y, ⟪up x, y⟫_ℝ = ⟪x, up y⟫_ℝ)
    (hsymm_down : ∀ x y, ⟪down x, y⟫_ℝ = ⟪x, down y⟫_ℝ)
    (α : ℝ) (x y : E) :
    ⟪mpStep (hodgeLaplacian up down) α x, y⟫_ℝ
      = ⟪x, mpStep (hodgeLaplacian up down) α y⟫_ℝ := by
  convert mpStep_symm ( hodgeLaplacian up down ) α ( hodgeLaplacian_symm up down hsymm_up hsymm_down ) x y using 1

end HodgeSpectralDuality