/-! ## §3. The valuation-depth (ultrametric) nerve is an equivalence relation -/

/-
**Backward nerve direction** (holds in *any* pseudometric space): points within
    distance `ε` are reachable in the Rips nerve.
-/
theorem reachable_of_dist_le {α : Type*} [PseudoMetricSpace α] {ε : ℝ} {x y : α}
    (hd : dist x y ≤ ε) : (ripsGraph α ε).Reachable x y := by
  by_cases hxy : x = y;
  · aesop;
  · exact SimpleGraph.Adj.reachable ( by exact ⟨ hxy, hd ⟩ )

/-
**Forward nerve direction — the tropical/valuation-depth step.**  In an ultrametric
    (non-Archimedean) space, reachability in the Rips nerve forces the endpoints to be
    within `ε`.  The proof walks the path and collapses it with the tropical inequality
    `dist x z ≤ max (dist x y) (dist y z)`; without it the statement is false.
-/
theorem dist_le_of_reachable {α : Type*} [PseudoMetricSpace α] [IsUltrametricDist α]
    {ε : ℝ} (hε : 0 ≤ ε) {x y : α} (h : (ripsGraph α ε).Reachable x y) :
    dist x y ≤ ε := by
  obtain ⟨ p ⟩ := h;
  induction' p with u v w p ih;
  · simpa using hε;
  · exact le_trans ( IsUltrametricDist.dist_triangle_max v w p ) ( max_le ( ih.2 ) ‹_› )

/-- **The Rips nerve of a valuation space is an ultrametric equivalence relation.**
    Reachability ⟺ direct ε-proximity.  This is the precise sense in which the tropical
    `max` law trivialises persistent homology over a non-Archimedean base. -/
theorem ripsGraph_reachable_iff {α : Type*} [PseudoMetricSpace α] [IsUltrametricDist α]
    {ε : ℝ} (hε : 0 ≤ ε) {x y : α} :
    (ripsGraph α ε).Reachable x y ↔ dist x y ≤ ε :=
  ⟨dist_le_of_reachable hε, reachable_of_dist_le⟩

-- !-- Lab Notes -- !--
-- HYPOTHESIS (H2 — the core conjecture): the tropical/ultrametric `max` triangle law is
--   *exactly* what makes Rips-reachability coincide with direct ε-proximity. In a general
--   metric space reachability is strictly coarser (chains of short hops connect far points).
-- EXPERIMENT: split the iff into `reachable_of_dist_le` (TRUE in any pseudometric — pure
--   adjacency) and `dist_le_of_reachable` (requires `IsUltrametricDist`). The forward
--   direction is proved by walk induction collapsing every path with
--   `IsUltrametricDist.dist_triangle_max` down to a single `max ε ε = ε` bound.
-- FAILURE ANALYSIS: dropping `[IsUltrametricDist]` from `dist_le_of_reachable` makes it
--   FALSE (e.g. three collinear reals 0,ε,2ε are reachable at scale ε but 2ε > ε). This
--   confirms the valuation-depth hypothesis is load-bearing, not cosmetic.
-- INSIGHT: over a valuation base the nerve is an honest equivalence relation, so β₀
--   degenerates to a counting problem — the bridge between non-Archimedean analysis and
--   trivial persistent homology.
-- !-- end Lab Notes -- !--

/-! ## §4. Tropical lower bound and its sharpness -/

/-- An **ε-packing**: a finite set whose distinct points are pairwise more than `ε` apart. -/
def IsPacking {α : Type*} [PseudoMetricSpace α] (P : Finset α) (ε : ℝ) : Prop :=
  ∀ x ∈ P, ∀ y ∈ P, x ≠ y → ε < dist x y

/-
**Functorial tropical lower bound.**  Over a valuation (ultrametric) space, any
    ε-packing injects into the set of connected components, so its size is a lower bound
    for persistent β₀.  This *fails* in general metric spaces, where packing points may be
    joined through chains; the valuation-depth hypothesis is exactly what rules that out.
-/
theorem tropical_lower_bound {α : Type*} [PseudoMetricSpace α] [IsUltrametricDist α]
    [Fintype α] {ε : ℝ} (hε : 0 ≤ ε) {P : Finset α} (hP : IsPacking P ε) :
    P.card ≤ persistentBetti0 α ε := by
  have h_inj : Function.Injective (fun x : P => (ripsGraph α ε).connectedComponentMk x) := by
    intro x y hxy;
    contrapose! hxy;
    intro h; have := hP x x.2 y y.2; simp_all +decide [ ripsGraph_reachable_iff ] ;
    linarith;
  convert Fintype.card_le_of_injective _ h_inj;
  · rw [ Fintype.card_of_subtype ] ; aesop;
  · convert Nat.card_eq_fintype_card

/-
**Sharpness witness** (any pseudometric space): a set of one representative per
    connected component is an ε-packing of size exactly β₀.  Combined with
    `tropical_lower_bound` this shows the bound is attained.
-/
theorem exists_packing_card_eq_betti0 {α : Type*} [PseudoMetricSpace α] [Fintype α]
    (ε : ℝ) : ∃ P : Finset α, IsPacking P ε ∧ P.card = persistentBetti0 α ε := by
  by_contra h_contra
  push_neg at h_contra
  generalize_proofs at *; (
  convert h_contra ( Finset.image ( fun c : ( ripsGraph α ε ).ConnectedComponent => c.out ) Finset.univ ) ?_ ?_ using 1;
  exact Classical.decEq α;
  · intro x hx y hy hxy; simp_all +decide [ IsPacking ] ;
    obtain ⟨ a, rfl ⟩ := hx; obtain ⟨ b, rfl ⟩ := hy; contrapose! hxy;
    have h_eq : (ripsGraph α ε).Reachable (Quot.out a) (Quot.out b) := by
      exact reachable_of_dist_le hxy
    generalize_proofs at *; (
    convert Quot.sound h_eq using 1;
    grind +suggestions);
  · convert Finset.card_image_of_injective _ _;
    · simp +decide [ persistentBetti0 ];
    · intro c₁ c₂ h; have := c₁.out_eq; have := c₂.out_eq; aesop;)

/-
**Bridge theorem.**  Over a valuation-depth (ultrametric) space the persistent
    0-th Betti number *equals* the maximal ε-packing number: it is the greatest cardinal
    attained by an ε-packing.  Tropical lower bound + sharpness witness = exact functorial
    identification of β₀ with non-Archimedean packing.
-/
theorem betti0_isGreatest_packing {α : Type*} [PseudoMetricSpace α] [IsUltrametricDist α]
    [Fintype α] {ε : ℝ} (hε : 0 ≤ ε) :
    IsGreatest {n : ℕ | ∃ P : Finset α, IsPacking P ε ∧ P.card = n}
      (persistentBetti0 α ε) := by
  refine' ⟨ _, fun n hn => _ ⟩;
  · convert exists_packing_card_eq_betti0 ε;
  · exact hn.choose_spec.2 ▸ tropical_lower_bound hε hn.choose_spec.1

-- !-- Lab Notes -- !--
-- HYPOTHESIS (H3): the packing lower bound on β₀, heuristic in general TDA, becomes a
--   SHARP functorial identity over a valuation space: β₀ = maximal ε-packing number.
-- EXPERIMENT: `tropical_lower_bound` (needs ultrametricity, via H2's forward direction)
--   injects a packing into the component set; `exists_packing_card_eq_betti0` (needs only
--   a pseudometric!) builds a section `ConnectedComponent.out` realising β₀ as a packing.
--   `betti0_isGreatest_packing` glues them via `IsGreatest`.
-- INSIGHT / ASYMMETRY: sharpness (the witness) is free in any metric, but the *upper*
--   control of every packing by β₀ is precisely where valuation depth enters. The two
--   inequalities meet only over an ultrametric base — a clean separation of where the
--   non-Archimedean hypothesis is and is not needed.
-- !-- end Lab Notes -- !--

/-! ## §5. p-adic instantiation (valuation depth made concrete) -/

/-- Over the `p`-adic integers `ℤ_[p]` — the archetypal valuation-depth space of
    `Computation/PadicValuationDepth.lean` — the Rips nerve is the ultrametric
    equivalence "agree to valuation depth ε". -/
theorem padic_reachable_iff (p : ℕ) [Fact (Nat.Prime p)] {ε : ℝ} (hε : 0 ≤ ε)
    {x y : ℤ_[p]} : (ripsGraph ℤ_[p] ε).Reachable x y ↔ dist x y ≤ ε :=
  ripsGraph_reachable_iff hε

end TropicalPersistentBetti