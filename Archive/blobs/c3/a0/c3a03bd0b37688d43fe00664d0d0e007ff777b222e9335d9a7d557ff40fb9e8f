/-
  # Functorial Tropical Lower Bounds on Persistent Betti-0
  ## via Valuation-Depth (Ultrametric) Čech/Rips Nerves

  Bridge: connects **tropical algebra** (Bridges/CategoricalTropicalUltrametric.lean) ↔
  **p-adic / non-Archimedean valuation depth** (Computation/PadicValuationDepth.lean) ↔
  **persistent topology** (Applications/PoincareData/MetricFiltration.lean).

  ## Core mathematical message

  The *tropical* triangle inequality `dist x z ≤ max (dist x y) (dist y z)` (i.e. the
  `IsUltrametricDist` / non-Archimedean / "valuation-depth" axiom — exactly the
  `add_eq_max'` principle of `TropicalValuationObject` and the `|a+b| ≤ max(|a|,|b|)`
  law of `PadicValuationDepth`) is precisely what turns the Vietoris–Rips nerve into an
  **equivalence relation**.  Consequently, over an ultrametric (valuation) space the
  persistent 0-th Betti number — the number of connected components of the Rips graph —
  is *exactly* the maximal ε-packing number, and it is a (contravariant) **functor**
  from the scale poset `(ℝ, ≤)` to `(ℕ, ≥)`.

  In an arbitrary metric space a packing only gives a heuristic; the *valuation-depth*
  hypothesis upgrades it to a **sharp, functorial lower bound**.  This is the bridge
  theorem of the file: `betti0_isGreatest_packing`.

  ## Main results
  * `ripsGraph` / `ripsGraph_mono` — the Rips 1-skeleton filtration (mirrors
    `Applications/PoincareData/MetricFiltration.lean`, kept local so the `Bridges`
    library is self-contained).
  * `persistentBetti0` — β₀ at scale ε, defined as `Nat.card` of connected components.
  * `persistentBetti0_antitone` — **functoriality**: β₀ is antitone in the scale.
  * `persistentBetti0_le_card`, `persistentBetti0_neg` — boundary behaviour.
  * `reachable_of_dist_le` — backward nerve direction (any pseudometric).
  * `dist_le_of_reachable` — **tropical/ultrametric** forward direction (valuation depth).
  * `ripsGraph_reachable_iff` — the Rips nerve is an *ultrametric equivalence relation*.
  * `tropical_lower_bound` — packing ⟹ β₀ lower bound (needs valuation depth).
  * `exists_packing_card_eq_betti0` — sharpness witness (any pseudometric).
  * `betti0_isGreatest_packing` — β₀ = maximal ε-packing number over a valuation space.
  * p-adic instantiation `padic_reachable_iff` over `ℤ_[p]`.
-/
import Mathlib

open Function SimpleGraph

noncomputable section

namespace TropicalPersistentBetti

/-! ## §1. The Rips nerve (self-contained mirror of `MetricFiltration.lean`) -/

/-- The **Rips graph** (Vietoris–Rips 1-skeleton) of a pseudometric space at scale `ε`:
    distinct points are adjacent iff within distance `ε`.  This is the 1-dimensional Čech
    nerve whose connected components compute persistent β₀. -/
def ripsGraph (α : Type*) [PseudoMetricSpace α] (ε : ℝ) : SimpleGraph α where
  Adj x y := x ≠ y ∧ dist x y ≤ ε
  symm x y h := ⟨h.1.symm, by rw [_root_.dist_comm]; exact h.2⟩
  loopless := ⟨fun x h => h.1 rfl⟩

theorem ripsGraph_adj_iff {α : Type*} [PseudoMetricSpace α] {ε : ℝ} {x y : α} :
    (ripsGraph α ε).Adj x y ↔ x ≠ y ∧ dist x y ≤ ε := Iff.rfl

/-- Filtration monotonicity: larger scale ⟹ more edges. -/
theorem ripsGraph_mono {α : Type*} [PseudoMetricSpace α] {ε₁ ε₂ : ℝ} (h : ε₁ ≤ ε₂) :
    ripsGraph α ε₁ ≤ ripsGraph α ε₂ := fun _ _ ⟨hne, hd⟩ => ⟨hne, hd.trans h⟩

/-- Boundary: at negative scale the nerve is edgeless. -/
theorem ripsGraph_bot_of_neg {α : Type*} [PseudoMetricSpace α] {ε : ℝ} (hε : ε < 0) :
    ripsGraph α ε = ⊥ := by
  ext x y
  simp only [ripsGraph, SimpleGraph.bot_adj]
  constructor
  · intro ⟨_, hd⟩; linarith [dist_nonneg (α := α) (x := x) (y := y)]
  · intro h; exact h.elim

/-! ## §2. Persistent Betti-0 and its functoriality -/

/-- The **persistent 0-th Betti number** at scale `ε`: the number of connected
    components of the Rips nerve. -/
def persistentBetti0 (α : Type*) [PseudoMetricSpace α] [Fintype α] (ε : ℝ) : ℕ :=
  Nat.card (ripsGraph α ε).ConnectedComponent

/-
**Functoriality of persistence**: β₀ is antitone in the scale, i.e. it is a
    contravariant functor `(ℝ, ≤) → (ℕ, ≥)`.  Components only ever merge as ε grows.
-/
theorem persistentBetti0_antitone (α : Type*) [PseudoMetricSpace α] [Fintype α] :
    Antitone (persistentBetti0 α) := by
  intro ε₁ ε₂ hε;
  have h_card_le_card : Nat.card (ripsGraph α ε₂).ConnectedComponent ≤ Nat.card (ripsGraph α ε₁).ConnectedComponent := by
    have h_le : ripsGraph α ε₁ ≤ ripsGraph α ε₂ := ripsGraph_mono hε
    convert SimpleGraph.ConnectedComponent.card_le_card_of_le h_le;
  exact h_card_le_card

/-
β₀ never exceeds the number of points.
-/
theorem persistentBetti0_le_card (α : Type*) [PseudoMetricSpace α] [Fintype α] (ε : ℝ) :
    persistentBetti0 α ε ≤ Nat.card α := by
  obtain ⟨f, hf⟩ : ∃ f : α → (ripsGraph α ε).ConnectedComponent, Function.Surjective f := by
    exact ⟨ _, fun x => by rcases x with ⟨ x ⟩ ; exact ⟨ x, rfl ⟩ ⟩;
  have h_card_le_card : Nat.card (ripsGraph α ε).ConnectedComponent ≤ Nat.card α := by
    have : Function.Surjective f := hf
    convert Nat.card_le_card_of_surjective f this
  exact h_card_le_card

/-
Boundary: below scale `0` every point is isolated, so β₀ equals the point count.
-/
theorem persistentBetti0_neg (α : Type*) [PseudoMetricSpace α] [Fintype α]
    {ε : ℝ} (hε : ε < 0) : persistentBetti0 α ε = Nat.card α := by
  convert Nat.card_congr ?_;
  symm;
  refine' Equiv.ofBijective ( fun x => ( ripsGraph α ε ).connectedComponentMk x ) ⟨ fun x y hxy => _, fun x => _ ⟩;
  · simp_all +decide [ ripsGraph_bot_of_neg hε ];
  · exact Quot.exists_rep x

