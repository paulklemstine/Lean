import Mathlib

/-!
# Functorial Tropical Automorphic Height Monotonicity on the Berggren Tree

This file develops a **tropical height theory** for the Berggren tree of primitive
Pythagorean triples and proves that the height is a strictly monotone functor along
every branch of the tree. The three results that organize the development are:

1. **Tropical height** `tropHeight (a,b,c) = max (max a b) c` — the max-plus
   ("tropical") valuation of a triple. On a positive Pythagorean triple it equals
   the hypotenuse, because the hypotenuse dominates both legs.

2. **Automorphic invariance**: the three Berggren generators act as integral Lorentz
   automorphisms in `O(2,1;ℤ)`, preserving the light-cone form `Q(a,b,c)=a²+b²-c²`.
   The tree maps are exactly the `mulVec` actions of the generator matrices, so the
   height is an automorphic invariant attached to a genuine group action.

3. **Functorial monotonicity**: regarded as a thin category, the descendant order on
   the tree maps strictly-monotonically to `(ℤ, <)`. Concretely, along **any** infinite
   branch `f : ℕ → Fin 3` from a positive seed, `n ↦ tropHeight (orbit f t₀ n)` is
   `StrictMono`, grows at least linearly, and along the all-`B` branch grows at least
   geometrically with ratio `3`.

## Bridge
Number theory (Pythagorean triples) ↔ tropical algebra (max-plus height) ↔ physics
(`O(2,1;ℤ)` Lorentz automorphisms) ↔ cryptography (collision-free, monotone orbit
heights). Extends `Algebra/BerggrenLorentz/Core.lean` (which only proved hypotenuse
growth under restrictive side hypotheses `b < a` / `a < b`) by establishing **uniform**
strict growth for *all three* generators on *every* positive Pythagorean triple, and
packages it as a functor.

-- !-- Lab Notes -- !--
-- HYPOTHESIS (H1): The hypotenuse strictly increases under every Berggren generator,
--   on every positive Pythagorean triple, with NO side condition. Core.lean only had
--   `hypA_strict_growth` (needs `b < a`) and `hypC_strict_growth` (needs `a < b`).
-- EXPERIMENT: c < hypA  ⟺  2a-2b+2c > 0  ⟺  a + (c-b) > 0. Since the hypotenuse
--   dominates the legs (c > b on a positive triple) and a > 0, this is unconditional.
--   Symmetrically c < hypC ⟺ b + (c-a) > 0, and c < hypB trivially. CONFIRMED: the
--   `b < a` / `a < b` hypotheses in Core were artifacts; `hyp_dominates` removes them.
-- INSIGHT: the right invariant is not `c` but `tropHeight = max(max a b) c`. On the
--   light cone these coincide (`tropHeight_posPythag`), but the tropical/max-plus form
--   is the structurally correct object: it is the valuation that makes growth functorial
--   and connects to `Bridges/CategoricalTropicalUltrametric.lean`.
-- FAILURE ANALYSIS: `rw [max_eq_right, max_eq_right]` collapsed both maxes after the
--   first rewrite ("pattern max not found"); `simp only [tropHeight]; omega` is the
--   robust closer since Lean's `omega` natively understands `max`/`min` over `ℤ`.
-- INSIGHT: positivity is preserved by all three generators (`step_posPythag`), so the
--   whole orbit stays on the positive light cone and the height identity propagates —
--   this is what upgrades a one-step bound into a functor.
-/

set_option maxHeartbeats 1000000

namespace BerggrenTropicalHeight

/-! ## §1. Berggren tree maps and the positive light cone -/

/-- Berggren child `A` (explicit coordinates), mirroring `BerggrenLorentz.childA`. -/
def childA (a b c : ℤ) : ℤ × ℤ × ℤ := (a - 2*b + 2*c, 2*a - b + 2*c, 2*a - 2*b + 3*c)

/-- Berggren child `B`. -/
def childB (a b c : ℤ) : ℤ × ℤ × ℤ := (a + 2*b + 2*c, 2*a + b + 2*c, 2*a + 2*b + 3*c)

/-- Berggren child `C`. -/
def childC (a b c : ℤ) : ℤ × ℤ × ℤ := (-a + 2*b + 2*c, -2*a + b + 2*c, -2*a + 2*b + 3*c)

/-- The ternary branching map of the Berggren tree, indexed by `Fin 3`. -/
def step : Fin 3 → ℤ × ℤ × ℤ → ℤ × ℤ × ℤ
  | 0, (a, b, c) => childA a b c
  | 1, (a, b, c) => childB a b c
  | 2, (a, b, c) => childC a b c

/-- A triple lies on the **positive light cone**: positive legs, positive hypotenuse,
    and Pythagorean. This is the home of every node of the Berggren tree. -/
def PosPythag (t : ℤ × ℤ × ℤ) : Prop :=
  0 < t.1 ∧ 0 < t.2.1 ∧ 0 < t.2.2 ∧ t.1 ^ 2 + t.2.1 ^ 2 = t.2.2 ^ 2

/-- The Lorentzian quadratic form (light-cone form). -/
def lorentzQ (a b c : ℤ) : ℤ := a ^ 2 + b ^ 2 - c ^ 2

/-- The **tropical height**: the max-plus valuation `max(max a b) c` of a triple.
    On the positive light cone it equals the hypotenuse (`tropHeight_posPythag`). -/
def tropHeight (t : ℤ × ℤ × ℤ) : ℤ := max (max t.1 t.2.1) t.2.2

/-! ## §2. Hypotenuse dominance and the height identity -/

/-- On a positive Pythagorean triple the hypotenuse strictly dominates both legs.
    This is the geometric fact powering all monotonicity below. -/
theorem hyp_dominates {a b c : ℤ} (ha : 0 < a) (hb : 0 < b) (hc : 0 < c)
    (h : a ^ 2 + b ^ 2 = c ^ 2) : a < c ∧ b < c := by
  constructor <;> nlinarith [sq_nonneg a, sq_nonneg b, sq_nonneg c]

/-- On the positive light cone, the tropical height **is** the hypotenuse. -/
theorem tropHeight_posPythag {t : ℤ × ℤ × ℤ} (ht : PosPythag t) :
    tropHeight t = t.2.2 := by
  obtain ⟨ha, hb, hc, h⟩ := ht
  obtain ⟨hac, hbc⟩ := hyp_dominates ha hb hc h
  simp only [tropHeight]; omega

/-! ## §3. The tree preserves the positive light cone -/

/-- Every Berggren generator maps the positive light cone to itself: positivity of all
    three coordinates is preserved, and the Pythagorean relation is preserved. -/
theorem step_posPythag (i : Fin 3) {t : ℤ × ℤ × ℤ} (ht : PosPythag t) :
    PosPythag (step i t) := by
  obtain ⟨a, b, c⟩ := t
  obtain ⟨ha, hb, hc, h⟩ := ht
  have hac : a < c := (hyp_dominates ha hb hc h).1
  have hbc : b < c := (hyp_dominates ha hb hc h).2
  fin_cases i <;>
    simp only [step, childA, childB, childC, PosPythag] <;>
    refine ⟨by nlinarith, by nlinarith, by nlinarith, by nlinarith⟩

/-! ## §4. Strict tropical height monotonicity (one step) -/

/-- **Main one-step theorem.** Every Berggren generator strictly increases the tropical
    height of every positive Pythagorean triple — uniformly, with no side condition.
    This generalizes `BerggrenLorentz.hypA_strict_growth` / `hypC_strict_growth`, which
    required `b < a` / `a < b` respectively. -/
theorem step_height_lt (i : Fin 3) {t : ℤ × ℤ × ℤ} (ht : PosPythag t) :
    tropHeight t < tropHeight (step i t) := by
  have h1 : tropHeight t = t.2.2 := tropHeight_posPythag ht
  have h2 : tropHeight (step i t) = (step i t).2.2 :=
    tropHeight_posPythag (step_posPythag i ht)
  rw [h1, h2]
  obtain ⟨a, b, c⟩ := t
  obtain ⟨ha, hb, hc, h⟩ := ht
  have hac : a < c := (hyp_dominates ha hb hc h).1
  have hbc : b < c := (hyp_dominates ha hb hc h).2
  fin_cases i <;> simp only [step, childA, childB, childC] <;> nlinarith

/-! ## §5. Automorphic structure: the `O(2,1;ℤ)` Lorentz action

-- !-- Lab Notes -- !--
-- HYPOTHESIS (H2): the tree maps are precisely the `mulVec` actions of integral Lorentz
--   matrices, so `tropHeight` is an automorphic invariant of a genuine group action and
--   not merely an ad-hoc combinatorial statistic.
-- EXPERIMENT: `matX.mulVec ![a,b,c]` unfolds (via `Fin.sum_univ_three`) to exactly the
--   `childX` coordinate vector; `ring` closes each component. The Lorentz identity
--   `Xᵀ Q X = Q` is decided by `native_decide`. CONFIRMED for A, B, C.
-- INSIGHT: the height transform `c ↦ c'` is governed by the third (time-like) row of the
--   boost; preservation of `Q` (`childX_Q`) is the conservation law underlying §4.
-/

/-- Berggren generator matrix `A` (a proper integral Lorentz boost, `det = +1`). -/
def matA : Matrix (Fin 3) (Fin 3) ℤ := !![1, -2, 2; 2, -1, 2; 2, -2, 3]
/-- Berggren generator matrix `B` (improper, `det = -1`). -/
def matB : Matrix (Fin 3) (Fin 3) ℤ := !![1, 2, 2; 2, 1, 2; 2, 2, 3]
/-- Berggren generator matrix `C` (proper, `det = +1`). -/
def matC : Matrix (Fin 3) (Fin 3) ℤ := !![-1, 2, 2; -2, 1, 2; -2, 2, 3]
/-- The Lorentz metric `diag(1,1,-1)`. -/
def metricQ : Matrix (Fin 3) (Fin 3) ℤ := !![1, 0, 0; 0, 1, 0; 0, 0, -1]

/-- The tree map `childA` is the matrix action of `matA`. -/
theorem matA_action (a b c : ℤ) :
    matA.mulVec ![a, b, c] =
      ![(childA a b c).1, (childA a b c).2.1, (childA a b c).2.2] := by
  funext i; fin_cases i <;>
    simp [matA, childA, Matrix.mulVec, dotProduct, Fin.sum_univ_three] <;> ring

/-- The tree map `childB` is the matrix action of `matB`. -/
theorem matB_action (a b c : ℤ) :
    matB.mulVec ![a, b, c] =
      ![(childB a b c).1, (childB a b c).2.1, (childB a b c).2.2] := by
  funext i; fin_cases i <;>
    simp [matB, childB, Matrix.mulVec, dotProduct, Fin.sum_univ_three]

/-- The tree map `childC` is the matrix action of `matC`. -/
theorem matC_action (a b c : ℤ) :
    matC.mulVec ![a, b, c] =
      ![(childC a b c).1, (childC a b c).2.1, (childC a b c).2.2] := by
  funext i; fin_cases i <;>
    simp [matC, childC, Matrix.mulVec, dotProduct, Fin.sum_univ_three]

/-- `A ∈ O(2,1;ℤ)`: it preserves the Lorentz metric. -/
theorem matA_lorentz : matA.transpose * metricQ * matA = metricQ := by native_decide
/-- `B ∈ O(2,1;ℤ)`. -/
theorem matB_lorentz : matB.transpose * metricQ * matB = metricQ := by native_decide
/-- `C ∈ O(2,1;ℤ)`. -/
theorem matC_lorentz : matC.transpose * metricQ * matC = metricQ := by native_decide

/-- Conservation law: each generator preserves the light-cone form `Q` exactly. -/
theorem childA_Q (a b c : ℤ) :
    lorentzQ (childA a b c).1 (childA a b c).2.1 (childA a b c).2.2 = lorentzQ a b c := by
  simp only [lorentzQ, childA]; ring
theorem childB_Q (a b c : ℤ) :
    lorentzQ (childB a b c).1 (childB a b c).2.1 (childB a b c).2.2 = lorentzQ a b c := by
  simp only [lorentzQ, childB]; ring
theorem childC_Q (a b c : ℤ) :
    lorentzQ (childC a b c).1 (childC a b c).2.1 (childC a b c).2.2 = lorentzQ a b c := by
  simp only [lorentzQ, childC]; ring

/-- The light-cone form is invariant under every generator (uniform statement). -/
theorem step_Q (i : Fin 3) (a b c : ℤ) :
    lorentzQ (step i (a, b, c)).1 (step i (a, b, c)).2.1 (step i (a, b, c)).2.2
      = lorentzQ a b c := by
  fin_cases i
  · exact childA_Q a b c
  · exact childB_Q a b c
  · exact childC_Q a b c

/-! ## §6. Orbits along branches and the height functor -/

/-- The orbit of a seed `t₀` along a branch `f : ℕ → Fin 3` of the tree. -/
def orbit (f : ℕ → Fin 3) (t₀ : ℤ × ℤ × ℤ) : ℕ → ℤ × ℤ × ℤ
  | 0 => t₀
  | n + 1 => step (f n) (orbit f t₀ n)

/-- Every node of an orbit from a positive seed stays on the positive light cone. -/
theorem orbit_posPythag (f : ℕ → Fin 3) {t₀ : ℤ × ℤ × ℤ} (h₀ : PosPythag t₀) :
    ∀ n, PosPythag (orbit f t₀ n)
  | 0 => h₀
  | n + 1 => step_posPythag (f n) (orbit_posPythag f h₀ n)

/-- **Functoriality (strict form).** Along any branch from a positive seed, the tropical
    height is a strictly monotone map `(ℕ, <) → (ℤ, <)`: a faithful functor from the
    descendant order of the branch to the ordered integers. -/
theorem height_strictMono (f : ℕ → Fin 3) {t₀ : ℤ × ℤ × ℤ} (h₀ : PosPythag t₀) :
    StrictMono (fun n => tropHeight (orbit f t₀ n)) := by
  apply strictMono_nat_of_lt_succ
  intro n
  exact step_height_lt (f n) (orbit_posPythag f h₀ n)

/-- **Functoriality (monotone form).** The induced map of posets is order-preserving. -/
theorem height_monotone (f : ℕ → Fin 3) {t₀ : ℤ × ℤ × ℤ} (h₀ : PosPythag t₀) :
    Monotone (fun n => tropHeight (orbit f t₀ n)) :=
  (height_strictMono f h₀).monotone

/-- **Collision-freeness.** Distinct depths along a branch have distinct heights — the
    height functor is injective, so no node revisits an ancestor's height. -/
theorem height_injective (f : ℕ → Fin 3) {t₀ : ℤ × ℤ × ℤ} (h₀ : PosPythag t₀) :
    Function.Injective (fun n => tropHeight (orbit f t₀ n)) :=
  (height_strictMono f h₀).injective

/-- **At least linear growth.** The height after `n` steps exceeds the seed height by
    at least `n` (each integer step raises it by ≥ 1). -/
theorem height_linear_lower (f : ℕ → Fin 3) {t₀ : ℤ × ℤ × ℤ} (h₀ : PosPythag t₀) :
    ∀ n, tropHeight t₀ + n ≤ tropHeight (orbit f t₀ n)
  | 0 => by simp [orbit]
  | n + 1 => by
      have ih := height_linear_lower f h₀ n
      have hstep : tropHeight (orbit f t₀ n) < tropHeight (orbit f t₀ (n + 1)) :=
        step_height_lt (f n) (orbit_posPythag f h₀ n)
      push_cast
      omega

/-! ## §7. Geometric growth along the all-`B` branch (tropical additivity)

-- !-- Lab Notes -- !--
-- HYPOTHESIS (H3): in the tropical/log scale the height is *additive* along the
--   fastest (all-`B`) branch — i.e. ordinary multiplicative (geometric) growth.
-- EXPERIMENT: hypB = 2a+2b+3c ≥ 3c for positive legs, so one `B`-step at least triples
--   the height; induction gives `3^n · h(t₀) ≤ h(orbitB n)`. CONFIRMED.
-- INSIGHT: this is the quantitative core of the catalog's "`O(log c)` tree depth":
--   reaching height `H` along `B` needs depth ≥ log₃(H / h(t₀)). Tropically, the height
--   functor sends the free monoid generator `B` to a translation by `log 3`.
-/

/-- One `B`-step at least triples the tropical height. -/
theorem stepB_triple {t : ℤ × ℤ × ℤ} (ht : PosPythag t) :
    3 * tropHeight t ≤ tropHeight (step 1 t) := by
  have h1 : tropHeight t = t.2.2 := tropHeight_posPythag ht
  have h2 : tropHeight (step 1 t) = (step 1 t).2.2 :=
    tropHeight_posPythag (step_posPythag 1 ht)
  rw [h1, h2]
  obtain ⟨a, b, c⟩ := t
  obtain ⟨ha, hb, hc, h⟩ := ht
  simp only [step, childB]
  nlinarith

/-- **Geometric lower bound.** Along the all-`B` branch the height grows at least like
    `3 ^ n` times the seed height: ordinary geometric growth = tropical/log-additivity. -/
theorem orbitB_exp_lower {t₀ : ℤ × ℤ × ℤ} (h₀ : PosPythag t₀) :
    ∀ n, 3 ^ n * tropHeight t₀ ≤ tropHeight (orbit (fun _ => 1) t₀ n)
  | 0 => by simp [orbit]
  | n + 1 => by
      have ih := orbitB_exp_lower h₀ n
      have hpos : (0 : ℤ) < tropHeight (orbit (fun _ => 1) t₀ n) := by
        have hp := orbit_posPythag (fun _ => 1) h₀ n
        rw [tropHeight_posPythag hp]; exact hp.2.2.1
      have hstep : 3 * tropHeight (orbit (fun _ => 1) t₀ n)
          ≤ tropHeight (orbit (fun _ => 1) t₀ (n + 1)) :=
        stepB_triple (orbit_posPythag (fun _ => 1) h₀ n)
      have h3 : (0 : ℤ) ≤ 3 ^ n := by positivity
      calc 3 ^ (n + 1) * tropHeight t₀ = 3 * (3 ^ n * tropHeight t₀) := by ring
        _ ≤ 3 * tropHeight (orbit (fun _ => 1) t₀ n) := by nlinarith
        _ ≤ tropHeight (orbit (fun _ => 1) t₀ (n + 1)) := hstep

/-! ## §8. The seed `(3,4,5)` and worked examples -/

/-- The classical seed `(3,4,5)` lies on the positive light cone. -/
theorem seed_posPythag : PosPythag (3, 4, 5) := by
  refine ⟨by norm_num, by norm_num, by norm_num, by norm_num⟩

/-- Its tropical height is the hypotenuse `5`. -/
theorem seed_height : tropHeight (3, 4, 5) = 5 := by simp [tropHeight]

/-- The three children of the seed (the first generation of the tree). -/
theorem seed_childA : step 0 (3, 4, 5) = (5, 12, 13) := by simp [step, childA]
theorem seed_childB : step 1 (3, 4, 5) = (21, 20, 29) := by simp [step, childB]
theorem seed_childC : step 2 (3, 4, 5) = (15, 8, 17) := by simp [step, childC]

/-- Concrete instance of strict monotonicity at the seed: every child is taller. -/
theorem seed_children_taller :
    tropHeight (3, 4, 5) < tropHeight (step 0 (3, 4, 5)) ∧
    tropHeight (3, 4, 5) < tropHeight (step 1 (3, 4, 5)) ∧
    tropHeight (3, 4, 5) < tropHeight (step 2 (3, 4, 5)) :=
  ⟨step_height_lt 0 seed_posPythag,
   step_height_lt 1 seed_posPythag,
   step_height_lt 2 seed_posPythag⟩

end BerggrenTropicalHeight
