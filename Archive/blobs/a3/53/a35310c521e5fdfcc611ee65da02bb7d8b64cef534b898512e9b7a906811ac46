import Mathlib
import Speculative.AutoResearch.CarmichaelHelper

/-! # The Fibonacci Apparition Law and the divisibility lattice of `F`

This file extends the Carmichael primitive-divisor arc
(`Speculative.AutoResearch.CarmichaelHelper`, `Shared.CarmichaelProof`,
`Speculative.AutoResearch.CarmichaelComposite`).  Those files use the *rank of
apparition* (entry point) `CarmHelper.entryPt p`, the least `k > 0` with
`p ∣ F(k)`, only as a one-directional tool (`entryPt_dvd`, `entryPt_min`).

Here we close the loop and prove the full structural statements that the
entry-point machinery was built for, all `sorry`-free:

* `fib_apparition_law` — the **complete apparition law**: `p ∣ F(n) ↔ α(p) ∣ n`.
  This upgrades the catalog's `entryPt_dvd` (only `⇒`) and `Nat.fib_dvd`
  (only `⇐`, specialised) to a genuine equivalence, identifying the *entire*
  index set `{n | p ∣ F(n)}` as the multiples of the entry point.
* `primitive_iff_entryPt_eq` — a clean restatement of "primitive divisor":
  a divisor `p ∣ F(n)` is *primitive* (divides no earlier Fibonacci number) iff
  its entry point is exactly `n`.  This is the conceptual core that
  `Shared.CarmichaelProof.fib_primitive_divisor_prime` proves only in the prime
  case; here it holds unconditionally.
* `fib_dvd_fib_iff` — the **divisibility lattice** of Fibonacci numbers:
  for `m ≥ 3`, `F(m) ∣ F(n) ↔ m ∣ n`.  This is the multiplicative refinement of
  the strong-divisibility identity `Nat.fib_gcd` (the catalog's `Fib_gcd_identity`).
* `fib_coprime_iff_gcd_le_two` — the coprimality dual: `F(m)` and `F(n)` are
  coprime iff `gcd(m, n) ∈ {1, 2}`.

Together these turn the `n ↦ F(n)` map into a divisibility-preserving morphism
from `(ℕ, ∣)` (modulo the `{1,2}` collapse) into `(ℕ, ∣)`.

-- !-- Lab Notebook -- !--
Hypothesis : The catalog used `entryPt` only one-directionally; the symmetric
  fact `p ∣ F(n) ↔ entryPt p ∣ n` should hold and would subsume both
  `entryPt_dvd` and the divisibility direction of `Nat.fib_dvd`, giving a single
  characterisation of the zero-set of `n ↦ F(n) mod p`.
Result     : Confirmed.  `fib_apparition_law` proves the equivalence (handling
  `n = 0` via `F 0 = 0`), and `primitive_iff_entryPt_eq` repackages primitivity
  as `entryPt p = n` with no primality hypothesis — strictly more general than the
  prime-only catalog statement.  `fib_dvd_fib_iff` derives the index-divisibility
  lattice from `Nat.fib_gcd` + strict monotonicity (`Nat.fib_strictMonoOn`).
Insight    : Strong divisibility `gcd(F m, F n) = F(gcd m n)` is the single engine
  behind every statement here; the apparition law is just its `p`-local shadow,
  and `fib_dvd_fib_iff` is its order-theoretic shadow.  Strict monotonicity of `F`
  on `[2,∞)` is exactly what removes the `F 1 = F 2 = 1` collapse.
Failure analysis : A first phrasing of `fib_dvd_fib_iff` without the `m ≥ 3`
  guard is false (`F 1 = F 2 = 1` divides everything but `1, 2 ∤ n` in general);
  the `{1,2}` exceptions resurface as the `gcd ≤ 2` clause of the coprimality dual.
-- !--
-/

namespace FibApparition

open CarmHelper

/-- **The Fibonacci apparition law.**  If some positive Fibonacci index is
    divisible by `p`, then `p ∣ F(n)` for *exactly* the multiples `n` of the entry
    point `α(p)`.  The forward direction is the catalog's `entryPt_dvd`; the reverse
    direction is `Nat.fib_dvd` applied at `α(p)`. -/
-- !-- `n = 0` is trivial (`F 0 = 0`, everything divides `0` and `α(p) ∣ 0`); for
--     `n > 0`, forward is `entryPt_dvd`, reverse is `F(α p) ∣ F n` via `Nat.fib_dvd`
--     composed with `dvd_fib_entryPt`. -- !--
theorem fib_apparition_law (p n : ℕ) (hex : ∃ k, 0 < k ∧ p ∣ Nat.fib k) :
    p ∣ Nat.fib n ↔ entryPt p ∣ n := by
  constructor <;> intro hn;
  · by_cases hn : 0 < n <;> simp_all +decide [ CarmHelper.entryPt_dvd ];
  · exact dvd_trans ( dvd_fib_entryPt p hex ) ( Nat.fib_dvd _ _ hn )

/-- **Primitivity ⇔ entry point.**  A divisor `p ∣ F(n)` (with `n > 0`) is a
    *primitive* divisor — i.e. divides no earlier Fibonacci number — exactly when
    its entry point equals `n`.  No primality assumption is needed, generalising
    the prime-only `Shared.CarmichaelProof.fib_primitive_divisor_prime`. -/
-- !-- `⇒`: `entryPt p ∣ n` and `p ∣ F(entryPt p)`, so if `entryPt p < n` the
--     primitivity hypothesis at `k = entryPt p` is contradicted; hence `= n`.
--     `⇐`: `entryPt_min` kills every `0 < k < n = entryPt p`. -- !--
theorem primitive_iff_entryPt_eq (p n : ℕ) (hn : 0 < n) (hpn : p ∣ Nat.fib n) :
    (∀ k, 0 < k → k < n → ¬(p ∣ Nat.fib k)) ↔ entryPt p = n := by
  constructor <;> intro h;
  · unfold entryPt;
    split_ifs <;> simp_all +decide [ Nat.find_eq_iff ];
  · intro k hk hk'; have := entryPt_min p k; simp_all +decide ;
    exact this n hn hpn

/-- **The divisibility lattice of Fibonacci numbers.**  For `m ≥ 3`,
    `F(m) ∣ F(n)` iff `m ∣ n`.  The reverse direction is `Nat.fib_dvd`; the forward
    direction uses `gcd(F m, F n) = F(gcd m n)` (`Nat.fib_gcd`) together with strict
    monotonicity of `F` on `[2, ∞)` to conclude `gcd m n = m`. -/
-- !-- `F m ∣ F n` ⟹ `gcd(F m,F n)=F m`, i.e. `F(gcd m n)=F m`; since `m ≥ 3` forces
--     `gcd m n ≥ 2`, injectivity of `F` on `[2,∞)` gives `gcd m n = m`, so `m ∣ n`. -- !--
theorem fib_dvd_fib_iff {m : ℕ} (hm : 3 ≤ m) (n : ℕ) :
    Nat.fib m ∣ Nat.fib n ↔ m ∣ n := by
  refine' ⟨ fun h => _, fun h => _ ⟩;
  · have h_gcd : Nat.gcd (Nat.fib m) (Nat.fib n) = Nat.fib m := Nat.gcd_eq_left h;
    have h_gcd_eq : Nat.fib (Nat.gcd m n) = Nat.fib m := by
      rw [ ← h_gcd, Nat.fib_gcd ];
    have h_gcd_ge_two : 2 ≤ Nat.gcd m n := by
      contrapose! h_gcd_eq; interval_cases _ : Nat.gcd m n <;> simp_all +decide ;
      linarith [ Nat.le_fib_add_one m ];
    have h_inj : StrictMonoOn Nat.fib (Set.Ici 2) := Nat.fib_strictMonoOn
    exact h_inj.eq_iff_eq h_gcd_ge_two ( show 2 ≤ m by linarith ) |>.1 h_gcd_eq ▸ Nat.gcd_dvd_right _ _;
  · exact Nat.fib_dvd _ _ h

/-- **Coprimality dual.**  Two Fibonacci numbers `F(m)`, `F(n)` are coprime iff
    `gcd(m, n) ∈ {1, 2}`.  Immediate from `Nat.fib_gcd` and `F(k) = 1 ↔ k ∈ {1,2}`. -/
-- !-- `gcd(F m,F n)=F(gcd m n)` is `1` iff `gcd m n ∈ {1,2}`, since `F` is `1` exactly
--     at indices `1` and `2`. -- !--
theorem fib_coprime_iff_gcd_le_two (m n : ℕ) :
    Nat.Coprime (Nat.fib m) (Nat.fib n) ↔ Nat.gcd m n = 1 ∨ Nat.gcd m n = 2 := by
  constructor <;> intro h;
  · have := Nat.fib_gcd m n; simp_all +decide [ Nat.Coprime, Nat.Coprime.gcd_eq_one ] ;
    rcases k : m.gcd n with ( _ | _ | _ | k ) <;> simp_all +arith +decide [ Nat.fib_add_two ];
    linarith [ Nat.fib_pos.2 ( Nat.succ_pos ‹_› ) ];
  · cases h <;> simp_all +decide [ Nat.Coprime ];
    · rw [ ← Nat.fib_gcd, ‹Nat.gcd m n = 1›, Nat.fib_one ];
    · rw [ ← Nat.fib_gcd, ‹m.gcd n = 2› ] ; norm_num

end FibApparition