# Functoriality of the distance certificate under direct sums of codes

Companion to `Catalog.Applications.PoincareData.CodeMetricFiltration`.  There, the Rips
filtration of the catalog's metric layer turns the `overlap`/`ip` invariants of the
coding layer into a *monotone minimum-distance certificate*.  Here we prove the
**functoriality** half: the direct sum (coordinate concatenation) of codes — the
coding-theory shadow of the orthogonal direct sum of intersection forms
(`Catalog.Applications.SmoothPoincare.DirectSum`) — induces *controlled* behavior of the
certificate.

Main results (all `sorry`-free):

* `hammingDist_append` — **metric functoriality**: the Hamming distance is *additive*
  across concatenation,
  `hammingDist (append x y) (append x' y') = hammingDist x x' + hammingDist y y'`.
* `wt_append` — weight additivity (the diagonal special case).
* `append_eq_zero_iff` — a concatenation vanishes iff both blocks vanish.
* `directSum_minWeight_lower` — **the certificate is functorial**: if every nonzero word
  of `C` has weight `≥ a` and every nonzero word of `D` has weight `≥ b`, then every
  nonzero word of the direct-sum code `C ⊕ D` has weight `≥ min a b`.  Thus the
  filtration certificate of a connected/direct sum is *controlled* by the certificates of
  its summands, exactly as `directSum_isEven` / `directSum_unimodular` control the
  structural predicates of intersection forms.

-- !-- Lab Notes -- !--
Hypothesis (Hypothesizer): the minimum-distance certificate built from the Rips
  filtration should be *monoidal* under direct sums of codes — the metric analogue of
  the additivity of intersection-form predicates under `⊕`.
Experiment (Experimenter): define the concatenation code via `Fin.append`, prove
  Hamming-distance additivity, and bound the nonzero weights of the sum by the summand
  bounds.
Analysis (Analyst): additivity of `hammingDist` across `Fin.append` is the load-bearing
  fact; the weight lower bound then follows because a nonzero concatenation has a nonzero
  block, contributing at least that block's certified weight.
Critique (Critic): the bound `min a b` is sharp — placing the zero word in the opposite
  block realizes a codeword of weight exactly `a` (resp. `b`), so no larger constant is
  possible; the statement is not vacuous.
Synthesis: `overlap`/distance ⇒ certificate (`CodeMetricFiltration`) is now closed under
  `⊕`, giving a small functorial calculus of minimum-distance lower bounds.
-/

import Mathlib
import Catalog.Applications.SmoothPoincare.TopologicalCodes

open scoped BigOperators
open SmoothPoincare.Codes

namespace SmoothPoincare
namespace CodeFiltration

variable {n m : ℕ}

/-! ## Part 1: Metric functoriality of concatenation -/

/-- **Metric functoriality.** The Hamming distance is additive across coordinate
concatenation. -/
theorem hammingDist_append (x x' : Fin n → ZMod 2) (y y' : Fin m → ZMod 2) :
    hammingDist (Fin.append x y) (Fin.append x' y')
      = hammingDist x x' + hammingDist y y' := by
  unfold hammingDist
  rw [Finset.card_filter, Finset.card_filter, Finset.card_filter, Fin.sum_univ_add]
  congr 1
  · apply Finset.sum_congr rfl; intro i _; rw [Fin.append_left, Fin.append_left]
  · apply Finset.sum_congr rfl; intro i _; rw [Fin.append_right, Fin.append_right]

/-- Weight additivity across concatenation (the diagonal case of `hammingDist_append`). -/
theorem wt_append (x : Fin n → ZMod 2) (y : Fin m → ZMod 2) :
    wt (Fin.append x y) = wt x + wt y := by
  unfold wt
  rw [Finset.card_filter, Finset.card_filter, Finset.card_filter, Fin.sum_univ_add]
  congr 1
  · apply Finset.sum_congr rfl; intro i _; rw [Fin.append_left]
  · apply Finset.sum_congr rfl; intro i _; rw [Fin.append_right]

/-- A concatenation vanishes iff both blocks vanish. -/
theorem append_eq_zero_iff (x : Fin n → ZMod 2) (y : Fin m → ZMod 2) :
    Fin.append x y = 0 ↔ x = 0 ∧ y = 0 := by
  constructor
  · intro h
    refine ⟨funext fun i => ?_, funext fun i => ?_⟩
    · have := congrArg (fun f => f (Fin.castAdd m i)) h
      simpa [Fin.append_left] using this
    · have := congrArg (fun f => f (Fin.natAdd n i)) h
      simpa [Fin.append_right] using this
  · rintro ⟨hx, hy⟩
    subst hx; subst hy
    funext i
    refine Fin.addCases ?_ ?_ i
    · intro j; rw [Fin.append_left]; rfl
    · intro j; rw [Fin.append_right]; rfl

/-! ## Part 2: The direct-sum code and functoriality of the certificate -/

/-- The **direct-sum code** `C ⊕ D`: all concatenations of a word of `C` with a word of
`D`.  This is the coding-theory shadow of the orthogonal direct sum of intersection
forms. -/
def directSumCode (C : Finset (Fin n → ZMod 2)) (D : Finset (Fin m → ZMod 2)) :
    Finset (Fin (n + m) → ZMod 2) :=
  (C ×ˢ D).image (fun p => Fin.append p.1 p.2)

/-- **Functoriality of the distance certificate.** If every nonzero word of `C` has
weight `≥ a` and every nonzero word of `D` has weight `≥ b`, then every nonzero word of
the direct-sum code `C ⊕ D` has weight `≥ min a b`.  The minimum-distance lower bound of
a direct sum is thus controlled by the bounds of its summands. -/
theorem directSum_minWeight_lower
    {C : Finset (Fin n → ZMod 2)} {D : Finset (Fin m → ZMod 2)} {a b : ℕ}
    (hC : ∀ x ∈ C, x ≠ 0 → a ≤ wt x) (hD : ∀ y ∈ D, y ≠ 0 → b ≤ wt y)
    {w : Fin (n + m) → ZMod 2} (hw : w ∈ directSumCode C D) (hw0 : w ≠ 0) :
    min a b ≤ wt w := by
  rw [directSumCode, Finset.mem_image] at hw
  obtain ⟨p, hp, rfl⟩ := hw
  rw [Finset.mem_product] at hp
  obtain ⟨hx, hy⟩ := hp
  rw [wt_append]
  have hne : p.1 ≠ 0 ∨ p.2 ≠ 0 := by
    by_contra h
    push_neg at h
    exact hw0 ((append_eq_zero_iff p.1 p.2).mpr ⟨h.1, h.2⟩)
  rcases hne with hx0 | hy0
  · have : a ≤ wt p.1 := hC p.1 hx hx0
    calc min a b ≤ a := min_le_left a b
      _ ≤ wt p.1 := this
      _ ≤ wt p.1 + wt p.2 := Nat.le_add_right _ _
  · have : b ≤ wt p.2 := hD p.2 hy hy0
    calc min a b ≤ b := min_le_right a b
      _ ≤ wt p.2 := this
      _ ≤ wt p.1 + wt p.2 := Nat.le_add_left _ _

/-- **Sharpness.** When `0 ∈ D`, the bound `min a b ≤ a` is realized: any weight-`a`
codeword of `C` concatenated with the zero block lies in `C ⊕ D` with the same weight,
so no constant larger than `min a b` is a valid lower bound in general. -/
theorem directSum_minWeight_sharp
    {C : Finset (Fin n → ZMod 2)} {D : Finset (Fin m → ZMod 2)}
    (h0D : (0 : Fin m → ZMod 2) ∈ D)
    {x : Fin n → ZMod 2} (hx : x ∈ C) :
    Fin.append x (0 : Fin m → ZMod 2) ∈ directSumCode C D
      ∧ wt (Fin.append x (0 : Fin m → ZMod 2)) = wt x := by
  refine ⟨?_, ?_⟩
  · rw [directSumCode, Finset.mem_image]
    exact ⟨(x, 0), Finset.mem_product.mpr ⟨hx, h0D⟩, rfl⟩
  · rw [wt_append]
    have : wt (0 : Fin m → ZMod 2) = 0 := by
      unfold wt; simp
    rw [this]
    rfl

end CodeFiltration
end SmoothPoincare
