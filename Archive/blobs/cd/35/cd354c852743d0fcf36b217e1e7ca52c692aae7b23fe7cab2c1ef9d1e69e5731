import Mathlib

/-!
# Lax Monoidal Functors from the Generating-Function Algebra

This file formalizes the sense in which passing from a *sequence* of coefficients to
its *generating function* (a formal power series) is a structure-preserving map between
two monoidal structures. Concretely, we exhibit two such "generating-function functors":

* the **ordinary generating function** (OGF) `ogf a = ∑ aₙ Xⁿ`, which turns the
  **Cauchy convolution** of sequences into the *product* of power series, and
* the **exponential generating function** (EGF) `egf a = ∑ (aₙ/n!) Xⁿ`, which turns the
  **binomial convolution** of sequences into the *product* of power series.

In categorical language, a functor `F` between monoidal categories is *lax monoidal* when
it is equipped with a coherent natural transformation `F(A) ⊗ F(B) → F(A ⊗ B)` and a unit
`𝟙 → F(𝟙)`. Here the source monoidal structure on sequences is convolution (with its unit
`δ₀ = (1,0,0,…)`), the target is the multiplicative monoid of power series, and the
comparison map is an *equality* — so our functors are in fact **strong** monoidal
(the comparison morphisms are isomorphisms).

## Main results

* `ogf_mul`, `ogf_unitSeq`, `ogf_add`, `ogf_smul` — the OGF is an `R`-algebra homomorphism
  from (sequences, convolution) to power series (the lax monoidal comparison + unit).
* `ogf_injective`, `ogf_surjective`, `ogf_bijective` — the comparison is an isomorphism
  (strong monoidality).
* `conv_comm`, `conv_assoc`, `conv_unitSeq`, `unitSeq_conv` — the convolution monoid laws,
  obtained by *transporting* the power-series ring laws through the OGF.
* `ogfMulHom`, `ogfMulEquiv` — the OGF bundled as a monoid (iso)morphism for the
  multiplicative/monoidal structure.
* `egf_mul`, `egf_unitSeq` — the EGF intertwines binomial convolution with multiplication.

-- !-- Lab Notes -- !--
HYPOTHESIS H1: The map "sequence ↦ ordinary generating function" preserves the Cauchy
  convolution: `ogf (a ⋆ b) = ogf a * ogf b`. Tested ✓. The crux,
  `coeff n (ogf a * ogf b) = ∑_{k≤n} aₖ b_{n-k}`, is exactly `PowerSeries.coeff_mul`
  re-indexed by `Nat.sum_antidiagonal_eq_sum_range_succ_mk`.

HYPOTHESIS H2: The same map is in fact a bijection, so the convolution algebra and the
  power-series algebra are *isomorphic* — the functor is strong (not merely lax) monoidal.
  Tested ✓ via `PowerSeries.ext_iff` (the comparison is the identity at the level of
  coefficient families). We package the multiplicative part as `ogfMulEquiv`.

HYPOTHESIS H3: The exponential generating function turns *binomial* convolution
  `(a ⋆ b)ₙ = ∑ C(n,k) aₖ b_{n-k}` into the product of power series over a char-0 field.
  Tested ✓. The decisive identity is `Nat.cast_choose`, giving
  `C(n,k) = n!/(k!·(n-k)!)` in ℚ, after which `field_simp` discharges the per-term equality.

FAILURE ANALYSIS A1: An early attempt proved `conv_comm` by hand via `antidiagonal_swap`;
  this was brittle (pattern-matching on `p.swap`). The clean route is to *transport*
  commutativity through the homomorphism: `ogf (conv a b) = ogf a * ogf b = ogf b * ogf a`
  followed by injectivity. "Prove the algebra facts on the model side" is the payoff of
  establishing the isomorphism early.

FAILURE ANALYSIS A2: A first attempt bundled the *full* `CommSemiring` on a type synonym
  `ConvAlg R := ℕ → R` and then a `RingHom`. This collided with the pre-existing pointwise
  (`Pi`) ring instance on `ℕ → R`: the new `add`/`mul` were defeq to the `Pi` operations,
  so `show`/elaboration could not disambiguate `+` inside the field proofs. Lesson learned:
  bundling the *additive* structure invites instance clashes, whereas bundling only the
  *multiplicative* monoid (`MulHom`/`MulEquiv`, the genuinely monoidal datum) is clean and
  is exactly what "monoidal functor" needs. We therefore expose `ogfMulHom`/`ogfMulEquiv`
  and keep additivity/linearity as separate unbundled lemmas.
-/

open PowerSeries Finset

namespace GFLaxMonoidal

variable {R : Type*} [CommSemiring R]

/-- The Cauchy convolution (the monoidal product on the generating-function algebra):
`(a ⋆ b)ₙ = ∑_{k=0}^{n} aₖ · b_{n-k}`. -/
def conv (a b : ℕ → R) : ℕ → R := fun n => ∑ k ∈ range (n + 1), a k * b (n - k)

/-- The unit of the convolution monoid: the sequence `δ₀ = (1, 0, 0, …)`. -/
def unitSeq : ℕ → R := fun n => if n = 0 then 1 else 0

/-- The ordinary generating function of a sequence: `ogf a = ∑ aₙ Xⁿ`. -/
def ogf (a : ℕ → R) : PowerSeries R := PowerSeries.mk a

@[simp] theorem coeff_ogf (a : ℕ → R) (n : ℕ) : (coeff n) (ogf a) = a n := by
  simp [ogf]

/-- **Lax monoidal comparison (OGF).** The OGF turns convolution into multiplication:
`ogf (a ⋆ b) = ogf a * ogf b`. -/
theorem ogf_mul (a b : ℕ → R) : ogf (conv a b) = ogf a * ogf b := by
  ext n
  simp only [ogf, conv, coeff_mk, coeff_mul, Nat.sum_antidiagonal_eq_sum_range_succ_mk]

/-- **Unit comparison (OGF).** The OGF of the convolution unit is `1`. -/
theorem ogf_unitSeq : ogf (unitSeq : ℕ → R) = 1 := by
  ext n
  simp only [ogf, coeff_mk, unitSeq]
  rcases Nat.eq_zero_or_pos n with h | h
  · subst h; simp
  · rw [if_neg h.ne', PowerSeries.coeff_one, if_neg h.ne']

/-- Additivity of the OGF. -/
theorem ogf_add (a b : ℕ → R) : ogf (a + b) = ogf a + ogf b := by
  ext n; simp [ogf]

/-- Scalar compatibility of the OGF. -/
theorem ogf_smul (r : R) (a : ℕ → R) : ogf (r • a) = r • ogf a := by
  ext n; simp [ogf]

theorem ogf_zero : ogf (0 : ℕ → R) = 0 := by ext n; simp [ogf]

/-- The OGF comparison map is injective (the unit comparison is monic). -/
theorem ogf_injective : Function.Injective (ogf : (ℕ → R) → PowerSeries R) := by
  intro a b h
  funext n
  have := PowerSeries.ext_iff.mp h n
  simpa [ogf] using this

/-- The OGF comparison map is surjective: every power series is the OGF of its
coefficient sequence. -/
theorem ogf_surjective : Function.Surjective (ogf : (ℕ → R) → PowerSeries R) := by
  intro φ
  refine ⟨fun n => (coeff n) φ, ?_⟩
  ext n; simp [ogf]

/-- **Strong monoidality.** The OGF comparison is a bijection: the convolution algebra of
sequences is isomorphic to the power-series algebra. -/
theorem ogf_bijective : Function.Bijective (ogf : (ℕ → R) → PowerSeries R) :=
  ⟨ogf_injective, ogf_surjective⟩

/-- Convolution is commutative — proved by transporting `mul_comm` through the OGF. -/
theorem conv_comm (a b : ℕ → R) : conv a b = conv b a := by
  apply ogf_injective
  rw [ogf_mul, ogf_mul, mul_comm]

/-- Convolution is associative — proved by transporting `mul_assoc` through the OGF. -/
theorem conv_assoc (a b c : ℕ → R) : conv (conv a b) c = conv a (conv b c) := by
  apply ogf_injective
  rw [ogf_mul, ogf_mul, ogf_mul, ogf_mul, mul_assoc]

/-- `δ₀` is a left unit for convolution. -/
theorem unitSeq_conv (a : ℕ → R) : conv unitSeq a = a := by
  apply ogf_injective
  rw [ogf_mul, ogf_unitSeq, one_mul]

/-- `δ₀` is a right unit for convolution. -/
theorem conv_unitSeq (a : ℕ → R) : conv a unitSeq = a := by
  apply ogf_injective
  rw [ogf_mul, ogf_unitSeq, mul_one]

/-!
## Bundling the multiplicative (monoidal) structure

The genuinely *monoidal* datum is the multiplicative monoid. We give `ℕ → R` the
convolution multiplication on a type synonym `Seq R` (carrying `Mul`/`One` only, hence no
clash with the pointwise `Pi` ring), and package the OGF as a monoid isomorphism onto the
multiplicative monoid of `PowerSeries R`.
-/

/-- Type synonym for sequences carrying the *convolution* multiplicative monoid structure
(and nothing else, to avoid clashing with the pointwise `Pi` instances on `ℕ → R`). -/
def Seq (R : Type*) := ℕ → R

namespace Seq

/-- Wrap a sequence as an element of the convolution monoid. -/
def of (a : ℕ → R) : Seq R := a
/-- Underlying sequence. -/
def coe (a : Seq R) : ℕ → R := a

instance : Mul (Seq R) := ⟨fun a b => conv (a : ℕ → R) b⟩
instance : One (Seq R) := ⟨(unitSeq : ℕ → R)⟩

theorem mul_def (a b : Seq R) : (a * b : Seq R) = (conv (a : ℕ → R) b : Seq R) := rfl
theorem one_def : (1 : Seq R) = (unitSeq : Seq R) := rfl

instance : CommMonoid (Seq R) where
  mul_assoc a b c := conv_assoc (a : ℕ → R) b c
  one_mul a := unitSeq_conv (a : ℕ → R)
  mul_one a := conv_unitSeq (a : ℕ → R)
  mul_comm a b := conv_comm (a : ℕ → R) b

end Seq

/-- **The generating-function functor as a monoid homomorphism** for the monoidal
(multiplicative) structure: `ogfMulHom : Seq R →* PowerSeries R`. This is the bundled lax
monoidal comparison together with the unit comparison. -/
def ogfMulHom : Seq R →* PowerSeries R where
  toFun a := ogf (a : ℕ → R)
  map_one' := ogf_unitSeq
  map_mul' a b := ogf_mul (a : ℕ → R) b

@[simp] theorem ogfMulHom_apply (a : Seq R) : ogfMulHom a = ogf (a : ℕ → R) := rfl

/-- **The generating-function functor as a monoid isomorphism** (strong monoidality,
bundled): the convolution monoid of sequences is isomorphic to the multiplicative monoid of
power series. -/
noncomputable def ogfMulEquiv : Seq R ≃* PowerSeries R :=
  MulEquiv.ofBijective ogfMulHom ogf_bijective

@[simp] theorem ogfMulEquiv_apply (a : Seq R) : ogfMulEquiv a = ogf (a : ℕ → R) := rfl

/-!
## The exponential generating-function functor

Over a characteristic-zero field we have a *second* lax monoidal functor: the exponential
generating function, which intertwines **binomial** convolution with multiplication of
power series.
-/

/-- The binomial convolution: `(a ⋆ b)ₙ = ∑_{k=0}^{n} C(n,k) · aₖ · b_{n-k}`. -/
def binomConv (a b : ℕ → ℚ) : ℕ → ℚ :=
  fun n => ∑ k ∈ range (n + 1), (n.choose k : ℚ) * a k * b (n - k)

/-- The exponential generating function: `egf a = ∑ (aₙ / n!) Xⁿ`. -/
def egf (a : ℕ → ℚ) : PowerSeries ℚ := PowerSeries.mk (fun n => a n / n.factorial)

/-- **Lax monoidal comparison (EGF).** The EGF turns *binomial* convolution into the
product of power series: `egf (a ⋆ b) = egf a * egf b`. -/
theorem egf_mul (a b : ℕ → ℚ) : egf (binomConv a b) = egf a * egf b := by
  ext n
  rw [coeff_mul]
  simp only [egf, binomConv, coeff_mk, Nat.sum_antidiagonal_eq_sum_range_succ_mk]
  rw [Finset.sum_div]
  apply Finset.sum_congr rfl
  intro k hk
  rw [mem_range, Nat.lt_succ_iff] at hk
  rw [Nat.cast_choose ℚ hk]
  field_simp

/-- **Unit comparison (EGF).** The EGF of the convolution unit `δ₀` is `1`. -/
theorem egf_unitSeq : egf (unitSeq : ℕ → ℚ) = 1 := by
  ext n
  simp only [egf, coeff_mk, unitSeq]
  rcases Nat.eq_zero_or_pos n with h | h
  · subst h; simp
  · rw [if_neg h.ne', PowerSeries.coeff_one, if_neg h.ne', zero_div]

end GFLaxMonoidal
