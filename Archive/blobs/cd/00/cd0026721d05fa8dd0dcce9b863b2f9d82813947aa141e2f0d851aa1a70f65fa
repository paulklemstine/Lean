/-- `7 ≡ 2 mod 5`, so `5` is a non-residue mod `7` and `7 ∣ F₈ = 21`. -/
example : (7 : ℕ) ∣ Nat.fib 8 := by decide

/-- `11 ≡ 1 mod 5`, so `5` is a residue mod `11` and `11 ∣ F₁₀ = 55`. -/
example : (11 : ℕ) ∣ Nat.fib 10 := by decide

end FibEntryReciprocity
