import Mathlib

/-!
# Shannon Perfect Secrecy of the One-Time Pad

This file formalizes the **combinatorial heart of Shannon's perfect secrecy
theorem** for the one-time pad, in its most general algebraic form: the key
space is an arbitrary finite group `G`, plaintexts and ciphertexts also live in
`G`, and encryption is the group multiplication `Enc k m = k * m`.

The defining property of perfect secrecy is that the ciphertext distribution is
*independent of the plaintext*. With a uniformly random key, this reduces to a
purely combinatorial statement: for any plaintext `m` and target ciphertext `c`,
there is **exactly one** key `k` with `k * m = c`. Consequently the number of
keys mapping `m` to `c` does not depend on `m`, so the induced ciphertext
distribution is the uniform distribution regardless of the message.

We additionally exhibit the result at the level of probability mass functions:
the pushforward of the uniform key distribution under encryption is *uniform*
and, in particular, identical for any two plaintexts.

## Main results

* `otp_unique_key` — for `m c : G` there is a unique key `k` with `k * m = c`,
  namely `k = c * m⁻¹`.
* `otp_key_count` — `#{k | k * m = c} = 1` for every plaintext/ciphertext pair.
* `otp_perfect_secrecy` — the key counts agree across plaintexts:
  `#{k | k * m₁ = c} = #{k | k * m₂ = c}` (perfect secrecy, combinatorial form).
* `otp_cipher_uniform` — with the uniform key PMF, `Enc · m` pushes forward to the
  uniform PMF on `G`, for every plaintext `m`.
* `otp_cipher_indep` — the ciphertext PMF is identical for any two plaintexts
  (perfect secrecy, probabilistic form).

## Lab Notes

-- !-- Lab Notes -- !--
-- Hypothesis: perfect secrecy of the OTP is *exactly* the statement that left
--   multiplication by the key is a bijection of `G`; everything else (uniform
--   ciphertext, plaintext-independence) is downstream bookkeeping.
-- Experiment: encode "exactly one key" as `Finset.card_eq_one` witnessed by
--   `k = c * m⁻¹`; the filtered finset becomes a singleton via `group`/`mul_left_cancel`.
-- Insight: the cleanest probabilistic statement uses `PMF.uniformOfFintype` and
--   `PMF.map`; the pushforward value at `c` is the (normalized) key count, which
--   `otp_key_count` pins to `1`, giving uniformity and hence independence.
-- Insight: stating encryption as `k * m` (key on the left) makes the unique key
--   `c * m⁻¹`; with `m * k` it would be `m⁻¹ * c`. Either works; left-key chosen
--   to match the standard "ciphertext = key ⋆ message" convention.
-- Failure mode avoided: don't assume `G` abelian — the group OTP is secure for
--   *any* finite group, and the proof never uses commutativity.
-- !-- Lab Notes -- !--
-/

namespace Catalog.Cryptography.OTP

open Finset

variable {G : Type*} [Group G] [Fintype G] [DecidableEq G]

omit [Fintype G] [DecidableEq G] in
/-- **Unique key.** For any plaintext `m` and ciphertext `c` there is a unique
key `k` with `k * m = c`, namely `k = c * m⁻¹`. This is the bijection at the
heart of one-time-pad secrecy. -/
theorem otp_unique_key (m c : G) : ∃! k : G, k * m = c := by
  exact ⟨ c * m⁻¹, by simp +decide, fun k hk => by simpa using congr_arg ( · * m⁻¹ ) hk ⟩

/-- **Key count.** Exactly one key encrypts plaintext `m` to ciphertext `c`. -/
theorem otp_key_count (m c : G) :
    (univ.filter (fun k : G => k * m = c)).card = 1 := by
  obtain ⟨ k, hk ⟩ := otp_unique_key m c;
  exact Finset.card_eq_one.mpr ⟨ k, by aesop ⟩

/-- **Perfect secrecy (combinatorial form).** The number of keys that encrypt a
plaintext to a fixed ciphertext `c` is the same for every plaintext: it cannot
leak any information about the message. -/
theorem otp_perfect_secrecy (m₁ m₂ c : G) :
    (univ.filter (fun k : G => k * m₁ = c)).card
      = (univ.filter (fun k : G => k * m₂ = c)).card := by
  -- Since both sets have cardinality 1, their cardinalities are equal.
  simp [otp_key_count]

/-- **Perfect secrecy (probabilistic form).** With a uniformly random key, the
ciphertext distribution `k ↦ k * m` is the uniform distribution on `G`, for
every plaintext `m`. -/
theorem otp_cipher_uniform (m : G) :
    (PMF.uniformOfFintype G).map (fun k => k * m) = PMF.uniformOfFintype G := by
  convert PMF.ext _ ; simp +decide [ PMF.uniformOfFintype_apply ] ;
  intro x; rw [ Finset.sum_eq_single ( x * m⁻¹ ) ] <;> aesop;

/-- **Plaintext independence.** The ciphertext distribution is identical for any
two plaintexts — the formal expression of "the ciphertext reveals nothing about
the plaintext". -/
theorem otp_cipher_indep (m₁ m₂ : G) :
    (PMF.uniformOfFintype G).map (fun k => k * m₁)
      = (PMF.uniformOfFintype G).map (fun k => k * m₂) := by
  rw [ otp_cipher_uniform, otp_cipher_uniform ]

end Catalog.Cryptography.OTP