/h1>\n  <div class=\"sub\">For a prime <code>p</code> not dividing <code>b</code>, the first index where <code>p</code> divides\n    <code>b<sup>n</sup>&minus;1</code> equals the multiplicative order of <code>b</code> modulo <code>p</code>.\n    Drag the sliders and watch the global appearance pattern be predicted by a single finite clock.</div>\n</header>\n\n<div class=\"wrap\">\n  <div class=\"panel\">\n    <h2>Inputs</h2>\n    <label>base b = <span class=\"val\" id=\"bv\">2</span></label>\n    <input type=\"range\" id=\"b\" min=\"2\" max=\"12\" value=\"2\" />\n    <label>prime p = <span class=\"val\" id=\"pv\">7</span></label>\n    <input type=\"range\" id=\"p\" min=\"3\" max=\"97\" value=\"7\" />\n    <div id=\"warn\" class=\"warn\"></div>\n\n    <div class=\"result\" id=\"out\"></div>\n    <div class=\"note\">The clock below shows the powers <code>b<sup>k</sup> mod p</code>. The entry point is the\n      smallest <code>k</code> returning the value <code>1</code> — that is the multiplicative order, and by the\n      Bridge it is exactly the rank of apparition.</div>\n  </div>\n\n  <div class=\"panel\">\n    <h2>Powers on the clock <code>b<sup>k</sup> mod p</code></h2>\n    <canvas id=\"clock\" width=\"320\" height=\"320\" class=\"clock\"></canvas>\n    <h2 style=\"margin-top:18px\">Support: where <code>p</code> divides <code>b<sup>n</sup>&minus;1</code> (n = 1..30)</h2>\n    <div class=\"grid\" id=\"grid\"></div>\n    <div class=\"note\">Blue = <code>p</code> divides the term. The red square is the entry point.\n      Notice the appearances are exactly the multiples of the entry point — the <em>support law</em>.</div>\n  </div>\n</div>\n\n<script>\nfunction isPrime(n){ if(n<2) return false; for(let d=2; d*d<=n; d++) if(n%d===0) return false; return true; }\nfunction order(b,p){ let acc=b%p, k=1; if(acc===0) return null; while(acc!==1%p){ acc=(acc*b)%p; k++; if(k>p) return null;} return k; }\n\nconst bEl=document.getElementById('b'), pEl=document.getElementById('p');\nconst bv=document.getElementById('bv'), pv=document.getElementById('pv');\nconst out=document.getElementById('out'), warn=document.getElementById('warn');\nconst grid=document.getElementById('grid'); const cv=document.getElementById('clock'); const ctx=cv.getContext('2d');\n\nfunction draw(){\n  let b=+bEl.value, p=+pEl.value; bv.textContent=b; pv.textContent=p;\n  let prime=isPrime(p), divides=(b%p===0);\n  if(!prime){ warn.textContent='⚠ p = '+p+' is not prime — the Bridge requires a prime modulus.'; }\n  else if(divides){ warn.textContent='⚠ p divides b — the Bridge requires p ∤ b.'; }\n  else { warn.textContent=''; }\n\n  let e = (prime && !divides) ? order(b,p) : null;\n  if(e!==null){\n    let ok = ((p-1)%e===0);\n    out.innerHTML = 'entry point = order(<code>'+b+'</code> mod <code>'+p+'</code>) = <span class=\"big\">'+e+'</span><br>'+\n      'Fermat descent: '+e+' divides p−1 = '+(p-1)+' &rarr; <b>'+(ok?'yes ✓':'no')+'</b>';\n  } else { out.innerHTML='<span class=\"warn\">Choose a prime p with p ∤ b to see the bridge.</span>'; }\n\n  // clock\n  ctx.clearRect(0,0,cv.width,cv.height);\n  let cx=160, cy=160, R=120;\n  ctx.strokeStyle='#2a3c5c'; ctx.beginPath(); ctx.arc(cx,cy,R,0,2*Math.PI); ctx.stroke();\n  if(prime && !divides){\n    let acc=1;\n    for(let k=0;k<=Math.min(e||0,p);k++){\n      let ang=-Math.PI/2 + 2*Math.PI*(acc%p)/p;\n      let x=cx+R*Math.cos(ang), y=cy+R*Math.sin(ang);\n      ctx.fillStyle = (k>0 && acc%p===1)? '#ff5a7a' : '#4cc3ff';\n      ctx.beginPath(); ctx.arc(x,y,7,0,2*Math.PI); ctx.fill();\n      ctx.fillStyle='#e8eef7'; ctx.font='11px sans-serif';\n      ctx.fillText('k='+k, x+9, y+4);\n      if(k>0) acc=(acc*b)%p;\n      if(k>0 && (acc%p===1)) {}\n    }\n  }\n  ctx.fillStyle='#8aa0c0'; ctx.font='12px sans-serif'; ctx.fillText('values of b^k mod p', cx-58, cy);\n\n  // support grid n=1..30\n  grid.innerHTML='';\n  for(let n=1;n<=30;n++){\n    let cell=document.createElement('div'); cell.className='cell'; cell.textContent=n;\n