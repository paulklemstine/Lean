import Mathlib

open scoped InnerProductSpace BigOperators

namespace HodgeHeatSemigroup

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- One layer of gradient message passing `T = 1 - α·Δ`, acting by
`x ↦ x - α • (Δ x)`.  Modeled as an element of `Module.End ℝ E` so that depth
(iteration) is automatically linear and depth-additivity is `pow_add`. -/
def mpStep (Δ : E →ₗ[ℝ] E) (α : ℝ) : E →ₗ[ℝ] E := (1 : Module.End ℝ E) - α • Δ

@[simp] theorem mpStep_apply (Δ : E →ₗ[ℝ] E) (α : ℝ) (x : E) :
    mpStep Δ α x = x - α • (Δ x) := by
  simp [mpStep]

/-! ## The semigroup law -/

/-
!-- comment: Depth is iteration of the linear endomorphism `T`, so
depth-additivity `Tᵐ⁺ⁿ = Tᵐ∘Tⁿ` is exactly `pow_add` in `Module.End ℝ E`. -- !--

**Semigroup law.** Composing depth `m` after depth `n` is depth `m + n`.
-/
theorem mpStep_semigroup (Δ : E →ₗ[ℝ] E) (α : ℝ) (m n : ℕ) (x : E) :
    ((mpStep Δ α) ^ (m + n)) x = ((mpStep Δ α) ^ m) (((mpStep Δ α) ^ n) x) := by
  rw [ pow_add ];
  rfl

/-! ## Commutation with the generator -/

/-
!-- comment: `T = 1 - α•Δ`, and `Δ` commutes with `1` and with `α•Δ`; `ext`
then `simp` with `map_sub`, `map_smul` closes it. -- !--

**Commutation with the generator.** The generator `Δ` commutes with one layer.
-/
theorem mpStep_commute (Δ : E →ₗ[ℝ] E) (α : ℝ) (x : E) :
    Δ (mpStep Δ α x) = mpStep Δ α (Δ x) := by
  simp +decide [ mpStep_apply, map_sub, map_smul ]

/-
!-- comment: Induct on `k`, pushing `Δ` through `T` one layer at a time via
`mpStep_commute`. -- !--

**Iterated commutation.** `Δ` commutes with every depth `Tᵏ`.
-/
theorem mpStep_iterate_commute (Δ : E →ₗ[ℝ] E) (α : ℝ) (k : ℕ) (x : E) :
    Δ (((mpStep Δ α) ^ k) x) = ((mpStep Δ α) ^ k) (Δ x) := by
  induction' k with k ih generalizing x;
  · rfl;
  · simp +decide [ *, pow_succ' ]

/-! ## The discrete heat equation -/

/-
!-- comment: `T y - y = (y - α•Δy) - y = -α•Δy` applied at `y = Tᵏx`. -- !--

**Discrete heat equation.** One more layer changes the state by `−α·Δ` of the
current state: message passing is explicit-Euler heat flow with time step `α`.
-/
theorem mpStep_discrete_heat_equation (Δ : E →ₗ[ℝ] E) (α : ℝ) (k : ℕ) (x : E) :
    ((mpStep Δ α) ^ (k + 1)) x - ((mpStep Δ α) ^ k) x
      = -(α • (Δ (((mpStep Δ α) ^ k) x))) := by
  simp +decide [ pow_succ', mpStep_apply ]

/-! ## The Dirichlet energy balance -/

/-
!-- comment: Expand `⟪x - α•Δx, x - α•Δx⟫`; the two cross terms `⟪x,Δx⟫` and
`⟪Δx,x⟫` are equal by `real_inner_comm`, so no self-adjointness is needed. -- !--

**Exact Dirichlet energy balance.** For an *arbitrary* operator `Δ`, the energy
lost in one layer is `α(2⟪x,Δx⟫ − α⟪Δx,Δx⟫)`.
-/
theorem mpStep_energy_dissipation (Δ : E →ₗ[ℝ] E) (α : ℝ) (x : E) :
    ⟪x, x⟫_ℝ - ⟪mpStep Δ α x, mpStep Δ α x⟫_ℝ
      = α * (2 * ⟪x, Δ x⟫_ℝ - α * ⟪Δ x, Δ x⟫_ℝ) := by
  simp +decide only [mpStep_apply, inner_sub_right, inner_sub_left, inner_smul_left, inner_smul_right];
  simp +decide [ real_inner_comm ] ; ring

/-
!-- comment: From the balance, the lost energy is `α(2 - αλ)·(something ≥ 0)`;
the Rayleigh bounds `μ⟪x,x⟫ ≤ ⟪x,Δx⟫` and `⟪Δx,Δx⟫ ≤ λ⟪x,Δx⟫` with `0 ≤ α`,
`αλ ≤ 2`, `0 ≤ μ` make it nonnegative (`nlinarith`). -- !--

**Monotone dissipation.** Under a stable step (`0 ≤ α`, `αλ ≤ 2`) and Rayleigh
bounds with `0 ≤ μ`, one layer never increases the energy.
-/
theorem mpStep_energy_monotone (Δ : E →ₗ[ℝ] E) (α μ lam : ℝ) (x : E)
    (hα : 0 ≤ α) (hμ : 0 ≤ μ) (hstep : α * lam ≤ 2)
    (hlower : μ * ⟪x, x⟫_ℝ ≤ ⟪x, Δ x⟫_ℝ)
    (hupper : ⟪Δ x, Δ x⟫_ℝ ≤ lam * ⟪x, Δ x⟫_ℝ) :
    ⟪mpStep Δ α x, mpStep Δ α x⟫_ℝ ≤ ⟪x, x⟫_ℝ := by
  -- From the balance, the lost energy is `α(2 - αλ)·(something ≥ 0)`. The Rayleigh bounds `μ⟪x,x⟫ ≤ ⟪x,Δx⟫` and `⟪Δx,Δx⟫ ≤ λ⟪x,Δx⟫` with `0 ≤ α`, `αλ ≤ 2`, `0 ≤ μ` make it nonnegative (`nlinarith`).
  have hlost : ⟪x, x⟫_ℝ - ⟪(mpStep Δ α) x, (mpStep Δ α) x⟫_ℝ ≥ α * (2 - α * lam) * ⟪x, Δ x⟫_ℝ := by
    rw [ mpStep_energy_dissipation ];
    nlinarith [ mul_le_mul_of_nonneg_left hupper hα ];
  nlinarith [ mul_nonneg hα ( sub_nonneg.2 hstep ), show 0 ≤ ⟪x, Δ x⟫_ℝ by exact le_trans ( mul_nonneg hμ ( real_inner_self_nonneg ) ) hlower ]

/-
!-- comment: Telescope `∑_{i<k} (Eᵢ − Eᵢ₊₁) = E₀ − E_k` with `Eᵢ = ⟪Tⁱx,Tⁱx⟫`,
then rewrite each summand by `mpStep_energy_dissipation` at `Tⁱx` (using the
semigroup law `Tⁱ⁺¹ = T∘Tⁱ`). -- !--

**Total dissipation (telescope).** The energy lost across `k` layers equals the
sum of the per-layer Dirichlet dissipations.
-/
theorem mpStep_total_dissipation (Δ : E →ₗ[ℝ] E) (α : ℝ) (x : E) (k : ℕ) :
    ⟪x, x⟫_ℝ - ⟪((mpStep Δ α) ^ k) x, ((mpStep Δ α) ^ k) x⟫_ℝ
      = ∑ i ∈ Finset.range k,
          α * (2 * ⟪((mpStep Δ α) ^ i) x, Δ (((mpStep Δ α) ^ i) x)⟫_ℝ
               - α * ⟪Δ (((mpStep Δ α) ^ i) x), Δ (((mpStep Δ α) ^ i) x)⟫_ℝ) := by
  induction' k with k ih;
  · simp +decide;
  · convert congr_arg ( fun y => y + α * ( 2 * ⟪ ( mpStep Δ α ^ k ) x, Δ ( ( mpStep Δ α ^ k ) x ) ⟫_ℝ - α * ⟪ Δ ( ( mpStep Δ α ^ k ) x ), Δ ( ( mpStep Δ α ^ k ) x ) ⟫_ℝ ) ) ih using 1;
    · have := mpStep_energy_dissipation Δ α ( ( mpStep Δ α ^ k ) x );
      rw [ ← this ] ; simp +decide [ pow_succ' ] ;
    · rw [ Finset.sum_range_succ ]

/-! ## Stationary solutions are exactly the harmonic cochains -/

/-
!-- comment: `T x = x ↔ α•Δx = 0 ↔ Δx = 0` since `α ≠ 0` and scalar action is
torsion-free over `ℝ`. -- !--

**Harmonic = stationary.** For a nonzero step, a cochain is harmonic (`Δ x = 0`)
iff it is a fixed point of the discrete heat flow.
-/
theorem hodge_heat_stationary (Δ : E →ₗ[ℝ] E) {α : ℝ} (hα : α ≠ 0) (x : E) :
    Δ x = 0 ↔ mpStep Δ α x = x := by
  simp +decide [ mpStep, hα ]

end HodgeHeatSemigroup