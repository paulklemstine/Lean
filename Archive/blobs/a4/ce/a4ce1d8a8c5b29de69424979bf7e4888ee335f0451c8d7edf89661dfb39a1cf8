# Discrete Hodge Theory: Abstract Combinatorial Hodge Decomposition

This file rebuilds the *discrete Hodge program* on a self-contained Mathlib
foundation, working with genuine finite-dimensional real inner product spaces
and Mathlib's `LinearMap.adjoint`.  The setting abstracts a length-two segment
of a (co)chain complex

  `U --A--> V --B--> W`,   with   `B ∘ A = 0`,

equipped with inner products on each space.  Writing `Aᵀ` and `Bᵀ`
for the formal adjoints, the **Hodge Laplacian** on the middle space `V` is

  `Δ = A ∘ Aᵀ + Bᵀ ∘ B`.

The central results are:

* `inner_laplacian_self` : `⟪Δ x, x⟫ = ‖Aᵀ x‖² + ‖B x‖²` (the Bochner/Weitzenböck
  identity that powers everything).
* `mem_harmonic_iff` : a chain is **harmonic** (`Δ x = 0`) iff it is *closed*
  (`B x = 0`) and *co-closed* (`Aᵀ x = 0`).
* `harmonic_orthogonal_*` and `hodge_decomposition_sup` : the **Hodge
  decomposition** `V = range A ⊕ harmonic ⊕ range Bᵀ` as a sum of pairwise
  orthogonal subspaces filling the whole space.
* `harmonic_equiv_homology` : the **Hodge isomorphism** identifying the harmonic
  space with the homology `ker B / range A`.

-- !-- Lab Notes -- !--
Hypothesis: The entire discrete Hodge decomposition is a *formal* consequence of
  three Mathlib facts about finite-dimensional inner product spaces:
    (i)  ker(fᵀ) = (range f)ᗮ,
    (ii) a subspace and its orthogonal complement are complementary (IsCompl),
    (iii) ⟪f x, y⟫ = ⟪x, fᵀ y⟫ (adjoint adjunction).
  No matrices, no orientation conventions, no explicit bases should be needed.
Result: Confirmed.  Every theorem below reduces to adjunction + positivity of the
  real inner product.  The Weitzenböck identity `⟪Δx,x⟫ = ‖Aᵀx‖²+‖Bx‖²` is the
  single load-bearing computation; harmonicity = closed ∧ co-closed falls out of
  positive-definiteness, and the three-way decomposition is just two nested
  orthogonal-complement splittings `V = rangeA ⊕ (rangeA)ᗮ` and
  `ker B = rangeA ⊕ harmonic`.
Insight: Phrasing homology as `ker B ⧸ range A` and harmonic as `ker B ∩ (range A)ᗮ`
  makes the Hodge isomorphism the abstract statement "an orthogonal complement of
  a subspace maps isomorphically onto the quotient by it".
Failure analysis: Trying to prove the three-way internal direct sum in one shot is
  painful; factoring through `ker B = range A ⊔ harmonic` (closed = exact ⊕ harmonic)
  and `V = ker B ⊕ range Bᵀ` keeps each step to a two-piece orthogonal split.
-- !-- end -- !--
-/

import Mathlib

noncomputable section

open LinearMap

namespace DiscreteHodge

variable {U V W : Type*}
  [NormedAddCommGroup U] [InnerProductSpace ℝ U] [FiniteDimensional ℝ U]
  [NormedAddCommGroup V] [InnerProductSpace ℝ V] [FiniteDimensional ℝ V]
  [NormedAddCommGroup W] [InnerProductSpace ℝ W] [FiniteDimensional ℝ W]

/-! ## The Hodge Laplacian -/

/-- The **Hodge Laplacian** of the two-step complex `U -A→ V -B→ W` acting on the
middle space: `Δ = A ∘ Aᵀ + Bᵀ ∘ B`. -/
def laplacian (A : U →ₗ[ℝ] V) (B : V →ₗ[ℝ] W) : V →ₗ[ℝ] V :=
  A.comp (LinearMap.adjoint A) + (LinearMap.adjoint B).comp B

/-- The **harmonic** subspace: the kernel of the Hodge Laplacian. -/
def harmonic (A : U →ₗ[ℝ] V) (B : V →ₗ[ℝ] W) : Submodule ℝ V :=
  LinearMap.ker (laplacian A B)

/-! ## Basic adjoint facts -/

/-
`ker (fᵀ) = (range f)ᗮ`: the kernel of the adjoint is the orthogonal complement
of the range.
-/
theorem ker_adjoint_eq_range_orthogonal (A : U →ₗ[ℝ] V) :
    LinearMap.ker (LinearMap.adjoint A) = (LinearMap.range A)ᗮ := by
  -- To prove equality of subspaces, we show each subspace is a subset of the other.
  apply le_antisymm;
  · intro x hx
    simp [Submodule.mem_orthogonal] at *;
    intro u; rw [ ← adjoint_inner_right ] ; simp +decide [ hx ] ;
  · intro x hx; simp_all +decide [ Submodule.mem_orthogonal', LinearMap.mem_ker ] ;
    exact ext_inner_right ℝ fun y => by simp +decide [ hx, LinearMap.adjoint_inner_left ] ;

/-
`ker f = (range fᵀ)ᗮ`.
-/
theorem ker_eq_range_adjoint_orthogonal (A : U →ₗ[ℝ] V) :
    LinearMap.ker A = (LinearMap.range (LinearMap.adjoint A))ᗮ := by
  convert ker_adjoint_eq_range_orthogonal ( LinearMap.adjoint A ) using 1;
  rw [ LinearMap.adjoint_adjoint ]

/-
The complex condition `B ∘ A = 0` dualizes to `Aᵀ ∘ Bᵀ = 0`.
-/
theorem adjoint_comp_adjoint_eq_zero (A : U →ₗ[ℝ] V) (B : V →ₗ[ℝ] W)
    (hAB : B.comp A = 0) :
    (LinearMap.adjoint A).comp (LinearMap.adjoint B) = 0 := by
  convert congr_arg ( LinearMap.adjoint ) hAB using 1; all_goals ext; simp

/-! ## The Weitzenböck identity and harmonic characterization -/

/-
**Weitzenböck / Bochner identity**: `⟪Δ x, x⟫ = ‖Aᵀ x‖² + ‖B x‖²`.
-/
theorem inner_laplacian_self (A : U →ₗ[ℝ] V) (B : V →ₗ[ℝ] W) (x : V) :
    (inner ℝ (laplacian A B x) x) = ‖LinearMap.adjoint A x‖ ^ 2 + ‖B x‖ ^ 2 := by
  rw [laplacian, LinearMap.add_apply, inner_add_left, LinearMap.comp_apply,
    LinearMap.comp_apply, ← LinearMap.adjoint_inner_right A,
    LinearMap.adjoint_inner_left B, real_inner_self_eq_norm_sq,
    real_inner_self_eq_norm_sq]

/-
The Hodge Laplacian is self-adjoint.
-/
theorem laplacian_isSelfAdjoint (A : U →ₗ[ℝ] V) (B : V →ₗ[ℝ] W) :
    IsSelfAdjoint (laplacian A B) := by
  simp_all +decide [ IsSelfAdjoint, laplacian ];
  simp_all +decide [ star, LinearMap.adjoint_comp ]

/-
**Harmonic = closed ∧ co-closed.** A chain is in the kernel of the Laplacian
iff `B x = 0` (closed) and `Aᵀ x = 0` (co-closed).
-/
theorem mem_harmonic_iff (A : U →ₗ[ℝ] V) (B : V →ₗ[ℝ] W) (x : V) :
    x ∈ harmonic A B ↔ LinearMap.adjoint A x = 0 ∧ B x = 0 := by
  constructor <;> intro h;
  · have h_inner : inner ℝ (laplacian A B x) x = ‖LinearMap.adjoint A x‖ ^ 2 + ‖B x‖ ^ 2 :=
      inner_laplacian_self A B x
    simp_all +decide [ harmonic ];
    exact ⟨ norm_eq_zero.mp ( by nlinarith ), norm_eq_zero.mp ( by nlinarith ) ⟩;
  · exact LinearMap.mem_ker.2 ( by unfold laplacian; aesop )

/-
The harmonic space equals `ker Aᵀ ⊓ ker B`.
-/
theorem harmonic_eq_inf (A : U →ₗ[ℝ] V) (B : V →ₗ[ℝ] W) :
    harmonic A B = LinearMap.ker (LinearMap.adjoint A) ⊓ LinearMap.ker B := by
  ext x;
  simp +decide [ mem_harmonic_iff ]

/-! ## Orthogonality of the three Hodge pieces -/

/-
The image of `A` (exact / cut part) lies inside `ker B` (closed part).
-/
omit [FiniteDimensional ℝ U] [FiniteDimensional ℝ V] [FiniteDimensional ℝ W] in
theorem range_le_ker (A : U →ₗ[ℝ] V) (B : V →ₗ[ℝ] W) (hAB : B.comp A = 0) :
    LinearMap.range A ≤ LinearMap.ker B := by
  exact fun x hx => by rcases hx with ⟨ u, rfl ⟩ ; simpa using LinearMap.congr_fun hAB u;

/-
`range A ⊥ range Bᵀ`.
-/
omit [FiniteDimensional ℝ U] in
theorem range_orthogonal_range_adjoint (A : U →ₗ[ℝ] V) (B : V →ₗ[ℝ] W)
    (hAB : B.comp A = 0) (u : U) (w : W) :
    inner ℝ (A u) (LinearMap.adjoint B w) = (0 : ℝ) := by
  convert inner_zero_left ( w ) using 1;
  convert LinearMap.adjoint_inner_right B ( A u ) w using 1;
  exact congr_arg₂ _ ( Eq.symm ( LinearMap.congr_fun hAB u ) ) rfl

/-
`harmonic ⊥ range A`.
-/
theorem harmonic_orthogonal_range (A : U →ₗ[ℝ] V) (B : V →ₗ[ℝ] W)
    {x : V} (hx : x ∈ harmonic A B) (u : U) :
    inner ℝ (A u) x = (0 : ℝ) := by
  -- From the definition of the harmonic subspace, we know that for all $u \in U$, $⟨A u, x⟩ = 0$.
  have h_harmonic_def : ∀ u : U, inner ℝ (A u) x = 0 := by
    intro u
    have h_adj : LinearMap.adjoint A x = 0 := by
      exact mem_harmonic_iff A B x |>.1 hx |>.1
    rw [ ← LinearMap.adjoint_inner_right, h_adj, inner_zero_right ];
  grind

/-
`harmonic ⊥ range Bᵀ`.
-/
theorem harmonic_orthogonal_range_adjoint (A : U →ₗ[ℝ] V) (B : V →ₗ[ℝ] W)
    {x : V} (hx : x ∈ harmonic A B) (w : W) :
    inner ℝ (LinearMap.adjoint B w) x = (0 : ℝ) := by
  have := mem_harmonic_iff A B x;
  simp_all +decide [ LinearMap.adjoint_inner_left ]

/-! ## The Hodge decomposition -/

/-
**Closed = exact ⊕ harmonic.** Inside the space of closed chains, every element
splits as an exact part plus a harmonic part: `ker B = range A ⊔ harmonic`.
-/
theorem ker_eq_range_sup_harmonic (A : U →ₗ[ℝ] V) (B : V →ₗ[ℝ] W)
    (hAB : B.comp A = 0) :
    LinearMap.ker B = LinearMap.range A ⊔ harmonic A B := by
  -- By Submodule.isCompl_orthogonal_of_hasOrthogonalProjection, IsCompl (range A) (range A)ᗮ, so (range A) ⊔ (range A)ᗮ = ⊤; hence x ∈ range A ⊔ (range A)ᗮ.
  have h_compl : IsCompl (LinearMap.range A) (LinearMap.range A)ᗮ := by
    grind +suggestions;
  apply le_antisymm;
  · intro x hx; have := h_compl.sup_eq_top; simp_all +decide [ Submodule.eq_top_iff' ] ;
    obtain ⟨ p, hp, q, hq, rfl ⟩ := Submodule.mem_sup.mp ( this x );
    -- Since $q \in (range A)^\perp$, we have $A^\dagger q = 0$.
    have hq_adj : LinearMap.adjoint A q = 0 := by
      rw [ ← ker_adjoint_eq_range_orthogonal ] at hq ; aesop;
    -- Since $q \in (range A)^\perp$, we have $B q = 0$.
    have hq_B : B q = 0 := by
      obtain ⟨ u, rfl ⟩ := hp; simp_all +decide [ LinearMap.ext_iff ] ;
    exact Submodule.add_mem_sup hp ( mem_harmonic_iff A B q |>.2 ⟨ hq_adj, hq_B ⟩ );
  · simp_all +decide [ LinearMap.ext_iff ];
    exact ⟨ fun x hx => by obtain ⟨ u, rfl ⟩ := hx; exact hAB u, fun x hx => by rw [ mem_harmonic_iff ] at hx; aesop ⟩

/-
**Hodge decomposition (spanning).** The three Hodge pieces fill the whole space:
`range A ⊔ harmonic ⊔ range Bᵀ = ⊤`.
-/
theorem hodge_decomposition_sup (A : U →ₗ[ℝ] V) (B : V →ₗ[ℝ] W)
    (hAB : B.comp A = 0) :
    LinearMap.range A ⊔ harmonic A B ⊔ LinearMap.range (LinearMap.adjoint B) = ⊤ := by
  rw [ ← ker_eq_range_sup_harmonic A B hAB ];
  rw [ show B.ker = ( LinearMap.range ( LinearMap.adjoint B ) ) ᗮ from ?_ ];
  · rw [ sup_comm, Submodule.sup_orthogonal_of_hasOrthogonalProjection ];
  · convert ker_eq_range_adjoint_orthogonal B using 1

/-
`range A` and `harmonic` are disjoint (their orthogonality forces trivial
intersection).
-/
theorem range_disjoint_harmonic (A : U →ₗ[ℝ] V) (B : V →ₗ[ℝ] W) :
    Disjoint (LinearMap.range A) (harmonic A B) := by
  refine' disjoint_iff_inf_le.mpr _;
  intro x hx
  obtain ⟨hx_range, hx_harmonic⟩ := hx
  have hx_orthogonal : ∀ y ∈ LinearMap.range A, inner ℝ x y = 0 := by
    intro y hy
    obtain ⟨u, hu⟩ := hy
    have h_inner : inner ℝ x (A u) = 0 := by
      have := harmonic_orthogonal_range A B hx_harmonic u; simp_all +decide [ real_inner_comm ] ;
    aesop;
  simpa using hx_orthogonal x hx_range

/-! ## The Hodge isomorphism: harmonic ≅ homology -/

/-
The harmonic space maps isomorphically onto the homology `ker B / range A`.
This is the **Hodge isomorphism**: harmonic representatives are a canonical set of
homology representatives.
-/
theorem harmonic_equiv_homology (A : U →ₗ[ℝ] V) (B : V →ₗ[ℝ] W)
    (hAB : B.comp A = 0) :
    Nonempty (harmonic A B ≃ₗ[ℝ]
      (LinearMap.ker B ⧸ (LinearMap.range A).comap (LinearMap.ker B).subtype)) := by
  refine' ⟨ _ ⟩;
  symm;
  have h_compl : IsCompl (LinearMap.range A |>.comap (LinearMap.ker B).subtype) (harmonic A B |>.comap (LinearMap.ker B).subtype) := by
    refine' ⟨ _, _ ⟩;
    · rw [ Submodule.disjoint_def ];
      simp +decide [ Submodule.mem_comap ];
      intro a ha x hx ha'; have := range_disjoint_harmonic A B; simp_all +decide [ Submodule.disjoint_def ] ;
      grind;
    · rw [ codisjoint_iff_le_sup ];
      intro x hx;
      obtain ⟨ y, hy ⟩ := Submodule.mem_sup.mp ( show x.val ∈ LinearMap.range A ⊔ harmonic A B from by rw [ ← ker_eq_range_sup_harmonic A B hAB ] ; exact x.2 );
      rcases hy with ⟨ hy₁, z, hz₁, hyz ⟩;
      exact Submodule.mem_sup.mpr ⟨ ⟨ y, by
        obtain ⟨ u, rfl ⟩ := hy₁; simp_all +decide [ LinearMap.ext_iff ] ; ⟩, by
        exact hy₁, ⟨ z, by
        exact mem_harmonic_iff A B z |>.1 hz₁ |>.2 ⟩, by
        exact hz₁, by aesop ⟩;
  refine' ( Submodule.quotientEquivOfIsCompl _ _ h_compl ) |> LinearEquiv.trans <| Submodule.comapSubtypeEquivOfLe _;
  exact fun x hx => mem_harmonic_iff A B x |>.1 hx |>.2

/-!
# The Cut/Cycle Decomposition of a Finite Graph

This section is the *combinatorial payoff* of the abstract Hodge program above.
We instantiate the abstract two-step complex with the degenerate one-step complex
of a finite oriented graph:

  `C⁰ = ℝ^V --d--> C¹ = ℝ^E --0--> 0`,

where `d = B` is the **coboundary / gradient** operator built from a signed
incidence matrix `B : Matrix E V ℝ` (each edge row maps a potential on vertices
to its difference across the edge).  Its formal adjoint `dᵀ = Bᵀ` is the
**divergence** operator.

Specialising the abstract Hodge decomposition `C¹ = range d ⊕ harmonic ⊕ range δ`
to this complex (the right-hand map is `0`, so `range δ = 0`) recovers the
classical **orthogonal decomposition of the edge space**

  `ℝ^E = cutSpace ⊕ cycleSpace`,

the fundamental theorem relating the *cut space* `range d` (potential/coboundary
flows) and the *cycle space* `ker dᵀ` (conservative/divergence-free flows).  The
dimension count `dim cut + dim cycle = |E|` is the rank–nullity form of the first
Betti number (cycle rank) of the graph.

-- !-- Lab Notes -- !--
Hypothesis: The classical "edge space = cut space ⊕ cycle space" fact is *not* an
  independent theorem — it is the abstract discrete Hodge decomposition of the
  trivial one-step complex, with the second boundary map taken to be `0`.  Setting
  `W = ℝ¹` and `B_map = 0` should make `harmonic = ker(dᵀ) = cycleSpace` and
  `range(δ) = 0`, collapsing the three-piece decomposition to two pieces.
Result: Confirmed.  `cycleSpace_eq_harmonic` shows the harmonic space of the zero
  second map is exactly the divergence-free flows; `hodge_graph_isCompl` is then a
  direct corollary of `hodge_decomposition_sup` + `range_disjoint_harmonic`.
Insight: The cut/cycle orthogonality (a staple of algebraic graph theory) is, on
  the nose, the orthogonality `harmonic ⊥ range A` from the abstract part — i.e.
  the *same* Bochner identity that gives "harmonic = closed ∧ co-closed" gives the
  Tutte/Whitney duality of cuts and cycles.
Failure analysis: Staying at the level of `LinearMap.range`/`LinearMap.ker` and
  quoting the abstract theorems keeps the proofs basis-free and short, avoiding
  `mulVec`/`EuclideanSpace` coercion pain.
-- !-- end -- !--
-/

open Matrix

namespace Graph

variable {V E : Type*} [Fintype V] [Fintype E] [DecidableEq V] [DecidableEq E]

/-- The **coboundary / gradient** operator `d : ℝ^V → ℝ^E` of a graph with signed
incidence matrix `B`.  A potential `f` on vertices is sent to its edge differences. -/
def coboundary (B : Matrix E V ℝ) :
    EuclideanSpace ℝ V →ₗ[ℝ] EuclideanSpace ℝ E :=
  Matrix.toEuclideanLin B

/-- The **cut space** (space of coboundary/potential flows): the range of `d`. -/
def cutSpace (B : Matrix E V ℝ) : Submodule ℝ (EuclideanSpace ℝ E) :=
  LinearMap.range (coboundary B)

/-- The **cycle space** (space of conservative/divergence-free flows): the kernel
of the divergence `dᵀ`. -/
def cycleSpace (B : Matrix E V ℝ) : Submodule ℝ (EuclideanSpace ℝ E) :=
  LinearMap.ker (LinearMap.adjoint (coboundary B))

/-
The adjoint of the coboundary `d = B` is the divergence `dᵀ = Bᵀ`.
-/
theorem adjoint_coboundary (B : Matrix E V ℝ) :
    LinearMap.adjoint (coboundary B) = Matrix.toEuclideanLin Bᵀ := by
  convert Matrix.toEuclideanLin_conjTranspose_eq_adjoint B |> Eq.symm

/-
The cycle space equals the kernel of the divergence operator `Bᵀ`.
-/
theorem cycleSpace_eq_ker_div (B : Matrix E V ℝ) :
    cycleSpace B = LinearMap.ker (Matrix.toEuclideanLin Bᵀ) := by
  exact adjoint_coboundary B ▸ rfl

/-
The cycle space is exactly the harmonic space of the one-step complex
`ℝ^V -d→ ℝ^E -0→ ℝ`.
-/
theorem cycleSpace_eq_harmonic (B : Matrix E V ℝ) :
    cycleSpace B =
      harmonic (coboundary B) (0 : EuclideanSpace ℝ E →ₗ[ℝ] EuclideanSpace ℝ (Fin 1)) := by
  simp +decide [ cycleSpace_eq_ker_div, harmonic_eq_inf ];
  rw [ adjoint_coboundary ]

/-
**Cut ⊥ Cycle.** Coboundary flows are orthogonal to conservative flows.
-/
theorem cut_orthogonal_cycle (B : Matrix E V ℝ)
    {x : EuclideanSpace ℝ E} (hx : x ∈ cutSpace B)
    {y : EuclideanSpace ℝ E} (hy : y ∈ cycleSpace B) :
    inner ℝ x y = (0 : ℝ) := by
  obtain ⟨ u, rfl ⟩ := hx;
  rw [ ← LinearMap.adjoint_inner_right ];
  rw [ cycleSpace_eq_ker_div ] at hy;
  rw [ adjoint_coboundary ] ; aesop

/-
**The Hodge decomposition of a graph.** The cut space and the cycle space are
complementary subspaces of the edge space `ℝ^E`: `ℝ^E = cutSpace ⊕ cycleSpace`.
-/
theorem hodge_graph_isCompl (B : Matrix E V ℝ) :
    IsCompl (cutSpace B) (cycleSpace B) := by
  refine' ⟨ _, _ ⟩;
  · convert DiscreteHodge.range_disjoint_harmonic _ _;
    convert cycleSpace_eq_harmonic B;
  · rw [ codisjoint_iff, ← top_le_iff ];
    intro x hx
    obtain ⟨y, z, hyz⟩ : ∃ y ∈ cutSpace B, ∃ z ∈ cycleSpace B, x = y + z := by
      have := hodge_decomposition_sup ( coboundary B ) ( 0 : EuclideanSpace ℝ E →ₗ[ℝ] EuclideanSpace ℝ ( Fin 1 ) ) ( by simp +decide );
      simp_all +decide [ Submodule.eq_top_iff', Submodule.mem_sup ];
      obtain ⟨ a, z, hz, rfl ⟩ := this x; exact ⟨ _, ⟨ a, rfl ⟩, _, by simpa [ cycleSpace_eq_harmonic ] using hz, rfl ⟩ ;
    exact hyz.elim fun w hw => hw.2 ▸ Submodule.add_mem_sup z hw.1

/-
**Cycle-rank / first Betti number (rank–nullity form).** The dimensions of the
cut space and the cycle space sum to the number of edges:
`dim(cutSpace) + dim(cycleSpace) = |E|`.  Equivalently
`dim(cycleSpace) = |E| − rank(B)` is the cycle rank of the graph.
-/
theorem finrank_cut_add_cycle (B : Matrix E V ℝ) :
    Module.finrank ℝ (cutSpace B) + Module.finrank ℝ (cycleSpace B) = Fintype.card E := by
  rw [ ← Submodule.finrank_sup_add_finrank_inf_eq ];
  rw [ hodge_graph_isCompl B |>.sup_eq_top, hodge_graph_isCompl B |>.inf_eq_bot ] ; simp +decide

end Graph

end DiscreteHodge