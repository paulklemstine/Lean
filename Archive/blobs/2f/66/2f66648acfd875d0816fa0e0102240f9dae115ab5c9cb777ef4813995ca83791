import Mathlib
import Logic.ProofSystemCollapse

/-!
# Density of the p-degree height ladder

This file develops, on top of the abstract Cook–Reckhow simulation framework of
`Logic.ProofSystemCollapse`, the **height ladder** of proof systems indexed by a
polynomial degree `k`, and proves that this ladder is *dense*: between any two
consecutive rungs `powSystem k` and `powSystem (k+1)` there sits a strictly
intermediate degree.

## Setup

A *size-indexed system* `sysOfSize s` proves every formula `n : ℕ` (using a
single proof object per formula) with proof-size `s n`.  Qualitative simulation
(`Simulates`) is therefore trivial — every such system proves everything — so the
meaningful comparison is the **quantitative** polynomial simulation `PSimulates`
from the catalog.  The basic computation `simulates_sysOfSize_iff` shows

  `PSimulates (sysOfSize s) (sysOfSize t) ↔ ∃ c k, ∀ n, s n ≤ c * (t n + 1) ^ k`,

i.e. `s` is polynomially bounded by `t`.  This makes the family

  `powSystem k := sysOfSize (fun n => 2 ^ (n ^ k))`

a strictly increasing ladder of *degrees* (larger proof-size = higher / weaker
degree).

## The parity-gluing witness

The intermediate witness `interPowSys k` is built from the **parity-split** size
function

  `interSize k n = if Even n then 2 ^ (n ^ (k+1)) else 2 ^ (n ^ k)`.

Locally it agrees with the next rung on even inputs and with the current rung on
odd inputs; gluing these two regimes produces a *global* degree that is

* strictly **above** `powSystem k`, because on infinitely many even indices its
  size `2 ^ (n ^ (k+1))` outgrows every polynomial overhead applied to
  `2 ^ (n ^ k)`; yet
* strictly **below** `powSystem (k+1)`, because on infinitely many odd indices it
  drops back to `2 ^ (n ^ k)`, so it cannot polynomially dominate
  `2 ^ (n ^ (k+1))`.

The non-strict comparisons hold everywhere (`interSize` is sandwiched between the
two rungs), and the two strictness failures are witnessed by the single
asymptotic gap lemma `pow_tower_dominates`, evaluated at an even resp. odd index
extracted by `exists_even_ge` / `exists_odd_ge`.

## Key results

- `simulates_sysOfSize_iff`: the comparison criterion for size-indexed systems.
- `pow_tower_dominates`: `2 ^ (n ^ (k+1))` eventually dominates
  `c * (2 ^ (n ^ k) + 1) ^ K` for `k ≥ 1`.
- `powSystem_lt_interPowSys`, `interPowSys_lt_powSystem_succ`: the two strict
  comparisons.
- `ladder_dense`: the consecutive-rung density theorem.
-/

namespace LadderDensity

open ProofSystemCollapse

/-! ## Size-indexed systems -/

/-- The **size-indexed system** for a size function `s : ℕ → ℕ`.  Formulas are
natural numbers; there is exactly one proof object per formula `n` (namely `n`
itself), establishing `n` with size `s n`. -/
def sysOfSize (s : ℕ → ℕ) : ProofSys ℕ where
  Proof := ℕ
  concl := id
  size := s

/-- **Comparison criterion.** One size-indexed system p-simulates another exactly
when the first size function is polynomially bounded by the second. -/
theorem simulates_sysOfSize_iff (s t : ℕ → ℕ) :
    PSimulates (sysOfSize s) (sysOfSize t) ↔
      ∃ c k : ℕ, ∀ n, s n ≤ c * (t n + 1) ^ k := by
  constructor;
  · rintro ⟨ tr, c, k, h₁, h₂ ⟩;
    exact ⟨ c, k, fun n => by simpa [ show tr n = n from h₁ n ] using h₂ n ⟩;
  · rintro ⟨ c, k, h ⟩;
    exact ⟨ fun n => n, c, k, fun n => rfl, fun n => h n ⟩

/-! ## The ladder and the parity-glued witness -/

/-- The `k`-th rung of the height ladder: proofs of formula `n` have size
`2 ^ (n ^ k)`. -/
def powSystem (k : ℕ) : ProofSys ℕ := sysOfSize (fun n => 2 ^ (n ^ k))

/-- The **parity-split size function**: `2 ^ (n ^ (k+1))` on even inputs and
`2 ^ (n ^ k)` on odd inputs. -/
def interSize (k n : ℕ) : ℕ := if Even n then 2 ^ (n ^ (k + 1)) else 2 ^ (n ^ k)

/-- The **intermediate witness system** built by gluing the two growth regimes via
`interSize`. -/
def interPowSys (k : ℕ) : ProofSys ℕ := sysOfSize (interSize k)

/-- The strict ladder order: `S` is strictly below `T` when `S` p-simulates `T`
but not conversely. -/
def LadderLT (S T : ProofSys ℕ) : Prop := PSimulates S T ∧ ¬ PSimulates T S

/-! ## Elementary monotonicity and parity extraction -/

/-- `2 ^ (n ^ k) ≤ 2 ^ (n ^ (k+1))` for `k ≥ 1`.  (Note: this fails for `k = 0`
at `n = 0`, since `0 ^ 0 = 1 > 0 = 0 ^ 1`.) -/
theorem two_pow_pow_mono (k n : ℕ) (hk : 1 ≤ k) : 2 ^ (n ^ k) ≤ 2 ^ (n ^ (k + 1)) := by
  by_cases hn : n = 0 <;> simp_all +decide [ pow_succ' ];
  · cases k <;> norm_num at *;
  · exact pow_le_pow_right₀ ( by decide ) ( by nlinarith [ Nat.pos_of_ne_zero hn, Nat.pow_le_pow_right ( Nat.pos_of_ne_zero hn ) hk ] )

/-- `interSize` is bounded below by the current rung (for `k ≥ 1`). -/
theorem pow_le_interSize (k n : ℕ) (hk : 1 ≤ k) : 2 ^ (n ^ k) ≤ interSize k n := by
  unfold interSize; split_ifs <;> [ exact two_pow_pow_mono k n hk; exact le_rfl ] ;

/-- `interSize` is bounded above by the next rung (for `k ≥ 1`). -/
theorem interSize_le_pow_succ (k n : ℕ) (hk : 1 ≤ k) :
    interSize k n ≤ 2 ^ (n ^ (k + 1)) := by
  unfold interSize; split_ifs <;> [ simp ; exact two_pow_pow_mono k n hk ] ;

/-- There are arbitrarily large even numbers. -/
theorem exists_even_ge (N : ℕ) : ∃ n, N ≤ n ∧ Even n :=
  ⟨2 * N, by omega, ⟨N, by ring⟩⟩

/-- There are arbitrarily large odd numbers. -/
theorem exists_odd_ge (N : ℕ) : ∃ n, N ≤ n ∧ Odd n :=
  ⟨2 * N + 1, by omega, ⟨N, by ring⟩⟩

/-! ## The asymptotic gap lemma -/

/-- **Asymptotic domination.** For `k ≥ 1` and any polynomial overhead given by a
constant `c` and exponent `K`, the tower `2 ^ (n ^ (k+1))` eventually strictly
dominates `c * (2 ^ (n ^ k) + 1) ^ K`.

The proof bounds the overhead by `2 ^ (c + K * n ^ k + K)` and compares exponents:
`c + K * n ^ k + K < n ^ (k+1) = n * n ^ k` once `n` exceeds `c + K`, using
`n ^ k ≥ n` for `k ≥ 1`. -/
theorem pow_tower_dominates (k c K : ℕ) (hk : 1 ≤ k) :
    ∃ N, ∀ n, N ≤ n → c * (2 ^ (n ^ k) + 1) ^ K < 2 ^ (n ^ (k + 1)) := by
  -- We can choose $N$ such that for all $n \geq N$, we have $c + K * n^k + K < n * n^k$.
  obtain ⟨N, hN⟩ : ∃ N : ℕ, ∀ n ≥ N, c + K * n ^ k + K < n * n ^ k := by
    refine' ⟨ c + K + K + 1, fun n hn => _ ⟩ ; nlinarith [ Nat.pow_le_pow_right ( by linarith : 1 ≤ n ) hk, Nat.pow_le_pow_left ( by linarith : n ≥ K + 1 ) k ];
  use N + c + K + 1;
  intro n hn
  have h_bound : c * (2 ^ (n ^ k) + 1) ^ K ≤ 2 ^ (c + K * n ^ k + K) := by
    have h_bound : c * (2 ^ (n ^ k) + 1) ^ K ≤ 2 ^ c * (2 ^ (n ^ k + 1)) ^ K := by
      gcongr;
      · exact le_of_lt ( Nat.recOn c ( by norm_num ) fun n ihn => by rw [ pow_succ' ] ; linarith [ Nat.one_le_pow n 2 zero_lt_two ] );
      · grind;
    convert h_bound using 1 ; ring;
    ring;
  exact lt_of_le_of_lt h_bound ( pow_lt_pow_right₀ ( by decide ) ( by simpa only [ pow_succ' ] using hN n ( by linarith ) ) )

/-! ## The four comparisons -/

/-- The current rung p-simulates the intermediate witness (non-strict, lower). -/
theorem powSystem_psim_interPowSys (k : ℕ) (hk : 1 ≤ k) :
    PSimulates (powSystem k) (interPowSys k) := by
  apply simulates_sysOfSize_iff _ _ |>.2;
  exact ⟨ 1, 1, fun n => by simpa using pow_le_interSize k n hk |> Nat.le_succ_of_le ⟩

/-- The intermediate witness is **not** p-simulated by the current rung: it
strictly exceeds it on even indices. -/
theorem not_interPowSys_psim_powSystem (k : ℕ) (hk : 1 ≤ k) :
    ¬ PSimulates (interPowSys k) (powSystem k) := by
  intro h
  obtain ⟨c, K, h⟩ := simulates_sysOfSize_iff (interSize k) (fun n => 2 ^ (n ^ k)) |>.1 h
  obtain ⟨N, hN⟩ := pow_tower_dominates k c K hk
  obtain ⟨n, hnN, hne⟩ := exists_even_ge N
  have h_even : interSize k n = 2 ^ (n ^ (k + 1)) := by
    exact if_pos hne
  have h_contra : c * (2 ^ (n ^ k) + 1) ^ K ≥ 2 ^ (n ^ (k + 1)) := by
    exact h_even ▸ h n
  have h_contra' : c * (2 ^ (n ^ k) + 1) ^ K < 2 ^ (n ^ (k + 1)) := by
    grind +locals
  linarith

/-- The intermediate witness is p-simulated by the next rung (non-strict, upper). -/
theorem interPowSys_psim_powSystem_succ (k : ℕ) (hk : 1 ≤ k) :
    PSimulates (interPowSys k) (powSystem (k + 1)) := by
  have := @simulates_sysOfSize_iff;
  exact this _ _ |>.2 ⟨ 1, 1, fun n => by simpa using Nat.le_succ_of_le ( interSize_le_pow_succ k n hk ) ⟩

/-- The next rung is **not** p-simulated by the intermediate witness: the witness
drops to the lower growth rate on odd indices. -/
theorem not_powSystem_succ_psim_interPowSys (k : ℕ) (hk : 1 ≤ k) :
    ¬ PSimulates (powSystem (k + 1)) (interPowSys k) := by
  intro h
  obtain ⟨c, K, h⟩ := simulates_sysOfSize_iff _ _ |>.1 h;
  obtain ⟨ N, hN ⟩ := pow_tower_dominates k c K hk;
  obtain ⟨ n, hnN, hno ⟩ := exists_odd_ge N; specialize h n; simp_all +decide [ interSize ] ;
  grind

/-! ## Main density theorems -/

/-- **Lower strictness.** `powSystem k` is strictly below `interPowSys k`. -/
theorem powSystem_lt_interPowSys (k : ℕ) (hk : 1 ≤ k) :
    LadderLT (powSystem k) (interPowSys k) :=
  ⟨powSystem_psim_interPowSys k hk, not_interPowSys_psim_powSystem k hk⟩

/-- **Upper strictness.** `interPowSys k` is strictly below `powSystem (k+1)`. -/
theorem interPowSys_lt_powSystem_succ (k : ℕ) (hk : 1 ≤ k) :
    LadderLT (interPowSys k) (powSystem (k + 1)) :=
  ⟨interPowSys_psim_powSystem_succ k hk, not_powSystem_succ_psim_interPowSys k hk⟩

/-- **Density of the height ladder.** For every `k ≥ 1` there is a system strictly
between consecutive rungs `powSystem k` and `powSystem (k+1)`, namely the
parity-glued witness `interPowSys k`. -/
theorem ladder_dense (k : ℕ) (hk : 1 ≤ k) :
    ∃ M : ProofSys.{0, 0} ℕ, LadderLT (powSystem k) M ∧ LadderLT M (powSystem (k + 1)) :=
  ⟨interPowSys k, powSystem_lt_interPowSys k hk, interPowSys_lt_powSystem_succ k hk⟩

end LadderDensity