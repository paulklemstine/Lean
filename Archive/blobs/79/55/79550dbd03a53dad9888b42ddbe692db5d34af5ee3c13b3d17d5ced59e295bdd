import Mathlib

open scoped InnerProductSpace BigOperators Topology

namespace RicciFlowHodgeFixedPoints

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-! ## The Ricci-flow / renormalization step -/

/-- One discrete Ricci-flow (renormalization) step `T = 1 - α·L`, acting by
`x ↦ x - α • (L x)`, modeled as an element of `Module.End ℝ E`. -/
def ricciStep (L : E →ₗ[ℝ] E) (α : ℝ) : Module.End ℝ E := (1 : Module.End ℝ E) - α • L

@[simp] theorem ricciStep_apply (L : E →ₗ[ℝ] E) (α : ℝ) (x : E) :
    ricciStep L α x = x - α • (L x) := by
  simp [ricciStep]

/-- The Dirichlet (curvature) energy of a cochain `x` with respect to `L`. -/
def dirichlet (L : E →ₗ[ℝ] E) (x : E) : ℝ := ⟪x, L x⟫_ℝ

/-! ## Fixed points of the flow are exactly the harmonics -/

/-
!-- comment: If `L h = 0` then `T h = h - α•0 = h`. -- !--
-/
theorem ricciStep_harmonic_fixed (L : E →ₗ[ℝ] E) (α : ℝ) {h : E} (hh : L h = 0) :
    ricciStep L α h = h := by
  unfold ricciStep; simp [hh]

/-
!-- comment: `T x = x ↔ α•(L x) = 0`; for `α ≠ 0`, `smul_eq_zero` gives `L x = 0`. -- !--

**Renormalization fixed points are exactly the harmonics.** For a nonzero step
`α`, a cochain `x` is an exact fixed point of the Ricci-flow step iff it is harmonic
(`L x = 0`).
-/
theorem ricciStep_fixed_iff_harmonic (L : E →ₗ[ℝ] E) {α : ℝ} (hα : α ≠ 0) (x : E) :
    ricciStep L α x = x ↔ L x = 0 := by
  simp [ricciStep, hα]

/-
!-- comment: `1 - ricciStep L α = α • L` (`sub_sub_cancel`), so its kernel is
`ker (α • L) = ker L` for `α ≠ 0` by `LinearMap.ker_smul`. -- !--

**The fixed-point set is the harmonic submodule.** The fixed points of the
Ricci-flow step form the submodule `ker (1 - T)`, which for `α ≠ 0` equals `ker L`.
-/
theorem ricciStep_fixedSubmodule_eq_ker (L : E →ₗ[ℝ] E) {α : ℝ} (hα : α ≠ 0) :
    LinearMap.ker ((1 : Module.End ℝ E) - ricciStep L α) = LinearMap.ker L := by
  ext x;
  simp +decide [ ricciStep, hα ]

/-! ## Dissipation of the Dirichlet (curvature) energy -/

/-
!-- comment: Expand `⟪Tx, L(Tx)⟫ = ⟪x,Lx⟫ - 2α⟪Lx,Lx⟫ + α²⟪Lx,L(Lx)⟫` using
self-adjointness `⟪Lu,v⟫=⟪u,Lv⟫`; then bound `⟪Lx,L(Lx)⟫ ≤ λ⟪Lx,Lx⟫` (Rayleigh),
scaled by `α² ≥ 0`. -- !--

**Ricci-flow energy dissipation.** With `L` self-adjoint and satisfying the
Rayleigh upper bound `⟪z, L z⟫ ≤ λ⟪z,z⟫`, one Ricci-flow step decreases the Dirichlet
energy by at least `α(2 - αλ)‖L x‖²`.
-/
theorem ricciStep_dirichlet_dissipation (L : E →ₗ[ℝ] E) (α lam : ℝ)
    (hsymm : ∀ u v : E, ⟪L u, v⟫_ℝ = ⟪u, L v⟫_ℝ)
    (hupper : ∀ z : E, ⟪z, L z⟫_ℝ ≤ lam * ⟪z, z⟫_ℝ)
    (x : E) :
    dirichlet L (ricciStep L α x)
      ≤ dirichlet L x - α * (2 - α * lam) * ⟪L x, L x⟫_ℝ := by
  unfold dirichlet ricciStep;
  simp +decide [ inner_sub_left, inner_sub_right, inner_smul_left, inner_smul_right, hsymm ];
  have := hupper ( L x ) ; have := hupper ( L ( L x ) ) ; simp_all +decide ;
  rw [ show ⟪x, L ( L x )⟫_ℝ = ⟪L x, L x⟫_ℝ by rw [ ← hsymm ] ] ; ring_nf at *;
  simp_all +decide ; nlinarith [ sq_nonneg ( α * lam - 1 ), sq_nonneg ( α * lam + 1 ) ] ;

/-
!-- comment: From `ricciStep_dirichlet_dissipation`, if `α(2-αλ) > 0` and `Lx ≠ 0`
then `⟪Lx,Lx⟫ > 0`, so the energy drop is strictly positive. -- !--

**Strict decrease off harmonics.** When the step factor `α(2-αλ)` is positive and
`x` is not harmonic, the Dirichlet energy strictly decreases.
-/
theorem ricciStep_dirichlet_strict (L : E →ₗ[ℝ] E) (α lam : ℝ)
    (hsymm : ∀ u v : E, ⟪L u, v⟫_ℝ = ⟪u, L v⟫_ℝ)
    (hupper : ∀ z : E, ⟪z, L z⟫_ℝ ≤ lam * ⟪z, z⟫_ℝ)
    (hstep : 0 < α * (2 - α * lam)) {x : E} (hx : L x ≠ 0) :
    dirichlet L (ricciStep L α x) < dirichlet L x := by
  convert lt_of_le_of_lt ( ricciStep_dirichlet_dissipation L α lam hsymm hupper x ) ( sub_lt_self _ _ ) using 1;
  exact mul_pos hstep ( by rw [ real_inner_self_eq_norm_sq ] ; exact sq_pos_of_pos ( norm_pos_iff.mpr hx ) )

/-
!-- comment: Iterating the non-strict bound (with the trivial bound `0 ≤ ⟪Lx,Lx⟫`
and `0 ≤ α(2-αλ)`) gives `dirichlet (T^(k+1) x) ≤ dirichlet (T^k x)`, hence
antitone along the flow. -- !--

**Monotone energy along the flow.** Under the dissipation hypotheses with a
non-negative step factor, the Dirichlet energy is non-increasing along the Ricci
flow.
-/
theorem ricciFlow_dirichlet_antitone (L : E →ₗ[ℝ] E) (α lam : ℝ)
    (hsymm : ∀ u v : E, ⟪L u, v⟫_ℝ = ⟪u, L v⟫_ℝ)
    (hupper : ∀ z : E, ⟪z, L z⟫_ℝ ≤ lam * ⟪z, z⟫_ℝ)
    (hpos : ∀ z : E, 0 ≤ ⟪z, z⟫_ℝ)
    (hstep : 0 ≤ α * (2 - α * lam)) (x : E) (k : ℕ) :
    dirichlet L (((ricciStep L α) ^ (k + 1)) x) ≤ dirichlet L (((ricciStep L α) ^ k) x) := by
  rw [ pow_succ' ];
  exact le_trans ( ricciStep_dirichlet_dissipation L α lam hsymm hupper _ ) ( sub_le_self _ ( mul_nonneg hstep ( hpos _ ) ) )

/-! ## Bridge to CSS quantum codes: fixed-point dimension = logical dimension -/

/-
!-- comment: `ricciStep_fixedSubmodule_eq_ker` equates the fixed-point submodule
with `ker L`; taking `finrank` of both sides gives the dimension equality. -- !--

**Code/cohomology bridge.** For a nonzero step on a finite-dimensional cochain
space, the dimension of the renormalization fixed-point space equals `dim (ker L)`,
i.e. the number of logical degrees of freedom (harmonic cochains / logical qubits) of
the underlying CSS code.
-/
theorem ricciFlow_logicalDim_eq_kerDim
    [FiniteDimensional ℝ E] (L : E →ₗ[ℝ] E) {α : ℝ} (hα : α ≠ 0) :
    Module.finrank ℝ (LinearMap.ker ((1 : Module.End ℝ E) - ricciStep L α))
      = Module.finrank ℝ (LinearMap.ker L) := by
  rw [ ricciStep_fixedSubmodule_eq_ker L hα ]

end RicciFlowHodgeFixedPoints