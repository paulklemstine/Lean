-/

open scoped InnerProductSpace
open Filter Topology Matrix

namespace RicciFlowQEC

/-! ## 1.  CSS codes as `ZMod 2` chain complexes -/

-- !-- The CSS commutation condition is just the chain-complex relation read entrywise:
-- `Hx * Hzᵀ = 0` says every `X`-row is orthogonal to every `Z`-row over the ground ring.
-- (Cf. `Catalog/Physics/StabilizerBounds.lean`, where such codes' parameters are bounded.) -- !--
theorem css_stabilizers_commute {α β γ R : Type*} [Fintype γ] [CommRing R]
    (Hx : Matrix α γ R) (Hz : Matrix β γ R) (h : Hx * Hzᵀ = 0) :
    ∀ i j, ∑ k, Hx i k * Hz j k = 0 := by
  intro i j
  have := congrFun (congrFun h i) j
  simpa [Matrix.mul_apply, Matrix.transpose_apply] using this

-- !-- Homological reformulation: `∂₁ ∘ ∂₂ = 0` is equivalent to `range ∂₂ ≤ ker ∂₁`,
-- the well-definedness of homology `ker ∂₁ / range ∂₂` (the space of logical qubits). -- !--
theorem css_homology_well_defined
    {R M₂ M₁ M₀ : Type*} [CommRing R]
    [AddCommGroup M₂] [AddCommGroup M₁] [AddCommGroup M₀]
    [Module R M₂] [Module R M₁] [Module R M₀]
    (d₂ : M₂ →ₗ[R] M₁) (d₁ : M₁ →ₗ[R] M₀) (h : d₁ ∘ₗ d₂ = 0) :
    LinearMap.range d₂ ≤ LinearMap.ker d₁ :=
  LinearMap.range_le_ker_iff.mpr h

/-! ## 2.  The discrete Hodge Laplacian `Δ = ∂* ∂` -/

variable {𝕜 E F : Type*} [RCLike 𝕜]
  [NormedAddCommGroup E] [NormedAddCommGroup F]
  [InnerProductSpace 𝕜 E] [InnerProductSpace 𝕜 F]
  [FiniteDimensional 𝕜 E] [FiniteDimensional 𝕜 F]

/-- The (down) Hodge Laplacian of a boundary map `D = ∂`. -/
noncomputable def hodgeLaplacian (D : E →ₗ[𝕜] F) : E →ₗ[𝕜] E :=
  LinearMap.adjoint D ∘ₗ D

-- !-- `Δ = ∂* ∂` is self-adjoint: immediate from `Mathlib`'s adjoint calculus. -- !--
theorem hodge_laplacian_isSymmetric (D : E →ₗ[𝕜] F) :
    (hodgeLaplacian D).IsSymmetric := by
  have := LinearMap.isPositive_adjoint_comp_self D
  exact this.isSymmetric

-- !-- `Δ = ∂* ∂` is positive: `⟪Δ x, x⟫ = ‖∂ x‖² ≥ 0`. -- !--
theorem hodge_laplacian_isPositive (D : E →ₗ[𝕜] F) :
    (hodgeLaplacian D).IsPositive :=
  LinearMap.isPositive_adjoint_comp_self D

-- !-- Discrete Hodge theorem: the harmonic forms `ker Δ` are exactly the cocycles `ker ∂`,
-- because `Δ x = 0 ⟹ ⟪∂* ∂ x, x⟫ = ‖∂ x‖² = 0 ⟹ ∂ x = 0`. -- !--
theorem hodge_harmonic_eq_ker (D : E →ₗ[𝕜] F) :
    LinearMap.ker (hodgeLaplacian D) = LinearMap.ker D := by
  unfold hodgeLaplacian
  ext x
  simp only [LinearMap.mem_ker, LinearMap.comp_apply]
  constructor
  · intro h
    have h2 : (⟪LinearMap.adjoint D (D x), x⟫_𝕜) = 0 := by rw [h]; simp
    rw [LinearMap.adjoint_inner_left] at h2
    exact inner_self_eq_zero.mp h2
  · intro h; rw [h]; simp

/-! ## 3.  The renormalization (linearized Ricci–Hodge) flow -/

/-- One renormalization step on a real configuration space: an affine map with
contraction (curvature) factor `a` and source term `b`.  This is the linearization of a
coupled discrete Ricci-flow / Hodge-Laplacian weight renormalization about a base point. -/
def renorm {V : Type*} [AddCommGroup V] [Module ℝ V] (a : ℝ) (b : V) : V → V :=
  fun x => a • x + b

variable {V : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V] [CompleteSpace V] [Nonempty V]

-- !-- The flow is a Banach contraction precisely because `‖a • (x - y)‖ = ‖a‖ · ‖x - y‖`. -- !--
omit [CompleteSpace V] [Nonempty V] in
theorem renorm_contracting (a : ℝ) (b : V) (ha : ‖a‖ < 1) :
    ContractingWith ‖a‖₊ (renorm a b) := by
  refine ⟨by simpa using ha, ?_⟩
  rw [lipschitzWith_iff_dist_le_mul]
  intro x y
  simp only [dist_eq_norm, renorm]
  have h1 : a • x + b - (a • y + b) = a • (x - y) := by module
  rw [h1, norm_smul]
  simp [Real.norm_eq_abs]

/-- The unique scale-invariant configuration: the fixed point of the renormalization flow. -/
noncomputable def renormFixedPoint (a : ℝ) (b : V) (ha : ‖a‖ < 1) : V :=
  ContractingWith.fixedPoint (renorm a b) (renorm_contracting a b ha)

-- !-- Scale invariance: the distinguished configuration is genuinely fixed by the flow. -- !--
theorem renorm_fixedPoint_isFixedPt (a : ℝ) (b : V) (ha : ‖a‖ < 1) :
    Function.IsFixedPt (renorm a b) (renormFixedPoint a b ha) :=
  ContractingWith.fixedPoint_isFixedPt (renorm_contracting a b ha)

-- !-- Uniqueness of the scale-invariant fixed point (Banach). -- !--
theorem renorm_fixedPoint_unique (a : ℝ) (b : V) (ha : ‖a‖ < 1) {x : V}
    (hx : Function.IsFixedPt (renorm a b) x) : x = renormFixedPoint a b ha :=
  ContractingWith.fixedPoint_unique (renorm_contracting a b ha) hx

-- !-- Global attractor: the renormalization-group flow converges to the fixed point from
-- *every* initial configuration — the convergence half of the conjecture. -- !--
theorem renorm_global_attractor (a : ℝ) (b : V) (ha : ‖a‖ < 1) (x₀ : V) :
    Tendsto (fun n => (renorm a b)^[n] x₀) atTop (𝓝 (renormFixedPoint a b ha)) :=
  ContractingWith.tendsto_iterate_fixedPoint (renorm_contracting a b ha) x₀

/-! ## 4.  The renormalization threshold (the conjecture's "iff") -/

-- !-- Threshold criterion: along a nonzero mode `x₀`, the homogeneous flow `x ↦ r·x`
-- converges to the (scale-invariant) fixed point `0` **iff** the curvature factor `r`
-- lies strictly below the critical value `1` — "convergence iff threshold bounded away". -- !--
theorem renorm_threshold (x₀ : ℝ) (hx : x₀ ≠ 0) (r : ℝ) (hr : 0 ≤ r) :
    Tendsto (fun n => r ^ n * x₀) atTop (𝓝 0) ↔ r < 1 := by
  constructor
  · intro h
    have h2 : Tendsto (fun n => r ^ n) atTop (𝓝 0) := by
      have := h.mul_const x₀⁻¹
      simpa [mul_assoc, mul_inv_cancel₀ hx] using this
    have := (tendsto_pow_atTop_nhds_zero_iff (r := r)).mp h2
    rwa [abs_of_nonneg hr] at this
  · intro h
    have h2 : Tendsto (fun n => r ^ n) atTop (𝓝 0) := by
      rw [tendsto_pow_atTop_nhds_zero_iff, abs_of_nonneg hr]; exact h
    have := h2.mul_const x₀
    simpa using this

/-! ## 5.  Bridge: Hodge heat-flow fixed points are the harmonic forms -/

-- !-- The coupled-flow bridge: the *Hodge* heat-flow renormalization step
-- `x ↦ x - ε · Δ x` (with `Δ = ∂* ∂`) has fixed points exactly the harmonic forms
-- `ker ∂` whenever the step `ε ≠ 0` — directly linking flow stability to homology. -- !--
theorem hodge_flow_fixedPoints_eq_harmonic (D : E →ₗ[𝕜] F) (ε : 𝕜) (hε : ε ≠ 0) (x : E) :
    Function.IsFixedPt (fun y => y - ε • (hodgeLaplacian D y)) x ↔ x ∈ LinearMap.ker D := by
  have hker := hodge_harmonic_eq_ker D
  unfold Function.IsFixedPt
  constructor
  · intro h
    have hz : ε • (hodgeLaplacian D x) = 0 := by
      have := sub_eq_self.mp h
      simpa using this
    have hL : hodgeLaplacian D x = 0 := by
      rcases smul_eq_zero.mp hz with h1 | h2
      · exact absurd h1 hε
      · exact h2
    rw [← LinearMap.mem_ker, hker] at hL
    exact hL
  · intro h
    rw [← hker, LinearMap.mem_ker] at h
    simp [h]

end RicciFlowQEC
