/-
  # Berggren Tropical Ultrametric
  ## A nonarchimedean ultrametric on Berggren / Lorentz arithmetic states

  Bridge: connects **Pythagorean arithmetic** (Berggren tree, `childA/B/C`,
  `IsPythag` from `Algebra.BerggrenLorentz.Core`) ↔ **tropical valuation theory**
  (`TropicalValuationObject` from `Bridges.CategoricalTropicalUltrametric`) ↔
  **nonarchimedean / ultrametric geometry**.

  ## Core principle

  A `2`-adic *content valuation* `w(a,b,c) = min(v₂ a, v₂ b, v₂ c) ∈ ℕ∞` on
  arithmetic states `ℤ³` is a genuine additive valuation: it satisfies the
  strong (nonarchimedean) triangle inequality
  `min (w u) (w v) ≤ w (u + v)` and vanishes (`= ⊤`) exactly at the origin.
  Pulling this back through `φ : ℕ∞ → ℝ`, `φ n = (1/2)^n`, `φ ⊤ = 0`, produces a
  **real ultrametric** `bdist x y = φ (w (x - y))` on Berggren states, satisfying
  symmetry, separation, and the strong triangle inequality.

  Because the Berggren successor maps `childA, childB, childC` are *integer-linear*,
  they are **valuation-monotone** (`w u ≤ w (childA u)`) and therefore
  **nonexpanding** for `bdist`.  Finally the value object `ℕ∞` with `(min, +)`
  (the min-plus tropical semiring, presented in order-dual form) is an explicit
  `CategoricalTropicalUltrametric.TropicalValuationObject`, and `w` is a tropical
  morphism into it — the promised functorial bridge.

  -- !-- Lab Notebook -- !--
  -- Hypothesis: the 2-adic content of a Berggren state ℤ³ is a valuation, and the
  --   Berggren generators (being integer-linear) cannot lower it, so they are
  --   ultrametric-nonexpanding maps.
  -- Result: fully proved — w_strong_triangle, bdist_strong_triangle,
  --   bdist_eq_zero_iff, c{A,B,C}_nonexpanding, and the tropical-object bridge
  --   tropMinPlus / weight_tropical_compat, all sorry-free.
  -- Insight: monotonicity of the generators is *automatic* from integer-linearity
  --   + `emultiplicity_mul` (v₂(k·x) ≥ v₂ x) + `min_le_emultiplicity_add`; no
  --   special structure of the Berggren matrices is needed beyond integrality.
  --   The Lorentz form / Pythagorean structure is orthogonal to the ultrametric:
  --   the bridge works for ANY integer-linear self-map of ℤ³ (see `w_le_combo`).
  -- Failure analysis: forcing a `UltraNormObj` (norm : α → ℕ multiplicative) is
  --   impossible for a nontrivial valuation, since ℕ-valued multiplicative
  --   ultranorms on a domain are essentially trivial; the order-valued (ℕ∞)
  --   formulation is the correct primitive, exactly as the research concept
  --   predicted ("formalize the order-valued norm first").
  -- !-- Lab Notebook -- !--
-/

import Mathlib
import Algebra.BerggrenLorentz.Core
import Bridges.CategoricalTropicalUltrametric

open scoped Classical

noncomputable section

namespace BerggrenTropicalUltrametric

/-! ## §1. The content valuation `w` on arithmetic states `ℤ³` -/

/-- The `2`-adic content valuation of a Berggren arithmetic state.
    `w (a,b,c) = min (v₂ a) (v₂ b) (v₂ c) ∈ ℕ∞`, with `v₂ = emultiplicity 2`.
    This is the additive valuation of the *content* `gcd(a,b,c)` at the prime `2`. -/
def w (u : ℤ × ℤ × ℤ) : ℕ∞ :=
  min (emultiplicity (2 : ℤ) u.1)
    (min (emultiplicity (2 : ℤ) u.2.1) (emultiplicity (2 : ℤ) u.2.2))

/-- `v₂ a = ⊤ ↔ a = 0`: finite multiplicity at a prime for nonzero integers. -/
theorem emult2_top_iff (a : ℤ) : emultiplicity (2 : ℤ) a = ⊤ ↔ a = 0 := by
  constructor
  · intro h; by_contra ha
    have hfin : FiniteMultiplicity (2 : ℤ) a := padicValRat.finite_int_prime_iff.mpr ha
    exact (lt_irrefl _ (h ▸ emultiplicity_lt_top.mpr hfin))
  · rintro rfl; exact emultiplicity_zero 2

-- !-- w 0 = ⊤ since each coordinate is 0 and v₂ 0 = ⊤. -- !--
@[simp] theorem w_zero : w (0 : ℤ × ℤ × ℤ) = ⊤ := by simp [w]

-- !-- Each coordinate valuation is invariant under negation, so `w` is too. -- !--
@[simp] theorem w_neg (u : ℤ × ℤ × ℤ) : w (-u) = w u := by
  simp [w, emultiplicity_neg]

-- !-- min over three coords is ⊤ iff each coord valuation is ⊤ iff each coord is 0. -- !--
theorem w_eq_top_iff (u : ℤ × ℤ × ℤ) : w u = ⊤ ↔ u = 0 := by
  unfold w
  rw [min_eq_top, min_eq_top, emult2_top_iff, emult2_top_iff, emult2_top_iff]
  constructor
  · rintro ⟨h1, h2, h3⟩; exact Prod.ext h1 (Prod.ext h2 h3)
  · rintro rfl; exact ⟨rfl, rfl, rfl⟩

/-- **Strong (nonarchimedean) triangle inequality for the valuation.**
    `min (w u) (w v) ≤ w (u + v)`. -/
-- !-- Coordinatewise from `min_le_emultiplicity_add` together with the fact that
--     `min` distributes over the coordinatewise min. -- !--
theorem w_strong_triangle (u v : ℤ × ℤ × ℤ) :
    min (w u) (w v) ≤ w (u + v) := by
  unfold w
  have h1 := min_le_emultiplicity_add (p := (2 : ℤ)) (a := u.1) (b := v.1)
  have h2 := min_le_emultiplicity_add (p := (2 : ℤ)) (a := u.2.1) (b := v.2.1)
  have h3 := min_le_emultiplicity_add (p := (2 : ℤ)) (a := u.2.2) (b := v.2.2)
  simp only [Prod.fst_add, Prod.snd_add]
  apply le_min
  · exact le_trans (min_le_min (min_le_left _ _) (min_le_left _ _)) h1
  · apply le_min
    · exact le_trans (min_le_min (le_trans (min_le_right _ _) (min_le_left _ _))
        (le_trans (min_le_right _ _) (min_le_left _ _))) h2
    · exact le_trans (min_le_min (le_trans (min_le_right _ _) (min_le_right _ _))
        (le_trans (min_le_right _ _) (min_le_right _ _))) h3

/-! ## §2. The real-valued ultrametric `bdist` -/

/-- The order-reversing pullback `φ : ℕ∞ → ℝ`, `φ ⊤ = 0`, `φ n = (1/2)^n`. -/
def phi : ℕ∞ → ℝ
  | ⊤ => 0
  | (n : ℕ) => (1 / 2 : ℝ) ^ n

@[simp] theorem phi_top : phi ⊤ = 0 := rfl

@[simp] theorem phi_coe (n : ℕ) : phi (n : ℕ∞) = (1 / 2 : ℝ) ^ n := rfl

theorem phi_nonneg (a : ℕ∞) : 0 ≤ phi a := by
  cases a with
  | top => simp
  | coe n => simp

-- !-- φ n = (1/2)^n > 0 for finite n; only φ ⊤ = 0. -- !--
theorem phi_pos_of_ne_top {a : ℕ∞} (h : a ≠ ⊤) : 0 < phi a := by
  cases a with
  | top => exact absurd rfl h
  | coe n => simp

theorem phi_eq_zero_iff (a : ℕ∞) : phi a = 0 ↔ a = ⊤ := by
  cases a with
  | top => simp
  | coe n =>
    simp only [phi_coe]
    constructor
    · intro h; have : (0 : ℝ) < (1 / 2 : ℝ) ^ n := by positivity
      linarith
    · intro h; exact absurd h (by simp)

-- !-- φ is antitone: larger valuation ↦ smaller distance, since (1/2)^· decreases. -- !--
theorem phi_antitone {a b : ℕ∞} (h : a ≤ b) : phi b ≤ phi a := by
  cases a with
  | top => cases b with
    | top => simp
    | coe n => simp at h
  | coe m => cases b with
    | top => simp
    | coe n =>
      simp only [phi_coe]
      have : m ≤ n := by exact_mod_cast h
      exact pow_le_pow_of_le_one (by norm_num) (by norm_num) this

-- !-- Antitonicity turns `min` into `max`. -- !--
theorem phi_min (a b : ℕ∞) : phi (min a b) = max (phi a) (phi b) := by
  rcases le_total a b with h | h
  · rw [min_eq_left h, max_eq_left (phi_antitone h)]
  · rw [min_eq_right h, max_eq_right (phi_antitone h)]

/-- The induced ultrametric distance on Berggren arithmetic states. -/
def bdist (x y : ℤ × ℤ × ℤ) : ℝ := phi (w (x - y))

theorem bdist_nonneg (x y : ℤ × ℤ × ℤ) : 0 ≤ bdist x y := phi_nonneg _

@[simp] theorem bdist_self (x : ℤ × ℤ × ℤ) : bdist x x = 0 := by simp [bdist]

-- !-- w (x - y) = w (-(y - x)) = w (y - x); apply w_neg. -- !--
theorem bdist_comm (x y : ℤ × ℤ × ℤ) : bdist x y = bdist y x := by
  unfold bdist
  rw [show x - y = -(y - x) by ring, w_neg]

/-- **Separation**: `bdist x y = 0 ↔ x = y` — the ultrametric is a genuine metric. -/
-- !-- bdist x y = 0 ↔ w (x-y) = ⊤ ↔ x - y = 0 ↔ x = y (phi_eq_zero_iff, w_eq_top_iff). -- !--
theorem bdist_eq_zero_iff (x y : ℤ × ℤ × ℤ) : bdist x y = 0 ↔ x = y := by
  unfold bdist
  rw [phi_eq_zero_iff, w_eq_top_iff, sub_eq_zero]

/-- **Strong triangle inequality for `bdist`** (the ultrametric inequality):
    `bdist x z ≤ max (bdist x y) (bdist y z)`. -/
-- !-- (x - z) = (x - y) + (y - z); apply w_strong_triangle, then φ antitone +
--     phi_min to convert the valuation min-bound into the distance max-bound. -- !--
theorem bdist_strong_triangle (x y z : ℤ × ℤ × ℤ) :
    bdist x z ≤ max (bdist x y) (bdist y z) := by
  unfold bdist
  rw [show x - z = (x - y) + (y - z) by ring, ← phi_min]
  exact phi_antitone (w_strong_triangle (x - y) (y - z))

/-! ## §3. Berggren successor maps are valuation-monotone and nonexpanding -/

/-- Berggren successor `A` as a self-map of arithmetic states. -/
def cA (u : ℤ × ℤ × ℤ) : ℤ × ℤ × ℤ := BerggrenLorentz.childA u.1 u.2.1 u.2.2
/-- Berggren successor `B` as a self-map of arithmetic states. -/
def cB (u : ℤ × ℤ × ℤ) : ℤ × ℤ × ℤ := BerggrenLorentz.childB u.1 u.2.1 u.2.2
/-- Berggren successor `C` as a self-map of arithmetic states. -/
def cC (u : ℤ × ℤ × ℤ) : ℤ × ℤ × ℤ := BerggrenLorentz.childC u.1 u.2.1 u.2.2

-- !-- The successors are integer-linear, so they commute with subtraction. -- !--
theorem cA_sub (u v : ℤ × ℤ × ℤ) : cA u - cA v = cA (u - v) := by
  simp only [cA, BerggrenLorentz.childA, Prod.fst_sub, Prod.snd_sub]
  refine Prod.ext ?_ (Prod.ext ?_ ?_) <;> simp <;> ring

theorem cB_sub (u v : ℤ × ℤ × ℤ) : cB u - cB v = cB (u - v) := by
  simp only [cB, BerggrenLorentz.childB, Prod.fst_sub, Prod.snd_sub]
  refine Prod.ext ?_ (Prod.ext ?_ ?_) <;> simp <;> ring

theorem cC_sub (u v : ℤ × ℤ × ℤ) : cC u - cC v = cC (u - v) := by
  simp only [cC, BerggrenLorentz.childC, Prod.fst_sub, Prod.snd_sub]
  refine Prod.ext ?_ (Prod.ext ?_ ?_) <;> simp <;> ring

/-- `v₂ x ≤ v₂ (k·x)`: multiplying by an integer cannot lower the 2-adic valuation. -/
theorem emult_mul_ge (k x : ℤ) : emultiplicity (2 : ℤ) x ≤ emultiplicity (2 : ℤ) (k * x) := by
  by_cases hx : x = 0
  · simp [hx]
  · rw [emultiplicity_mul (by norm_num : Prime (2 : ℤ))]; simp

/-- **Master monotonicity lemma**: the valuation of any integer-linear combination
    of the coordinates is bounded below by the content valuation `w u`.  This is the
    structural reason every integer-linear self-map of `ℤ³` is valuation-monotone. -/
-- !-- Two applications of `min_le_emultiplicity_add` plus `emult_mul_ge` per term. -- !--
theorem w_le_combo (u : ℤ × ℤ × ℤ) (x y z : ℤ) :
    w u ≤ emultiplicity (2 : ℤ) (x * u.1 + y * u.2.1 + z * u.2.2) := by
  unfold w
  have hx := emult_mul_ge x u.1
  have hy := emult_mul_ge y u.2.1
  have hz := emult_mul_ge z u.2.2
  have h1 := min_le_emultiplicity_add (p := (2 : ℤ)) (a := x * u.1 + y * u.2.1) (b := z * u.2.2)
  have h2 := min_le_emultiplicity_add (p := (2 : ℤ)) (a := x * u.1) (b := y * u.2.1)
  refine le_trans ?_ h1
  apply le_min
  · refine le_trans ?_ h2
    apply le_min
    · exact le_trans (min_le_left _ _) hx
    · exact le_trans (min_le_right _ _) (le_trans (min_le_left _ _) hy)
  · exact le_trans (min_le_right _ _) (le_trans (min_le_right _ _) hz)

/-- **Valuation monotonicity of successor `A`**: `w u ≤ w (cA u)`. -/
theorem cA_weight_monotone (u : ℤ × ℤ × ℤ) : w u ≤ w (cA u) := by
  unfold w cA BerggrenLorentz.childA
  simp only
  refine le_min ?_ (le_min ?_ ?_)
  · have h := w_le_combo u 1 (-2) 2
    rw [show (1 : ℤ) * u.1 + (-2) * u.2.1 + 2 * u.2.2 = u.1 - 2 * u.2.1 + 2 * u.2.2 by ring] at h
    exact h
  · have h := w_le_combo u 2 (-1) 2
    rw [show (2 : ℤ) * u.1 + (-1) * u.2.1 + 2 * u.2.2 = 2 * u.1 - u.2.1 + 2 * u.2.2 by ring] at h
    exact h
  · have h := w_le_combo u 2 (-2) 3
    rw [show (2 : ℤ) * u.1 + (-2) * u.2.1 + 3 * u.2.2 = 2 * u.1 - 2 * u.2.1 + 3 * u.2.2 by ring] at h
    exact h

/-- **Valuation monotonicity of successor `B`**: `w u ≤ w (cB u)`. -/
theorem cB_weight_monotone (u : ℤ × ℤ × ℤ) : w u ≤ w (cB u) := by
  unfold w cB BerggrenLorentz.childB
  simp only
  refine le_min ?_ (le_min ?_ ?_)
  · have h := w_le_combo u 1 2 2
    rw [show (1 : ℤ) * u.1 + 2 * u.2.1 + 2 * u.2.2 = u.1 + 2 * u.2.1 + 2 * u.2.2 by ring] at h
    exact h
  · have h := w_le_combo u 2 1 2
    rw [show (2 : ℤ) * u.1 + 1 * u.2.1 + 2 * u.2.2 = 2 * u.1 + u.2.1 + 2 * u.2.2 by ring] at h
    exact h
  · have h := w_le_combo u 2 2 3
    rw [show (2 : ℤ) * u.1 + 2 * u.2.1 + 3 * u.2.2 = 2 * u.1 + 2 * u.2.1 + 3 * u.2.2 by ring] at h
    exact h

/-- **Valuation monotonicity of successor `C`**: `w u ≤ w (cC u)`. -/
theorem cC_weight_monotone (u : ℤ × ℤ × ℤ) : w u ≤ w (cC u) := by
  unfold w cC BerggrenLorentz.childC
  simp only
  refine le_min ?_ (le_min ?_ ?_)
  · have h := w_le_combo u (-1) 2 2
    rw [show (-1 : ℤ) * u.1 + 2 * u.2.1 + 2 * u.2.2 = -u.1 + 2 * u.2.1 + 2 * u.2.2 by ring] at h
    exact h
  · have h := w_le_combo u (-2) 1 2
    rw [show (-2 : ℤ) * u.1 + 1 * u.2.1 + 2 * u.2.2 = -2 * u.1 + u.2.1 + 2 * u.2.2 by ring] at h
    exact h
  · have h := w_le_combo u (-2) 2 3
    rw [show (-2 : ℤ) * u.1 + 2 * u.2.1 + 3 * u.2.2 = -2 * u.1 + 2 * u.2.1 + 3 * u.2.2 by ring] at h
    exact h

/-- **Successor `A` is nonexpanding** for the ultrametric `bdist`. -/
-- !-- cA x - cA y = cA (x - y) (cA_sub); w(cA(x-y)) ≥ w(x-y) (cA_weight_monotone);
--     φ antitone gives bdist (cA x)(cA y) ≤ bdist x y. -- !--
theorem cA_nonexpanding (x y : ℤ × ℤ × ℤ) : bdist (cA x) (cA y) ≤ bdist x y := by
  unfold bdist; rw [cA_sub]; exact phi_antitone (cA_weight_monotone (x - y))

theorem cB_nonexpanding (x y : ℤ × ℤ × ℤ) : bdist (cB x) (cB y) ≤ bdist x y := by
  unfold bdist; rw [cB_sub]; exact phi_antitone (cB_weight_monotone (x - y))

theorem cC_nonexpanding (x y : ℤ × ℤ × ℤ) : bdist (cC x) (cC y) ≤ bdist x y := by
  unfold bdist; rw [cC_sub]; exact phi_antitone (cC_weight_monotone (x - y))

/-! ## §4. The tropical valuation object and the functorial bridge -/

open CategoricalTropicalUltrametric in
/-- The min-plus tropical semiring `(ℕ∞, min, +)` packaged (in order-dual form,
    `le a b := b ≤ a`) as a `TropicalValuationObject`.  This is the value object
    into which the Berggren content valuation `w` maps. -/
def tropMinPlus : TropicalValuationObject ℕ∞ where
  le a b := b ≤ a
  le_refl _ := le_refl _
  le_antisymm h₁ h₂ := le_antisymm h₂ h₁
  le_trans h₁ h₂ := le_trans h₂ h₁
  le_total a b := le_total b a
  zero := ⊤
  one := 0
  add := min
  mul := (· + ·)
  max_op := min
  add_eq_max' _ _ := rfl
  max_comm := min_comm
  max_assoc := min_assoc
  max_idem := min_self
  max_le_left := fun a b => min_le_left a b
  max_le_right := fun a b => min_le_right a b
  max_least h₁ h₂ := le_min h₁ h₂
  mul_comm := add_comm
  mul_assoc := add_assoc
  mul_one := add_zero
  mul_zero := by intro a; simp
  add_zero := by intro a; simp

/-- **Functorial bridge**: the content valuation `w` is a valuation into the
    tropical object `tropMinPlus`, i.e. it satisfies the tropical strong-triangle
    relation `tropMinPlus.le (w (u+v)) (tropMinPlus.add (w u) (w v))`
    (which unfolds, in the dual order, to `min (w u) (w v) ≤ w (u+v)`). -/
theorem weight_tropical_compat (u v : ℤ × ℤ × ℤ) :
    tropMinPlus.le (w (u + v)) (tropMinPlus.add (w u) (w v)) :=
  w_strong_triangle u v

/-- The valuation sends the origin to the tropical zero `⊤`. -/
theorem weight_tropical_zero : w (0 : ℤ × ℤ × ℤ) = tropMinPlus.zero := w_zero

end BerggrenTropicalUltrametric
