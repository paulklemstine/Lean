<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Neural Observation Pseudometric ⇆ Proof-Spectrum Congruence</title>
<style>
  :root {
    --bg: #0f1226; --panel: #1b1f3b; --ink: #e9ecff; --muted: #9aa3d4;
    --accent: #6ea8fe; --good: #46d39a; --bad: #ff6b8a; --line: #2d3361;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; font-family: "Segoe UI", system-ui, sans-serif;
    background: radial-gradient(1200px 700px at 70% -10%, #232a55, var(--bg));
    color: var(--ink); line-height: 1.5;
  }
  header { padding: 28px 24px 8px; text-align: center; }
  h1 { margin: 0; font-size: 1.55rem; font-weight: 700; }
  .sub { color: var(--muted); margin-top: 6px; font-size: .98rem; }
  .wrap { max-width: 1080px; margin: 0 auto; padding: 16px 20px 48px; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; } }
  .card {
    background: linear-gradient(180deg, var(--panel), #161a34);
    border: 1px solid var(--line); border-radius: 14px; padding: 18px;
    box-shadow: 0 10px 30px rgba(0,0,0,.25);
  }
  .card h2 { margin: 0 0 10px; font-size: 1.05rem; color: var(--accent); }
  label { display:block; font-size:.82rem; color:var(--muted); margin:10px 0 4px; }
  input[type=text] {
    width: 100%; padding: 9px 11px; border-radius: 9px; border: 1px solid var(--line);
    background: #11142b; color: var(--ink); font-family: ui-monospace, monospace;
    font-size: .95rem;
  }
  .row { display:flex; gap:10px; }
  .row > div { flex:1; }
  button {
    margin-top: 14px; width: 100%; padding: 11px; border:none; border-radius: 10px;
    background: linear-gradient(90deg, #6ea8fe, #9b8cff); color:#0b0e22;
    font-weight: 700; font-size: 1rem; cursor:pointer;
  }
  button:hover { filter: brightness(1.08); }
  table { width:100%; border-collapse: collapse; margin-top: 8px; font-size:.9rem; }
  th, td { padding: 6px 8px; border-bottom: 1px solid var(--line); text-align:left; }
  th { color: var(--muted); font-weight:600; }
  code { font-family: ui-monospace, monospace; color: #cdd6ff; }
  .verdict { margin-top: 14px; padding: 12px 14px; border-radius: 10px; font-weight:700; }
  .v-good { background: rgba(70,211,154,.14); border:1px solid var(--good); color: var(--good); }
  .v-bad { background: rgba(255,107,138,.14); border:1px solid var(--bad); color: var(--bad); }
  .bars { display:flex; gap:6px; align-items:flex-end; height:120px; margin-top:8px; }
  .bar { flex:1; background: linear-gradient(180deg,#6ea8fe,#9b8cff); border-radius:6px 6px 0 0;
         position:relative; }
  .bar span { position:absolute; top:-18px; left:0; right:0; text-align:center;
              font-size:.78rem; color: var(--muted); }
  .bar small { position:absolute; bottom:-20px; left:0; right:0; text-align:center;
               font-size:.72rem; color: var(--muted); }
  .note { color: var(--muted); font-size:.82rem; margin-top:10px; }
  .pill { display:inline-block; padding:2px 9px; border-radius:999px; font-size:.78rem;
          background:#262c55; color:var(--accent); margin-right:6px; }
</style>
</head>
<body>
<header>
  <h1>Neural Observation Pseudometric&nbsp;&#8646;&nbsp;Proof-Spectrum Congruence</h1>
  <div class="sub">Probe two hidden states of an algebraic neural system, watch the
    distance, and see it coincide with the semiring congruence kernel.</div>
</header>

<div class="wrap">
  <div class="grid">
    <div class="card">
      <h2>1 &middot; The algebraic neural system</h2>
      <div class="note">A <b>selector layer</b> routes each output coordinate from one
      input coordinate (or zeroes it). Such maps preserve <code>+</code>,
      <code>&times;</code>, and <code>0</code>, so each layer and the read-out are
      semiring homomorphisms &mdash; exactly an <i>algebraic neural observation
      system</i>.</div>
      <label>Layer for symbol <code>a</code> &nbsp;(comma list; <code>-</code> = zero)</label>
      <input id="stepA" type="text" value="1,2,3,3" />
      <label>Layer for symbol <code>b</code></label>
      <input id="stepB" type="text" value="0,1,2,3" />
      <label>Read-out selector (state &rarr; output)</label>
      <input id="obs" type="text" value="0" />
      <div class="note pill">state space R = Z<sup>n</sup></div>
      <div class="note pill">output K = Z<sup>m</sup>, componentwise</div>
    </div>

    <div class="card">
      <h2>2 &middot; Two hidden states</h2>
      <div class="row">
        <div>
          <label>state x</label>
          <input id="x" type="text" value="1,1,1,2" />
        </div>
        <div>
          <label>state y</label>
          <input id="y" type="text" value="1,1,1,9" />
        </div>
      </div>
      <label>Maximum probing depth k</label>
      <input id="depth" type="text" value="5" />
      <button onclick="run()">Probe &amp; compare</button>
      <div id="verdict"></div>
    </div>
  </div>

  <div class="card" style="margin-top:18px;">
    <h2>3 &middot; Behaviors under probing words</h2>
    <div class="note">behavior(x, w) = observe(fold the word w through the layers from x).
      Distance is 0 exactly when <i>no</i> word separates the states.</div>
    <table id="behtbl"><thead><tr><th>word w</th><th>behavior(x, w)</th>
      <th>behavior(y, w)</th><th>agree?</th></tr></thead><tbody></tbody></table>
  </div>

  <div class="card" style="margin-top:18px;">
    <h2>4 &middot; Partition refinement (depth-by-depth)</h2>
    <div class="note">The behavior congruence is the intersection of the depth filtration:
      states agreeing up to every depth k are congruent. Bars show the smallest depth at
      which x and y are <i>still</i> indistinguishable; once a word separates them, the
      distance jumps to 1.</div>
    <div class="bars" id="bars"></div>
    <div class="note" style="margin-top:28px;" id="refnote"></div>
  </div>
</div>

<script>
function parseSel(s) {
  return s.split(",").map(t => t.trim()).map(t => (t === "-" || t === "") ? null : parseInt(t,10));
}
function parseVec(s) { return s.split(",").map(t => parseInt(t.trim(),10)); }
function applySel(sel, x) { return sel.map(j => j === null ? 0 : (x[j] ?? 0)); }
function eqVec(a,b){ if(a.length!==b.length) return false; for(let i=0;i<a.length;i++) if(a[i]!==b[i]) return false; return true; }

function behavior(steps, obs, x, w) {
  let s = x.slice();
  for (const a of w) s = applySel(steps[a], s);
  return applySel(obs, s);
}
function wordsUpto(numSym, k) {
  let out = [[]];
  let frontier = [[]];
  for (let len=1; len<=k; len++) {
    let next = [];
    for (const w of frontier) for (let a=0;a<numSym;a++) next.push(w.concat([a]));
    out = out.concat(next); frontier = next;
  }
  return out;
}
function fmtWord(w){ return w.length? w.map(a=>String.fromCharCode(97+a)).join("") : "ε"; }
function fmtVec(v){ return "("+v.join(",")+")"; }

function run() {
  const steps = [parseSel(document.getElementById("stepA").value),
                 parseSel(document.getElementById("stepB").value)];
  const obs = parseSel(document.getElementById("obs").value);
  const x = parseVec(document.getElementById("x").value);
  const y = parseVec(document.getElementById("y").value);
  const depth = Math.max(0, Math.min(7, parseInt(document.getElementById("depth").value,10)||0));
  const numSym = 2;

  // Behavior table (show words up to min(depth,3) to keep it readable).
  const showK = Math.min(depth, 3);
  const ws = wordsUpto(numSym, showK);
  const tb = document.querySelector("#behtbl tbody"); tb.innerHTML = "";
  let firstSep = -1;
  const allWs = wordsUpto(numSym, depth);
  for (const w of allWs) {
    const bx = behavior(steps,obs,x,w), by = behavior(steps,obs,y,w);
    if (!eqVec(bx,by)) { firstSep = w.length; break; }
  }
  for (const w of ws) {
    const bx = behavior(steps,obs,x,w), by = behavior(steps,obs,y,w);
    const ag = eqVec(bx,by);
    const tr = document.createElement("tr");
    tr.innerHTML = `<td><code>${fmtWord(w)}</code></td><td><code>${fmtVec(bx)}</code></td>`+
      `<td><code>${fmtVec(by)}</code></td><td>${ag?'&#10004;':'<b style="color:#ff6b8a">&#10008;</b>'}</td>`;
    tb.appendChild(tr);
  }

  // Verdict.
  const dist = (firstSep === -1) ? 0 : 1;
  const v = document.getElementById("verdict");
  if (dist === 0) {
    v.className = "verdict v-good";
    v.innerHTML = `obsDist(x, y) = <b>0</b> &nbsp;&rarr;&nbsp; states are <b>behaviorally
      equivalent</b> up to depth ${depth}: (x, y) lies in the semiring congruence
      <code>behaviorCongruence</code>. The metric kernel and the algebraic congruence agree.`;
  } else {
    v.className = "verdict v-bad";
    v.innerHTML = `obsDist(x, y) = <b>1</b> &nbsp;&rarr;&nbsp; a word of length ${firstSep}
      separates the states, so (x, y) is <b>outside</b> the congruence. Distinct point of
      the proof spectrum.`;
  }

  // Refinement bars: per depth k, are they still equivalent up to k?
  const bars = document.getElementById("bars"); bars.innerHTML = "";
  for (let k=0;k<=depth;k++) {
    const wk = wordsUpto(numSym,k);
    let eq = true;
    for (const w of wk){ if(!eqVec(behavior(steps,obs,x,w),behavior(steps,obs,y,w))){eq=false;break;} }
    const div = document.createElement("div");
    div.className = "bar";
    div.style.height = (eq? 100 : 18) + "%";
    div.style.background = eq ? "linear-gradient(180deg,#46d39a,#2f9d77)"
                              : "linear-gradient(180deg,#ff6b8a,#c44765)";
    div.innerHTML = `<span>${eq?'≈':'≉'}</span><small>k=${k}</small>`;
    bars.appendChild(div);
  }
  const rn = document.getElementById("refnote");
  rn.innerHTML = (firstSep===-1)
    ? `Green at every depth: the two states are <b>congruent</b> (indistinguishable at all depths).`
    : `Refinement first separates the states at depth <b>${firstSep}</b>; from there on the
       distance is locked at 1. This is partition refinement converging to the congruence.`;
}
window.onload = run;
</script>
</body>
</html>
