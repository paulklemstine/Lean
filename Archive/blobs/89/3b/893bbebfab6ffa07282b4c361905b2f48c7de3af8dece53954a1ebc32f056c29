<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Fibonacci Primitive Divisor Explorer</title>
<style>
  :root { --bg:#0f1226; --panel:#1a1f3c; --accent:#ffd166; --good:#06d6a0; --bad:#ef476f; --txt:#e8eaf6; }
  * { box-sizing: border-box; }
  body { margin:0; font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
         background: radial-gradient(1200px 800px at 20% -10%, #25305e, #0f1226);
         color:#e8eaf6; min-height:100vh; }
  .wrap { max-width: 920px; margin: 0 auto; padding: 28px 18px 60px; }
  h1 { font-weight: 800; letter-spacing:.3px; margin-bottom:4px; }
  .sub { color:#aab0d6; margin-top:0; }
  .panel { background: rgba(26,31,60,.85); border:1px solid #2c3464; border-radius:16px;
           padding:18px 20px; margin:16px 0; box-shadow: 0 10px 30px rgba(0,0,0,.35); }
  label { font-weight:600; }
  input[type=range]{ width: 100%; }
  .row { display:flex; gap:18px; align-items:center; flex-wrap:wrap; }
  .nbox { font-size: 1.6rem; font-weight:800; color: var(--accent); min-width:90px; }
  .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
  .verdict { font-size:1.15rem; font-weight:700; padding:10px 14px; border-radius:10px; display:inline-block; }
  .ok { background: rgba(6,214,160,.15); color: var(--good); border:1px solid var(--good); }
  .no { background: rgba(239,71,111,.15); color: var(--bad); border:1px solid var(--bad); }
  .pill { display:inline-block; padding:3px 9px; margin:3px; border-radius:999px; font-weight:700;
          font-family: ui-monospace, monospace; }
  .new { background: rgba(255,209,102,.2); color:var(--accent); border:1px solid var(--accent); }
  .old { background: rgba(170,176,214,.12); color:#aab0d6; border:1px solid #444c84; }
  .big { word-break: break-all; }
  table { width:100%; border-collapse: collapse; margin-top:8px; }
  td,th { text-align:left; padding:6px 8px; border-bottom:1px solid #2c3464; font-family: ui-monospace, monospace; }
  .muted { color:#8b92be; font-size:.92rem; }
  a { color: var(--accent); }
</style>
</head>
<body>
<div class="wrap">
  <h1>Fibonacci Primitive Divisor Explorer</h1>
  <p class="sub">Watch each Fibonacci number F(n) introduce a brand-new prime &mdash; and meet the four exceptions.</p>

  <div class="panel">
    <div class="row">
      <div><label for="n">index n</label></div>
      <div class="nbox mono" id="nval">13</div>
      <div style="flex:1; min-width:240px;"><input id="n" type="range" min="1" max="40" value="13" /></div>
    </div>
    <p class="muted">A prime p is a <b>primitive prime divisor</b> of F(n) if p divides F(n) but divides no earlier Fibonacci number.
       Carmichael's theorem: this always exists except for n &isin; {1, 2, 6, 12}.</p>
  </div>

  <div class="panel">
    <div>F(<span id="n2" class="mono">13</span>) = <span id="fval" class="mono big">233</span></div>
    <div style="margin-top:10px;">Prime factorization:&nbsp; <span id="factors"></span></div>
    <div style="margin-top:10px;">Primitive part (after stripping inherited primes):&nbsp;
       <span id="pp" class="mono">233</span></div>
    <div style="margin-top:14px;" id="verdict"></div>
  </div>

  <div class="panel">
    <h3 style="margin-top:0;">How the stripping certificate works</h3>
    <p class="muted">Start from F(n); for every proper divisor d of n, divide out every prime shared with F(d).
       What survives is built entirely from newcomers. If it exceeds 1, its smallest prime factor is primitive.</p>
    <table id="strip"></table>
  </div>

  <div class="panel">
    <h3 style="margin-top:0;">Birth log: first appearance of each prime</h3>
    <div id="birth" class="mono" style="line-height:1.9;"></div>
  </div>

  <p class="muted">Pure client-side BigInt arithmetic &mdash; no servers, no libraries.</p>
</div>

<script>
function fib(n){ let a=0n,b=1n; for(let i=0;i<n;i++){ [a,b]=[b,a+b]; } return a; }
function gcd(a,b){ a=a<0n?-a:a; b=b<0n?-b:b; while(b){ [a,b]=[b,a%b]; } return a; }
function isPrimeN(n){ if(n<2)return false; if(n%2===0)return n===2; for(let d=3; d*d<=n; d+=2) if(n%d===0) return false; return true; }
function factorBig(x){ // returns Map prime->exp for moderate x (BigInt)
  const f=new Map(); let n=x;
  for(let d=2n; d*d<=n; d+= (d===2n?1n:2n)){ while(n%d===0n){ f.set(d,(f.get(d)||0n)+1n); n/=d; } }
  if(n>1n) f.set(n,(f.get(n)||0n)+1n);
  return f;
}
function properDivs(n){ const r=[]; for(let d=1;d<n;d++) if(n%d===0) r.push(d); return r; }
function stripAll(r,m){ if(m<=1n) return r; while(true){ const g=gcd(r,m); if(g<=1n) return r; r/=g; } }
function primPart(n){ let r=fib(n); for(const d of properDivs(n)) r=stripAll(r,fib(d)); return r; }

function fmtFactors(map){
  const parts=[]; for(const [p,e] of [...map.entries()].sort((a,b)=> a[0]<b[0]?-1:1)){
    parts.push(e>1n? `${p}^${e}` : `${p}`); }
  return parts.length? parts.join(" &middot; ") : "1";
}

function render(n){
  document.getElementById('nval').textContent=n;
  document.getElementById('n2').textContent=n;
  const fn=fib(n);
  document.getElementById('fval').textContent=fn.toString();
  const small = fn < 10n**18n; // only factor when feasible
  const fmap = (fn>1n && small)? factorBig(fn) : new Map();
  document.getElementById('factors').innerHTML = (fn<=1n)? "1 (no prime factors)"
       : (small? fmtFactors(fmap) : "(too large to factor in-browser)");

  const pp=primPart(n);
  document.getElementById('pp').textContent=pp.toString();

  // verdict
  const v=document.getElementById('verdict');
  const exceptional = (n===1||n===2||n===6||n===12);
  if(exceptional){
    v.innerHTML = `<span class="verdict no">No primitive prime divisor &mdash; n = ${n} is exceptional.</span>`;
  } else {
    let witness = "";
    if(pp>1n){ const pm=factorBig(pp); witness = [...pm.keys()].sort((a,b)=>a<b?-1:1)[0].toString(); }
    v.innerHTML = `<span class="verdict ok">Primitive prime divisor exists${witness?`: <b>${witness}</b>`:""}.</span>`;
  }

  // strip table
  const tbl=document.getElementById('strip');
  let rows="<tr><th>proper divisor d</th><th>F(d)</th><th>residue after stripping</th></tr>";
  let r=fn;
  rows += `<tr><td>&mdash;</td><td>start</td><td>${fn.toString()}</td></tr>`;
  for(const d of properDivs(n)){ const m=fib(d); r=stripAll(r,m);
    rows += `<tr><td>${d}</td><td>${m.toString()}</td><td>${r.toString()}</td></tr>`; }
  tbl.innerHTML=rows;

  // birth log up to n (small only)
  const birth=document.getElementById('birth');
  const seen=new Set(); let html="";
  for(let k=1;k<=Math.min(n,30);k++){
    const fk=fib(k); if(fk<=1n){ html+=`F(${k})=1 &rarr; <span class="pill old">none</span><br>`; continue; }
    const fm=factorBig(fk); const news=[];
    for(const p of fm.keys()){ const s=p.toString(); if(!seen.has(s)){ news.push(s);} seen.add(s); }
    const pills=[...fm.keys()].sort((a,b)=>a<b?-1:1).map(p=>{ const s=p.toString();
        return news.includes(s)? `<span class="pill new">${s} NEW</span>` : `<span class="pill old">${s}</span>`; }).join(" ");
    html+=`F(${k})=${fk} &rarr; ${pills}<br>`;
  }
  birth.innerHTML=html;
}

const slider=document.getElementById('n');
slider.addEventListener('input', e=> render(parseInt(e.target.value)));
render(13);
</script>
</body>
</html>
