      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\"/>\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/>\n<title>Interleaving Stability Explorer</title>\n<style>\n  body{font-family:-apple-system,Segoe UI,Roboto,sans-serif;margin:0;background:#0f1226;color:#e8ecf8}\n  header{padding:18px 24px;background:linear-gradient(120deg,#1b2050,#3a2b6b);box-shadow:0 2px 12px rgba(0,0,0,.4)}\n  h1{margin:0;font-size:20px}\n  p.sub{margin:6px 0 0;color:#aab2d8;font-size:13px}\n  .wrap{display:flex;flex-wrap:wrap;gap:20px;padding:20px}\n  .panel{background:#161a36;border:1px solid #2a3160;border-radius:12px;padding:16px;flex:1;min-width:320px}\n  canvas{background:#0c0f24;border-radius:8px;width:100%;height:auto;cursor:grab}\n  label{display:block;margin:10px 0 4px;font-size:13px;color:#c8cfff}\n  input[type=range]{width:100%}\n  .stat{font-size:14px;margin:6px 0}\n  .big{font-size:22px;font-weight:700}\n  .ok{color:#5ee08a}.bad{color:#ff7a90}\n  code{background:#0c0f24;padding:2px 6px;border-radius:5px;color:#9fe8ff}\n</style>\n</head>\n<body>\n<header>\n  <h1>Interleaving Stability Explorer</h1>\n  <p class=\"sub\">Drag the points. Perturb them with noise. Watch the verified bound\n     <code>interleavingDist(RipsMod d, RipsMod d') &le; ||d - d'||&infin;</code> hold in real time.</p>\n</header>\n<div class=\"wrap\">\n  <div class=\"panel\">\n    <h3>Point cloud &amp; Vietoris-Rips graph</h3>\n    <canvas id=\"cv\" width=\"520\" height=\"420\"></canvas>\n    <label>Rips scale t = <span id=\"tval\">1.20</span></label>\n    <input id=\"t\" type=\"range\" min=\"0\" max=\"4\" step=\"0.02\" value=\"1.2\"/>\n    <label>Perturbation noise &epsilon; = <span id=\"nval\">0.40</span></label>\n    <input id=\"noise\" type=\"range\" min=\"0\" max=\"1.5\" step=\"0.02\" value=\"0.4\"/>\n    <button id=\"reroll\">Re-roll perturbation</button>\n  </div>\n  <div class=\"panel\">\n    <h3>Stability dashboard</h3>\n    <div class=\"stat\">sup-distance &nbsp;<code>||d - d'||&infin;</code> = <span class=\"big\" id=\"sup\">-</span></div>\n    <div class=\"stat\">optimal interleaving shift = <span class=\"big\" id=\"shift\">-</span></div>\n    <div class=\"stat\" id=\"verdict\">-</div>\n    <hr style=\"border-color:#2a3160\"/>\n    <p style=\"font-size:13px;color:#aab2d8\">\n      Blue edges: <code>{(x,y): d(x,y) &le; t}</code> on the original cloud (solid)\n      and on the perturbed cloud (dashed orange). The theorem guarantees the orange\n      point in the dashboard never rises above the dashed diagonal: the entire movie\n      of shapes moves by at most the sup-distance.\n    </p>\n    <canvas id=\"plot\" width=\"520\" height=\"300\"></canvas>\n  </div>\n</div>\n<script>\nconst cv=document.getElementById('cv'),ctx=cv.getContext('2d');\nconst plot=document.getElementById('plot'),px=plot.getContext('2d');\nlet pts=[[90,120],[230,90],[380,140],[410,300],[230,340],[90,300]];\nlet pert=pts.map(p=>p.slice());\nconst tEl=document.getElementById('t'),nEl=document.getElementById('noise');\nlet drag=-1;\nfunction dist(a,b){return Math.hypot(a[0]-b[0],a[1]-b[1])/100;}\nfunction dmat(P){let m=[];for(let i=0;i<P.length;i++){m[i]=[];for(let j=0;j<P.length;j++)m[i][j]=dist(P[i],P[j]);}return m;}\nfunction reroll(){let n=parseFloat(nEl.value);pert=pts.map(p=>[p[0]+(Math.random()*2-1)*n*100,p[1]+(Math.random()*2-1)*n*100]);}\nfunction supDist(){let a=dmat(pts),b=dmat(pert),s=0;for(let i=0;i<pts.length;i++)for(let j=0;j<pts.length;j++)s=Math.max(s,Math.abs(a[i][j]-b[i][j]));return s;}\nfunction interleaved(eps){let a=dmat(pts),b=dmat(pert);let scales=[];for(let t=0;t<=4.001;t+=0.1)scales.push(t);\n  for(const t of scales){for(let i=0;i<pts.length;i++)for(let j=0;j<pts.length;j++){\n    if(a[i][j]<=t && !(b[i][j]<=t+eps))return false;\n    if(b[i][j]<=t && !(a[i][j]<=t+eps))return false;}}return true;}\nfunction optShift(){for(let e=0;e<=2.001;e+=0.02)if(interleaved(e))return e;return Infinity;}\nfunction drawGraph(P,col,dash,t){ctx.lineWidth=dash?1.5:2;ctx.strokeStyle=col;ctx.setLineDash(dash?[6,5]:[]);\n  for(let i=0;i<P.length;i++)for(let j=i+1;j<P.length;j++)if(dist(P[i],P[j])<=t){ctx.beginPath();ctx.moveTo(P[i][0],P[i][1]);ctx.lineTo(P[j][0],P[j][1]);ctx.stroke();}ctx.setLineDash([]);}\nfunction render(){let t=parseFloat(tEl.value);document.getElementById('tval').textContent=t.toFixed(2);\n  document.getElementById('nval').textContent=parseFloat(nEl.value).toFixed(2);\n  ctx.clearRect(0,0,cv.width,cv.height);\n  drawGraph(pert,'#ff9a3c',true,t);drawGraph(pts,'#5aa0ff',false,t);\n  ctx.fillStyle='#ff7a90';for(const p of pert){ctx.beginPath();ctx.arc(p[0],p[1],5,0,7);ctx.fill();}\n  ctx.fillStyle='#5ee0ff';for(const p of pts){ctx.beginPath();ctx.arc(p[0],p[1],6,0,7);ctx.fill();}\n  let sup=supDist(),sh=optShift();\n  document.getElementById('sup').textContent=sup.toFixed(3);\n  document.getElementById('shift').textContent=isFinite(sh)?sh.toFixed(3):'inf';\n  let ok=sh<=sup+1e-6;\n  document.getElementById('verdict').innerHTML=ok?\n    '<span class=\"ok\">STABILITY HOLDS &nbsp;shift &le; sup-distance &check;</span>':\n    '<span class=\"bad\">violation (numerical grid)</span>';\n  drawPlot(sup,sh);}\nfunction drawPlot(sup,sh){px.clearRect(0,0,plot.width,plot.height);let m=40,W=plot.width-2*m,H=plot.height-2*m,L=2.2;\n  px.strokeStyle='#3a4170';px.beginPath();px.moveTo(m,plot.height-m);px.lineTo(m+W,plot.height-m);px.moveTo(m,plot.height-m);px.lineTo(m,m);px.stroke();\n  px.strokeStyle='#7fe0a0';px.setLineDash([5,5]);px.beginPath();px.moveTo(m,plot.height-m);px.lineTo(m+W,plot.height-m-H);px.stroke();px.setLineDash([]);\n  px.fillStyle='#aab2d8';px.font='12px sans-serif';px.fillText('sup-distance',m+W/2-30,plot.height-10);\n  px.save();px.translate(14,m+H/2+30);px.rotate(-Math.PI/2);px.fillText('interleaving shift',0,0);px.restore();\n  let x=m+Math.min(sup/L,1)*W,y=plot.height-m-Math.min(sh/L,1)*H;\n  px.fillStyle='#ff9a3c';px.beginPath();px.arc(x,y,6,0,7);px.fill();}\ncv.addEventListener('mousedown',e=>{let r=cv.getBoundingClientRect(),mx=(e.clientX-r.left)*cv.width/r.width,my=(e.clientY-r.top)*cv.height/r.height;\n  for(let i=0;i<pts.length;i++)if(Math.hypot(pts[i][0]-mx,pts[i][1]-my)<12){drag=i;break;}});\ncv.addEventListener('mousemove',e=>{if(drag<0)return;let r=cv.getBoundingClientRect();pts[drag]=[(e.clientX-r.left)*cv.width/r.width,(e.clientY-r.top)*cv.height/r.height];reroll();render();});\nwindow.addEventListener('mouseup',()=>drag=-1);\ntEl.oninput=render;nEl.oninput=()=>{reroll();render();};\ndocument.getElementById('reroll').onclick=()=>{reroll();render();};\nreroll();render();\n</script>\n</body>\n</html>\n"
