import Mathlib

/-!
# Elementary 2×2 Markov moves on two-way integer tables

This file develops the basic algebra of *elementary 2×2 Markov moves* (basic moves)
on finite integer tables, i.e. integer matrices `Fin m × Fin n → ℤ`.

A **basic move** picks two distinct rows `i ≠ i'` and two distinct columns `j ≠ j'`
and adds the `±1` pattern

```
        j      j'
   i   -1      +1
   i'  +1      -1
```

leaving every other cell unchanged. Such a move preserves all row sums, all column
sums, and hence the grand total. These moves are the connecting moves of the Markov
basis of two-way contingency tables with fixed margins.
-/

namespace Catalog.Algebra.MarkovMoves

open scoped BigOperators

/-- A two-way integer table with `m` rows and `n` columns. -/
abbrev Table (m n : ℕ) := Matrix (Fin m) (Fin n) ℤ

variable {m n : ℕ}

/-- The sum of the entries in row `i`. -/
def rowSum (T : Table m n) (i : Fin m) : ℤ := ∑ j, T i j

/-- The sum of the entries in column `j`. -/
def colSum (T : Table m n) (j : Fin n) : ℤ := ∑ i, T i j

/-- The sum of all entries of the table. -/
def totalSum (T : Table m n) : ℤ := ∑ i, ∑ j, T i j

/-- Two tables have the same margins if all their row sums and all their column
sums agree. -/
def sameMargins (T T' : Table m n) : Prop :=
  (∀ i, rowSum T i = rowSum T' i) ∧ (∀ j, colSum T j = colSum T' j)

/-- A table is nonnegative if every entry is `≥ 0`. -/
def Nonneg (T : Table m n) : Prop := ∀ i j, 0 ≤ T i j

/-- The elementary 2×2 Markov move: `-1` at `(i,j)` and `(i',j')`, `+1` at `(i,j')`
and `(i',j)`, and `0` elsewhere. -/
def basicMove (i i' : Fin m) (j j' : Fin n) : Table m n :=
  fun r c =>
    (if r = i ∧ c = j then (-1 : ℤ) else 0)
      + (if r = i' ∧ c = j' then (-1 : ℤ) else 0)
      + (if r = i ∧ c = j' then (1 : ℤ) else 0)
      + (if r = i' ∧ c = j then (1 : ℤ) else 0)

/-! ### Additivity of the sum functionals -/

theorem rowSum_add (T T' : Table m n) (i : Fin m) :
    rowSum (T + T') i = rowSum T i + rowSum T' i := by
  simp only [rowSum, Matrix.add_apply, Finset.sum_add_distrib]

theorem colSum_add (T T' : Table m n) (j : Fin n) :
    colSum (T + T') j = colSum T j + colSum T' j := by
  simp only [colSum, Matrix.add_apply, Finset.sum_add_distrib]

theorem totalSum_add (T T' : Table m n) :
    totalSum (T + T') = totalSum T + totalSum T' := by
  simp only [totalSum, Matrix.add_apply, Finset.sum_add_distrib]

/-! ### Pointwise values of `basicMove` -/

theorem basicMove_apply (i i' : Fin m) (j j' : Fin n) (r : Fin m) (c : Fin n) :
    basicMove i i' j j' r c =
      (if r = i ∧ c = j then (-1 : ℤ) else 0)
        + (if r = i' ∧ c = j' then (-1 : ℤ) else 0)
        + (if r = i ∧ c = j' then (1 : ℤ) else 0)
        + (if r = i' ∧ c = j then (1 : ℤ) else 0) := rfl

/-! ### The basic move has zero margins -/

/-- Every row sum of a basic move is zero. The hypothesis `hj : j ≠ j'` is kept as
requested in the specification, but turns out to be unnecessary for the row-sum
statement. -/
theorem basicMove_rowSum_zero (i i' : Fin m) (j j' : Fin n)
    (hi : i ≠ i') (hj : j ≠ j') (r : Fin m) :
    rowSum (basicMove i i' j j') r = 0 := by
  simp only [rowSum, basicMove, Finset.sum_add_distrib]
  by_cases hri : r = i <;> by_cases hri' : r = i' <;>
    simp_all [Finset.sum_ite_eq']

/-- Every column sum of a basic move is zero. The hypothesis `hi : i ≠ i'` is kept
as requested in the specification, but turns out to be unnecessary for the
column-sum statement. -/
theorem basicMove_colSum_zero (i i' : Fin m) (j j' : Fin n)
    (hi : i ≠ i') (hj : j ≠ j') (c : Fin n) :
    colSum (basicMove i i' j j') c = 0 := by
  simp only [colSum, basicMove, Finset.sum_add_distrib]
  by_cases hcj : c = j <;> by_cases hcj' : c = j' <;>
    simp_all [Finset.sum_ite_eq']

theorem basicMove_totalSum_zero (i i' : Fin m) (j j' : Fin n)
    (hi : i ≠ i') (hj : j ≠ j') :
    totalSum (basicMove i i' j j') = 0 := by
  have h : totalSum (basicMove i i' j j') = ∑ r, rowSum (basicMove i i' j j') r := rfl
  rw [h]
  simp [basicMove_rowSum_zero i i' j j' hi hj]

/-! ### Margin and total preservation -/

theorem basicMove_preserves_margins (T : Table m n) (i i' : Fin m) (j j' : Fin n)
    (hi : i ≠ i') (hj : j ≠ j') :
    sameMargins T (T + basicMove i i' j j') := by
  constructor
  · intro r
    rw [rowSum_add, basicMove_rowSum_zero i i' j j' hi hj, add_zero]
  · intro c
    rw [colSum_add, basicMove_colSum_zero i i' j j' hi hj, add_zero]

theorem basicMove_preserves_totalSum (T : Table m n) (i i' : Fin m) (j j' : Fin n)
    (hi : i ≠ i') (hj : j ≠ j') :
    totalSum (T + basicMove i i' j j') = totalSum T := by
  rw [totalSum_add, basicMove_totalSum_zero i i' j j' hi hj, add_zero]

/-! ### Legal basic steps -/

/-- A legal basic step from `T` to `T'`: there are distinct rows `i ≠ i'` and
distinct columns `j ≠ j'` so that `T'` is obtained from `T` by the corresponding
basic move, and both tables are nonnegative. -/
def legalBasicStep (T T' : Table m n) : Prop :=
  ∃ (i i' : Fin m) (j j' : Fin n),
    i ≠ i' ∧ j ≠ j' ∧ T' = T + basicMove i i' j j' ∧ Nonneg T ∧ Nonneg T'

theorem legalBasicStep_preserves_margins (T T' : Table m n)
    (h : legalBasicStep T T') : sameMargins T T' := by
  obtain ⟨i, i', j, j', hi, hj, heq, _, _⟩ := h
  rw [heq]
  exact basicMove_preserves_margins T i i' j j' hi hj

theorem legalBasicStep_preserves_totalSum (T T' : Table m n)
    (h : legalBasicStep T T') : totalSum T' = totalSum T := by
  obtain ⟨i, i', j, j', hi, hj, heq, _, _⟩ := h
  rw [heq]
  exact basicMove_preserves_totalSum T i i' j j' hi hj

/-!
## Summary

We defined two-way integer tables `Table m n`, their row/column/total sums, the
notion of `sameMargins`, nonnegativity, and the elementary 2×2 Markov move
`basicMove`. We proved additivity of all three sum functionals (`rowSum_add`,
`colSum_add`, `totalSum_add`), that a basic move with distinct rows and columns has
zero row sums, column sums and total (`basicMove_rowSum_zero`,
`basicMove_colSum_zero`, `basicMove_totalSum_zero`), and consequently that applying
a basic move preserves all margins and the grand total
(`basicMove_preserves_margins`, `basicMove_preserves_totalSum`). Finally we packaged
this into `legalBasicStep` and showed that legal steps preserve margins and total
(`legalBasicStep_preserves_margins`, `legalBasicStep_preserves_totalSum`).
-/

end Catalog.Algebra.MarkovMoves
