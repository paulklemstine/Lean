  "interactive_demos": [
    {
      "title": "The Hodge Diffusion Explorer: Watch Topology Survive the Smoothing",
      "description": "An interactive widget on the theta-graph Hodge Laplacian Delta = [[3,1,2],[1,3,2],[2,2,2]]. Users vary the diffusion step size a, the depth k, and the random initial vector, and watch in real time as the non-harmonic residual ||S^k x - P x|| decays along a live log-scale plot while the harmonic projection P(S^k x) remains pinned to its initial value P x0. The readout panel displays the current vector, its harmonic projection, and the residual, making the conservation law P(S^k x) = P x and the geometric over-smoothing decay tangible and explorable.",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\"/>\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/>\n<title>Hodge Diffusion Explorer</title>\n<style>\n  body { font-family: -apple-system, Segoe UI, Roboto, sans-serif; margin: 0;\n         background: #0f1226; color: #e8ecff; }\n  header { padding: 20px 28px; background: linear-gradient(120deg,#1a1f44,#2a1d52); }\n  h1 { margin: 0 0 6px; font-size: 22px; }\n  p.sub { margin: 0; color: #aab2e0; font-size: 14px; }\n  .wrap { display: flex; flex-wrap: wrap; gap: 24px; padding: 24px 28px; }\n  .panel { background: #171a37; border: 1px solid #2a2f5c; border-radius: 12px;\n           padding: 18px 20px; flex: 1 1 360px; }\n  .panel h2 { font-size: 15px; margin: 0 0 12px; color: #c7cdf5; }\n  label { display:block; font-size: 13px; margin: 14px 0 4px; color:#aab2e0; }\n  input[type=range] { width: 100%; }\n  canvas { background:#0c0e22; border-radius: 8px; width: 100%; }\n  .val { color:#7ef0c0; font-variant-numeric: tabular-nums; }\n  .eq { font-family: ui-monospace, Menlo, monospace; background:#0c0e22;\n        padding:10px 12px; border-radius:8px; color:#9fe7ff; font-size:13px;\n        white-space:pre-wrap; }\n  footer { padding: 8px 28px 28px; color:#7c84b8; font-size:12px; }\n</style>\n</head>\n<body>\n<header>\n  <h1>The Hodge Diffusion Explorer</h1>\n  <p class=\"sub\">Watch diffusion S = I &minus; a&middot;&Delta; relax the noise while the harmonic\n     fingerprint P&middot;x stays frozen &mdash; on a theta-graph complex with one hole.</p>\n</header>\n\n<div class=\"wrap\">\n  <div class=\"panel\">\n    <h2>Controls</h2>\n    <div class=\"eq\">U &mdash;e&rarr; V &mdash;d&rarr; W\n&Delta; = d*&middot;d + e&middot;e*\n&lang;&Delta;x, x&rang; = &#8214;dx&#8214;&sup2; + &#8214;e*x&#8214;&sup2;</div>\n    <label>Step size a = <span class=\"val\" id=\"aval\"></span>\n      <span style=\"color:#7c84b8\">(stable for 0 &lt; a &lt; 2/&lambda;<sub>max</sub>)</span></label>\n    <input id=\"a\" type=\"range\" min=\"0.01\" max=\"0.55\" step=\"0.01\" value=\"0.20\"/>\n    <label>Diffusion depth k = <span class=\"val\" id=\"kval\"></span></label>\n    <input id=\"k\" type=\"range\" min=\"0\" max=\"120\" step=\"1\" value=\"0\"/>\n    <label>Initial vector seed</label>\n    <input id=\"seed\" type=\"range\" min=\"0\" max=\"40\" step=\"1\" value=\"7\"/>\n    <div class=\"eq\" id=\"readout\"></div>\n  </div>\n\n  <div class=\"panel\">\n    <h2>Residual &#8214;S&#8319;x &minus; Px&#8214; vs depth</h2>\n    <canvas id=\"plot\" width=\"520\" height=\"300\"></canvas>\n  </div>\n</div>\n\n<footer>\n  &Delta; = [[3,1,2],[1,3,2],[2,2,2]] on the theta-graph edge space (first Betti number 1).\n  The harmonic projection P x is conserved at every depth: P(S&#8319;x) = P x.\n</footer>\n\n<script>\nconst A = [[3,1,2],[1,3,2],[2,2,2]];   // Hodge Laplacian on the theta graph\n// harmonic eigenvector (eigenvalue 0) of A, normalized:  [1,1,-2]/sqrt(6)\nconst H = [1/Math.sqrt(6), 1/Math.sqrt(6), -2/Math.sqrt(6)];\n\nfunction matvec(M, v){ return M.map(row => row.reduce((s,m,i)=>s+m*v[i],0)); }\nfunction dot(u,v){ return u.reduce((s,x,i)=>s+x*v[i],0); }\nfunction proj(v){ const c = dot(H,v); return H.map(h=>c*h); }   // P v = (H.v) H\nfunction sub(u,v){ return u.map((x,i)=>x-v[i]); }\nfunction norm(v){ return Math.sqrt(dot(v,v)); }\n\n// deterministic pseudo-random initial vector from a seed\nfunction initVec(seed){\n  let s = seed*2654435761 % 2147483647 || 1;\n  const r = ()=>{ s = (s*16807)%2147483647; return s/2147483647*2-1; };\n  return [r(),r(),r()];\n}\n\nfunction step(v, a){ // S v = v - a A v\n  const Av = matvec(A, v);\n  return v.map((x,i)=>x - a*Av[i]);\n}\n\nconst aEl=document.getElementById('a'), kEl=document.getElementById('k'),\n      seedEl=document.getElementById('seed'), aval=document.getElementById('aval'),\n      kval=document.getElementById('kval'), readout=document.getElementById('readout'),\n      cv=document.getElementById('plot'), ctx=cv.getContext('2d');\n\nfunction render(){\n  const a=parseFloat(aEl.value), kmax=parseInt(kEl.value), seed=parseInt(seedEl.value);\n  aval.textContent=a.toFixed(2); kval.textContent=kmax;\n  const x0=initVec(seed), Px=proj(x0);\n  // build trajectory residuals up to 120\n  let v=x0.slice(); const res=[];\n  for(let k=0;k<=120;k++){ res.push(norm(sub(v,Px))); v=step(v,a); }\n  // current state at depth kmax\n  let xk=x0.slice(); for(let k=0;k<kmax;k++) xk=step(xk,a);\n  const Pxk=proj(xk);\n  readout.textContent =\n    \"x0      = [\"+x0.map(z=>z.toFixed(3))+\"]\\n\"+\n    \"P x0    = [\"+Px.map(z=>z.toFixed(3))+\"]\\n\"+\n    \"S^k x   = [\"+xk.map(z=>z.toFixed(3))+\"]\\n\"+\n    \"P(S^k x)= [\"+Pxk.map(z=>z.toFixed(3))+\"]   (== P x0)\\n\"+\n    \"residual= \"+norm(sub(xk,Px)).toExponential(3);\n  // draw\n  ctx.clearRect(0,0,cv.width,cv.height);\n  const W=cv.width,Hh=cv.height,padL=46,padB=26,padT=12,padR=10;\n  const maxR=Math.max(...res,1e-12);\n  const x2px=k=>padL+(k/120)*(W-padL-padR);\n  const y2px=r=>{ const t=Math.log10(r+1e-15), lo=Math.log10(1e-6), hi=Math.log10(maxR);\n                  const f=(t-lo)/(hi-lo); return Hh-padB-Math.max(0,Math.min(1,f))*(Hh-padB-padT); };\n  // axes\n  ctx.strokeStyle=\"#33386b\"; ctx.lineWidth=1; ctx.beginPath();\n  ctx.moveTo(padL,padT); ctx.lineTo(padL,Hh-padB); ctx.lineTo(W-padR,Hh-padB); ctx.stroke();\n  ctx.fillStyle=\"#7c84b8\"; ctx.font=\"11px sans-serif\";\n  ctx.fillText(\"k\",W-18,Hh-10); ctx.fillText(\"||S^k x - P x||\",6,padT+8);\n  // curve\n  ctx.strokeStyle=\"#7ef0c0\"; ctx.lineWidth=2; ctx.beginPath();\n  res.forEach((r,k)=>{ const px=x2px(k),py=y2px(r); k?ctx.lineTo(px,py):ctx.moveTo(px,py); });\n  ctx.stroke();\n  // marker at current depth\n  const mx=x2px(kmax),my=y2px(res[kmax]);\n  ctx.fillStyle=\"#ff7ea8\"; ctx.beginPath(); ctx.arc(mx,my,5,0,7); ctx.fill();\n}\n[aEl,kEl,seedEl].forEach(el=>el.addEventListener('input',render));\nrender();\n</script>\n</body>\n</html>\n"
    }
