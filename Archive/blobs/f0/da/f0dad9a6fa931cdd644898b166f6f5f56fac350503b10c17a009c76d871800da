  "interactive_demos": [
    {
      "title": "Markov Basis Explorer: Interactive 2x2 Swap Moves on a Live Table",
      "description": "A browser widget displaying a 3x4 contingency table with its row and column margins highlighted. Users click two distinct rows and two distinct columns to select a basic 2x2 swap move B(i,i',j,j'), then apply it (or its reverse). The widget enforces legality (rejecting any move that would create a negative entry), confirms after every move that the gold-highlighted margins are unchanged, and offers a 'random walk' button that applies a sequence of legal moves to illustrate how the basic moves wander through a single fiber while preserving all margins. A hands-on demonstration of margin invariance, reversibility, and fiber connectivity.",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\"/>\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/>\n<title>Markov Basis Explorer - 2x2 Swap Moves</title>\n<style>\n  body { font-family: -apple-system, Segoe UI, Roboto, sans-serif;\n         background:#0f172a;color:#e2e8f0;margin:0;padding:24px;}\n  h1 { font-size:22px;margin:0 0 4px;}\n  p.sub { color:#94a3b8;margin:0 0 18px;max-width:760px;line-height:1.5;}\n  .wrap { display:flex;gap:32px;flex-wrap:wrap;align-items:flex-start;}\n  table { border-collapse:collapse; }\n  td { width:54px;height:54px;text-align:center;font-size:20px;font-weight:600;\n       border:1px solid #334155;cursor:pointer;user-select:none;\n       transition:background .12s;}\n  td:hover { background:#1e293b; }\n  td.sel { background:#2563eb;color:white; }\n  .margins { color:#fbbf24;font-size:13px;margin-top:8px;}\n  .panel { background:#1e293b;padding:16px 20px;border-radius:10px;min-width:260px;}\n  button { background:#2563eb;color:white;border:none;padding:9px 16px;border-radius:7px;\n           font-size:14px;cursor:pointer;margin:4px 4px 4px 0;}\n  button:hover { background:#1d4ed8; }\n  button.ghost { background:#334155; }\n  .msg { margin-top:12px;color:#86efac;min-height:20px;font-size:14px;}\n  .bad { color:#fca5a5; }\n  code { background:#0f172a;padding:2px 6px;border-radius:4px;color:#7dd3fc;}\n</style>\n</head>\n<body>\n<h1>Markov Basis Explorer</h1>\n<p class=\"sub\">A contingency table with fixed row &amp; column margins. Click two\ndistinct rows and two distinct columns to choose a <b>2&times;2 swap move</b>\n<code>B(i,i',j,j')</code>, then apply it. The pinwheel adds +1/-1 in a balanced\npattern, so the <span style=\"color:#fbbf24\">margins (gold)</span> never change.\nThe Fundamental Theorem of Markov Bases guarantees these moves connect every\ntable sharing the same margins.</p>\n\n<div class=\"wrap\">\n  <div>\n    <div id=\"grid\"></div>\n    <div class=\"margins\" id=\"rowm\"></div>\n    <div class=\"margins\" id=\"colm\"></div>\n  </div>\n  <div class=\"panel\">\n    <div>Selected rows: <b id=\"selr\">none</b></div>\n    <div>Selected cols: <b id=\"selc\">none</b></div>\n    <div style=\"margin-top:12px;\">\n      <button onclick=\"applyMove(false)\">Apply move (-1 / +1 diagonal)</button>\n      <button class=\"ghost\" onclick=\"applyMove(true)\">Apply reverse</button>\n    </div>\n    <div>\n      <button class=\"ghost\" onclick=\"clearSel()\">Clear selection</button>\n      <button class=\"ghost\" onclick=\"reset()\">Reset table</button>\n      <button class=\"ghost\" onclick=\"scramble()\">Random walk x12</button>\n    </div>\n    <div class=\"msg\" id=\"msg\"></div>\n    <div style=\"margin-top:14px;color:#94a3b8;font-size:13px;line-height:1.5;\">\n      Initial margins are preserved by every legal move. A move is\n      <b>legal</b> only if it keeps all entries &ge; 0.\n    </div>\n  </div>\n</div>\n\n<script>\nlet M = 3, N = 4;\nconst INIT = [[3,1,0,2],[0,2,3,1],[2,1,2,1]];\nlet T = INIT.map(r => r.slice());\nlet selR = [], selC = [];\n\nfunction rowSum(i){ return T[i].reduce((a,b)=>a+b,0); }\nfunction colSum(j){ let s=0; for(let i=0;i<M;i++) s+=T[i][j]; return s; }\n\nfunction render(){\n  let html = \"<table>\";\n  for(let i=0;i<M;i++){\n    html += \"<tr>\";\n    for(let j=0;j<N;j++){\n      const sel = (selR.includes(i) && selC.includes(j)) ? \" class='sel'\" : \"\";\n      html += `<td${sel} onclick=\"pick(${i},${j})\">${T[i][j]}</td>`;\n    }\n    html += \"</tr>\";\n  }\n  html += \"</table>\";\n  document.getElementById(\"grid\").innerHTML = html;\n  let rm = []; for(let i=0;i<M;i++) rm.push(rowSum(i));\n  let cm = []; for(let j=0;j<N;j++) cm.push(colSum(j));\n  document.getElementById(\"rowm\").textContent = \"row margins: [\" + rm.join(\", \") + \"]\";\n  document.getElementById(\"colm\").textContent = \"col margins: [\" + cm.join(\", \") + \"]\";\n  document.getElementById(\"selr\").textContent = selR.length? selR.join(\", \") : \"none\";\n  document.getElementById(\"selc\").textContent = selC.length? selC.join(\", \") : \"none\";\n}\n\nfunction pick(i,j){\n  toggle(selR, i); toggle(selC, j);\n  if(selR.length>2) selR.shift();\n  if(selC.length>2) selC.shift();\n  render();\n}\nfunction toggle(arr,x){ const k=arr.indexOf(x); if(k>=0) arr.splice(k,1); else arr.push(x); }\nfunction clearSel(){ selR=[]; selC=[]; render(); }\n\nfunction applyMove(rev){\n  const msg = document.getElementById(\"msg\");\n  if(selR.length!==2 || selC.length!==2){\n    msg.className=\"msg bad\"; msg.textContent=\"Select exactly two rows and two columns.\"; return;\n  }\n  let [i,ip] = selR, [j,jp] = selC;\n  if(rev){ [i,ip] = [ip,i]; }\n  const C = T.map(r=>r.slice());\n  C[i][jp]+=1; C[ip][j]+=1; C[i][j]-=1; C[ip][jp]-=1;\n  if(C.some(r=>r.some(x=>x<0))){\n    msg.className=\"msg bad\";\n    msg.textContent=\"Illegal: that move would create a negative entry. Try the reverse.\";\n    return;\n  }\n  T = C;\n  msg.className=\"msg\";\n  msg.textContent=\"Move applied. Margins unchanged \\u2713\";\n  render();\n}\n\nfunction reset(){ T = INIT.map(r=>r.slice()); clearSel();\n  document.getElementById(\"msg\").textContent=\"\"; render(); }\n\nfunction scramble(){\n  let done=0, tries=0;\n  while(done<12 && tries<400){\n    tries++;\n    const i=Math.floor(Math.random()*M), ip=Math.floor(Math.random()*M);\n    const j=Math.floor(Math.random()*N), jp=Math.floor(Math.random()*N);\n    if(i===ip||j===jp) continue;\n    const C=T.map(r=>r.slice());\n    C[i][jp]+=1; C[ip][j]+=1; C[i][j]-=1; C[ip][jp]-=1;\n    if(C.some(r=>r.some(x=>x<0))) continue;\n    T=C; done++;\n  }\n  document.getElementById(\"msg\").className=\"msg\";\n  document.getElementById(\"msg\").textContent=\"Random walk: \"+done+\" legal moves applied, margins preserved \\u2713\";\n  render();\n}\nrender();\n</script>\n</body>\n</html>\n"
    }
