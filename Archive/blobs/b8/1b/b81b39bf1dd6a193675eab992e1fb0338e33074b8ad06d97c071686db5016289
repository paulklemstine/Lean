/-
# Local algebra of `2×2` Markov moves on two-way integer contingency tables

This file develops the *local* algebraic theory of the standard `2×2` basic
Markov move acting on two-way integer contingency tables
`Table m n := Fin m → Fin n → ℤ`.

We deliberately stay local: we formalize the basic move, prove its exact
margin–invariance and nonnegativity properties, extract an alternating
sign witness ("rectangle pattern") from a nonzero margin-preserving
difference, and prove a strict `tdist` reduction lemma for a correctly
oriented move.  Combining these we obtain a genuine one-step existence
theorem `exists_reducing_step`.  We do **not** attempt the global
fiber-connectivity theorem.
-/

import Mathlib

namespace MarkovMoves

open scoped BigOperators

/-- A two-way integer contingency table with `m` rows and `n` columns. -/
def Table (m n : ℕ) : Type := Fin m → Fin n → ℤ

namespace Table

variable {m n : ℕ}

instance : Add (Table m n) := ⟨fun u v i j => u i j + v i j⟩
instance : Sub (Table m n) := ⟨fun u v i j => u i j - v i j⟩
instance : Zero (Table m n) := ⟨fun _ _ => 0⟩

@[simp] theorem add_apply (u v : Table m n) (i : Fin m) (j : Fin n) :
    (u + v) i j = u i j + v i j := rfl

@[simp] theorem sub_apply (u v : Table m n) (i : Fin m) (j : Fin n) :
    (u - v) i j = u i j - v i j := rfl

@[simp] theorem zero_apply (i : Fin m) (j : Fin n) : (0 : Table m n) i j = 0 := rfl

/-- The sum of the entries in row `i`. -/
def rowSum (u : Table m n) (i : Fin m) : ℤ := ∑ j, u i j

/-- The sum of the entries in column `j`. -/
def colSum (u : Table m n) (j : Fin n) : ℤ := ∑ i, u i j

/-- The total sum of all entries. -/
def totalSum (u : Table m n) : ℤ := ∑ i, ∑ j, u i j

/-- A table is nonnegative if all its entries are `≥ 0`. -/
def Nonneg (u : Table m n) : Prop := ∀ i j, 0 ≤ u i j

/-- The `ℓ¹` distance between two tables. -/
def tdist (u v : Table m n) : ℤ := ∑ i, ∑ j, |u i j - v i j|

/-- The standard oriented `2×2` basic move.  It adds `+1` to the two
"diagonal" corners `(i,j)`, `(i',j')` and `-1` to the two "off-diagonal"
corners `(i,j')`, `(i',j)`. -/
def basicMove (i i' : Fin m) (j j' : Fin n) : Table m n :=
  fun a b =>
    (if a = i ∧ b = j then (1 : ℤ) else 0)
    + (if a = i' ∧ b = j' then (1 : ℤ) else 0)
    + (if a = i ∧ b = j' then (-1 : ℤ) else 0)
    + (if a = i' ∧ b = j then (-1 : ℤ) else 0)

/-! ### Pointwise evaluation of the basic move at the four corners -/

theorem basicMove_corner_ij (i i' : Fin m) (j j' : Fin n)
    (hi : i ≠ i') (hj : j ≠ j') :
    basicMove i i' j j' i j = 1 := by
      unfold basicMove; aesop;

theorem basicMove_corner_ij' (i i' : Fin m) (j j' : Fin n)
    (hi : i ≠ i') (hj : j ≠ j') :
    basicMove i i' j j' i j' = -1 := by
      unfold basicMove; aesop;

theorem basicMove_corner_i'j (i i' : Fin m) (j j' : Fin n)
    (hi : i ≠ i') (hj : j ≠ j') :
    basicMove i i' j j' i' j = -1 := by
      unfold basicMove; aesop;

theorem basicMove_corner_i'j' (i i' : Fin m) (j j' : Fin n)
    (hi : i ≠ i') (hj : j ≠ j') :
    basicMove i i' j j' i' j' = 1 := by
      unfold basicMove; aesop;

/-
Away from the four corner cells the basic move is `0`.
-/
theorem basicMove_off_support (i i' : Fin m) (j j' : Fin n)
    (a : Fin m) (b : Fin n)
    (h : ¬ ((a = i ∨ a = i') ∧ (b = j ∨ b = j'))) :
    basicMove i i' j j' a b = 0 := by
      grind +locals

/-! ### Margin invariance of the basic move -/

/-
Every row of the basic move sums to `0`.
-/
theorem rowSum_basicMove (i i' : Fin m) (j j' : Fin n) (a : Fin m) :
    rowSum (basicMove i i' j j') a = 0 := by
      unfold basicMove;
      by_cases hi : a = i <;> by_cases hi' : a = i' <;> simp +decide [ *, rowSum ];
      · simp_all +decide [ Finset.sum_add_distrib ];
      · simp_all +decide [ Finset.sum_add_distrib ];
      · by_cases hi'' : i' = i <;> simp_all +decide [ Finset.sum_add_distrib ]

/-
Every column of the basic move sums to `0`.
-/
theorem colSum_basicMove (i i' : Fin m) (j j' : Fin n) (b : Fin n) :
    colSum (basicMove i i' j j') b = 0 := by
      unfold basicMove;
      simp +decide [ colSum, Finset.sum_add_distrib ];
      by_cases hi : b = j <;> by_cases hj : b = j' <;> simp +decide [ Finset.sum_ite, Finset.filter_eq', Finset.filter_and, hi, hj ]; all_goals aesop

theorem rowSum_add (u v : Table m n) (a : Fin m) :
    rowSum (u + v) a = rowSum u a + rowSum v a := by
      exact Finset.sum_add_distrib

theorem colSum_add (u v : Table m n) (b : Fin n) :
    colSum (u + v) b = colSum u b + colSum v b := by
      exact Finset.sum_add_distrib

theorem totalSum_add (u v : Table m n) :
    totalSum (u + v) = totalSum u + totalSum v := by
      unfold Table.totalSum;
      simp +decide only [add_apply, Finset.sum_add_distrib]

theorem totalSum_basicMove (i i' : Fin m) (j j' : Fin n) :
    totalSum (basicMove i i' j j') = 0 := by
      convert Finset.sum_eq_zero fun x hx => rowSum_basicMove i i' j j' x

/-
A basic move preserves all row sums.
-/
theorem basicMove_preserves_rowSums (u : Table m n) (i i' : Fin m) (j j' : Fin n)
    (a : Fin m) :
    rowSum (u + basicMove i i' j j') a = rowSum u a := by
      rw [ rowSum_add, rowSum_basicMove, add_zero ]

/-
A basic move preserves all column sums.
-/
theorem basicMove_preserves_colSums (u : Table m n) (i i' : Fin m) (j j' : Fin n)
    (b : Fin n) :
    colSum (u + basicMove i i' j j') b = colSum u b := by
      rw [ colSum_add, colSum_basicMove, add_zero ]

/-
A basic move preserves the total sum.
-/
theorem basicMove_preserves_totalSum (u : Table m n) (i i' : Fin m) (j j' : Fin n) :
    totalSum (u + basicMove i i' j j') = totalSum u := by
      rw [ totalSum_add, totalSum_basicMove, add_zero ]

/-! ### Admissible steps -/

/-- An admissible `2×2` step: `u'` is obtained from `u` by an oriented basic
move on distinct rows `i ≠ i'` and distinct columns `j ≠ j'`, and the two
cells that get decremented are at least `1` in `u` (so that nonnegativity is
preserved). -/
def Step (u u' : Table m n) : Prop :=
  ∃ (i i' : Fin m) (j j' : Fin n),
    i ≠ i' ∧ j ≠ j' ∧ 1 ≤ u i j' ∧ 1 ≤ u i' j ∧
    u' = u + basicMove i i' j j'

/-
A step preserves all row sums.
-/
theorem Step.rowSum {u u' : Table m n} (h : Step u u') (a : Fin m) :
    rowSum u' a = rowSum u a := by
      rcases h with ⟨ i, i', j, j', hij, hj', h1, h2, rfl ⟩ ; exact basicMove_preserves_rowSums _ i i' j j' a;

/-
A step preserves all column sums.
-/
theorem Step.colSum {u u' : Table m n} (h : Step u u') (b : Fin n) :
    colSum u' b = colSum u b := by
      obtain ⟨ i, i', j, j', hij, hj, h₁, h₂, rfl ⟩ := h;
      convert basicMove_preserves_colSums u i i' j j' b using 1

/-
A step preserves the total sum.
-/
theorem Step.totalSum {u u' : Table m n} (h : Step u u') :
    totalSum u' = totalSum u := by
      obtain ⟨ i, i', j, j', hij, hj, h₁, h₂, rfl ⟩ := h; exact basicMove_preserves_totalSum u i i' j j';

/-
An admissible step preserves nonnegativity.
-/
theorem Step.nonneg {u u' : Table m n} (hu : Nonneg u) (h : Step u u') :
    Nonneg u' := by
      obtain ⟨ i, i', j, j', hij, hj, h₁, h₂, rfl ⟩ := h;
      intro a b; simp [basicMove];
      split_ifs <;> simp_all +decide;
      · linarith [ hu i j ];
      · linarith [ hu i' j' ];
      · exact hu a b

/-! ### A double-sum support lemma -/

/-
If `f` is supported on the four corner cells determined by distinct rows
`i ≠ i'` and distinct columns `j ≠ j'`, then its double sum collapses to the
sum of the four corner values.
-/
theorem double_sum_support_four (f : Fin m → Fin n → ℤ)
    (i i' : Fin m) (j j' : Fin n) (hi : i ≠ i') (hj : j ≠ j')
    (hz : ∀ a b, ¬ ((a = i ∨ a = i') ∧ (b = j ∨ b = j')) → f a b = 0) :
    (∑ a, ∑ b, f a b) = f i j + f i j' + f i' j + f i' j' := by
      -- By Fubini's theorem, we can interchange the order of summation.
      have h_fubini : ∑ a, ∑ b, f a b = ∑ a ∈ ({i, i'} : Finset (Fin m)), ∑ b ∈ ({j, j'} : Finset (Fin n)), f a b := by
        rw [ ← Finset.sum_subset ( Finset.subset_univ { i, i' } ) ];
        · exact Finset.sum_congr rfl fun x hx => by rw [ ← Finset.sum_subset ( Finset.subset_univ { j, j' } ) ] ; aesop;
        · aesop;
      grind

/-! ### Sign / rectangle witness extraction -/

/-
In a finite integer sum that is negative, some summand is negative.
-/
theorem exists_neg_of_sum_neg {ι : Type*} (s : Finset ι) (f : ι → ℤ)
    (h : (∑ k ∈ s, f k) < 0) : ∃ k ∈ s, f k < 0 := by
      contrapose! h;
      exact Finset.sum_nonneg h

/-
A table with zero row sums, zero column sums and a nonzero entry has a
strictly positive entry.
-/
theorem exists_pos_of_margins_zero (d : Table m n)
    (hrow : ∀ i, rowSum d i = 0)
    (hne : ∃ i j, d i j ≠ 0) :
    ∃ i j, 0 < d i j := by
      contrapose! hrow; simp_all +decide [ Table.rowSum ] ;
      exact hne.imp fun i hi => by obtain ⟨ j, hj ⟩ := hi; exact ne_of_lt ( lt_of_lt_of_le ( Finset.sum_lt_sum ( fun a _ => hrow i a ) ⟨ j, Finset.mem_univ j, lt_of_le_of_ne ( hrow i j ) hj ⟩ ) ( by norm_num ) ) ;

/-
**Rectangle witness lemma.**  A nonzero table with zero row and column
sums contains three corners of an alternating `2×2` pattern: a positive entry
`(i,j)`, a negative entry `(i,j')` in the same row, and a negative entry
`(i',j)` in the same column.
-/
theorem rectangle_witness (d : Table m n)
    (hrow : ∀ i, rowSum d i = 0)
    (hcol : ∀ j, colSum d j = 0)
    (hne : ∃ i j, d i j ≠ 0) :
    ∃ (i i' : Fin m) (j j' : Fin n), i ≠ i' ∧ j ≠ j' ∧
      0 < d i j ∧ d i j' < 0 ∧ d i' j < 0 := by
        obtain ⟨ i, j, hij ⟩ := hne;
        obtain ⟨ i, j, hij ⟩ := exists_pos_of_margins_zero d hrow ⟨ i, j, hij ⟩;
        obtain ⟨ j', hj' ⟩ : ∃ j', j' ≠ j ∧ d i j' < 0 := by
          have h_sum_neg : ∑ j' ∈ Finset.univ.erase j, d i j' < 0 := by
            simp_all +decide [ Table.rowSum ];
          exact Exists.elim ( exists_neg_of_sum_neg ( Finset.univ.erase j ) ( fun j' => d i j' ) h_sum_neg ) fun x hx => ⟨ x, by aesop ⟩;
        obtain ⟨ i', hi' ⟩ : ∃ i', i' ≠ i ∧ d i' j < 0 := by
          have h_sum_neg : ∑ a ∈ Finset.univ.erase i, d a j < 0 := by
            simp_all +decide [ Table.colSum ];
          exact Exists.elim ( exists_neg_of_sum_neg ( Finset.univ.erase i ) ( fun a => d a j ) h_sum_neg ) fun x hx => ⟨ x, by aesop ⟩;
        exact ⟨ i, i', j, j', by tauto ⟩

/-
**Rectangle witness for two tables with equal margins.**  If `u ≠ v` have
the same row and column margins, then there is an oriented `2×2` rectangle
where `u` is below `v` at `(i,j)`, above `v` at `(i,j')`, and above `v` at
`(i',j)`.
-/
theorem rectangle_witness_of_margins (u v : Table m n)
    (hrow : ∀ i, rowSum u i = rowSum v i)
    (hcol : ∀ j, colSum u j = colSum v j)
    (hne : u ≠ v) :
    ∃ (i i' : Fin m) (j j' : Fin n), i ≠ i' ∧ j ≠ j' ∧
      u i j < v i j ∧ v i j' < u i j' ∧ v i' j < u i' j := by
        obtain ⟨ i, j, hij ⟩ : ∃ i j, v i j - u i j ≠ 0 := by
          contrapose! hne;
          exact funext fun i => funext fun j => by linarith [ hne i j ] ;
        obtain ⟨ i, i', j, j', hij₁, hij₂, hij₃, hij₄, hij₅ ⟩ := rectangle_witness ( fun a b => v a b - u a b ) ( fun i => by
          simp_all +decide [ rowSum, Finset.sum_sub_distrib ] ) ( fun j => by
          simp_all +decide [ colSum, Finset.sum_sub_distrib ] ) ⟨ i, j, hij ⟩ ; use i, i', j, j' ; aesop;

/-! ### `tdist` reduction -/

/-
**Local `tdist` reduction.**  Applying the oriented basic move
`basicMove i i' j j'` to `u` strictly decreases the `ℓ¹` distance to `v`,
provided the three essential corners have the right signs relative to `v`:
`u` is below `v` at the incremented corner `(i,j)`, and above `v` at the two
decremented corners `(i,j')` and `(i',j)`.  (The fourth corner can move the
distance by at most `1`, while the three good corners each save `1`.)
-/
theorem tdist_basicMove_lt (u v : Table m n) (i i' : Fin m) (j j' : Fin n)
    (hi : i ≠ i') (hj : j ≠ j')
    (h1 : u i j < v i j)
    (h2 : v i j' < u i j')
    (h3 : v i' j < u i' j) :
    tdist (u + basicMove i i' j j') v < tdist u v := by
      unfold Table.tdist;
      -- Let `u' = u + basicMove i i' j j'`. We compare `tdist u' v = ∑ a, ∑ b, |u' a b - v a b|` with `tdist u v = ∑ a, ∑ b, |u a b - v a b|`.
      set u' : Table m n := u + basicMove i i' j j' with hu';
      -- By `double_sum_support_four`, `∑ a, ∑ b, g a b = g i j + g i j' + g i' j + g i' j'`.
      have h_sum : ∑ a, ∑ b, |u' a b - v a b| - ∑ a, ∑ b, |u a b - v a b| = |u' i j - v i j| + |u' i j' - v i j'| + |u' i' j - v i' j| + |u' i' j' - v i' j'| - |u i j - v i j| - |u i j' - v i j'| - |u i' j - v i' j| - |u i' j' - v i' j'| := by
        convert double_sum_support_four ( fun a b => |u' a b - v a b| - |u a b - v a b| ) i i' j j' hi hj _ using 1;
        · simp +decide only [Finset.sum_sub_distrib];
        · ring;
        · simp +zetaDelta at *;
          intro a b hab; rw [ basicMove_off_support ] <;> aesop;
      -- Evaluate each corner using `add_apply` and the corner lemmas.
      have h_eval : u' i j = u i j + 1 ∧ u' i j' = u i j' - 1 ∧ u' i' j = u i' j - 1 ∧ u' i' j' = u i' j' + 1 := by
        simp +zetaDelta at *;
        unfold basicMove; simp +decide [ hi, hj ] ;
        grind;
      grind

/-! ### One-step existence theorem -/

/-
**One-step existence.**  If `u ≠ v` are nonnegative tables with the same
row and column margins, then there is an admissible step from `u` that strictly
decreases the `ℓ¹` distance to `v`.
-/
theorem exists_reducing_step (u v : Table m n)
    (hv : Nonneg v)
    (hrow : ∀ i, rowSum u i = rowSum v i)
    (hcol : ∀ j, colSum u j = colSum v j)
    (hne : u ≠ v) :
    ∃ u', Step u u' ∧ tdist u' v < tdist u v := by
      obtain ⟨ i, i', j, j', hi, hj, h1, h2, h3 ⟩ := rectangle_witness_of_margins u v hrow hcol hne;
      have h_step : 1 ≤ u i j' ∧ 1 ≤ u i' j := by
        exact ⟨ by linarith [ hv i j' ], by linarith [ hv i' j ] ⟩;
      exact ⟨ _, ⟨ i, i', j, j', hi, hj, h_step.1, h_step.2, rfl ⟩, tdist_basicMove_lt u v i i' j j' hi hj h1 h2 h3 ⟩

end Table

end MarkovMoves