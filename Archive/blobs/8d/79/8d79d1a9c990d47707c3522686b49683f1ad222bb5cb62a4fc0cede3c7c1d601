import Mathlib

/-!
# Elementary 2×2 Markov move for two-way contingency tables

This file develops the finite algebraic soundness of a single basic `2×2`
Markov move on integer two-way contingency tables, together with the legality
wrapper for nonnegative tables.

The main result is `legalBasicStep_preserves_margins`: a legal basic step
between two entrywise nonnegative tables preserves all row and column margins.
-/

namespace MarkovMoves

/-- A two-way integer contingency table with `m` rows and `n` columns. -/
abbrev Table (m n : ℕ) := Matrix (Fin m) (Fin n) ℤ

variable {m n : ℕ}

/-- The sum of entries in row `i`. -/
def rowSum (T : Table m n) (i : Fin m) : ℤ := ∑ j, T i j

/-- The sum of entries in column `j`. -/
def colSum (T : Table m n) (j : Fin n) : ℤ := ∑ i, T i j

/-- The sum of all entries of the table. -/
def totalSum (T : Table m n) : ℤ := ∑ i, ∑ j, T i j

/-- Two tables have the same margins when their row sums and column sums agree. -/
def sameMargins (T T' : Table m n) : Prop :=
    (∀ i, rowSum T i = rowSum T' i) ∧ (∀ j, colSum T j = colSum T' j)

/-- A table is entrywise nonnegative. -/
def Nonneg (T : Table m n) : Prop := ∀ i j, 0 ≤ T i j

/-- The basic `2×2` Markov move: `-1` at `(i,j)` and `(i',j')`, `+1` at
`(i,j')` and `(i',j)`, and `0` elsewhere. -/
def basicMove (i i' : Fin m) (j j' : Fin n) : Table m n :=
  fun r c =>
    if r = i ∧ c = j then -1
    else if r = i' ∧ c = j' then -1
    else if r = i ∧ c = j' then 1
    else if r = i' ∧ c = j then 1
    else 0

/-- Row sums are additive. -/
theorem rowSum_add (T U : Table m n) (i : Fin m) :
    rowSum (T + U) i = rowSum T i + rowSum U i :=
  Finset.sum_add_distrib

/-- Column sums are additive. -/
theorem colSum_add (T U : Table m n) (j : Fin n) :
    colSum (T + U) j = colSum T j + colSum U j :=
  Finset.sum_add_distrib

/-- Total sums are additive. -/
theorem totalSum_add (T U : Table m n) :
    totalSum (T + U) = totalSum T + totalSum U := by
  unfold totalSum
  simp [Matrix.add_apply, Finset.sum_add_distrib]

/-- The basic move has zero row sums on every row. -/
theorem rowSum_basicMove (i i' : Fin m) (j j' : Fin n)
    (hii' : i ≠ i') (hjj' : j ≠ j') (r : Fin m) :
    rowSum (basicMove i i' j j') r = 0 := by
  unfold rowSum basicMove
  by_cases hr : r = i <;> by_cases hr' : r = i' <;> simp +decide [hr, hr']
  · grind
  · simp +decide [Finset.sum_ite, Finset.filter_eq', Finset.filter_ne', hii']
    grind
  · simp +decide [Finset.sum_ite, Finset.filter_eq', Finset.filter_ne', hii'.symm, hjj']

/-- The basic move has zero column sums on every column. -/
theorem colSum_basicMove (i i' : Fin m) (j j' : Fin n)
    (hii' : i ≠ i') (hjj' : j ≠ j') (c : Fin n) :
    colSum (basicMove i i' j j') c = 0 := by
  unfold colSum basicMove
  rw [Finset.sum_eq_add i i'] <;> aesop

/-- The basic move has zero total sum. -/
theorem basicMove_totalSum_zero (i i' : Fin m) (j j' : Fin n)
    (hii' : i ≠ i') (hjj' : j ≠ j') :
    totalSum (basicMove i i' j j') = 0 := by
  convert Finset.sum_eq_zero _
  exact fun x _ => rowSum_basicMove i i' j j' hii' hjj' x

/-- Adding a basic move preserves all margins. -/
theorem basicMove_preserves_margins (T : Table m n) (i i' : Fin m) (j j' : Fin n)
    (hii' : i ≠ i') (hjj' : j ≠ j') :
    sameMargins T (T + basicMove i i' j j') := by
  refine ⟨fun r => ?_, fun c => ?_⟩
  · rw [rowSum_add, rowSum_basicMove i i' j j' hii' hjj', add_zero]
  · rw [colSum_add, colSum_basicMove i i' j j' hii' hjj', add_zero]

/-- Adding a basic move preserves the total sum. -/
theorem basicMove_preserves_totalSum (T : Table m n) (i i' : Fin m) (j j' : Fin n)
    (hii' : i ≠ i') (hjj' : j ≠ j') :
    totalSum (T + basicMove i i' j j') = totalSum T := by
  rw [totalSum_add, basicMove_totalSum_zero i i' j j' hii' hjj', add_zero]

/-- A legal basic step from `T` to `T'`: both tables are entrywise nonnegative
and `T'` is obtained from `T` by adding a basic move. -/
def legalBasicStep (T T' : Table m n) (i i' : Fin m) (j j' : Fin n) : Prop :=
    Nonneg T ∧ Nonneg T' ∧ T' = T + basicMove i i' j j'

/-- A legal basic step preserves all margins. -/
theorem legalBasicStep_preserves_margins (T T' : Table m n)
    (i i' : Fin m) (j j' : Fin n)
    (hii' : i ≠ i') (hjj' : j ≠ j')
    (h : legalBasicStep T T' i i' j j') :
    sameMargins T T' := by
  rcases h with ⟨_, _, rfl⟩
  exact basicMove_preserves_margins T i i' j j' hii' hjj'

end MarkovMoves
