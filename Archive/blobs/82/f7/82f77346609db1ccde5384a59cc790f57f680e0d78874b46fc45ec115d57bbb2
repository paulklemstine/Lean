# A Sound Tropical Lower-Bound Certificate for Combinatorial-Species Expressions

This file builds a small syntax `SpExpr` of combinatorial-species expressions whose
denotation is an integer coefficient sequence `ℕ → ℤ`, and proves that a *structurally
computed tropical lower bound* always lies below the actual **p-adic valuation profile**
of the denoted sequence.

The semantics mirror the catalog's species counting operations
(`Catalog/Applications/CombinatorialSpecies.lean`).  Because that file lives in a directory
that is not configured as a Lean library of this package (and so cannot be imported), the
small amount of species infrastructure that is needed — the `Species` structure, the species
of sets `E` (`setSpecies`), the empty species `0` (`emptySpecies`), and the cardinality of the
structural (Day-convolution) product (`card_prodSpecies`) — is reproduced here verbatim, and
`mul` is shown to denote exactly the species product count (`intBinConv_card_prodSpecies`).

* the two atoms are the **species of sets** `E` (`setSpecies`, counting sequence the
  constant `1`) and the **empty species** `0` (`emptySpecies`, counting sequence the
  constant `0`);
* `add` is interpreted coefficientwise (the sum / disjoint-union of species);
* `mul` is interpreted by the **binomial convolution** `intBinConv`, which equals the
  cardinality of the structural product of species (`intBinConv_card_prodSpecies`).

The **valuation profile** of a coefficient sequence `a` at a prime `p` is the family of
`p`-adic valuations `valProfile p a n = emultiplicity (p : ℤ) (a n) : ℕ∞`, where `⊤`
records a vanishing coefficient.

The **tropical lower bound** `tropLB` is computed structurally in the min-plus semiring
`ℕ∞ = WithTop ℕ`:

* atoms: `0` for `E` (its coefficients are units), `⊤` for the empty species;
* `add`: pointwise `min`;
* `mul`: min-plus convolution `⨅_{i+j=n} (tropLB e₁ i + tropLB e₂ j)`.

## Main results
* `valProfile_add_node`     — the ultrametric step: `min` is a sound lower bound for `+`.
* `valProfile_mul_node`     — the min-plus convolution step: a sound lower bound for the
  binomial convolution.
* `tropLB_le_valProfile`    — the soundness certificate: `tropLB p e n ≤ valProfile p e.coeff n`,
  proved by structural induction on `e`.
-/
import Mathlib

open scoped Classical BigOperators
open Finset

namespace SpeciesTropicalProfile

noncomputable section

/-! ### Minimal species infrastructure (mirroring `CombinatorialSpecies`) -/

/-- A **combinatorial species** in skeletal form: a family of finite structure types `obj n`
together with a functorial relabelling action.  (Reproduced from
`Catalog/Applications/CombinatorialSpecies.lean`.) -/
structure Species where
  /-- `obj n` = the (finite) set of `F`-structures on a fixed `n`-element label set. -/
  obj : ℕ → Type
  /-- Each structure set is finite. -/
  fintypeObj : ∀ n, Fintype (obj n)
  /-- Relabelling acts functorially: `Sₙ → Perm (F[n])`. -/
  act : ∀ n, Equiv.Perm (Fin n) →* Equiv.Perm (obj n)

attribute [instance] Species.fintypeObj

/-- The counting sequence `n ↦ |F[n]|` of a species. -/
def Species.coeffSeq (F : Species) (n : ℕ) : ℕ := Fintype.card (F.obj n)

/-- The **species of sets** `E`: a unique structure on every label set. -/
def setSpecies : Species where
  obj := fun _ => Unit
  fintypeObj := fun _ => inferInstance
  act := fun _ => 1

/-- The **empty species** `0`: no structure on any label set. -/
def emptySpecies : Species where
  obj := fun _ => Empty
  fintypeObj := fun _ => inferInstance
  act := fun _ => 1

@[simp] lemma coeffSeq_setSpecies (n : ℕ) : setSpecies.coeffSeq n = 1 := by
  simp [Species.coeffSeq, setSpecies]

@[simp] lemma coeffSeq_emptySpecies (n : ℕ) : emptySpecies.coeffSeq n = 0 := by
  simp [Species.coeffSeq, emptySpecies]

/-! ### Integer binomial convolution (the species product on counting sequences) -/

/-- The integer **binomial convolution** of two coefficient sequences:
`(a ⋆ b)ₙ = ∑_{i+j=n} C(n,i)·aᵢ·bⱼ`.  This is the integer shadow of the species product
counting law. -/
def intBinConv (a b : ℕ → ℤ) (n : ℕ) : ℤ :=
  ∑ pr ∈ Finset.antidiagonal n, (n.choose pr.1 : ℤ) * a pr.1 * b pr.2

/-- **Cardinality of the structural product species.** For structure families `A`, `B`, the
Day-convolution product `(A·B)[n] = Σ_{S ⊆ [n]} A[|S|] × B[n∖S]` has cardinality the binomial
convolution of the counting sequences.  (Reproduced from `CombinatorialSpecies`.) -/
theorem card_prodSpecies (A B : ℕ → Type) [∀ k, Fintype (A k)] [∀ k, Fintype (B k)] (n : ℕ) :
    Fintype.card (Σ S : Finset (Fin n), A S.card × B (n - S.card))
      = ∑ p ∈ Finset.antidiagonal n,
          n.choose p.1 * Fintype.card (A p.1) * Fintype.card (B p.2) := by
  simp +decide only [Fintype.card_sigma, Fintype.card_prod]
  rw [Finset.sum_congr rfl fun x hx => by rw [mul_comm]]
  rw [Finset.sum_congr rfl fun x hx => by rw [mul_comm]]
  rw [Finset.Nat.sum_antidiagonal_eq_sum_range_succ_mk]
  rw [show (Finset.univ : Finset (Finset (Fin n)))
        = Finset.biUnion (Finset.range (n + 1))
            fun k => Finset.powersetCard k (Finset.univ : Finset (Fin n)) from ?_,
      Finset.sum_biUnion]
  · refine Finset.sum_congr rfl fun i hi => ?_
    rw [Finset.sum_congr rfl fun j hj => by rw [Finset.mem_powersetCard.mp hj |>.2]]
    simp +decide [mul_assoc]
  · exact fun i hi j hj hij => Finset.disjoint_left.mpr fun x hx₁ hx₂ =>
      hij <| by rw [Finset.mem_powersetCard] at hx₁ hx₂; aesop
  · ext s
    simp [Finset.mem_biUnion, Finset.mem_powersetCard]
    exact le_trans (Finset.card_le_univ _) (by norm_num)

/-- **Faithfulness to the species product count.** For finite structure families `A`, `B`, the
integer binomial convolution of their counting sequences equals the cardinality of the
structural (Day-convolution) product `(A·B)[n]`. -/
lemma intBinConv_card_prodSpecies
    (A B : ℕ → Type) [∀ k, Fintype (A k)] [∀ k, Fintype (B k)] (n : ℕ) :
    intBinConv (fun k => (Fintype.card (A k) : ℤ)) (fun k => (Fintype.card (B k) : ℤ)) n
      = (Fintype.card (Σ S : Finset (Fin n), A S.card × B (n - S.card)) : ℤ) := by
  rw [card_prodSpecies A B n]
  simp only [intBinConv]
  push_cast
  ring_nf

/-! ### The syntax of species expressions and its coefficient denotation -/

/-- A minimal syntax of combinatorial-species expressions: the two atoms `sets` (`E`) and
`empty` (`0`), closed under `add` (sum of species) and `mul` (product of species). -/
inductive SpExpr : Type
  | sets : SpExpr
  | empty : SpExpr
  | add : SpExpr → SpExpr → SpExpr
  | mul : SpExpr → SpExpr → SpExpr

/-- The coefficient denotation `SpExpr → ℕ → ℤ`: atoms denote their species counting
sequences, `add` denotes coefficientwise addition, and `mul` denotes the binomial
convolution `intBinConv`. -/
def SpExpr.coeff : SpExpr → ℕ → ℤ
  | .sets, n => (setSpecies.coeffSeq n : ℤ)
  | .empty, n => (emptySpecies.coeffSeq n : ℤ)
  | .add e₁ e₂, n => e₁.coeff n + e₂.coeff n
  | .mul e₁ e₂, n => intBinConv e₁.coeff e₂.coeff n

@[simp] lemma coeff_sets (n : ℕ) : SpExpr.sets.coeff n = 1 := by
  simp [SpExpr.coeff]

@[simp] lemma coeff_empty (n : ℕ) : SpExpr.empty.coeff n = 0 := by
  simp [SpExpr.coeff]

@[simp] lemma coeff_add (e₁ e₂ : SpExpr) (n : ℕ) :
    (e₁.add e₂).coeff n = e₁.coeff n + e₂.coeff n := rfl

@[simp] lemma coeff_mul (e₁ e₂ : SpExpr) (n : ℕ) :
    (e₁.mul e₂).coeff n = intBinConv e₁.coeff e₂.coeff n := rfl

/-! ### The valuation profile and the structural tropical lower bound -/

/-- The **p-adic valuation profile** of a coefficient sequence: `valProfile p a n` is the
`p`-adic valuation of the `n`-th coefficient, as an element of `ℕ∞ = WithTop ℕ` (with `⊤`
for a vanishing coefficient). -/
def valProfile (p : ℕ) (a : ℕ → ℤ) (n : ℕ) : ℕ∞ :=
  emultiplicity (p : ℤ) (a n)

/-- The **structural tropical lower bound** of a species expression, computed in the
min-plus semiring `ℕ∞`: `0` / `⊤` on the atoms, pointwise `min` on `add`, and min-plus
convolution on `mul`. -/
def tropLB (p : ℕ) : SpExpr → ℕ → ℕ∞
  | .sets, _ => 0
  | .empty, _ => ⊤
  | .add e₁ e₂, n => min (tropLB p e₁ n) (tropLB p e₂ n)
  | .mul e₁ e₂, n =>
      (Finset.antidiagonal n).inf (fun pr => tropLB p e₁ pr.1 + tropLB p e₂ pr.2)

/-! ### Valuation lemmas -/

/-- **Finset valuation bound.** The valuation of a finite sum is at least the infimum of the
valuations of the summands (the additive ultrametric, lifted to finite sums). -/
lemma inf_emultiplicity_le_emultiplicity_sum {ι : Type*} (p : ℤ) (s : Finset ι) (f : ι → ℤ) :
    s.inf (fun i => emultiplicity p (f i)) ≤ emultiplicity p (∑ i ∈ s, f i) := by
  classical
  induction s using Finset.induction with
  | empty => simp [emultiplicity_zero]
  | insert a s ha ih =>
      rw [Finset.sum_insert ha, Finset.inf_insert]
      calc min (emultiplicity p (f a)) (s.inf fun i => emultiplicity p (f i))
          ≤ min (emultiplicity p (f a)) (emultiplicity p (∑ i ∈ s, f i)) :=
            min_le_min le_rfl ih
        _ ≤ emultiplicity p (f a + ∑ i ∈ s, f i) := min_le_emultiplicity_add

/-- A single binomial-convolution summand `c·x·y` has valuation at least `v(x) + v(y)`. -/
lemma emultiplicity_term_bound (p : ℤ) (hp : Prime p) (c x y : ℤ) :
    emultiplicity p x + emultiplicity p y ≤ emultiplicity p (c * x * y) := by
  rw [emultiplicity_mul hp, emultiplicity_mul hp]
  gcongr
  exact le_add_self

/-- **The `add` step (ultrametric).** Pointwise `min` of valuation profiles is a sound lower
bound for the valuation profile of the coefficientwise sum. -/
theorem valProfile_add_node (p : ℕ) (a b : ℕ → ℤ) (n : ℕ) :
    min (valProfile p a n) (valProfile p b n) ≤ valProfile p (fun k => a k + b k) n := by
  simpa [valProfile] using
    (min_le_emultiplicity_add (p := (p : ℤ)) (a := a n) (b := b n))

/-- **The `mul` step (min-plus convolution).** The min-plus convolution of valuation
profiles is a sound lower bound for the valuation profile of the binomial convolution. -/
theorem valProfile_mul_node (p : ℕ) (hp : p.Prime) (a b : ℕ → ℤ) (n : ℕ) :
    (Finset.antidiagonal n).inf (fun pr => valProfile p a pr.1 + valProfile p b pr.2)
      ≤ valProfile p (intBinConv a b) n := by
  have hp' : Prime ((p : ℤ)) := Nat.prime_iff_prime_int.mp hp
  calc
    (Finset.antidiagonal n).inf (fun pr => valProfile p a pr.1 + valProfile p b pr.2)
        ≤ (Finset.antidiagonal n).inf
            (fun pr => emultiplicity (p : ℤ) ((n.choose pr.1 : ℤ) * a pr.1 * b pr.2)) := by
          refine Finset.inf_mono_fun (fun pr _ => ?_)
          exact emultiplicity_term_bound (p : ℤ) hp' (n.choose pr.1 : ℤ) (a pr.1) (b pr.2)
    _ ≤ valProfile p (intBinConv a b) n := by
          simpa [valProfile, intBinConv] using
            inf_emultiplicity_le_emultiplicity_sum (p := (p : ℤ))
              (s := Finset.antidiagonal n)
              (f := fun pr => (n.choose pr.1 : ℤ) * a pr.1 * b pr.2)

/-! ### The soundness certificate -/

/-- **Tropical lower-bound certificate (soundness).** For every prime `p` and every species
expression `e`, the structurally computed tropical lower bound is below the actual `p`-adic
valuation profile of the denoted coefficient sequence. -/
theorem tropLB_le_valProfile (p : ℕ) (hp : p.Prime) (e : SpExpr) (n : ℕ) :
    tropLB p e n ≤ valProfile p e.coeff n := by
  induction e generalizing n with
  | sets => exact bot_le
  | empty =>
      have h : valProfile p SpExpr.empty.coeff n = ⊤ := by
        simp [valProfile, coeff_empty, emultiplicity_zero]
      rw [h]; exact le_top
  | add e₁ e₂ ih₁ ih₂ =>
      have := le_trans (min_le_min (ih₁ n) (ih₂ n))
        (valProfile_add_node p e₁.coeff e₂.coeff n)
      simpa [tropLB] using this
  | mul e₁ e₂ ih₁ ih₂ =>
      have hstep :
          (Finset.antidiagonal n).inf (fun pr => tropLB p e₁ pr.1 + tropLB p e₂ pr.2)
            ≤ (Finset.antidiagonal n).inf
                (fun pr => valProfile p e₁.coeff pr.1 + valProfile p e₂.coeff pr.2) :=
        Finset.inf_mono_fun (fun pr _ => add_le_add (ih₁ pr.1) (ih₂ pr.2))
      have := le_trans hstep (valProfile_mul_node p hp e₁.coeff e₂.coeff n)
      simpa [tropLB] using this

end

end SpeciesTropicalProfile
