import Bridges.StrongDivisibilitySequences

/-! # Primitive divisors at prime indices of strong divisibility sequences

Domain: Bridges / Number theory.

For a strong divisibility sequence `s` and a **prime** index `n`, any divisor `p` of
`s.a n` that does *not* divide `s.a 1` is automatically a primitive divisor at index `n`.

The argument is the classical entry-point computation:

* `entryPoint_ne_one` — from `¬ p ∣ s.a 1` the entry point of `p` cannot be `1`.
* `isPrimitive_of_prime_index` — combine `dvd_iff_entryPoint_dvd` with the fact that a
  prime's only divisors are `1` and itself, exclude `1` via `entryPoint_ne_one`, deduce
  `entryPoint p = n`, and convert to primitivity via `primitive_iff_entryPoint_eq`.
-/

namespace StrongDivSeq

variable (s : StrongDivSeq)

/-- If `p` does not divide `s.a 1`, then the entry point of `p` is not `1`. -/
theorem entryPoint_ne_one {p : ℕ} (h1 : ¬ p ∣ s.a 1) : s.entryPoint p ≠ 1 := by
  intro hep
  -- A nonzero entry point forces existence of a witness, so `p` is primitive there.
  have hex : ∃ k, 0 < k ∧ p ∣ s.a k := by
    by_contra hno
    rw [entryPoint, dif_neg hno] at hep
    exact absurd hep (by norm_num)
  have hprim := s.entryPoint_isPrimitive hex
  rw [hep] at hprim
  exact h1 hprim.1

/-- **Primitive divisors at prime indices.** For a strong divisibility sequence `s`, if `n`
is prime, `p ∣ s.a n`, and `p ∤ s.a 1`, then `p` is a primitive divisor of `s` at index `n`. -/
theorem isPrimitive_of_prime_index {p n : ℕ} (hn : Nat.Prime n)
    (hpn : p ∣ s.a n) (h1 : ¬ p ∣ s.a 1) : s.IsPrimitive p n := by
  have hnpos : 0 < n := hn.pos
  have hex : ∃ k, 0 < k ∧ p ∣ s.a k := ⟨n, hnpos, hpn⟩
  -- The entry point divides the prime index `n`.
  have hdvd : s.entryPoint p ∣ n := (s.dvd_iff_entryPoint_dvd hex n).1 hpn
  -- Hence it is `1` or `n`; exclude `1`.
  have hcases := hn.eq_one_or_self_of_dvd _ hdvd
  have heq : s.entryPoint p = n := by
    rcases hcases with h | h
    · exact absurd h (s.entryPoint_ne_one h1)
    · exact h
  exact (s.primitive_iff_entryPoint_eq hnpos hex).2 heq

end StrongDivSeq
