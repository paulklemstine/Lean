import Mathlib

open Finset BigOperators

namespace NoiseStablePrimeSpectrum

variable {n : ℕ} [NeZero n]

/-- The standard additive character `ψ(x) = exp(2πi x / n)` of `ZMod n`,
phrased as a plain function for readability. -/
noncomputable def chi (x : ZMod n) : ℂ := ZMod.stdAddChar x

@[simp] lemma chi_zero : chi (0 : ZMod n) = 1 := by
  simp [chi]

lemma chi_norm (x : ZMod n) : ‖chi x‖ = 1 := by
  rw [chi, ZMod.stdAddChar_apply]; simp

/-- The eigenvalue of the Cayley-graph walk generator on `Cay(ZMod n, S)` at the
Fourier mode `j`: the additive-character sum `∑_{s ∈ S} ψ(j·s)`. -/
noncomputable def ceig (S : Finset (ZMod n)) (j : ZMod n) : ℂ :=
  ∑ s ∈ S, chi (j * s)

/-- The weighted (gate-amplitude) generalization: each step `s` carries a complex
amplitude `w s`. This is the perturbation/noise model: a "gate perturbation"
is a change of the weight function `w`. -/
noncomputable def weig (w : ZMod n → ℂ) (T : Finset (ZMod n)) (j : ZMod n) : ℂ :=
  ∑ s ∈ T, w s * chi (j * s)

-- !-- The trivial Fourier mode `j = 0` makes every character `1`, so the
-- eigenvalue is just the number of gates, i.e. the graph degree (Perron value). -- !--
/-- **Perron / degree eigenvalue.** At the trivial mode the eigenvalue is the degree `|S|`. -/
theorem ceig_zero_eq_card (S : Finset (ZMod n)) :
    ceig S 0 = (S.card : ℂ) := by
  simp [ceig]

-- !-- Swap the double sum and apply primitive-character orthogonality
-- (`AddChar.sum_mulShift`): the inner sum over `j` collapses to `n·[s=0]`. -- !--
/-- **Spectral trace / orthogonality.** Summing the eigenvalue over all Fourier
modes recovers `n` times the indicator that the step set contains the identity
(a self-loop). For loop-free walks (`0 ∉ S`) the spectrum is traceless. -/
theorem ceig_total (S : Finset (ZMod n)) :
    ∑ j : ZMod n, ceig S j = (if (0 : ZMod n) ∈ S then (n : ℂ) else 0) := by
  -- For fixed $s$, the inner sum $\sum_{j : ZMod n} \chi(j * s)$ by AddChar.sum_mulShift gives $n$ if $s=0$ and $0$ if $s \neq 0$.
  have h_inner_sum : ∀ s : ZMod n, ∑ j : ZMod n, ZMod.stdAddChar (j * s) = if s = 0 then (n : ℂ) else 0 := by
    intro s; split_ifs <;> simp_all +decide [ ZMod.stdAddChar ] ;
    convert AddChar.sum_mulShift s ( ZMod.isPrimitive_stdAddChar n ) using 1;
    aesop;
  convert Finset.sum_comm.trans ( Finset.sum_congr rfl fun s hs => h_inner_sum s ) using 1;
  aesop

-- !-- `ψ(-x) = conj ψ(x)` since `|ψ| = 1`; reindexing the symmetric step set
-- `s ↦ -s` shows the eigenvalue equals its own conjugate. -- !--
/-- **Hermitian spectrum.** If the step set is symmetric (`s ∈ S ↔ -s ∈ S`) the
eigenvalues are real, i.e. equal to their complex conjugates. This is the
self-adjointness underlying a genuine *unitary* quantum walk. -/
theorem ceig_conj (S : Finset (ZMod n)) (hS : ∀ s ∈ S, -s ∈ S) (j : ZMod n) :
    (starRingEnd ℂ) (ceig S j) = ceig S j := by
  unfold ceig; simp +decide ;
  apply Finset.sum_bij (fun s _ => -s);
  · assumption;
  · aesop;
  · exact fun s hs => ⟨ -s, hS s hs, neg_neg s ⟩;
  · unfold chi; simp +decide [ AddChar.map_neg_eq_inv ] ;
    exact fun a ha => Eq.symm (AddChar.inv_apply_eq_conj ZMod.stdAddChar (j * a))

-- !-- Complete graph = all gates except the identity. Use orthogonality over
-- the full vertex set and subtract the removed self-loop `ψ(0)=1`. -- !--
/-- **Complete Cayley walk spectrum.** For the complete graph (every nonzero
shift) the spectrum is the maximally degenerate `{ |n| - 1, -1, …, -1 }`:
the Perron value `n-1` at mode `0`, and `-1` at every nonzero mode. This is the
extremal *fragile* walk: an eigenphase mass concentrated at a single point. -/
theorem ceig_complete (j : ZMod n) :
    ceig (Finset.univ \ {0}) j = (if j = 0 then (n : ℂ) - 1 else -1) := by
  -- Split on whether j is 0 or not.
  by_cases hj : j = 0;
  · simp +decide [ hj, ceig ];
    simp +decide [ Finset.card_sdiff, Finset.card_singleton, Finset.card_univ ];
    rw [ Nat.cast_pred ( NeZero.pos n ) ];
  · -- For $j \neq 0$, we use the orthogonality relation of the characters.
    have h_ortho : ∑ s ∈ Finset.univ, chi (j * s) = 0 := by
      have h_char_ortho : ∀ (ψ : AddChar (ZMod n) ℂ), ψ ≠ 1 → ∑ x : ZMod n, ψ x = 0 := by
        intro ψ hψ;
        exact AddChar.sum_eq_zero_iff_ne_zero.mpr hψ;
      convert h_char_ortho ( ZMod.stdAddChar.compAddMonoidHom ( AddMonoidHom.mulLeft j ) ) _ using 1;
      have := ZMod.isPrimitive_stdAddChar n; simp_all +decide [ AddChar.IsPrimitive ] ;
      specialize this hj ; simp_all +decide [ AddChar.ext_iff, AddChar.mulShift ] ;
    simp_all +decide [ ceig ]

-- !-- Triangle inequality plus `|ψ| = 1`: the eigenvalue difference is bounded
-- by the ℓ¹ norm of the weight difference. The Lipschitz/noise-stability core. -- !--
/-- **Noise stability (ℓ¹-Lipschitz eigenvalues).** Perturbing the gate weights
from `w₁` to `w₂` moves each eigenvalue by at most the `ℓ¹` size of the
perturbation. This is the rigorous content of "Wasserstein-`O(ε)`" stability of
the eigenphase law under gate noise. -/
theorem weig_perturbation_le (w₁ w₂ : ZMod n → ℂ) (T : Finset (ZMod n)) (j : ZMod n) :
    ‖weig w₁ T j - weig w₂ T j‖ ≤ ∑ s ∈ T, ‖w₁ s - w₂ s‖ := by
  simp +decide [ ← Finset.sum_sub_distrib, weig ];
  refine' le_trans ( norm_sum_le _ _ ) _;
  norm_num [ ← sub_mul, chi_norm ]

/-- **Uniform noise bound.** If every gate amplitude is perturbed by at most `ε`,
the eigenvalue moves by at most `|T|·ε` — the explicit `O(ε)` stability constant. -/
theorem weig_perturbation_uniform (w₁ w₂ : ZMod n → ℂ) (T : Finset (ZMod n))
    (j : ZMod n) (ε : ℝ) (hε : ∀ s ∈ T, ‖w₁ s - w₂ s‖ ≤ ε) :
    ‖weig w₁ T j - weig w₂ T j‖ ≤ (T.card : ℝ) * ε := by
  refine' le_trans _ ( le_trans ( Finset.sum_le_sum hε ) _ );
  · convert weig_perturbation_le w₁ w₂ T j using 1;
  · norm_num

end NoiseStablePrimeSpectrum