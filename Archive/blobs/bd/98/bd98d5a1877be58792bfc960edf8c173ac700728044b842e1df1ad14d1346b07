import Mathlib

/-!
# Ladder Density: an intermediate degree between consecutive power rungs

This file develops a small, self-contained slice of proof-complexity order theory:
the **simulation preorder** on abstract complexity measures, the polynomial-power
**ladder** `powSystem k`, and a *density* theorem showing that the ladder is
nowhere discrete — between any two consecutive rungs there sits a strictly
intermediate degree.

## The model

A *system* (`PSystem`) is represented by its size/complexity function
`size : ℕ → ℕ` (read: the resource cost of the system on input of length `n`).
The **simulation preorder** `S ≤ T` holds when `T` eventually pointwise
dominates `S`:
`∃ N, ∀ n ≥ N, S.size n ≤ T.size n`.
This is a genuine `Preorder` (`PSystem.instPreorder`), with the induced strict
order `S < T` meaning `S ≤ T` but `¬ T ≤ S`.  Intuitively `S < T` says `T` is a
*strictly faster-growing* (strictly stronger) degree, but domination is required
to hold at **all** large inputs, so a single unbounded family of inputs on which
`S` overtakes `T` already blocks `T ≤ S`.

## The ladder and the witness

The ladder rung `powSystem k` has size function `n ↦ n ^ k`.  The intermediate
witness is built by **parity-gluing** the two neighbouring growth rates:

`interPowSys k` has size `n ↦ n ^ (k + 1)` on even `n` and `n ↦ n ^ k` on odd `n`.

* On the **even** inputs it grows like the upper rung `powSystem (k+1)`, which is
  enough to dominate the lower rung `powSystem k` everywhere, while the even
  inputs being unbounded prevent the lower rung from dominating it back.
* On the **odd** inputs it grows only like the lower rung `powSystem k`, which is
  still dominated by the upper rung, while the odd inputs being unbounded prevent
  the upper rung from dominating it.

Hence `powSystem k < interPowSys k < powSystem (k+1)`.

## Key results

* `PSystem.instPreorder` : the simulation preorder.
* `PSystem.not_le_iff` : failure of domination = frequent overtaking.
* `powSystem_lt_interPowSys` : lower separation, `powSystem k < interPowSys k`.
* `interPowSys_lt_powSystem_succ` : upper separation, `interPowSys k < powSystem (k+1)`.
* `exists_strictly_between_powSystem` : for every `k ≥ 1` there is a degree
  strictly between `powSystem k` and `powSystem (k+1)`.
-/

namespace LadderDensity

/-- A *system* is represented by its size/complexity function `size : ℕ → ℕ`. -/
structure PSystem where
  /-- The size (resource) the system uses on an input of length `n`. -/
  size : ℕ → ℕ

namespace PSystem

/-- The **simulation preorder**: `S` is simulated by `T` (`Sim S T`) when `T`
eventually pointwise dominates `S`. -/
def Sim (S T : PSystem) : Prop :=
  ∃ N, ∀ n, N ≤ n → S.size n ≤ T.size n

theorem sim_refl (S : PSystem) : Sim S S :=
  ⟨0, fun _ _ => le_rfl⟩

theorem sim_trans {S T U : PSystem} (h₁ : Sim S T) (h₂ : Sim T U) : Sim S U := by
  obtain ⟨N₁, h₁⟩ := h₁
  obtain ⟨N₂, h₂⟩ := h₂
  exact ⟨max N₁ N₂, fun n hn =>
    le_trans (h₁ n (le_trans (le_max_left _ _) hn)) (h₂ n (le_trans (le_max_right _ _) hn))⟩

/-- The simulation preorder on systems. `S ≤ T` is `Sim S T`; the induced
strict order is `S < T ↔ S ≤ T ∧ ¬ T ≤ S`. -/
instance instPreorder : Preorder PSystem where
  le := Sim
  le_refl := sim_refl
  le_trans _ _ _ := sim_trans

theorem le_def {S T : PSystem} : S ≤ T ↔ ∃ N, ∀ n, N ≤ n → S.size n ≤ T.size n := Iff.rfl

theorem lt_def {S T : PSystem} : S < T ↔ S ≤ T ∧ ¬ T ≤ S := Iff.rfl

/-- Failure of domination is exactly *frequent overtaking*: `¬ S ≤ T` iff `S`
strictly exceeds `T` on arbitrarily large inputs. -/
theorem not_le_iff (S T : PSystem) :
    ¬ S ≤ T ↔ ∀ N, ∃ n, N ≤ n ∧ T.size n < S.size n := by
  constructor
  · intro h N
    by_contra hc
    push_neg at hc
    exact h ⟨N, fun n hn => hc n hn⟩
  · rintro h ⟨N, hN⟩
    obtain ⟨n, hn, h2⟩ := h N
    exact absurd (hN n hn) (Nat.not_le.2 h2)

end PSystem

/-- The ladder rung `powSystem k`: the power-`k` growth rate `n ↦ n ^ k`. -/
def powSystem (k : ℕ) : PSystem := ⟨fun n => n ^ k⟩

/-- The parity-glued intermediate witness: upper growth `n ^ (k+1)` on even
inputs, lower growth `n ^ k` on odd inputs. -/
def interPowSys (k : ℕ) : PSystem := ⟨fun n => if Even n then n ^ (k + 1) else n ^ k⟩

@[simp] theorem powSystem_size (k n : ℕ) : (powSystem k).size n = n ^ k := rfl

@[simp] theorem interPowSys_size (k n : ℕ) :
    (interPowSys k).size n = if Even n then n ^ (k + 1) else n ^ k := rfl

/-- **Lower separation.** The intermediate witness is strictly above the lower
rung.  (The separation in fact holds for every `k`, no positivity needed: the
even inputs `2N+2 ≥ 2` already block domination.) -/
theorem powSystem_lt_interPowSys (k : ℕ) :
    powSystem k < interPowSys k := by
  rw [PSystem.lt_def]
  refine ⟨⟨1, fun n hn => ?_⟩, ?_⟩
  · simp only [powSystem_size, interPowSys_size]
    split
    · exact Nat.pow_le_pow_right hn (Nat.le_succ k)
    · exact le_rfl
  · rw [PSystem.not_le_iff]
    intro N
    refine ⟨2 * N + 2, by omega, ?_⟩
    have he : Even (2 * N + 2) := ⟨N + 1, by ring⟩
    simp only [powSystem_size, interPowSys_size, if_pos he]
    exact Nat.pow_lt_pow_succ (by omega)

/-- **Upper separation.** The intermediate witness is strictly below the upper
rung.  (Holds for every `k`: the odd inputs `2N+3 ≥ 3` block domination.) -/
theorem interPowSys_lt_powSystem_succ (k : ℕ) :
    interPowSys k < powSystem (k + 1) := by
  rw [PSystem.lt_def]
  refine ⟨⟨1, fun n hn => ?_⟩, ?_⟩
  · simp only [powSystem_size, interPowSys_size]
    split
    · exact le_rfl
    · exact Nat.pow_le_pow_right hn (Nat.le_succ k)
  · rw [PSystem.not_le_iff]
    intro N
    refine ⟨2 * N + 3, by omega, ?_⟩
    have ho : ¬ Even (2 * N + 3) := by simp [Nat.even_add_one, parity_simps]
    simp only [powSystem_size, interPowSys_size, if_neg ho]
    exact Nat.pow_lt_pow_succ (by omega)

/-- **Ladder density.** For every `k ≥ 1` there is a degree strictly between the
consecutive ladder rungs `powSystem k` and `powSystem (k + 1)`; the parity-glued
system `interPowSys k` is an explicit witness. -/
theorem exists_strictly_between_powSystem :
    ∀ k, 1 ≤ k → ∃ S, powSystem k < S ∧ S < powSystem (k + 1) := by
  intro k _
  exact ⟨interPowSys k, powSystem_lt_interPowSys k, interPowSys_lt_powSystem_succ k⟩

end LadderDensity
