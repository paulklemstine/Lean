import Mathlib

/-!
# Topological Quantum Error Correction from Chain Complexes

## Overview

This file develops the **homological algebra underpinning CSS (Calderbank–Shor–Steane)
quantum codes**, of which the *toric code* and general *surface / topological codes* are the
prototypical examples.  A CSS code is built from a length-three chain complex of
finite-dimensional vector spaces over a field `𝕜` (in physics `𝕜 = ZMod 2`):

```
        d_Z              d_X
  C₂  ────────▶   C₁  ────────▶   C₀
```

* `C₁` indexes the **physical qubits**;
* `d_X = ∂₁` is the matrix of **X-type stabilizers**;
* `d_Z = ∂₂` is the matrix of **Z-type stabilizers** (its image spans the Z-checks);
* the boundary condition `∂₁ ∘ ∂₂ = 0` is *exactly* the requirement that the X- and
  Z-stabilizer groups **commute**, so that the code space is well defined.

The number of encoded **logical qubits** is the dimension of the first homology group
`H₁ = ker d_X / im d_Z` — a purely topological invariant.  This file proves the
fundamental dimension count relating logical qubits to the ranks of the stabilizer
matrices, together with the standard CSS rate bound `k ≥ n − r_X − r_Z`.

## Main Results

* `css_commute_iff` — the CSS commutation condition `∂₁ ∘ ∂₂ = 0` is equivalent to the
  inclusion `im ∂₂ ⊆ ker ∂₁` of cycles over boundaries.
* `logicalQubits` — the number of logical qubits, defined as `dim H₁`.
* `logicalQubits_eq_sub` — `k = dim(ker ∂₁) − dim(im ∂₂)`.
* `logicalQubits_eq` — the master formula `k = n − r_X − r_Z` (`n = dim C₁`).
* `logicalQubits_ge` — the CSS rate bound `k ≥ dim C₁ − dim C₀ − dim C₂`.
* `logicalQubits_eq_zero_of_exact` — an *exact* complex carries **no** logical information.
* `logicalQubits_zero_maps` — with no stabilizers every physical qubit is logical (`k = n`).

## Lab Notes

See the inline `-- !-- Lab Notes -- !--` blocks throughout the file.
-/

open Module LinearMap

namespace TopologicalQEC

-- !-- Lab Notes -- !--
-- Hypothesis (H1): The whole of CSS coding theory's *dimension* statements are a
--   restatement of rank–nullity for a two-step chain complex.  We test this by deriving
--   the logical-qubit count `k = n - r_X - r_Z` from `LinearMap.finrank_range_add_finrank_ker`
--   and `Submodule.finrank_quotient_add_finrank` alone, with NO quantum-specific axioms.
-- Outcome: confirmed — every theorem below reduces to finite-dimensional linear algebra.
-- Insight: choosing `𝕜` a general field (not just `ZMod 2`) costs nothing and yields the
--   "qudit" CSS generalisation for free.

section CommutationCondition

variable {𝕜 : Type*} [Field 𝕜]
variable {C2 C1 C0 : Type*}
  [AddCommGroup C2] [Module 𝕜 C2]
  [AddCommGroup C1] [Module 𝕜 C1]
  [AddCommGroup C0] [Module 𝕜 C0]

/-
**CSS commutation ⇔ chain condition.**  The X- and Z-type stabilizers of the code
commute precisely when the boundary maps compose to zero, equivalently when every
Z-boundary is an X-cycle (`im ∂₂ ⊆ ker ∂₁`).
-/
theorem css_commute_iff (dZ : C2 →ₗ[𝕜] C1) (dX : C1 →ₗ[𝕜] C0) :
    dX.comp dZ = 0 ↔ LinearMap.range dZ ≤ LinearMap.ker dX := by
  simp +decide [ LinearMap.ext_iff, SetLike.le_def ]

end CommutationCondition

section Dimension

variable {𝕜 : Type*} [Field 𝕜]
variable {C2 C1 C0 : Type*}
  [AddCommGroup C2] [Module 𝕜 C2]
  [AddCommGroup C1] [Module 𝕜 C1]
  [AddCommGroup C0] [Module 𝕜 C0]
  [FiniteDimensional 𝕜 C2] [FiniteDimensional 𝕜 C1] [FiniteDimensional 𝕜 C0]

/-- The number of **logical qubits** of the CSS code, i.e. the dimension of the first
homology group `H₁ = ker ∂₁ / im ∂₂`. -/
noncomputable def logicalQubits (dZ : C2 →ₗ[𝕜] C1) (dX : C1 →ₗ[𝕜] C0) : ℕ :=
  finrank 𝕜 ((LinearMap.ker dX) ⧸ (LinearMap.range dZ).comap (LinearMap.ker dX).subtype)

/-
!-- Lab Notes -- !--
Experiment: identify `dim H₁` with `dim(ker ∂₁) - dim(im ∂₂)`.  The subtlety is that
`im ∂₂` must be viewed as a submodule of `ker ∂₁`; under the chain condition the
pullback `(im ∂₂).comap (ker ∂₁).subtype` is linearly isomorphic to `im ∂₂` via
`Submodule.comapSubtypeEquivOfLe`, so dimensions agree.

Under the chain condition, the homology dimension is the difference of cycle and
boundary dimensions: `k = dim(ker ∂₁) − dim(im ∂₂)`.
-/
theorem logicalQubits_eq_sub (dZ : C2 →ₗ[𝕜] C1) (dX : C1 →ₗ[𝕜] C0)
    (h : dX.comp dZ = 0) :
    logicalQubits dZ dX = finrank 𝕜 (LinearMap.ker dX) - finrank 𝕜 (LinearMap.range dZ) := by
  convert Nat.eq_sub_of_add_eq ( Submodule.finrank_quotient_add_finrank _ ) using 1;
  · rw [ ← LinearEquiv.finrank_eq ( Submodule.comapSubtypeEquivOfLe <| show LinearMap.range dZ ≤ LinearMap.ker dX from by simpa [ LinearMap.range_le_ker_iff ] using h ) ];
  · infer_instance;
  · infer_instance;
  · infer_instance

/-
**Master dimension formula for CSS codes.**  With `n = dim C₁` physical qubits,
`r_X = rank ∂₁` independent X-stabilizers and `r_Z = rank ∂₂` independent Z-stabilizers,
the code encodes `k = n − r_X − r_Z` logical qubits.
-/
theorem logicalQubits_eq (dZ : C2 →ₗ[𝕜] C1) (dX : C1 →ₗ[𝕜] C0)
    (h : dX.comp dZ = 0) :
    logicalQubits dZ dX =
      finrank 𝕜 C1 - finrank 𝕜 (LinearMap.range dX) - finrank 𝕜 (LinearMap.range dZ) := by
  rw [ logicalQubits_eq_sub dZ dX h ];
  rw [ ← LinearMap.finrank_range_add_finrank_ker dX, add_comm ] ; aesop;

/-
**CSS rate bound.**  Since each stabilizer matrix has rank at most its number of rows,
`k ≥ n − m_X − m_Z` where `m_X = dim C₀` and `m_Z = dim C₂` are the numbers of X- and
Z-checks.
-/
theorem logicalQubits_ge (dZ : C2 →ₗ[𝕜] C1) (dX : C1 →ₗ[𝕜] C0)
    (h : dX.comp dZ = 0) :
    finrank 𝕜 C1 - finrank 𝕜 C0 - finrank 𝕜 C2 ≤ logicalQubits dZ dX := by
  rw [ logicalQubits_eq dZ dX h ];
  gcongr;
  · exact Submodule.finrank_le _;
  · exact LinearMap.finrank_range_le dZ

/-
!-- Lab Notes -- !--
Boundary case: an *exact* complex (`im ∂₂ = ker ∂₁`) has trivial homology, hence zero
logical qubits — the code degenerates to a stabilizer state.  Conversely, with no
stabilizers at all (`∂₂ = ∂₁ = 0`) every physical qubit survives as a logical qubit.

An **exact** complex carries no logical information: `k = 0`.
-/
theorem logicalQubits_eq_zero_of_exact (dZ : C2 →ₗ[𝕜] C1) (dX : C1 →ₗ[𝕜] C0)
    (h : LinearMap.range dZ = LinearMap.ker dX) :
    logicalQubits dZ dX = 0 := by
  convert logicalQubits_eq_sub dZ dX ?_;
  · rw [ h, Nat.sub_self ];
  · exact LinearMap.ext fun x => by simpa using LinearMap.mem_ker.mp ( h ▸ LinearMap.mem_range_self dZ x ) ;

/-
With **no stabilizers** (`∂₂ = ∂₁ = 0`) all `n = dim C₁` physical qubits are logical.
-/
theorem logicalQubits_zero_maps :
    logicalQubits (0 : C2 →ₗ[𝕜] C1) (0 : C1 →ₗ[𝕜] C0) = finrank 𝕜 C1 := by
  convert logicalQubits_eq_sub _ _ _;
  · rw [ LinearMap.range_zero, LinearMap.ker_zero ];
    simp +decide;
  · infer_instance;
  · infer_instance;
  · infer_instance;
  · rfl

end Dimension

end TopologicalQEC