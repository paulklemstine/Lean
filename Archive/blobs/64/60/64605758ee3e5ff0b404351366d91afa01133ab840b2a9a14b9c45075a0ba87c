import Mathlib

/-!
# Density of the `powSystem` ladder in the proof-complexity degree lattice

This file develops a small, self-contained slice of the Cook–Reckhow
*size-system* theory (in the spirit of `Logic/ProofSystemCollapse.lean`) and uses
it to prove a **density** statement for the canonical exponential ladder.

A **size system** is just a size-as-a-function-of-input-length map
`ℕ → ℕ`.  One system is **dominated** by another, written `S ≤ T`, exactly when
the sizes of `S` are bounded by a *fixed polynomial* in the sizes of `T`
(the Cook–Reckhow polynomial-simulation relation):
`∃ c d, ∀ n, S n ≤ c * (T n + 1) ^ d`.  This is a preorder, and its strict part
`<` is the corresponding *degree* strict order.

The canonical ladder is `powSystem k = fun n => 2 ^ (n ^ k)`.  The rungs are
strictly increasing: `powSystem k < powSystem (k+1)`.  We show the ladder is
**dense**: between any two consecutive rungs there is an explicit intermediate
degree.  The witness `interPowSys k` is *parity-glued*: it runs at the faster
rate `2 ^ (n ^ (k+1))` on even inputs and at the slower rate `2 ^ (n ^ k)` on
odd inputs.  The even subsequence forces `powSystem k < interPowSys k`, and the
odd subsequence forces `interPowSys k < powSystem (k+1)`.

## Key results

- `Dom`, the polynomial-domination preorder on size systems (`instance : Preorder`).
- `powSystem`, `interPowSys`: the ladder and the parity-glued witness.
- `powSystem_le_interPowSys`, `not_interPowSys_le_powSystem`,
  `interPowSys_le_powSystem_succ`, `not_powSystem_succ_le_interPowSys`.
- `powSystem_lt_interPowSys`, `interPowSys_lt_powSystem_succ`.
- `ladder_dense`: `∃ S, powSystem k < S ∧ S < powSystem (k+1)` for `k ≥ 1`.
-/

namespace LadderDensity

/-- A **size system**: the size of the cheapest proof/object as a function of the
input length `n`. -/
structure SizeSys where
  /-- The size as a function of input length. -/
  size : ℕ → ℕ

/-- `S` is **polynomially dominated** by `T` (Cook–Reckhow polynomial simulation):
the sizes of `S` are bounded by a fixed polynomial in the sizes of `T`. -/
def Dom (S T : SizeSys) : Prop :=
  ∃ c d : ℕ, ∀ n, S.size n ≤ c * (T.size n + 1) ^ d

/-- Domination is reflexive (identity, with the linear bound). -/
theorem Dom_refl (S : SizeSys) : Dom S S :=
  ⟨1, 1, fun n => by simp⟩

/-- Domination is transitive: monomial bounds compose into a single monomial
bound. -/
theorem Dom_trans {S T U : SizeSys} (h₁ : Dom S T) (h₂ : Dom T U) : Dom S U := by
  obtain ⟨c₁, d₁, hb₁⟩ := h₁
  obtain ⟨c₂, d₂, hb₂⟩ := h₂
  refine ⟨c₁ * (c₂ + 1) ^ d₁, d₁ * d₂, fun n => ?_⟩
  have hstep : T.size n + 1 ≤ (c₂ + 1) * (U.size n + 1) ^ d₂ := by
    have hpos : 1 ≤ (U.size n + 1) ^ d₂ := Nat.one_le_pow _ _ (Nat.succ_pos _)
    nlinarith [hb₂ n, hpos]
  calc
    S.size n ≤ c₁ * (T.size n + 1) ^ d₁ := hb₁ n
    _ ≤ c₁ * ((c₂ + 1) * (U.size n + 1) ^ d₂) ^ d₁ := by
          exact Nat.mul_le_mul_left _ (Nat.pow_le_pow_left hstep _)
    _ = c₁ * (c₂ + 1) ^ d₁ * (U.size n + 1) ^ (d₁ * d₂) := by
          rw [mul_pow, ← pow_mul]; ring

/-- The polynomial-domination preorder on size systems; its strict part `<` is
the degree strict order. -/
instance : Preorder SizeSys where
  le := Dom
  le_refl := Dom_refl
  le_trans := fun _ _ _ h₁ h₂ => Dom_trans h₁ h₂

theorem le_def (S T : SizeSys) :
    S ≤ T ↔ ∃ c d : ℕ, ∀ n, S.size n ≤ c * (T.size n + 1) ^ d := Iff.rfl

/-! ## The ladder and the parity-glued witness -/

/-- The canonical exponential ladder: `powSystem k` has size `2 ^ (n ^ k)`. -/
def powSystem (k : ℕ) : SizeSys := ⟨fun n => 2 ^ (n ^ k)⟩

/-- The parity-glued intermediate witness: it runs at the *faster* rate
`2 ^ (n ^ (k+1))` on even inputs and at the *slower* rate `2 ^ (n ^ k)` on odd
inputs. -/
def interPowSys (k : ℕ) : SizeSys :=
  ⟨fun n => if n % 2 = 0 then 2 ^ (n ^ (k + 1)) else 2 ^ (n ^ k)⟩

/-! ## Growth-gap auxiliary lemmas -/

/-- A polynomial growth gap: if `j < m` then eventually `a + b * n ^ j < n ^ m`. -/
theorem poly_dom (a b j m : ℕ) (h : j < m) :
    ∃ n₀, ∀ n, n₀ ≤ n → a + b * n ^ j < n ^ m := by
  use a + b + 1;
  intro n hn; induction h <;> simp_all +decide [ pow_succ' ] ;
  · nlinarith [ pow_pos ( by linarith : 0 < n ) j ];
  · nlinarith [ pow_pos ( by linarith : 0 < n ) ‹_› ]

/-- The decisive **exponential / polynomial growth gap**: if `j < m`, then for
all `c, d` eventually `c * (2 ^ (n ^ j) + 1) ^ d < 2 ^ (n ^ m)`. -/
theorem eventually_gap (j m c d : ℕ) (h : j < m) :
    ∃ n₀, ∀ n, n₀ ≤ n → c * (2 ^ (n ^ j) + 1) ^ d < 2 ^ (n ^ m) := by
  obtain ⟨ n₀, hn₀ ⟩ := poly_dom ( c + d ) d j m h;
  refine' ⟨ n₀, fun n hn => _ ⟩;
  refine' lt_of_le_of_lt _ ( pow_lt_pow_right₀ ( by decide ) ( hn₀ n hn ) );
  refine' le_trans ( Nat.mul_le_mul ( show c ≤ 2 ^ c by exact le_of_lt ( Nat.recOn c ( by norm_num ) fun n ihn => by rw [ pow_succ' ] ; nlinarith [ Nat.one_le_pow n 2 zero_lt_two ] ) ) ( show ( 2 ^ n ^ j + 1 ) ^ d ≤ 2 ^ ( d * n ^ j + d ) by
                                                                                                                                                                                            rw [ pow_add, pow_mul' ];
                                                                                                                                                                                            rw [ ← mul_pow ] ; gcongr ; linarith [ Nat.one_le_pow ( n ^ j ) 2 zero_lt_two ] ) ) _ ; ring_nf ; norm_num [ pow_mul' ]

/-! ## The four domination facts -/

/-- Lower rung is dominated by the witness (needs `1 ≤ k`: at `k = 0` the witness
is strictly cheaper at the input `n = 0`). -/
theorem powSystem_le_interPowSys (k : ℕ) (hk : 1 ≤ k) :
    powSystem k ≤ interPowSys k := by
  refine' ⟨ 1, 1, fun n => _ ⟩ ; simp +decide [ powSystem, interPowSys ];
  split_ifs <;> simp +decide [ *, pow_add, pow_mul ];
  rcases n with ( _ | _ | n ) <;> simp_all +decide [ Nat.pow_succ ];
  · cases k <;> norm_num at *;
  · exact Nat.le_succ_of_le ( Nat.le_trans ( Nat.le_mul_of_pos_left _ <| by positivity ) <| Nat.le_mul_of_pos_right _ <| by positivity )

/-- The witness is *not* dominated by the lower rung: on even inputs it runs at
the faster rate, which outgrows every polynomial in the lower rate. -/
theorem not_interPowSys_le_powSystem (k : ℕ) :
    ¬ interPowSys k ≤ powSystem k := by
  obtain ⟨ n₀, hn₀ ⟩ := eventually_gap k ( k + 1 ) 1 k ( by linarith );
  contrapose! hn₀;
  obtain ⟨ c, d, hcd ⟩ := hn₀;
  obtain ⟨ n₁, hn₁ ⟩ := eventually_gap k ( k + 1 ) c d ( by linarith );
  exact absurd ( hn₁ ( 2 * ( n₁ + n₀ + 1 ) ) ( by linarith ) ) ( by have := hcd ( 2 * ( n₁ + n₀ + 1 ) ) ; unfold interPowSys at this; unfold powSystem at this; norm_num [ Nat.add_mod, Nat.mul_mod, Nat.pow_mod ] at * ; linarith )

/-- The witness is dominated by the upper rung. -/
theorem interPowSys_le_powSystem_succ (k : ℕ) :
    interPowSys k ≤ powSystem (k + 1) := by
  refine' ⟨ 1, 1, fun n => _ ⟩ ; simp_all +decide [ powSystem, interPowSys ];
  split_ifs <;> [ exact Nat.le_succ _; exact Nat.le_succ_of_le ( pow_le_pow_right₀ ( by decide ) ( Nat.pow_le_pow_right ( Nat.pos_of_ne_zero ( by aesop ) ) ( by linarith ) ) ) ]

/-- The upper rung is *not* dominated by the witness: on odd inputs the witness
falls back to the slower rate, which the upper rate outgrows. -/
theorem not_powSystem_succ_le_interPowSys (k : ℕ) :
    ¬ powSystem (k + 1) ≤ interPowSys k := by
  intro h
  obtain ⟨c, d, h⟩ := h;
  -- Choose n = 2*(n₀+1)+1. We have n % 2 = 1 (by omega) and n₀ ≤ n (by omega);
  -- after `simp only [interPowSys]`, `interPowSys k .size n` becomes `(if ...` where the test is False.
  -- `powSystem (k+1) .size n` is `2^(n^(k+1))`.
  obtain ⟨n₀, hn₀⟩ := eventually_gap k (k+1) c d (by omega : k < k+1)
  have h_odd : ∀ n', n₀ ≤ n' → (powSystem (k + 1)).size (2 * n' + 1) ≤ c * ((interPowSys k).size (2 * n' + 1) + 1) ^ d := by
    exact fun n' hn' => h _;
  simp_all +decide [ powSystem, interPowSys ];
  exact not_lt_of_ge ( h_odd ( n₀ + 1 ) ( by linarith ) ) ( hn₀ _ ( by linarith ) )

/-! ## Strict inequalities and density -/

/-- The lower rung is strictly below the witness. -/
theorem powSystem_lt_interPowSys (k : ℕ) (hk : 1 ≤ k) :
    powSystem k < interPowSys k :=
  lt_iff_le_not_ge.mpr ⟨powSystem_le_interPowSys k hk, not_interPowSys_le_powSystem k⟩

/-- The witness is strictly below the upper rung (this direction in fact needs no
hypothesis on `k`). -/
theorem interPowSys_lt_powSystem_succ (k : ℕ) :
    interPowSys k < powSystem (k + 1) :=
  lt_iff_le_not_ge.mpr
    ⟨interPowSys_le_powSystem_succ k, not_powSystem_succ_le_interPowSys k⟩

/-- **Density of the ladder.** For every `k ≥ 1` there is an explicit degree
strictly between the consecutive rungs `powSystem k` and `powSystem (k+1)`. -/
theorem ladder_dense (k : ℕ) (hk : 1 ≤ k) :
    ∃ S : SizeSys, powSystem k < S ∧ S < powSystem (k + 1) :=
  ⟨interPowSys k, powSystem_lt_interPowSys k hk, interPowSys_lt_powSystem_succ k⟩

end LadderDensity