/-
# The basic `2 × 2` Markov move for two-way contingency tables

This file records the elementary algebraic soundness of the basic Markov-basis
move for two-way contingency tables.

A *two-way table* is an integer matrix `Table m n = Matrix (Fin m) (Fin n) ℤ`.
Its *margins* are the row sums and column sums.  The basic move associated with
two distinct rows `i ≠ i'` and two distinct columns `j ≠ j'` adds `+1` to the
two "off-diagonal" cells `(i, j')`, `(i', j)` and `-1` to the two "diagonal"
cells `(i, j)`, `(i', j')`.  This `2 × 2` swap is the fundamental generator of
the Markov basis for the independence model of two-way tables: applying it to a
table leaves all row and column sums (hence the total) unchanged, while a step is
*legal* when both the source and target tables are entrywise nonnegative.

## Main results

* `rowSum_add`, `colSum_add`, `totalSum_add` — additivity of the margins.
* `rowSum_basicMove`, `colSum_basicMove` — every row/column sum of a basic move
  is `0`.
* `basicMove_preserves_margins` — adding a basic move preserves all margins.
* `basicMove_totalSum_zero` — the total sum of a basic move is `0`.
* `legalBasicStep_preserves_margins` — a legal basic step preserves all margins.
-/

import Mathlib

open BigOperators

namespace MarkovBases.TwoWay

/-- A two-way contingency table: an integer matrix indexed by `Fin m × Fin n`. -/
abbrev Table (m n : ℕ) := Matrix (Fin m) (Fin n) ℤ

variable {m n : ℕ}

/-- The sum of the entries in row `i`. -/
def rowSum (T : Table m n) (i : Fin m) : ℤ := ∑ j, T i j

/-- The sum of the entries in column `j`. -/
def colSum (T : Table m n) (j : Fin n) : ℤ := ∑ i, T i j

/-- The sum of all entries of the table. -/
def totalSum (T : Table m n) : ℤ := ∑ i, ∑ j, T i j

/-- Two tables have the same margins when all their row sums and column sums
agree. -/
def sameMargins (T T' : Table m n) : Prop :=
  (∀ i, rowSum T i = rowSum T' i) ∧ (∀ j, colSum T j = colSum T' j)

/-- The basic `2 × 2` Markov move for rows `i, i'` and columns `j, j'`: it places
`+1` at `(i, j')` and `(i', j)`, `-1` at `(i, j)` and `(i', j')`, and `0`
everywhere else. -/
def basicMove (i i' : Fin m) (j j' : Fin n) : Table m n :=
  fun a b =>
    if a = i ∧ b = j' then 1
    else if a = i' ∧ b = j then 1
    else if a = i ∧ b = j then -1
    else if a = i' ∧ b = j' then -1
    else 0

/-- A sum over `Fin k` of a function supported on the two distinct indices
`c` and `d` (with values `x` at `c` and `y` at `d`) evaluates to `x + y`. -/
private theorem two_support {k : ℕ} (c d : Fin k) (x y : ℤ) (hcd : c ≠ d) :
    ∑ b : Fin k, (if b = c then x else if b = d then y else 0) = x + y := by
  have hsplit : (fun b : Fin k => (if b = c then x else if b = d then y else 0))
      = (fun b => (if b = c then x else 0) + (if b = d then y else 0)) := by
    funext b
    by_cases hbc : b = c
    · subst hbc; simp [hcd]
    · by_cases hbd : b = d <;> simp [hbc, hbd, hcd.symm]
  rw [hsplit, Finset.sum_add_distrib]; simp

theorem rowSum_add (T U : Table m n) (i : Fin m) :
    rowSum (T + U) i = rowSum T i + rowSum U i := by
  unfold rowSum; simp [Finset.sum_add_distrib]

theorem colSum_add (T U : Table m n) (j : Fin n) :
    colSum (T + U) j = colSum T j + colSum U j := by
  unfold colSum; simp [Finset.sum_add_distrib]

theorem totalSum_add (T U : Table m n) :
    totalSum (T + U) = totalSum T + totalSum U := by
  unfold totalSum; simp [Finset.sum_add_distrib]

/-- Every row sum of a basic move is `0`. -/
theorem rowSum_basicMove (i i' : Fin m) (j j' : Fin n)
    (hi : i ≠ i') (hj : j ≠ j') (a : Fin m) :
    rowSum (basicMove i i' j j') a = 0 := by
  unfold rowSum basicMove
  by_cases hai : a = i
  · have heq : ∀ b : Fin n,
        (if a = i ∧ b = j' then (1:ℤ) else if a = i' ∧ b = j then 1
          else if a = i ∧ b = j then -1 else if a = i' ∧ b = j' then -1 else 0)
        = (if b = j' then (1:ℤ) else if b = j then -1 else 0) := by
      intro b; simp [hai, hi]
    rw [Finset.sum_congr rfl (fun b _ => heq b), two_support j' j 1 (-1) hj.symm]; ring
  · by_cases hai' : a = i'
    · have heq : ∀ b : Fin n,
          (if a = i ∧ b = j' then (1:ℤ) else if a = i' ∧ b = j then 1
            else if a = i ∧ b = j then -1 else if a = i' ∧ b = j' then -1 else 0)
          = (if b = j then (1:ℤ) else if b = j' then -1 else 0) := by
        intro b; simp [hai', hi.symm]
      rw [Finset.sum_congr rfl (fun b _ => heq b), two_support j j' 1 (-1) hj]; ring
    · have heq : ∀ b : Fin n,
          (if a = i ∧ b = j' then (1:ℤ) else if a = i' ∧ b = j then 1
            else if a = i ∧ b = j then -1 else if a = i' ∧ b = j' then -1 else 0)
          = 0 := by
        intro b; simp [hai, hai']
      rw [Finset.sum_congr rfl (fun b _ => heq b)]; simp

/-- Every column sum of a basic move is `0`. -/
theorem colSum_basicMove (i i' : Fin m) (j j' : Fin n)
    (hi : i ≠ i') (hj : j ≠ j') (b : Fin n) :
    colSum (basicMove i i' j j') b = 0 := by
  unfold colSum basicMove
  by_cases hbj' : b = j'
  · have heq : ∀ a : Fin m,
        (if a = i ∧ b = j' then (1:ℤ) else if a = i' ∧ b = j then 1
          else if a = i ∧ b = j then -1 else if a = i' ∧ b = j' then -1 else 0)
        = (if a = i then (1:ℤ) else if a = i' then -1 else 0) := by
      intro a; simp [hbj', hj.symm]
    rw [Finset.sum_congr rfl (fun a _ => heq a), two_support i i' 1 (-1) hi]; ring
  · by_cases hbj : b = j
    · have heq : ∀ a : Fin m,
          (if a = i ∧ b = j' then (1:ℤ) else if a = i' ∧ b = j then 1
            else if a = i ∧ b = j then -1 else if a = i' ∧ b = j' then -1 else 0)
          = (if a = i' then (1:ℤ) else if a = i then -1 else 0) := by
        intro a; simp [hbj, hj]
      rw [Finset.sum_congr rfl (fun a _ => heq a), two_support i' i 1 (-1) hi.symm]; ring
    · have heq : ∀ a : Fin m,
          (if a = i ∧ b = j' then (1:ℤ) else if a = i' ∧ b = j then 1
            else if a = i ∧ b = j then -1 else if a = i' ∧ b = j' then -1 else 0)
          = 0 := by
        intro a; simp [hbj, hbj']
      rw [Finset.sum_congr rfl (fun a _ => heq a)]; simp

/-- Adding a basic move to a table preserves all of its margins. -/
theorem basicMove_preserves_margins (T : Table m n) (i i' : Fin m) (j j' : Fin n)
    (hi : i ≠ i') (hj : j ≠ j') :
    sameMargins T (T + basicMove i i' j j') := by
  refine ⟨fun a => ?_, fun b => ?_⟩
  · rw [rowSum_add, rowSum_basicMove i i' j j' hi hj a, add_zero]
  · rw [colSum_add, colSum_basicMove i i' j j' hi hj b, add_zero]

/-- The total sum of a basic move is `0`. -/
theorem basicMove_totalSum_zero (i i' : Fin m) (j j' : Fin n)
    (hi : i ≠ i') (hj : j ≠ j') :
    totalSum (basicMove i i' j j') = 0 := by
  have hsum : totalSum (basicMove i i' j j') = ∑ a, rowSum (basicMove i i' j j') a := rfl
  rw [hsum]
  simp [rowSum_basicMove i i' j j' hi hj]

/-- A legal basic step between nonnegative tables: there exist distinct rows
`i ≠ i'` and distinct columns `j ≠ j'` whose basic move sends `T` to `T'`, with
both tables entrywise nonnegative. -/
def legalBasicStep (T T' : Table m n) : Prop :=
  ∃ (i i' : Fin m) (j j' : Fin n),
    i ≠ i' ∧ j ≠ j' ∧ T' = T + basicMove i i' j j' ∧
    (∀ a b, 0 ≤ T a b) ∧ (∀ a b, 0 ≤ T' a b)

/-- A legal basic step preserves all margins. -/
theorem legalBasicStep_preserves_margins (T T' : Table m n)
    (h : legalBasicStep T T') : sameMargins T T' := by
  obtain ⟨i, i', j, j', hi, hj, hT', _, _⟩ := h
  subst hT'
  exact basicMove_preserves_margins T i i' j j' hi hj

end MarkovBases.TwoWay
