      "code": "from __future__ import annotations\n\ndef hensel_steps_for_digits(digits: int) -> int:\n    \"\"\"Minimal certified Hensel step count for `digits` precision: floor(log2 d)+1.\"\"\"\n    if digits < 1:\n        return 0\n    return (digits.bit_length() - 1) + 1\n"
