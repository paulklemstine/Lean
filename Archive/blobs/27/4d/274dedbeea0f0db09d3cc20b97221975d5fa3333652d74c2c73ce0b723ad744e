      "name": "Exponential/Logarithm Comparison Functor: Shadow Round-Trip and Law Intertwining",
      "description": "Verifies the core of the bridge numerically. Computes the tropical shadow T(f) = base**depth and its discrete-logarithm inverse Nat.log_base, confirming the round-trip is exact on powers, and checks the intertwining identity base**(max(a,b)+1) = base*max(base**a, base**b) over a grid of inputs and several bases. This is the empirical witness that additive max-plus depth and multiplicative tropical rate are the same law in different coordinates.",
      "code": "from __future__ import annotations\n\ndef tropical_shadow(depth: int, base: int = 2) -> int:\n    \"\"\"T(f) = base ** depth: the multiplicative shadow of additive depth.\"\"\"\n    return base ** depth\n\ndef depth_from_shadow(shadow: int, base: int = 2) -> int:\n    \"\"\"Discrete-log inverse Nat.log_base: recovers depth, exact on powers.\"\"\"\n    if shadow < 1:\n        return 0\n    d = 0\n    while base ** (d + 1) <= shadow:\n        d += 1\n    return d\n\ndef intertwining(a: int, b: int, base: int = 2) -> bool:\n    \"\"\"base**(max(a,b)+1) == base * max(base**a, base**b).\"\"\"\n    return base ** (max(a, b) + 1) == base * max(base ** a, base ** b)\n\nif __name__ == \"__main__\":\n    for base in (2, 3, 5):\n        assert all(intertwining(a, b, base) for a in range(6) for b in range(6))\n        assert all(depth_from_shadow(tropical_shadow(d, base), base) == d for d in range(8))\n        print(f\"base={base}: intertwining identity and exp/log round-trip verified.\")\n"
    },
    {
      "name": "Iteration Dichotomy: Multiplicative Lipschitz Blow-up vs. Invariant Ultrametric Exponent",
      "description": "Contrasts the two iteration laws. On the tropical/multiplicative side a C-Lipschitz map iterated n times has rate C**n, whose logarithm (the depth) grows linearly. On the ultrametric side the signed Lipschitz exponent is invariant under composition (min of exponents) and hence under arbitrarily many iterations: no blow-up. Demonstrates that 'non-expansive stays non-expansive' is the logarithmic image of the constant C=1 fixed point.",
      "code": "from __future__ import annotations\nfrom dataclasses import dataclass\n\ndef iterated_tropical_rate(C: int, n: int) -> int:\n    \"\"\"C-Lipschitz iterated n times has rate C**n (multiplicative blow-up).\"\"\"\n    return C ** n\n\n@dataclass\nclass UltraLipschitzData:\n    \"\"\"Single signed exponent; composition takes the min, iteration is invariant.\"\"\"\n    exponent: int\n    @property\n    def is_non_expansive(self) -> bool:\n        return self.exponent >= 0\n    def compose(self, other: \"UltraLipschitzData\") -> \"UltraLipschitzData\":\n        return UltraLipschitzData(min(self.exponent, other.exponent))\n    def iterate(self, n: int) -> \"UltraLipschitzData\":\n        r = self\n        for _ in range(n):\n            r = r.compose(self)\n        return r\n\nif __name__ == \"__main__\":\n    # Multiplicative side: C**n grows; its logarithm (the depth) grows linearly.\n    for n in range(6):\n        rate = iterated_tropical_rate(3, n)\n        print(f\"n={n}: rate 3**n = {rate:>4}  log_3(rate) = depth = {n}\")\n    # Ultrametric exponent is invariant under iteration: no blow-up.\n    for e in (-1, 0, 2):\n        assert UltraLipschitzData(e).iterate(1000).exponent == e\n    print(\"Ultrametric exponent invariant under 1000 iterations: no blow-up.\")\n"
    },
