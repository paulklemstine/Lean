  "algorithms": [
    {
      "name": "Max-Plus Valuation-Depth Evaluation over Expression Trees",
      "description": "Computes the valuation depth of a composite function presented as an expression tree over the operations {+, *, ∘}. Each leaf carries its own depth; each internal node applies the ultrametric law depth = max(children) + 1. Because combination costs a maximum rather than a sum, the result is the longest weighted root-to-leaf path plus the node count along it. Runs in O(size) time and O(height) stack.",
      "pseudocode": "function EVAL-DEPTH(expr):\n    if expr is (\"leaf\", d):\n        return d\n    (op, L, R) <- expr\n    dL <- EVAL-DEPTH(L)\n    dR <- EVAL-DEPTH(R)\n    return max(dL, dR) + 1",
      "code": "from __future__ import annotations\nfrom typing import Tuple\n\nExpr = Tuple  # (\"leaf\", d) | (op, left, right) with op in {\"add\",\"mul\",\"comp\"}\n\ndef eval_depth(expr: Expr) -> int:\n    \"\"\"Bottom-up max-plus fold computing valuation depth of an expression tree.\"\"\"\n    if expr[0] == \"leaf\":\n        return int(expr[1])\n    left = eval_depth(expr[1])\n    right = eval_depth(expr[2])\n    return max(left, right) + 1\n"
    },
    {
      "name": "Exponential Comparison Functor and Discrete-Logarithm Inverse",
      "description": "Implements the comparison functor T(d) = base**d carrying additive max-plus depth to a multiplicative tropical Lipschitz rate, together with its exact inverse Nat.log_base on powers. The pair is a monotone Galois connection and an isometry on the depth lattice, so VAL_k maps to the rate class {f : T(f) <= base**k}. Forward map is O(log d) multiplications; the inverse is O(log shadow).",
      "pseudocode": "function SHADOW(d, base):           # depth -> rate\n    return base ** d\n\nfunction DEPTH-FROM-SHADOW(s, base): # rate -> depth\n    if s < 1: return 0\n    d <- 0\n    while base**(d+1) <= s:\n        d <- d + 1\n    return d",
