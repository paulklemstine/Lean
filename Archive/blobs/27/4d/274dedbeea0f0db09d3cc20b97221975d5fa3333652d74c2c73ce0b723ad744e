      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\"/>\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/>\n<title>Depth = log(Tropical Lipschitz Constant) — Interactive Explorer</title>\n<style>\n  body { font-family: -apple-system, Segoe UI, Roboto, sans-serif; margin: 0;\n         background: #0e1117; color: #e6edf3; }\n  header { padding: 24px; background: linear-gradient(135deg,#1f6feb,#8957e5); }\n  h1 { margin: 0; font-size: 1.5rem; }\n  .sub { opacity: .9; margin-top: 6px; font-size: .95rem; }\n  main { padding: 24px; max-width: 900px; margin: 0 auto; }\n  .card { background: #161b22; border: 1px solid #30363d; border-radius: 12px;\n          padding: 18px 20px; margin-bottom: 18px; }\n  label { display:block; margin: 10px 0 4px; font-size:.9rem; opacity:.85; }\n  input[type=range] { width: 100%; }\n  .val { font-variant-numeric: tabular-nums; color:#7ee787; font-weight:600; }\n  .eq { font-family: ui-monospace, monospace; background:#0d1117; padding:10px;\n        border-radius:8px; border:1px solid #30363d; margin-top:8px; }\n  .ok { color:#7ee787; } .bad { color:#ff7b72; }\n  canvas { width:100%; height:240px; background:#0d1117; border-radius:8px;\n           border:1px solid #30363d; }\n</style>\n</head>\n<body>\n<header>\n  <h1>Depth = log( Tropical Lipschitz Constant )</h1>\n  <div class=\"sub\">The exponential map turns the max-plus depth law into the multiplicative tropical law — exactly.</div>\n</header>\n<main>\n  <div class=\"card\">\n    <label>base (b &gt; 1): <span class=\"val\" id=\"baseV\">2</span></label>\n    <input type=\"range\" id=\"base\" min=\"2\" max=\"6\" value=\"2\"/>\n    <label>depth of f (a): <span class=\"val\" id=\"aV\">2</span></label>\n    <input type=\"range\" id=\"a\" min=\"0\" max=\"10\" value=\"2\"/>\n    <label>depth of g (b): <span class=\"val\" id=\"bV\">3</span></label>\n    <input type=\"range\" id=\"b\" min=\"0\" max=\"10\" value=\"3\"/>\n    <div class=\"eq\" id=\"law\"></div>\n    <div class=\"eq\" id=\"round\"></div>\n  </div>\n  <div class=\"card\">\n    <h3 style=\"margin-top:0\">Tropical shadow T(d) = base<sup>d</sup> (log axis ⇒ straight line)</h3>\n    <canvas id=\"plot\" width=\"840\" height=\"240\"></canvas>\n  </div>\n</main>\n<script>\nconst $ = id => document.getElementById(id);\nfunction refresh(){\n  const base = +$('base').value, a = +$('a').value, b = +$('b').value;\n  $('baseV').textContent = base; $('aV').textContent = a; $('bV').textContent = b;\n  const lhs = Math.pow(base, Math.max(a,b)+1);\n  const rhs = base * Math.max(Math.pow(base,a), Math.pow(base,b));\n  const ok = lhs === rhs;\n  $('law').innerHTML = `Intertwining law:  base^(max(a,b)+1) = ${lhs}` +\n     `  vs  base·max(base^a,base^b) = ${rhs}  ` +\n     `<span class=\"${ok?'ok':'bad'}\">${ok?'✓ equal':'✗'}</span>`;\n  const d = Math.max(a,b)+1, shadow = Math.pow(base,d);\n  const back = Math.floor(Math.log(shadow)/Math.log(base)+1e-9);\n  $('round').innerHTML = `Composition depth = max(a,b)+1 = ${d};  shadow = base^${d} = ${shadow};  ` +\n     `log_base(shadow) = ${back}  <span class=\"${back===d?'ok':'bad'}\">${back===d?'✓ recovered':'✗'}</span>`;\n  draw(base);\n}\nfunction draw(base){\n  const c = $('plot'), ctx = c.getContext('2d');\n  const W=c.width, H=c.height; ctx.clearRect(0,0,W,H);\n  const dmax=10; const ys=[]; for(let d=0;d<=dmax;d++) ys.push(Math.log(Math.pow(base,d))/Math.log(base));\n  // log-scale value of base^d is just d -> straight line\n  ctx.strokeStyle='#30363d'; ctx.beginPath();\n  for(let g=0;g<=dmax;g++){const x=40+g*(W-60)/dmax; ctx.moveTo(x,10); ctx.lineTo(x,H-20);} ctx.stroke();\n  ctx.strokeStyle='#7ee787'; ctx.lineWidth=2; ctx.beginPath();\n  ys.forEach((v,d)=>{const x=40+d*(W-60)/dmax; const y=H-20-(v/dmax)*(H-30);\n    d===0?ctx.moveTo(x,y):ctx.lineTo(x,y);}); ctx.stroke();\n  ctx.fillStyle='#8b949e'; ctx.font='12px sans-serif';\n  ctx.fillText('depth d', W-70, H-4); ctx.fillText('log_base T(d) = d', 44, 16);\n}\n['base','a','b'].forEach(id=>$(id).addEventListener('input',refresh));\nrefresh();\n</script>\n</body>\n</html>\n"
