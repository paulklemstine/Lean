import Mathlib

open scoped InnerProductSpace BigOperators Topology

namespace SpectralGapRigidity

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
variable {F : Type*} [NormedAddCommGroup F] [InnerProductSpace ℝ F]

/-! ## Basic operator predicates -/

/-- `L` is symmetric for the real inner product. -/
def SymmOp (L : E →ₗ[ℝ] E) : Prop := ∀ x y, ⟪L x, y⟫_ℝ = ⟪x, L y⟫_ℝ

/-- `L` is positive semidefinite: the energy `⟪x, L x⟫` is always nonnegative. -/
def PSDOp (L : E →ₗ[ℝ] E) : Prop := ∀ x, 0 ≤ ⟪x, L x⟫_ℝ

/-- `L` has a (global) Rayleigh spectral gap `μ`: `μ⟪x,x⟫ ≤ ⟪x, L x⟫` for all `x`.
For `μ > 0` this is the *expanding* regime (no nontrivial harmonics). -/
def RayleighGap (L : E →ₗ[ℝ] E) (μ : ℝ) : Prop := ∀ x, μ * ⟪x, x⟫_ℝ ≤ ⟪x, L x⟫_ℝ

/-- The abstract Hodge Laplacian `Δ = up + down`. -/
def hodgeLaplacian (up down : E →ₗ[ℝ] E) : E →ₗ[ℝ] E := up + down

@[simp] theorem hodgeLaplacian_apply (up down : E →ₗ[ℝ] E) (x : E) :
    hodgeLaplacian up down x = up x + down x := rfl

/-! ## Stalk-level rigidity of the energy form -/

-- !-- The energy `t ↦ ⟪x+t•Lx, L(x+t•Lx)⟫ = 2t‖Lx‖²_L + t²q` is a nonneg parabola;
-- its vertex value `-‖Lx‖⁴_L/q ≥ 0` forces `⟪Lx,Lx⟫ = 0`, i.e. `Lx = 0`. -- !--
/-- **Stalk rigidity.** For a symmetric PSD operator, the energy form has the same
kernel as the operator: `⟪x, L x⟫ = 0` implies `L x = 0`.  This is the pointwise
fact that drives the Hodge decomposition. -/
theorem psd_operator_inner_self_eq_zero (L : E →ₗ[ℝ] E) (hsymm : SymmOp L)
    (hpsd : PSDOp L) {x : E} (hx : ⟪x, L x⟫_ℝ = 0) : L x = 0 := by
  set p := ⟪L x, L x⟫_ℝ with hp
  set q := ⟪L x, L (L x)⟫_ℝ with hq
  have hquad : ∀ t : ℝ, 0 ≤ 2 * t * p + t ^ 2 * q := by
    intro t
    have hpos := hpsd (x + t • L x)
    have e : ⟪x + t • L x, L (x + t • L x)⟫_ℝ = 2 * t * p + t ^ 2 * q := by
      simp only [map_add, map_smul, inner_add_left, inner_add_right, inner_smul_left,
        inner_smul_right, conj_trivial]
      have s1 : ⟪x, L (L x)⟫_ℝ = p := by rw [← hsymm x (L x)]
      rw [hx, s1]; ring
    rwa [e] at hpos
  have hq0 : 0 ≤ q := hpsd (L x)
  have hp0 : 0 ≤ p := real_inner_self_nonneg
  have hpe : p = 0 := by
    by_cases hqz : q = 0
    · have := hquad (-1); nlinarith
    · have hqpos : 0 < q := lt_of_le_of_ne hq0 (Ne.symm hqz)
      have h2 := hquad (-p / q)
      have hpq : 2 * (-p / q) * p + (-p / q) ^ 2 * q = -p ^ 2 / q := by field_simp; ring
      rw [hpq] at h2
      have h3 : 0 ≤ -p ^ 2 := by
        have := mul_nonneg h2 hqpos.le
        rwa [div_mul_cancel₀ _ hqpos.ne'] at this
      have key : p ^ 2 = 0 := le_antisymm (by linarith) (sq_nonneg p)
      exact pow_eq_zero_iff two_ne_zero |>.mp key
  exact inner_self_eq_zero.mp hpe

/-! ## The Hodge Laplacian is symmetric and PSD -/

-- !-- Sum of symmetric operators is symmetric: expand `inner_add` on both sides. -- !--
theorem hodgeLaplacian_symm (up down : E →ₗ[ℝ] E)
    (hup : SymmOp up) (hdown : SymmOp down) : SymmOp (hodgeLaplacian up down) := by
  intro x y
  simp only [hodgeLaplacian_apply, inner_add_left, inner_add_right]
  rw [hup x y, hdown x y]

-- !-- Sum of PSD energies is nonneg: `⟪x,Δx⟫ = ⟪x,up x⟫ + ⟪x,down x⟫ ≥ 0`. -- !--
theorem hodgeLaplacian_psd (up down : E →ₗ[ℝ] E)
    (hup : PSDOp up) (hdown : PSDOp down) : PSDOp (hodgeLaplacian up down) := by
  intro x
  simp only [hodgeLaplacian_apply, inner_add_right]
  exact add_nonneg (hup x) (hdown x)

/-! ## Local-to-global: the Hodge harmonicity criterion -/

-- !-- `⟪x,Δx⟫ = ⟪x,up x⟫ + ⟪x,down x⟫`; if `Δx=0` both nonneg summands vanish, so by
-- stalk rigidity `up x = 0` and `down x = 0`.  Converse is `map_zero`. -- !--
/-- **Local-to-global glueing.** A cochain is *globally* harmonic (`Δ x = 0`) iff it
is *locally* closed and coclosed (`up x = 0 ∧ down x = 0`).  This is the algebraic
core of the Hodge decomposition `ker Δ ≅ H*`. -/
theorem harmonic_iff (up down : E →ₗ[ℝ] E)
    (hup_s : SymmOp up) (hup_p : PSDOp up)
    (hdown_s : SymmOp down) (hdown_p : PSDOp down) (x : E) :
    hodgeLaplacian up down x = 0 ↔ up x = 0 ∧ down x = 0 := by
  constructor
  · intro h
    have hzero : ⟪x, hodgeLaplacian up down x⟫_ℝ = 0 := by rw [h, inner_zero_right]
    have hsum : ⟪x, up x⟫_ℝ + ⟪x, down x⟫_ℝ = 0 := by
      simpa only [hodgeLaplacian_apply, inner_add_right] using hzero
    have hu : ⟪x, up x⟫_ℝ = 0 := le_antisymm (by nlinarith [hdown_p x]) (hup_p x)
    have hd : ⟪x, down x⟫_ℝ = 0 := le_antisymm (by nlinarith [hup_p x]) (hdown_p x)
    exact ⟨psd_operator_inner_self_eq_zero up hup_s hup_p hu,
           psd_operator_inner_self_eq_zero down hdown_s hdown_p hd⟩
  · rintro ⟨hu, hd⟩
    simp [hodgeLaplacian_apply, hu, hd]

/-! ## Functoriality of harmonics and rigidity of the spectral gap -/

-- !-- `L_F (P x) = P (L_E x) = P 0 = 0`: harmonics push forward along any
-- intertwiner — cohomology is functorial under coarse-graining. -- !--
/-- **Functoriality of cohomology.** An intertwiner `P` of Laplacians
(`P ∘ L_E = L_F ∘ P`) maps harmonics to harmonics. -/
theorem harmonic_pushforward (LE : E →ₗ[ℝ] E) (LF : F →ₗ[ℝ] F) (P : E →ₗ[ℝ] F)
    (hinter : ∀ x, P (LE x) = LF (P x)) {x : E} (hx : LE x = 0) : LF (P x) = 0 := by
  rw [← hinter, hx, map_zero]

-- !-- `⟪a,L_F a⟫ = ⟪ιa, L_E(ιa)⟫ ≥ μ⟪ιa,ιa⟫ = μ⟪a,a⟫` using the isometry to move
-- the Rayleigh quotient across the intertwiner. -- !--
/-- **Spectral-gap rigidity.** An *isometric* intertwiner `ι : F → E`
(`⟪ι a, ι b⟫ = ⟪a, b⟫` and `L_E ∘ ι = ι ∘ L_F`) transfers the spectral gap:
if the ambient Laplacian `L_E` has gap `μ`, so does the coarse model `L_F`. -/
theorem gap_transfer_isometry (LE : E →ₗ[ℝ] E) (LF : F →ₗ[ℝ] F) (ι : F →ₗ[ℝ] E)
    (μ : ℝ) (hiso : ∀ a b, ⟪ι a, ι b⟫_ℝ = ⟪a, b⟫_ℝ)
    (hinter : ∀ a, LE (ι a) = ι (LF a)) (hgap : RayleighGap LE μ) :
    RayleighGap LF μ := by
  intro a
  have h1 : ⟪a, LF a⟫_ℝ = ⟪ι a, LE (ι a)⟫_ℝ := by rw [hinter, hiso]
  have h2 : ⟪a, a⟫_ℝ = ⟪ι a, ι a⟫_ℝ := (hiso a a).symm
  rw [h1, h2]; exact hgap (ι a)

/-! ## Vanishing: a spectral gap kills all harmonics -/

-- !-- `Lx=0 ⇒ ⟪x,Lx⟫=0 ⇒ μ⟪x,x⟫≤0`; with `μ>0` and `⟪x,x⟫≥0` this forces `x=0`. -- !--
/-- **Expander vanishing theorem.** A positive spectral gap (`μ > 0`) forces the
harmonic space to be trivial: the only harmonic cochain is `0`.  An expanding
complex has no nontrivial cohomology. -/
theorem gap_implies_vanishing (L : E →ₗ[ℝ] E) (μ : ℝ) (hμ : 0 < μ)
    (hgap : RayleighGap L μ) {x : E} (hx : L x = 0) : x = 0 := by
  have h := hgap x
  rw [hx, inner_zero_right] at h
  have hpos : (0 : ℝ) ≤ ⟪x, x⟫_ℝ := real_inner_self_nonneg
  have hxx : ⟪x, x⟫_ℝ ≤ 0 := by nlinarith
  exact inner_self_eq_zero.mp (le_antisymm hxx hpos)

/-! ## Message-passing dynamics: the ML bridge -/

/-- One gradient message-passing layer `T = 1 - α·L`, acting by `x ↦ x - α•(L x)`,
as an element of `Module.End ℝ E` so iteration (depth) is automatically linear. -/
def mpStep (L : E →ₗ[ℝ] E) (α : ℝ) : E →ₗ[ℝ] E := (1 : Module.End ℝ E) - α • L

@[simp] theorem mpStep_apply (L : E →ₗ[ℝ] E) (α : ℝ) (x : E) :
    mpStep L α x = x - α • (L x) := by simp [mpStep]

-- !-- Harmonic ⇒ `Lh=0 ⇒ Th = h - α•0 = h`. -- !--
/-- Harmonic signals are exact fixed points of every layer. -/
theorem mpStep_harmonic_fixed (L : E →ₗ[ℝ] E) (α : ℝ) {h : E} (hh : L h = 0) :
    mpStep L α h = h := by simp [mpStep, hh]

-- !-- Iterate the fixed-point property over depth `k` by induction. -- !--
/-- Harmonic signals stay fixed at every depth. -/
theorem mpStep_iterate_harmonic_fixed (L : E →ₗ[ℝ] E) (α : ℝ) {h : E}
    (hh : L h = 0) (k : ℕ) : ((mpStep L α) ^ k) h = h := by
  induction k with
  | zero => simp
  | succ n ih => rw [pow_succ', Module.End.mul_apply, ih, mpStep_harmonic_fixed L α hh]

-- !-- Expand `⟪Tx,Tx⟫ = ⟪x,x⟫ - 2α⟪x,Lx⟫ + α²⟪Lx,Lx⟫`, then bound
-- `⟪Lx,Lx⟫ ≤ λ⟪x,Lx⟫` and `μ⟪x,x⟫ ≤ ⟪x,Lx⟫` with `α≥0`, `αλ≤2`. -- !--
/-- **Per-layer contraction.** From the Rayleigh bounds `μ⟪x,x⟫ ≤ ⟪x,Lx⟫` and
`⟪Lx,Lx⟫ ≤ λ⟪x,Lx⟫`, one layer contracts the energy by `1 - αμ(2 - αλ)`. -/
theorem mpStep_contraction (L : E →ₗ[ℝ] E) (α μ lam : ℝ)
    (hα : 0 ≤ α) (hstep : α * lam ≤ 2)
    (hlower : ∀ x, μ * ⟪x, x⟫_ℝ ≤ ⟪x, L x⟫_ℝ)
    (hupper : ∀ x, ⟪L x, L x⟫_ℝ ≤ lam * ⟪x, L x⟫_ℝ) (x : E) :
    ⟪mpStep L α x, mpStep L α x⟫_ℝ ≤ (1 - α * μ * (2 - α * lam)) * ⟪x, x⟫_ℝ := by
  simp only [mpStep_apply, inner_sub_left, inner_sub_right, inner_smul_left,
    inner_smul_right, conj_trivial]
  nlinarith [mul_nonneg (sq_nonneg α) (sub_nonneg.2 (hupper x)),
    mul_nonneg (mul_nonneg hα (sub_nonneg.2 hstep)) (sub_nonneg.2 (hlower x)),
    real_inner_comm x (L x)]

-- !-- Induct on `k`: `⟪Tᵏ⁺¹r⟫ = ⟪T(Tᵏr)⟫ ≤ ρ⟪Tᵏr⟫ ≤ ρ·ρᵏ⟪r⟫`, using `0 ≤ ρ`. -- !--
/-- **Geometric decay across depth.** If a single layer contracts every energy by
`ρ ≥ 0`, then depth-`k` message passing contracts it by `ρ^k`. -/
theorem mpStep_iterate_contraction (L : E →ₗ[ℝ] E) (α ρ : ℝ) (hρ : 0 ≤ ρ)
    (hc : ∀ x, ⟪mpStep L α x, mpStep L α x⟫_ℝ ≤ ρ * ⟪x, x⟫_ℝ) (r : E) (k : ℕ) :
    ⟪((mpStep L α) ^ k) r, ((mpStep L α) ^ k) r⟫_ℝ ≤ ρ ^ k * ⟪r, r⟫_ℝ := by
  induction k with
  | zero => simp
  | succ n ih =>
    rw [pow_succ', Module.End.mul_apply]
    calc ⟪mpStep L α (((mpStep L α) ^ n) r), mpStep L α (((mpStep L α) ^ n) r)⟫_ℝ
        ≤ ρ * ⟪((mpStep L α) ^ n) r, ((mpStep L α) ^ n) r⟫_ℝ := hc _
      _ ≤ ρ * (ρ ^ n * ⟪r, r⟫_ℝ) := by exact mul_le_mul_of_nonneg_left ih hρ
      _ = ρ ^ (n + 1) * ⟪r, r⟫_ℝ := by ring

-- !-- With `0 ≤ ρ < 1`, `ρᵏ → 0`, so the energy bound `ρᵏ⟪r,r⟫` of the iterate is
-- eventually `< ε`: message passing collapses every signal onto the gapped (trivial)
-- harmonic space `{0}`. -- !--
/-- **Convergence under a gap.** If a layer is a strict contraction (`0 ≤ ρ < 1`),
then for every tolerance `ε > 0` there is a depth `K` beyond which the output energy
is below `ε`.  In the gapped regime (where the only harmonic is `0`) this says deep
message passing drives every signal to the trivial cohomology. -/
theorem gap_mpStep_converges (L : E →ₗ[ℝ] E) (α ρ : ℝ)
    (hρ0 : 0 ≤ ρ) (hρ1 : ρ < 1)
    (hc : ∀ x, ⟪mpStep L α x, mpStep L α x⟫_ℝ ≤ ρ * ⟪x, x⟫_ℝ)
    (r : E) {ε : ℝ} (hε : 0 < ε) :
    ∃ K : ℕ, ∀ k ≥ K,
      ⟪((mpStep L α) ^ k) r, ((mpStep L α) ^ k) r⟫_ℝ < ε := by
  have hlim : Filter.Tendsto (fun k : ℕ => ρ ^ k * ⟪r, r⟫_ℝ) Filter.atTop (nhds 0) := by
    simpa using (tendsto_pow_atTop_nhds_zero_of_lt_one hρ0 hρ1).mul tendsto_const_nhds
  obtain ⟨K, hK⟩ := Filter.eventually_atTop.mp (hlim.eventually (gt_mem_nhds hε))
  exact ⟨K, fun k hk => lt_of_le_of_lt
    (mpStep_iterate_contraction L α ρ hρ0 hc r k) (hK k hk)⟩

/-! ## Optimality of the spectral step `α = 1/λ` -/

-- !-- `(1 - αμ(2-αλ)) - (1 - μ/λ) = μ(αλ-1)²/λ ≥ 0`, a perfect square. -- !--
/-- **Optimal spectral step.** Among all steps `α`, the contraction factor
`1 - αμ(2 - αλ)` is minimized at `α = 1/λ`, where it equals `1 - μ/λ` (one minus
the spectral-gap ratio). -/
theorem contraction_factor_optimal (μ lam α : ℝ) (hμ : 0 < μ) (hlam : 0 < lam) :
    1 - μ / lam ≤ 1 - α * μ * (2 - α * lam) := by
  nlinarith [sq_nonneg (α * lam - 1), mul_pos hμ hlam, div_mul_cancel₀ μ hlam.ne']

/-- The contraction factor at the optimal step `α = 1/λ` is exactly `1 - μ/λ`. -/
theorem contraction_factor_at_optimal (μ lam : ℝ) (hlam : lam ≠ 0) :
    1 - (1 / lam) * μ * (2 - (1 / lam) * lam) = 1 - μ / lam := by
  field_simp
  ring

/-! ## Capstone: gap ⇒ optimal message passing collapses to zero cohomology -/

-- !-- Combine `mpStep_contraction` (rate `1 - μ/λ`) at `α = 1/λ` with
-- `gap_mpStep_converges`: the gap `μ>0` makes the rate `< 1`, so deep optimal
-- message passing collapses every signal onto the (trivial) harmonic space. -- !--
/-- **Spectral-gap rigidity ⇒ collapse.** On a complex with gap `μ` and upper
Rayleigh bound `λ` (with `0 < μ ≤ λ`), the optimal layer `α = 1/λ` is a strict
contraction with rate `1 - μ/λ < 1`, so deep message passing converges every
signal to the trivial cohomology. -/
theorem gap_optimal_mpStep_converges (L : E →ₗ[ℝ] E) (μ lam : ℝ)
    (hμ : 0 < μ) (hμlam : μ ≤ lam)
    (hlower : ∀ x, μ * ⟪x, x⟫_ℝ ≤ ⟪x, L x⟫_ℝ)
    (hupper : ∀ x, ⟪L x, L x⟫_ℝ ≤ lam * ⟪x, L x⟫_ℝ)
    (r : E) {ε : ℝ} (hε : 0 < ε) :
    ∃ K : ℕ, ∀ k ≥ K,
      ⟪((mpStep L (1 / lam)) ^ k) r, ((mpStep L (1 / lam)) ^ k) r⟫_ℝ < ε := by
  have hlam : 0 < lam := lt_of_lt_of_le hμ hμlam
  have hrate : (1 : ℝ) - (1 / lam) * μ * (2 - (1 / lam) * lam) = 1 - μ / lam :=
    contraction_factor_at_optimal μ lam hlam.ne'
  have hρ0 : (0 : ℝ) ≤ 1 - μ / lam := by
    rw [sub_nonneg]; exact (div_le_one hlam).2 hμlam
  have hρ1 : (1 : ℝ) - μ / lam < 1 := by
    have : 0 < μ / lam := div_pos hμ hlam
    linarith
  have hc : ∀ x, ⟪mpStep L (1 / lam) x, mpStep L (1 / lam) x⟫_ℝ ≤ (1 - μ / lam) * ⟪x, x⟫_ℝ := by
    intro x
    have := mpStep_contraction L (1 / lam) μ lam (by positivity)
      (by rw [one_div, inv_mul_cancel₀ hlam.ne']; norm_num) hlower hupper x
    rwa [hrate] at this
  exact gap_mpStep_converges L (1 / lam) (1 - μ / lam) hρ0 hρ1 hc r hε

end SpectralGapRigidity
