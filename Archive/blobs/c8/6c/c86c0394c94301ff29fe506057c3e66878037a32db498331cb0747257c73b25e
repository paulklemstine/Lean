import Mathlib

/-! # Zeckendorf's theorem: every positive integer is a unique sum of
non-consecutive Fibonacci numbers (core layer)

Domain: Number Theory.

Zeckendorf's theorem (Lekkerkerker 1952 / Zeckendorf 1972) states that every
positive integer `n` can be written **uniquely** as a sum of one or more distinct
Fibonacci numbers, subject to the constraint that no two of the Fibonacci numbers
used are consecutive.  Using the indexing `F 2 = 1, F 3 = 2, F 4 = 3, F 5 = 5, …`
(so the value-`1` Fibonacci number is taken once, at index `2`), every representation
is a set of indices `≥ 2` with no two consecutive integers.

The catalog already contains a deep *entry-point / rank-of-apparition* theory of the
Fibonacci numbers (`Catalog/Applications/RankOfApparition.lean`,
`Catalog/Applications/FibonacciPisanoRepresentation.lean`, the Carmichael
primitive-divisor files, …).  All of those study **divisibility** of Fibonacci numbers.
Zeckendorf's theorem is the orthogonal, *additive* structural theorem about the
Fibonacci sequence, and is absent from both Mathlib and the catalog.  This file builds
the combinatorial core from scratch.

We encode a Zeckendorf representation as a list of indices in **strictly decreasing**
order (head = largest index), each index `≥ 2`, with consecutive indices differing by
at least `2` (the "non-consecutive" constraint).

* `IsZeck l`              — `l` is a valid Zeckendorf index list.
* `value l`              — the integer `∑_{i ∈ l} F i` it represents.
* `value_lt_fib_succ_head` — **the crux**: a Zeckendorf list with largest index `a`
  has value `< F (a+1)`.  This single bound powers both existence (the greedy step is
  forced) and uniqueness (the largest index is pinned by the value).
* `fib_head_le_value`    — the matching lower bound `F a ≤ value l`.
* `value_eq_zero_iff`    — `value l = 0 ↔ l = []` (for valid lists).

Existence and uniqueness are assembled in the companion files
`Existence.lean` and `Uniqueness.lean`.

-- !-- Lab Notes -- !--
-- HYPOTHESIS: the entire theorem rests on a single two-sided estimate: a valid list with
--   largest index `a` has value in the half-open Fibonacci interval `[F a, F (a+1))`.
-- EXPERIMENT: encode representations as strictly-decreasing index lists with a `Chain'`
--   "gap ≥ 2" predicate. The head is then the largest index, which is exactly the datum the
--   greedy/uniqueness arguments need to read off in O(1). SUCCESS: `chain'_cons'` exposes the
--   head-gap obligation cleanly.
-- INSIGHT: the upper bound is a telescoping induction `F a + (value tail) < F a + F (a-1) = F (a+1)`,
--   where `value tail < F (b+1) ≤ F (a-1)` uses the gap `b + 2 ≤ a`. The `+2` gap is precisely
--   what makes `F (b+1) ≤ F (a-1)` hold, i.e. non-consecutiveness is the hypothesis the bound needs.
-- FAILURE ANALYSIS: with index `1` allowed, `F 1 = F 2 = 1` would break uniqueness (two ways to
--   write `1`); forcing indices `≥ 2` removes the `F 1 = F 2` degeneracy. This is why `2 ≤ x`.
-- !-- End Lab Notes -- !--
-/

namespace Zeckendorf

/-- A **Zeckendorf index list**: indices in strictly decreasing order (head largest),
each `≥ 2`, with consecutive indices differing by at least `2`. -/
def IsZeck (l : List ℕ) : Prop :=
  l.Chain' (fun a b => b + 2 ≤ a) ∧ ∀ x ∈ l, 2 ≤ x

/-- The integer represented by a Zeckendorf index list: `∑_{i ∈ l} F i`. -/
def value (l : List ℕ) : ℕ := (l.map Nat.fib).sum

@[simp] lemma value_nil : value [] = 0 := rfl

@[simp] lemma value_cons (a : ℕ) (l : List ℕ) :
    value (a :: l) = Nat.fib a + value l := rfl

lemma isZeck_nil : IsZeck [] := ⟨List.chain'_nil, by simp⟩

/-- Structural characterization of `IsZeck` on a cons. -/
lemma isZeck_cons {a : ℕ} {l : List ℕ} :
    IsZeck (a :: l) ↔
      (2 ≤ a ∧ IsZeck l ∧ ∀ b, l.head? = some b → b + 2 ≤ a) := by
  simp +decide [ IsZeck, List.chain'_cons' ];
  rcases l <;> simp +decide [ List.Chain' ];
  tauto

/-- The largest index gives a lower bound on the value: `F a ≤ value l` when `a` is the head. -/
lemma fib_head_le_value {l : List ℕ} {a : ℕ} (ha : l.head? = some a) :
    Nat.fib a ≤ value l := by
  induction l <;> simp_all +arith +decide [ value ]

/-- **The crux bound.**  A Zeckendorf list with largest index `a` has value `< F (a+1)`. -/
lemma value_lt_fib_succ_head {l : List ℕ} (hl : IsZeck l) {a : ℕ}
    (ha : l.head? = some a) : value l < Nat.fib (a + 1) := by
  induction' l with x l ih generalizing a <;> simp_all +decide [ Nat.fib_add_two ];
  cases hl ; simp_all +decide [ Nat.fib_add_two ];
  rcases l <;> simp_all +decide [ List.chain'_cons' ];
  · exact Nat.fib_lt_fib_succ ( by linarith );
  · rename_i k hk₁ hk₂;
    have := ih ?_;
    · have h_fib_mono : Nat.fib (‹_› + 1) ≤ Nat.fib (a - 1) := by
        exact Nat.fib_mono ( by have := List.isChain_cons_cons.mp hk₁; omega );
      rcases a with ( _ | _ | a ) <;> simp_all +decide [ Nat.fib_add_two ];
      grind;
    · exact ⟨ List.chain'_cons'.mp hk₁ |>.2, by aesop ⟩

/-- For a valid list, the value is zero iff the list is empty. -/
lemma value_eq_zero_iff {l : List ℕ} (hl : IsZeck l) : value l = 0 ↔ l = [] := by
  rcases l with ( _ | ⟨ a, _ | ⟨ b, l ⟩ ⟩ ) <;> simp_all +arith +decide [ Nat.fib_add_two ]; all_goals cases hl ; aesop

/-- A nonempty valid list has positive value. -/
lemma value_pos {l : List ℕ} (hl : IsZeck l) (hne : l ≠ []) : 0 < value l := by
  exact Nat.pos_of_ne_zero fun h => hne <| value_eq_zero_iff hl |>.1 h

end Zeckendorf
