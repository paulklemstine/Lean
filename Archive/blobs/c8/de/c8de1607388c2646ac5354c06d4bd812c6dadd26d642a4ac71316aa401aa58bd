/-
# Neural observation pseudometric — formalizable core

This file isolates the *abstract ultrametric / pseudometric core* underlying the
"neural observation pseudometric" project.

The informal picture is the following.  Two inputs `x` and `y` to a network are
compared by *observations of increasing depth*.  For each depth `n : ℕ` we can
either still tell them apart or not.  The function

  `depth x y : WithTop ℕ`

records the *first depth at which `x` and `y` become distinguishable*, with the
convention that `depth x y = ⊤` (`⊤ = none`) means that the two inputs are
*indistinguishable at every depth*.  A larger `depth` therefore means the inputs
agree for longer, i.e. they are "closer".

We turn this separation depth into a genuine dyadic (ultra)pseudometric via the
antitone map

  `toDist : WithTop ℕ → ℝ≥0∞`,   `toDist ⊤ = 0`,   `toDist k = (1/2) ^ k`.

The neural pseudometric is then `dist x y = toDist (depth x y)`.

We adopt the **depth-first formulation** (Option B of the project brief) because
it minimizes Lean friction: the separation depth is taken as a primitive
satisfying three natural axioms

* `hrefl  : depth x x = ⊤`              (a point is indistinguishable from itself)
* `hsymm  : depth x y = depth y x`      (symmetry of observation)
* `hmin   : min (depth x y) (depth y z) ≤ depth x z`
            (a strong / ultrametric triangle law at the level of depths)

and we prove the four core facts about the induced distance:

* `dist_self`           : `dist x x = 0`
* `dist_comm`           : `dist x y = dist y x`
* `dist_eq_zero_iff`    : `dist x y = 0 ↔ depth x y = ⊤`  (kernel = indistinguishability)
* `dist_strong_triangle`: `dist x z ≤ max (dist x y) (dist y z)` (strong/ultra triangle)

The codomain is `ℝ≥0∞ = ENNReal`, so the result is literally a
`(1/2)^•`-valued ultrapseudometric, matching the dyadic pseudometrics used in the
informal project.
-/

import Mathlib

open scoped ENNReal

namespace NeuralObservationPseudometric

/-! ## The dyadic value map `toDist`

`toDist` sends a separation depth in `WithTop ℕ` to a dyadic distance in `ℝ≥0∞`.
It is the order-reversing dictionary between "depth of agreement" and "distance":
agreement at all depths (`⊤`) is distance `0`, while first disagreement at depth
`k` is distance `(1/2)^k`. -/

/-- Dyadic distance attached to a separation depth: `⊤ ↦ 0` and `k ↦ (1/2)^k`. -/
noncomputable def toDist (t : WithTop ℕ) : ℝ≥0∞ := t.elim 0 (fun k => (1 / 2) ^ k)

@[simp] lemma toDist_top : toDist ⊤ = 0 := rfl

@[simp] lemma toDist_coe (k : ℕ) : toDist (k : ℕ) = (1 / 2) ^ k := rfl

/-- A finite separation depth always yields a strictly positive distance. -/
lemma toDist_coe_ne_zero (k : ℕ) : toDist (k : ℕ) ≠ 0 := by
  simp only [toDist_coe]
  exact pow_ne_zero k (by norm_num)

/-- The kernel of `toDist` is exactly `{⊤}`: a pair has distance `0` iff it is
indistinguishable at every depth. -/
lemma toDist_eq_zero_iff (t : WithTop ℕ) : toDist t = 0 ↔ t = ⊤ := by
  induction t using WithTop.recTopCoe with
  | top => simp
  | coe k =>
    constructor
    · intro h; exact absurd h (toDist_coe_ne_zero k)
    · intro h; exact absurd h WithTop.coe_ne_top

/-- `toDist` is antitone: deeper agreement means smaller distance. -/
lemma toDist_antitone : Antitone toDist := by
  intro a b hab
  induction a using WithTop.recTopCoe with
  | top =>
    have hb : b = ⊤ := top_le_iff.mp hab
    subst hb; simp
  | coe k =>
    induction b using WithTop.recTopCoe with
    | top => simp only [toDist_top]; exact zero_le _
    | coe m =>
      have hkm : k ≤ m := by exact_mod_cast hab
      show (1 / 2 : ℝ≥0∞) ^ m ≤ (1 / 2) ^ k
      exact pow_le_pow_right_of_le_one' (by norm_num) hkm

/-- Antitonicity converts `min` of depths into `max` of distances; this is the
algebraic heart of the strong triangle inequality. -/
lemma toDist_min (a b : WithTop ℕ) :
    toDist (min a b) = max (toDist a) (toDist b) := by
  rcases le_total a b with h | h
  · rw [min_eq_left h, max_eq_left (toDist_antitone h)]
  · rw [min_eq_right h, max_eq_right (toDist_antitone h)]

/-! ## The abstract neural observation pseudometric

We now fix a type `X` together with a separation-depth function `depth` and prove
the four core properties of the induced dyadic distance. -/

section Core

variable {X : Type*} (depth : X → X → WithTop ℕ)

/-- The dyadic (ultra)pseudometric induced by a separation-depth function. -/
noncomputable def dist (x y : X) : ℝ≥0∞ := toDist (depth x y)

@[simp] lemma dist_def (x y : X) : dist depth x y = toDist (depth x y) := rfl

/-- Two points are *indistinguishable* if they are never separated at any depth. -/
def Indist (x y : X) : Prop := depth x y = ⊤

variable {depth}

/-- (a) Reflexivity: a point has distance `0` to itself. -/
lemma dist_self (hrefl : ∀ x, depth x x = ⊤) (x : X) : dist depth x x = 0 := by
  simp [dist, hrefl x]

/-- (b) Symmetry, inherited from symmetry of the separation depth. -/
lemma dist_comm (hsymm : ∀ x y, depth x y = depth y x) (x y : X) :
    dist depth x y = dist depth y x := by
  simp [dist, hsymm x y]

/-- (c) Kernel characterization: distance `0` is exactly indistinguishability. -/
lemma dist_eq_zero_iff (x y : X) : dist depth x y = 0 ↔ Indist depth x y := by
  simpa [dist, Indist] using toDist_eq_zero_iff (depth x y)

/-- (d) Strong (ultrametric) triangle inequality:
`dist x z ≤ max (dist x y) (dist y z)`. -/
lemma dist_strong_triangle
    (hmin : ∀ x y z, min (depth x y) (depth y z) ≤ depth x z)
    (x y z : X) :
    dist depth x z ≤ max (dist depth x y) (dist depth y z) := by
  have h := toDist_antitone (hmin x y z)
  rwa [toDist_min] at h

/-- The strong triangle inequality immediately implies the ordinary triangle
inequality, since `max a b ≤ a + b` in `ℝ≥0∞`. -/
lemma dist_triangle
    (hmin : ∀ x y z, min (depth x y) (depth y z) ≤ depth x z)
    (x y z : X) :
    dist depth x z ≤ dist depth x y + dist depth y z :=
  le_trans (dist_strong_triangle hmin x y z) (max_le_add_of_nonneg (zero_le _) (zero_le _))

end Core

end NeuralObservationPseudometric
