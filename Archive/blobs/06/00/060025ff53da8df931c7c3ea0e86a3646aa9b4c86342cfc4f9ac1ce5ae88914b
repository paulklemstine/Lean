import Mathlib

/-! # Valuation profiles and tropical convolution lower bounds

This file builds a small, self-contained package relating an additive valuation
on a commutative semiring `K` to a tropical (min-plus) lower bound on the
valuations of finite Cauchy convolutions of coefficient sequences.

The valuation takes values in `WithTop ℤ` and satisfies only three axioms:
`v 0 = ⊤`, `v (x * y) = v x + v y`, and `min (v x) (v y) ≤ v (x + y)`.

The central statement is `vprofile_cauchy_ge_tropConv` (repackaged as
`vprofile_lax_monoidal`): the tropical convolution of two valuation profiles is
a pointwise lower bound for the valuation profile of the Cauchy convolution of
the corresponding sequences.
-/

namespace ValuationTropicalConvolutionBridge

open Finset

/-- An additive valuation on a commutative semiring `K`, valued in `WithTop ℤ`. -/
structure AddVal (K : Type*) [CommSemiring K] where
  /-- The underlying valuation map. -/
  v : K → WithTop ℤ
  /-- The valuation of `0` is `⊤`. -/
  map_zero : v 0 = ⊤
  /-- Valuations are additive on products. -/
  map_mul : ∀ x y, v (x * y) = v x + v y
  /-- The valuation of a sum is at least the minimum of the valuations. -/
  min_le_map_add : ∀ x y, min (v x) (v y) ≤ v (x + y)

variable {K : Type*} [CommSemiring K]

/-- A coefficient sequence with values in `K`. -/
abbrev Seq (K : Type*) := ℕ → K

/-- The valuation profile of a sequence `f : Seq K`. -/
def vprofile (V : AddVal K) (f : Seq K) : ℕ → WithTop ℤ := fun n => V.v (f n)

/-- The finite Cauchy convolution of two sequences, summing over the
antidiagonal so every coefficient is a finite sum. -/
def cauchy (f g : Seq K) (n : ℕ) : K :=
  ∑ p ∈ Finset.antidiagonal n, f p.1 * g p.2

/-- The antidiagonal of `n` is nonempty (it contains `(0, n)`). -/
lemma antidiagonal_nonempty (n : ℕ) : (Finset.antidiagonal n).Nonempty :=
  ⟨(0, n), by simp⟩

/-- The tropical (min-plus) convolution of two `WithTop ℤ`-valued profiles,
defined as a finite minimum over the antidiagonal of `n`. -/
noncomputable def tropConv (φ ψ : ℕ → WithTop ℤ) (n : ℕ) : WithTop ℤ :=
  (Finset.antidiagonal n).inf' (antidiagonal_nonempty n) (fun p => φ p.1 + ψ p.2)

/-- **Item 1.** The valuation profile of a pointwise sum is at least the minimum
of the two profiles. Immediate from the additive valuation axiom. -/
theorem vprofile_add_ge (V : AddVal K) (f g : Seq K) (n : ℕ) :
    min (vprofile V f n) (vprofile V g n) ≤ vprofile V (f + g) n := by
  simpa [vprofile, Pi.add_apply] using V.min_le_map_add (f n) (g n)

/-- **Item 2.** The tropical convolution is a lower bound for each pair summand
indexed by the antidiagonal. -/
theorem tropConv_le_pair (φ ψ : ℕ → WithTop ℤ) (n : ℕ) (p : ℕ × ℕ)
    (hp : p ∈ Finset.antidiagonal n) :
    tropConv φ ψ n ≤ φ p.1 + ψ p.2 :=
  Finset.inf'_le _ hp

/-- A finite sum has valuation at least `m` whenever every summand does.
(The empty sum is `0`, whose valuation is `⊤`, so no nonemptiness is required.) -/
lemma le_val_sum (V : AddVal K) (m : WithTop ℤ) {α : Type*} (s : Finset α) (a : α → K)
    (h : ∀ i ∈ s, m ≤ V.v (a i)) : m ≤ V.v (∑ i ∈ s, a i) := by
  induction s using Finset.cons_induction with
  | empty => simp [V.map_zero]
  | cons i s hi ih =>
      rw [Finset.sum_cons]
      refine le_trans (le_min (h i (Finset.mem_cons_self i s)) (ih ?_)) (V.min_le_map_add _ _)
      intro j hj
      exact h j (Finset.mem_cons.mpr (Or.inr hj))

/-- **Item 3.** The key finite-sum valuation lower bound: the infimum of the
valuations of the summands bounds the valuation of the sum from below. -/
theorem v_add_sum_ge_inf (V : AddVal K) {α : Type*} (s : Finset α) (hne : s.Nonempty)
    (a : α → K) :
    s.inf' hne (fun i => V.v (a i)) ≤ V.v (∑ i ∈ s, a i) := by
  apply le_val_sum
  intro i hi
  exact Finset.inf'_le _ hi

/-- **Item 4.** The tropical convolution of the valuation profiles is a lower
bound for the valuation profile of the Cauchy convolution. -/
theorem vprofile_cauchy_ge_tropConv (V : AddVal K) (f g : Seq K) (n : ℕ) :
    tropConv (vprofile V f) (vprofile V g) n ≤ vprofile V (cauchy f g) n := by
  unfold tropConv vprofile cauchy
  apply le_val_sum
  intro p hp
  rw [V.map_mul]
  exact Finset.inf'_le _ hp

/-- **Item 5.** The lax-monoidal inequality for valuation profiles: passing from
sequences to valuation profiles turns the Cauchy product into a lower bound for
the tropical convolution. This is the packaged interpretation of
`vprofile_cauchy_ge_tropConv`. -/
theorem vprofile_lax_monoidal (V : AddVal K) (f g : Seq K) (n : ℕ) :
    tropConv (vprofile V f) (vprofile V g) n ≤ vprofile V (cauchy f g) n :=
  vprofile_cauchy_ge_tropConv V f g n

end ValuationTropicalConvolutionBridge
