\section{Introduction}

Behavioral indistinguishability---the inability of any experiment to separate two
internal states---is a load-bearing concept across automata theory, coalgebra,
concurrency, cryptography, and the semantics of learned models. It underlies state
minimization, the meaning of cryptographic indistinguishability, and the modern
view of ``compression'' as quotienting by what cannot be observed.

This paper studies behavioral equivalence for a class of machines that carry
\emph{algebraic} structure on both their state space and their output space, and it
relates three independently natural formalizations:
\begin{enumerate}
  \item \textbf{Metric.} An observation pseudometric $\obsDist$ whose kernel
        $\{(x,y) : \obsDist(x,y)=0\}$ records indistinguishability.
  \item \textbf{Coalgebraic.} The Myhill--Nerode behavioral equivalence $\approx$
        of an observation system: agreement of read-outs across all input contexts.
  \item \textbf{Algebraic-geometric.} A semiring congruence in the sense of
        proof-theoretic algebraic geometry, i.e.\ a point datum of a proof spectrum.
\end{enumerate}
The contribution is to show these three are not merely analogous but \emph{equal},
that the correspondence is functorial in the systems, and that the pseudometric
matures into an honest metric on the behavioral quotient. All results have been
formalized and machine-checked; here we present the mathematics with proof
sketches.

\subsection{Background and context}
The three viewpoints we unify each have long, independent pedigrees.
\emph{Coalgebra and Myhill--Nerode:} the coalgebraic reformulation replaces
residual languages by behaviors---the function sending each input continuation
to the observed output---and identifies states with the same behavior; this is
bisimilarity for the deterministic-observation functor, and quotienting yields
the minimal realization. Our systems are the semiring-weighted case.
\emph{Universal algebra:} a congruence is the kernel of a homomorphism; the
surprise exploited here is that the semantic relation ``same behavior'' is a
congruence purely because the behavior map is a homomorphism in the state.
\emph{Proof-theoretic algebraic geometry:} semiring congruences play the role of
ideals, with prime congruences, a spectrum carrying a Zariski-style topology, and
a Galois connection; realizing a behavior as a congruence places it in this
spectral world. \emph{Metric semantics:} the discrete pseudometric is the
coarsest quantitative structure but already exposes the kernel identity and
sharpens to a metric after quotienting. The novelty is the \emph{exact}
coincidence of these strands and its functoriality.

\section{Algebraic neural observation systems}

Throughout, $\Rsemiring$ and $\Ksemiring$ are semirings and $\alpha$ is an alphabet
of input symbols.

\begin{definition}[Algebraic neural observation system]\label{def:alg}
An \emph{algebraic neural observation system} $N$ over $(\Rsemiring,\Ksemiring,\alpha)$
consists of layers $\stepfn : \Rsemiring \to \alpha \to \Rsemiring$, written
$\stepfn(x,a)$, and a read-out $\observe : \Rsemiring \to \Ksemiring$, subject to the
homomorphism laws, for all $a \in \alpha$ and $x,y \in \Rsemiring$:
\[
\stepfn(0,a)=0,\quad
\stepfn(x+y,a)=\stepfn(x,a)+\stepfn(y,a),\quad
\stepfn(x\cdot y,a)=\stepfn(x,a)\cdot\stepfn(y,a),
\]
\[
\observe(0)=0,\quad
\observe(x+y)=\observe(x)+\observe(y),\quad
\observe(x\cdot y)=\observe(x)\cdot\observe(y).
\]
\end{definition}

We deliberately do \emph{not} require preservation of the multiplicative unit $1$.
Behavioral equivalence inspects only sums and products of states under the
read-out, never the state's unit; demanding $\stepfn(1,a)=1$ would be an unused and
frequently false hypothesis.

\begin{definition}[Behavior]\label{def:behavior}
For $x\in\Rsemiring$ and a context (word) $w=a_1\cdots a_n$, the \emph{behavior of
$x$ on $w$} is $\behavior(x,w)=\observe\bigl(\foldl(\stepfn,x,w)\bigr)$, where
$\foldl(\stepfn,x,[a_1,\dots,a_n])=\stepfn(\dots\stepfn(\stepfn(x,a_1),a_2)\dots,a_n)$.
In particular $\behavior(x,[])=\observe(x)$.
\end{definition}

\begin{lemma}[Fold preserves the algebra]\label{lem:fold}
For every word $w$:
$\foldl(\stepfn,0,w)=0$,
$\foldl(\stepfn,x+y,w)=\foldl(\stepfn,x,w)+\foldl(\stepfn,y,w)$, and
$\foldl(\stepfn,x\cdot y,w)=\foldl(\stepfn,x,w)\cdot\foldl(\stepfn,y,w)$.
\end{lemma}

\begin{proof}[Proof sketch]
Induct on $w$ via reverse recursion. The base case is trivial; the inductive step
applies the corresponding $\stepfn$ law to the accumulated state, since a composite
of additive (resp.\ multiplicative, resp.\ zero-preserving) maps has the same
property.
\end{proof}

\begin{proposition}[Behavior is a homomorphism in the state]\label{prop:hom}
For every word $w$:
$\behavior(0,w)=0$, $\behavior(x+y,w)=\behavior(x,w)+\behavior(y,w)$, and
$\behavior(x\cdot y,w)=\behavior(x,w)\cdot\behavior(y,w)$.
\end{proposition}

\begin{proof}[Proof sketch]
Apply $\observe$ to Lemma~\ref{lem:fold} and use that $\observe$ is a semiring
homomorphism.
\end{proof}

Proposition~\ref{prop:hom} is the structural lever for everything that follows.

\section{The behavior congruence: the functor object}

\begin{definition}[Behavioral equivalence kernel]\label{def:rel}
Define $\mathrm{behaviorRel}(x,y) :\Longleftrightarrow \forall w,\ \behavior(x,w)=\behavior(y,w)$.
\end{definition}

This is an equivalence relation, coinciding with the coalgebraic Myhill--Nerode
equivalence of the underlying weighted observation system.

A \emph{semiring congruence} on $\Rsemiring$ is an equivalence relation $\sim$ with
$a\sim b,\ c\sim d \Rightarrow a+c\sim b+d$ and $a\cdot c\sim b\cdot d$.

\begin{theorem}[Behavioral equivalence is a congruence]\label{thm:cong}
$\mathrm{behaviorRel}$ is a semiring congruence on $\Rsemiring$.
\end{theorem}

\begin{proof}[Proof sketch]
The equivalence axioms are formal. For additive compatibility, suppose $a\sim b$
and $c\sim d$. For any $w$, Proposition~\ref{prop:hom} gives
$\behavior(a+c,w)=\behavior(a,w)+\behavior(c,w)=\behavior(b,w)+\behavior(d,w)=\behavior(b+d,w)$,
hence $a+c\sim b+d$. Multiplicative compatibility is identical with $\cdot$.
\end{proof}

We denote the resulting congruence $\mathrm{behaviorCongruence}(N)\in\SRCong\,\Rsemiring$;
it is a datum of the proof spectrum over $\Rsemiring$, where objects are semiring
congruences, primes are geometric points, and a Galois connection furnishes
Zariski-closed loci.

\begin{proposition}[Zero-class]\label{prop:zero}
$\{x : \mathrm{behaviorRel}(x,0)\}=\{x : \forall w,\ \behavior(x,w)=0\}$.
\end{proposition}

\begin{proof}[Proof sketch]
By Proposition~\ref{prop:hom}, $\behavior(0,w)=0$, so $\mathrm{behaviorRel}(x,0)$
unfolds to $\forall w,\ \behavior(x,w)=0$.
\end{proof}

\begin{definition}[Depth-$k$ equivalence]
$\mathrm{equivUpto}(k)(x,y):\Longleftrightarrow \forall w,\ |w|\le k \Rightarrow \behavior(x,w)=\behavior(y,w)$.
\end{definition}

\begin{theorem}[Kernel as limit of finite observers]\label{thm:depth}
$\mathrm{behaviorRel}(x,y)\Longleftrightarrow \forall k\in\mathbb{N},\ \mathrm{equivUpto}(k)(x,y)$.
\end{theorem}

\begin{proof}[Proof sketch]
Forward: restrict to words of length $\le k$. Backward: any word has finite length
$k$, so agreement at all depths forces agreement on it.
\end{proof}

Theorem~\ref{thm:depth} exhibits the congruence as the intersection of a converging
sequence of finite-depth partition refinements with $O(|\alpha|^k)$ observation
budget at depth $k$.

\section{Functoriality}

\begin{definition}[Morphism]\label{def:morphism}
A morphism $f:N\to M$ over a common alphabet $\alpha$ and output semiring
$\Ksemiring$ is a state map $f:\Rsemiring\to S$ with
$f(\stepfn_N(x,a))=\stepfn_M(f(x),a)$ and $\observe_N(x)=\observe_M(f(x))$.
No compatibility of $f$ with $+$ or $\cdot$ is required.
\end{definition}

\begin{theorem}[Behavior preservation]\label{thm:pres}
For every $x$ and word $w$, $\behavior_N(x,w)=\behavior_M(f(x),w)$.
\end{theorem}

\begin{proof}[Proof sketch]
Intertwining $\stepfn$ makes the two folds agree state-by-state, and intertwining
$\observe$ makes the read-outs agree.
\end{proof}

\begin{corollary}[Functoriality on objects]\label{cor:func}
If $\mathrm{behaviorRel}_N(x,y)$ then $\mathrm{behaviorRel}_M(f(x),f(y))$. Hence
$N\mapsto\mathrm{behaviorCongruence}(N)$ pushes congruences forward.
\end{corollary}

\begin{definition}[Identity and composition]\label{def:cat}
The identity $\mathrm{id}_N$ has underlying state map the identity; the composite
$f\circ g$ of $g:N\to M$ and $f:M\to P$ has underlying state map
$f.\mathrm{toFun}\circ g.\mathrm{toFun}$. The intertwining laws hold by rewriting.
\end{definition}

\begin{proposition}[Extensionality]\label{prop:ext}
Two morphisms with equal underlying state maps are equal.
\end{proposition}

With identities, associative composition, and extensionality, algebraic neural
systems and their intertwining morphisms form a \textbf{category}.

\begin{theorem}[The pushforwards are functorial]\label{thm:funct}
Writing $\mathrm{algBehavior}(f)$ and $\mathrm{behaviorCongruence\_map}(f)$ for the
underlying state pushforward of $f$:
$\mathrm{algBehavior}(\mathrm{id}_N)=\mathrm{id}$,
$\mathrm{behaviorCongruence\_map}(\mathrm{id}_N)=\mathrm{id}$,
$\mathrm{algBehavior}(f\circ g)=\mathrm{algBehavior}(f)\circ\mathrm{algBehavior}(g)$, and
$\mathrm{behaviorCongruence\_map}(f\circ g)=\mathrm{behaviorCongruence\_map}(f)\circ\mathrm{behaviorCongruence\_map}(g)$.
\end{theorem}

\begin{proof}[Proof sketch]
Each pushforward is $f.\mathrm{toFun}$; the identity/composition statements hold
definitionally from Definition~\ref{def:cat}.
\end{proof}

\section{The observation pseudometric and the comparison theorem}

\begin{definition}[Observation pseudometric]\label{def:obsdist}
$\obsDist(x,y)=0$ if $\mathrm{behaviorRel}(x,y)$, and $\obsDist(x,y)=1$ otherwise.
\end{definition}

\begin{theorem}[Pseudometric axioms]\label{thm:pseudo}
$\obsDist$ is a pseudometric: $\obsDist(x,y)\ge 0$, $\obsDist(x,x)=0$,
$\obsDist(x,y)=\obsDist(y,x)$, and
$\obsDist(x,z)\le\obsDist(x,y)+\obsDist(y,z)$.
\end{theorem}

\begin{proof}[Proof sketch]
Non-negativity and self-distance are by definition and reflexivity; symmetry from
symmetry of $\mathrm{behaviorRel}$. For the triangle inequality, the only failing
configuration would have left side $1$ and right side $0$, forcing $x\approx y$,
$y\approx z$, but $x\not\approx z$, contradicting transitivity.
\end{proof}

\begin{theorem}[Kernel $=$ congruence]\label{thm:kernel}
$\obsDist(x,y)=0\Longleftrightarrow\mathrm{behaviorCongruence}(N).\mathrm{rel}(x,y)$.
\end{theorem}

\begin{proof}[Proof sketch]
Both sides unfold to $\mathrm{behaviorRel}(x,y)$.
\end{proof}

\begin{theorem}[Three faces of one kernel]\label{thm:three}
For all $x,y$:
$\obsDist(x,y)=0\Longleftrightarrow \mathrm{weightedNeuralEquiv}(x,y)$ and
$\mathrm{weightedNeuralEquiv}(x,y)\Longleftrightarrow\mathrm{behaviorCongruence}(N).\mathrm{rel}(x,y)$.
\end{theorem}

Thus the metric kernel, the Myhill--Nerode equivalence, and the proof-spectrum
congruence are one relation; the three quotients coincide.

\section{Quotient descent: from pseudometric to metric}

\begin{definition}[Behavior setoid]\label{def:setoid}
Let $\mathrm{behaviorSetoid}(N)$ be the setoid on $\Rsemiring$ with relation
$a\approx b :\Longleftrightarrow \obsDist(a,b)=0$, equivalently
$\mathrm{behaviorRel}(a,b)$.
\end{definition}

\begin{lemma}[Invariance]\label{lem:inv}
If $a_1\approx a_2$ and $b_1\approx b_2$ then $\obsDist(a_1,b_1)=\obsDist(a_2,b_2)$.
\end{lemma}

\begin{proof}[Proof sketch]
Translate to $\mathrm{behaviorRel}$ via Theorem~\ref{thm:kernel}. If $a_1\approx
b_1$, then composing $a_2\approx a_1\approx b_1\approx b_2$ gives $a_2\approx b_2$,
so both sides are $0$; otherwise both are $1$ by the contrapositive.
\end{proof}

\begin{definition}[Neural quotient and descended distance]\label{def:quot}
Let $\mathrm{NeuralQuotient}(N)=\Rsemiring/\mathrm{behaviorSetoid}(N)$. By
Lemma~\ref{lem:inv}, $\obsDist$ lifts uniquely to
$\mathrm{quotObsDist}$ with $\mathrm{quotObsDist}([a],[b])=\obsDist(a,b)$.
\end{definition}

\begin{theorem}[Metric on the quotient]\label{thm:metric}
$\mathrm{quotObsDist}$ is a metric:
$\mathrm{quotObsDist}(X,X)=0$,
$\mathrm{quotObsDist}(X,Y)=\mathrm{quotObsDist}(Y,X)$,
$\mathrm{quotObsDist}(X,Z)\le\mathrm{quotObsDist}(X,Y)+\mathrm{quotObsDist}(Y,Z)$, and
\emph{separation:} $\mathrm{quotObsDist}(X,Y)=0\Longleftrightarrow X=Y$.
\end{theorem}

\begin{proof}[Proof sketch]
The first three axioms descend from Theorem~\ref{thm:pseudo} by quotient induction.
For separation: $\mathrm{quotObsDist}([a],[b])=0$ means $a\approx b$, which is
$[a]=[b]$ by soundness/exactness of the quotient.
\end{proof}

Thus the only defect of $\obsDist$---failure of separation---is exactly cured by
quotienting, and by Corollary~\ref{cor:func} every morphism descends to a
non-expanding map of quotients.

\section{Algorithms}

\subsection{Behavior signature and depth-bounded equivalence}
By Theorem~\ref{thm:depth}, behavioral equivalence is the limit of depth-bounded
equivalences. For a finite alphabet and decidable equality on $\Ksemiring$,
depth-$k$ equivalence is decidable by enumerating all $O(|\alpha|^k)$ words of
length $\le k$ and comparing read-outs, yielding a partition-refinement procedure.

\subsection{Quotient construction (minimization)}
Compute the behavior congruence by partition refinement, then choose one
representative per class. The result is the minimal realization; the descended
metric is the discrete metric on classes.

\section{A worked example}

Take the Boolean semiring $B=\{0,1\}$ with $+=\mathrm{OR}$, $\cdot=\mathrm{AND}$,
state space $R=B^4$, output $K=B$. Over $B^n$ the componentwise semiring
homomorphisms $B^n\to B^k$ are exactly the \emph{wirings}: each output coordinate
is constant $0$ or a copy of one input coordinate. Consider two input symbols
with $\stepfn(x,a)=(x_1,x_0,x_0,x_1)$, $\stepfn(x,b)=(x_0,x_1,x_1,x_0)$, and
\observe$(x)=x_0$. Coordinates $2,3$ are never read, hence unobservable, so any
two states agreeing on $(x_0,x_1)$ are behaviorally indistinguishable: the $16$
states collapse to $4$ behavior classes indexed by $(x_0,x_1)$. The behavior
congruence $x\sim y\Leftrightarrow x_0=y_0\wedge x_1=y_1$ is compatible with OR
and AND as Theorem~\ref{thm:cong} guarantees; $\obsDist$ is $0$ within classes and
$1$ across them, and $\mathrm{quotObsDist}$ is the discrete metric on the four
classes, with separation by construction. Every theorem above is checked
exhaustively on this system in the accompanying numerical demonstrations.

\section{Applications}

\begin{itemize}
  \item \textbf{Certified neural compression.} The quotient is the minimal machine
        with identical behavior; collapsing the congruence is observably lossless.
  \item \textbf{A common currency across fields.} The comparison theorem transports
        results among metric, algebraic, and geometric settings.
  \item \textbf{Behavioral geometry via proof spectra.} Behavior becomes a point
        datum of a proof spectrum, inviting Zariski topology and prime decomposition.
  \item \textbf{Stability under re-encoding.} Functoriality carries the behavioral
        geometry through any dynamics-intertwining refactor without expansion.
\end{itemize}

\section{Discussion and future work}

\begin{conjecture}[Primality as null-detection]
For systems whose reachable behavior values generate $\Ksemiring$ multiplicatively,
the behavior congruence is prime iff the read-out detects nullity along reachable
states.
\end{conjecture}

\begin{conjecture}[Metric-space-valued functor]
The quotient metric extends to a $\mathrm{MetricSpace}$ instance, and morphisms
induce $1$-Lipschitz maps, promoting the functor into the category of metric spaces.
\end{conjecture}

\begin{conjecture}[Graded ultrametric refinement]
With the antitone depth filtration, $\mathrm{gradDist}(x,y)=2^{-\inf\{k :
\neg\,\mathrm{equivUpto}(k)(x,y)\}}$ (empty-set convention $0$) is an ultrametric
whose kernel is the behavior congruence.
\end{conjecture}

\begin{conjecture}[Functorial Galois/Zariski transport]
When $f.\mathrm{toFun}$ is a semiring homomorphism, $f$ induces a continuous
$\Spec(f):\mathrm{ProofSpectrum}\,S\to\mathrm{ProofSpectrum}\,\Rsemiring$ for which
the behavioral prime congruence is natural and $\mathrm{zariskiClosed}$ pulls back.
\end{conjecture}

\section{Conclusion}

For algebraic neural observation systems, behavioral indistinguishability admits
three faithful descriptions---an observation pseudometric of distance zero, a
coalgebraic Myhill--Nerode equivalence, and a semiring congruence in a proof
spectrum---and these coincide exactly. The correspondence is functorial and
descends to a genuine metric on the behavioral quotient. Distance, logic, and
geometry name a single object.

