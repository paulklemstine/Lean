import Mathlib

/-!
# The Markov Basis of the Two-Way Independence Model

This file gives a self-contained, constructive formalization of the *Fundamental Theorem of
Markov Bases* (Diaconis–Sturmfels) for the **two-way independence model** on integer
contingency tables.

An `m × n` contingency table is a function `u : Fin m → Fin n → ℤ`.  The independence model
fixes all row sums (`rowSum`) and all column sums (`colSum`).  A *fiber* is the set of
non-negative integer tables with prescribed margins.  The classical Markov basis of this model
is the family of **basic `2 × 2` swap moves**

  `basicMove i i' j j' = e_{i,j'} + e_{i',j} - e_{i,j} - e_{i',j'}`   (`i ≠ i'`, `j ≠ j'`),

i.e. the `2 × 2` minor swaps.  We model a single *oriented admissible step* `Step u v` as the
addition of one basic move whose two *subtraction sites* `(i,j)` and `(i',j')` are already at
least `1` in `u`, so that the move keeps the table non-negative.

## Main results (general `m × n` case)

* `basicMove_preserves_rowSums`, `basicMove_preserves_colSums`, `basicMove_preserves_margins`,
  `Step.preserve_margins` — every basic move lies in the kernel of the margin map.
* `sign_rectangle` — for distinct equal-margin tables, a three-stage pigeonhole on `d = v - u`
  (zero total sum → zero row sum → zero column sum) extracts a `2 × 2` rectangle with the sign
  pattern needed to orient a distance-reducing move; the two decremented cells are `≥ 1` in `u`.
* `exists_reducing_step` — any non-negative `u ≠ v` in a fiber admits one admissible `Step`
  toward `v` that stays non-negative, keeps the margins, and strictly decreases the `ℓ¹`
  distance `tdist`.
* `twoWay_fiber_connected` — **Fundamental Theorem of Markov Bases.** Any two non-negative
  tables with equal row and column margins are joined by a walk of admissible basic moves:
  the basic moves connect every fiber.  The proof is strong induction on `(tdist u v).natAbs`.

The full general `m × n` statement is proved; no extra `2 ≤ m`, `2 ≤ n` hypotheses are needed,
since distinctness of the extracted rows/columns is forced by their opposite sign patterns.
-/

namespace MarkovBases.TwoWay

variable {m n : ℕ}

/-- An `m × n` integer contingency table. -/
abbrev Table (m n : ℕ) := Fin m → Fin n → ℤ

/-- The `i`-th row margin (sum over columns). -/
def rowSum (u : Table m n) (i : Fin m) : ℤ := ∑ j, u i j

/-- The `j`-th column margin (sum over rows). -/
def colSum (u : Table m n) (j : Fin n) : ℤ := ∑ i, u i j

/-- Two tables lie in the same fiber of the independence model iff all row sums and all
column sums agree. -/
def SameMargins (u v : Table m n) : Prop :=
  (∀ i, rowSum u i = rowSum v i) ∧ (∀ j, colSum u j = colSum v j)

/-- Non-negativity of a table (membership in a fiber requires non-negative counts). -/
def Nonneg (u : Table m n) : Prop := ∀ i j, 0 ≤ u i j

/-- The basic `2 × 2` swap move `B(i,i',j,j') = e_{i,j'} + e_{i',j} - e_{i,j} - e_{i',j'}`. -/
def basicMove (i i' : Fin m) (j j' : Fin n) : Table m n :=
  fun a b =>
      (if a = i ∧ b = j' then 1 else 0)
    + (if a = i' ∧ b = j then 1 else 0)
    - (if a = i ∧ b = j then 1 else 0)
    - (if a = i' ∧ b = j' then 1 else 0)

/-- A single oriented admissible Markov step: add a basic `2 × 2` move (distinct rows and
columns) whose two subtraction sites `(i,j)` and `(i',j')` are already at least `1` in `u`, so
that `v` stays non-negative wherever `u` is. -/
def Step (u v : Table m n) : Prop :=
  ∃ (i i' : Fin m) (j j' : Fin n), i ≠ i' ∧ j ≠ j' ∧
    1 ≤ u i j ∧ 1 ≤ u i' j' ∧ v = u + basicMove i i' j j'

/-- The `ℓ¹` distance between two tables. -/
def tdist (u v : Table m n) : ℤ := ∑ i, ∑ j, |u i j - v i j|

/-- `tdist` as a single sum over the product index set. -/
theorem tdist_eq_prod (u v : Table m n) :
    tdist u v = ∑ p : Fin m × Fin n, |u p.1 p.2 - v p.1 p.2| := by
  erw [ Finset.sum_product ];
  rfl

/-- Adding a basic move preserves every row margin. -/
theorem basicMove_preserves_rowSums (u : Table m n) (i i' : Fin m) (j j' : Fin n) (k : Fin m) :
    rowSum (u + basicMove i i' j j') k = rowSum u k := by
  unfold rowSum; by_cases hk : k = i <;> by_cases hk' : k = i' <;> simp_all +decide [ Finset.sum_add_distrib ] ;
  · unfold basicMove; aesop;
  · unfold basicMove; simp +decide [ Finset.sum_add_distrib ] ;
    aesop;
  · unfold basicMove; simp +decide [ Finset.sum_add_distrib ] ;
    aesop;
  · unfold basicMove; aesop;

/-- Adding a basic move preserves every column margin. -/
theorem basicMove_preserves_colSums (u : Table m n) (i i' : Fin m) (j j' : Fin n) (k : Fin n) :
    colSum (u + basicMove i i' j j') k = colSum u k := by
  unfold colSum basicMove; simp +decide [ Finset.sum_add_distrib ] ;
  by_cases hi : i = i' <;> by_cases hj : k = j <;> by_cases hk : k = j' <;> simp_all +decide [ Finset.filter_eq' ]

/-- Every basic move lies in the kernel of the margin map: adding it changes no margin. -/
theorem basicMove_preserves_margins (u : Table m n) (i i' : Fin m) (j j' : Fin n) :
    SameMargins u (u + basicMove i i' j j') :=
  ⟨fun k => (basicMove_preserves_rowSums u i i' j j' k).symm,
   fun k => (basicMove_preserves_colSums u i i' j j' k).symm⟩

/-- An admissible step preserves all margins. -/
theorem Step.preserve_margins {u v : Table m n} (h : Step u v) : SameMargins u v := by
  obtain ⟨i, i', j, j', _, _, _, _, rfl⟩ := h
  exact basicMove_preserves_margins u i i' j j'

/-- An admissible step preserves non-negativity. -/
theorem Step.preserve_nonneg {u v : Table m n} (hu : Nonneg u) (h : Step u v) : Nonneg v := by
  rcases h with ⟨ i, i', j, j', hi, hj, h₁, h₂, rfl ⟩;
  intro a b; unfold basicMove; simp +decide [ * ] ; split_ifs <;> simp_all +decide [ Nonneg ] ;
  · linarith [ hu i j' ];
  · linarith [ hu i' j ]

/-- **Sign-rectangle pigeonhole.**  For distinct equal-margin tables there is a `2 × 2`
configuration `(i,i',j,j')` with `i ≠ i'`, `j ≠ j'` and the sign pattern
`v i j < u i j`, `u i j' < v i j'`, `v i' j' < u i' j'`.  Writing `d = v - u`, this says
`d i j < 0`, `d i j' > 0`, `d i' j' < 0`. -/
theorem sign_rectangle (u v : Table m n) (hm : SameMargins u v) (hne : u ≠ v) :
    ∃ (i i' : Fin m) (j j' : Fin n), i ≠ i' ∧ j ≠ j' ∧
      v i j < u i j ∧ u i j' < v i j' ∧ v i' j' < u i' j' := by
  obtain ⟨i, j, h_pos⟩ : ∃ i j, v i j < u i j := by
    by_contra! h; simp_all +decide [ funext_iff, SameMargins ] ;
    obtain ⟨ i, j, hij ⟩ := hne;
    exact hij ( le_antisymm ( h i j ) ( by have := hm.1 i; exact le_of_not_gt fun hi => absurd this ( by { exact ne_of_lt ( Finset.sum_lt_sum ( fun a _ => h i a ) ⟨ j, Finset.mem_univ j, hi ⟩ ) } ) ) );
  obtain ⟨j', h_neg⟩ : ∃ j', u i j' < v i j' := by
    contrapose! h_pos; have := hm.1 i; simp_all +decide [ rowSum ] ;
    exact le_of_not_gt fun h => this.not_gt <| Finset.sum_lt_sum ( fun a _ => by aesop ) ⟨ j, Finset.mem_univ j, h ⟩;
  obtain ⟨i', h_pos'⟩ : ∃ i', v i' j' < u i' j' := by
    by_contra h_contra;
    exact absurd ( hm.2 j' ) ( by { exact ne_of_lt ( Finset.sum_lt_sum ( fun a _ ↦ by aesop ) ⟨ i, Finset.mem_univ _, by aesop ⟩ ) } );
  exact ⟨ i, i', j, j', by rintro rfl; linarith, by rintro rfl; linarith, h_pos, h_neg, h_pos' ⟩

/-- The sign-aligned basic move strictly decreases the `ℓ¹` distance to `v` (by at least `2`,
since three of the four touched cells move toward `v` and only one can move away). -/
theorem tdist_decrease (u v : Table m n) (i i' : Fin m) (j j' : Fin n)
    (hi : i ≠ i') (hj : j ≠ j')
    (h1 : v i j < u i j) (h2 : u i j' < v i j') (h3 : v i' j' < u i' j') :
    tdist (u + basicMove i i' j j') v < tdist u v := by
  convert Int.lt_of_sub_pos _ using 1;
  rw [ tdist_eq_prod, tdist_eq_prod ];
  rw [ ← Finset.sum_sub_distrib ];
  refine' ( lt_of_lt_of_le _ ( Finset.sum_le_sum_of_subset_of_nonneg ( show { ( i, j ), ( i, j' ), ( i', j ), ( i', j' ) } ⊆ Finset.univ from Finset.subset_univ _ ) _ ) );
  · simp +decide [ *, basicMove ];
    grind +qlia;
  · unfold basicMove; aesop;

/-
**One-step reduction.**  From any non-negative `u ≠ v` in the same fiber there is a single
admissible Markov step to a non-negative table with the same margins that is strictly closer
to `v` in `ℓ¹` distance.
-/
theorem exists_reducing_step (u v : Table m n) (hu : Nonneg u) (hv : Nonneg v)
    (hm : SameMargins u v) (hne : u ≠ v) :
    ∃ u', Step u u' ∧ SameMargins u' v ∧ Nonneg u' ∧ tdist u' v < tdist u v := by
  obtain ⟨ i, i', j, j', hi, hj, h1, h2, h3 ⟩ := sign_rectangle u v hm hne;
  refine' ⟨ u + basicMove i i' j j', _, _, _, _ ⟩;
  · exact ⟨ i, i', j, j', hi, hj, by linarith [ hv i j ], by linarith [ hv i' j' ], rfl ⟩;
  · exact ⟨ fun k => by have := basicMove_preserves_rowSums u i i' j j' k; have := hm.1 k; unfold rowSum at *; aesop, fun k => by have := basicMove_preserves_colSums u i i' j j' k; have := hm.2 k; unfold colSum at *; aesop ⟩;
  · exact Step.preserve_nonneg hu ⟨ i, i', j, j', hi, hj, by linarith [ hu i j, hv i j ], by linarith [ hu i' j', hv i' j' ], rfl ⟩;
  · exact tdist_decrease u v i i' j j' hi hj h1 h2 h3

/-
The natural-valued connectivity measure used for strong induction.
-/
private theorem connected_of_measure_le : ∀ (N : ℕ) (u v : Table m n),
    (tdist u v).natAbs ≤ N → Nonneg u → Nonneg v → SameMargins u v →
    Relation.ReflTransGen Step u v := by
  intro N;
  induction' N with N ih;
  · intro u v hN hu hv hm
    have h_eq : u = v := by
      simp_all +decide [ tdist ];
      exact funext fun i => funext fun j => by_contra fun h => absurd hN <| ne_of_gt <| lt_of_lt_of_le ( abs_pos.mpr <| sub_ne_zero.mpr h ) <| Finset.single_le_sum ( fun i _ => Finset.sum_nonneg fun j _ => abs_nonneg <| u i j - v i j ) ( Finset.mem_univ i ) |> le_trans ( Finset.single_le_sum ( fun j _ => abs_nonneg <| u i j - v i j ) ( Finset.mem_univ j ) ) ;
    exact h_eq.symm ▸ Relation.ReflTransGen.refl;
  · intro u v huv hu hv hm
    by_cases huv_eq : u = v;
    · exact huv_eq ▸ Relation.ReflTransGen.refl;
    · obtain ⟨ u', hstep, hm', hu', hlt ⟩ := exists_reducing_step u v hu hv hm huv_eq;
      have hlt_nat : (tdist u' v).natAbs < (tdist u v).natAbs := by
        rw [ ← Int.ofNat_lt, Int.natAbs_of_nonneg, Int.natAbs_of_nonneg ];
        · exact hlt;
        · exact Finset.sum_nonneg fun i _ => Finset.sum_nonneg fun j _ => abs_nonneg _;
        · exact Finset.sum_nonneg fun i _ => Finset.sum_nonneg fun j _ => abs_nonneg _;
      grind +suggestions

/-- **Fundamental Theorem of Markov Bases (two-way independence model).**  Any two non-negative
tables with equal row and column margins are joined by a walk of admissible basic `2 × 2` swap
moves that stays non-negative at every step.  Equivalently, the basic moves form a Markov
basis: they connect every fiber of the independence model. -/
theorem twoWay_fiber_connected (u v : Table m n)
    (hu : Nonneg u) (hv : Nonneg v) (hm : SameMargins u v) :
    Relation.ReflTransGen Step u v :=
  connected_of_measure_le (tdist u v).natAbs u v le_rfl hu hv hm

end MarkovBases.TwoWay