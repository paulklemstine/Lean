import Mathlib

/-! # A parity-glued intermediate proof system on the power ladder

This file works inside the **size-function fragment** of the abstract proof-complexity
*simulation preorder*.  A proof system over a type `F` of formulas (à la Cook–Reckhow)
carries a type of proofs together with a conclusion map and a size function, and one system
**p-simulates** another (`≼`) when it can translate every proof while blowing up the size by
at most a fixed polynomial.  The construction `sysOfSize f` realises a size function `f` as a
proof system (every natural-number "formula" `n` has a single proof of size `f n`), and the
ladder rung `powSystem k := sysOfSize (fun n => 2 ^ (n ^ k))` records the size rate
`2 ^ (n ^ k)`.

For `k ≥ 1` the consecutive rungs satisfy `powSystem k ≺ powSystem (k+1)` because the
exponent jumps from `n ^ k` to `n ^ (k+1)`.  Here we exhibit a system strictly **between**
them.  The witness `interPowSys k` is the *parity-glued* size function

  `interPowSize k n = if Even n then 2 ^ (n ^ (k+1)) else 2 ^ (n ^ k)`,

running the faster upper rate on the even indices and falling back to the slower lower rate
on the odd indices.  It is super-polynomially above the lower rung (the even indices keep the
faster rate, so the lower rung cannot recover it) yet too thin to reach the upper rung (the
odd indices fall back to the slower rate, so it cannot dominate the upper rung): a degree
glued from the two rates prescribed on the two residue classes mod `2`.

## Main results (for `k ≥ 1`)

* `powSystem_simulates_interPow`  : `powSystem k ≼ interPowSys k`
* `interPow_not_simulates_powSystem` : `¬ interPowSys k ≼ powSystem k`
* `powSystem_succ_not_simulates_interPow` : `¬ powSystem (k+1) ≼ interPowSys k`
* `interPow_strictly_between` : `powSystem k < interPowSys k ∧ interPowSys k < powSystem (k+1)`.

The engine is the domination characterisation `simulates_sysOfSize_iff` (which reduces
`sysOfSize f ≼ sysOfSize g` to "`f` is polynomially dominated by `g` pointwise") together
with the uniform super-polynomial gap `pow_pow_succ_gap` between the rungs `2 ^ (n ^ k)` and
`2 ^ (n ^ (k+1))`, available at a witness of *either* parity.
-/

set_option maxHeartbeats 1000000

namespace ProofComplexity

universe u v

/-! ## The abstract simulation preorder (size-function fragment) -/

/-- An abstract proof system over a type `F` of formulas (à la Cook–Reckhow): a type of
proofs, a `concl`usion function recording which formula each proof establishes, and a `size`
function recording its resource cost. -/
structure ProofSystem (F : Type u) where
  /-- The type of proof objects. -/
  Proof : Type v
  /-- The formula a given proof establishes. -/
  concl : Proof → F
  /-- The resource cost (size) of a proof. -/
  size : Proof → ℕ

/-- `S` **p-simulates** `T` (written `S ≼ T`) when there is a translation of `T`-proofs into
`S`-proofs that preserves conclusions and increases the size by at most a fixed polynomial
`c * (· + 1) ^ d`.  This is the Cook–Reckhow notion of polynomial simulation with an explicit
monomial bound; it is the order of the simulation preorder. -/
def Simulates {F : Type u} (S T : ProofSystem.{u, v} F) : Prop :=
  ∃ (t : T.Proof → S.Proof) (c d : ℕ),
    (∀ q, S.concl (t q) = T.concl q) ∧
    (∀ q, S.size (t q) ≤ c * (T.size q + 1) ^ d)

@[inherit_doc] infix:50 " ≼ " => Simulates

/-- The simulation relation is reflexive: the identity translation with the linear bound
`1 * (n + 1) ^ 1 = n + 1` works. -/
theorem simulates_refl {F : Type u} (S : ProofSystem.{u, v} F) : S ≼ S :=
  ⟨id, 1, 1, fun _ => rfl, fun q => by simp⟩

/-- The simulation relation is transitive: composing two translations composes the two
monomial bounds into a single one. -/
theorem simulates_trans {F : Type u} {S T U : ProofSystem.{u, v} F}
    (h1 : S ≼ T) (h2 : T ≼ U) : S ≼ U := by
  obtain ⟨t₁, c₁, d₁, hc₁, hb₁⟩ := h1
  obtain ⟨t₂, c₂, d₂, hc₂, hb₂⟩ := h2
  refine ⟨fun q => t₁ (t₂ q), c₁ * (c₂ + 1) ^ d₁, d₂ * d₁,
    fun q => by rw [hc₁, hc₂], fun q => le_trans (hb₁ _) ?_⟩
  refine le_trans (Nat.mul_le_mul_left _ (Nat.pow_le_pow_left
    (show T.size (t₂ q) + 1 ≤ (c₂ + 1) * (U.size q + 1) ^ d₂ from by
      linarith [hb₂ q, pow_pos (Nat.succ_pos (U.size q)) d₂]) _)) ?_
  rw [mul_pow, pow_mul]; ring_nf; norm_num

/-- The simulation preorder on proof systems. -/
instance {F : Type u} : Preorder (ProofSystem.{u, v} F) where
  le := Simulates
  le_refl := simulates_refl
  le_trans := fun _ _ _ => simulates_trans

/-! ## Size functions as proof systems -/

/-- `sysOfSize f` realises the size rate `f : ℕ → ℕ` as a proof system: the formulas are the
natural numbers, every formula `n` has a single proof (also named `n`), and that proof has
size `f n`. -/
def sysOfSize (f : ℕ → ℕ) : ProofSystem ℕ where
  Proof := ℕ
  concl := id
  size := f

/-- **Domination characterisation.**  `sysOfSize f ≼ sysOfSize g` holds exactly when `f` is
pointwise polynomially dominated by `g`: there are constants `c, d` with
`f n ≤ c * (g n + 1) ^ d` for all `n`.  (Conclusion preservation pins the translation to the
identity, so only the size bound remains.) -/
theorem simulates_sysOfSize_iff (f g : ℕ → ℕ) :
    sysOfSize f ≼ sysOfSize g ↔ ∃ c d : ℕ, ∀ n, f n ≤ c * (g n + 1) ^ d := by
  constructor
  · rintro ⟨t, c, d, hconcl, hsize⟩
    refine ⟨c, d, fun n => ?_⟩
    have htn : t n = n := hconcl n
    have := hsize n
    simpa [sysOfSize, htn] using this
  · rintro ⟨c, d, h⟩
    exact ⟨id, c, d, fun _ => rfl, fun q => by simpa [sysOfSize] using h q⟩

/-- The `k`-th rung of the power ladder: the size rate `2 ^ (n ^ k)`. -/
def powSystem (k : ℕ) : ProofSystem ℕ := sysOfSize (fun n => 2 ^ (n ^ k))

/-! ## A uniform (all-large-`n`) super-polynomial gap -/

/-- **Uniform ladder gap (monomial form).**  For `k ≥ 1` and every exponent `c`, the
inequality `(2 ^ (n ^ k) + 2) ^ c < 2 ^ (n ^ (k + 1))` holds for *all* `n ≥ c + 2`. -/
lemma pow_pow_succ_gap_strong (k : ℕ) (hk : 1 ≤ k) (c : ℕ) :
    ∀ n, c + 2 ≤ n → (2 ^ (n ^ k) + 2) ^ c < 2 ^ (n ^ (k + 1)) := by
  have h_pow : ∀ n, c + 2 ≤ n → (2 ^ (n ^ k) + 2) ^ c ≤ 2 ^ (c * (n ^ k + 1)) := by
    intros n hn; rw [pow_mul']; gcongr
    rw [pow_succ']
    linarith [Nat.pow_le_pow_right (by decide : 1 ≤ 2)
      (show n ^ k ≥ 1 by exact Nat.one_le_pow _ _ (by linarith))]
  refine fun n hn ↦ lt_of_le_of_lt (h_pow n hn) ?_
  gcongr <;> norm_num
  rw [pow_succ']; nlinarith [Nat.pow_le_pow_right (by linarith : 1 ≤ n) hk]

/-- **Uniform ladder gap (general polynomial form).**  For `k ≥ 1` and every pair of
constants `c, d`, the polynomial bound `c * (2 ^ (n ^ k) + 1) ^ d` falls strictly below the
upper rung `2 ^ (n ^ (k + 1))` for all `n ≥ (c + d) + 2`.  This is the precise statement that
the upper rung is *not* polynomially dominated by the lower rung, uniformly in `n`. -/
lemma pow_pow_succ_gap (k : ℕ) (hk : 1 ≤ k) (c d : ℕ) :
    ∀ n, (c + d) + 2 ≤ n → c * (2 ^ (n ^ k) + 1) ^ d < 2 ^ (n ^ (k + 1)) := by
  intro n hn
  have key : c * (2 ^ (n ^ k) + 1) ^ d ≤ (2 ^ (n ^ k) + 2) ^ (c + d) := by
    have hX : 1 ≤ 2 ^ (n ^ k) := Nat.one_le_two_pow
    have h1 : c ≤ (2 ^ (n ^ k) + 2) ^ c := by
      calc c ≤ 2 ^ c := Nat.lt_two_pow_self.le
        _ ≤ (2 ^ (n ^ k) + 2) ^ c := Nat.pow_le_pow_left (by omega) c
    have h2 : (2 ^ (n ^ k) + 1) ^ d ≤ (2 ^ (n ^ k) + 2) ^ d :=
      Nat.pow_le_pow_left (by omega) d
    calc c * (2 ^ (n ^ k) + 1) ^ d
        ≤ (2 ^ (n ^ k) + 2) ^ c * (2 ^ (n ^ k) + 2) ^ d := Nat.mul_le_mul h1 h2
      _ = (2 ^ (n ^ k) + 2) ^ (c + d) := by rw [pow_add]
  exact lt_of_le_of_lt key (pow_pow_succ_gap_strong k hk (c + d) n hn)

/-! ## The parity-glued intermediate system -/

/-- The parity-glued size function: the faster upper rate `2 ^ (n ^ (k+1))` on even `n`, the
slower lower rate `2 ^ (n ^ k)` on odd `n`. -/
def interPowSize (k : ℕ) : ℕ → ℕ := fun n => if Even n then 2 ^ (n ^ (k + 1)) else 2 ^ (n ^ k)

/-- On even inputs the glued size function takes the faster upper rate. -/
lemma interPowSize_even (k n : ℕ) (h : Even n) : interPowSize k n = 2 ^ (n ^ (k + 1)) := by
  simp [interPowSize, h]

/-- On odd inputs the glued size function falls back to the slower lower rate. -/
lemma interPowSize_odd (k n : ℕ) (h : ¬ Even n) : interPowSize k n = 2 ^ (n ^ k) := by
  simp [interPowSize, h]

/-- The lower rate is everywhere `≤` the glued rate. -/
lemma pow_le_interPowSize (k : ℕ) (hk : 1 ≤ k) (n : ℕ) :
    2 ^ (n ^ k) ≤ interPowSize k n := by
  have hexp : n ^ k ≤ n ^ (k + 1) := by
    rcases Nat.eq_zero_or_pos n with hn | hn
    · subst hn; simp [Nat.zero_pow (show 0 < k by omega), Nat.zero_pow (show 0 < k + 1 by omega)]
    · exact Nat.pow_le_pow_right hn (Nat.le_succ k)
  by_cases h : Even n
  · rw [interPowSize_even k n h]; exact Nat.pow_le_pow_right (by norm_num) hexp
  · rw [interPowSize_odd k n h]

/-- The glued rate is everywhere `≤` the upper rate `2 ^ (n ^ (k+1))`. -/
lemma interPowSize_le_pow_succ (k : ℕ) (n : ℕ) :
    interPowSize k n ≤ 2 ^ (n ^ (k + 1)) := by
  by_cases h : Even n
  · rw [interPowSize_even k n h]
  · rw [interPowSize_odd k n h]
    have hn1 : 1 ≤ n := Nat.one_le_iff_ne_zero.mpr (by rintro rfl; exact h (by decide))
    exact Nat.pow_le_pow_right (by norm_num)
      (Nat.pow_le_pow_right hn1 (Nat.le_succ k))

/-- The parity-glued intermediate system: size `2 ^ (n ^ (k+1))` on even `n`, size
`2 ^ (n ^ k)` on odd `n`. -/
def interPowSys (k : ℕ) : ProofSystem ℕ := sysOfSize (interPowSize k)

/-! ## The three core simulation facts -/

/-- **Lower rung simulates the glued system.**  Since the glued rate dominates the lower rate
pointwise, `powSystem k ≼ interPowSys k`. -/
theorem powSystem_simulates_interPow (k : ℕ) (hk : 1 ≤ k) :
    powSystem k ≼ interPowSys k := by
  rw [powSystem, interPowSys, simulates_sysOfSize_iff]
  exact ⟨1, 1, fun n => by
    have := pow_le_interPowSize k hk n
    simpa using this.trans (Nat.le_succ _)⟩

/-- **The glued system is not simulated by the lower rung.**  Restricting the assumed
polynomial domination to large *even* indices, where the glued rate equals the upper rate,
contradicts the uniform gap `pow_pow_succ_gap`. -/
theorem interPow_not_simulates_powSystem (k : ℕ) (hk : 1 ≤ k) :
    ¬ interPowSys k ≼ powSystem k := by
  rw [interPowSys, powSystem, simulates_sysOfSize_iff]
  rintro ⟨c, d, h⟩
  set n := 2 * ((c + d) + 2) with hn
  have hne : Even n := ⟨(c + d) + 2, by rw [hn]; ring⟩
  have hge : (c + d) + 2 ≤ n := by omega
  have h1 : 2 ^ (n ^ (k + 1)) ≤ c * (2 ^ (n ^ k) + 1) ^ d := by
    have := h n; rwa [interPowSize_even k n hne] at this
  exact absurd h1 (not_le.mpr (pow_pow_succ_gap k hk c d n hge))

/-- **The upper rung is not simulated by the glued system.**  Restricting the assumed
polynomial domination to large *odd* indices, where the glued rate drops to the lower rate,
contradicts the uniform gap `pow_pow_succ_gap`. -/
theorem powSystem_succ_not_simulates_interPow (k : ℕ) (hk : 1 ≤ k) :
    ¬ powSystem (k + 1) ≼ interPowSys k := by
  rw [powSystem, interPowSys, simulates_sysOfSize_iff]
  rintro ⟨c, d, h⟩
  set n := 2 * ((c + d) + 2) + 1 with hn
  have hno : ¬ Even n := by rw [hn]; simp [parity_simps]
  have hge : (c + d) + 2 ≤ n := by omega
  have h1 : 2 ^ (n ^ (k + 1)) ≤ c * (2 ^ (n ^ k) + 1) ^ d := by
    have := h n; rwa [interPowSize_odd k n hno] at this
  exact absurd h1 (not_le.mpr (pow_pow_succ_gap k hk c d n hge))

/-! ## Density at every rung -/

/-- **The glued system simulates the upper rung.**  Since the glued rate is dominated by the
upper rate pointwise, `interPowSys k ≼ powSystem (k+1)`. -/
theorem interPow_simulates_powSystem_succ (k : ℕ) :
    interPowSys k ≼ powSystem (k + 1) := by
  rw [interPowSys, powSystem, simulates_sysOfSize_iff]
  exact ⟨1, 1, fun n => by
    have := interPowSize_le_pow_succ k n
    simpa using this.trans (Nat.le_succ _)⟩

/-- **Strict betweenness in the simulation preorder.**  For every `k ≥ 1`, the glued system
`interPowSys k` lies strictly between the consecutive ladder rungs:
`powSystem k < interPowSys k < powSystem (k+1)`. -/
theorem interPow_strictly_between (k : ℕ) (hk : 1 ≤ k) :
    powSystem k < interPowSys k ∧ interPowSys k < powSystem (k + 1) :=
  ⟨⟨powSystem_simulates_interPow k hk, interPow_not_simulates_powSystem k hk⟩,
   ⟨interPow_simulates_powSystem_succ k, powSystem_succ_not_simulates_interPow k hk⟩⟩

end ProofComplexity
