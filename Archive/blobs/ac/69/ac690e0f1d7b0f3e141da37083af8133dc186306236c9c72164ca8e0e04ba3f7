import Applications.UnifiedRankOfApparition

/-! # Primitive prime divisors at prime indices for strong divisibility sequences

Domain: Combinatorics / Number Theory (cross-domain unification).

This file *generalizes the prime-index case of Carmichael's primitive-divisor theorem*
from the Fibonacci sequence to **every** strong divisibility sequence `u` normalized by
`u 1 = 1`, using the generic rank-of-apparition engine already developed in the catalog
file `Applications.UnifiedRankOfApparition` (`IsStrongDivSeq`, `rank`, `HasRank`,
`rank_dvd_iff`, `rank_min`, `dvd_rank`, and the instances `fib_isStrongDivSeq`,
`mersenne_isStrongDivSeq`).

The catalog already proved the *value biconditional* `value_dvd_iff` (`u a ∣ u b ↔ a ∣ b`)
generically.  Here we extract the orthogonal *existence-of-primitive-divisor* phenomenon:
for prime index `p`, **some prime divides `u p` and divides no earlier term**.  The single
abstract theorem `sds_primitive_divisor_prime` then instantiates simultaneously to:

* `fib_primitive_at_prime`     — the Fibonacci/Carmichael prime case (cf.
  `Shared.CarmichaelHelper.fib_primitive_divisor_prime`, here re-derived from the engine);
* `mersenne_primitive_at_prime` — *Bang's theorem at prime exponents*: every Mersenne number
  `2^p − 1` (`p` prime) has a primitive prime divisor — a genuinely cross-domain corollary
  obtained from the *same* one-line engine call.

We additionally prove the sharp *apparition characterization* `sds_primitive_divisor_apparition`:
the primitive prime `q` has apparition set exactly the multiples of `p` (`q ∣ u n ↔ p ∣ n`).

-- !-- Lab Notebook -- !--
Hypothesis : The "every prime divisor of a prime-index term is primitive" miracle that
  makes Carmichael's prime case trivial is not special to Fibonacci — it is a property of
  any strong divisibility sequence with `u 1 = 1`, because then `rank q ∣ p` and `rank q ≠ 1`
  (else `q ∣ u 1 = 1`) force `rank q = p`.
Result     : Confirmed, `sorry = 0`.  One abstract theorem (`sds_primitive_divisor_prime`)
  yields both the Fibonacci and the Mersenne primitive-divisor theorems at prime index.
Insight    : The load-bearing hypothesis is `u 1 = 1` (the sequence is "primitive at 1"),
  NOT anything Fibonacci-specific.  Both `Nat.fib` and `2^· − 1` satisfy it, which is exactly
  why the two classical theorems are facets of one truth; the engine's spine `rank_dvd_iff`
  does all the work.
Failure analysis : The composite-index case genuinely fails this miracle — a prime divisor
  of `u (m·k)` can have rank a proper divisor of `m·k` — which is precisely the obstruction
  that forces `CarmichaelComposite` to strip `u d` for proper `d`, and why the composite
  infinite tail (`Shared.CarmichaelProof`) remains open (see FUTURE_DIRECTIONS.md).
-- !--
-/

open UnifiedRank

/-- **Generic Carmichael prime case.** For a strong divisibility sequence `u` with `u 1 = 1`,
every prime index `p` with `u p > 1` admits a *primitive* prime divisor: a prime `q ∣ u p`
that divides no earlier term `u k` (`0 < k < p`). -/
-- !-- Pick a prime `q ∣ u p`; its rank divides the prime `p` and is `≠ 1` (else `q ∣ u 1 = 1`),
--     so `rank q = p`, and `rank_min` kills all `k < p`. -- !--
theorem sds_primitive_divisor_prime {u : ℕ → ℕ} (hu : IsStrongDivSeq u)
    (h1 : u 1 = 1) {p : ℕ} (hp : Nat.Prime p) (hup : 1 < u p) :
    ∃ q, Nat.Prime q ∧ q ∣ u p ∧ ∀ k, 0 < k → k < p → ¬(q ∣ u k) := by
  obtain ⟨q, hq, hqp⟩ := Nat.exists_prime_and_dvd (n := u p) (by omega)
  have hpos : 0 < p := hp.pos
  have hhas : HasRank u q := ⟨p, hpos, hqp⟩
  have hdvd : rank u q ∣ p := (rank_dvd_iff hu hhas p).1 hqp
  have hne1 : rank u q ≠ 1 := by
    intro h
    have : q ∣ u 1 := by
      have := dvd_rank hhas; rwa [h] at this
    rw [h1] at this
    exact hq.one_lt.ne' (Nat.eq_one_of_dvd_one this)
  have heq : rank u q = p := ((Nat.dvd_prime hp).1 hdvd).resolve_left hne1
  refine ⟨q, hq, hqp, ?_⟩
  intro k hk hkp
  have hlt : k < rank u q := by rw [heq]; exact hkp
  exact rank_min hk hlt

/-- **Apparition characterization (sharp form).** The primitive prime `q` of `u p` has
apparition set exactly the multiples of `p`: `q ∣ u n ↔ p ∣ n` for all `n`. -/
-- !-- Same construction as `sds_primitive_divisor_prime`, but conclude via the engine spine
--     `rank_dvd_iff` rewritten through `rank q = p`. -- !--
theorem sds_primitive_divisor_apparition {u : ℕ → ℕ} (hu : IsStrongDivSeq u)
    (h1 : u 1 = 1) {p : ℕ} (hp : Nat.Prime p) (hup : 1 < u p) :
    ∃ q, Nat.Prime q ∧ q ∣ u p ∧ ∀ n, q ∣ u n ↔ p ∣ n := by
  obtain ⟨q, hq, hqp⟩ := Nat.exists_prime_and_dvd (n := u p) (by omega)
  have hhas : HasRank u q := ⟨p, hp.pos, hqp⟩
  have hdvd : rank u q ∣ p := (rank_dvd_iff hu hhas p).1 hqp
  have hne1 : rank u q ≠ 1 := by
    intro h
    have : q ∣ u 1 := by have := dvd_rank hhas; rwa [h] at this
    rw [h1] at this; exact hq.one_lt.ne' (Nat.eq_one_of_dvd_one this)
  have heq : rank u q = p := ((Nat.dvd_prime hp).1 hdvd).resolve_left hne1
  refine ⟨q, hq, hqp, fun n => ?_⟩
  rw [rank_dvd_iff hu hhas n, heq]

/-- **Fibonacci / Carmichael, prime case (via the generic engine).** For prime `p ≥ 3`,
`F p` has a primitive prime divisor. -/
-- !-- Instance of `sds_primitive_divisor_prime` with `u = Nat.fib`, `u 1 = F 1 = 1`,
--     and `F p ≥ F 3 = 2 > 1` from monotonicity. -- !--
theorem fib_primitive_at_prime {p : ℕ} (hp : Nat.Prime p) (hpge : 3 ≤ p) :
    ∃ q, Nat.Prime q ∧ q ∣ Nat.fib p ∧ ∀ k, 0 < k → k < p → ¬(q ∣ Nat.fib k) := by
  apply sds_primitive_divisor_prime fib_isStrongDivSeq (by decide) hp
  have h1 : Nat.fib 3 ≤ Nat.fib p := Nat.fib_mono hpge
  have h2 : Nat.fib 3 = 2 := by decide
  omega

/-- **Bang's theorem at prime exponents (via the generic engine).** For every prime `p`,
the Mersenne number `2^p − 1` has a primitive prime divisor — a prime dividing `2^p − 1`
but no smaller `2^k − 1`. -/
-- !-- Instance of `sds_primitive_divisor_prime` with `u = (2^· − 1)`, `u 1 = 1`,
--     and `2^p − 1 ≥ 2^2 − 1 = 3 > 1`. -- !--
theorem mersenne_primitive_at_prime {p : ℕ} (hp : Nat.Prime p) :
    ∃ q, Nat.Prime q ∧ q ∣ (2 ^ p - 1) ∧ ∀ k, 0 < k → k < p → ¬(q ∣ (2 ^ k - 1)) := by
  have key := sds_primitive_divisor_prime (u := fun n => 2 ^ n - 1)
    (mersenne_isStrongDivSeq 2) (by decide) hp ?_
  · simpa using key
  · have h4 : 4 ≤ 2 ^ p := by
      calc (4 : ℕ) = 2 ^ 2 := by norm_num
        _ ≤ 2 ^ p := Nat.pow_le_pow_right (by norm_num) hp.two_le
    simp only []; omega
