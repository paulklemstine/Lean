import Applications.UnifiedRankOfApparition

/-! # Primitive prime divisors at **arbitrary** indices for strong divisibility sequences

Domain: Number Theory / Combinatorics (cross-domain unification).

The catalog already contains:

* the *prime-index* primitive-divisor miracle, generically, in
  `Speculative.AutoResearch.PrimitiveDivisorEntryLaw`
  (`sds_primitive_divisor_prime`): for prime `p`, *every* prime divisor of `u p` is
  primitive; and
* the *Fibonacci-specific, composite-index* engine in
  `Speculative.AutoResearch.CarmichaelComposite`
  (`primitive_of_not_dvd_proper_divisors`, `primitive_of_fibCoprimePart_pos`), which is
  tied to `Nat.fib` through the concrete entry-point lemmas.

This file unifies and sharpens the composite-index theory by lifting it to the abstract
rank engine `UnifiedRank` (`rank`, `HasRank`, `rank_dvd_iff`, `rank_min`, `dvd_rank`,
`rank_pos`).  The single load-bearing observation is the **rank characterization of
primitivity**:

> a prime `q ∣ u n` is a *primitive* divisor of `u n`  ⟺  `rank u q = n`.

Strikingly, this characterization, the uniqueness of the birth index, and the
existence/`rank`-reformulation need **no hypothesis on `u` whatsoever** — they are facts
about the rank function alone (`rank_min`, `dvd_rank`).  Only the *proper-divisor reduction*
`isPrimitiveDivisor_iff_not_proper` (and the classical instances) invoke the gcd-meet law
`IsStrongDivSeq`, precisely where the strong-divisibility structure is genuinely used.

* `isPrimitiveDivisor_iff_rank`        — the characterization itself (hypothesis-free);
* `rank_of_isPrimitiveDivisor`         — the birth index of a primitive prime is its rank;
* `isPrimitiveDivisor_iff_not_proper`  — primitivity ⟺ avoiding *proper-divisor* terms
  (the right generalization of `CarmichaelComposite.primitive_of_not_dvd_proper_divisors`,
  now a biconditional valid for every SDS);
* `hasPrimitiveDivisor_of_prime_not_proper` — the existence form used by Carmichael;
* `isPrimitiveDivisor_unique_index`    — a prime is primitive for **at most one** index,
  so `q ↦ rank u q` tags primitive divisors by their birth index;
* `hasPrimitiveDivisor_iff_exists_rank` — existence of a primitive divisor at `n` ⟺ some
  prime has rank exactly `n`.

Two classical theories are then *instances of one engine*: the Fibonacci composite case
(`fib_hasPrimitiveDivisor_of_not_proper`) and the Mersenne / `aⁿ−1` composite case
(`mersenne_hasPrimitiveDivisor_of_not_proper`) — Bang/Zsygmondy at composite exponents,
reduced to the same proper-divisor avoidance condition.

-- !-- Lab Notebook -- !--
Hypothesis : The entire composite-index primitive-divisor theory of Carmichael is not
  Fibonacci-specific; it is a statement about the rank function of *any* sequence, with
  primitivity being *exactly* the equation `rank u q = n`.
Result     : Confirmed, `sorry = 0`.  Eight generic theorems; the rank characterization,
  uniqueness, and existence reformulation are *hypothesis-free*, while the proper-divisor
  reduction and the Fibonacci/Mersenne instances run on `IsStrongDivSeq` (via the spine
  `rank_dvd_iff` / meet law).
Insight    : Primitivity = "rank equals index", and this needs nothing about `u`.  The
  proper-divisor avoidance test used by the computational Carmichael verifier
  (`fibCoprimePart`) is *equivalent* to primitivity because any earlier hit `q ∣ u k`
  (`k < n`) factors through `rank u q`, which is then a *proper divisor* of `n`
  (`rank u q ∣ n`, `rank u q ≤ k < n`); reducing the strong-divisibility step to a single
  `gcd` is where `IsStrongDivSeq` enters.  So one never needs to test all `k < n`, only the
  divisors of `n` — the structural content of Carmichael's reduction.
Failure analysis : The *existence* of such a primitive `q` for composite `n` (the open
  infinite tail in `Shared.CarmichaelProof`) is NOT supplied here and genuinely requires a
  size/cyclotomic argument; `hasPrimitiveDivisor_iff_exists_rank` isolates exactly that
  missing existential.  Dropping the primality of `q` breaks `isPrimitiveDivisor_unique_index`
  (a composite modulus can have several ranks' worth of factors), confirming primality is
  load-bearing there; and dropping `IsStrongDivSeq` breaks `isPrimitiveDivisor_iff_not_proper`
  (the `gcd`-meet step), confirming the meet law is load-bearing exactly there.
-- !--
-/

open UnifiedRank

namespace PrimitiveComposite

/-- `q` is a **primitive prime divisor** of `u n`: a prime dividing `u n` but dividing no
earlier positive-index term `u k` (`0 < k < n`). -/
def IsPrimitiveDivisor (u : ℕ → ℕ) (q n : ℕ) : Prop :=
  Nat.Prime q ∧ q ∣ u n ∧ ∀ k, 0 < k → k < n → ¬ q ∣ u k

/-- `u n` *has a primitive divisor* if some prime is primitive for it. -/
def HasPrimitiveDivisor (u : ℕ → ℕ) (n : ℕ) : Prop := ∃ q, IsPrimitiveDivisor u q n

/-! ## §1. The rank characterization of primitivity -/

-- !-- Primitivity equals "rank = index": forward, the rank is a divisor of `n` that, if
--     proper, would be an earlier hit contradicting primitivity; backward, `rank_min`.
--     No hypothesis on `u` is needed — pure rank arithmetic. -- !--
theorem isPrimitiveDivisor_iff_rank {u : ℕ → ℕ} {q n : ℕ}
    (hn : 0 < n) (hq : Nat.Prime q) (hqn : q ∣ u n) :
    IsPrimitiveDivisor u q n ↔ rank u q = n := by
  constructor
  · rintro ⟨ hq, hqn, hmin ⟩
    unfold rank
    split_ifs <;> simp_all +decide [ Nat.find_eq_iff ]
  · intro h
    exact ⟨ hq, hqn, fun k hk hk' => by have := rank_min hk ( by linarith ) ; aesop ⟩

-- !-- The rank of a primitive prime divisor is its birth index (forward direction). -- !--
theorem rank_of_isPrimitiveDivisor {u : ℕ → ℕ} {q n : ℕ}
    (hn : 0 < n) (h : IsPrimitiveDivisor u q n) : rank u q = n :=
  (isPrimitiveDivisor_iff_rank hn h.1 h.2.1).1 h

/-! ## §2. Primitivity ⟺ avoiding proper-divisor terms -/

-- !-- Any earlier hit `q ∣ u k` (`0 < k < n`) factors through `rank u q`, a *proper divisor*
--     of `n`; here the `gcd`-meet law `IsStrongDivSeq` collapses the step, so testing all
--     `k < n` reduces to testing divisors of `n`. -- !--
theorem isPrimitiveDivisor_iff_not_proper {u : ℕ → ℕ} (hu : IsStrongDivSeq u) {q n : ℕ}
    (hn : 0 < n) (hq : Nat.Prime q) (hqn : q ∣ u n) :
    IsPrimitiveDivisor u q n ↔ ∀ d, d ∣ n → 0 < d → d < n → ¬ q ∣ u d := by
  constructor
  · exact fun h d _ hd' hd'' => h.2.2 d hd' hd''
  · intro h
    refine' ⟨ hq, hqn, fun k hk₁ hk₂ => _ ⟩
    contrapose! h
    refine' ⟨ Nat.gcd n k, Nat.gcd_dvd_left _ _, _, _, _ ⟩
    · positivity
    · exact lt_of_le_of_lt ( Nat.le_of_dvd hk₁ ( Nat.gcd_dvd_right _ _ ) ) hk₂
    · exact hu n k ▸ Nat.dvd_gcd hqn h

/-- **Existence form (Carmichael reduction).** A prime `q ∣ u n` that avoids every
*proper-divisor* term `u d` (`d ∣ n`, `0 < d < n`) is automatically a primitive divisor,
so `u n` has a primitive divisor.  This is the generic engine behind
`CarmichaelComposite.primitive_of_not_dvd_proper_divisors`. -/
-- !-- Immediate from `isPrimitiveDivisor_iff_not_proper`. -- !--
theorem hasPrimitiveDivisor_of_prime_not_proper {u : ℕ → ℕ} (hu : IsStrongDivSeq u) {q n : ℕ}
    (hn : 0 < n) (hq : Nat.Prime q) (hqn : q ∣ u n)
    (hnd : ∀ d, d ∣ n → 0 < d → d < n → ¬ q ∣ u d) :
    HasPrimitiveDivisor u n :=
  ⟨ q, (isPrimitiveDivisor_iff_not_proper hu hn hq hqn).2 hnd ⟩

/-! ## §3. Primitive divisors are tagged by a unique index -/

-- !-- Both indices equal `rank u q`, hence each other. -- !--
theorem isPrimitiveDivisor_unique_index {u : ℕ → ℕ} {q m n : ℕ}
    (hm : 0 < m) (hn : 0 < n)
    (h1 : IsPrimitiveDivisor u q m) (h2 : IsPrimitiveDivisor u q n) : m = n := by
  rw [ ← rank_of_isPrimitiveDivisor hm h1, ← rank_of_isPrimitiveDivisor hn h2 ]

/-! ## §4. Existence of a primitive divisor ⟺ a prime of rank exactly `n` -/

-- !-- A primitive divisor at `n` is, via the characterization, exactly a prime of rank `n`;
--     conversely a prime of rank `n` is primitive at `n` (`dvd_rank` + `rank_min`). -- !--
theorem hasPrimitiveDivisor_iff_exists_rank {u : ℕ → ℕ} {n : ℕ} (hn : 0 < n) :
    HasPrimitiveDivisor u n ↔ ∃ q, Nat.Prime q ∧ rank u q = n := by
  constructor
  · rintro ⟨ q, hq ⟩
    exact ⟨ q, hq.1, rank_of_isPrimitiveDivisor hn hq ⟩
  · simp +zetaDelta at *
    intro q hq hqn
    use q
    apply (isPrimitiveDivisor_iff_rank hn hq (by
      unfold rank at hqn
      split_ifs at hqn <;> simp_all +decide [ Nat.find_eq_iff ])).mpr hqn

/-! ## §5. Instance I — Fibonacci (composite Carmichael reduction) -/

-- !-- `Nat.fib` is an SDS by `Nat.fib_gcd`; instantiate the generic existence form. -- !--
theorem fib_hasPrimitiveDivisor_of_not_proper {n : ℕ} (hn : 0 < n) {q : ℕ}
    (hq : Nat.Prime q) (hqn : q ∣ Nat.fib n)
    (hnd : ∀ d, d ∣ n → 0 < d → d < n → ¬ q ∣ Nat.fib d) :
    HasPrimitiveDivisor Nat.fib n :=
  hasPrimitiveDivisor_of_prime_not_proper fib_isStrongDivSeq hn hq hqn hnd

/-! ## §6. Instance II — Mersenne / `aⁿ − 1` (Bang/Zsygmondy reduction, cross-domain) -/

-- !-- `n ↦ aⁿ − 1` is an SDS (`mersenne_isStrongDivSeq`); same one-line reduction. -- !--
theorem mersenne_hasPrimitiveDivisor_of_not_proper {a n : ℕ} (hn : 0 < n) {q : ℕ}
    (hq : Nat.Prime q) (hqn : q ∣ a ^ n - 1)
    (hnd : ∀ d, d ∣ n → 0 < d → d < n → ¬ q ∣ a ^ d - 1) :
    HasPrimitiveDivisor (fun k => a ^ k - 1) n :=
  hasPrimitiveDivisor_of_prime_not_proper (mersenne_isStrongDivSeq a) hn hq hqn hnd

end PrimitiveComposite
