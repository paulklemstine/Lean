/-
# Strict density between consecutive power-growth systems

This file proves a strict density theorem for a small, self-contained ladder of
*size systems*, using the **polynomial-profile** formulation (formulation 1).

## Semantics chosen

A size system is just a size profile `ℕ → ℕ`:

* `powProfile k n   := n ^ k`
* `interProfile k n := if n % 2 = 0 then n ^ (k + 1) else n ^ k`

i.e. the intermediate system glues `n ^ (k+1)` on the even residue class and
`n ^ k` on the odd residue class.

The order on systems is **eventual domination up to a multiplicative constant**:
`Dominates f g` means `∃ C, ∀ n, f n ≤ C * g n`, and a system `S` is below a
system `T` (`S ≤ T`) exactly when `T.profile` dominates `S.profile`.  Strict
order `S < T` is `S ≤ T ∧ ¬ T ≤ S`.

## Results proved

For every `k ≥ 1`:

* `powSystem k < interPowSys k`
* `interPowSys k < powSystem (k + 1)`

packaged as

* `exists_strictly_between_powSystem :
     ∀ k ≥ 1, ∃ T, powSystem k < T ∧ T < powSystem (k + 1)`.

The two non-domination halves are witnessed by parity-restricted families: the
even sequence `2*m` breaks `interPowSys k ≤ powSystem k`, and the odd sequence
`2*m+1` breaks `powSystem (k+1) ≤ interPowSys k`.  These are the parity gap
lemmas `interProfile_even_unbounded` and `powProfile_odd_unbounded`.
-/

import Mathlib

namespace LadderDensity

/-- A size system is determined by a single size profile `ℕ → ℕ`. -/
structure SizeSys where
  profile : ℕ → ℕ

/-- `Dominates f g` : `f` is dominated by `g` up to a multiplicative constant,
i.e. there is a constant `C` with `f n ≤ C * g n` for all `n`. -/
def Dominates (f g : ℕ → ℕ) : Prop := ∃ C : ℕ, ∀ n, f n ≤ C * g n

/-
Domination is reflexive (take `C = 1`).
-/
theorem Dominates.refl (f : ℕ → ℕ) : Dominates f f := by
  exact ⟨ 1, fun n => by simp +decide ⟩

/-
Domination is transitive (multiply the two constants).
-/
theorem Dominates.trans {f g h : ℕ → ℕ}
    (hfg : Dominates f g) (hgh : Dominates g h) : Dominates f h := by
      exact ⟨ hfg.choose * hgh.choose, fun n => by nlinarith [ hfg.choose_spec n, hgh.choose_spec n ] ⟩

/-- Order on systems: `S ≤ T` iff `T`'s profile dominates `S`'s profile. -/
instance : LE SizeSys := ⟨fun S T => Dominates S.profile T.profile⟩

/-- Strict order on systems. -/
instance : LT SizeSys := ⟨fun S T => S ≤ T ∧ ¬ T ≤ S⟩

/-- Characterization: system comparison is profile domination, by definition. -/
theorem sysLE_iff (S T : SizeSys) : S ≤ T ↔ Dominates S.profile T.profile := Iff.rfl

/-- Characterization of strict system comparison. -/
theorem sysLT_iff (S T : SizeSys) :
    S < T ↔ (Dominates S.profile T.profile ∧ ¬ Dominates T.profile S.profile) := Iff.rfl

/-- Pure power profile `n ↦ n ^ k`. -/
def powProfile (k n : ℕ) : ℕ := n ^ k

/-- Parity-glued intermediate profile: `n ^ (k+1)` on evens, `n ^ k` on odds. -/
def interProfile (k n : ℕ) : ℕ := if n % 2 = 0 then n ^ (k + 1) else n ^ k

/-- The pure power system of degree `k`. -/
def powSystem (k : ℕ) : SizeSys := ⟨powProfile k⟩

/-- The parity-glued intermediate system between degrees `k` and `k+1`. -/
def interPowSys (k : ℕ) : SizeSys := ⟨interProfile k⟩

/-! ### Positive (domination) directions -/

/-
`powProfile k` is dominated by `interProfile k` (with constant `1`),
provided `k ≥ 1`.
-/
theorem powProfile_le_interProfile (k : ℕ) (hk : 1 ≤ k) :
    Dominates (powProfile k) (interProfile k) := by
      use 1; intro n; rcases Nat.eq_zero_or_pos n with rfl | hn; simp +decide [ powProfile, interProfile ] ;
      · linarith;
      · unfold powProfile interProfile; split_ifs <;> simp_all +decide [ Nat.pow_succ' ] ;
        linarith

/-
`interProfile k` is dominated by `powProfile (k+1)` (with constant `1`).
-/
theorem interProfile_le_powProfile_succ (k : ℕ) :
    Dominates (interProfile k) (powProfile (k + 1)) := by
      use 1; intro n; rcases Nat.mod_two_eq_zero_or_one n with hn|hn <;> simp +decide [ hn, powProfile, interProfile ] ; (
      exact Nat.pow_le_pow_right ( Nat.pos_of_ne_zero ( by aesop_cat ) ) ( Nat.le_succ _ ))

/-! ### Parity gap lemmas (non-domination directions) -/

/-
**Even parity gap.** For every constant `C` the inequality
`interProfile k n ≤ C * powProfile k n` fails at a sufficiently large *even*
argument `n = 2*m`.
-/
theorem interProfile_even_unbounded (k C : ℕ) :
    ∃ m, C * powProfile k (2 * m) < interProfile k (2 * m) := by
      unfold powProfile interProfile; norm_num;
      exact ⟨ C + 1, by rw [ pow_succ' ] ; nlinarith [ pow_pos ( by linarith : 0 < 2 * ( C + 1 ) ) k ] ⟩

/-
**Odd parity gap.** For every constant `C` the inequality
`powProfile (k+1) n ≤ C * interProfile k n` fails at a sufficiently large *odd*
argument `n = 2*m+1`.
-/
theorem powProfile_odd_unbounded (k C : ℕ) :
    ∃ m, C * interProfile k (2 * m + 1) < powProfile (k + 1) (2 * m + 1) := by
      refine' ⟨ C, _ ⟩ ; ring_nf;
      unfold interProfile powProfile;
      norm_num [ pow_add ] ; nlinarith [ pow_pos ( by linarith : 0 < 1 + C * 2 ) k ]

/-
`interProfile k` is **not** dominated by `powProfile k`: witnessed on the
even residue class.
-/
theorem not_interProfile_le_powProfile (k : ℕ) :
    ¬ Dominates (interProfile k) (powProfile k) := by
      intro h
      obtain ⟨C, hC⟩ := h
      have := interProfile_even_unbounded k C
      obtain ⟨m, hm⟩ := this
      have := hC (2 * m)
      linarith! [this]

/-
`powProfile (k+1)` is **not** dominated by `interProfile k`: witnessed on the
odd residue class.
-/
theorem not_powProfile_succ_le_interProfile (k : ℕ) :
    ¬ Dominates (powProfile (k + 1)) (interProfile k) := by
      exact fun ⟨ C, hC ⟩ => by obtain ⟨ m, hm ⟩ := powProfile_odd_unbounded k C; linarith [ hC ( 2 * m + 1 ) ] ;

/-! ### The strict density theorem -/

/-
`powSystem k < interPowSys k` for `k ≥ 1`.
-/
theorem powSystem_lt_interPowSys (k : ℕ) (hk : 1 ≤ k) :
    powSystem k < interPowSys k := by
      exact ⟨ powProfile_le_interProfile k hk, not_interProfile_le_powProfile k ⟩

/-
`interPowSys k < powSystem (k+1)` for `k ≥ 1`.

The hypothesis `hk : 1 ≤ k` is kept to match the stated `k ≥ 1` ladder setting
requested in the target theorem; this particular direction in fact holds for all
`k`, so `hk` is unused in the proof.
-/
theorem interPowSys_lt_powSystem_succ (k : ℕ) (hk : 1 ≤ k) :
    interPowSys k < powSystem (k + 1) :=
  ⟨interProfile_le_powProfile_succ k, not_powProfile_succ_le_interProfile k⟩

/-
**Strict density.** For every `k ≥ 1` there is a system strictly between
`powSystem k` and `powSystem (k+1)`.
-/
theorem exists_strictly_between_powSystem :
    ∀ k, 1 ≤ k → ∃ T : SizeSys, powSystem k < T ∧ T < powSystem (k + 1) := by
      intro k hk; use interPowSys k; exact ⟨ powSystem_lt_interPowSys k hk, interPowSys_lt_powSystem_succ k hk ⟩ ;

end LadderDensity