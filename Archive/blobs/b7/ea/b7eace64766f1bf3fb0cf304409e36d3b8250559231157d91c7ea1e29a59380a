import Mathlib

/-! # Korselt arithmetic bridge for Carmichael numbers

This file completes the *arithmetic bridge* used in Korselt's criterion for Carmichael
numbers, staying entirely inside the shared number-theory / algebra setting (no cryptography
scaffolding).

The classical statement of the bridge is:

> If `n` is squarefree and satisfies the universal Fermat/unit condition at modulus `n`
> (every unit `a : (ZMod n)ˣ` satisfies `a ^ (n - 1) = 1`), then for every prime `p ∣ n`
> one has `(p - 1) ∣ (n - 1)`.

We expose the proof as a short pipeline of clearly named lemmas:

`universal power condition on (ZMod n)ˣ`
  → `order divisibility` (`forall_orderOf_dvd_of_forall_pow_eq_one`)
  → `lift/reduce to (ZMod p)ˣ` (`orderOf_dvd_of_dvd_modulus`, via `ZMod.unitsMap_surjective`)
  → `(p - 1) ∣ (n - 1)` (`prime_sub_one_dvd_of_forall_pow_eq_one`)

The element of order `p - 1` in `(ZMod p)ˣ` comes from the cyclicity of the unit group of a
finite field (`exists_orderOf_eq_prime_sub_one`).

All proofs are complete (no `sorry`) and depend only on standard `Mathlib` machinery.
-/

namespace KorseltBridge

open scoped Classical

variable {n : ℕ}

/-! ## Step 1 — the group-theoretic order bridge on `(ZMod n)ˣ` -/

/-- **Order bridge (single element).** In any monoid, `a ^ (n - 1) = 1` forces
`orderOf a ∣ (n - 1)`. This is the elementary finite-group fact underlying the whole
argument; it is just `orderOf_dvd_of_pow_eq_one` specialised to the exponent `n - 1`. -/
lemma orderOf_dvd_of_pow_pred_eq_one {G : Type*} [Monoid G] {a : G}
    (h : a ^ (n - 1) = 1) : orderOf a ∣ (n - 1) :=
  orderOf_dvd_of_pow_eq_one h

/-- **Order bridge (universal).** If *every* unit modulo `n` satisfies the Fermat power
equation `a ^ (n - 1) = 1`, then *every* unit's order divides `n - 1`. -/
lemma forall_orderOf_dvd_of_forall_pow_eq_one
    (h : ∀ a : (ZMod n)ˣ, a ^ (n - 1) = 1) :
    ∀ a : (ZMod n)ˣ, orderOf a ∣ (n - 1) :=
  fun a => orderOf_dvd_of_pow_eq_one (h a)

/-! ## Step 2 — a generator of the prime unit group -/

/-- **Generator of the prime unit group.** For a prime `p`, the group `(ZMod p)ˣ` is the
unit group of the finite field `ZMod p`, hence cyclic, and has cardinality `p - 1`.
Therefore it contains an element of order exactly `p - 1`. -/
lemma exists_orderOf_eq_prime_sub_one (p : ℕ) [Fact p.Prime] :
    ∃ b : (ZMod p)ˣ, orderOf b = p - 1 := by
  obtain ⟨g, hg⟩ := IsCyclic.exists_ofOrder_eq_natCard (α := (ZMod p)ˣ)
  exact ⟨g, by rw [hg, Nat.card_eq_fintype_card, ZMod.card_units]⟩

/-! ## Step 3 — transfer order-divisibility from modulus `n` to modulus `p` -/

/-- **Lift/reduce transfer.** When `n ≠ 0` and `p ∣ n`, the reduction homomorphism
`ZMod.unitsMap : (ZMod n)ˣ →* (ZMod p)ˣ` is surjective (`ZMod.unitsMap_surjective`). Hence any
unit `b` modulo `p` is the image of some unit `a` modulo `n`, and since the order of a
homomorphic image divides the order of the source (`orderOf_map_dvd`), the bound
`orderOf a ∣ (n - 1)` transfers to `orderOf b ∣ (n - 1)`.

This is exactly the minimal lifting statement needed: we never decompose `ZMod n` via CRT. -/
lemma orderOf_dvd_of_dvd_modulus
    [NeZero n] {p : ℕ} (hpn : p ∣ n)
    (hbound : ∀ a : (ZMod n)ˣ, orderOf a ∣ (n - 1))
    (b : (ZMod p)ˣ) : orderOf b ∣ (n - 1) := by
  obtain ⟨a, ha⟩ := ZMod.unitsMap_surjective hpn b
  have h := orderOf_map_dvd (ZMod.unitsMap hpn) a
  rw [ha] at h
  exact h.trans (hbound a)

/-! ## Step 4 — the Korselt arithmetic bridge -/

/-- **Korselt arithmetic bridge.** If `n > 1` satisfies the universal Fermat unit condition
`∀ a : (ZMod n)ˣ, a ^ (n - 1) = 1`, then for every prime `p ∣ n` one has `(p - 1) ∣ (n - 1)`.

This is the core implication of Korselt's criterion. Note that *squarefreeness of `n` is not
needed* for this direction: the reduction map on units is surjective for any `p ∣ n`. The
squarefree-flavoured restatement requested by the criterion is recorded below as
`korselt_squarefree`. -/
theorem prime_sub_one_dvd_of_forall_pow_eq_one
    (hn : 1 < n) {p : ℕ} (hp : p.Prime) (hpn : p ∣ n)
    (h : ∀ a : (ZMod n)ˣ, a ^ (n - 1) = 1) :
    (p - 1) ∣ (n - 1) := by
  haveI : Fact p.Prime := ⟨hp⟩
  haveI : NeZero n := ⟨by omega⟩
  obtain ⟨b, hb⟩ := exists_orderOf_eq_prime_sub_one p
  have hdvd :=
    orderOf_dvd_of_dvd_modulus hpn (forall_orderOf_dvd_of_forall_pow_eq_one h) b
  rwa [hb] at hdvd

/-- **Korselt's criterion (necessity, squarefree form).** Exactly the statement requested for
Korselt's criterion: a squarefree `n > 1` satisfying the universal Fermat unit condition has
`(p - 1) ∣ (n - 1)` for every prime `p ∣ n`.

The `Squarefree n` hypothesis is kept to match the classical phrasing, but the proof shows it
is unnecessary for this implication: it is discharged by
`prime_sub_one_dvd_of_forall_pow_eq_one`. -/
theorem korselt_squarefree
    (hn : 1 < n) (_hsqfree : Squarefree n) {p : ℕ} (hp : p.Prime) (hpn : p ∣ n)
    (h : ∀ a : (ZMod n)ˣ, a ^ (n - 1) = 1) :
    (p - 1) ∣ (n - 1) :=
  prime_sub_one_dvd_of_forall_pow_eq_one hn hp hpn h

end KorseltBridge
