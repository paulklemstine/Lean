-- Failure analysis: an early attempt to phrase "no gap" via the operator norm of
--   U on ℓ² required Mathlib's spectral-radius API for non-self-adjoint operators,
--   which is heavy. The character-eigenvector formulation is elementary and
--   captures exactly the same content (|eigenvalue| = 1).
-/

namespace CollatzFourier

open scoped BigOperators
open Finset

variable (N : ℕ)

/-- The affine "3n+1" map on `ℤ/N` (the linear branch of the Syracuse step). -/
def affine (x : ZMod N) : ZMod N := 3 * x + 1

/-- The Koopman / composition operator `U f = f ∘ A` of the affine map. -/
def koopman (f : ZMod N → ℂ) : ZMod N → ℂ := fun x => f (affine N x)

/-- `3` is a unit mod `N` iff `gcd(3,N) = 1`. -/
theorem isUnit_three_iff_coprime : IsUnit (3 : ZMod N) ↔ Nat.Coprime 3 N := by
  convert ZMod.isUnit_iff_coprime _ _ using 1

/-- The affine map is injective when `3` is a unit mod `N`. -/
theorem affine_injective (h : IsUnit (3 : ZMod N)) :
    Function.Injective (affine N) := by
  intro a b hab
  exact h.mul_left_cancel (by simpa [affine] using hab)

/-- On a finite cyclic group, the affine map is a bijection when `3` is a unit. -/
theorem affine_bijective [NeZero N] (h : IsUnit (3 : ZMod N)) :
    Function.Bijective (affine N) := by
  exact ⟨affine_injective _ h, Finite.injective_iff_surjective.mp (affine_injective _ h)⟩

/-- **Koopman acts on characters by a phase times another character.**
The additive character `ψ` (a Fourier mode) is sent to `ψ(1) · ψ(3·)`. -/
theorem koopman_addChar (ψ : AddChar (ZMod N) ℂ) (x : ZMod N) :
    koopman N (fun y => ψ y) x = ψ 1 * ψ (3 * x) := by
  rw [mul_comm, ← AddChar.map_add_eq_mul]
  ring!

/-- **Closed form for the iterated Koopman operator on a character.**
`Uᵏ ψ (x) = ψ(∑_{j<k} 3ʲ) · ψ(3ᵏ x)`: the frequency is multiplied by `3ᵏ` and a
geometric-sum phase accumulates. -/
theorem koopman_iterate_addChar (ψ : AddChar (ZMod N) ℂ) (k : ℕ) (x : ZMod N) :
    (koopman N)^[k] (fun y => ψ y) x
      = ψ (∑ j ∈ Finset.range k, (3 : ZMod N) ^ j) * ψ ((3 : ZMod N) ^ k * x) := by
  induction k generalizing x with
  | zero => simp
  | succ k ih =>
      rw [Function.iterate_succ_apply']
      simp only [koopman, affine]
      rw [ih (3 * x + 1)]
      simp only [Finset.sum_range_succ, pow_succ]
      rw [← AddChar.map_add_eq_mul, ← AddChar.map_add_eq_mul]
      congr 1
      ring

/-- **Eigenvector at the multiplicative time scale.**
If `3^L = 1` in `ℤ/N` (e.g. `L = ord_N(3)`), then `Uᴸ ψ = c · ψ` with the scalar
`c = ψ(∑_{j<L} 3ʲ)`. -/
theorem koopman_eigen_of_order (ψ : AddChar (ZMod N) ℂ) (L : ℕ)
    (hL : (3 : ZMod N) ^ L = 1) :
    (koopman N)^[L] (fun y => ψ y)
      = fun x => ψ (∑ j ∈ Finset.range L, (3 : ZMod N) ^ j) * ψ x := by
  convert funext fun x => koopman_iterate_addChar N ψ L x using 1
  norm_num [hL]

/-- **No spectral gap.**  On a finite cyclic group, whenever `3^L = 1`, every
additive character is an eigenvector of `Uᴸ` with a **unimodular** eigenvalue.
Hence the spectrum of the affine `3n+1` Koopman operator lies on the unit circle:
the affine branch is non-mixing and exhibits no spectral gap. -/
theorem no_spectral_gap [NeZero N] (ψ : AddChar (ZMod N) ℂ) (L : ℕ)
    (hL : (3 : ZMod N) ^ L = 1) :
    ∃ c : ℂ, ‖c‖ = 1 ∧ (koopman N)^[L] (fun y => ψ y) = fun x => c * ψ x := by
  exact ⟨ψ (∑ j ∈ Finset.range L, (3 : ZMod N) ^ j),
    AddChar.norm_apply _ _, koopman_eigen_of_order N ψ L hL⟩

/-- **`L²`-isometry.**  When `A` is a bijection (`gcd(3,N)=1`), the Koopman
operator preserves the `L²` mass: `∑_x ‖U f x‖² = ∑_x ‖f x‖²`.  This is the
"measure preserving" face of the absence of a spectral gap. -/
theorem koopman_l2_isometry [NeZero N] (h : Function.Bijective (affine N))
    (f : ZMod N → ℂ) :
    ∑ x : ZMod N, ‖koopman N f x‖ ^ 2 = ∑ x : ZMod N, ‖f x‖ ^ 2 := by
  convert Equiv.sum_comp (Equiv.ofBijective _ h) (fun x => ‖f x‖ ^ 2) using 1

end CollatzFourier